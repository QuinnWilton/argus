{erl_opts, [debug_info, warnings_as_errors]}.
{deps, []}.

%% Published to Hex with `rebar3 hex publish` (the docs are edoc's).
%% rebar3_hex pinned to 7.2.0: 7.3.0 (with hex_core 0.19) crashes on
%% rebar3 3.25 before authenticating, since it passes no cli_auth_callbacks
%% to hex_cli_auth. Unpin once a fixed release is out.
{project_plugins, [{rebar3_hex, "7.2.0"}]}.
{hex, [{doc, edoc}]}.
