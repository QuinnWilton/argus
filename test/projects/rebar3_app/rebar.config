%% A rebar3 umbrella for argus's tests: apps/shop and apps/ledger are one
%% program. telemetry is a dependency argus's escript also carries, at
%% another version (_checkouts/telemetry, so no fetch is needed).
{erl_opts, [debug_info]}.
{deps, [telemetry]}.

{argus, [
    {analyses, [coupling, mailbox, blocking, startup]}
]}.

{argus_plugin, [
    {fail_above, 100}
]}.
