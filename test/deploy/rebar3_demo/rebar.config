%% A small rebar3 project with a known finding for test/deploy/check.sh,
%% analyzed through the rebar3_argus plugin from Hex: with the escript at
%% $ARGUS_ESCRIPT, else the release named here (check.sh writes it).
{erl_opts, [debug_info]}.
{plugins, [rebar3_argus]}.
{argus, [{analyses, [unsafe_input]}]}.
