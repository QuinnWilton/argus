%% argus's configuration for analyzing argus itself, read by bin/argus
%% (a released argus escript): Erlang terms, one {Key, Value} per key
%% (see Argus.Config).

%% Every analysis: a warm run takes under a second.
{analyses, [all]}.

%% argus decodes its own owner-only caches, and the chunks of the beams
%% it analyzes, which hold atoms :safe refuses; its subprocesses run
%% constant argv: notes, not warnings.
{severity, [{unsafe_input, info}]}.
