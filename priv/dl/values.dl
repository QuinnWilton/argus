// The values stage — which literals a parameter can hold, derived once.
//
// Interprocedural constant propagation over sets of constants (Callahan,
// Cooper, Kennedy and Torczon, PLDI 1986), with two jump functions: a
// literal a caller passes (`call_arg`), and a parameter it passes through
// unchanged (`call_arg_forward`). A parameter's values are every literal
// that reaches it through any chain of such calls; the closure is
// transitive, so a helper wrapped any number of times still resolves.
//
// A value set is complete only when every way into the parameter is
// seen, and `param_complete` says which are. The rest may also hold a
// value no literal names: a caller passes a computed one (or one past the
// fourth argument, where `call_arg` stops), a caller the program does not
// show may call the function (an export, a fun, an apply), or a forwarded
// parameter is itself incomplete. A consumer that claims a set is
// complete reads `param_complete`; one that only names what a parameter
// may hold reads `param_value` alone. The complete parameters are staged
// rather than the others, since most parameters are not.
//
// Only the program's own functions have parameters here: a library
// function's callers are mostly outside the program, and what a call to
// one is handed is `call_arg`'s already.
//
// What a caller hands is kept apart from what the callee holds: `arg_value`
// is the literal a caller passes, or what its forwarded parameter holds,
// so a consumer that attributes a value to the function supplying it does
// not mix every caller's.
//
// Outputs are written as `.facts`, the format the analyses read
// (clientlib/staged_values.dl). It runs after stage 0, whose call graph it
// reads, within a budget (below); a program that outgrows it runs
// values_unknown.dl instead, which knows no value and says every parameter
// is unknown, so no consumer takes a truncated set as complete.

.include "base.dl"
.include "layer2.dl"

.decl call_edge(caller: symbol, callee: symbol) mutable
.input call_edge

// Which program runs: "full" for the stage as it runs by default;
// values_unknown.dl adds "unknown".
.decl values_program(mode: symbol)

values_program("full").

// ── Jump functions ──────────────────────────────────────────────────

// `caller` passes `callee` the literal `value` at `pos`.
.decl passes_literal(caller: symbol, callee: symbol, pos: number, value: symbol)

passes_literal(f, g, n, v) :-
  call_arg(f, g, n, v),
  v != "dynamic",
  function_def(g, _, _, _, _),
  !values_program("unknown").

// `caller` passes `callee` its own parameter `forward_pos` at `pos`.
.decl passes_param(caller: symbol, callee: symbol, pos: number, forward_pos: number)

passes_param(f, g, n, m) :- call_arg_forward(f, g, n, m), function_def(g, _, _, _, _).

// `caller` passes `callee` a value no literal names at `pos`.
.decl passes_unknown(caller: symbol, callee: symbol, pos: number)

passes_unknown(f, g, n) :- call_arg(f, g, n, "dynamic"), function_def(g, _, _, _, _).
passes_unknown(f, g, n) :- call_arg(f, g, n, _), function_def(g, _, _, _, _), values_program("unknown").

// A call the program shows, with an argument past the fourth, where
// call_arg stops.
passes_unknown(f, g, n) :-
  called_with_arguments(f, g),
  function_def(g, _, _, arity, _),
  position_of(arity, n),
  n >= 4.

// ── Callers the program does not show ───────────────────────────────

// A function a caller the program does not show may call: an export, a
// function captured as a fun (whoever holds the fun calls it), or one the
// call graph reaches by an edge no call with arguments makes (an apply, a
// function handed to another).
.decl unseen_callers(func: symbol)

unseen_callers(g) :- function_def(g, _, _, _, 1).
unseen_callers(g) :- closure_def(_, g).
unseen_callers(g) :- fun_ref(_, g).

unseen_callers(g) :-
  call_edge(f, g),
  function_def(g, _, _, arity, _),
  arity > 0,
  !called_with_arguments(f, g).

// `caller` calls `callee` with arguments call_arg resolves.
.decl called_with_arguments(caller: symbol, callee: symbol)

called_with_arguments(f, g) :- call_arg(f, g, _, _).
called_with_arguments(f, g) :- call_arg_forward(f, g, _, _).

// The positions of a function of `arity`.
.decl position_of(arity: number, pos: number)

position_of(a, 0) :- function_def(_, _, _, a, _), a > 0.
position_of(a, n) :- position_of(a, m), n = m + 1, n < a.

// ── Values ──────────────────────────────────────────────────────────

// The literals parameter `pos` of `func` may hold.
.decl param_value(func: symbol, pos: number, value: symbol)

param_value(g, n, v) :- passes_literal(_, g, n, v).
param_value(g, n, v) :- passes_param(f, g, n, m), param_value(f, m, v).

// Parameter `pos` of `func` may hold a value no literal names.
.decl param_unknown(func: symbol, pos: number)

param_unknown(g, n) :- passes_unknown(_, g, n).
param_unknown(g, n) :- passes_param(f, g, n, m), param_unknown(f, m).

param_unknown(g, n) :-
  unseen_callers(g),
  function_def(g, _, _, arity, _),
  position_of(arity, n).

// What `caller` hands `callee` at `pos`: its literal, or what the
// parameter it forwards may hold.
.decl arg_value(caller: symbol, callee: symbol, pos: number, value: symbol)

arg_value(f, g, n, v) :- passes_literal(f, g, n, v).
arg_value(f, g, n, v) :- passes_param(f, g, n, m), param_value(f, m, v).

.decl arg_unknown(caller: symbol, callee: symbol, pos: number)

arg_unknown(f, g, n) :- passes_unknown(f, g, n).
arg_unknown(f, g, n) :- passes_param(f, g, n, m), param_unknown(f, m).

// Every value parameter `pos` of `func` may hold is a param_value.
.decl param_complete(func: symbol, pos: number)

param_complete(g, n) :- param_value(g, n, _), !param_unknown(g, n).

// Every value `caller` hands `callee` at `pos` is an arg_value.
.decl arg_complete(caller: symbol, callee: symbol, pos: number)

arg_complete(f, g, n) :- arg_value(f, g, n, _), !arg_unknown(f, g, n).

// ── The budget ──────────────────────────────────────────────────────
//
// The closure grows with the literals a chain of helpers hands on: a
// logging wrapper every module calls with its own message holds them all.
// Held to 500,000 rows of param_value and of arg_value, as points-to's
// relations are; a program that reaches it runs values_unknown.dl.
.decl values_budget(rows: number)

values_budget(500000).

.limitsize param_value(n=500000)
.limitsize arg_value(n=500000)

.decl param_value_rows(n: number)

param_value_rows(count((f, n, v))) :- param_value(f, n, v).

.decl arg_value_rows(n: number)

arg_value_rows(count((f, g, n, v))) :- arg_value(f, g, n, v).

.decl values_overflow(relation: symbol, rows: number, budget: number)

values_overflow("param_value", n, b) :- values_budget(b), param_value_rows(n), n >= b.
values_overflow("arg_value", n, b) :- values_budget(b), arg_value_rows(n), n >= b.

.output values_overflow(filename="values_overflow.csv")

.decl values_mode(mode: symbol)

values_mode("full") :- values_program("full"), !values_program("unknown").
values_mode("unknown") :- values_program("unknown").

.output values_mode(filename="values_mode.facts")
.output param_value(filename="param_value.facts")
.output param_complete(filename="param_complete.facts")
.output arg_value(filename="arg_value.facts")
.output arg_complete(filename="arg_complete.facts")
