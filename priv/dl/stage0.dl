// Stage 0 — the shared derived call graph.
//
// Every client analysis walks `call_edge`, and every one of them used to
// re-derive it from raw bytecode inside its own solve. That is wasteful (the same fixpoint, computed once per
// analysis) and, worse, it makes each analysis's input set include the
// layer-1 relations — `instruction`, `remote_call`, `function_def` and
// friends — which churn on any edit to a function body.
//
// Stratifying fixes both. This program derives the call graph once; the
// analyses take the result as facts (see clientlib/imports.dl). The
// payoff for incremental consumers is that the *output* of this stage is
// far more stable than its input: editing a function body without
// changing which functions it calls leaves call_edge byte-identical, so a memoizing driver can stop there instead of
// re-solving every analysis.
//
// Outputs are written as `.facts` (the fact-file extension and the same
// tab-separated format inputs are read in) so the directory can be handed
// straight back to an analysis run with no renaming step.

.include "base.dl"

// Only call_edge is staged, never its transitive closure: the closure is
// quadratic in the worst case — 1.6MB of call_edge expands to 24.7MB of
// call_reachable on a 555-beam corpus — so materializing it would trade
// a cheap fixpoint for an expensive write-then-read on every solve. No
// shipped analysis takes the closure either: each walks call_edge from
// the functions it cares about, bounded (clientlib/reach.dl), and
// `call_reachable` in clientlib/imports.dl is left to clients, which
// FlowLog prunes from any program that does not read it.
.decl call_edge(caller: symbol, callee: symbol)
.include "clientlib/callgraph_rules.dl"
.output call_edge(filename="call_edge.facts")

// The instruction-level sites a supervision analysis can anchor a
// coupling at: calls into functions defined in the project (remote and
// local), the GenServer.call/cast a function performs itself, and the
// few library calls a finding anchors at (anchor_api). Derived once here
// for the same reason as call_edge — it keeps `remote_call` and
// `local_call` out of the input set of analyses that only reason about
// supervision structure, while their findings still point at the
// instruction.
.decl call_site(id: symbol, caller: symbol, callee_mod: symbol, callee_func: symbol, arity: number)

call_site(id, caller, mod, func, arity) :-
  remote_call(id, caller, mod, func, arity),
  function_def(_, mod, _, _, _).

call_site(id, caller, mod, func, arity) :-
  local_call(id, caller, target, arity),
  function_def(target, mod, func, _, _).

call_site(id, caller, mod, func, arity) :-
  remote_call(id, caller, mod, func, arity),
  anchor_api(mod, func).

// The library calls findings point at: a synchronous call, a child
// started under a supervisor, a tree started, a socket waited on; the
// call that hands a function's fun to a child, and a task started and
// awaited (runs_elsewhere, in runs_elsewhere.dl).
.decl anchor_api(mod: symbol, func: symbol)

anchor_api("GenServer", "call").
anchor_api("GenServer", "cast").
anchor_api(":gen_server", "call").
anchor_api(":gen_server", "cast").
anchor_api(":gen_statem", "call").
anchor_api(":gen_statem", "cast").
anchor_api("GenStateMachine", "call").
anchor_api("GenStateMachine", "cast").
anchor_api("DynamicSupervisor", "start_child").
anchor_api("Supervisor", "start_link").
anchor_api(":gen_tcp", "recv").
anchor_api(":ssl", "recv").
anchor_api("Supervisor", "start_child").
anchor_api("Task", "async").
anchor_api("Task", "await").
anchor_api("Task", "await_many").
anchor_api("Task", "yield").
anchor_api("Task", "yield_many").
anchor_api("Task.Supervisor", "async").
anchor_api("Task.Supervisor", "async_nolink").

.output call_site(filename="call_site.facts")

// The call-graph edges that run on every path through the caller: at
// least one site for the pair is not control-dependent on a branch.
// `conditional_call` and the per-site relations are positional and churn
// on body edits; this pair set is as stable as call_edge, which is why
// the "is the path from init conditional?" question is answered here.
.decl unconditional_call_edge(caller: symbol, callee: symbol)

unconditional_call_edge(caller, callee) :-
  remote_call(id, caller, mod, func, arity),
  !conditional_call(id),
  callee = cat(mod, cat(":", cat(func, cat("/", to_string(arity))))).

unconditional_call_edge(caller, callee) :-
  bif_call(id, caller, mod, func, arity, _),
  !conditional_call(id),
  callee = cat(mod, cat(":", cat(func, cat("/", to_string(arity))))).

unconditional_call_edge(caller, target) :-
  local_call(id, caller, target, _),
  !conditional_call(id),
  function_def(target, _, _, _, _).

.output unconditional_call_edge(filename="unconditional_call_edge.facts")

// The message tag a GenServer.call/cast site sends: the first element of
// a tuple, or a bare atom. Derived here, once, over def_use — reaching
// definitions, so it is the write that feeds the call rather than the
// one textually nearest it — and staged as a small, stable relation, so
// that the analyses attributing dynamic-target calls by tag never read
// the positional value-flow relations themselves.
.decl call_tag(id: symbol, caller: symbol, kind: symbol, tag: symbol)

call_tag(id, caller, "call", tag) :-
  remote_call(id, caller, gs, "call", _),
  (gs = "GenServer" ; gs = ":gen_server"),
  def_use(write_id, id),
  tuple_literal(write_id, "x1", tag, _).

call_tag(id, caller, "call", tag) :-
  remote_call(id, caller, gs, "call", _),
  (gs = "GenServer" ; gs = ":gen_server"),
  def_use(write_id, id),
  literal_value(write_id, "x1", tag),
  match(":.*", tag).

call_tag(id, caller, "cast", tag) :-
  remote_call(id, caller, gs, "cast", 2),
  (gs = "GenServer" ; gs = ":gen_server"),
  def_use(write_id, id),
  tuple_literal(write_id, "x1", tag, _).

call_tag(id, caller, "cast", tag) :-
  remote_call(id, caller, gs, "cast", 2),
  (gs = "GenServer" ; gs = ":gen_server"),
  def_use(write_id, id),
  literal_value(write_id, "x1", tag),
  match(":.*", tag).

.output call_tag(filename="call_tag.facts")

// Which function each call a fun is handed to calls (fun_handed names
// the call by its instruction): `Enum:each/2`, `:telemetry:attach/4`, a
// local helper. runs_elsewhere asks it whether that call runs the fun
// on the caller's stack, starts a process on it or keeps it for later.
// Staged, so the analyses read neither remote_call nor local_call for it.
.decl fun_handed_to(caller: symbol, fun: symbol, callee: symbol)

fun_handed_to(f, g, callee) :-
  fun_handed(id, f, g, _),
  remote_call(id, f, mod, func, arity),
  callee = cat(mod, cat(":", cat(func, cat("/", to_string(arity))))).

fun_handed_to(f, g, callee) :-
  fun_handed(id, f, g, _),
  local_call(id, f, callee, _).

.output fun_handed_to(filename="fun_handed_to.facts")

