// Supervision tree analysis.
//
// Detects common supervision anti-patterns:
// - Transient children depended upon by permanent children.
// - Coupled siblings under one_for_one without links.
// - Children started before their dependencies (wrong order).
//
// Uses transitive stateful_module_dep to catch indirect dependencies
// (e.g. A calls helper H which calls GenServer.call(B)).

.include "base.dl"

.decl supervisor(mod: symbol, strategy: symbol)
.input supervisor

.decl supervisor_child(sup: symbol, position: number, child_mod: symbol, restart: symbol, type: symbol)
.input supervisor_child

.decl sync_call(caller_func: symbol, callee_mod: symbol)
.input sync_call

.decl async_cast(caller_func: symbol, callee_mod: symbol)
.input async_cast

.decl process_link(from_mod: symbol, to_mod: symbol)
.input process_link

.decl named_process(mod: symbol, name: symbol)
.input named_process

.decl implements_behaviour(mod: symbol, behaviour: symbol)
.input implements_behaviour

// ── Callgraph ────────────────────────────────────────────────────────

.decl call_edge(caller: symbol, callee: symbol)
.include "callgraph_rules.dl"

.decl call_reachable(from: symbol, to: symbol)
.include "call_reachable_rules.dl"

// ── Shared rules ─────────────────────────────────────────────────────

.include "genserver_api_rules.dl"
.include "stateful_module_dep_rules.dl"
.include "init_function_rules.dl"

// ── Child subtree ──────────────────────────────────────────────────

.include "child_subtree.dl"

// ── Init-time reachability ──────────────────────────────────────────

.decl init_reaches(from_mod: symbol, to_mod: symbol)

init_reaches(from_mod, to_mod) :-
  init_function(from_mod, func),
  call_reachable(func, callee),
  function_def(callee, to_mod, _, _, _, _),
  from_mod != to_mod.

init_reaches(from_mod, to_mod) :-
  init_function(from_mod, func),
  function_def(func, _, _, _, _, _),
  call_edge(func, callee),
  function_def(callee, to_mod, _, _, _, _),
  from_mod != to_mod.

// ── Derived process links ────────────────────────────────────────────

// Supervisors are implicitly linked to their children.
.decl derived_process_link(from_mod: symbol, to_mod: symbol)

derived_process_link(a, b) :- process_link(a, b).
derived_process_link(sup, child) :- supervisor_child(sup, _, child, _, _).

// ── Anti-patterns ────────────────────────────────────────────────

// Permanent child that depends on a transient child (transitively).
.decl suspect_transient_dependency(sup: symbol, permanent: symbol, transient: symbol)
.output suspect_transient_dependency

suspect_transient_dependency(sup, perm, trans) :-
  supervisor_child(sup, _, perm, "permanent", _),
  supervisor_child(sup, _, trans, "transient", _),
  stateful_module_dep(perm, trans).

// one_for_one siblings that communicate but aren't linked.
.decl unlinked_coupled_siblings(sup: symbol, a: symbol, b: symbol)
.output unlinked_coupled_siblings

unlinked_coupled_siblings(sup, a, b) :-
  supervisor(sup, "one_for_one"),
  child_subtree(sup, a_branch, a),
  child_subtree(sup, b_branch, b),
  stateful_module_dep(a, b),
  !derived_process_link(a, b),
  !derived_process_link(b, a),
  a_branch != b_branch.

// Child started before a dependency (wrong order under any strategy).
// Scoped to init_reaches to avoid false positives from runtime paths.
.decl wrong_start_order(sup: symbol, child: symbol, dep: symbol, child_pos: number, dep_pos: number)
.output wrong_start_order

wrong_start_order(sup, child, dep, cpos, dpos) :-
  supervisor(sup, _),
  child_subtree(sup, child_branch, child),
  child_subtree(sup, dep_branch, dep),
  supervisor_child(sup, cpos, child_branch, _, _),
  supervisor_child(sup, dpos, dep_branch, _, _),
  init_reaches(child, dep),
  cpos < dpos,
  child_branch != dep_branch.
