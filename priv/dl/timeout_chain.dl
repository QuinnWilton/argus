// Timeout chain detection.
//
// Detects two dangerous patterns in GenServer callback implementations:
//
// 1. Timeout chains: handle_call/3 callbacks that make synchronous calls
//    to other GenServer modules, creating chains where timeouts compose
//    unpredictably (A→B→C means A's 5000ms timeout must accommodate
//    both B and C latency).
//
// 2. Blocking cast handlers: handle_cast/2 callbacks that make
//    synchronous calls, defeating the async purpose of cast and silently
//    blocking the GenServer.

.include "base.dl"

// ── Input facts ──────────────────────────────────────────────────────

.decl implements_behaviour(mod: symbol, behaviour: symbol)
.input implements_behaviour

.decl sync_call(caller_func: symbol, callee_mod: symbol)
.input sync_call

.decl sync_call_timeout(caller_func: symbol, callee_mod: symbol, timeout_ms: number)
.input sync_call_timeout

.decl async_cast(caller_func: symbol, callee_mod: symbol)
.input async_cast

// ── Callgraph ────────────────────────────────────────────────────────

.decl call_edge(caller: symbol, callee: symbol)
.include "callgraph_rules.dl"

.decl call_reachable(from: symbol, to: symbol)
.include "call_reachable_rules.dl"

// ── Shared rules ─────────────────────────────────────────────────────

.include "genserver_api_rules.dl"
.include "stateful_module_dep_rules.dl"

// ── Callback identification ──────────────────────────────────────────

// handle_call/3 in a GenServer module.
.decl handle_call_function(mod: symbol, func: symbol)

handle_call_function(mod, func) :-
  function_def(func, mod, "handle_call", 3, _, _),
  implements_behaviour(mod, "GenServer").

// handle_cast/2 in a GenServer module.
.decl handle_cast_function(mod: symbol, func: symbol)

handle_cast_function(mod, func) :-
  function_def(func, mod, "handle_cast", 2, _, _),
  implements_behaviour(mod, "GenServer").

// ── Callback sync dependency ─────────────────────────────────────────

// A handle_call callback in `from_mod` makes a synchronous call to
// `to_mod` (directly or transitively through helpers/API functions).
.decl callback_sync_dep(from_mod: symbol, to_mod: symbol)

// Direct sync_call from handle_call.
callback_sync_dep(from_mod, to_mod) :-
  handle_call_function(from_mod, func),
  sync_call(func, to_mod),
  to_mod != "dynamic",
  from_mod != to_mod.

// Transitive: handle_call reaches a function with sync_call.
callback_sync_dep(from_mod, to_mod) :-
  handle_call_function(from_mod, func),
  call_reachable(func, g),
  sync_call(g, to_mod),
  to_mod != "dynamic",
  from_mod != to_mod.

// Via GenServer API: handle_call calls/reaches a sync API function.
callback_sync_dep(from_mod, to_mod) :-
  handle_call_function(from_mod, func),
  call_edge(func, g),
  genserver_sync_api(g, to_mod),
  from_mod != to_mod.

callback_sync_dep(from_mod, to_mod) :-
  handle_call_function(from_mod, func),
  call_reachable(func, g),
  genserver_sync_api(g, to_mod),
  from_mod != to_mod.

// Via stateful_module_dep (catches heuristic cases).
callback_sync_dep(from_mod, to_mod) :-
  handle_call_function(from_mod, _),
  stateful_module_dep(from_mod, to_mod),
  implements_behaviour(to_mod, "GenServer"),
  from_mod != to_mod.

// ── Timeout chain computation ────────────────────────────────────────

// Transitive timeout chain: if A's handle_call syncs to B, and B's
// handle_call syncs to C, then A has a chain through B to C.
.decl timeout_chain(from: symbol, to: symbol, depth: number)

// Base case: direct callback sync dependency (depth 1).
timeout_chain(from, to, 1) :-
  callback_sync_dep(from, to),
  implements_behaviour(to, "GenServer").

// Recursive case: chain through intermediate GenServer.
timeout_chain(from, to, d + 1) :-
  callback_sync_dep(from, mid),
  timeout_chain(mid, to, d),
  from != to,
  d < 10.

// ── Output: timeout chain risk ───────────────────────────────────────

// Chains of depth >= 2 are risky: the outermost caller's timeout must
// accommodate the sum of all intermediate timeouts.
.decl timeout_chain_risk(from: symbol, to: symbol, depth: number)
.output timeout_chain_risk

timeout_chain_risk(from, to, depth) :-
  timeout_chain(from, to, depth),
  depth >= 2.

// ── Output: blocking cast handler ────────────────────────────────────

// handle_cast/2 that makes a synchronous call defeats the async
// purpose of cast and silently blocks the GenServer.
.decl blocking_cast_handler(mod: symbol, target: symbol)
.output blocking_cast_handler

// Direct sync_call from handle_cast.
blocking_cast_handler(mod, target) :-
  handle_cast_function(mod, func),
  sync_call(func, target),
  target != "dynamic".

// Transitive: handle_cast reaches a function with sync_call.
blocking_cast_handler(mod, target) :-
  handle_cast_function(mod, func),
  call_reachable(func, g),
  sync_call(g, target),
  target != "dynamic".

// Via GenServer API.
blocking_cast_handler(mod, target_mod) :-
  handle_cast_function(mod, func),
  call_edge(func, g),
  genserver_sync_api(g, target_mod).

blocking_cast_handler(mod, target_mod) :-
  handle_cast_function(mod, func),
  call_reachable(func, g),
  genserver_sync_api(g, target_mod).

// ── Timeout-aware sync dependency ──────────────────────────────────

// Like callback_sync_dep, but carries the timeout value from the call site.
.decl callback_sync_dep_timeout(from_mod: symbol, to_mod: symbol, timeout_ms: number)

// Direct: handle_call itself has sync_call_timeout.
callback_sync_dep_timeout(from_mod, to_mod, timeout_ms) :-
  handle_call_function(from_mod, func),
  sync_call_timeout(func, to_mod, timeout_ms),
  to_mod != "dynamic",
  from_mod != to_mod.

// Transitive: handle_call reaches a function with sync_call_timeout.
callback_sync_dep_timeout(from_mod, to_mod, timeout_ms) :-
  handle_call_function(from_mod, func),
  call_reachable(func, g),
  sync_call_timeout(g, to_mod, timeout_ms),
  to_mod != "dynamic",
  from_mod != to_mod.

// Via GenServer sync API: use the API function's own sync_call_timeout.
callback_sync_dep_timeout(from_mod, to_mod, timeout_ms) :-
  handle_call_function(from_mod, func),
  call_edge(func, g),
  genserver_sync_api(g, to_mod),
  sync_call_timeout(g, _, timeout_ms),
  from_mod != to_mod.

callback_sync_dep_timeout(from_mod, to_mod, timeout_ms) :-
  handle_call_function(from_mod, func),
  call_reachable(func, g),
  genserver_sync_api(g, to_mod),
  sync_call_timeout(g, _, timeout_ms),
  from_mod != to_mod.

// ── Output: timeout insufficient ───────────────────────────────────

// A calls B with T_AB, B's handle_call calls someone with T_BC.
// If T_AB <= T_BC: A's budget cannot accommodate B's downstream work.
.decl timeout_insufficient(caller: symbol, callee: symbol,
                           caller_timeout: number, callee_downstream_timeout: number)
.output timeout_insufficient

timeout_insufficient(a, b, t_ab, t_bc) :-
  callback_sync_dep_timeout(a, b, t_ab),
  callback_sync_dep_timeout(b, _, t_bc),
  t_ab > 0,     // not dynamic
  t_ab != -1,   // not infinity
  t_bc > 0,     // not dynamic
  t_ab <= t_bc.

// ── Output: infinity timeout in chain ──────────────────────────────

// Sync call in a chain uses :infinity timeout — can block forever.
.decl infinity_timeout_in_chain(mod: symbol, target: symbol)
.output infinity_timeout_in_chain

infinity_timeout_in_chain(mod, target) :-
  callback_sync_dep_timeout(mod, target, -1),
  implements_behaviour(target, "GenServer").
