// Layer 1 — generic bytecode facts.
//
// GENERATED by `mix argus.gen.dl` from Argus.Schema.layer_1/0 — do not edit.
// Schema version 9.
//
// Include this instead of declaring fact relations by hand. Souffle
// prunes input relations no rule reads, so including the whole layer
// costs nothing in the solve.

// Stack frame allocation.
.decl allocate(id: symbol, stack: number, live: number)
.input allocate

// Built-in function call.
.decl bif_call(id: symbol, mod: symbol, func: symbol, arity: number, fail: number)
.input bif_call

// Conditional two-way control transfer: the label edge plus fallthrough. For test instructions the label is the fail edge; for receive-loop control (loop_rec, wait_timeout) it is the empty-mailbox/loop-again edge.
.decl branch(id: symbol, fail: number, reserved: number)
.input branch

// Start of binary matching.
.decl bs_start(id: symbol, fail: number)
.input bs_start

// Closure construction edge: `parent_func` builds a closure pointing at `closure_func`. Treated as a static call edge in the call graph so that `call_reachable` follows execution into closure bodies passed to higher-order callees (`Enum.map`, `:telemetry.span`, `Task.async`, etc.).
//
// Only emitted when the `make_fun3` target is a concrete `{Mod, Func, Arity}` triple. Closures targeting raw labels (rare in modern BEAM) are skipped because we don't have the closure's function ID at emit time.
//
.decl closure_def(parent_func: symbol, closure_func: symbol)
.input closure_def

// Stack frame deallocation.
.decl deallocate(id: symbol, stack: number)
.input deallocate

// Register definition (write).
.decl def(id: symbol, reg: symbol)
.input def

// Function definition within a module.
.decl function_def(func: symbol, mod: symbol, name: symbol, arity: number, exported: number)
.input function_def

// Entry label of a function — positional, split from function_def.
.decl function_entry(func: symbol, entry: number)
.input function_entry

// External function referenced by the module.
.decl import_ref(mod: symbol, name: symbol, arity: number)
.input import_ref

// Every instruction in every function.
.decl instruction(id: symbol, func: symbol, idx: number, op: symbol)
.input instruction

// Unconditional jump to a label.
.decl jump(id: symbol, target: number)
.input jump

// Maps a label number to the instruction at that position.
.decl label_at(label: number, id: symbol)
.input label_at

// The source line in effect at this instruction: line markers are resolved through the Line chunk at emit time and stamped onto every following instruction until the next marker, so any instruction ID an anchor names resolves to its exact line. Instructions with no line in effect — before the first marker, under a no-location marker (reference 0, on compiler-generated code), or in modules without a parseable Line chunk — emit no rows.
//
.decl line_info(id: symbol, line: number)
.input line_info

// Literal value loaded into a register.
.decl literal_value(id: symbol, reg: symbol, val: symbol)
.input literal_value

// Call to a local (same-module) function by label or MFA.
.decl local_call(id: symbol, target: symbol, arity: number)
.input local_call

// Lambda/closure creation.
.decl make_fun(id: symbol, target: symbol, num_free: number)
.input make_fun

// Module attribute key-value pair.
.decl module_attribute(mod: symbol, key: symbol, val: symbol)
.input module_attribute

// Module existence.
.decl module_info(mod: symbol, name: symbol)
.input module_info

// Data move from source to destination.
.decl move(id: symbol, src: symbol, dst: symbol)
.input move

// Sequential (fallthrough) instruction ordering.
.decl next(from: symbol, to: symbol)
.input next

// End of a receive clause (remove_message).
.decl recv_end(id: symbol)
.input recv_end

// Start of a receive loop (loop_rec).
.decl recv_start(id: symbol, fail: number)
.input recv_start

// Call to an external (remote) function.
.decl remote_call(id: symbol, mod: symbol, func: symbol, arity: number)
.input remote_call

// One arm of a select_val or select_tuple_arity.
.decl select_branch(id: symbol, val: symbol, target: number)
.input select_branch

// Message send instruction.
.decl send_msg(id: symbol)
.input send_msg

// Process spawn detected via erlang:spawn* calls.
.decl spawn_call(id: symbol, mod: symbol, func: symbol, arity: number, variant: symbol)
.input spawn_call

// Marks an instruction as a tail call.
.decl tail_call(id: symbol)
.input tail_call

// End of a try block.
.decl try_end(id: symbol)
.input try_end

// Start of a try block.
.decl try_start(id: symbol, handler: number)
.input try_start

// Records the index of a `get_tuple_element` extraction. Lets analyses that follow pattern-matched destructuring (e.g. `{:ok, val} = call()`) know which field of the source tuple was placed in the destination.
//
.decl tuple_field_access(id: symbol, src: symbol, idx: number, dst: symbol)
.input tuple_field_access

// Type-test instructions emitted by the compiler for guard and pattern-match narrowing (`is_integer`, `is_tuple`, and the structural `is_nonempty_list`/`is_tagged_tuple`, whose extra operands are not recorded — `src` is always the tested register). Captures the test name (which the generic `branch` fact discards) so type-narrowing dataflow analyses can reason about which register has which inferred type on the success edge.
//
.decl type_test(id: symbol, test: symbol, src: symbol, fail: number)
.input type_test

// Records every instruction that fell through to the catch-all clause in `Argus.Pipeline.Emit`. Used for offline auditing — running this against a real corpus surfaces opcodes Argus is silently dropping (e.g. pre-OTP-24 instruction shapes still emitted by older compilers).
//
.decl unhandled_op(id: symbol, op: symbol)
.input unhandled_op

// Register use (read).
.decl use(id: symbol, reg: symbol)
.input use
