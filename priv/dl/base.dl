// Layer 1 — generic bytecode facts.
//
// GENERATED by `mix argus.gen.dl` from Argus.Schema.layer_1/0 — do not edit.
//
// Include this instead of declaring fact relations by hand. FlowLog
// prunes input relations no rule reads, so including the whole layer
// costs nothing in the solve.

// Built-in function call.
.decl bif_call(id: symbol, caller: symbol, mod: symbol, func: symbol, arity: number, fail: number) mutable
.input bif_call

// Control-flow edges between `site_block` blocks, skipping intermediate blocks without rows. Excludes loop back edges whose target dominates their source, matching `Argus.Cfg.Function.precedes?/3`. The resulting closure orders sites within one iteration; a receive's loop back to `loop_rec` adds no ordering.
//
.decl block_flow(from: symbol, to: symbol) mutable
.input block_flow

// Conditional two-way control transfer: the label edge plus fallthrough. For test instructions the label is the fail edge; for receive-loop control (loop_rec, wait_timeout) it is the empty-mailbox/loop-again edge.
.decl branch(id: symbol, fail: number, reserved: number) mutable
.input branch

// Start of binary matching.
.decl bs_start(id: symbol, fail: number) mutable
.input bs_start

// A closure constructed by `parent_func` with target `closure_func`. Adds a call-graph edge so reachability includes closure bodies. Emitted only for concrete `{Mod, Func, Arity}` targets of `make_fun3`; raw-label targets are omitted.
//
.decl closure_def(parent_func: symbol, closure_func: symbol) mutable
.input closure_def

// A call absent from at least one path that returns or tail-calls (`Argus.Cfg.Function.completing_blocks/1`). Raising paths do not count. If no path completes, uses control dependence on any branch instead.
//
.decl conditional_call(id: symbol) mutable
.input conditional_call

// Register definition (write).
.decl def(id: symbol, reg: symbol) mutable
.input def

// A write that can supply a read, accounting for register reuse and control flow. Both columns are positional instruction IDs, so body edits invalidate these rows. Use this relation only when value flow is needed.
//
.decl def_use(def_id: symbol, use_id: symbol) mutable
.input def_use

// A call through a fun value or computed module/function whose target is not statically known. Unresolved calls limit reachability analysis and prevent claims that require knowing every callee, such as proving a function pure.
//
.decl dynamic_call(id: symbol, caller: symbol, kind: symbol) mutable
.input dynamic_call

// An extraction failure for a module. A failed extractor or derived-facts stage loses only its own rows. Failed disassembly, failed bytecode emission, or a per-module timeout leaves only this error row. Analysis continues with the available facts.
//
.decl extraction_error(mod: symbol, step: symbol, reason: symbol) mutable
.input extraction_error

// The call receiving a closure or literal external fun that runs `callee` (`Argus.Pipeline.Emit.FunRefs`). Identifies the call site used to check `try` coverage of the fun's execution. Excludes funs stored in terms or returned by the receiving call.
//
.decl fun_handed(id: symbol, caller: symbol, callee: symbol, pos: number) mutable
.input fun_handed

// A literal external fun passed to a call that may invoke it, with its argument position (`Argus.Pipeline.Emit.FunRefs`). Excludes funs stored in terms, returned by the callee, or also called directly. Local captures use `closure_def` instead. The call graph follows this edge; same-process walks consult `fun_handed` to exclude deferred or spawned execution.
//
.decl fun_ref(caller: symbol, callee: symbol) mutable
.input fun_ref

// Function definition within a module.
.decl function_def(func: symbol, mod: symbol, name: symbol, arity: number, exported: number) mutable
.input function_def

// Entry label of a function — positional, split from function_def.
.decl function_entry(func: symbol, entry: number) mutable
.input function_entry

// Every instruction in every function.
.decl instruction(id: symbol, func: symbol, idx: number, op: symbol) mutable
.input instruction

// Unconditional jump to a label.
.decl jump(id: symbol, target: number) mutable
.input jump

// Maps a label number to the instruction at that position.
.decl label_at(label: number, id: symbol) mutable
.input label_at

// The source line active at an instruction, resolved from the BEAM Line chunk. Each marker applies until the next. No row is emitted before the first marker, under a no-location marker (reference 0), or without a parseable Line chunk.
//
.decl line_info(id: symbol, line: number) mutable
.input line_info

// Literal value loaded into a register.
.decl literal_value(id: symbol, reg: symbol, val: symbol) mutable
.input literal_value

// Call to a local (same-module) function by label or MFA.
.decl local_call(id: symbol, caller: symbol, target: symbol, arity: number) mutable
.input local_call

// Sequential (fallthrough) instruction ordering.
.decl next(from: symbol, to: symbol) mutable
.input next

// Start of a receive loop (`loop_rec`). The emitter follows its empty-mailbox branch to classify the receive: `wait` can block indefinitely; `wait_timeout` has a timeout.
//
.decl recv_start(id: symbol, caller: symbol, blocking: number, fail: number) mutable
.input recv_start

// Call to an external (remote) function.
.decl remote_call(id: symbol, caller: symbol, mod: symbol, func: symbol, arity: number) mutable
.input remote_call

// An `apply` target resolved from reaching values (`Argus.Pipeline.Emit.Applies`), including module/function registers, `erlang:apply/3`, and closure or external-fun calls via `erlang:apply/2`. These calls enter the call graph and use the target's effect classification instead of an opaque `dynamic_call` effect.
//
.decl resolved_apply(id: symbol, caller: symbol, target: symbol) mutable
.input resolved_apply

// One arm of a select_val or select_tuple_arity.
.decl select_branch(id: symbol, val: symbol, target: number) mutable
.input select_branch

// Message send instruction.
.decl send_msg(id: symbol, caller: symbol) mutable
.input send_msg

// The basic block containing a named call, receive, or branch; blocks are identified by their first instruction. Used with `block_flow` by `clientlib/order.dl` to order calls and receives. BIFs, dynamic calls, and sends have no rows. Branch rows are for in-process passes; a receive's `loop_rec` has both kinds. Instruction IDs change on body edits.
//
.decl site_block(id: symbol, kind: symbol, block: symbol, idx: number) mutable
.input site_block

// A process spawn and its entry function, resolved by `Argus.Pipeline.Emit.Spawns` from a closure, literal external fun, or module/function/argument list. Captured variables count toward closure arity. A forwarded fun is `param`; unresolved names are `dynamic` and unknown arity is -1. Known module or function names are retained even if the other is unknown. `variant` comes from literal options. `Argus.Extractors.TermFlow` uses the spawn site as the process identity.
//
.decl spawn_call(id: symbol, caller: symbol, mod: symbol, func: symbol, arity: number, variant: symbol, api: symbol, source: symbol, param: number, args: number) mutable
.input spawn_call

// Marks an instruction as a tail call.
.decl tail_call(id: symbol) mutable
.input tail_call

// Start of a try block.
.decl try_start(id: symbol, caller: symbol, kind: symbol, handler: number) mutable
.input try_start

// A tuple constructed with a literal atom as its first element, with the destination register. Complements `literal_value` for messages such as `{:get, key}`. The register identifies the operand; `def_use` alone does not.
//
.decl tuple_literal(id: symbol, reg: symbol, tag: symbol, size: number) mutable
.input tuple_literal

// A compiler-emitted type test for a guard or pattern match, with the tested register in `src`. Unlike `branch`, retains the test name for type narrowing on the success edge. Extra operands of structural tests such as `is_tagged_tuple` are omitted.
//
.decl type_test(id: symbol, test: symbol, src: symbol, fail: number) mutable
.input type_test

// Register use (read).
.decl use(id: symbol, reg: symbol) mutable
.input use
