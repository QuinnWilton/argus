// Layer 1 — generic bytecode facts.
//
// GENERATED by `mix argus.gen.dl` from Argus.Schema.layer_1/0 — do not edit.
// Schema version 33.
//
// Include this instead of declaring fact relations by hand. Souffle
// prunes input relations no rule reads, so including the whole layer
// costs nothing in the solve.

// Stack frame allocation.
.decl allocate(id: symbol, stack: number, live: number)
.input allocate

// Built-in function call.
.decl bif_call(id: symbol, caller: symbol, mod: symbol, func: symbol, arity: number, fail: number)
.input bif_call

// Conditional two-way control transfer: the label edge plus fallthrough. For test instructions the label is the fail edge; for receive-loop control (loop_rec, wait_timeout) it is the empty-mailbox/loop-again edge.
.decl branch(id: symbol, fail: number, reserved: number)
.input branch

// Start of binary matching.
.decl bs_start(id: symbol, fail: number)
.input bs_start

// A call instruction with at least one branch (a `test` or `loop_rec`) later in the same function.
//
// This is positional information, computed where positional information belongs: in the emitter, which already knows every instruction's index. The alternative is what `unsafe_task` used to do — join `instruction` twice to compare two indexes — which dragged the largest and most volatile relation in the schema into that analysis's input set to answer a yes/no question about ordering.
//
// Deliberately a coarse predicate, because the rule it serves is coarse: "some branch occurs after this call" is a weak proxy for "the call's result was pattern-matched", and it fires on a branch anywhere later in the function including one in an unrelated clause. Encoding it faithfully keeps findings identical; sharpening it is a separate, deliberate change.
//
.decl call_followed_by_branch(id: symbol)
.input call_followed_by_branch

// Closure construction edge: `parent_func` builds a closure pointing at `closure_func`. Treated as a static call edge in the call graph so that `call_reachable` follows execution into closure bodies passed to higher-order callees (`Enum.map`, `:telemetry.span`, `Task.async`, etc.).
//
// Only emitted when the `make_fun3` target is a concrete `{Mod, Func, Arity}` triple. Closures targeting raw labels (rare in modern BEAM) are skipped because we don't have the closure's function ID at emit time.
//
.decl closure_def(parent_func: symbol, closure_func: symbol)
.input closure_def

// A call instruction (local, remote, or BIF) that does not execute on every path through its function: its basic block is control-dependent on a branch. Derived per module from the control-flow graph's post-dominator tree, so an analysis can tell "init/1 calls X" from "init/1 calls X when an option is set" without reading `instruction` or reconstructing control flow in Datalog.
//
.decl conditional_call(id: symbol)
.input conditional_call

// Stack frame deallocation.
.decl deallocate(id: symbol, stack: number)
.input deallocate

// Register definition (write).
.decl def(id: symbol, reg: symbol)
.input def

// A reaching definition: this write can produce the value that read consumes. True def→use, respecting register reuse and control flow, rather than register-name matching — the difference between knowing where a value came from and guessing.
//
// Volatile by construction. Both columns are positional instruction IDs, so editing a function body churns every edge in it. Only analyses that genuinely need value flow should declare it; the rest keep the incrementality that removing `instruction` from every rule bought.
//
.decl def_use(def_id: symbol, use_id: symbol)
.input def_use

// A call whose target is not statically known: through a fun value (`call_fun`), or through a computed module/function (`apply`).
//
// The call graph cannot follow these, which makes them the boundary of anything that reasons over reachability. Most analyses can ignore that and be merely incomplete; one that makes a claim about ALL executions — that a function performs no side effects, say — cannot, because an unfollowable call could do anything. Recorded so such an analysis can say "unprovable here" instead of quietly answering as though the call were not there.
//
.decl dynamic_call(id: symbol, caller: symbol, kind: symbol)
.input dynamic_call

// Function definition within a module.
.decl function_def(func: symbol, mod: symbol, name: symbol, arity: number, exported: number)
.input function_def

// Entry label of a function — positional, split from function_def.
.decl function_entry(func: symbol, entry: number)
.input function_entry

// Every instruction in every function.
.decl instruction(id: symbol, func: symbol, idx: number, op: symbol)
.input instruction

// Unconditional jump to a label.
.decl jump(id: symbol, target: number)
.input jump

// Maps a label number to the instruction at that position.
.decl label_at(label: number, id: symbol)
.input label_at

// The source line in effect at this instruction: line markers are resolved through the Line chunk at emit time and stamped onto every following instruction until the next marker, so any instruction ID an anchor names resolves to its exact line. Instructions with no line in effect — before the first marker, under a no-location marker (reference 0, on compiler-generated code), or in modules without a parseable Line chunk — emit no rows.
//
.decl line_info(id: symbol, line: number)
.input line_info

// Literal value loaded into a register.
.decl literal_value(id: symbol, reg: symbol, val: symbol)
.input literal_value

// Call to a local (same-module) function by label or MFA.
.decl local_call(id: symbol, caller: symbol, target: symbol, arity: number)
.input local_call

// Module attribute key-value pair.
.decl module_attribute(mod: symbol, key: symbol, val: symbol)
.input module_attribute

// Data move from source to destination.
.decl move(id: symbol, src: symbol, dst: symbol)
.input move

// Sequential (fallthrough) instruction ordering.
.decl next(from: symbol, to: symbol)
.input next

// Start of a receive loop (loop_rec).
//
// `blocking` distinguishes the two shapes a receive compiles to. The loop_rec's fail label leads to the empty-mailbox block, which ends in either `wait` (re-enter the loop and sleep — no timeout, so the process can block forever) or `wait_timeout` (bounded). That distinction is only visible by following a label to another instruction, so it is resolved in the emitter and recorded here rather than left for a rule to reconstruct.
//
.decl recv_start(id: symbol, caller: symbol, blocking: number, fail: number)
.input recv_start

// Call to an external (remote) function.
.decl remote_call(id: symbol, caller: symbol, mod: symbol, func: symbol, arity: number)
.input remote_call

// One arm of a select_val or select_tuple_arity.
.decl select_branch(id: symbol, val: symbol, target: number)
.input select_branch

// Message send instruction.
.decl send_msg(id: symbol, caller: symbol)
.input send_msg

// Process spawn detected via erlang:spawn* calls.
.decl spawn_call(id: symbol, caller: symbol, mod: symbol, func: symbol, arity: number, variant: symbol)
.input spawn_call

// Marks an instruction as a tail call.
.decl tail_call(id: symbol)
.input tail_call

// End of a try block.
.decl try_end(id: symbol)
.input try_end

// Start of a try block.
.decl try_start(id: symbol, caller: symbol, kind: symbol, handler: number)
.input try_start

// A tuple built with a literal atom head. Complements `literal_value`, which already records scalars written by `move` — including atoms — with their register; `put_tuple2` was the gap, so `{:get, key}` was invisible where a bare `:get` was not, and those are different messages.
//
// The register is the point. `def_use` says which write feeds which read but not which OPERAND, so a call reading {x,0} and {x,1} gets two edges and neither says which is the message. The write knows.
//
.decl tuple_literal(id: symbol, reg: symbol, tag: symbol, size: number)
.input tuple_literal

// Type-test instructions emitted by the compiler for guard and pattern-match narrowing (`is_integer`, `is_tuple`, and the structural `is_nonempty_list`/`is_tagged_tuple`, whose extra operands are not recorded — `src` is always the tested register). Captures the test name (which the generic `branch` fact discards) so type-narrowing dataflow analyses can reason about which register has which inferred type on the success edge.
//
.decl type_test(id: symbol, test: symbol, src: symbol, fail: number)
.input type_test

// Register use (read).
.decl use(id: symbol, reg: symbol)
.input use
