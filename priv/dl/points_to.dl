// The points-to stage — which process a pid can be, derived once.
//
// Process points-to (clientlib/processes.dl) is a whole-program fixpoint
// over PidFlow's per-function summaries, and on a large program it is
// most of what a solve costs: over ssl, public_key and kernel it was four
// of the four and a half seconds each of blocking, coupling, failure,
// mailbox, shutdown, startup, coverage and races spent, the same rows
// derived in each. Like stage 0 (stage0.dl), this derives them once, and
// the analyses read the result as facts (clientlib/staged_processes.dl).
//
// It runs after stage 0, whose call graph it reads, into the same facts
// directory, and writes only what an analysis reads: the processes, the
// resolved targets, and of what each source points to, the processes and
// tables (not the terms that hold them, the bulk of it). For an
// incremental consumer it is a cutoff seam of its own: most edits leave
// every process and target where it was.
//
// Outputs are written as `.facts`, the format the analyses read.
//
// This is the stage as it runs by default: every leaf resolved exactly.
// When that cannot finish in time, the stage runs points_to_bounded.dl
// instead (Argus.Analysis.Extraction.derive_points_to/2): this program
// with stage_mode("bounded"), which resolves the leaves a coarse pass
// finds pervasive with that pass (clientlib/pervasive.dl) and every
// other one as here. Both write the same relations.

.include "clientlib/imports.dl"
.include "clientlib/behaviours.dl"
.include "clientlib/callbacks.dl"
.include "clientlib/process_statem.dl"
.include "clientlib/runs_elsewhere.dl"
.include "clientlib/processes.dl"
.include "clientlib/pervasive.dl"

stage_mode("exact").

.output server_process(filename="server_process.facts")
.output instance(filename="instance.facts")
.output supervised_process(filename="supervised_process.facts")
.output private_process(filename="private_process.facts")
.output process(filename="process.facts")
.output named_pid(filename="named_pid.facts")
.output call_site_target(filename="call_site_target.facts")
.output self_call(filename="self_call.facts")

// The calls, casts and sends, and apart from them the exit signals,
// monitors and links, which only signals.dl reads.
.decl staged_process_call(func: symbol, anchor: symbol, site: symbol, api_kind: symbol, proc: symbol)

staged_process_call(f, a, id, kind, p) :- process_call(f, a, id, kind, p), pid_call(id, _, kind, _, _).

.output staged_process_call(filename="process_call.facts")

.decl process_signal(func: symbol, anchor: symbol, site: symbol, signal: symbol, proc: symbol)

process_signal(f, a, id, kind, p) :- process_call(f, a, id, kind, p), pid_signal(id, _, kind, _, _).

.output process_signal(filename="process_signal.facts")

// The processes a handler hands a call as its first argument (shutdown's
// stops), and the tables an :ets operation names (tables.dl): what a
// source may point to, for the sources the analyses ask about. Staged
// for those alone, since a source no rule asks about is most of the
// program, and the points-to of an arbitrary one is what the stage
// otherwise never needs; a rule that asks about other sources adds them
// here.
.decl source_process(func: symbol, src_kind: symbol, src: symbol, proc: symbol)

source_process(h, sk, s, p) :-
  handler_function(_, h),
  pid_arg(_, h, _, "0", "call", sk, s),
  source_pts(h, sk, s, p),
  process(p).

source_process(h, sk, s, p) :-
  handler_function(_, h),
  pid_arg(_, h, _, "0", "call", sk, s),
  coarse(h, sk, s, r, p),
  coarse_top(r),
  pervasive(p).

.output source_process(filename="source_process.facts")

.decl source_table(func: symbol, src_kind: symbol, src: symbol, table: symbol)

source_table(f, sk, s, t) :- table_use(_, f, sk, s), source_pts(f, sk, s, t), table_alloc(_, _, t).

source_table(f, sk, s, t) :-
  table_use(_, f, sk, s),
  coarse(f, sk, s, r, t),
  coarse_top(r),
  pervasive(t),
  table_alloc(_, _, t).

.output source_table(filename="source_table.facts")
