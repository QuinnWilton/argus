// The points-to stage — which objects (processes, tables and the terms
// holding them) a variable can hold, derived once.
//
// Points-to (clientlib/processes.dl) is a whole-program fixpoint
// over TermFlow's per-function summaries, and on a large program most of
// what a solve costs, the same rows for every analysis that asks. Like
// stage 0 (stage0.dl), this derives them once, and the analyses read the
// result as facts (clientlib/staged_processes.dl).
//
// It runs after stage 0, whose call graph it reads, into the same facts
// directory, and writes only what an analysis reads: the processes, the
// resolved targets, and of what each variable points to, the processes and
// tables (not the terms that hold them, the bulk of it). For an
// incremental consumer it is a cutoff seam of its own: most edits leave
// every process and target where it was.
//
// Outputs are written as `.facts`, the format the analyses read.
//
// This is the stage as it runs by default, the full one: every object
// resolved field-sensitively, within a budget (below). A program whose
// full fixpoint outgrows it runs points_to_selective.dl instead
// (Argus.Analysis.Extraction.derive_points_to/2): this program with
// stage_mode("selective"), which resolves the hub objects a
// field-insensitive pass finds with that pass (clientlib/hub_objects.dl)
// and every other one as here; and one that outgrows even that runs
// points_to_field_insensitive.dl, which resolves every object with it.
// All three write the same relations, and points_to_mode says which one
// wrote them.

.include "clientlib/imports.dl"
.include "clientlib/behaviours.dl"
.include "clientlib/callbacks.dl"
.include "clientlib/process_statem.dl"
.include "clientlib/runs_elsewhere.dl"
.include "clientlib/processes.dl"
.include "clientlib/hub_objects.dl"
.include "clientlib/task_handles.dl"

stage_mode("full").

// ── The budget ──────────────────────────────────────────────────────
//
// What a variable may point to (var_points_to) and what a term's field may
// hold (field_points_to) are the fixpoint's bulk, and each is held to 500,000
// rows. Over twenty evaluation programs the largest are 45k and 30k
// rows (the Phoenix stack's 751-module deps; a 1,239-module umbrella
// takes 5k); where the program's helpers merge most of its terms into
// one value, the two grow with the square of those terms instead, and
// past the budget within seconds: Ash's 1,327 modules reach 13 million
// field rows after thirteen minutes, all of OTP and a 7,104-module
// deps tree run past ten.
//
// The budget is decided by the rows a relation reaches: one that reaches
// it overflows, whether the engine stops it as it grows past (`.limitsize`
// below) or the finished fixpoint counts it, so whether a program outgrows
// it is a function of the program and its facts, not of how fast the
// engine ran. points_to_overflow names the relations that reached it, and
// the caller runs the selective stage in their place. The selective
// stage is held to the same budget (it includes this file), and the
// field-insensitive stage, run when the selective one outgrows it, too:
// a program that outgrows even that has no points-to, and the analyses
// that read it degrade.

.decl points_to_budget(rows: number)

points_to_budget(500000).

// The budget as the engine reads it: a relation that grows past it stops
// the solve as it grows, rather than after a fixpoint of millions of rows,
// and the caller reads the stop as an overflow (Argus.Stages).
.limitsize var_points_to(n=500000)
.limitsize field_points_to(n=500000)

.decl points_to_overflow(relation: symbol, rows: number, budget: number)

.decl var_points_to_rows(n: number)

var_points_to_rows(count((f, k, s, x))) :- var_points_to(f, k, s, x).

.decl field_points_to_rows(n: number)

field_points_to_rows(count((o, sel, x))) :- field_points_to(o, sel, x).

points_to_overflow("var_points_to", n, b) :- points_to_budget(b), var_points_to_rows(n), n >= b.

points_to_overflow("field_points_to", n, b) :- points_to_budget(b), field_points_to_rows(n), n >= b.

.output points_to_overflow(filename="points_to_overflow.csv")

// Which stage wrote the relations below, staged beside them: a result
// read back from a store says how it was made. The hub objects the
// selective and field-insensitive stages resolved field-insensitively go
// beside it too (none in the full stage).
.decl points_to_mode(mode: symbol)

points_to_mode("full") :- stage_mode("full"), !stage_mode("selective").
points_to_mode("selective") :- stage_mode("selective"), !stage_mode("field_insensitive").
points_to_mode("field_insensitive") :- stage_mode("field_insensitive").

.output points_to_mode(filename="points_to_mode.facts")
.output hub_object(filename="hub_object.csv")

.output server_process(filename="server_process.facts")
.output instance(filename="instance.facts")
.output supervised_process(filename="supervised_process.facts")
.output private_process(filename="private_process.facts")
.output process(filename="process.facts")
.output named_pid(filename="named_pid.facts")
.output call_site_target(filename="call_site_target.facts")
.output self_call(filename="self_call.facts")

// The calls, casts and sends, and apart from them the exit signals,
// monitors and links, which only signals.dl reads.
.decl staged_process_call(func: symbol, anchor: symbol, site: symbol, api_kind: symbol, proc: symbol)

staged_process_call(f, a, id, kind, p) :- process_call(f, a, id, kind, p), process_call_var(id, _, kind, _, _).

.output staged_process_call(filename="process_call.facts")

.decl process_signal(func: symbol, anchor: symbol, site: symbol, signal: symbol, proc: symbol)

process_signal(f, a, id, kind, p) :- process_call(f, a, id, kind, p), process_signal_var(id, _, kind, _, _).

.output process_signal(filename="process_signal.facts")

// The processes a handler hands a call as its first argument (shutdown's
// stops), and the tables an :ets operation names (tables.dl): what a
// variable may point to, for the variables the analyses ask about.
// Staged for those alone, since a variable no rule asks about is most of
// the program, and the points-to of an arbitrary one is what the stage
// otherwise never needs; a rule that asks about other variables adds
// them here.
.decl var_process(func: symbol, var_kind: symbol, var: symbol, proc: symbol)

var_process(h, sk, s, p) :-
  handler_function(_, h),
  call_arg_var(_, h, _, "0", "call", sk, s),
  var_points_to(h, sk, s, p),
  process(p).

var_process(h, sk, s, p) :-
  handler_function(_, h),
  call_arg_var(_, h, _, "0", "call", sk, s),
  field_insensitive_points_to(h, sk, s, r, p),
  reach_top(r),
  hub_object(p).

.output var_process(filename="var_process.facts")

.decl var_table(func: symbol, var_kind: symbol, var: symbol, table: symbol)

var_table(f, sk, s, t) :- table_use(_, f, sk, s), var_points_to(f, sk, s, t), table_allocation(_, _, t).

var_table(f, sk, s, t) :-
  table_use(_, f, sk, s),
  field_insensitive_points_to(f, sk, s, r, t),
  reach_top(r),
  hub_object(t),
  table_allocation(_, _, t).

.output var_table(filename="var_table.facts")

// A table the process that made it keeps in its dictionary, whose
// reference never leaves that process: no term holds it (a message, a
// server's state, a reply, a start's argument are all terms), no start,
// spawn or closure another process runs is handed it. Each process that
// runs the code makes and keeps a table of its own, so no other process
// can reach the one a process keeps (tables.dl reads it as private to
// its process). A reference handed to code outside the program (stored
// in another table, in :persistent_term, returned to an outside caller)
// is not seen, and ets.dl's give_away is asked apart, in tables.dl.
.decl kept_in_dictionary(table: symbol)

kept_in_dictionary(t) :-
  dictionary_put(_, g, _, sk, s),
  var_points_to(g, sk, s, t),
  table_allocation(_, _, t),
  !leaves_process(t).

.decl leaves_process(table: symbol)

leaves_process(t) :- field_points_to(_, _, t), table_allocation(_, _, t).

leaves_process(t) :-
  call_arg_var(_, f, _, _, via, sk, s),
  via != "call",
  via != "closure",
  var_points_to(f, sk, s, t),
  table_allocation(_, _, t).

leaves_process(t) :-
  call_arg_var(_, f, g, _, "closure", sk, s),
  runs_elsewhere(_, g),
  var_points_to(f, sk, s, t),
  table_allocation(_, _, t).

.output kept_in_dictionary(filename="kept_in_dictionary.facts")

// The tables the selective stage resolved field-insensitively (hub
// objects): its var_table rows for them are a superset, which a rule
// that needs the table an operation surely names must not take as one
// (tables.dl). None in the full stage.
.decl approximated_table(table: symbol)

approximated_table(t) :- hub_object(t), table_allocation(_, _, t).

.output approximated_table(filename="approximated_table.facts")

// The processes the selective or field-insensitive stage resolved
// field-insensitively: their targets are a superset (hub_objects.dl),
// each a process a call, send or signal may reach, not one it surely
// does. None in the full stage.
.decl approximated_process(proc: symbol)

approximated_process(p) :- hub_object(p), process(p).

.output approximated_process(filename="approximated_process.facts")
