// The points-to stage — which process a pid can be, derived once.
//
// Process points-to (clientlib/processes.dl) is a whole-program fixpoint
// over TermFlow's per-function summaries, and on a large program it is
// most of what a solve costs: over ssl, public_key and kernel it was four
// of the four and a half seconds each of blocking, coupling, failure,
// mailbox, shutdown, startup, coverage and races spent, the same rows
// derived in each. Like stage 0 (stage0.dl), this derives them once, and
// the analyses read the result as facts (clientlib/staged_processes.dl).
//
// It runs after stage 0, whose call graph it reads, into the same facts
// directory, and writes only what an analysis reads: the processes, the
// resolved targets, and of what each source points to, the processes and
// tables (not the terms that hold them, the bulk of it). For an
// incremental consumer it is a cutoff seam of its own: most edits leave
// every process and target where it was.
//
// Outputs are written as `.facts`, the format the analyses read.
//
// This is the stage as it runs by default: every leaf resolved exactly,
// within a budget (below). A program whose exact fixpoint outgrows it
// runs points_to_bounded.dl instead (Argus.Analysis.Extraction.
// derive_points_to/2): this program with stage_mode("bounded"), which
// resolves the leaves a coarse pass finds pervasive with that pass
// (clientlib/pervasive.dl) and every other one as here. Both write the
// same relations, and points_to_mode says which one wrote them.

.include "clientlib/imports.dl"
.include "clientlib/behaviours.dl"
.include "clientlib/callbacks.dl"
.include "clientlib/process_statem.dl"
.include "clientlib/runs_elsewhere.dl"
.include "clientlib/processes.dl"
.include "clientlib/pervasive.dl"
.include "clientlib/task_handles.dl"

stage_mode("exact").

// ── The budget ──────────────────────────────────────────────────────
//
// What a source may point to (source_pts) and what a term's field may
// hold (field_pts) are the fixpoint's bulk, and each is held to 500,000
// rows. Over twenty evaluation programs the largest are 45k and 30k
// rows (the Phoenix stack's 751-module deps; a 1,239-module umbrella
// takes 5k); where the program's helpers merge most of its terms into
// one value, the two grow with the square of those terms instead, and
// past the budget within seconds: Ash's 1,327 modules reach 13 million
// field rows after thirteen minutes, all of OTP and a 7,104-module
// deps tree run past ten.
//
// Souffle stops a fixpoint once a relation `.limitsize` names holds that
// many rows. The rows only grow, so a stop means the whole fixpoint
// holds at least that many, and a fixpoint that ends below the budget is
// complete: whether a program outgrows it is a function of the program
// and its facts, not of how fast the solver ran. points_to_overflow
// names the relations that reached it; their outputs are then partial,
// and the caller runs the bounded stage in their place. The bounded
// stage is held to the same budget (it includes this file), and a
// program that outgrows even that has no points-to: the analyses that
// read it degrade.
.limitsize source_pts(n=500000)
.limitsize field_pts(n=500000)

.decl points_to_budget(rows: number)

points_to_budget(500000).

.decl points_to_overflow(relation: symbol, rows: number, budget: number)

points_to_overflow("source_pts", n, b) :-
  points_to_budget(b),
  n = count : { source_pts(_, _, _, _) },
  n >= b.

points_to_overflow("field_pts", n, b) :-
  points_to_budget(b),
  n = count : { field_pts(_, _, _) },
  n >= b.

.output points_to_overflow(filename="points_to_overflow.csv")

// Which stage wrote the relations below, staged beside them: a result
// read back from a store says how it was made. The leaves the bounded
// stage resolved coarsely go beside it too (none in this stage).
.decl points_to_mode(mode: symbol)

points_to_mode("exact") :- !stage_mode("bounded").
points_to_mode("bounded") :- stage_mode("bounded").

.output points_to_mode(filename="points_to_mode.facts")
.output pervasive(filename="pervasive.csv")

.output server_process(filename="server_process.facts")
.output instance(filename="instance.facts")
.output supervised_process(filename="supervised_process.facts")
.output private_process(filename="private_process.facts")
.output process(filename="process.facts")
.output named_pid(filename="named_pid.facts")
.output call_site_target(filename="call_site_target.facts")
.output self_call(filename="self_call.facts")

// The calls, casts and sends, and apart from them the exit signals,
// monitors and links, which only signals.dl reads.
.decl staged_process_call(func: symbol, anchor: symbol, site: symbol, api_kind: symbol, proc: symbol)

staged_process_call(f, a, id, kind, p) :- process_call(f, a, id, kind, p), process_call_source(id, _, kind, _, _).

.output staged_process_call(filename="process_call.facts")

.decl process_signal(func: symbol, anchor: symbol, site: symbol, signal: symbol, proc: symbol)

process_signal(f, a, id, kind, p) :- process_call(f, a, id, kind, p), process_signal_source(id, _, kind, _, _).

.output process_signal(filename="process_signal.facts")

// The processes a handler hands a call as its first argument (shutdown's
// stops), and the tables an :ets operation names (tables.dl): what a
// source may point to, for the sources the analyses ask about. Staged
// for those alone, since a source no rule asks about is most of the
// program, and the points-to of an arbitrary one is what the stage
// otherwise never needs; a rule that asks about other sources adds them
// here.
.decl source_process(func: symbol, src_kind: symbol, src: symbol, proc: symbol)

source_process(h, sk, s, p) :-
  handler_function(_, h),
  value_arg(_, h, _, "0", "call", sk, s),
  source_pts(h, sk, s, p),
  process(p).

source_process(h, sk, s, p) :-
  handler_function(_, h),
  value_arg(_, h, _, "0", "call", sk, s),
  coarse(h, sk, s, r, p),
  coarse_top(r),
  pervasive(p).

.output source_process(filename="source_process.facts")

.decl source_table(func: symbol, src_kind: symbol, src: symbol, table: symbol)

source_table(f, sk, s, t) :- table_use(_, f, sk, s), source_pts(f, sk, s, t), table_alloc(_, _, t).

source_table(f, sk, s, t) :-
  table_use(_, f, sk, s),
  coarse(f, sk, s, r, t),
  coarse_top(r),
  pervasive(t),
  table_alloc(_, _, t).

.output source_table(filename="source_table.facts")

// A table the process that made it keeps in its dictionary, whose
// reference never leaves that process: no term holds it (a message, a
// server's state, a reply, a start's argument are all terms), no start,
// spawn or closure another process runs is handed it. Each process that
// runs the code makes and keeps a table of its own, so no other process
// can reach the one a process keeps (tables.dl reads it as private to
// its process). A reference handed to code outside the program (stored
// in another table, in :persistent_term, returned to an outside caller)
// is not seen, and ets.dl's give_away is asked apart, in tables.dl.
.decl kept_in_dictionary(table: symbol)

kept_in_dictionary(t) :-
  dict_put(_, g, _, sk, s),
  source_pts(g, sk, s, t),
  table_alloc(_, _, t),
  !leaves_process(t).

.decl leaves_process(table: symbol)

leaves_process(t) :- field_pts(_, _, t), table_alloc(_, _, t).

leaves_process(t) :-
  value_arg(_, f, _, _, via, sk, s),
  via != "call",
  via != "closure",
  source_pts(f, sk, s, t),
  table_alloc(_, _, t).

leaves_process(t) :-
  value_arg(_, f, g, _, "closure", sk, s),
  runs_elsewhere(_, g),
  source_pts(f, sk, s, t),
  table_alloc(_, _, t).

.output kept_in_dictionary(filename="kept_in_dictionary.facts")

// The tables the bounded stage resolved coarsely (pervasive leaves): its
// source_table rows for them are a superset, which a rule that needs
// the table an operation surely names must not take as one (tables.dl).
// None in the exact stage.
.decl coarse_table(table: symbol)

coarse_table(t) :- pervasive(t), table_alloc(_, _, t).

.output coarse_table(filename="coarse_table.facts")
