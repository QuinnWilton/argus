// Distributed systems analysis.
//
// Detects distributed system anti-patterns: RPC calls without timeout,
// RPC in GenServer callbacks, global registration without conflict
// resolution, and distributed operations in init/1.

.include "../clientlib/imports.dl"

// ── RPC without timeout ──────────────────────────────────────────

// RPC call using default infinity timeout — hangs on netsplit.
// site is the rpc call instruction. One row per site — finding
// builders dedupe on (func, variant).
.decl rpc_without_timeout(func: symbol, variant: symbol, site: symbol)
.output rpc_without_timeout

rpc_without_timeout(func, variant, id) :-
  rpc_call(id, func, variant, "infinity").

// ── RPC in GenServer callback ────────────────────────────────────

// RPC inside a GenServer callback compounds timeout risk — the
// GenServer's own timeout plus the RPC timeout can cascade.
.decl genserver_callback_func(func: symbol)

genserver_callback_func(func) :-
  function_def(func, mod, "handle_call", _, _),
  implements_behaviour(mod, "GenServer").

genserver_callback_func(func) :-
  function_def(func, mod, "handle_cast", _, _),
  implements_behaviour(mod, "GenServer").

genserver_callback_func(func) :-
  function_def(func, mod, "handle_info", _, _),
  implements_behaviour(mod, "GenServer").

// Only the RPC directly in the callback is reported. The transitive
// form — `rpc_call(_, g, _, _), call_reachable(func, g)` — was removed:
// call_reachable runs over a function-granularity call graph that
// collapses the clauses of a guarded dispatcher, so on the corpus every
// GenServer callback that reached a library's routing function (Cachex's
// Router.route, whose guards statically pick local vs. RPC) was reported
// as making an RPC, even when the concrete action provably routes local.
// All 13 of the analysis's transitive findings were false; the RPC sites
// themselves are already surfaced by rpc_without_timeout.
.decl rpc_in_genserver_callback(func: symbol, variant: symbol)
.output rpc_in_genserver_callback

rpc_in_genserver_callback(func, variant) :-
  rpc_call(_, func, variant, _),
  genserver_callback_func(func).

// ── Global register without conflict resolution ──────────────────

// :global.register_name/2 (without resolve function) is race-prone
// during network partitions. register_name/3 supplies an explicit
// conflict-resolution function — the fixed form — so only /2 is
// flagged. site is the registration instruction.
.decl global_register_risk(func: symbol, name: symbol, site: symbol)
.output global_register_risk

global_register_risk(func, name, id) :-
  global_register(id, func, name, "2").

// ── Blocking :global synchronization ─────────────────────────────

// :global.set_lock and :global.trans block on netsplit when retries
// is :infinity or any positive integer (which retries with backoff).
// retries = "0" means try once and return immediately — non-blocking.
// site is the :global call instruction. One row per site — finding
// builders dedupe on (func, op, retries).
.decl global_blocking_op(func: symbol, op: symbol, retries: symbol, site: symbol)
.output global_blocking_op

global_blocking_op(func, op, retries, id) :-
  global_op(id, func, op, retries),
  retries != "0",
  retries != "dynamic".

// ── Blocking :global op in init/1 ────────────────────────────────

// Catches the worst case: blocking on :global from supervisor startup
// (init/1 or transitively from init/1). Hangs the supervisor.
.decl global_blocking_in_init(func: symbol, op: symbol)
.output global_blocking_in_init

global_blocking_in_init(func, op) :-
  global_blocking_op(func, op, _, _),
  init_function(_, func).

global_blocking_in_init(func, op) :-
  global_blocking_op(callee_func, op, _, _),
  call_reachable(func, callee_func),
  init_function(_, func).

// ── Distributed operations in init ───────────────────────────────

// RPC or global ops in init/1 block supervisor startup.
//
// init_function comes from the clientlib: init/1 in a behaviour module.
// Only those init/1 functions run under a supervisor at start time — a
// plain module's init/1 is an ordinary function and must not be flagged.
.include "../clientlib/init_function_rules.dl"

// site is the distributed-op instruction inside init. One row per
// site — finding builders dedupe on (func, op).
.decl distributed_in_init(func: symbol, op: symbol, site: symbol)
.output distributed_in_init

distributed_in_init(func, op, id) :-
  rpc_call(id, func, op, _),
  init_function(_, func).

distributed_in_init(func, op, id) :-
  global_register(id, func, _, _),
  init_function(_, func),
  op = "global_register".

// Node operations in init — exclude the non-blocking ops that return
// immediately: Node.list ("list"), Node.monitor ("monitor"), and
// :net_kernel.monitor_nodes ("monitor_nodes" — a subscription flag, not
// a connection attempt).
distributed_in_init(func, op, id) :-
  node_operation(id, func, op),
  init_function(_, func),
  op != "list",
  op != "monitor",
  op != "monitor_nodes".

distributed_in_init(func, op, id) :-
  distributed_store_op(id, func, _, op),
  init_function(_, func).
