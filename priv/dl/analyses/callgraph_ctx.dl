// Context-sensitive call graph with 1-call-site sensitivity.
//
// Extends the basic call_edge(caller, callee) with the call site instruction
// ID, enabling analyses to distinguish different call sites within the same
// function. This is the simplest useful context sensitivity for the BEAM.
//
// The BEAM's explicit module system means most calls are already precise;
// context mainly helps with higher-order functions and dynamic dispatch.

.include "../clientlib/cfg.dl"

// base.dl relations are included transitively through cfg.dl.

// ── Context-sensitive call edge ──────────────────────────────────────

// call_edge_ctx(caller_func, callee, call_site_id): a call from caller_func
// to callee at a specific instruction.
.decl call_edge_ctx(caller: symbol, callee: symbol, site: symbol)
.output call_edge_ctx

// Remote call with call site.
call_edge_ctx(caller_func, callee, id) :-
  remote_call(id, mod, func, arity),
  instruction(id, caller_func, _, _),
  callee = cat(mod, cat(":", cat(func, cat("/", to_string(arity))))).

// BIF call with call site.
call_edge_ctx(caller_func, callee, id) :-
  bif_call(id, mod, func, arity, _),
  instruction(id, caller_func, _, _),
  callee = cat(mod, cat(":", cat(func, cat("/", to_string(arity))))).

// Local call with call site.
call_edge_ctx(caller_func, target, id) :-
  local_call(id, target, _),
  instruction(id, caller_func, _, _),
  function_def(target, _, _, _, _, _).

// ── Context-insensitive projection ───────────────────────────────────

// Standard call_edge is the projection of call_edge_ctx.
.decl call_edge(caller: symbol, callee: symbol)
.output call_edge

call_edge(caller, callee) :- call_edge_ctx(caller, callee, _).

// ── Call site fan-out ────────────────────────────────────────────────

// Number of distinct callees per call site (useful for detecting dynamic
// dispatch or polymorphic call sites).
.decl call_site_fan_out(site: symbol, fan_out: number)
.output call_site_fan_out

call_site_fan_out(site, n) :-
  call_edge_ctx(_, _, site),
  n = count : { call_edge_ctx(_, _, site) }.

// ── Per-function call site count ─────────────────────────────────────

// How many distinct call sites a function has.
.decl function_call_site_count(func: symbol, n: number)
.output function_call_site_count

function_call_site_count(func, n) :-
  function_def(func, _, _, _, _, _),
  n = count : { call_edge_ctx(func, _, _) }.

// ── Context-sensitive reachability ───────────────────────────────────

// call_reachable_ctx: transitive reachability tracking the initial call site.
.decl call_reachable_ctx(from: symbol, to: symbol, origin_site: symbol)
.output call_reachable_ctx

call_reachable_ctx(a, b, site) :- call_edge_ctx(a, b, site).
call_reachable_ctx(a, c, site) :-
  call_reachable_ctx(a, b, site),
  call_edge(b, c).
