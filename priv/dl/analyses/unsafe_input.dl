// Attacker-shaped data reaching a sink.
//
// Four sinks matter on the BEAM: atom creation (the atom table is
// fixed-size and never collected, so distinct attacker-supplied values
// kill the node), deserialization (binary_to_term materializes funs,
// ports and references), one-shot decompression (the whole output of an
// input with no size bound: a few hundred bytes of gzip inflate to
// gigabytes) and code execution. One relation, with the
// proximity to a request surface as a column, says how exposed each
// sink is:
//
//   direct      the sink is in a request-handling callback, operating
//               on the callback's own arguments — which ARE the request
//   adjacent    one call away: the callback passed something to it
//   transitive  anywhere else in the callback's cone — a path, not a
//               proven flow
//   flow        request DATA reaches the sink's argument: one of the
//               entry's request-carrying parameters, through
//               destructuring, string building and forwarding — a
//               proven flow, whatever the distance
//
// Reachability is not taint. Verified the hard way on sequin, where
// every transitive hit sourced its input from Postgres or Redis rather
// than the request, reached only because a LiveView happens to load
// those records. A sink inside the callback is another matter. The flow
// proximity is the answer to that: the per-function summaries
// (call_arg_derived, sink_arg_derived) are computed from reaching
// definitions in Elixir, and Souffle only chains them backward from the
// sink. A flow the summaries cannot see — a value laundered through a
// local helper's return, an element handed to a closure — stays a path,
// so the absence of a flow row is not evidence the data comes from
// elsewhere.
//
// A sink no request reaches is reported once, on its own: code
// execution when some exported function reaches it (in a library that is
// very nearly everything, so this is "is this code live", not "can an
// attacker reach it"), atom creation when what a caller hands in reaches
// its argument (caller_input, below), and every deserialization without
// :safe, since the caller's input is the question. Entry points are identified by OTP behaviour plus callback
// name/arity, which is exactly the information beam attributes carry.

.include "../clientlib/imports.dl"
.include "../clientlib/behaviours.dl"
.include "../clientlib/callbacks.dl"
.include "../clientlib/request_entry.dl"
.include "../clientlib/runs_elsewhere.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ── The sinks ────────────────────────────────────────────────────

// `safety` is the deserialization's option class — unsafe, atoms_only
// ([:safe] passed: no new atoms, but a fun referencing a loaded module
// still runs when the term is used) or dynamic — and empty for the other
// sinks. It reaches the finding so the text can say which.
.decl sink(id: symbol, func: symbol, api: symbol, kind: symbol, safety: symbol)

sink(id, func, api, "atom", "") :-
  unsafe_atom_creation(id, func, api),
  !bounded_input(id, func),
  !repeated_site(id).

sink(id, func, api, "code", "") :- code_execution(id, func, api), !repeated_site(id).

// A one-shot decompression's input has no bound the program can write:
// a literal compressed blob is not a shape anyone decompresses, so no
// allowlist quiets it. What bounds it is the streaming form, which is
// not a sink.
sink(id, func, api, "decompression", "") :-
  unsafe_decompression(id, func, api, _),
  !repeated_site(id).

// The argument a decompression reads: the compressed data, not the
// zstream `inflate/2` takes first (which lives in the handler's state).
.decl sink_data_arg(id: symbol, func: symbol, pos: number)

sink_data_arg(id, func, pos) :- unsafe_decompression(id, func, _, pos).

// Every site of the four sinks, bounded or not: the flow walk (below)
// starts at each, since whether an atoms-of-atoms bound holds asks
// whether request data reaches the site.
.decl sink_site(id: symbol, func: symbol, kind: symbol)

sink_site(id, func, "atom") :- unsafe_atom_creation(id, func, _).
sink_site(id, func, "code") :- code_execution(id, func, _).
sink_site(id, func, "decompression") :- unsafe_decompression(id, func, _, _).

sink_site(id, func, "deserialization") :-
  unsafe_deserialization(id, func, _, safety),
  unsafe_safety_class(safety).

sink(id, func, api, "deserialization", safety) :-
  unsafe_deserialization(id, func, api, safety),
  unsafe_safety_class(safety),
  !bounded_input(id, func),
  !repeated_site(id).

// ── Input the program bounds ─────────────────────────────────────
//
// A sink whose argument is one of a set the program wrote, on every path
// to it — compared equal to a literal in a clause head, a guard's `in` or
// a case arm, or found in a literal list on the branch where it holds
// (sink_arg_bounded) — takes no attacker's input, however that input was
// derived: logflare's `handle_event(dir, ...) when dir in ["backwards",
// "forwards"]` makes one of two atoms. A membership test against a list
// the function takes as a parameter bounds it where every caller passes
// a literal list (call_arg_allowlist): hexpm's `safe_to_atom(bin,
// allowed)`, called with `@sort_params`. Only the argument an atom or a
// deserialization sink reads (position 0) is asked; a code sink's module
// may be bounded while its function is not.
.decl bounded_input(id: symbol, func: symbol)

bounded_input(id, f) :- sink_arg_bounded(id, f, 0, "").

bounded_input(id, f) :-
  sink_arg_bounded(id, f, 0, "atoms"),
  !atoms_chosen(id).

bounded_input(id, f) :-
  sink_arg_bounded(id, f, 0, q),
  q != "",
  q != "atoms",
  call_edge(_, f),
  !unlisted_caller(f, q).

.decl unlisted_caller(func: symbol, pos: symbol)

unlisted_caller(f, q) :-
  sink_arg_bounded(_, f, 0, q),
  q != "",
  q != "atoms",
  call_edge(c, f),
  !allowlist_at(c, f, q).

.decl allowlist_at(caller: symbol, callee: symbol, pos: symbol)

allowlist_at(c, f, to_string(n)) :- call_arg_allowlist(c, f, n).

// ── Atoms made of atoms ──────────────────────────────────────────
//
// An atom made of an atom that exists and of literals (`:"#{name}_id"`,
// `list_to_atom(atom_to_list(Tab) ++ "_sup")`, sink_arg_bounded's
// "atoms") is one per atom its callers hand in: a library's pool and
// table names, the program's own. That count is only a bound while the
// atoms that exist are not the caller's to choose, and the site's own
// atoms are among them the moment it makes one. They are the caller's
// choice:
//
// - when an existing atom's lookup made the atom (sink_arg_chosen, or
//   call_arg_chosen at a call whose argument reaches the site): a
//   caller sends "name", then "name_desc" — the atom the first request
//   made — then "name_desc_desc", one new atom per request;
// - when a request reaches the site at all: a request carries strings,
//   and an atom made of one is a lookup's or a sink's, here or before
//   the value was kept in a process's state, which the flow does not
//   follow;
// - when the site's atoms come back to it: a function on a cycle of the
//   call graph (a recursion naming each child after its parent; not the
//   loop a comprehension compiles to, which walks its list), or the fun a
//   fold runs. Known limit: a fold's closure calling the maker hands its
//   answer back unseen (`Enum.reduce(1..n, base, fn _, a ->
//   :"#{a}.child" end)`, each answer the next call's argument).
//
// A process that keeps the atom it made in its state and makes the next
// of it is the last shape, through the runtime: its callbacks take their
// state from the program, not from a caller (runtime_callback), and it
// is not reported with or without the bound.
.decl atoms_chosen(id: symbol)

atoms_chosen(id) :- sink_arg_bounded(id, f, 0, "atoms"), sink_arg_chosen(id, f, 0).

atoms_chosen(id) :-
  sink_arg_bounded(id, _, 0, "atoms"),
  sink_flow_reaches(g, k, id),
  call_arg_chosen(_, g, k).

atoms_chosen(id) :- sink_arg_bounded(id, f, 0, "atoms"), atoms_requested(f).
atoms_chosen(id) :- sink_arg_bounded(id, f, 0, "atoms"), atoms_fed_back(f).

.init atoms_reach = CallReach

atoms_reach.seed(f, f) :- sink_arg_bounded(_, f, 0, "atoms").

.decl atoms_requested(func: symbol)

atoms_requested(f) :- request_entry(e, _), atoms_reach.reaches(e, f).

.decl atoms_fed_back(func: symbol)

atoms_fed_back(f) :-
  atoms_reach.reaches(g, f),
  call_edge(f, g),
  !comprehension_loop(f, g).

// The edge an Erlang comprehension's function makes to itself, walking
// its list: the loop the comprehension compiles to, not a way back. A
// comprehension whose body calls a function that reaches it again
// (`[{N, names(N, Sub)} || ...]`, each level's atom the next level's
// parent) is on a cycle through that function all the same.
.decl comprehension_loop(func: symbol, callee: symbol)

comprehension_loop(f, f) :-
  call_edge(f, f),
  function_def(f, _, n, _, _),
  match("-.*-l[b]?c[$].*", n).

atoms_fed_back(f) :- fold_closure(f), sink_arg_bounded(_, f, 0, "atoms").

// A closure handed to a fold, which calls it with its own last answer.
.decl fold_closure(closure: symbol)

fold_closure(c) :-
  fun_handed(id, caller, c, _),
  remote_call(id, caller, m, n, _),
  fold_api(m, n).

.decl fold_api(mod: symbol, func: symbol)

fold_api("Enum", "reduce").
fold_api("Enum", "reduce_while").
fold_api("Enum", "map_reduce").
fold_api("Enum", "flat_map_reduce").
fold_api("Enum", "scan").
fold_api("List", "foldl").
fold_api("List", "foldr").
fold_api("Stream", "iterate").
fold_api("Stream", "unfold").
fold_api("Stream", "scan").
fold_api("Stream", "transform").
fold_api(":lists", "foldl").
fold_api(":lists", "foldr").
fold_api(":lists", "mapfoldl").
fold_api(":lists", "mapfoldr").
fold_api(":maps", "fold").

// A copy of an earlier sink site: the compiler duplicated the code that
// holds it (a body shared by two clause heads), and the source has one
// call. The copy is reported as the first, once.
.decl repeated_site(id: symbol)

repeated_site(id) :- sink_copy(id, _, first), !bounded_first(first).

.decl bounded_first(id: symbol)

bounded_first(first) :- sink_copy(_, f, first), bounded_input(first, f).

// ── Reachability from a request surface ──────────────────────────

.decl request_reaches(entry: symbol, kind: symbol, func: symbol, proximity: symbol)

request_reaches(entry, kind, entry, "direct") :-
  request_entry(entry, kind).

request_reaches(entry, kind, callee, "adjacent") :-
  request_entry(entry, kind),
  call_edge(entry, callee).

// Only a function holding a sink is asked about, so the walk runs back
// from those to the entries rather than forward from every entry over
// everything it calls.
.init sink_func_reach = CallReach

sink_func_reach.seed(func, func) :- sink(_, func, _, _, _).

request_reaches(entry, kind, func, "transitive") :-
  request_entry(entry, kind),
  sink_func_reach.reaches(entry, func),
  !call_edge(entry, func),
  func != entry.

// ── Proven flow ──────────────────────────────────────────────────
//
// Backward from each sink's argument over call_arg_derived to a request
// entry, then only the parameters that carry the request count.

// ParamReach's walk, with one edge read by name: a view's dispatch on
// the template's name (Phoenix.Template's render_template/2, a clause per
// template, which render/2 calls) reaches every template, so a
// controller rendering "token.json" would flow into "_scopes.html"
// through it. The walk crosses a dispatch only to a render that names
// the template it came from, as a literal (`render("_scopes.html",
// assigns)`), through the functions that hand the name down (render/2 to
// render_template/2). Any other caller of a template — the one clause of
// a view with one template, a helper calling it directly — hands it its
// assigns as any call does. What a template's assigns carry otherwise is
// `rendered` (below), whichever controller put it there.
.decl sink_flow_seed(func: symbol, pos: number, target: symbol)
.decl sink_flow_reaches(func: symbol, pos: number, target: symbol)

sink_flow_reaches(f, p, t) :- sink_flow_seed(f, p, t).

sink_flow_reaches(f, p, t) :-
  call_arg_derived(f, g, k, p),
  sink_flow_reaches(g, k, t),
  !template_function(g).

sink_flow_reaches(f, p, t) :-
  call_arg_derived(f, g, k, p),
  sink_flow_reaches(g, k, t),
  template_function(g),
  !template_dispatch(f).

// A function that calls more than one template: a dispatch on the name.
.decl template_dispatch(func: symbol)

template_dispatch(f) :-
  call_edge(f, t1),
  template_function(t1),
  call_edge(f, t2),
  template_function(t2),
  t1 != t2.

// The assigns reach f's parameter `ap` for the template called `name`,
// and f's parameter `np` must name it: the dispatch's two parameters
// (template, assigns), and each function that hands both down.
.decl named_flow(func: symbol, ap: number, np: number, target: symbol, name: symbol)

named_flow(f, ap, 1 - ap, t, name) :-
  call_arg_derived(f, g, 0, ap),
  sink_flow_reaches(g, 0, t),
  template_function(g),
  template_dispatch(f),
  function_def(f, _, _, 2, _),
  function_def(g, _, name, 1, _),
  ap <= 1.

named_flow(c, q, r, t, name) :-
  named_flow(f, ap, np, t, name),
  call_arg_derived(c, f, ap, q),
  call_arg_forward(c, f, np, r).

sink_flow_reaches(c, q, t) :-
  named_flow(f, ap, np, t, name),
  call_arg_derived(c, f, ap, q),
  call_arg(c, f, np, cat("\"", cat(name, "\""))).

sink_flow_seed(func, pos, id) :-
  sink_site(id, func, k),
  k != "decompression",
  sink_arg_derived(id, func, _, pos).

sink_flow_seed(func, pos, id) :-
  sink_data_arg(id, func, arg),
  sink_arg_derived(id, func, arg, pos).

.decl sink_flow_from(id: symbol, entry: symbol, kind: symbol)

sink_flow_from(id, entry, kind) :-
  sink_flow_reaches(entry, pos, id),
  request_param(entry, pos),
  request_entry(entry, kind).

// ── Rendered from a template's assigns ───────────────────────────
//
// A Phoenix template compiles to a function of its assigns
// (`"_scopes.html"(assigns)`, Phoenix.Template's `name.format` naming),
// rendered once per request with what the controller put there: the
// request's params, and the records the request looked up. A sink whose
// argument is made of the template's assigns makes a value per request
// that no program text fixes, from data the request chose — its own, or a
// row it asked for by id. akkoma's OAuth authorize page makes an atom of
// each scope of the app named by `client_id`, and any client registers
// an app with scopes of its choosing (POST /api/v1/apps, no
// authentication): one atom per scope an attacker stores, for every
// visitor. The render itself reaches the template only through Phoenix's
// dispatch, which the call graph does not follow, so the path found is
// whichever call reaches the view's render/2; the flow from assigns is
// what makes it the request's. A flow from a request entry's own
// parameters stays `flow`.
.decl template_function(func: symbol)

template_function(f) :-
  function_def(f, _, name, 1, _),
  match(".*[.](html|heex|eex|json|text|xml|js|txt)", name).

.decl sink_rendered(id: symbol)

sink_rendered(id) :-
  template_function(t),
  sink_flow_reaches(t, 0, id).

// ── Findings ─────────────────────────────────────────────────────
//
// Anchored at the sink's call site, because that is where the fix
// goes, with one reaching entry point so the report can show the path
// is real. A sink reachable from several entries is one finding: the
// analysis module dedupes on the site — keeping the lexicographically
// least row, which is why a proven flow must replace the path rows for
// its site rather than sit beside them: "adjacent" sorts before "flow".

// What the sink's own function reads, when priors are on (Argus.Priors;
// off by default): a path row to a helper that converts a stored record
// is the sequin shape — real as a path, storage as data — and the
// finding says so at a step lower severity. A proven flow needs no
// prior. 0.7 is where the calibration spike measured 95% precision.

.decl sink_func_reads(func: symbol, source: symbol, permille: number)

sink_func_reads(func, source, p) :-
  sink(_, func, _, _, _),
  prior_reads(func, source, p),
  p >= 700,
  !several_sinks(func).

// A prior answers per function, not per call: of a function holding two
// sinks it cannot say which one converts what it names, and it re-tiers
// neither.
.decl several_sinks(func: symbol)

several_sinks(func) :- sink(a, func, _, _, _), sink(b, func, _, _, _), a != b.

// One arm per sink, strongest evidence first: a proven flow, else a sink
// a view renders (only the call that reaches the view's dispatch is on
// its path, so its row replaces the path rows, as a flow's does), else
// the request path, graded by what the sink's function reads.
.decl sink_reachable(id: symbol, func: symbol, api: symbol, sink: symbol, entry: symbol, kind: symbol, proximity: symbol, source: symbol, permille: number, safety: symbol)
.output sink_reachable

sink_reachable(id, func, api, s, entry, kind, "flow", "", 0, safety) :-
  sink(id, func, api, s, safety),
  sink_flow_from(id, entry, kind).

sink_reachable(id, func, api, s, entry, kind, "rendered", "", 0, safety) :-
  sink(id, func, api, s, safety),
  request_reaches(entry, kind, func, _),
  !sink_flow_from(id, _, _),
  sink_rendered(id).

sink_reachable(id, func, api, s, entry, kind, proximity, source, p, safety) :-
  sink(id, func, api, s, safety),
  request_reaches(entry, kind, func, proximity),
  !sink_flow_from(id, _, _),
  !sink_rendered(id),
  sink_func_reads(func, source, p).

sink_reachable(id, func, api, s, entry, kind, proximity, "", 0, safety) :-
  sink(id, func, api, s, safety),
  request_reaches(entry, kind, func, proximity),
  !sink_flow_from(id, _, _),
  !sink_rendered(id),
  !sink_func_reads(func, _, _).

// The same sinks where no request path exists: atom creation and code
// execution reachable from an exported function, and every unsafe
// deserialization. Reported here only, so a sink is one finding.
.init export_reach = ForwardCallReachSet

export_reach.root(func) :- api_export(func).

.decl unreached_sink(id: symbol, func: symbol, api: symbol, sink: symbol, safety: symbol)

unreached_sink(id, func, api, "code", "") :-
  sink(id, func, api, "code", ""),
  export_reach.reaches(func),
  !sink_reachable(id, _, _, _, _, _, _, _, _, _).

unreached_sink(id, func, api, "atom", "") :-
  sink(id, func, api, "atom", ""),
  export_reach.reaches(func),
  caller_input(id),
  !sink_reachable(id, _, _, _, _, _, _, _, _, _).

// What the value such a sink converts is, when priors are on
// (Argus.Priors; off by default): library API handed a pool's name, a
// dets file's own records or a mix task's command is doing what it is
// for, and the finding says so at a step lower severity; one handed a
// URL, a request's parameter or a connecting peer's name is the bug and
// keeps its severity. 0.9 of the mass away from outside data is where
// the calibration measured 98% precision (Questions.ValueSource).

.decl sink_value(func: symbol, sink: symbol, source: symbol, permille: number)

sink_value(func, s, source, p) :-
  unreached_sink(_, func, _, s, _),
  prior_value_source(func, s, source, _, p),
  p >= 900,
  !several_sinks(func).

.decl sink_without_request_path(id: symbol, func: symbol, api: symbol, sink: symbol, source: symbol, permille: number, safety: symbol)
.output sink_without_request_path

sink_without_request_path(id, func, api, s, source, p, safety) :-
  unreached_sink(id, func, api, s, safety),
  sink_value(func, s, source, p).

sink_without_request_path(id, func, api, s, "", 0, safety) :-
  unreached_sink(id, func, api, s, safety),
  !sink_value(func, s, _, _).

// ── Atoms made of what a caller hands in ─────────────────────────
//
// Reachable from an exported function says the code is live, not that a
// caller's data reaches the atom: the atom may be made of a literal, of
// configuration, of what the process read from its own state. Atom
// creation no request reaches is reported where its argument is made of
// what the program's callers hand in: a parameter of an exported function
// — the library's API, which its users call with their own input —
// reached backward from the sink's argument. The sink's argument is made
// of a parameter through the propagators ParamFlow lists
// (sink_arg_derived) or through any call of the runtime's
// (Dependence's sink_reads: `String.to_atom(Macro.underscore(name))`),
// and from there through what calls are handed (call_arg_reads, which
// carry data through any call): tesla's adapter building an atom of the
// URL's scheme, membrane parsing box names out of the file it is handed,
// absinthe_federation converting the keys of the representations its
// resolver is handed (through the closure `Map.new/2` runs on each). A
// message a client function sends its server carries the client's
// parameter into the callback's (`message_param`): an `intern(name)`
// that calls the server with `{:intern, name}`, whose handle_call/3
// makes the atom. A callback the runtime calls with the program's own
// data is not an API: a process's callbacks and init/1, Broadway's
// `process_name/2`, a protocol's implementation.
.init atom_input = ParamReadsReach

atom_input.seed(func, to_string(pos), id) :-
  sink(id, func, _, "atom", ""),
  sink_arg_derived(id, func, 0, pos).

atom_input.seed(func, p, id) :-
  sink(id, func, _, "atom", ""),
  sink_reads(id, func, 0, "param", p).

// Made of what a local helper returns of its own parameter.
atom_input.seed(func, p, id) :-
  sink(id, func, _, "atom", ""),
  sink_reads(id, func, 0, "call", g),
  returns_reads(g, "param", q),
  call_arg_reads(func, g, n, "param", p),
  q = to_string(n).

atom_input.reaches(f, p, t) :- message_param(f, p, h), atom_input.reaches(h, "0", t).

// A client function calls (or casts to) a server running `mod`'s
// callbacks with a message made of its parameter `pos`: the message is
// the callback's first parameter.
.decl message_param(client: symbol, pos: symbol, callback: symbol)

message_param(f, to_string(p), h) :-
  call_arg_derived(f, api, 1, p),
  sync_api(api),
  sync_call_site(_, f, m, _),
  function_def(h, m, "handle_call", 3, _).

message_param(f, to_string(p), h) :-
  call_arg_derived(f, api, 1, p),
  cast_api(api),
  async_cast(f, m),
  function_def(h, m, "handle_cast", 2, _).

.decl sync_api(api: symbol)

sync_api("GenServer:call/2").
sync_api("GenServer:call/3").
sync_api(":gen_server:call/2").
sync_api(":gen_server:call/3").

.decl cast_api(api: symbol)

cast_api("GenServer:cast/2").
cast_api(":gen_server:cast/2").

.decl caller_input(id: symbol)

caller_input(id) :- atom_input.reaches(f, _, id), outside_api(f).

// An exported function: the library's users can call it with anything,
// whether or not the program also calls it itself (an Ecto type's
// cast/1, which the program calls once with a literal default). As
// failure's `exposed` roots, every export is an entry. A macro is not:
// the compiler calls it, with the code that uses it, and what it makes
// it makes at compile time.
.decl outside_api(func: symbol)

outside_api(f) :-
  api_export(f),
  function_def(f, m, n, a, _),
  !runtime_callback(m, n, a),
  !function_def(_, m, "__impl__", 1, _).

// A protocol's implementation is called with what the protocol's own
// function is handed: dispatch relays it. The implementation of a
// protocol the program defines is a way in when that function is
// (a library's `MyLib.Key.to_key/1`, whose BitString implementation
// makes an atom of the users' string). An implementation of a protocol
// the program does not define is the runtime's or a library's to call,
// with the program's own values (`Inspect`, `String.Chars`,
// `Phoenix.Param`), and is not one.
outside_api(f) :-
  function_def(f, m, n, a, _),
  implements_protocol(m, p),
  function_def(pf, p, n, a, _),
  outside_api(pf).

// `m` implements the protocol `p` the program defines: `defimpl`'s
// module, named `p` then the implementation's type, which compiles
// `__impl__/1`; `p` compiles `__protocol__/1`. The name is `p` and a dot
// first (the pattern, whose dots take any character, from the start;
// the literal prefix somewhere: substr is a partial functor).
.decl implements_protocol(impl: symbol, protocol: symbol)

implements_protocol(m, p) :-
  function_def(_, m, "__impl__", 1, _),
  function_def(_, p, "__protocol__", 1, _),
  match(cat(p, "[.].*"), m),
  contains(cat(p, "."), m).

// What the runtime calls a process module with: its own start arguments,
// its own messages, its own name. A process's callbacks that take them
// (otp_callback and message_callback, clientlib/callbacks.dl; not a
// LiveView's handle_event/3, which takes the client's), and Broadway's
// process_name/2, which the topology calls with the pipeline's own name
// when it starts.
//
// Not a process's handle_info/2 when the process makes a socket active:
// the bytes a peer sends arrive as its messages (`{:tcp, socket, data}`),
// an outside party's data — a Ranch protocol written as a gen_server
// loop, a GenServer holding a client connection. Any activation counts,
// a mode the bytecode does not show included (mailbox's rules ask the
// opposite question, whether a message surely arrives, and read only the
// modes it can see): the runtime's call is the program's own only where
// nothing says a socket feeds it.
.decl runtime_callback(mod: symbol, name: symbol, arity: number)

runtime_callback(m, n, a) :-
  otp_callback(f, m, n, _),
  message_callback(n),
  function_def(f, m, n, a, _),
  !socket_messages(m, n).

.decl socket_messages(mod: symbol, callback: symbol)

socket_messages(m, "handle_info") :-
  socket_active(_, f, _, mode, _),
  mode != "false",
  mode != "unset",
  function_def(f, m, _, _, _).

runtime_callback(m, "process_name", 2) :-
  behaves_as(m, "Broadway"),
  function_def(_, m, "process_name", 2, _).

// ── Decompression of what a caller hands in ──────────────────────
//
// As atoms: reported with no request path where the compressed data is
// made of a parameter of an exported function (tesla's
// Compression middleware inflating the response body its `call/3` is
// handed, a client library's decompress of what its users pass).
.init inflate_input = ParamReadsReach

inflate_input.seed(func, to_string(pos), id) :-
  sink(id, func, _, "decompression", ""),
  sink_data_arg(id, func, arg),
  sink_arg_derived(id, func, arg, pos).

inflate_input.seed(func, p, id) :-
  sink(id, func, _, "decompression", ""),
  sink_data_arg(id, func, arg),
  sink_reads(id, func, arg, "param", p).

.decl inflate_caller_input(id: symbol)

inflate_caller_input(id) :- inflate_input.reaches(f, _, id), outside_api(f).

unreached_sink(id, func, api, "decompression", "") :-
  sink(id, func, api, "decompression", ""),
  export_reach.reaches(func),
  inflate_caller_input(id),
  !sink_reachable(id, _, _, _, _, _, _, _, _, _).

unreached_sink(id, func, api, "deserialization", safety) :-
  sink(id, func, api, "deserialization", safety),
  !sink_reachable(id, _, _, _, _, _, _, _, _, _).

// The exported functions the sink is reachable from, walked back from
// the sink a few calls: evidence for "the module's public surface
// reaches it". The sink's own function, when exported, is the finding's
// anchor already.
.init sink_callers = BackwardBoundedCallReach

sink_callers.root(func, func) :- unreached_sink(_, func, _, _, _).
sink_callers.limit(6).

.decl sink_export(sink: symbol, export: symbol)
.output sink_export

.decl sink_export_reach(sink: symbol, export: symbol)

sink_export_reach(id, e) :-
  unreached_sink(id, func, _, _, _),
  sink_callers.reaches(func, e, d),
  d > 0,
  api_export(e).

sink_export(id, e) :-
  sink_export_reach(id, e),
  !forwards_to_listed_arity(id, e).

// An export that calls a higher arity of itself, which is listed too: a
// default-argument head (`start_link/0` calling `start_link/1` from the
// same `def` line), or a wrapper filling in an option. Its frame would
// say what the higher arity's says, and take one of the three.
.decl forwards_to_listed_arity(sink: symbol, export: symbol)

forwards_to_listed_arity(id, e) :-
  sink_export_reach(id, e),
  function_def(e, m, name, n, _),
  call_edge(e, g),
  function_def(g, m, name, k, _),
  k > n,
  sink_export_reach(id, g).

// ── Which HTTP endpoint reaches the sink ─────────────────────────
//
// "Reachable from a plug entry point" is a claim a reader has to go and
// check; "reachable from GET /public/sessions/:id/assets/..." is one
// they can act on. Routes come from Phoenix's `__routes__/0` literal.
// `pipe_through` is not in it — pipelines compile into the dispatch
// function as control flow — so this does NOT say whether the route is
// authenticated. The path is often the tell, and that judgement stays
// with the reader.

.decl sink_endpoint(sink: symbol, verb: symbol, path: symbol, plug: symbol)
.output sink_endpoint

// Callers only: the function holding the sink is not itself an endpoint.
.init sink_reach = CallReach

sink_reach.seed(f, sink) :-
  call_edge(f, g),
  (unsafe_atom_creation(sink, g, _) ; unsafe_deserialization(sink, g, _, _) ;
   unsafe_decompression(sink, g, _, _)).

sink_endpoint(sink, verb, path, plug) :-
  http_route(_, verb, path, plug, _),
  function_def(entry, plug, _, _, _),
  sink_reach.reaches(entry, sink).

// ── Processes an outside party can create without limit ──────────
//
// DynamicSupervisor defaults to max_children: :infinity, and the default
// is what everyone uses. On its own that is fine: most dynamic
// supervisors are driven by trusted callers. The finding is the pairing:
// can start_child be reached from a request handler? Then an
// unauthenticated request creates a process and nothing bounds how many.
// No single line is wrong, which is why the supervisor and the handler
// each read fine in isolation.

// `supervisor_max_children` is emitted only when a finite cap is set, so
// absence is the question. A supervisor held as a pid ("dynamic") has no
// init/1 to read the cap from; process points-to does not follow
// start_child's supervisor argument, which is not a pid use. A supervisor whose init/1 could not be read
// emits no cap either, which counts as uncapped — the conservative
// direction for a resource bound, and the one that matches the default.
.decl uncapped_supervisor(sup: symbol)

uncapped_supervisor(sup) :-
  dynamic_child(sup, _, _),
  sup != "dynamic",
  !supervisor_max_children(sup, _).

.decl externally_reachable(func: symbol, entry: symbol, kind: symbol)

// Backwards from the functions that start dynamic children, so only
// their callers are explored.
.init start_reach = CallReach

start_reach.seed(via, via) :- dynamic_child(_, _, via).

externally_reachable(via, entry, kind) :-
  request_entry(entry, kind),
  start_reach.reaches(entry, via).

.decl unbounded_children_from_request(sup: symbol, child: symbol, via: symbol, kind: symbol)
.output unbounded_children_from_request

unbounded_children_from_request(sup, child, via, kind) :-
  uncapped_supervisor(sup),
  dynamic_child(sup, child, via),
  externally_reachable(via, _, kind),
  !disabled_transport(sup),
  !stream_only(via, child),
  !awaits_child_exit(via).

// A start whose caller then waits for the child's :DOWN (awaits_child_exit:
// Livebook's UniqueTask.run/2 monitors what it started and blocks until
// it exits) keeps no more children alive than it has callers waiting.

// Tasks the request's own enumeration runs: Task.Supervisor's
// async_stream and async_stream_nolink start at most max_concurrency
// tasks at a time for the process that enumerates the stream, and it
// waits for each, so what they start lives no longer than the request —
// when the request's own process enumerates it. Reached through a start
// (a `Task.start(fn -> fan_out(ids) end)` from handle_event/3,
// runs_elsewhere) the stream runs in a process the request does not wait
// for, and each request adds another max_concurrency tasks beside the
// last. A function that also starts tasks another way keeps its row: the
// Task dynamic_child row is per function, not per call (TaskLive fires,
// StreamLive is quiet).
.decl stream_only(via: symbol, child: symbol)

stream_only(via, "Task") :-
  task_supervisor_start(_, via, op),
  task_supervisor_op(op, "stream"),
  !starts_tasks_otherwise(via),
  !streams_detached(via).

.decl starts_tasks_otherwise(via: symbol)

starts_tasks_otherwise(via) :-
  task_supervisor_start(_, via, op),
  task_supervisor_op(op, "one").

// A request reaches the streaming function through an edge off its own
// stack: some function a request reaches starts (or keeps) a fun whose
// code reaches it. Or the streaming function itself starts one, which
// may enumerate the stream it built (a stream is lazy: its tasks start
// where it is run, `Task.start(fn -> Stream.run(stream) end)`). Known
// limit: a stream handed back to a caller that runs it in a process of
// its own reads as enumerated by the request.
.init detach_reach = CallReach

detach_reach.seed(f, via) :-
  task_supervisor_start(_, via, op),
  task_supervisor_op(op, "stream"),
  runs_elsewhere(f, g),
  start_reach.reaches(g, via).

.decl streams_detached(via: symbol)

streams_detached(via) :- request_entry(entry, _), detach_reach.reaches(entry, via).

streams_detached(via) :-
  task_supervisor_start(_, via, op),
  task_supervisor_op(op, "stream"),
  runs_elsewhere(via, _).

// A dangerous path in a dependency is not a finding when nothing turns
// it on. Phoenix's long-poll transport starts a process per
// unauthenticated request with no ceiling, and it was reported in three
// projects while being enabled in exactly one. `Phoenix.Endpoint`'s
// `socket/3` is a macro, so its options compile into `__sockets__/0` as
// a literal, readable the same way as the TLS option lists: config is
// visible when a macro bakes it into the module and invisible when it
// is read at runtime.
.decl transport_supervisor(sup: symbol, transport: symbol)

transport_supervisor("Phoenix.Transports.LongPoll.Supervisor", "longpoll").

.decl disabled_transport(sup: symbol)

disabled_transport(sup) :-
  transport_supervisor(sup, transport),
  !socket_transport(_, _, transport).
