// Attacker-shaped data reaching a sink.
//
// Three sinks matter on the BEAM: atom creation (the atom table is
// fixed-size and never collected, so distinct attacker-supplied values
// kill the node), deserialization (binary_to_term materializes funs,
// ports and references), and code execution. One relation, with the
// proximity to a request surface as a column, says how exposed each
// sink is:
//
//   direct      the sink is in a request-handling callback, operating
//               on the callback's own arguments — which ARE the request
//   adjacent    one call away: the callback passed something to it
//   transitive  anywhere else in the callback's cone — a path, not a
//               proven flow
//   flow        request DATA reaches the sink's argument: one of the
//               entry's request-carrying parameters, through
//               destructuring, string building and forwarding — a
//               proven flow, whatever the distance
//
// Reachability is not taint. Verified the hard way on sequin, where
// every transitive hit sourced its input from Postgres or Redis rather
// than the request, reached only because a LiveView happens to load
// those records. A sink inside the callback is another matter. The flow
// proximity is the answer to that: the per-function summaries
// (call_arg_derived, sink_arg_derived) are computed from reaching
// definitions in Elixir, and Souffle only chains them backward from the
// sink. A flow the summaries cannot see — a value laundered through a
// local helper's return, an element handed to a closure — stays a path,
// so the absence of a flow row is not evidence the data comes from
// elsewhere.
//
// A sink no request reaches is reported once, on its own: unsafe atom
// creation and code execution when some exported function reaches it
// (in a library that is very nearly everything, so this is "is this
// code live", not "can an attacker reach it"), and every
// deserialization without :safe, since the caller's input is the
// question. Entry points are identified by OTP behaviour plus callback
// name/arity, which is exactly the information beam attributes carry.

.include "../clientlib/imports.dl"
.include "../clientlib/behaviours.dl"
.include "../clientlib/request_entry.dl"

// ── The sinks ────────────────────────────────────────────────────

// `safety` is the deserialization's option class — unsafe, atoms_only
// ([:safe] passed: no new atoms, but a fun referencing a loaded module
// still runs when the term is used) or dynamic — and empty for the other
// sinks. It reaches the finding so the text can say which.
.decl sink(id: symbol, func: symbol, api: symbol, kind: symbol, safety: symbol)

sink(id, func, api, "atom", "") :- unsafe_atom_creation(id, func, api).
sink(id, func, api, "code", "") :- code_execution(id, func, api).

sink(id, func, api, "deserialization", safety) :-
  unsafe_deserialization(id, func, api, safety),
  unsafe_safety_class(safety).

// ── Reachability from a request surface ──────────────────────────

.decl request_reaches(entry: symbol, kind: symbol, func: symbol, proximity: symbol)

request_reaches(entry, kind, entry, "direct") :-
  request_entry(entry, kind).

request_reaches(entry, kind, callee, "adjacent") :-
  request_entry(entry, kind),
  call_edge(entry, callee).

// Only a function holding a sink is asked about, so the walk runs back
// from those to the entries rather than forward from every entry over
// everything it calls.
.init sink_func_reach = CallReach

sink_func_reach.seed(func, func) :- sink(_, func, _, _, _).

request_reaches(entry, kind, func, "transitive") :-
  request_entry(entry, kind),
  sink_func_reach.reaches(entry, func),
  !call_edge(entry, func),
  func != entry.

// ── Proven flow ──────────────────────────────────────────────────
//
// Backward from each sink's argument over call_arg_derived to a request
// entry, then only the parameters that carry the request count.

.init sink_flow = ParamReach

sink_flow.seed(func, pos, id) :-
  sink(id, func, _, _, _),
  sink_arg_derived(id, func, _, pos).

.decl sink_flow_from(id: symbol, entry: symbol, kind: symbol)

sink_flow_from(id, entry, kind) :-
  sink_flow.reaches(entry, pos, id),
  request_param(entry, pos),
  request_entry(entry, kind).

// ── Findings ─────────────────────────────────────────────────────
//
// Anchored at the sink's call site, because that is where the fix
// goes, with one reaching entry point so the report can show the path
// is real. A sink reachable from several entries is one finding: the
// analysis module dedupes on the site — keeping the lexicographically
// least row, which is why a proven flow must replace the path rows for
// its site rather than sit beside them: "adjacent" sorts before "flow".

// What the sink's own function reads, when priors are on (Argus.Priors;
// off by default): a path row to a helper that converts a stored record
// is the sequin shape — real as a path, storage as data — and the
// finding says so at a step lower severity. A proven flow needs no
// prior. 0.7 is where the calibration spike measured 95% precision.

.decl sink_func_reads(func: symbol, source: symbol, permille: number)

sink_func_reads(func, source, p) :-
  sink(_, func, _, _, _),
  prior_reads(func, source, p),
  p >= 700.

.decl sink_reachable(id: symbol, func: symbol, api: symbol, sink: symbol, entry: symbol, kind: symbol, proximity: symbol, source: symbol, permille: number, safety: symbol)
.output sink_reachable

sink_reachable(id, func, api, s, entry, kind, "flow", "", 0, safety) :-
  sink(id, func, api, s, safety),
  sink_flow_from(id, entry, kind).

sink_reachable(id, func, api, s, entry, kind, proximity, source, p, safety) :-
  sink(id, func, api, s, safety),
  request_reaches(entry, kind, func, proximity),
  !sink_flow_from(id, _, _),
  sink_func_reads(func, source, p).

sink_reachable(id, func, api, s, entry, kind, proximity, "", 0, safety) :-
  sink(id, func, api, s, safety),
  request_reaches(entry, kind, func, proximity),
  !sink_flow_from(id, _, _),
  !sink_func_reads(func, _, _).

// The same sinks where no request path exists: atom creation and code
// execution reachable from an exported function, and every unsafe
// deserialization. Reported here only, so a sink is one finding.
.init export_reach = ForwardCallReachSet

export_reach.root(func) :- function_def(func, _, _, _, 1).

.decl sink_without_request_path(id: symbol, func: symbol, api: symbol, sink: symbol, safety: symbol)
.output sink_without_request_path

sink_without_request_path(id, func, api, s, "") :-
  sink(id, func, api, s, ""),
  (s = "atom" ; s = "code"),
  export_reach.reaches(func),
  !sink_reachable(id, _, _, _, _, _, _, _, _, _).

sink_without_request_path(id, func, api, "deserialization", safety) :-
  sink(id, func, api, "deserialization", safety),
  !sink_reachable(id, _, _, _, _, _, _, _, _, _).

// The exported functions the sink is reachable from, walked back from
// the sink a few calls: evidence for "the module's public surface
// reaches it". The sink's own function, when exported, is the finding's
// anchor already.
.init sink_callers = BackwardBoundedCallReach

sink_callers.root(func, func) :- sink_without_request_path(_, func, _, _, _).
sink_callers.limit(6).

.decl sink_export(sink: symbol, export: symbol)
.output sink_export

sink_export(id, e) :-
  sink_without_request_path(id, func, _, _, _),
  sink_callers.reaches(func, e, d),
  d > 0,
  function_def(e, _, _, _, 1).

// ── Which HTTP endpoint reaches the sink ─────────────────────────
//
// "Reachable from a plug entry point" is a claim a reader has to go and
// check; "reachable from GET /public/sessions/:id/assets/..." is one
// they can act on. Routes come from Phoenix's `__routes__/0` literal.
// `pipe_through` is not in it — pipelines compile into the dispatch
// function as control flow — so this does NOT say whether the route is
// authenticated. The path is often the tell, and that judgement stays
// with the reader.

.decl sink_endpoint(sink: symbol, verb: symbol, path: symbol, plug: symbol)
.output sink_endpoint

// Callers only: the function holding the sink is not itself an endpoint.
.init sink_reach = CallReach

sink_reach.seed(f, sink) :-
  call_edge(f, g),
  (unsafe_atom_creation(sink, g, _) ; unsafe_deserialization(sink, g, _, _)).

sink_endpoint(sink, verb, path, plug) :-
  http_route(_, verb, path, plug, _),
  function_def(entry, plug, _, _, _),
  sink_reach.reaches(entry, sink).

// ── Processes an outside party can create without limit ──────────
//
// DynamicSupervisor defaults to max_children: :infinity, and the default
// is what everyone uses. On its own that is fine: most dynamic
// supervisors are driven by trusted callers. The finding is the pairing:
// can start_child be reached from a request handler? Then an
// unauthenticated request creates a process and nothing bounds how many.
// No single line is wrong, which is why the supervisor and the handler
// each read fine in isolation.

// `supervisor_max_children` is emitted only when a finite cap is set, so
// absence is the question. A supervisor whose init/1 could not be read
// emits no cap either, which counts as uncapped — the conservative
// direction for a resource bound, and the one that matches the default.
.decl uncapped_supervisor(sup: symbol)

uncapped_supervisor(sup) :-
  dynamic_child(sup, _, _),
  sup != "dynamic",
  !supervisor_max_children(sup, _).

.decl externally_reachable(func: symbol, entry: symbol, kind: symbol)

// Backwards from the functions that start dynamic children, so only
// their callers are explored.
.init start_reach = CallReach

start_reach.seed(via, via) :- dynamic_child(_, _, via).

externally_reachable(via, entry, kind) :-
  request_entry(entry, kind),
  start_reach.reaches(entry, via).

.decl unbounded_children_from_request(sup: symbol, child: symbol, via: symbol, kind: symbol)
.output unbounded_children_from_request

unbounded_children_from_request(sup, child, via, kind) :-
  uncapped_supervisor(sup),
  dynamic_child(sup, child, via),
  externally_reachable(via, _, kind),
  !disabled_transport(sup).

// A dangerous path in a dependency is not a finding when nothing turns
// it on. Phoenix's long-poll transport starts a process per
// unauthenticated request with no ceiling, and it was reported in three
// projects while being enabled in exactly one. `Phoenix.Endpoint`'s
// `socket/3` is a macro, so its options compile into `__sockets__/0` as
// a literal, readable the same way as the TLS option lists: config is
// visible when a macro bakes it into the module and invisible when it
// is read at runtime.
.decl transport_supervisor(sup: symbol, transport: symbol)

transport_supervisor("Phoenix.Transports.LongPoll.Supervisor", "longpoll").

.decl disabled_transport(sup: symbol)

disabled_transport(sup) :-
  transport_supervisor(sup, transport),
  !socket_transport(_, _, transport).
