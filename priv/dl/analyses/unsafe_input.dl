// Unsafe atom creation, deserialization, decompression, code execution and subprocesses
// reachable from requests. Evidence distinguishes direct/adjacent/transitive call paths from
// proven argument flow (`flow`). Reachability alone does not establish
// attacker-controlled data.
// Flow chains per-function argument summaries backward from sinks. Missing flow
// evidence may reflect unsupported returns, captures, or stored state; it does not
// prove safe input.
// Outside request paths, report live code-execution sinks, atom creation, decompression
// and subprocesses fed by external caller parameters, and deserialization without :safe.
// Export reach establishes liveness, not attacker access. Request entries use behaviour
// and callback signatures.

.include "../clientlib/imports.dl"
.include "../clientlib/behaviours.dl"
.include "../clientlib/callbacks.dl"
.include "../clientlib/request_entry.dl"
.include "../clientlib/runs_elsewhere.dl"
.include "../clientlib/supervision.dl"
.include "../clientlib/tooling.dl"
.include "../clientlib/etf_allocation.dl"
.include "../clientlib/verification.dl"
.include "../clientlib/code_injection.dl"
.include "../clientlib/sql_injection.dl"
.include "../clientlib/html_injection.dl"
.include "../clientlib/path_traversal.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ── A sink a request reaches ─────────────────────────────────────

// An unbounded sink reached through request-data flow, template assigns, or a
// request-handler call path.
.decl request_reached_sink(id: symbol, func: symbol, entry: symbol, kind: symbol, evidence: symbol)

request_reached_sink(id, func, entry, kind, evidence) :-
  sink(id, func, _, _, _),
  reached_by_request(id, func, entry, kind, evidence),
  !config_path(id, evidence),
  !fixed_command_path(id, evidence).

// ── Configuration, not the request ───────────────────────────────

// A path a request takes to an atom or deserialization sink whose argument is made of
// the application's configuration alone: what the host configured, its code. Only a
// path is dropped (adjacent or transitive); a request's own data at the sink is a flow
// and stays, and a sink in the callback itself operates on the request.
.decl config_path(id: symbol, evidence: symbol)

config_path(id, evidence) :-
  config_candidate(id, evidence),
  config_reaches(id),
  !other_source(id).

.decl config_candidate(id: symbol, evidence: symbol)

config_candidate(id, evidence) :-
  sink(id, func, _, kind, _),
  (kind = "atom" ; kind = "deserialization"),
  reached_by_request(id, func, _, _, evidence),
  (evidence = "adjacent" ; evidence = "transitive").

// The functions and parameters the sink's argument is made of, backward over
// call_arg_derived (closures' captures and handed elements included). Unlike
// sink_flow_reaches, no template is skipped: a wider chain asks more sources.
.decl config_chain(func: symbol, pos: number, id: symbol)

config_chain(f, p, id) :-
  config_candidate(id, _),
  sink_arg_derived(id, f, 0, p).

config_chain(f, p, id) :- call_arg_derived(f, g, k, p), config_chain(g, k, id).

// An application environment read reaches the argument (ParamFlow's config origin).
.decl config_reaches(id: symbol)

config_reaches(id) :- config_candidate(id, _), sink_arg_config(id, _, 0).
config_reaches(id) :- config_chain(g, k, id), call_arg_config(_, g, k).

// Something other than configuration may reach the argument: a result of a call
// outside the runtime or of a shared-state operation (Dependence's sources, which see
// through the runtime's calls), a parameter ParamFlow does not follow, an unresolved
// fun's result, an atom an existing-atom lookup chose, or a parameter of an export,
// whose callers argus does not see. Known limits: a value a fun handed to a helper is
// called with is followed by neither extractor, and a runtime call's result carries only
// its arguments in Dependence, so a fresh value (`make_ref/0`) beside the config is not
// seen either.
.decl other_source(id: symbol)

other_source(id) :- config_candidate(id, _), sink_reads(id, _, 0, kind, _), kind != "param".

other_source(id) :-
  config_candidate(id, _),
  sink_reads(id, f, 0, "param", p),
  !sink_param_followed(id, f, p).

other_source(id) :- config_candidate(id, _), call_arg_runtime(id, _, 0, _, _).
other_source(id) :- config_candidate(id, _), sink_arg_chosen(id, _, 0).

other_source(id) :-
  config_chain(g, k, id),
  call_arg_reads(_, g, k, kind, _),
  kind != "param".

other_source(id) :-
  config_chain(g, k, id),
  call_arg_reads(c, g, k, "param", q),
  !call_param_followed(c, g, k, q).

other_source(id) :-
  config_chain(g, k, id),
  local_call(site, c, g, _),
  call_arg_runtime(site, c, k, _, _).

other_source(id) :- config_chain(g, k, id), call_arg_chosen(_, g, k).
other_source(id) :- config_chain(g, _, id), api_export(g).

// ParamFlow's parameters, spelled as Dependence spells its sources.
.decl sink_param_followed(id: symbol, func: symbol, param: symbol)

sink_param_followed(id, f, to_string(p)) :-
  config_candidate(id, _),
  sink_arg_derived(id, f, 0, p).

.decl call_param_followed(caller: symbol, callee: symbol, pos: number, param: symbol)

call_param_followed(c, g, k, to_string(q)) :-
  config_chain(g, k, _),
  call_arg_derived(c, g, k, q).

// One unbounded sink per source call. Deserialization `safety` is unsafe, atoms_only
// ([:safe], preventing new atoms but not unsafe use of decoded terms), or dynamic.
// Other sink kinds leave it empty.
.decl sink(id: symbol, func: symbol, api: symbol, kind: symbol, safety: symbol)

sink(id, func, api, kind, safety) :-
  sink_call(id, func, api, kind, safety),
  !bounded_sink_input(id, func, kind),
  !repeated_site(id).

// Seed flow at all four sink kinds, including bounded candidates, because request reach
// can invalidate an existing-atom bound. Include only deserialization classes capable
// of creating atoms or funs.
.decl sink_call(id: symbol, func: symbol, api: symbol, kind: symbol, safety: symbol)

sink_call(id, func, api, "atom", "") :- unsafe_atom_creation(id, func, api).
sink_call(id, func, api, "code", "") :- code_execution(id, func, api), !command_api(api).
sink_call(id, func, api, "command", "") :- code_execution(id, func, api), command_api(api).
sink_call(id, func, api, "decompression", "") :- unsafe_decompression(id, func, api, _).

sink_call(id, func, api, "deserialization", safety) :-
  unsafe_deserialization(id, func, api, safety),
  unsafe_safety_class(safety),
  !inert_decoded_term(id, func),
  !server_authored_bytes(id, func).

// The bytes are an authenticated decryption's or MAC check's success payload
// (clientlib/verification.dl): only a holder of the server's key could have written
// them, so the term decoded is one the server encoded, wherever the ciphertext came
// from. The payload is decoded where it is checked, or handed to a private function
// whose every caller hands it one at that parameter (one hop; a capture or a fun
// reference is a caller that hands nothing known).
.decl server_authored_bytes(id: symbol, func: symbol)

server_authored_bytes(id, func) :-
  unsafe_deserialization(id, func, _, _),
  authenticated_arg(id, func, 0).

server_authored_bytes(id, func) :-
  unsafe_deserialization(id, func, _, _),
  decoded_bytes_value(id, func, 0, q, "", _),
  q >= 0,
  authenticated_param(func, q).

// Argument `pos` of the call `id` is exactly an authenticated payload its own function
// received (decoded_bytes_value: a join with any other value has no row).
.decl authenticated_arg(id: symbol, func: symbol, pos: number)

authenticated_arg(id, func, pos) :-
  decoded_bytes_value(id, func, pos, -1, api, path),
  authenticated_payload_api(api),
  authenticated_payload_path(path).

// Parameter `pos` of a private function holds an authenticated payload on every call.
.decl authenticated_param(func: symbol, pos: number)

authenticated_param(f, q) :-
  decoded_param(f, q),
  function_def(f, _, _, _, 0),
  local_call(_, _, f, _),
  !unauthenticated_caller(f, q).

// A deserialization's bytes are exactly parameter `pos` of its function.
.decl decoded_param(func: symbol, pos: number)

decoded_param(f, q) :-
  unsafe_deserialization(id, f, _, _),
  decoded_bytes_value(id, f, 0, q, "", _),
  q >= 0.

.decl unauthenticated_caller(func: symbol, pos: number)

unauthenticated_caller(f, q) :-
  decoded_param(f, q),
  local_call(site, c, f, _),
  !authenticated_arg(site, c, q).

// A capture, a fun reference or a resolved apply runs the function with arguments no
// call site shows, even in a function that also calls it directly.
unauthenticated_caller(f, q) :-
  decoded_param(f, q),
  (closure_def(_, f) ; fun_ref(_, f) ; resolved_apply(_, _, f)).

// Recursive validation protects the exact accepted decoded payload. Rejected error
// envelopes can be returned unchanged, but their payload cannot be reused unchecked.
// Validation does not undo atom creation, and compressed ETF is reported independently.
.decl inert_decoded_term(id: symbol, func: symbol)

inert_decoded_term(id, func) :-
  unsafe_deserialization(id, func, _, "atoms_only"),
  decoded_term_validated(id, func).

// Apply allowlist suppression to atom and deserialization arguments only. A bounded
// code module does not bound its function, and a decompression's size safety requires
// streaming APIs, excluded from sinks; a decoder of the program's own literal bytes
// decodes no input at all (`constant_input`). A command is bounded when the module's
// helpers and callers hand its shell or interpreter literal arguments, or `mix` a
// task that runs no code (`command_fixed`).
.decl bounded_sink_input(id: symbol, func: symbol, kind: symbol)

bounded_sink_input(id, func, "command") :-
  sink_call(id, func, _, "command", _),
  command_fixed(id, func).

bounded_sink_input(id, func, "atom") :- sink_call(id, func, _, "atom", _), bounded_input(id, func).

bounded_sink_input(id, func, "deserialization") :-
  sink_call(id, func, _, "deserialization", _),
  bounded_input(id, func).

bounded_sink_input(id, func, kind) :-
  sink_call(id, func, _, kind, _),
  (kind = "deserialization" ; kind = "decompression"),
  constant_input(id).

// Constant input
//
// The bytes a deserialization or decompression decodes are made of parameters alone,
// each one the program fills with a literal at every call it makes: a module attribute
// built at compile time (`@payload`), a literal binary. An exported decoder is judged
// by the calls the program makes to it; one the program never calls has no such
// evidence and keeps its finding. What the argument is made of is Dependence's answer
// (`sink_reads`); a value it does not see beside the parameter, such as a received
// message, is a known limit, as it is for `other_source`.
.decl constant_input(id: symbol)

constant_input(id) :-
  decoded_input(id, func, pos),
  sink_reads(id, func, pos, "param", _),
  !varying_input(id).

// The argument a decoding sink reads its bytes from.
.decl decoded_input(id: symbol, func: symbol, pos: number)

decoded_input(id, func, 0) :- unsafe_deserialization(id, func, _, _).
decoded_input(id, func, pos) :- unsafe_decompression(id, func, _, pos).

// Something other than a literal-fed parameter reaches the decoded argument.
.decl varying_input(id: symbol)

varying_input(id) :-
  decoded_input(id, func, pos),
  sink_reads(id, func, pos, kind, _),
  kind != "param".

varying_input(id) :-
  decoded_input(id, func, pos),
  sink_reads(id, func, pos, "param", p),
  !literal_fed(func, p).

varying_input(id) :- decoded_input(id, func, pos), call_arg_runtime(id, func, pos, _, _).

// The parameters `literal_fed` is asked of: a decoding sink's, and an exported ETF
// decoder's that caller-derived bytes reach (`etf_has_external_input`).
.decl literal_fed_candidate(func: symbol, param: symbol)

literal_fed_candidate(f, p) :- decoded_input(id, f, pos), sink_reads(id, f, pos, "param", p).

literal_fed_candidate(f, p) :- etf_outside_param(f, _, p).

// Every call the program makes to `func` hands its parameter `param` a literal, and there
// is at least one. CallArgs resolves the first four arguments only.
.decl literal_fed(func: symbol, param: symbol)

literal_fed(f, p) :-
  literal_fed_candidate(f, p),
  call_arg(_, f, q, v),
  p = to_string(q),
  v != "dynamic",
  !unliteral_call(f, p).

// A caller hands `func` something other than a literal at `param` on some call, or
// reaches it without a call site argus reads: a capture, a fun handed on, an apply.
.decl unliteral_call(func: symbol, param: symbol)

unliteral_call(f, p) :- literal_fed_candidate(f, p), call_edge(c, f), !literal_call(c, f, p).

unliteral_call(f, p) :-
  literal_fed_candidate(f, p),
  (closure_def(_, f) ; fun_ref(_, f) ; resolved_apply(_, _, f)).

// Every call from `caller` to `callee` hands it a literal at `param`.
.decl literal_call(caller: symbol, callee: symbol, param: symbol)

literal_call(c, f, p) :-
  literal_fed_candidate(f, p),
  call_arg(c, f, q, v),
  p = to_string(q),
  v != "dynamic",
  !call_arg(c, f, q, "dynamic"),
  !call_arg_forward(c, f, q, _).

// The argument a decompression reads: the compressed data, not the
// zstream `inflate/2` takes first (which lives in the handler's state).
.decl sink_data_arg(id: symbol, func: symbol, pos: number)

sink_data_arg(id, func, pos) :- unsafe_decompression(id, func, _, pos).

// Bounded sink input
//
// Suppress arguments restricted on every path to program-defined values. A parameter
// allowlist qualifies only when every caller passes a literal list. Check argument 0,
// used by atom and deserialization sinks (`bounded_sink_input`).
.decl bounded_input(id: symbol, func: symbol)

bounded_input(id, f) :- sink_arg_bounded(id, f, 0, "").

// Exactly an existing atom's name (`String.to_atom(Atom.to_string(a))`): the conversion
// returns that atom and makes none, whoever chose it and however often it runs. Only an
// atom sink has the row.
bounded_input(id, f) :- sink_arg_bounded(id, f, 0, "atom").

bounded_input(id, f) :-
  sink_arg_bounded(id, f, 0, "atoms"),
  !atoms_chosen(id).

bounded_input(id, f) :-
  sink_arg_bounded(id, f, 0, q),
  allowlist_param(q),
  call_edge(_, f),
  !unlisted_caller(f, q).

// A `list_param` naming the function's list parameter, not a bound of its own.
.decl allowlist_param(q: symbol)

allowlist_param(q) :- sink_arg_bounded(_, _, 0, q), q != "", q != "atom", q != "atoms".

// A caller of `func` hands its allowlist parameter `pos` something other
// than a literal list.
.decl unlisted_caller(func: symbol, pos: symbol)

unlisted_caller(f, q) :-
  sink_arg_bounded(_, f, 0, q),
  allowlist_param(q),
  call_edge(c, f),
  !allowlist_at(c, f, q).

// The caller hands the callee's parameter `pos` a literal list.
.decl allowlist_at(caller: symbol, callee: symbol, pos: symbol)

allowlist_at(c, f, to_string(n)) :- call_arg_allowlist(c, f, n).

// Atoms derived from existing atoms
//
// Existing-atom input bounds creation only if callers cannot choose or recycle those
// atoms. Reject the bound for existing-atom lookups, request argument flow, call-graph
// feedback, or fold closures. Comprehension self-loops are excluded from feedback.
// Limits: a fold calling an atom-making helper can hide feedback. Mutable socket
// arguments remain possibly client-selected across callback invocations; their
// individual fields and prior writes are not reconstructed here.
.decl atoms_chosen(id: symbol)

atoms_chosen(id) :- sink_arg_bounded(id, f, 0, "atoms"), sink_arg_chosen(id, f, 0).

atoms_chosen(id) :-
  sink_arg_bounded(id, _, 0, "atoms"),
  sink_flow_reaches(g, k, id),
  call_arg_chosen(_, g, k).

atoms_chosen(id) :- sink_arg_bounded(id, _, 0, "atoms"), request_data_reaches(id, _, _).

// Stateful request callbacks may keep an existing-atom lookup from an earlier
// request in their socket. Follow that exact socket argument too; Plug options
// and unrelated configuration parameters do not become client-selected.
atoms_chosen(id) :-
  sink_arg_bounded(id, _, 0, "atoms"),
  sink_flow_reaches(entry, 2, id),
  request_entry(entry, kind),
  (kind = "live_view" ; kind = "live_component" ; kind = "channel").
atoms_chosen(id) :- sink_arg_bounded(id, f, 0, "atoms"), atoms_fed_back(f).

.init atoms_reach = CallReach

atoms_reach.seed(f, f) :- sink_arg_bounded(_, f, 0, "atoms").

// The function's atoms come back to it: it is on a cycle of the call
// graph, or it is the fun a fold runs.
.decl atoms_fed_back(func: symbol)

atoms_fed_back(f) :-
  atoms_reach.reaches(g, f),
  call_edge(f, g),
  !comprehension_loop(f, g).

atoms_fed_back(f) :- fold_closure(f), sink_arg_bounded(_, f, 0, "atoms").

// Exclude an Erlang comprehension's list-walking self-edge from atom feedback. A cycle
// through another atom-making function still counts.
.decl comprehension_loop(func: symbol, callee: symbol)

comprehension_loop(f, f) :-
  call_edge(f, f),
  function_def(f, _, n, _, _),
  match("-.*-l[b]?c[$].*", n).

// A closure handed to a fold, which calls it with its own last answer.
.decl fold_closure(closure: symbol)

fold_closure(c) :-
  fun_handed(id, caller, c, _),
  remote_call(id, caller, m, n, _),
  fold_api(m, n).

.decl fold_api(mod: symbol, func: symbol)

fold_api("Enum", "reduce").
fold_api("Enum", "reduce_while").
fold_api("Enum", "map_reduce").
fold_api("Enum", "flat_map_reduce").
fold_api("Enum", "scan").
fold_api("List", "foldl").
fold_api("List", "foldr").
fold_api("Stream", "iterate").
fold_api("Stream", "unfold").
fold_api("Stream", "scan").
fold_api("Stream", "transform").
fold_api(":lists", "foldl").
fold_api(":lists", "foldr").
fold_api(":lists", "mapfoldl").
fold_api(":lists", "mapfoldr").
fold_api(":maps", "fold").

// Compiler-duplicated sinks from one source call are reported once, anchored at the
// first copy.
.decl repeated_site(id: symbol)

repeated_site(id) :-
  sink_copy(id, func, first),
  sink_call(first, func, _, _, _),
  !bounded_first(first).

// A bounded or validated first copy cannot represent an unchecked sibling.
// Validated calls are absent from sink_call; bounded calls are excluded here.
.decl bounded_first(id: symbol)

bounded_first(first) :- sink_copy(_, f, first), bounded_input(first, f).

// ── Reachability from a request surface ──────────────────────────

// Choose the strongest evidence per sink: proven `flow`, then template `rendered` flow,
// then graded call-path reach. Weaker rows must be excluded before lexicographic
// deduplication, where adjacent would otherwise sort before flow.
.decl reached_by_request(id: symbol, func: symbol, entry: symbol, kind: symbol, evidence: symbol)

reached_by_request(id, func, entry, kind, "flow") :-
  sink(id, func, _, _, _),
  request_data_reaches(id, entry, kind).

reached_by_request(id, func, entry, kind, "rendered") :-
  sink(id, func, _, _, _),
  request_reaches(entry, kind, func, _),
  !request_data_reaches(id, _, _),
  rendered_from_assigns(id).

reached_by_request(id, func, entry, kind, proximity) :-
  sink(id, func, _, _, _),
  request_reaches(entry, kind, func, proximity),
  !request_data_reaches(id, _, _),
  !rendered_from_assigns(id).

// Reachability from a request entry: direct at the entry, adjacent one call away, or
// transitive further away. Transitive reachability does not prove data flow.
.decl request_reaches(entry: symbol, kind: symbol, func: symbol, proximity: symbol)

request_reaches(entry, kind, entry, "direct") :-
  request_entry(entry, kind).

request_reaches(entry, kind, callee, "adjacent") :-
  request_entry(entry, kind),
  call_edge(entry, callee).

// Walk backward from sink functions to request entries, avoiding unrelated code
// reachable from those entries.
.init sink_func_reach = CallReach

sink_func_reach.seed(func, func) :- sink(_, func, _, _, _).

request_reaches(entry, kind, func, "transitive") :-
  request_entry(entry, kind),
  sink_func_reach.reaches(entry, func),
  !call_edge(entry, func),
  func != entry.

// ── Proven flow ──────────────────────────────────────────────────
//
// Backward from each sink's argument over call_arg_derived to a request
// entry, then only the parameters that carry the request count.

// Parameter flow with template-sensitive dispatch. Cross a template dispatcher only
// toward a template named by the incoming literal, following wrappers that forward the
// name. Direct template calls propagate assigns normally. Other assigns-derived input
// is classified as `rendered`.
.decl sink_flow_seed(func: symbol, pos: number, target: symbol)
.decl sink_flow_reaches(func: symbol, pos: number, target: symbol)

sink_flow_reaches(f, p, t) :- sink_flow_seed(f, p, t).

sink_flow_reaches(f, p, t) :-
  call_arg_derived(f, g, k, p),
  sink_flow_reaches(g, k, t),
  !template_function(g).

sink_flow_reaches(f, p, t) :-
  call_arg_derived(f, g, k, p),
  sink_flow_reaches(g, k, t),
  template_function(g),
  !template_dispatch(f).

// A function that calls more than one template: a dispatch on the name.
.decl template_dispatch(func: symbol)

template_dispatch(f) :-
  call_edge(f, t1),
  template_function(t1),
  call_edge(f, t2),
  template_function(t2),
  t1 != t2.

// Template name and assigns travel together through parameters np and ap. Follow
// functions that forward both to the template dispatcher.
.decl named_flow(func: symbol, ap: number, np: number, target: symbol, name: symbol)

named_flow(f, ap, 1 - ap, t, name) :-
  call_arg_derived(f, g, 0, ap),
  sink_flow_reaches(g, 0, t),
  template_function(g),
  template_dispatch(f),
  function_def(f, _, _, 2, _),
  function_def(g, _, name, 1, _),
  ap <= 1.

named_flow(c, q, r, t, name) :-
  named_flow(f, ap, np, t, name),
  call_arg_derived(c, f, ap, q),
  call_arg_forward(c, f, np, r).

sink_flow_reaches(c, q, t) :-
  named_flow(f, ap, np, t, name),
  call_arg_derived(c, f, ap, q),
  call_arg(c, f, np, quoted), quoted = cat("\"", cat(name, "\"")).

sink_flow_seed(func, pos, id) :-
  sink_call(id, func, _, k, _),
  k != "decompression",
  k != "command",
  sink_arg_derived(id, func, _, pos).

sink_flow_seed(func, pos, id) :-
  sink_call(id, func, _, "command", _),
  command_arg(id, arg),
  sink_arg_derived(id, func, arg, pos).

sink_flow_seed(func, pos, id) :-
  sink_data_arg(id, func, arg),
  sink_arg_derived(id, func, arg, pos).

// Request data reaches the sink's argument: the walk back from it ends
// at one of a request entry's request-carrying parameters.
.decl request_data_reaches(id: symbol, entry: symbol, kind: symbol)

request_data_reaches(id, entry, kind) :-
  sink_flow_reaches(entry, pos, id),
  request_param(entry, pos),
  request_entry(entry, kind).

// Template assigns reaching sinks
//
// A compiled Phoenix template takes assigns containing request data or records selected
// by the request. Track assigns-derived sink arguments even when the call graph reaches
// only the view dispatcher. Direct request-parameter flow retains the stronger `flow`
// evidence.
.decl template_function(func: symbol)

template_function(f) :-
  function_def(f, _, name, 1, _),
  match(".*[.](html|heex|eex|json|text|xml|js|txt)", name).

// The sink's argument is made of a template's assigns.
.decl rendered_from_assigns(id: symbol)

rendered_from_assigns(id) :-
  template_function(t),
  sink_flow_reaches(t, 0, id).

// Finding anchors
//
// Anchor at the sink and retain one reaching entry as evidence. Multiple entry paths
// produce one finding per sink site.

// Each sink a request reaches, with what its function reads when the
// evidence is a path (graded_by_reads).
.decl sink_reachable(id: symbol, func: symbol, api: symbol, sink: symbol, entry: symbol, kind: symbol, proximity: symbol, source: symbol, permille: number, safety: symbol)
.output sink_reachable

sink_reachable(id, func, api, s, entry, kind, evidence, source, p, safety) :-
  request_reached_sink(id, func, entry, kind, evidence),
  sink(id, func, api, s, safety),
  graded_by_reads(func, evidence, source, p).

// With priors enabled, lower severity of path-only findings when the sink function is
// classified as reading stored data at confidence at least 0.7. Proven flow and
// rendered-assigns evidence are not regraded.
.decl graded_by_reads(func: symbol, evidence: symbol, source: symbol, permille: number)

graded_by_reads(func, evidence, "", 0) :-
  request_reached_sink(_, func, _, _, evidence),
  proven_reach(evidence).

graded_by_reads(func, evidence, source, p) :-
  request_reached_sink(_, func, _, _, evidence),
  !proven_reach(evidence),
  sink_func_reads(func, source, p).

graded_by_reads(func, evidence, "", 0) :-
  request_reached_sink(_, func, _, _, evidence),
  !proven_reach(evidence),
  !sink_func_reads(func, _, _).

// Evidence that the request's data, not only its path, reaches the sink.
.decl proven_reach(evidence: symbol)

proven_reach("flow").
proven_reach("rendered").

// The stored sources a sink's function reads by the prior, at 0.7 or
// more, where the function holds one sink.
.decl sink_func_reads(func: symbol, source: symbol, permille: number)

sink_func_reads(func, source, p) :-
  sink(_, func, _, _, _),
  prior_reads(func, source, p),
  p >= 700,
  !several_sinks(func).

// Function-level priors cannot distinguish multiple sink sites in one function. Do not
// re-tier those sites.
.decl several_sinks(func: symbol)

several_sinks(func) :- sink(a, func, _, _, _), sink(b, func, _, _, _), a != b.

// ── A sink its callers' input reaches ───────────────────────────

// Report caller-controlled sinks here only when no request reaches them, avoiding
// duplicates. Include external parameter flow and deserialization without :safe.
.decl exposed_sink(id: symbol, func: symbol, api: symbol, sink: symbol, safety: symbol)

exposed_sink(id, func, api, s, safety) :-
  sink(id, func, api, s, safety),
  exposed_to_callers(id, func),
  !request_reached_sink(id, _, _, _, _).

// External reach establishes code-execution liveness. Atom, decompression and subprocess
// findings also require caller-derived arguments. Deserialization remains eligible
// independently.
.decl exposed_to_callers(id: symbol, func: symbol)

exposed_to_callers(id, func) :- sink_call(id, func, _, "code", _), called_from_api(func).
exposed_to_callers(id, func) :- sink_call(id, func, _, _, _), called_from_api(func), caller_input(id).
exposed_to_callers(id, func) :- sink_call(id, func, _, "deserialization", _).

// An exported function reaches `func` on its calls.
.decl called_from_api(func: symbol)

called_from_api(func) :- export_reach.reaches(func).

.init export_reach = ForwardCallReachSet

export_reach.root(func) :- api_export(func).

.decl sink_without_request_path(id: symbol, func: symbol, api: symbol, sink: symbol, source: symbol, permille: number, safety: symbol)
.output sink_without_request_path

sink_without_request_path(id, func, api, s, source, p, safety) :-
  exposed_sink(id, func, api, s, safety),
  sink_value(func, s, source, p).

sink_without_request_path(id, func, api, s, "", 0, safety) :-
  exposed_sink(id, func, api, s, safety),
  !sink_value(func, s, _, _).

// With priors enabled, lower severity when at least 0.9 probability places the sink's
// input outside externally supplied data. Preserve severity for request, URL, or
// peer-controlled input (`Questions.ValueSource`).
.decl sink_value(func: symbol, sink: symbol, source: symbol, permille: number)

sink_value(func, s, source, p) :-
  exposed_sink(_, func, _, s, _),
  prior_value_source(func, s, source, _, p),
  p >= 900,
  !several_sinks(func).

// The prior asks one question of every code_execution call, subprocesses included.
sink_value(func, "command", source, p) :-
  exposed_sink(_, func, _, "command", _),
  prior_value_source(func, "code", source, _, p),
  p >= 900,
  !several_sinks(func).

// Atom creation from external caller data
//
// For sinks outside request reach, trace the argument back to exported API parameters
// through `sink_arg_derived`, `sink_reads`, and `call_arg_reads`. Include client
// messages forwarded into server parameters. Export reach alone proves only liveness.
// Exclude runtime callbacks receiving the program's own state, start arguments, or
// names.
.init atom_input = ParamReadsReach

atom_input.seed(func, to_string(pos), id) :-
  sink(id, func, _, "atom", ""),
  sink_arg_derived(id, func, 0, pos).

atom_input.seed(func, p, id) :-
  sink(id, func, _, "atom", ""),
  sink_reads(id, func, 0, "param", p).

// Made of what a local helper returns of its own parameter.
atom_input.seed(func, p, id) :-
  sink(id, func, _, "atom", ""),
  sink_reads(id, func, 0, "call", g),
  returns_reads(g, "param", q),
  call_arg_reads(func, g, n, "param", p),
  q = to_string(n).

atom_input.reaches(f, p, t) :- message_param(f, p, h), atom_input.reaches(h, "0", t).

// A client sends a call or cast derived from parameter pos to mod's server. The handler
// receives the message as its first parameter.
.decl message_param(client: symbol, pos: symbol, callback: symbol)

message_param(f, to_string(p), h) :-
  call_arg_derived(f, api, 1, p),
  sync_api(api),
  sync_call_site(_, f, m, _),
  function_def(h, m, "handle_call", 3, _).

message_param(f, to_string(p), h) :-
  call_arg_derived(f, api, 1, p),
  cast_api(api),
  async_cast(f, m),
  function_def(h, m, "handle_cast", 2, _).

.decl sync_api(api: symbol)

sync_api("GenServer:call/2").
sync_api("GenServer:call/3").
sync_api(":gen_server:call/2").
sync_api(":gen_server:call/3").

.decl cast_api(api: symbol)

cast_api("GenServer:cast/2").
cast_api(":gen_server:cast/2").

// The sink's argument is made of a parameter of the program's API
// (outside_api): an atom's here, a decompression's compressed data below.
.decl caller_input(id: symbol)

caller_input(id) :- atom_input.reaches(f, _, id), outside_api(f).

// Every exported function is a possible external entry, even if internal callers pass
// only literals. Macros are excluded because they run at compile time on the caller's
// code, and so are exports the library's users do not call (internal_export).
.decl outside_api(func: symbol)

outside_api(f) :-
  api_export(f),
  function_def(f, m, n, a, _),
  !runtime_callback(m, n, a),
  !function_def(_, m, "__impl__", 1, _),
  !internal_export(f).

// An export the docs hide from the library's users (`@doc false`, a `@moduledoc false`
// module) that the program itself calls: a helper its own modules share, or one its
// macros and module bodies call at compile time, as `SQL.BNF` parses a fixed grammar
// into atoms. Its parameters are what the program hands it, and a documented caller's
// input still reaches the sink through the flow walk above. A hidden export nothing in
// the program calls is called from outside after all, by code a macro generates or by
// a user past the docs, and stays a way in. So does a hidden export of a module with a
// behaviour: `@impl true` hides a callback, which the behaviour's runtime calls with
// outside data. And so does one a function a quote defines calls: that generated
// function runs in the user's module on what its callers hand it.
.decl internal_export(func: symbol)

internal_export(f) :-
  doc_hidden(f),
  call_edge(c, f),
  c != f,
  function_def(f, m, _, _, _),
  !behaves_as(m, _),
  !quoted_call_to(f, "function").

// A `__name__` hook (the convention for what generated code calls, not a user) that
// only the top of code a macro returns calls: it runs where the macro expands, as
// phoenix_replay's `__live_sessions__/2` builds session names in a router's body while
// the router compiles, on the options its source writes. A hook a function the quote
// defines calls, or one the program's runtime calls, stays a way in.
// Known limit: a macro expanded inside a function body runs such a hook at runtime, on
// what that function holds.
internal_export(f) :-
  quoted_call_to(f, "expansion"),
  function_def(f, _, n, _, _),
  match("__.+__", n),
  !quoted_call_to(f, "function"),
  !runtime_caller(f).

// A quote in the program calls `func`: in a function or nested quote it defines
// (`function`), or at the top of the code a macro returns (`expansion`). A call whose
// arity is unknown names every arity.
.decl quoted_call_to(func: symbol, context: symbol)

quoted_call_to(f, context) :-
  quoted_call(_, m, n, a, context),
  function_def(f, m, n, arity, _),
  (a = arity ; a = -1).

// A function other than a macro calls `func`.
.decl runtime_caller(func: symbol)

runtime_caller(f) :-
  call_edge(c, f),
  function_def(c, _, n, _, _),
  !match("MACRO-.*", n).

// A protocol implementation is an external entry when the program defines and exposes
// the corresponding protocol function. Implementations of external protocols are
// treated as receiving the program's own values.
outside_api(f) :-
  function_def(f, m, n, a, _),
  implements_protocol(m, p),
  function_def(pf, p, n, a, _),
  outside_api(pf).

// Identify implementations of program-defined protocols through __impl__, __protocol__,
// and the protocol-prefixed module name. Combine pattern matching with a literal prefix
// check; avoid partial substring functors.
.decl implements_protocol(impl: symbol, protocol: symbol)

implements_protocol(m, p) :-
  function_def(_, m, "__impl__", 1, _),
  function_def(_, p, "__protocol__", 1, _),
  match(cat(p, "[.].*"), m),
  contains(cat(p, "."), m).

// Callbacks normally receiving program-owned values, including process callbacks and
// Broadway process_name/2. Request callbacks remain external. Exclude handle_info from
// this classification when the process may activate a socket, including unresolved
// modes: peer bytes can then supply its messages.
.decl runtime_callback(mod: symbol, name: symbol, arity: number)

runtime_callback(m, n, a) :-
  otp_callback(f, m, n, _),
  message_callback(n),
  function_def(f, m, n, a, _),
  !socket_messages(m, n).

.decl socket_messages(mod: symbol, callback: symbol)

socket_messages(m, "handle_info") :-
  socket_active(_, f, _, mode, _),
  mode != "false",
  mode != "unset",
  function_def(f, m, _, _, _).

runtime_callback(m, "process_name", 2) :-
  behaves_as(m, "Broadway"),
  function_def(_, m, "process_name", 2, _).

// Decompression from external input
//
// Without request reach, require compressed data derived from an exported function's
// parameter.
.init inflate_input = ParamReadsReach

inflate_input.seed(func, to_string(pos), id) :-
  sink(id, func, _, "decompression", ""),
  sink_data_arg(id, func, arg),
  sink_arg_derived(id, func, arg, pos).

inflate_input.seed(func, p, id) :-
  sink(id, func, _, "decompression", ""),
  sink_data_arg(id, func, arg),
  sink_reads(id, func, arg, "param", p).

caller_input(id) :- inflate_input.reaches(f, _, id), outside_api(f).

// ── Subprocesses ─────────────────────────────────────────────────

// The subprocess APIs among code_execution's: what runs is a program on the host, not
// code in the node. A call is a finding where outside data chooses what runs.
.decl command_api(api: symbol)

command_api("System.cmd/2").
command_api("System.cmd/3").
command_api(":os.cmd/1").
command_api(":os.cmd/2").
command_api("System.shell/1").
command_api("System.shell/2").

// The arguments of a subprocess call that say what runs: the program System.cmd runs
// and its argument list, which a shell or an interpreter runs as code (a literal
// program that runs none of its arguments is no sink: code_execution leaves it out),
// and the whole command line a shell parses. A shell handed a literal script that takes
// the arguments after it as data (`command_data_args`) runs nothing those arguments
// say. Known limits: an option that makes a program run another (option injection),
// and an `env:` entry such as `LD_PRELOAD`, are not arguments that say what runs here.
.decl command_arg(id: symbol, pos: number)

command_arg(id, 0) :- code_execution(id, _, api), command_api(api).

command_arg(id, 1) :-
  code_execution(id, func, api),
  (api = "System.cmd/2" ; api = "System.cmd/3"),
  !command_data_args(id, func).

// A request's path to a subprocess whose program and script are made of nothing at all:
// literals, and what the environment and the configuration answer (Dependence reads a
// lookup as made of nothing). No request data, and no other source, reaches what runs.
.decl fixed_command_path(id: symbol, evidence: symbol)

fixed_command_path(id, evidence) :-
  sink(id, func, _, "command", _),
  reached_by_request(id, func, _, _, evidence),
  evidence != "flow",
  !command_varies(id).

// Something reaches what the subprocess runs: a parameter, a call's or a shared-state
// operation's result (Dependence's sources), or an unresolved fun's result.
.decl command_varies(id: symbol)

command_varies(id) :- command_arg(id, pos), sink_reads(id, _, pos, _, _).
command_varies(id) :- command_arg(id, pos), sink_arg_derived(id, _, pos, _).
command_varies(id) :- command_arg(id, pos), call_arg_runtime(id, _, pos, _, _).

// Without a request path, the parameters of the program's API that reach what runs.
.init command_input = ParamReadsReach

command_input.seed(func, to_string(pos), id) :-
  sink(id, func, _, "command", ""),
  command_arg(id, arg),
  sink_arg_derived(id, func, arg, pos).

command_input.seed(func, p, id) :-
  sink(id, func, _, "command", ""),
  command_arg(id, arg),
  sink_reads(id, func, arg, "param", p).

// Made of what a helper returns of its own parameter.
command_input.seed(func, p, id) :-
  sink(id, func, _, "command", ""),
  command_arg(id, arg),
  sink_reads(id, func, arg, "call", g),
  returns_reads(g, "param", q),
  call_arg_reads(func, g, n, "param", p),
  q = to_string(n).

command_input.reaches(f, p, t) :- message_param(f, p, h), command_input.reaches(h, "0", t).

caller_input(id) :- command_input.reaches(f, _, id), command_entry(f).

// Where a caller outside the program hands a subprocess's function its arguments: the
// program's API, or a named function the program makes a fun of (`&run/1`), which runs
// with whatever its holder hands it.
.decl command_entry(func: symbol)

command_entry(f) :- outside_api(f).

command_entry(f) :-
  closure_def(_, f),
  function_def(f, _, n, _, _),
  !match("-.*-fun-[0-9]+-", n).

// A deserialization reported without a literal :safe, whose finding covers the call
// whatever its bytes hold, compressed ETF included: the compressed-ETF finding at the
// same call would report one site twice. A [:safe] decode keeps it, since :safe bounds
// no allocation. A value prior that re-tiers the deserialization re-tiers what it says
// of the compressed form with it: priors move findings, and never add one.
.decl unsafe_decode_reported(id: symbol)

unsafe_decode_reported(id) :-
  sink(id, _, _, "deserialization", safety),
  safety != "atoms_only",
  request_reached_sink(id, _, _, _, _).

unsafe_decode_reported(id) :-
  sink(id, _, _, "deserialization", safety),
  safety != "atoms_only",
  exposed_sink(id, _, _, _, _).

// Nearby exported callers provide evidence of public reachability. An exported sink
// function already serves as its own anchor.
.init sink_callers = BackwardBoundedCallReach

sink_callers.root(func, func) :- exposed_sink(_, func, _, _, _).
sink_callers.limit(6).

// The exports listed with an exposed sink's finding, one per arity a reader would look
// at, and how each relates to it: its caller's argument reaches the sink's (`input`), or,
// where no export's does, it calls into the sink's function within six calls (`calls`),
// a path that says nothing of the data.
.decl sink_export(sink: symbol, export: symbol, via: symbol)
.output sink_export

sink_export(id, e, via) :- export_frame(id, e, via), !forwards_to_listed_arity(id, e, via).

// The candidate frames. An exported sink function already serves as its own anchor.
.decl export_frame(sink: symbol, export: symbol, via: symbol)

export_frame(id, e, "input") :-
  exposed_sink(id, func, _, _, _),
  sink_input_export(id, e),
  e != func.

export_frame(id, e, "calls") :- sink_export_reach(id, e), !sink_input_export(id, _).

// An export of the program's API whose parameter reaches the sink's argument: the walks
// that found the caller's input (`caller_input`).
.decl sink_input_export(sink: symbol, export: symbol)

sink_input_export(id, e) :- atom_input.reaches(e, _, id), outside_api(e).
sink_input_export(id, e) :- inflate_input.reaches(e, _, id), outside_api(e).
sink_input_export(id, e) :- command_input.reaches(e, _, id), outside_api(e).

// An export at least one call above the exposed sink's function, within
// the walk's six calls.
.decl sink_export_reach(sink: symbol, export: symbol)

sink_export_reach(id, e) :-
  exposed_sink(id, func, _, _, _),
  sink_callers.reaches(func, e, d),
  d > 0,
  api_export(e).

// Suppress redundant evidence frames for exports forwarding to a higher arity of
// themselves, such as default-argument wrappers, when that arity is already listed.
.decl forwards_to_listed_arity(sink: symbol, export: symbol, via: symbol)

forwards_to_listed_arity(id, e, via) :-
  export_frame(id, e, via),
  function_def(e, m, name, n, _),
  call_edge(e, g),
  function_def(g, m, name, k, _),
  k > n,
  export_frame(id, g, via).

// HTTP routes reaching a sink
//
// Attach verb, path, and plug from Phoenix's __routes__/0. Route facts omit compiled
// pipelines, so they do not establish whether the endpoint is authenticated.

.decl sink_endpoint(sink: symbol, verb: symbol, path: symbol, plug: symbol)
.output sink_endpoint

// Callers only: the function holding the sink is not itself an endpoint.
.init sink_reach = CallReach

sink_reach.seed(f, sink) :-
  call_edge(f, g),
  (unsafe_atom_creation(sink, g, _) ; unsafe_deserialization(sink, g, _, _) ;
   unsafe_decompression(sink, g, _, _)).

sink_endpoint(sink, verb, path, plug) :-
  http_route(_, verb, path, plug, _),
  function_def(entry, plug, _, _, _),
  sink_reach.reaches(entry, sink).

// Request-driven process growth
//
// A request can reach start_child under a supervisor without a cap and leave the child
// running after the request. Repeated requests can accumulate processes. An uncapped
// supervisor alone is not a finding.

// Each request starts a child under an uncapped dynamic supervisor without waiting for
// completion, allowing processes to accumulate.
.decl unbounded_request_child(sup: symbol, child: symbol, via: symbol, kind: symbol)

unbounded_request_child(sup, child, via, kind) :-
  starts_child(via, sup, child),
  uncapped_supervisor(sup),
  started_by_request(via, kind),
  !disabled_transport(sup),
  !waits_for_child(via, child).

.decl unbounded_children_from_request(sup: symbol, child: symbol, via: symbol, kind: symbol)
.output unbounded_children_from_request

unbounded_children_from_request(sup, child, via, kind) :-
  unbounded_request_child(sup, child, via, kind).

// `via` starts a `child` under the dynamic supervisor `sup`.
.decl starts_child(via: symbol, sup: symbol, child: symbol)

starts_child(via, sup, child) :- dynamic_child(sup, child, via).

// A supervisor with no known finite or dynamic max_children cap. Dynamic option rows
// block this conclusion. Pid targets are not resolved by points-to here; inline or
// external supervisors without visible options are treated as uncapped, a known
// limitation.
.decl uncapped_supervisor(sup: symbol)

uncapped_supervisor(sup) :-
  dynamic_child(sup, _, _),
  sup != "dynamic",
  !supervisor_max_children(sup, _).

// A request entry of `kind` reaches the function that starts the child
// (reaches_child_start, clientlib/supervision.dl).
.decl started_by_request(via: symbol, kind: symbol)

started_by_request(via, kind) :-
  request_entry(entry, kind),
  reaches_child_start(entry, via).

// The request bounds child lifetime by enumerating a task stream itself or waiting for
// the child's :DOWN. Live children are then bounded by active callers.
.decl waits_for_child(via: symbol, child: symbol)

waits_for_child(via, child) :- stream_only(via, child).
waits_for_child(via, child) :- dynamic_child(_, child, via), awaits_child_exit(via).

// Stream-only tasks are bounded by max_concurrency when enumerated by the request's own
// process. Detached enumeration can add a new group per request. A function also
// starting tasks through other APIs remains reportable because dynamic_child is
// function-level.
.decl stream_only(via: symbol, child: symbol)

stream_only(via, "Task") :-
  task_supervisor_start(_, via, op, _),
  task_supervisor_op(op, "stream"),
  !starts_tasks_otherwise(via),
  !streams_detached(via).

.decl starts_tasks_otherwise(via: symbol)

starts_tasks_otherwise(via) :-
  task_supervisor_start(_, via, op, _),
  task_supervisor_op(op, "one").

// The request reaches the stream through detached or stored-fun execution, or the
// streaming function starts a fun that may enumerate it. Known limit: a returned stream
// later enumerated by another process appears to run in the request.
.init detach_reach = CallReach

detach_reach.seed(f, via) :-
  task_supervisor_start(_, via, op, _),
  task_supervisor_op(op, "stream"),
  runs_elsewhere(f, g),
  reaches_child_start(g, via).

.decl streams_detached(via: symbol)

streams_detached(via) :- request_entry(entry, _), detach_reach.reaches(entry, via).

streams_detached(via) :-
  task_supervisor_start(_, via, op, _),
  task_supervisor_op(op, "stream"),
  runs_elsewhere(via, _).

// Require evidence that a dependency's transport is enabled. Phoenix socket options are
// visible in compiled __sockets__/0 literals; runtime configuration may remain unknown.
.decl transport_supervisor(sup: symbol, transport: symbol)

transport_supervisor("Phoenix.Transports.LongPoll.Supervisor", "longpoll").

.decl disabled_transport(sup: symbol)

disabled_transport(sup) :-
  transport_supervisor(sup, transport),
  !socket_transport(_, _, transport).
