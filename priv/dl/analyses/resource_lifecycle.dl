// Resource lifecycle analysis.
//
// Detects resource leaks: files, sockets, and ports opened without
// corresponding close calls in the same function or module.

.include "../clientlib/imports.dl"

// Layer 2 input declarations.
.decl resource_open(id: symbol, func: symbol, type: symbol)
.input resource_open

.decl resource_close(id: symbol, func: symbol, type: symbol)
.input resource_close

.decl port_open(id: symbol, func: symbol, port_type: symbol)
.input port_open

// ── Function-level resource leak ─────────────────────────────────

// A function opens a resource type but does not close the same type.
.decl resource_leak(func: symbol, type: symbol)
.output resource_leak

resource_leak(func, type) :-
  resource_open(_, func, type),
  !resource_close(_, func, type).

// ── Module-level port leak ───────────────────────────────────────

// Module that opens a port in a function but has no port close
// anywhere in the module.
.decl module_has_port_close(mod: symbol)

module_has_port_close(mod) :-
  resource_close(_, func, "port"),
  function_def(func, mod, _, _, _, _).

.decl unclosed_port(func: symbol, port_type: symbol)
.output unclosed_port

unclosed_port(func, port_type) :-
  port_open(_, func, port_type),
  function_def(func, mod, _, _, _, _),
  !module_has_port_close(mod).
