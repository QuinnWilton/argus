// Credentials printed, or sent unauthenticated.
//
// Two ways a secret leaves protection without anyone deciding it
// should: an Ecto schema field holding one that inspect/1 prints in
// full (Logger calls, changeset errors, crash reports), and a TLS
// connection that encrypts without authenticating the peer, so anyone
// able to answer for the host terminates the session with a certificate
// they minted themselves.

.include "../clientlib/imports.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ══ Secrets a schema prints ═════════════════════════════════════════
// Credentials an inspect/1 will print.
//
// Ecto's `redact: true` keeps a field out of `inspect/1`, and so does
// `@derive {Inspect, except: [...]}` (or `only: [...]`). Both default to
// off, so a struct holding a third-party API key prints it in full — into
// Logger calls, changeset error output, LiveView debug, crash reports, and
// whatever error reporter is installed. Nothing at the field's definition
// site suggests that, and nothing fails when it happens.
//
// The field name is the only signal available for "is this a secret", which
// makes this a heuristic. It is one of the few places a heuristic is
// clearly right: nobody names a field `sendgrid_api_key` by accident.
//
// Severity follows what leaking the value costs. A live third-party
// credential is someone else's system; a hash is an offline attack; a
// session token expires.

// A schema field named for a secret is printed in full by inspect/1: into
// log lines, changeset errors and crash reports.
.decl printed_secret(mod: symbol, field: symbol, kind: symbol)

printed_secret(mod, field, kind) :-
  holds_secret(mod, field, kind),
  !hidden_from_inspect(mod, field).


.decl secret_kind(fragment: symbol, kind: symbol)

// Third-party credentials — leaking one hands over another system.
secret_kind("api_key", "credential").
secret_kind("apikey", "credential").
secret_kind("secret", "credential").
secret_kind("private_key", "credential").
secret_kind("client_secret", "credential").
secret_kind("smtp_password", "credential").
secret_kind("access_key", "credential").

// Authentication material for this system.
secret_kind("password", "password").
secret_kind("passwd", "password").

// Bearer material, usually with a lifetime.
secret_kind("access_token", "token").
secret_kind("refresh_token", "token").
secret_kind("auth_token", "token").
secret_kind("session_token", "token").

// The field's name names a secret of `kind` (one of several, for a name
// that matches more than one fragment), and not a fact about it.
.decl named_for_secret(mod: symbol, field: symbol, kind: symbol)

named_for_secret(mod, field, kind) :-
  schema_field(mod, field, _),
  secret_kind(fragment, kind),
  contains(fragment, field),
  !secret_metadata(field).

// A schema named for a token (akkoma's PasswordResetToken and MFA.Token,
// phx.gen.auth's UserToken, an OAuth Token) exists to hold the bearer
// value in its field `token`. The module's name is the signal the bare
// field name lacks: `token` alone is also a currency ticker (blockster's
// Hub) or a lexer's, and stays the classifier's to judge.
named_for_secret(mod, ":token", "token") :-
  schema_field(mod, ":token", _),
  match(".*Token", mod).

// A field that names a secret but holds a fact about it — when it was
// sent, when it expires, whether one is set — is not the secret:
// `password_reset_sent_at`, `api_key_expires_at`, `password_changed_at`.
// Matched on the field's ending, as schemas spell these.
.decl secret_metadata(field: symbol)

secret_metadata(field) :-
  schema_field(_, field, _),
  match(".*_(at|on|date|time|count|expires|expiry|expiration|ttl|set|length|version)", field).

// A field can match more than one fragment — `smtp_password` is both a
// third-party credential and a password — and reporting it twice under two
// severities is worse than useless. The most severe kind wins, which is
// also the most specific: `smtp_password` is somebody else's SMTP account,
// not a local login.
.decl secret_rank(kind: symbol, rank: number)

secret_rank("credential", 1).
secret_rank("password", 2).
secret_rank("token", 3).

// The field holds a secret, of the most severe kind its name names.
.decl holds_secret(mod: symbol, field: symbol, kind: symbol)

holds_secret(mod, field, kind) :-
  named_for_secret(mod, field, kind),
  secret_rank(kind, rank),
  rank = min r : { named_for_secret(mod, field, other), secret_rank(other, r) }.

// What inspect/1 leaves out. Ecto implements `redact: true` by deriving
// Inspect with `except:` the redacted fields — unless the schema derives
// Inspect itself, in which case its own list is all there is and
// `redact: true` hides nothing. So a derived Inspect, when one is in
// view, is the whole answer: a field it does not show is hidden, and a
// field it shows is printed whatever `redact:` says. Without one in view
// (a hand-written impl, or a run that did not include the impl module),
// `redact: true` is taken at its word.
.decl hidden_from_inspect(mod: symbol, field: symbol)

hidden_from_inspect(mod, field) :-
  redacted_field(mod, field),
  !inspect_derived(mod).

hidden_from_inspect(mod, field) :- derive_hides(mod, field).

// The schema's own derived Inspect leaves the field out.
.decl derive_hides(mod: symbol, field: symbol)

derive_hides(mod, field) :-
  inspect_derived(mod),
  schema_field(mod, field, _),
  !inspect_shows(mod, field).

// Where the fix goes: the field's `redact: true`, or — when the schema
// derives Inspect itself — that derive's field list. Ecto's own derive
// hides exactly the redacted fields; any other derive is the schema's.
// Ecto derives Inspect only for a schema with a redacted field, so a
// derive in a schema with none is the schema's own.
//
// The schema's derived Inspect hides a field not marked `redact: true`.
.decl hides_unredacted(mod: symbol)

hides_unredacted(mod) :- derive_hides(mod, field), !redacted_field(mod, field).

// The schema's derived Inspect shows a field marked `redact: true`.
.decl shows_redacted(mod: symbol)

shows_redacted(mod) :- redacted_field(mod, field), inspect_shows(mod, field).

// The schema derives Inspect itself, not through Ecto's redaction.
.decl own_derive(mod: symbol)

own_derive(mod) :- inspect_derived(mod), hides_unredacted(mod).
own_derive(mod) :- inspect_derived(mod), shows_redacted(mod).
own_derive(mod) :- inspect_derived(mod), schema_field(mod, _, _), !redacted_field(mod, _).

// The schema's fix goes into its own derive's list ("derive") or its
// fields' `redact: true` ("redact").
.decl hides_via(mod: symbol, via: symbol)

hides_via(mod, "derive") :- own_derive(mod).
hides_via(mod, "redact") :- schema_field(mod, _, _), !own_derive(mod).

// A schema that hides something has answered the question, and answered
// it differently here. That is a stronger finding than one that never
// considered it, and the finding text says so — one sequin schema redacts a
// field while twenty-four of its siblings do not.
.decl schema_redacts_something(mod: symbol)

schema_redacts_something(mod) :- hidden_from_inspect(mod, _).

// Where a schema's fields are anchored: its own `__schema__/1`, or, for
// one compiled with no line (an `embeds_one ... do` block, lineless_schema),
// the schema that embeds it, whose source holds the block — the outermost
// one with a line, for an embed inside an embed. The field's line is found
// from there by its name.
.decl schema_anchor(mod: symbol, anchor: symbol)

schema_anchor(mod, mod) :- schema_field(mod, _, _), !lineless_schema(mod).

schema_anchor(mod, anchor) :-
  lineless_schema(mod),
  embedded_in(mod, parent),
  schema_anchor(parent, anchor).

// The lineless schema `child` is embedded by `parent`.
.decl embedded_in(child: symbol, parent: symbol)

embedded_in(child, parent) :-
  lineless_schema(child),
  schema_field(parent, _, type),
  (type = cat("embeds_one ", child) ; type = cat("embeds_many ", child)).

// A lineless schema no schema of the run embeds keeps its own anchor.
schema_anchor(mod, mod) :- lineless_schema(mod), !embedded_in(mod, _).

// The report adds whether the schema hides any field ("aware"), where
// the fix goes (`via`), and the line the field is anchored on.
.decl unredacted_secret(mod: symbol, field: symbol, kind: symbol, aware: symbol, via: symbol, anchor: symbol)
.output unredacted_secret

unredacted_secret(mod, field, kind, "aware", via, anchor) :-
  printed_secret(mod, field, kind),
  schema_redacts_something(mod),
  hides_via(mod, via),
  schema_anchor(mod, anchor).

unredacted_secret(mod, field, kind, "unaware", via, anchor) :-
  printed_secret(mod, field, kind),
  !schema_redacts_something(mod),
  hides_via(mod, via),
  schema_anchor(mod, anchor).

// ── A secret the table cannot name ──────────────────────────────────
//
// `totp_seed`, `teams_key`, a `secret_first` beside a `secret_second`:
// names a reader recognises and thirteen substrings do not. When priors
// are on (Argus.Priors, off by default), `prior_sensitive` carries a
// classifier's judgement of every field with its probability in
// thousandths. A field the table already names is the table's; the
// rest are reported from the prior at 0.9 and above — the point at which
// the calibration spike measured 98% precision — as their own relation,
// so the structural rows above are byte-identical with priors on or off,
// and the finding says it is heuristic.
//
// The 0.9 is the probability that the field is a secret at all, summed
// over credential, password and token: `jwt` at 0.89 token and 0.11
// credential is a secret the model is sure of, and unsure only which
// kind. The kind reported is the likeliest of the three.

// A schema field a model judges a secret is printed in full by inspect/1.
.decl printed_inferred_secret(mod: symbol, field: symbol, kind: symbol, permille: number)

printed_inferred_secret(mod, field, kind, p) :-
  model_names_secret(mod, field, kind, p),
  !hidden_from_inspect(mod, field).

// A schema field the priors' classifier judges a secret with `permille`
// in a thousand, and whose name the table does not name.
.decl model_names_secret(mod: symbol, field: symbol, kind: symbol, permille: number)

model_names_secret(mod, field, detail, p) :-
  prior_sensitive("schema_field", mod, field, "secret", detail, _, p),
  schema_field(mod, field, _),
  p >= 900,
  !named_for_secret(mod, field, _).


.decl unredacted_secret_inferred(mod: symbol, field: symbol, kind: symbol, aware: symbol, via: symbol, permille: number, anchor: symbol)
.output unredacted_secret_inferred

unredacted_secret_inferred(mod, field, kind, "aware", via, p, anchor) :-
  printed_inferred_secret(mod, field, kind, p),
  schema_redacts_something(mod),
  hides_via(mod, via),
  schema_anchor(mod, anchor).

unredacted_secret_inferred(mod, field, kind, "unaware", via, p, anchor) :-
  printed_inferred_secret(mod, field, kind, p),
  !schema_redacts_something(mod),
  hides_via(mod, via),
  schema_anchor(mod, anchor).

// ══ TLS without verification ════════════════════════════════════════
// TLS that encrypts without authenticating.
//
// A TLS connection that does not verify the peer's certificate is
// confidential against a passive observer and wide open to anyone who can
// answer for the host — which is the threat TLS exists to address. Nothing
// distinguishes a verified session from an unverified one at runtime: the
// connection succeeds, the bytes are encrypted, and the padlock is a lie.
//
// Two shapes. The first is greppable and reported anyway, because it is
// high severity and rare enough that every site deserves a look. The second
// is the reason this is an analysis: an option list that never mentions
// `verify` takes whatever the library defaults to, and Erlang's `:ssl`
// client verified nothing at all before OTP 26. Reading the call site tells
// you nothing — the absence IS the finding, and absence is what a search
// cannot look for.


// ── Verification disabled outright ───────────────────────────────

// Reported only when the module offers no way to get a verified
// connection. That distinction is the whole value here, and it is not one a
// search can make.
//
// Sequin has both shapes. `ConfigParser` maps REDIS_TLS_VERIFY=verify-none
// onto :verify_none — an explicit, documented user choice, and the same
// module sets :verify_peer when certificates are configured. Reporting it
// would be noise. `RedisStringSink.maybe_put_tls/2` does
//
//     defp maybe_put_tls(opts, %RedisStringSink{tls: true}),
//       do: Keyword.put(opts, :tls, verify: :verify_none)
//
// and :verify_peer appears nowhere in the module, so enabling TLS gets you
// an unauthenticated channel and there is no option that changes it.
//
// A module naming :verify_peer anywhere is credited with offering the
// choice, which is deliberately generous: the alternative is arguing about
// which branch is reachable, and a false "this is insecure" against code
// that supports verification is the finding that gets an analysis switched
// off. The credit is for a setting built apart from the connect, which a
// choice can replace: a client connect whose own literal options say
// :verify_none has no choice, whatever else the module offers (below).

.decl module_can_verify(mod: symbol)

module_can_verify(mod) :-
  tls_verification(_, func, "peer"),
  function_def(func, mod, _, _, _).

// A server's `verify_none` (tls_server_side: a listener's or an accepted
// socket's options, made only into those) is not this bug: the server
// does not ask its clients for a certificate, which is how nearly every
// server runs. ejabberd's HTTP listener and supavisor's client handler
// accept TLS that way. A setting that also reaches a client's connect,
// a return or a field stays reported.

.decl disables_verification(func: symbol, id: symbol)
.output disables_verification

disables_verification(func, id) :-
  tls_verification(id, func, "none"),
  function_def(func, mod, _, _, _),
  !module_can_verify(mod),
  !tls_server_side(id, func).

// A client's connect whose own literal options turn verification off:
// that connection verifies nothing, whatever other connections of the
// module do (a mesh transport's listener demanding its peers'
// certificates beside the dialer that checks none; a metrics push beside
// a verified API connection). A choice is between settings one
// connection can take, and this one is written into the call.
disables_verification(func, id) :-
  tls_connect(id, func, api, "literal"),
  client_connect_api(api),
  tls_verification(id, func, "none").

.decl client_connect_api(api: symbol)

client_connect_api(":ssl.connect/3").
client_connect_api(":ssl.connect/4").

// ── Verification left to the library's default ───────────────────
//
// Only for connects whose options are a literal list. A list built at
// runtime may well set `verify` somewhere this cannot see, and a false
// "insecure" on correctly configured code is worse than silence. A
// server's call is not a connect: a server that leaves `verify` out does
// not ask for client certificates, the usual configuration.

.decl relies_on_default_verification(func: symbol, id: symbol, api: symbol)
.output relies_on_default_verification

relies_on_default_verification(func, id, api) :-
  tls_connect(id, func, api, "literal"),
  tls_verification(id, func, "absent"),
  !tls_server_side(id, func).
