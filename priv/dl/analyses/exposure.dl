// Secret exposure through inspect output or TLS connections without peer
// authentication.

.include "../clientlib/imports.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// Secrets printed by Inspect
//
// Ecto fields may reach logs, changeset errors, and crash reports unless redacted or
// excluded by derived Inspect. Secret classification is a field-name heuristic.
// Severity depends on the value's kind: credential, password hash, or expiring token.

// A schema field named for a secret is printed in full by inspect/1: into
// log lines, changeset errors and crash reports.
.decl printed_secret(mod: symbol, field: symbol, kind: symbol)

printed_secret(mod, field, kind) :-
  holds_secret(mod, field, kind),
  !hidden_from_inspect(mod, field).


.decl secret_kind(fragment: symbol, kind: symbol)

// Third-party credentials — leaking one hands over another system.
secret_kind("api_key", "credential").
secret_kind("apikey", "credential").
secret_kind("secret", "credential").
secret_kind("private_key", "credential").
secret_kind("client_secret", "credential").
secret_kind("smtp_password", "credential").
secret_kind("access_key", "credential").

// Authentication material for this system.
secret_kind("password", "password").
secret_kind("passwd", "password").

// Bearer material, usually with a lifetime.
secret_kind("access_token", "token").
secret_kind("refresh_token", "token").
secret_kind("auth_token", "token").
secret_kind("session_token", "token").

// The field name suggests a secret of `kind`, excluding metadata about secrets. A name
// may match multiple kinds.
.decl named_for_secret(mod: symbol, field: symbol, kind: symbol)

named_for_secret(mod, field, kind) :-
  schema_field(mod, field, _),
  secret_kind(fragment, kind),
  contains(fragment, field),
  !secret_boolean(mod, field),
  !secret_metadata(field).

// A token-named schema's `token` field is treated as a bearer secret. Bare token fields
// elsewhere are ambiguous and left to the classifier.
named_for_secret(mod, ":token", "token") :-
  schema_field(mod, ":token", _),
  !secret_boolean(mod, ":token"),
  match(".*Token", mod).

// A known boolean schema field is a policy or status flag, not credential
// material. Keep string, custom and unknown types: their names may denote values.
.decl secret_boolean(mod: symbol, field: symbol)

secret_boolean(mod, field) :- schema_field(mod, field, "boolean").

// Exclude secret metadata fields by suffix, such as sent_at, expires_at, or changed_at;
// they describe the secret rather than contain it.
.decl secret_metadata(field: symbol)

secret_metadata(field) :-
  schema_field(_, field, _),
  match(".*_(at|on|date|time|count|expires|expiry|expiration|ttl|set|length|version)", field).

// Choose the highest-severity kind when a field matches several secret patterns,
// avoiding duplicate findings.
.decl secret_rank(kind: symbol, rank: number)

secret_rank("credential", 1).
secret_rank("password", 2).
secret_rank("token", 3).

// The field holds a secret, of the most severe kind its name names.
.decl holds_secret(mod: symbol, field: symbol, kind: symbol)

.decl strongest_secret(mod: symbol, field: symbol, rank: number)

strongest_secret(mod, field, min(r)) :- named_for_secret(mod, field, other), secret_rank(other, r).

holds_secret(mod, field, kind) :-
  named_for_secret(mod, field, kind),
  secret_rank(kind, rank),
  strongest_secret(mod, field, rank).

// Fields hidden from inspect/1. A visible derived Inspect implementation determines the
// complete field list, overriding `redact: true`. Without a visible derive, trust the
// Ecto redaction flag.
.decl hidden_from_inspect(mod: symbol, field: symbol)

hidden_from_inspect(mod, field) :-
  redacted_field(mod, field),
  !inspect_derived(mod).

hidden_from_inspect(mod, field) :- derive_hides(mod, field).

// The schema's own derived Inspect leaves the field out.
.decl derive_hides(mod: symbol, field: symbol)

derive_hides(mod, field) :-
  inspect_derived(mod),
  schema_field(mod, field, _),
  !inspect_shows(mod, field).

// Identify a schema-owned Inspect derive so fixes target its field list. Ecto's
// generated derive hides exactly redacted fields; a derive hiding unredacted fields, or
// present without redacted fields, is treated as the schema's own.
.decl hides_unredacted(mod: symbol)

hides_unredacted(mod) :- derive_hides(mod, field), !redacted_field(mod, field).

// The schema's derived Inspect shows a field marked `redact: true`.
.decl shows_redacted(mod: symbol)

shows_redacted(mod) :- redacted_field(mod, field), inspect_shows(mod, field).

// The schema derives Inspect itself, not through Ecto's redaction.
.decl own_derive(mod: symbol)

own_derive(mod) :- inspect_derived(mod), hides_unredacted(mod).
own_derive(mod) :- inspect_derived(mod), shows_redacted(mod).
own_derive(mod) :- inspect_derived(mod), schema_field(mod, _, _), !redacted_field(mod, _).

// The schema's fix goes into its own derive's list ("derive") or its
// fields' `redact: true` ("redact").
.decl hides_via(mod: symbol, via: symbol)

hides_via(mod, "derive") :- own_derive(mod).
hides_via(mod, "redact") :- schema_field(mod, _, _), !own_derive(mod).

// Existing redaction indicates a deliberate distinction: the schema hides some fields
// but still exposes this secret. Preserve that context in the finding.
.decl schema_redacts_something(mod: symbol)

schema_redacts_something(mod) :- hidden_from_inspect(mod, _).

// Anchor at the schema's __schema__/1, or the outermost embedding schema with source
// lines when the schema is lineless. Locate the field by name from that anchor.
.decl schema_anchor(mod: symbol, anchor: symbol)

schema_anchor(mod, mod) :- schema_field(mod, _, _), !lineless_schema(mod).

schema_anchor(mod, anchor) :-
  lineless_schema(mod),
  embedded_in(mod, parent),
  schema_anchor(parent, anchor).

// The lineless schema `child` is embedded by `parent`.
.decl embedded_in(child: symbol, parent: symbol)

embedded_in(child, parent) :-
  lineless_schema(child),
  schema_field(parent, _, type),
  (type = cat("embeds_one ", child) ; type = cat("embeds_many ", child)).

// A lineless schema no schema of the run embeds keeps its own anchor.
schema_anchor(mod, mod) :- lineless_schema(mod), !embedded_in(mod, _).

// The report adds whether the schema hides any field ("aware"), where
// the fix goes (`via`), and the line the field is anchored on.
.decl unredacted_secret(mod: symbol, field: symbol, kind: symbol, aware: symbol, via: symbol, anchor: symbol)
.output unredacted_secret

unredacted_secret(mod, field, kind, "aware", via, anchor) :-
  printed_secret(mod, field, kind),
  schema_redacts_something(mod),
  hides_via(mod, via),
  schema_anchor(mod, anchor).

unredacted_secret(mod, field, kind, "unaware", via, anchor) :-
  printed_secret(mod, field, kind),
  !schema_redacts_something(mod),
  hides_via(mod, via),
  schema_anchor(mod, anchor).

// Optional secret classification
//
// With priors enabled, report otherwise unclassified fields when total secret
// probability is at least 0.9. Sum credential, password, and token probabilities;
// report the most likely kind. Keep these heuristic findings separate so structural
// output is unchanged.

// A schema field a model judges a secret is printed in full by inspect/1.
.decl printed_inferred_secret(mod: symbol, field: symbol, kind: symbol, permille: number)

printed_inferred_secret(mod, field, kind, p) :-
  model_names_secret(mod, field, kind, p),
  !hidden_from_inspect(mod, field).

// A schema field the priors' classifier judges a secret with `permille`
// in a thousand, and whose name the table does not name.
.decl model_names_secret(mod: symbol, field: symbol, kind: symbol, permille: number)

model_names_secret(mod, field, detail, p) :-
  prior_sensitive("schema_field", mod, field, "secret", detail, _, p),
  schema_field(mod, field, _),
  p >= 900,
  !secret_boolean(mod, field),
  !named_for_secret(mod, field, _).


.decl unredacted_secret_inferred(mod: symbol, field: symbol, kind: symbol, aware: symbol, via: symbol, permille: number, anchor: symbol)
.output unredacted_secret_inferred

unredacted_secret_inferred(mod, field, kind, "aware", via, p, anchor) :-
  printed_inferred_secret(mod, field, kind, p),
  schema_redacts_something(mod),
  hides_via(mod, via),
  schema_anchor(mod, anchor).

unredacted_secret_inferred(mod, field, kind, "unaware", via, p, anchor) :-
  printed_inferred_secret(mod, field, kind, p),
  !schema_redacts_something(mod),
  hides_via(mod, via),
  schema_anchor(mod, anchor).

// TLS without peer verification
//
// Detect disabled verification and known option lists that omit it. Encryption alone
// does not authenticate the peer. Missing `verify` uses the library default; Erlang
// :ssl clients before OTP 26 defaulted to no verification.


// ── Verification disabled outright ───────────────────────────────

// Suppress separately built verify_none settings when the module also names
// verify_peer, treating it as a configurable choice. This is intentionally module-wide.
// A client's literal connect options are checked independently because another
// connection's settings cannot change them.

// A TLS setting tells a client to verify nothing, and its module offers no
// verified connection that a choice could put in its place.
.decl unverified_tls(func: symbol, setting: symbol)

unverified_tls(func, setting) :-
  turns_off_verification(setting, func),
  !module_offers_verification(func),
  !server_setting(setting, func).

// A client's connect whose own options, written into the call, turn
// verification off: no other setting of the module can replace them.
unverified_tls(func, connect) :-
  turns_off_verification(connect, func),
  literal_client_connect(connect, func).

.decl disables_verification(func: symbol, id: symbol)
.output disables_verification

disables_verification(func, id) :- unverified_tls(func, id).

// The setting at `setting` in `func` gives `verify: :verify_none`.
.decl turns_off_verification(setting: symbol, func: symbol)

turns_off_verification(setting, func) :- tls_verification(setting, func, "none").

// `func`'s module offers a verified connection (module_can_verify).
.decl module_offers_verification(func: symbol)

module_offers_verification(func) :- in_module(func, mod), module_can_verify(mod).

// Some function of `mod` sets `verify: :verify_peer`.
.decl module_can_verify(mod: symbol)

module_can_verify(mod) :- tls_verification(_, func, "peer"), in_module(func, mod).

// Server-only verify_none settings disable client-certificate requests and are exempt.
// Settings also used by client connects, returned, or stored remain reportable.
.decl server_setting(setting: symbol, func: symbol)

server_setting(setting, func) :- tls_server_side(setting, func).

// A client :ssl.connect/3,4 with literal options. Its verify_none is checked
// independently of other verified connections in the module.
.decl literal_client_connect(connect: symbol, func: symbol)

literal_client_connect(connect, func) :-
  literal_connect(connect, func, api),
  client_connect_api(api).

.decl client_connect_api(api: symbol)

client_connect_api(":ssl.connect/3").
client_connect_api(":ssl.connect/4").

// A TLS connect through `api` whose options are a literal list in the call.
.decl literal_connect(connect: symbol, func: symbol, api: symbol)

literal_connect(connect, func, api) :- tls_connect(connect, func, api, "literal").

// Verification defaults
//
// Check only literal client-connect option lists. Runtime-built options may enable
// verification outside the extractor's view. Server-side omission concerns client
// certificates and is excluded.

// A fully specified TLS option list omits verify. Peer verification then depends on the
// library default; :ssl did not verify by default before OTP 26.
.decl unstated_verification(func: symbol, connect: symbol, api: symbol)

unstated_verification(func, connect, api) :-
  literal_connect(connect, func, api),
  leaves_out_verify(connect, func),
  !server_setting(connect, func).

.decl relies_on_default_verification(func: symbol, id: symbol, api: symbol)
.output relies_on_default_verification

relies_on_default_verification(func, id, api) :- unstated_verification(func, id, api).

// The options at `connect` in `func` never mention `verify`.
.decl leaves_out_verify(connect: symbol, func: symbol)

leaves_out_verify(connect, func) :- tls_verification(connect, func, "absent").
