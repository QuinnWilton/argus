// Call cycle (deadlock) detection.
//
// Derives module-level synchronous dependency cycles: A sync-calls B and
// B sync-calls A (directly or transitively through the call graph).
// A cycle between two GenServer modules means each can block waiting for
// the other, producing a deadlock.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/resolved_calls.dl"
// ── Layer 2 facts ──────────────────────────────────────────────────────

// ── GenServer API identification ───────────────────────────────────────


// ── Synchronous dependency ─────────────────────────────────────────────

// Direct: a function in from_mod makes a sync_call to to_mod.
// `witness` is the depending function in from_mod — anchor-grade evidence.
// Module A waits on module B somewhere: a function of A reaches a sync
// dependency on B.
.decl module_sync_dep(from_mod: symbol, to_mod: symbol, witness: symbol)

module_sync_dep(from_mod, to_mod, f) :-
  function_def(f, from_mod, _, _, _),
  reaches_sync_dep(f, to_mod),
  from_mod != to_mod.

.decl call_cycle(mod_a: symbol, mod_b: symbol, witness_a: symbol, witness_b: symbol)
.output call_cycle

call_cycle(a, b, wa, wb) :-
  module_sync_dep(a, b, wa),
  module_sync_dep(b, a, wb),
  a < b.

// Full path of transitive sync dependencies for cycle participants.
// One row per witness — finding builders dedupe on (from_mod, to_mod).
.decl call_cycle_path(from_mod: symbol, to_mod: symbol, witness: symbol)
.output call_cycle_path

call_cycle_path(from_mod, to_mod, witness) :-
  call_cycle(a, b, _, _),
  module_sync_dep(from_mod, to_mod, witness),
  (from_mod = a ; from_mod = b),
  (to_mod = a ; to_mod = b).
