// Synchronous waits: nested call chains, cycles, callback receives, unbounded RPC and
// socket calls, global locks, and incomplete handling of peer shutdown.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/resolved_calls.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/global_reach.dl"
.include "../clientlib/order.dl"
.include "../clientlib/trapping.dl"
.include "../clientlib/timer_flush.dl"
.include "../clientlib/replies.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// Outputs:
// `call_chain`: request chains (`chain`), synchronous waits from casts (`cast`), or
// caller timeouts shorter than downstream timeouts (`budget`). Includes depth, timeout
// values, call site, and `tag` for inferred targets.
// `unbounded_wait`: an infinity call hop, RPC, RPC in a callback, global lock, or
// socket wait. Global rows include retries and node scope; socket rows identify the API
// and server.
// `receive_in_callback`: a receive on an OTP callback's stack. `bounded` is `false`
// without an after clause, `true` with one, or `down` when a monitor's :DOWN bounds the
// wait.
// With priors enabled, cast and infinity findings may include `peer = local` and
// confidence in `permille` when the target is classified as answering locally.
.decl call_chain(from: symbol, to: symbol, kind: symbol, depth: number, inferred: symbol, caller_ms: number, downstream_ms: number, peer: symbol, permille: number, site: symbol)
.output call_chain

.decl unbounded_wait(func: symbol, site: symbol, kind: symbol, api: symbol, detail: symbol, nodes: symbol, peer: symbol, permille: number)
.output unbounded_wait

// What the rules below find, before a prior says whether the peer answers.
.decl chain_found(from: symbol, to: symbol, kind: symbol, depth: number, inferred: symbol, caller_ms: number, downstream_ms: number, site: symbol)
.decl wait_found(func: symbol, site: symbol, kind: symbol, api: symbol, detail: symbol, nodes: symbol)

.decl receive_in_callback(id: symbol, func: symbol, callback: symbol, behaviour: symbol, proximity: symbol, bounded: symbol)
.output receive_in_callback

// Call chains through handle_call
//
// Track (module, request clause) so a cycle in one clause does not hide a chain through
// another. `clause_call` identifies the next synchronous hops. Unknown clauses accept
// every request; unknown request tags enter every clause. `site_request` also filters
// guarded dispatchers by their literal arguments.

// The requests a handle_call/3's calls make, per call site and clause
// (clientlib/calls.dl's site_request, site_clause).
site_demand(h) :- handle_call_function(_, h).

// A request tagged `clause` to `mod` makes a request tagged `request` of
// `to`'s server.
.decl clause_dep(mod: symbol, clause: symbol, to: symbol, request: symbol)

clause_dep(mod, clause, to, request) :-
  handle_call_function(mod, h),
  site_request(h, id, to, request),
  site_clause(h, id, clause),
  mod != to.

// Do not derive chains from `stateful_module_dep`: it can describe init or cast work,
// include asynchronous edges, and infer server dependencies from unrelated functions in
// a module. Chains require synchronous calls reached by handle_call.

.decl requested(mod: symbol, request: symbol)

requested(to, request) :- clause_dep(_, _, to, request).

// Map request tags to matching handler clauses, including catch-alls. An unknown
// request tag may enter every clause.
.decl enters(mod: symbol, request: symbol, clause: symbol)

enters(m, request, clause) :-
  requested(m, request),
  clause_dep(m, clause, _, _),
  (request = clause ; clause = "any" ; request = "any").

// ── Timeout chain computation ────────────────────────────────────────

// A request into clause `clause` of `from` reaches `to`'s server through
// `depth` handle_call hops, for every depth up to ten.
.decl request_chain_at(from: symbol, clause: symbol, to: symbol, depth: number)

// Base case: the clause itself calls `to` (depth 1).
request_chain_at(from, clause, to, 1) :-
  clause_dep(from, clause, to, _),
  gen_server_like(to).

// Extend through the clause entered in the next server. Stop at request cycles, which
// `call_cycle` reports separately.
request_chain_at(from, clause, to, d + 1) :-
  clause_dep(from, clause, mid, request),
  enters(mid, request, mid_clause),
  !chain_cycle_clause(mid, mid_clause),
  request_chain_at(mid, mid_clause, to, d),
  from != to,
  d < 10.

// The shortest chain from a clause to each server. A longer chain extends to longer
// chains only, so the shortest is the one extending the shortest.
.decl request_chain(from: symbol, clause: symbol, to: symbol, depth: number)

request_chain(from, clause, to, min(d)) :- request_chain_at(from, clause, to, d).

// One request following another, and the clauses on a cycle of them.
.decl clause_step(mod: symbol, clause: symbol, to: symbol, to_clause: symbol)

clause_step(m, c, to, tc) :- clause_dep(m, c, to, request), enters(to, request, tc).

.decl clause_reach(mod: symbol, clause: symbol, to: symbol, to_clause: symbol)

clause_reach(m, c, to, tc) :- clause_step(m, c, to, tc).

clause_reach(m, c, to, tc) :-
  clause_step(m, c, mid, mc),
  clause_reach(mid, mc, to, tc).

.decl chain_cycle_clause(mod: symbol, clause: symbol)

chain_cycle_clause(m, c) :- clause_reach(m, c, m, c).

// A request into `from`'s handle_call/3 waits on `to`'s server through
// `depth` handle_call hops: the shortest chain, from any clause of from.
.decl waits_through_chain(from: symbol, to: symbol, depth: number)

waits_through_chain(from, to, min(d)) :- request_chain(from, _, to, d).

// ── Output: timeout chain risk ───────────────────────────────────────

// A chain of synchronous calls from `from` to `to`. The first caller's timeout must
// cover all subsequent waits.
.decl nested_call_chain(from: symbol, to: symbol, depth: number)

nested_call_chain(from, to, depth) :-
  waits_through_chain(from, to, depth),
  // A server between the chain's two ends: two hops or more.
  depth >= 2.

// Call chains containing a hop inferred from tag attribution. These inferred hops are
// weaker evidence than directly resolved calls.
.decl handler_inferred(h: symbol, site: symbol, to: symbol)

handler_inferred(h, id, to) :-
  handle_call_function(_, h),
  tag_resolved_site(id, h, "call", to),
  sync_call_site(id, h, t, _),
  unresolved_target(t).

// Direct call instructions run on h's stack. Site-less closure/fun edges do too unless
// `runs_elsewhere` identifies detached or deferred execution.
handler_inferred(h, id, to) :-
  handle_call_function(_, h),
  call_instr(h, g, id),
  reaches_tag_dep(g, to).

handler_inferred(h, "", to) :-
  handle_call_function(_, h),
  call_edge(h, g),
  !call_instr(h, g, _),
  !runs_elsewhere(h, g),
  reaches_tag_dep(g, to).

.decl clause_tag_dep(mod: symbol, clause: symbol, to: symbol)

clause_tag_dep(mod, clause, to) :-
  handle_call_function(mod, h),
  handler_inferred(h, id, to),
  site_request(h, id, to, _),
  site_clause(h, id, clause),
  mod != to.

.decl request_chain_inferred(from: symbol, clause: symbol, to: symbol)

request_chain_inferred(from, clause, to) :-
  request_chain(from, clause, to, _),
  clause_tag_dep(from, clause, to).

request_chain_inferred(from, clause, to) :-
  clause_dep(from, clause, mid, request),
  enters(mid, request, mid_clause),
  !chain_cycle_clause(mid, mid_clause),
  request_chain(mid, mid_clause, to, _),
  from != to,
  (clause_tag_dep(from, clause, mid) ; request_chain_inferred(mid, mid_clause, to)).

.decl timeout_chain_inferred(from: symbol, to: symbol)

timeout_chain_inferred(from, to) :- request_chain_inferred(from, _, to).

// The first call in handle_call on a shortest chain to `to`. Anchor at the call site
// rather than the shared function head; the relation key selects the earliest site.
.decl chain_site(from: symbol, to: symbol, site: symbol)

chain_site(from, to, id) :-
  nested_call_chain(from, to, d),
  handle_call_function(from, h),
  site_request(h, id, mid, request),
  id != "",
  site_clause(h, id, clause),
  request_chain(from, clause, to, d),
  enters(mid, request, mid_clause),
  !chain_cycle_clause(mid, mid_clause),
  request_chain(mid, mid_clause, to, dm),
  d = dm + 1.

// Anchor a chain at the call instruction that starts it. If the first edge has no
// instruction, such as a passed closure, anchor at the function.
.decl chain_at(from: symbol, to: symbol, site: symbol)

chain_at(from, to, id) :- chain_site(from, to, id).

chain_at(from, to, "") :-
  nested_call_chain(from, to, _),
  !chain_site(from, to, _).

// Each chain at its first call, "tag" when a hop on it exists only by
// tag attribution, "static" otherwise.
chain_found(from, to, "chain", depth, "tag", 0, 0, site) :-
  nested_call_chain(from, to, depth),
  timeout_chain_inferred(from, to),
  chain_at(from, to, site).

chain_found(from, to, "chain", depth, "static", 0, 0, site) :-
  nested_call_chain(from, to, depth),
  !timeout_chain_inferred(from, to),
  chain_at(from, to, site).

// ── Output: blocking cast handler ────────────────────────────────────

// handle_cast/2 makes a synchronous call. Although the sender does not wait, the
// receiving server cannot process its mailbox until the call returns.
.decl blocking_cast_handler(mod: symbol, handler: symbol, to: symbol)

blocking_cast_handler(mod, handler, to) :-
  handles_casts(mod, handler),
  waits_on_server(handler, to),
  requests_through_a_clause_it_enters(handler, to).

// `handler` is `mod`'s handle_cast/2.
.decl handles_casts(mod: symbol, handler: symbol)

handles_casts(mod, h) :- handle_cast_function(mod, h).

// The handler waits on another module's server, on its own stack or in
// a task it awaits (handler_dep's "call" kind, clientlib/entries.dl).
.decl waits_on_server(handler: symbol, to: symbol)

waits_on_server(h, to) :- handler_dep(_, "handle_cast", to, "call", h).

// The handler can reach this wait through clauses selected by its literal arguments.
// Uses `site_request`; `reaches_sync_dep` does not distinguish dispatcher clauses.
.decl requests_through_a_clause_it_enters(handler: symbol, to: symbol)

requests_through_a_clause_it_enters(h, to) :- site_request(h, _, to, _).

site_demand(h) :- handle_cast_function(_, h).

// The call in handle_cast that waits or enters a waiting helper. Report once per target
// at the earliest such site, rather than at the shared function head.
.decl cast_call_site(mod: symbol, to: symbol, site: symbol)

cast_call_site(mod, to, id) :-
  blocking_cast_handler(mod, h, to),
  site_request(h, id, to, _),
  id != "".

chain_found(mod, to, "cast", 1, "", 0, 0, id) :- cast_call_site(mod, to, id).

// A wait only a closure or a fun handed on makes has no site of its own,
// and is anchored at the handler.
chain_found(mod, to, "cast", 1, "", 0, 0, "") :-
  blocking_cast_handler(mod, _, to),
  !cast_call_site(mod, to, _).

// ── Timeout-aware sync dependency ──────────────────────────────────

// `mod`'s handle_call/3 waits on another module's server for up to `ms`
// (-1 for :infinity, 0 when the bytecode does not show it).
.decl handle_call_waits_on(mod: symbol, to: symbol, ms: number)

handle_call_waits_on(mod, to, ms) :-
  handle_call_function(mod, h),
  reaches_sync_dep_timeout(h, to, ms),
  mod != to.

// ── Output: timeout insufficient ───────────────────────────────────

// The caller's timeout is shorter than its callee's outgoing call timeout. The callee
// may still be waiting legitimately when the caller times out.
.decl insufficient_timeout(caller: symbol, callee: symbol, caller_ms: number, callee_ms: number)

insufficient_timeout(caller, callee, caller_ms, callee_ms) :-
  handle_call_waits_on(caller, callee, caller_ms),
  handle_call_waits_on(callee, _, callee_ms),
  // The caller's known finite timeout is strictly shorter than the callee's.
  // Exclude infinity (-1), unknown (0), and equal timeouts. Equality commonly
  // represents two default 5-second budgets, so it is not reported.
  caller_ms > 0,
  callee_ms > 0,
  caller_ms < callee_ms.

chain_found(caller, callee, "budget", 1, "", caller_ms, callee_ms, site) :-
  insufficient_timeout(caller, callee, caller_ms, callee_ms),
  timed_wait(caller, callee, caller_ms, site).

// ── Output: infinity timeout in chain ──────────────────────────────

// A handle_call/3 waits with no deadline on a server that may itself
// wait, so a caller waiting on the first waits forever with it.
.decl infinite_wait_in_chain(caller: symbol, server: symbol)

infinite_wait_in_chain(caller, server) :-
  handle_call_waits_forever_on(caller, server),
  gen_server_like(server),
  !answers_straight_away(server).

// The handle_call/3's wait on the server has an :infinity timeout.
.decl handle_call_waits_forever_on(mod: symbol, to: symbol)

handle_call_waits_forever_on(mod, to) :- handle_call_waits_on(mod, to, -1).

wait_found(cat(caller, ":handle_call/3"), site, "infinity", server, "", "") :-
  infinite_wait_in_chain(caller, server),
  timed_wait(caller, server, -1, site).

// The handler call site for a timed wait, including helper/API calls and targets
// resolved by tags or points-to. Uses -1 for infinity. An empty site means the wait
// occurs in a closure without a handler call anchor; findings fall back to the
// function.
.decl timed_wait_site(mod: symbol, target: symbol, ms: number, site: symbol)

timed_wait_site(mod, t, ms, id) :-
  handle_call_waits_on(mod, t, ms),
  handle_call_function(mod, h),
  sync_call_site(id, h, t, ms).

timed_wait_site(mod, t, ms, id) :-
  handle_call_waits_on(mod, t, ms),
  handle_call_function(mod, h),
  tag_resolved_site(id, h, "call", t),
  sync_call_site(id, h, u, ms),
  unresolved_target(u).

timed_wait_site(mod, t, ms, anchor) :-
  handle_call_waits_on(mod, t, ms),
  handle_call_function(mod, h),
  process_call(h, anchor, site, "call", p),
  server_process(p, t),
  sync_call_site(site, _, _, ms).

timed_wait_site(mod, t, ms, id) :-
  handle_call_waits_on(mod, t, ms),
  handle_call_function(mod, h),
  call_instr(h, g, id),
  !side_call(h, g),
  reaches_sync_dep_timeout(g, t, ms).

.decl timed_wait(mod: symbol, target: symbol, ms: number, site: symbol)

timed_wait(mod, t, ms, id) :- timed_wait_site(mod, t, ms, id).

timed_wait(mod, t, ms, "") :-
  handle_call_waits_on(mod, t, ms),
  !timed_wait_site(mod, t, ms, _).

// Servers that answer without adding a wait
//
// For infinity targets, prove that handle_call replies immediately, does not defer, and
// reaches no unbounded receive, opaque call, or unvetted external call. Same-module
// helpers are checked too. This suppresses the extra-wait finding; the server may still
// be busy or blocked in another callback. Unlike startup's `handler_blocks`,
// suppression requires proof that no unbounded wait is added.
.decl infinity_target(mod: symbol)

infinity_target(m) :- handle_call_waits_forever_on(_, m).

// Work that blocks the handler: its same-module stack and tasks it awaits. Exclude
// detached closures.
.init answer_reach = ForwardIntraModuleHoldingReach

answer_reach.root(h, h) :- infinity_target(m), handle_call_function(m, h).

// The handler may delay its reply through an untimed receive, deferred reply,
// unresolved call, or external call that cannot answer promptly.
.decl may_wait_to_answer(handler: symbol)

may_wait_to_answer(h) :- answer_reach.reaches(h, f), recv_start(_, f, 1, _).

// Returning {:noreply, …} defers the reply to a later callback. The caller waits for
// that reply, which may never arrive.
may_wait_to_answer(h) :- infinity_target(m), defers_reply(m, h, _).
may_wait_to_answer(h) :- answer_reach.reaches(h, f), dynamic_call(_, f, kind), unseen_call(kind).

may_wait_to_answer(h) :-
  answer_reach.reaches(h, f),
  fun_ref(f, g),
  function_def(f, own, _, _, _),
  !function_def(g, own, _, _, _).

may_wait_to_answer(h) :-
  answer_reach.reaches(h, f),
  out_call(f, id, _, _, _),
  !answers_in_time(id).

// The server's handle_call/3 answers at once: it cannot wait.
.decl answers_straight_away(mod: symbol)

answers_straight_away(m) :- infinity_target(m), handle_call_function(m, h), !may_wait_to_answer(h).

// Synchronous wait cycles
//
// `phase` is `call`, `continue` for mutual startup continuations, or `self`. Report
// each cycle from its least module `mod_a` and the next module `mod_b`. `witness_a`
// starts the cycle; `witness_b` closes it, possibly from a later module in a longer
// cycle. `call_cycle_path` supplies the edges.
.decl call_cycle(mod_a: symbol, mod_b: symbol, witness_a: symbol, witness_b: symbol, phase: symbol, site_a: symbol, site_b: symbol)
.output call_cycle

// A cycle of waits made by the servers' own processes. `a` is the least module and `z`
// closes the cycle; for two servers, `z` is `b`.
.decl wait_cycle(a: symbol, b: symbol, first_wait: symbol, closing_wait: symbol)

wait_cycle(a, b, first_wait, closing_wait) :-
  process_waits_on(a, b, first_wait),
  ring_closes_at(a, b, z),
  process_waits_on(z, a, closing_wait).

call_cycle(a, b, first_wait, closing_wait, "call", site_a, site_z) :-
  wait_cycle(a, b, first_wait, closing_wait),
  sync_site_or_empty(first_wait, b, site_a),
  sync_site_or_empty(closing_wait, a, site_z).

// A cycle starting at least module `a`: its peer `b` reaches `z` through later modules,
// and `z` waits on `a`. Restricting traversal to later modules avoids duplicate cycle
// starts and path enumeration.
.decl ring_closes_at(a: symbol, b: symbol, z: symbol)

ring_closes_at(a, b, z) :- waits_through_later(a, b, z), process_waits_on(z, a, _).

// b is a module after a that a's process waits on, and z one b's
// reaches through waits among modules after a.
.decl waits_through_later(a: symbol, b: symbol, z: symbol)

waits_through_later(a, b, b) :- process_waits_on(a, b, _), a < b.

waits_through_later(a, b, z) :-
  waits_through_later(a, b, y),
  process_waits_on(y, z, _),
  a < z.

// Identify the waiting process
//
// A module dependency alone does not prove that module's process waits: exported client
// functions run in their callers. For cycle candidates, trace each witness back to a
// callback on the module's own stack, including tasks it awaits.
.decl cycle_candidate(a: symbol, b: symbol)

cycle_candidate(a, b) :- module_sync_dep(a, b, _), sync_reach(b, a).

// Transitive module-level wait dependencies, limited to modules that both wait and are
// waited on, since only those can participate in cycles.
.decl sync_link(a: symbol, b: symbol)

sync_link(a, b) :- module_sync_dep(a, b, _), module_sync_dep(b, _, _), module_sync_dep(_, a, _).

.decl sync_reach(a: symbol, b: symbol)

sync_reach(a, b) :- sync_link(a, b).
sync_reach(a, c) :- sync_reach(a, b), sync_link(b, c).

// `holds.reaches(f, w)`: f runs the witness w while it runs, on its own
// stack or in a task it waits for.
.init holds = HoldingReach

holds.seed(w, w) :- cycle_candidate(a, b), module_sync_dep(a, b, w).

// Classify process entries as startup ("start": init/1 or a channel's join/3) or normal
// operation ("run": other callbacks).
.decl process_code(mod: symbol, func: symbol, phase: symbol)

.decl start_code(mod: symbol, func: symbol)

start_code(m, f) :- init_function(m, f).
start_code(m, f) :- otp_callback(f, m, "join", "Phoenix.Channel").

process_code(m, f, "start") :- start_code(m, f).
process_code(m, f, "run") :- process_entry(m, f), !start_code(m, f).

// a's process waits on b's at `w`, a function of a's it runs.
.decl process_dep(a: symbol, b: symbol, w: symbol, phase: symbol)

process_dep(a, b, w, phase) :-
  cycle_candidate(a, b),
  module_sync_dep(a, b, w),
  process_code(a, e, phase),
  holds.reaches(e, w).

// Waits during startup
//
// An unnamed starting process has not yet returned its pid to its starter. Count its
// wait only if it can already be addressed by name or the peer's entered request clause
// calls it back. Unseen peer handlers are assumed able to call back.
// Known limit: a peer may defer the reply and call back from another callback; reply
// flow is not tracked, so that deadlock can be missed.
.decl nameable(mod: symbol)

nameable(m) :- named_process(m, _).
nameable(m) :- named_pid(_, p), server_process(p, m).
nameable(m) :- sync_call(_, m).
nameable(m) :- async_cast(_, m).

// b's handler of the request a's start makes at `w` calls a back.
.decl calls_back(b: symbol, a: symbol, w: symbol)

calls_back(b, a, w) :-
  process_dep(a, b, w, "start"),
  !handle_call_function(b, _).

calls_back(b, a, w) :-
  process_dep(a, b, w, "start"),
  reaches_sync_request(w, b, request),
  clause_dep(b, clause, a, _),
  (request = clause ; clause = "any" ; request = "any").

// Process a waits on process b at w, either during normal operation or during startup
// when the start can participate in a cycle.
.decl process_waits_on(a: symbol, b: symbol, w: symbol)

process_waits_on(a, b, w) :- process_dep(a, b, w, "run").
process_waits_on(a, b, w) :- process_dep(a, b, w, "start"), nameable(a).
process_waits_on(a, b, w) :- calls_back(b, a, w).

// Two servers wait on each other from handle_continue/2 after both have initialized.
// Neither processes its mailbox. Report once, ordered by module.
.decl continue_cycle(a: symbol, b: symbol, a_wait: symbol, b_wait: symbol)

continue_cycle(a, b, a_wait, b_wait) :-
  continues_into_wait_on(a, b, a_wait),
  continues_into_wait_on(b, a, b_wait),
  // The pair is taken in one order, so it is reported once.
  a < b.

// A handle_continue/2 that init/1 continues to waits on another module's
// server at `w` (continue_dep, clientlib/entries.dl).
.decl continues_into_wait_on(mod: symbol, to: symbol, w: symbol)

continues_into_wait_on(mod, to, w) :- continue_dep(mod, to, w).

call_cycle(a, b, a_wait, b_wait, "continue", site_a, site_b) :-
  continue_cycle(a, b, a_wait, b_wait),
  continue_wait(a, b, site_a),
  continue_wait(b, a, site_b).

// A synchronous self-call through self(), a helper parameter, or a name held only by
// this module's processes. The gen API exits with `:calling_self`. These one-process
// cycles are separate from multi-module rings.
.decl call_to_self(func: symbol, call: symbol)

call_to_self(func, call) :- self_call(func, call).

call_cycle(m, m, func, func, "self", call, call) :-
  call_to_self(func, call),
  function_def(func, m, _, _, _).

// The witness's own call or call into the target's client API. Empty when another
// callee makes the dependency and no site in the witness identifies it.
.decl sync_site_or_empty(func: symbol, mod: symbol, site: symbol)

sync_site_or_empty(f, m, id) :- sync_site(f, m, id).

sync_site_or_empty(f, m, id) :-
  module_sync_dep(_, m, f),
  !sync_site(f, m, _),
  call_instr(f, g, id),
  function_def(g, m, _, _, _).

sync_site_or_empty(f, m, "") :-
  module_sync_dep(_, m, f),
  !sync_site(f, m, _),
  !calls_into(f, m).

// The witness calls a function of the other module.
.decl calls_into(func: symbol, mod: symbol)

calls_into(f, m) :-
  module_sync_dep(_, m, f),
  call_instr(f, g, _),
  function_def(g, m, _, _, _).

// Evidence edges for a `call_cycle` finding. Frames are deduplicated by cycle and
// module pair. `how = tag` marks a target inferred from the message tag; `static` marks
// a named callee.
.decl call_cycle_path(mod_a: symbol, mod_b: symbol, from_mod: symbol, to_mod: symbol, witness: symbol, how: symbol, site: symbol)
.output call_cycle_path

call_cycle_path(a, b, from_mod, to_mod, witness, "tag", site) :-
  ring_edge(a, b, from_mod, to_mod, witness),
  reaches_tag_dep(witness, to_mod),
  sync_site_or_empty(witness, to_mod, site).

call_cycle_path(a, b, from_mod, to_mod, witness, "static", site) :-
  ring_edge(a, b, from_mod, to_mod, witness),
  !reaches_tag_dep(witness, to_mod),
  sync_site_or_empty(witness, to_mod, site).

// Edges in a call_cycle: a → b, then the path back to a through modules ordered after
// a.
.decl ring_edge(a: symbol, b: symbol, from_mod: symbol, to_mod: symbol, witness: symbol)

ring_edge(a, b, a, b, w) :- wait_cycle(a, b, _, _), process_waits_on(a, b, w).

ring_edge(a, b, x, y, w) :-
  wait_cycle(a, b, _, _),
  waits_through_later(a, b, x),
  process_waits_on(x, y, w),
  back_to(a, y).

// y is a, or a module after a that reaches a through modules after a.
.decl back_to(a: symbol, y: symbol)

back_to(a, a) :- ring_closes_at(a, _, _).
back_to(a, z) :- ring_closes_at(a, _, z).

back_to(a, y) :-
  back_to(a, z),
  z != a,
  process_waits_on(y, z, _),
  a < y.

// ══ Synchronous fan-in ══════════════════════════════════════════════

// Many modules wait on one server's replies: it answers them one at a
// time, and every call queues behind the others.
.decl serialization_bottleneck(server: symbol, callers: number)

serialization_bottleneck(server, callers) :-
  caller_count(server, callers),
  // Five or more: this separates normal centralized services (one to four
  // callers) from true serialization bottlenecks.
  callers >= 5.

// How many modules have a function that waits on the server's process
// (module_sync_dep, clientlib/calls.dl).
.decl caller_count(server: symbol, callers: number)

.decl sync_callers(server: symbol, callers: number)

sync_callers(server, count(c)) :- sync_caller(c, server).

caller_count(server, n) :- gen_server_like(server), sync_callers(server, n).
caller_count(server, 0) :- gen_server_like(server), !sync_callers(server, _).

.decl sync_caller(caller_mod: symbol, target_mod: symbol)

sync_caller(caller_mod, target_mod) :- module_sync_dep(caller_mod, target_mod, _).

// Count of distinct caller modules for each such server.
.decl sync_call_fan_in(target_mod: symbol, cnt: number)
.output sync_call_fan_in

sync_call_fan_in(target_mod, cnt) :- serialization_bottleneck(target_mod, cnt).

// ── Bottleneck callers ──────────────────────────────────────────────────

// Caller evidence for a fan-in finding. Keep one row per witness; deduplicate displayed
// frames by (caller_mod, target_mod).
.decl bottleneck_caller(caller_mod: symbol, target_mod: symbol, witness: symbol)
.output bottleneck_caller

bottleneck_caller(caller_mod, target_mod, witness) :-
  module_sync_dep(caller_mod, target_mod, witness),
  serialization_bottleneck(target_mod, _).

// Receives on an OTP callback's own stack. Exclude edges into detached or deferred
// functions (runs_elsewhere).
.decl same_process_edge(caller: symbol, callee: symbol)

same_process_edge(caller, callee) :-
  call_edge(caller, callee),
  !runs_elsewhere(caller, callee),
  !side_call(caller, callee).

// A process entry and its loop behaviour, including callbacks, init, terminate, statem
// states, and inferred unlisted servers.
.decl loop_entry(entry: symbol, mod: symbol, behaviour: symbol)

loop_entry(e, m, b) :- process_entry(m, e), behaves_as(m, b), process_behaviour(b, "loop").
loop_entry(e, m, b) :- process_entry(m, e), unlisted_server(m), behaves_as(m, b).

// Same-process reach from a callback: the callback itself (`direct`) or one helper call
// (`helper`). The one-hop limit avoids reporting OTP's internal receives behind peer
// calls, which synchronous-call rules already cover.
.decl callback_reaches(entry: symbol, func: symbol, proximity: symbol)

callback_reaches(entry, entry, "direct") :- loop_entry(entry, _, _).

callback_reaches(entry, callee, "helper") :-
  loop_entry(entry, _, _),
  same_process_edge(entry, callee).

// ── Findings ─────────────────────────────────────────────────────

// An unbounded receive on an OTP callback's stack with no guaranteed completion
// message. Init receives are reported by startup's `unbounded_effect_in_init` instead.
.decl hanging_receive(receive: symbol, func: symbol, callback: symbol, proximity: symbol)

hanging_receive(receive, func, callback, proximity) :-
  waits_without_timeout(receive, func),
  callback_reaches(callback, func, proximity),
  !is_init(callback),
  !ends_when_peer_exits(receive, callback),
  !takes_fired_timer_message(receive).

receive_in_callback(receive, func, callback, behaviour, proximity, "false") :-
  hanging_receive(receive, func, callback, proximity),
  loop_entry(callback, _, behaviour).

// A callback receive without an after clause that ends when its peer exits. Reported
// with bound `down`; it can hold the callback for the peer's lifetime. Init receives
// are reported by startup.
.decl receive_until_peer_exits(receive: symbol, func: symbol, callback: symbol, proximity: symbol)

receive_until_peer_exits(receive, func, callback, proximity) :-
  waits_without_timeout(receive, func),
  callback_reaches(callback, func, proximity),
  !is_init(callback),
  ends_when_peer_exits(receive, callback),
  !takes_fired_timer_message(receive).

receive_in_callback(receive, func, callback, behaviour, proximity, "down") :-
  receive_until_peer_exits(receive, func, callback, proximity),
  loop_entry(callback, _, behaviour).

// A timed receive on an OTP callback's stack has a bounded wait but still consumes and
// re-scans the behaviour's mailbox.
.decl timed_receive_in_callback(receive: symbol, func: symbol, callback: symbol, proximity: symbol)

timed_receive_in_callback(receive, func, callback, proximity) :-
  waits_with_timeout(receive, func),
  callback_reaches(callback, func, proximity),
  !polls_cancelled_timer(receive).

receive_in_callback(receive, func, callback, behaviour, proximity, "true") :-
  timed_receive_in_callback(receive, func, callback, proximity),
  loop_entry(callback, _, behaviour).

// The receive in `func` has no `after`: it waits until its message
// comes.
.decl waits_without_timeout(receive: symbol, func: symbol)

waits_without_timeout(receive, func) :- recv_start(receive, func, 1, _).

// The receive in `func` has an `after`: it can end without its message.
.decl waits_with_timeout(receive: symbol, func: symbol)

waits_with_timeout(receive, func) :- recv_start(receive, func, 0, _).

// The receive accepts a monitor's :DOWN, or a linked peer's :EXIT while the callback
// traps exits. Its wait ends no later than that peer's lifetime; other clauses may end
// it sooner.
.decl ends_when_peer_exits(receive: symbol, callback: symbol)

ends_when_peer_exits(receive, callback) :-
  down_bounded(receive),
  recv_start(receive, func, 1, _),
  callback_reaches(callback, func, _).

ends_when_peer_exits(receive, callback) :-
  trapped_exit_ends(receive, func),
  callback_reaches(callback, func, _).

// A receive pinned to a linked process or port's EXIT while trapping exits. The linked
// peer's exit ends the wait; see exit_pinned and clientlib/trapping.dl.
.decl trapped_exit_ends(id: symbol, func: symbol)

trapped_exit_ends(id, f) :- exit_pinned(id, f), (flag_set_before(f, id) ; entered_trapping(f), !cleared_before(id)).

// ── The cancel_timer flush idiom ─────────────────────────────────

// A blocking receive that runs only where cancel_timer/1 said the timer
// had already fired, and takes its message, is no hang (flush_receive,
// clientlib/timer_flush.dl).
.decl takes_fired_timer_message(receive: symbol)

takes_fired_timer_message(receive) :- flush_receive(receive).

// A bounded receive flushing a cancelled timer's message (`flush_poll`). Exempt at any
// timeout because facts distinguish bounded from unbounded receives but do not retain
// the timeout value.
.decl polls_cancelled_timer(receive: symbol)

polls_cancelled_timer(receive) :- flush_poll(receive).

// Socket waits on an OTP callback's stack
//
// Detect socket calls with infinity timeouts, including forwarded literals, and
// connects bounded only by the operating system. Same-process traversal excludes
// detached work. Init receives belong to startup; connects are checked here even during
// init. Non-OTP reader processes are excluded.

// An unbounded socket call on a server callback's stack, excluding init/1. An
// unresponsive peer can block the server indefinitely.
.decl socket_wait_in_callback(site: symbol, func: symbol, api: symbol, server: symbol)

socket_wait_in_callback(site, func, api, server) :-
  waits_on_socket_forever(site, func, api, holder),
  runs_in_callback_of(holder, server),
  !recv_during_init(site).

wait_found(func, site, "socket", api, server, "") :-
  socket_wait_in_callback(site, func, api, server).

// An infinite socket timeout: omitted, explicitly :infinity, or supplied as :infinity
// by a forwarding caller (`holder`).
.decl waits_on_socket_forever(site: symbol, func: symbol, api: symbol, holder: symbol)

waits_on_socket_forever(id, f, api, f) :- socket_wait(id, f, api, "infinity", _).

waits_on_socket_forever(id, f, api, c) :-
  socket_wait(id, f, api, "param", p),
  socket_infinity_at(f, p, c).

// A caller passing :infinity as the timeout parameter, directly or
// through its own.
.decl socket_timeout_needed(func: symbol, pos: number)

socket_timeout_needed(f, p) :- socket_wait(_, f, _, "param", p).
socket_timeout_needed(f, q) :- socket_timeout_needed(g, p), call_arg_forward(f, g, p, q).

.decl socket_infinity_at(func: symbol, pos: number, caller: symbol)

socket_infinity_at(g, p, c) :- socket_timeout_needed(g, p), call_arg(c, g, p, ":infinity").

socket_infinity_at(g, p, c) :-
  socket_timeout_needed(g, p),
  call_arg_forward(f, g, p, q),
  socket_infinity_at(f, q, c).

.init socket_reach = SameProcessReachCut

socket_reach.cut(f, g) :- side_call(f, g).

socket_reach.seed(h, h) :- waits_on_socket_forever(_, _, _, h).

// `holder` runs on `server`'s callback stack outside init/1. socket_reach excludes
// detached functions.
.decl runs_in_callback_of(holder: symbol, server: symbol)

runs_in_callback_of(h, m) :-
  otp_callback(c, m, name, _),
  name != "init",
  socket_reach.reaches(c, h).

.decl socket_recv_api(api: symbol)

socket_recv_api(":gen_tcp.recv/2").
socket_recv_api(":gen_tcp.recv/3").
socket_recv_api(":ssl.recv/2").
socket_recv_api(":ssl.recv/3").

// A recv init/1 runs: startup's finding (unbounded_effect_in_init,
// "recv"), reported there once.
.decl recv_during_init(site: symbol)

recv_during_init(id) :-
  waits_on_socket_forever(id, _, api, h),
  socket_recv_api(api),
  init_function(_, c),
  socket_reach.reaches(c, h).

// ══ Remote calls and cluster-wide locks ═════════════════════════════

// ── RPC without timeout ──────────────────────────────────────────

// An RPC without a deadline whose target may wait. A connected, unresponsive peer can
// block it indefinitely; disconnection is detected through node monitoring. Init RPCs
// are reported by startup's `blocks_on_peer` instead.
.decl rpc_without_timeout(func: symbol, call: symbol, variant: symbol)

rpc_without_timeout(func, call, variant) :-
  makes_rpc(func, call, variant),
  no_timeout(call),
  !answers_at_once(call),
  !bounds_its_wait(call),
  !during_init(call).

// One row per RPC instruction `call`; findings deduplicate by (func, variant). `detail`
// is "caller" for a forwarded :infinity timeout, otherwise empty.
wait_found(func, call, "rpc", variant, "", "") :-
  rpc_without_timeout(func, call, variant),
  rpc_call(call, _, _, -1).

wait_found(func, call, "rpc", variant, "caller", "") :-
  rpc_without_timeout(func, call, variant),
  rpc_infinity_caller(func, call, _).

// An :rpc call a function makes, and which of the rpc functions it is.
.decl makes_rpc(func: symbol, call: symbol, variant: symbol)

makes_rpc(f, call, variant) :- rpc_call(call, f, variant, _).

// An RPC waits indefinitely when its timeout is omitted, explicitly :infinity, or
// passed as :infinity through a parameter.
.decl no_timeout(call: symbol)

no_timeout(call) :- rpc_call(call, _, _, -1).
no_timeout(call) :- rpc_infinity_caller(_, call, _).

// A wrapper call passing literal :infinity into the RPC timeout parameter. `caller`
// names the supplying function. Further parameter forwarding is not followed because
// `call_arg_forward` stops at the fourth argument, often before the timeout.
.decl rpc_infinity_caller(func: symbol, call: symbol, caller: symbol)
.output rpc_infinity_caller

rpc_infinity_caller(func, call, caller) :-
  rpc_call(call, func, _, 0),
  rpc_timeout_param(call, p),
  infinity_arg(caller, func, p).

// An RPC target vetted to return without waiting on another process, such as selected
// BIFs, ETS operations, persistent_term operations, clocks, and signals. Whole-table
// work can still take time. Select, match, and folds are excluded; unlisted targets
// remain reportable. Node monitoring bounds waits caused by disconnection.
.decl answers_at_once(call: symbol)

answers_at_once(call) :-
  rpc_target(call, target),
  quick_api(mod, fun),
  target = cat(mod, cat(".", fun)).

answers_at_once(call) :-
  rpc_target(call, target),
  answers_from_os(mod, fun),
  target = cat(mod, cat(".", fun)).

// A closure the rpc runs, when nothing it runs can wait (fun_waits).
answers_at_once(call) :-
  rpc_closure(call, _),
  !fun_waits(call).

.decl quick_api(mod: symbol, fun: symbol)

quick_api("Process", "alive?").
quick_api("Process", "whereis").
quick_api("Process", "info").
quick_api("Process", "list").
quick_api("Process", "registered").
quick_api(":erlang", "is_process_alive").
quick_api(":erlang", "whereis").
quick_api(":erlang", "process_info").
quick_api(":erlang", "processes").
quick_api(":erlang", "registered").
quick_api(":erlang", "system_info").
quick_api(":erlang", "memory").
quick_api(":erlang", "statistics").
quick_api(":erlang", "node").
quick_api(":erlang", "nodes").
quick_api(":erlang", "system_time").
quick_api(":erlang", "monotonic_time").
quick_api(":erlang", "exit").
quick_api("Process", "exit").
quick_api(":erlang", "send").
quick_api("Process", "send").
quick_api(":erlang", "function_exported").
quick_api(":erlang", "module_loaded").
quick_api("Node", "self").
quick_api("Node", "list").
quick_api("Node", "alive?").
quick_api("System", "system_time").
quick_api("System", "monotonic_time").
quick_api("System", "os_time").
quick_api("System", "version").
quick_api("System", "otp_release").
quick_api(":os", "timestamp").
quick_api(":os", "system_time").
quick_api(":os", "getpid").
quick_api(":ets", "lookup").
quick_api(":ets", "lookup_element").
quick_api(":ets", "member").
quick_api(":ets", "info").
quick_api(":ets", "tab2list").
quick_api(":ets", "whereis").
quick_api(":ets", "insert").
quick_api(":ets", "insert_new").
quick_api(":ets", "delete").
quick_api(":ets", "delete_object").
quick_api(":ets", "update_counter").
quick_api(":ets", "update_element").
quick_api(":ets", "take").
quick_api(":ets", "first").
quick_api(":ets", "last").
quick_api(":ets", "next").
quick_api(":ets", "prev").
quick_api(":ets", "first_lookup").
quick_api(":ets", "last_lookup").
quick_api(":ets", "next_lookup").
quick_api(":ets", "prev_lookup").
quick_api(":persistent_term", "get").
quick_api(":code", "is_loaded").
quick_api("Application", "get_env").
quick_api("Application", "fetch_env").
quick_api("Application", "fetch_env!").
quick_api(":application", "get_env").

// An RPC target with its own finite deadline. For example,
// `:application.which_applications/0` uses the default GenServer timeout; `/1` uses its
// argument. `rpc_arity` distinguishes them.
.decl bounds_its_wait(call: symbol)

bounds_its_wait(call) :-
  rpc_target(call, target),
  rpc_arity(call, n),
  self_bounded_api(mod, fun, n),
  target = cat(mod, cat(".", fun)).

.decl self_bounded_api(mod: symbol, fun: symbol, arity: number)

self_bounded_api(":application", "which_applications", 0).
self_bounded_api("Application", "started_applications", 0).

// File metadata requests wait on the kernel file server and disk, without depending on
// a program-owned process.
.decl answers_from_os(mod: symbol, fun: symbol)

answers_from_os("File", "stat").
answers_from_os("File", "stat!").
answers_from_os("File", "lstat").
answers_from_os("File", "lstat!").
answers_from_os("File", "exists?").
answers_from_os("File", "regular?").
answers_from_os("File", "dir?").
answers_from_os(":file", "read_file_info").
answers_from_os(":file", "read_link_info").
answers_from_os(":filelib", "is_file").
answers_from_os(":filelib", "is_dir").
answers_from_os(":filelib", "is_regular").
answers_from_os(":filelib", "file_size").

// Closures run by RPC
//
// A closure requires the same module version on the peer, so its local body and
// same-module callees can be checked here. Named targets and external funs run the
// peer's installed code; only the vetted runtime APIs above establish their wait
// behavior.
.decl rpc_closure(call: symbol, closure: symbol)

rpc_closure(call, g) :-
  rpc_target(call, "fun"),
  fun_handed(call, f, g, _),
  closure_def(f, g).

// What the closure runs: its module's functions it reaches, a process
// it spawns included (louder, never quieter).
.init rpc_fun = ForwardIntraModuleReach

rpc_fun.root(call, g) :- rpc_closure(call, g).

// The RPC closure may wait if it reaches an unbounded receive, opaque call, or unvetted
// call outside its module. Calls with finite deadlines are bounded. Known limit:
// captured funs passed to Enum may appear only as Enum calls.
.decl fun_waits(call: symbol)

fun_waits(call) :- rpc_fun.reaches(call, f), recv_start(_, f, 1, _).
fun_waits(call) :- rpc_fun.reaches(call, f), dynamic_call(_, f, kind), unseen_call(kind).

fun_waits(call) :-
  rpc_fun.reaches(call, f),
  fun_ref(f, g),
  function_def(f, own, _, _, _),
  !function_def(g, own, _, _, _).

fun_waits(call) :-
  rpc_fun.reaches(call, f),
  out_call(f, id, _, _, _),
  !answers_in_time(id).

// Opaque dynamic-call kinds emitted for fun calls and apply. Treat effect-model
// dot_dispatch as its classified call instead, so results do not depend on which
// extractors ran.
.decl unseen_call(kind: symbol)

unseen_call("call_fun").
unseen_call("apply").

// Outgoing calls to other modules, restricted to functions reached by an RPC closure or
// a server's handle_call/3.
.decl asked_about(func: symbol)

asked_about(f) :- rpc_fun.reaches(_, f).
asked_about(f) :- answer_reach.reaches(_, f).

.decl out_call(func: symbol, id: symbol, mod: symbol, fun: symbol, arity: number)

out_call(f, id, mod, fun, arity) :-
  asked_about(f),
  remote_call(id, f, mod, fun, arity),
  function_def(f, own, _, _, _),
  mod != own.

.decl answers_in_time(id: symbol)

answers_in_time(id) :- out_call(_, id, mod, fun, _), quick_api(mod, fun).
answers_in_time(id) :- out_call(_, id, mod, fun, _), answers_from_os(mod, fun).
answers_in_time(id) :- out_call(_, id, mod, fun, n), self_bounded_api(mod, fun, n).
answers_in_time(id) :- out_call(_, id, mod, _, _), computes_only(mod).
// Treat logging and telemetry calls as side paths: their servers answer from their own
// state without calling program-owned processes.
answers_in_time(id) :- out_call(_, id, mod, _, _), side_api(mod).
answers_in_time(id) :- out_call(_, id, ":erlang", fun, _), !erlang_waits(fun).
// The compiler uses this helper for x.field when x is not known to be a map. It reads
// map fields; atom-based zero-arity calls are deprecated.
answers_in_time(id) :- out_call(_, id, ":elixir_erl_pass", "no_parens_remote", 2).
answers_in_time(id) :- out_call(f, id, _, _, _), sync_call_site(id, f, _, t), t > 0.

answers_in_time(id) :-
  out_call(f, id, _, _, _),
  rpc_call(id, f, _, t),
  t > 0.

// Modules whose functions compute a value from their arguments, and the
// exceptions a `raise` builds.
.decl computes_only(mod: symbol)

computes_only("Enum").
computes_only("Map").
computes_only("MapSet").
computes_only("List").
computes_only("Keyword").
computes_only("Tuple").
computes_only("String").
computes_only("Integer").
computes_only("Float").
computes_only("Atom").
computes_only("Base").
computes_only("Bitwise").
computes_only("Range").
computes_only("Access").
computes_only("URI").
computes_only(":lists").
computes_only(":maps").
computes_only(":sets").
computes_only(":ordsets").
computes_only(":orddict").
computes_only(":gb_trees").
computes_only(":gb_sets").
computes_only(":string").
computes_only(":binary").
computes_only(":unicode").
computes_only(":proplists").
computes_only(":math").
computes_only(":queue").
computes_only("Exception").
computes_only("ArgumentError").
computes_only("RuntimeError").
computes_only("KeyError").
computes_only("ErlangError").

// :erlang operations that may wait: hibernate, port operations, process suspension or
// collection, scheduler coordination, and dynamic apply. Treat other :erlang operations
// as immediate.
.decl erlang_waits(fun: symbol)

erlang_waits("apply").
erlang_waits("hibernate").
erlang_waits("port_command").
erlang_waits("port_call").
erlang_waits("port_control").
erlang_waits("suspend_process").
erlang_waits("garbage_collect").
erlang_waits("check_process_code").
erlang_waits("system_flag").

// RPC and global operations reached by init, including in awaited tasks, are reported
// by startup. Shared helpers reached by both init and runtime callbacks receive only
// the startup finding.
.decl during_init(site: symbol)

during_init(site) :- rpc_during_init(_, site).
during_init(site) :- global_call_during_init(_, site).

// ── RPC in GenServer callback ────────────────────────────────────

// A server's message handler makes a remote call itself: its process
// waits on another node, and every caller waits behind it.
.decl rpc_in_callback(func: symbol, call: symbol, variant: symbol)

rpc_in_callback(func, call, variant) :-
  makes_rpc(func, call, variant),
  handles_messages(func).

// A handle_call, handle_cast, handle_info or handle_continue of a
// server (handler_function, clientlib/callbacks.dl).
.decl handles_messages(func: symbol)

handles_messages(func) :- handler_function(_, func).

// Report RPC-in-callback only for direct sites. Function-level transitive reach loses
// dispatcher-clause selection and can attribute remote work to a local branch.
// `rpc_without_timeout` still reports unbounded RPC sites.
wait_found(func, call, "rpc_in_callback", variant, "", "") :-
  rpc_in_callback(func, call, variant).

// Global synchronization
//
// Use startup's lock criteria: unbounded retries on any node scope, or finite positive
// retries involving other nodes. Finite local-only retries are exempt.

// A :global lock outside init/1 retries indefinitely while another process holds it.
.decl unbounded_lock_wait(func: symbol, lock: symbol)

unbounded_lock_wait(func, lock) :-
  takes_global_lock(func, lock),
  retries_until_locked(lock),
  !during_init(lock).

// A :global lock outside init/1 uses finite retries, but each attempt may wait for a
// partitioned node to be declared down.
.decl bounded_lock_wait(func: symbol, lock: symbol)

bounded_lock_wait(func, lock) :-
  takes_global_lock(func, lock),
  gives_up_after_retries(lock),
  waits_on_other_nodes(lock),
  !during_init(lock).

// A :global.set_lock or :global.trans call `func` makes.
.decl takes_global_lock(func: symbol, lock: symbol)

takes_global_lock(func, lock) :- global_op(lock, func, _, _, _).

// A global lock site with retry count and node scope. Cluster scope can stall on
// partitions; local scope waits only on local holders. Builders deduplicate by
// function, operation, retries, and nodes.
wait_found(func, lock, "global", op, retries, nodes) :-
  unbounded_lock_wait(func, lock),
  global_op(lock, func, op, retries, nodes).

wait_found(func, lock, "global", op, retries, nodes) :-
  bounded_lock_wait(func, lock),
  global_op(lock, func, op, retries, nodes).

// Peer calls catching :noproc but not peer shutdown
//
// A catch for `{:noproc, _}` may miss a peer stopping during the call. Check both
// `{:normal, _}` and `{{:shutdown, reason}, _}`. The latter uses `catch_inner_tag`;
// `catch_tuple_tag` for `{:shutdown, _}` covers only the bare shutdown reason.
// Unrestricted tuple or exit catches cover both.
.decl partial_noproc_catch(func: symbol, site: symbol, callee: symbol, call: symbol, guard_end: symbol)
.output partial_noproc_catch

// The handler catches :noproc but not a peer stopping during the call. That stop can
// crash the caller.
.decl uncaught_peer_stop(try: symbol, func: symbol, callee: symbol)

uncaught_peer_stop(try, func, callee) :-
  calls_peer_in_try(try, func, callee),
  catches_noproc(try, func),
  !takes_peer_stop(try, func).

partial_noproc_catch(func, try, callee, call, guard_end) :-
  uncaught_peer_stop(try, func, callee),
  try_call(try, func, callee, call, guard_end).

// The try at `try` in `func` guards a synchronous call to a peer
// (peer_call, clientlib/calls.dl): GenServer.call, :gen_server.call,
// :gen_statem.call.
.decl calls_peer_in_try(try: symbol, func: symbol, callee: symbol)

calls_peer_in_try(try, func, callee) :- try_call(try, func, callee, _, _), peer_call(callee).

// A handler of the try takes the exit :noproc: the peer may not exist.
.decl catches_noproc(try: symbol, func: symbol)

catches_noproc(try, func) :- catch_tag(try, func, "exit", ":noproc").

// The handler of the try at `id` takes an exit of a call whose peer
// stopped itself: `{:normal, _}` or `{{:shutdown, _}, _}`.
.decl takes_peer_stop(id: symbol, func: symbol)

takes_peer_stop(id, f) :- catch_tuple_tag(id, f, c, ":normal"), (c = "exit" ; c = "*").
takes_peer_stop(id, f) :- catch_inner_tag(id, f, c, ":shutdown"), (c = "exit" ; c = "*").
takes_peer_stop(id, f) :- catches_any_tuple_exit(id, f).
takes_peer_stop(id, f) :- try_call(id, f, _, _, _), site_catches_class(id, f, "exit").

// A catch matching every tuple exit reason also handles a peer stopping mid-call,
// including {:shutdown, {GenServer, :call, _}}.
.decl catches_any_tuple_exit(id: symbol, func: symbol)

catches_any_tuple_exit(id, f) :- catch_tuple_tag(id, f, "exit", "*").
catches_any_tuple_exit(id, f) :- catch_tuple_tag(id, f, "*", "*").

// Optional prior for locally answered waits
//
// At confidence 0.8 or above, a peer classified as answering every call within the node
// lowers the severity of infinity and cast-call findings. Peers depending on external
// activity retain their severity. Targets resolve through module or registered name.
.decl answers_at(target: symbol, permille: number)

answers_at(m, p) :- prior_answers("server", m, _, _, p).
answers_at(name, p) :- named_process(m, name), prior_answers("server", m, _, _, p).

.decl answering_peer(target: symbol, permille: number)

.decl answers_at_most(target: symbol, permille: number)

answers_at_most(t, max(q)) :- answers_at(t, q).

answering_peer(t, p) :- answers_at_most(t, p), p >= 800.

.decl answered_chain(from: symbol, to: symbol, kind: symbol)

answered_chain(f, t, "cast") :- chain_found(f, t, "cast", _, _, _, _, _), answering_peer(t, _).

call_chain(f, t, "cast", d, i, c, dm, "local", p, s) :-
  chain_found(f, t, "cast", d, i, c, dm, s),
  answering_peer(t, p).

call_chain(f, t, k, d, i, c, dm, "", 0, s) :-
  chain_found(f, t, k, d, i, c, dm, s),
  !answered_chain(f, t, k).

.decl answered_wait(kind: symbol, api: symbol)

answered_wait("infinity", a) :- wait_found(_, _, "infinity", a, _, _), answering_peer(a, _).

unbounded_wait(f, s, "infinity", a, d, n, "local", p) :-
  wait_found(f, s, "infinity", a, d, n),
  answering_peer(a, p).

unbounded_wait(f, s, k, a, d, n, "", 0) :-
  wait_found(f, s, k, a, d, n),
  !answered_wait(k, a).
