// A synchronous wait that can last forever or nest.
//
// Every one of these is a process waiting on another: a chain of
// handle_call hops whose per-hop timeouts compose unpredictably, two
// modules waiting on each other, a server that serializes too many
// callers, a receive on an OTP process's own stack, a remote call with
// no deadline, a cluster-wide lock, a peer call whose catch lets the
// peer's shutdown crash the caller. The mechanism (GenServer.call, rpc,
// :global, receive) is a column or a relation; the concern is the wait.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/resolved_calls.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/global_reach.dl"

// ══ The outputs ═════════════════════════════════════════════════════
//
// `call_chain(from, to, kind, depth, inferred, caller_ms, downstream_ms)`
//   — synchronous hops through callbacks: "chain" (a request into
//   `from` traverses `depth` handle_call hops to `to`; `inferred` is
//   "tag" when a hop was attributed by message tag), "cast" (a
//   handle_cast that makes a synchronous call), "budget" (the caller's
//   `caller_ms` timeout is shorter than the callee's own `downstream_ms`).
// `unbounded_wait(func, site, kind, api, detail, nodes)` — a wait with no
//   deadline: ":infinity" on a hop that itself serves callers
//   ("infinity"; `func` is the handle_call, `api` the target), a remote
//   call with the default infinity timeout ("rpc"), a remote call inside
//   a callback ("rpc_in_callback"), a :global lock with retries
//   ("global"; `detail` is the retries, `nodes` whose agreement it waits
//   on: "cluster", "local" or "unknown"; empty for the other kinds).
// `receive_in_callback(id, func, callback, behaviour, proximity, bounded)`
//   — a receive on an OTP process's own stack, `bounded` "false" when
//   it has no after clause and can hang, "true" when it has one, "down"
//   when it has none but takes the :DOWN of a monitor its function took.
.decl call_chain(from: symbol, to: symbol, kind: symbol, depth: number, inferred: symbol, caller_ms: number, downstream_ms: number)
.output call_chain

.decl unbounded_wait(func: symbol, site: symbol, kind: symbol, api: symbol, detail: symbol, nodes: symbol)
.output unbounded_wait

.decl receive_in_callback(id: symbol, func: symbol, callback: symbol, behaviour: symbol, proximity: symbol, bounded: symbol)
.output receive_in_callback

// ══ Call chains through handle_call ═════════════════════════════════
//
// A chain is made of requests, not modules: a request enters one clause
// of the server's handle_call/3 (clause_call says which calls each
// clause makes), and that clause's own synchronous calls are the next
// hops. Fugue's Countersubject answers :invert by calling Answer with
// :answer, whose clause calls Subject — a chain of two — while Answer's
// :echo clause calls Countersubject back, closing a cycle the :answer
// request never enters. Tracked by module, that cycle swallowed the
// chain beside it.
//
// Where a clause is unknown (a body that dispatches through a helper, a
// catch-all) the node is (mod, "any"), which every request to the module
// enters; where a request's tag is unknown (a message built at runtime)
// it is "any", which enters every clause. With both unknown throughout,
// this is the module-granular chain the rule used to compute, less the
// hops a handler reaches only through a clause of a guarded dispatcher
// its literal argument never enters (site_request, clientlib/calls.dl).

// The requests a handle_call/3's calls make, per call site and clause
// (clientlib/calls.dl's site_request, site_clause).
site_demand(h) :- handle_call_function(_, h).

// A request tagged `clause` to `mod` makes a request tagged `request` of
// `to`'s server.
.decl clause_dep(mod: symbol, clause: symbol, to: symbol, request: symbol)

clause_dep(mod, clause, to, request) :-
  handle_call_function(mod, h),
  site_request(h, id, to, request),
  site_clause(h, id, clause),
  mod != to.

// NOTE deliberately no `stateful_module_dep` clause here. It was
// `handle_call_function(from_mod, _), stateful_module_dep(from_mod,
// to_mod, _)` — an existence check that (a) never tied the dependency to
// the handle_call (the dep could flow from init/1 or a cast handler),
// (b) inherited stateful_module_dep's module-level heuristic (reaching a
// PURE function like an ETS-read `Config.get/2` counts as calling the
// Config server, because the module has a GenServer.call *somewhere*),
// and (c) pulled async_cast edges into a "synchronous" chain. On a
// 15-project corpus this clause produced every one of the analysis's 29
// false positives (0 came from it that were real); the genuine chains
// all derive from the genserver_sync_api rules above.

// A request tagged `request` to `mod` enters its clause `clause`: the one
// for that tag, or one serving any request; a request whose tag is
// unknown enters every clause.
.decl requested(mod: symbol, request: symbol)

requested(to, request) :- clause_dep(_, _, to, request).

.decl enters(mod: symbol, request: symbol, clause: symbol)

enters(m, request, clause) :-
  requested(m, request),
  clause_dep(m, clause, _, _),
  (request = clause ; clause = "any" ; request = "any").

// ── Timeout chain computation ────────────────────────────────────────

// A request into clause `clause` of `from` reaches `to`'s server through
// `depth` handle_call hops.
.decl request_chain(from: symbol, clause: symbol, to: symbol, depth: number)

// Base case: the clause itself calls `to` (depth 1).
request_chain(from, clause, to, 1) :-
  clause_dep(from, clause, to, _),
  behaves_as(to, "GenServer").

// Recursive case: through the clause the request enters in an
// intermediate server. A clause on a cycle of requests is not passed
// through: every length around the cycle was once a chain of its own,
// and a server that can wait on itself is call_cycle's finding. Only the
// shortest chain from a clause to a server is kept — the one the finding
// reports — so no path is enumerated at every length up to the bound.
request_chain(from, clause, to, d + 1) :-
  clause_dep(from, clause, mid, request),
  enters(mid, request, mid_clause),
  !chain_cycle_clause(mid, mid_clause),
  request_chain(mid, mid_clause, to, d),
  from != to,
  d < 10.

request_chain(from, clause, to, d1) <= request_chain(from, clause, to, d2) :- d2 <= d1.

// One request following another, and the clauses on a cycle of them.
.decl clause_step(mod: symbol, clause: symbol, to: symbol, to_clause: symbol)

clause_step(m, c, to, tc) :- clause_dep(m, c, to, request), enters(to, request, tc).

.decl clause_reach(mod: symbol, clause: symbol, to: symbol, to_clause: symbol)

clause_reach(m, c, to, tc) :- clause_step(m, c, to, tc).

clause_reach(m, c, to, tc) :-
  clause_step(m, c, mid, mc),
  clause_reach(mid, mc, to, tc).

.decl chain_cycle_clause(mod: symbol, clause: symbol)

chain_cycle_clause(m, c) :- clause_reach(m, c, m, c).

// The shortest chain between two servers, from any clause of the first.
.decl timeout_chain(from: symbol, to: symbol, depth: number)

timeout_chain(from, to, d) :- request_chain(from, _, to, d).

timeout_chain(from, to, d1) <= timeout_chain(from, to, d2) :- d2 <= d1.

// ── Output: timeout chain risk ───────────────────────────────────────

// A hop that exists only by tag attribution, and the chains that cross
// one: an inferred hop is the first thing to doubt in a long chain.
// The calls of h that reach `to` through a tag-attributed hop.
.decl handler_inferred(h: symbol, site: symbol, to: symbol)

handler_inferred(h, id, to) :-
  handle_call_function(_, h),
  tag_resolved_site(id, h, "call", to),
  sync_call_site(id, h, t, _),
  unresolved_target(t).

handler_inferred(h, id, to) :-
  handle_call_function(_, h),
  call_instr(h, g, id),
  !runs_elsewhere(h, g),
  reaches_tag_dep(g, to).

handler_inferred(h, "", to) :-
  handle_call_function(_, h),
  call_edge(h, g),
  !call_instr(h, g, _),
  !runs_elsewhere(h, g),
  reaches_tag_dep(g, to).

.decl clause_tag_dep(mod: symbol, clause: symbol, to: symbol)

clause_tag_dep(mod, clause, to) :-
  handle_call_function(mod, h),
  handler_inferred(h, id, to),
  site_request(h, id, to, _),
  site_clause(h, id, clause),
  mod != to.

.decl request_chain_inferred(from: symbol, clause: symbol, to: symbol)

request_chain_inferred(from, clause, to) :-
  request_chain(from, clause, to, _),
  clause_tag_dep(from, clause, to).

request_chain_inferred(from, clause, to) :-
  clause_dep(from, clause, mid, request),
  enters(mid, request, mid_clause),
  !chain_cycle_clause(mid, mid_clause),
  request_chain(mid, mid_clause, to, _),
  from != to,
  (clause_tag_dep(from, clause, mid) ; request_chain_inferred(mid, mid_clause, to)).

.decl timeout_chain_inferred(from: symbol, to: symbol)

timeout_chain_inferred(from, to) :- request_chain_inferred(from, _, to).

// Chains of depth >= 2 are risky: the outermost caller's timeout must
// accommodate the sum of all intermediate timeouts.
call_chain(from, to, "chain", depth, "tag", 0, 0) :-
  timeout_chain(from, to, depth),
  depth >= 2,
  timeout_chain_inferred(from, to).

call_chain(from, to, "chain", depth, "static", 0, 0) :-
  timeout_chain(from, to, depth),
  depth >= 2,
  !timeout_chain_inferred(from, to).

// ── Output: blocking cast handler ────────────────────────────────────

call_chain(mod, target, "cast", 1, "", 0, 0) :- handler_dep(mod, "handle_cast", target, "call", _).

// ── Timeout-aware sync dependency ──────────────────────────────────

.decl callback_sync_dep_timeout(from_mod: symbol, to_mod: symbol, timeout_ms: number)

callback_sync_dep_timeout(from_mod, to_mod, timeout_ms) :-
  handle_call_function(from_mod, func),
  reaches_sync_dep_timeout(func, to_mod, timeout_ms),
  from_mod != to_mod.

// ── Output: timeout insufficient ───────────────────────────────────

// A calls B with T_AB, B's handle_call calls someone with T_BC.
// If T_AB < T_BC: A's budget strictly cannot accommodate B's downstream
// work — B may legitimately wait longer than A is willing to.
//
// Equality is deliberately NOT flagged: the extractor encodes the
// GenServer.call default as 5000, so T_AB = T_BC almost always means
// "both sides use the default" — the universal configuration, not a
// misconfiguration. The boundary case is real (equal budgets leave B
// zero processing slack) but flagging it would mark nearly every
// two-hop chain in real code as an error.
call_chain(a, b, "budget", 1, "", t_ab, t_bc) :-
  callback_sync_dep_timeout(a, b, t_ab),
  callback_sync_dep_timeout(b, _, t_bc),
  t_ab > 0,     // not dynamic
  t_ab != -1,   // not infinity
  t_bc > 0,     // not dynamic
  t_ab < t_bc.

// ── Output: infinity timeout in chain ──────────────────────────────

// Sync call in a chain uses :infinity timeout — can block forever.
unbounded_wait(cat(mod, ":handle_call/3"), "", "infinity", target, "", "") :-
  callback_sync_dep_timeout(mod, target, -1),
  behaves_as(target, "GenServer").

// ══ Mutual synchronous dependency ═══════════════════════════════════
// `phase` is "call" for two modules whose processes synchronously call
// each other, "continue" when both do so from handle_continue/2: both
// return from init, the supervisor proceeds, and neither ever reads its
// mailbox. "self" is a process calling itself (mod_a = mod_b).
.decl call_cycle(mod_a: symbol, mod_b: symbol, witness_a: symbol, witness_b: symbol, phase: symbol, site_a: symbol, site_b: symbol)
.output call_cycle

call_cycle(a, b, wa, wb, "call", sa, sb) :-
  cycle_edge(a, b, wa),
  cycle_edge(b, a, wb),
  a < b,
  sync_site_or_empty(wa, b, sa),
  sync_site_or_empty(wb, a, sb).

// ── Which process waits ──────────────────────────────────────────────
//
// A deadlock is two processes each waiting on the other's mailbox, and
// module_sync_dep(a, b, w) says only that a function of a's waits on
// b's process: a function runs in whichever process calls it. A
// client function of a's (`def produce(recs), do: Batcher.produce(...)`,
// klife's Producer) runs in its caller, and a module with no process of
// its own (Plausible's `def flush, do: WriteBuffer.flush(__MODULE__)`)
// never waits as itself. So a direction of a cycle is a wait a's own
// process makes: a witness that runs on its stack, entered at one of
// a's callbacks — or in a task it awaits, which holds it just the same.
//
// Asked only of the pairs that depend on each other both ways, backwards
// from their witnesses.
.decl cycle_candidate(a: symbol, b: symbol)

cycle_candidate(a, b) :- module_sync_dep(a, b, _), module_sync_dep(b, a, _).

// `holds.reaches(f, w)`: f runs the witness w while it runs, on its own
// stack or in a task it waits for.
.init holds = HoldingReach

holds.seed(w, w) :- cycle_candidate(a, b), module_sync_dep(a, b, w).

// Where `mod`'s process starts running its code: its startup ("start":
// init/1, or a channel's join/3, which the channel server runs in the
// channel's process before it is joined), or once it runs ("run"): the
// other callbacks, a process module's under a behaviour the table does
// not list included.
.decl process_code(mod: symbol, func: symbol, phase: symbol)

process_code(m, f, "start") :- init_function(m, f).

process_code(m, f, "start") :-
  behaves_as(m, "Phoenix.Channel"),
  function_def(f, m, "join", 3, _).

process_code(m, f, "run") :- process_entry(m, f), !init_function(m, f).

process_code(m, f, "run") :-
  process_behaviour_module(m),
  function_def(f, m, name, _, _),
  callback_name(name),
  !init_function(m, f).

// a's process waits on b's at `w`, a function of a's it runs.
.decl process_dep(a: symbol, b: symbol, w: symbol, phase: symbol)

process_dep(a, b, w, phase) :-
  cycle_candidate(a, b),
  module_sync_dep(a, b, w),
  process_code(a, e, phase),
  holds.reaches(e, w).

// ── A wait made on the way up ────────────────────────────────────────
//
// A process that waits on a peer only while it starts, and has no name,
// is reachable during its start by the pid it hands out alone: a
// starter's start_link has not returned it, and no registry holds it. A
// peer that learns the pid from the call it is answering, and answers
// before calling back, cannot close the cycle — the start is over by
// then. Phoenix LiveView's upload channel registers with the LiveView
// from join/3, handing it `self()`; the LiveView replies at once and
// calls the channel only later, through the pid it kept.
//
// The wait counts when the process can be named while it starts (a
// registered name, or a call to it by name, anywhere), or when the
// peer's handle_call clause the request enters calls it back: the
// start deadlocks on its own request. A peer whose request handling the
// program cannot see (no handle_call/3 of its) is taken to call back.
//
// Known limit: a peer that holds the start's request unanswered (a
// `{:noreply, _}` without a reply) and calls the starting process from
// another callback deadlocks too; the reply is not followed, and that
// wait is not reported.
.decl nameable(mod: symbol)

nameable(m) :- named_process(m, _).
nameable(m) :- named_pid(_, p), server_process(p, m).
nameable(m) :- sync_call(_, m).
nameable(m) :- async_cast(_, m).

// b's handler of the request a's start makes at `w` calls a back.
.decl calls_back(b: symbol, a: symbol, w: symbol)

calls_back(b, a, w) :-
  process_dep(a, b, w, "start"),
  !handle_call_function(b, _).

calls_back(b, a, w) :-
  process_dep(a, b, w, "start"),
  reaches_sync_request(w, b, request),
  clause_dep(b, clause, a, _),
  (request = clause ; clause = "any" ; request = "any").

// One direction of a cycle: a wait a's process makes once it runs, or
// on its way up where the start can be caught in it.
.decl cycle_edge(a: symbol, b: symbol, w: symbol)

cycle_edge(a, b, w) :- process_dep(a, b, w, "run").
cycle_edge(a, b, w) :- process_dep(a, b, w, "start"), nameable(a).
cycle_edge(a, b, w) :- calls_back(b, a, w).

call_cycle(a, b, wa, wb, "continue", sa, sb) :-
  continue_dep(a, b, wa),
  continue_dep(b, a, wb),
  a < b,
  sync_site_or_empty(wa, b, sa),
  sync_site_or_empty(wb, a, sb).

// A cycle of one: a synchronous call to the calling process itself — to
// self(), to self() handed to a helper, or from a server's callback to a
// name only its own module's processes hold (self_call, processes.dl).
// gen checks a call's target against self() and exits with
// :calling_self rather than wait forever for a reply the caller would
// have to send. A module_sync_dep cycle needs two modules; this is the
// one it cannot see.
call_cycle(m, m, f, f, "self", id, id) :-
  self_call(f, id),
  function_def(f, m, _, _, _).

// The call in a witness that makes its side of the dependency, when the
// witness makes it directly; empty when a callee does.
.decl sync_site_or_empty(func: symbol, mod: symbol, site: symbol)

sync_site_or_empty(f, m, id) :- sync_site(f, m, id).
sync_site_or_empty(f, m, "") :- module_sync_dep(_, m, f), !sync_site(f, m, _).
sync_site_or_empty(f, m, "") :- continue_dep(_, m, f), !sync_site(f, m, _).

// The edges of a cycle: evidence attached to the call_cycle finding for
// (mod_a, mod_b), one related frame per edge. One row per witness —
// the frames are deduplicated on (mod_a, mod_b, from_mod, to_mod).
// `how` is "tag" when the edge exists only because a dynamic-target call
// was attributed by its message tag, "static" when the callee is named:
// an inferred edge is the first thing to doubt in a surprising cycle.
.decl call_cycle_path(mod_a: symbol, mod_b: symbol, from_mod: symbol, to_mod: symbol, witness: symbol, how: symbol, site: symbol)
.output call_cycle_path

call_cycle_path(a, b, from_mod, to_mod, witness, "tag", site) :-
  call_cycle(a, b, _, _, "call", _, _),
  cycle_edge(from_mod, to_mod, witness),
  (from_mod = a ; from_mod = b),
  (to_mod = a ; to_mod = b),
  reaches_tag_dep(witness, to_mod),
  sync_site_or_empty(witness, to_mod, site).

call_cycle_path(a, b, from_mod, to_mod, witness, "static", site) :-
  call_cycle(a, b, _, _, "call", _, _),
  cycle_edge(from_mod, to_mod, witness),
  (from_mod = a ; from_mod = b),
  (to_mod = a ; to_mod = b),
  !reaches_tag_dep(witness, to_mod),
  sync_site_or_empty(witness, to_mod, site).

// ══ Synchronous fan-in ══════════════════════════════════════════════
.decl sync_caller_witness(caller_mod: symbol, target_mod: symbol, witness: symbol)

sync_caller_witness(caller_mod, target_mod, f) :- module_sync_dep(caller_mod, target_mod, f).

.decl sync_caller(caller_mod: symbol, target_mod: symbol)

sync_caller(caller_mod, target_mod) :- sync_caller_witness(caller_mod, target_mod, _).

// ── Fan-in aggregation ─────────────────────────────────────────────────

// Count of distinct caller modules for each GenServer target.
.decl sync_call_fan_in(target_mod: symbol, cnt: number)
.output sync_call_fan_in

sync_call_fan_in(target_mod, cnt) :-
  behaves_as(target_mod, "GenServer"),
  cnt = count : { sync_caller(_, target_mod) },
  cnt >= 5.

// ── Bottleneck callers ──────────────────────────────────────────────────

// Sync callers filtered to only targets that exceed the fan-in threshold.
// This separates normal centralized services (1–4 callers) from true
// serialization bottlenecks. Evidence attached to the fan-in finding,
// one related frame per caller module: one row per witness, frames
// deduplicated on (caller_mod, target_mod).
.decl bottleneck_caller(caller_mod: symbol, target_mod: symbol, witness: symbol)
.output bottleneck_caller

bottleneck_caller(caller_mod, target_mod, witness) :-
  sync_caller_witness(caller_mod, target_mod, witness),
  sync_call_fan_in(target_mod, _).

// ══ A receive on an OTP process's own stack ═════════════════════════
.decl same_process_edge(caller: symbol, callee: symbol)

same_process_edge(caller, callee) :-
  call_edge(caller, callee),
  !runs_elsewhere(caller, callee).

.decl callback_reaches(entry: symbol, func: symbol, proximity: symbol)

callback_reaches(entry, entry, "direct") :-
  otp_callback(entry, _, _, _).

callback_reaches(entry, callee, "helper") :-
  otp_callback(entry, _, _, _),
  same_process_edge(entry, callee).

// ── Findings ─────────────────────────────────────────────────────

// ── The cancel_timer flush idiom ─────────────────────────────────
//
// A blocking receive is NOT a bug when it is flushing an already-delivered
// timer message:
//
//     if Process.cancel_timer(ref) == false do
//       receive do :tick -> :ok end
//     end
//
// `cancel_timer/1` returning false means the timer had already expired, so
// the message has already been sent and is sitting in the mailbox — the
// receive is guaranteed to match, and OTP's own code is written this way.
// This is the documented way to keep a stale timer message from being
// mistaken for a fresh one later.
//
// Found by verification, not by anticipation: both blocking receives in the
// first corpus sweep were this idiom, and reporting them as hangs would
// have been the analysis's entire output on that project.
//
// The flush is the receive, not the function: a function that cancels a
// timer suppresses a blocking receive of its own only when that receive
// can take a timer's message — a clause for a literal one of the
// module's timers is armed with, for :timeout (erlang:start_timer/3's
// `{timeout, Ref, Msg}`), or for anything. A receive whose every clause
// names some other literal, in a module whose timers all carry known
// literals, is waiting for something else, and is reported. When the
// module arms no timer the program can see (the ref came from a caller)
// or arms one whose message is not a known literal, the receive may be
// the flush, and stays suppressed: the quiet direction.
.decl cancels_timer(func: symbol)

cancels_timer(func) :-
  remote_call(_, func, ":erlang", "cancel_timer", _).

.decl timer_message(mod: symbol, message: symbol)

timer_message(mod, lit) :-
  timer_arm(_, a, _, "bare", _, lit),
  function_def(a, mod, _, _, _).

timer_message(mod, lit) :-
  timer_arm(_, a, _, "param", pos, _),
  resolved_arg(a, pos, lit),
  function_def(a, mod, _, _, _).

.decl timer_message_unknown(mod: symbol)

timer_message_unknown(mod) :-
  timer_arm(_, a, _, "dynamic", _, _),
  function_def(a, mod, _, _, _).

timer_message_unknown(mod) :-
  timer_arm(_, a, _, "param", pos, _),
  !resolved_arg(a, pos, _),
  function_def(a, mod, _, _, _).

.decl takes_timer_message(recv: symbol)

takes_timer_message(id) :- recv_pattern(id, _, "any").
takes_timer_message(id) :- recv_pattern(id, _, ":timeout").

takes_timer_message(id) :-
  recv_pattern(id, f, lit),
  function_def(f, mod, _, _, _),
  timer_message(mod, lit).

.decl waits_for_other(recv: symbol)

waits_for_other(id) :-
  recv_pattern(id, f, _),
  function_def(f, mod, _, _, _),
  timer_message(mod, _),
  !timer_message_unknown(mod),
  !takes_timer_message(id).

.decl flush_receive(recv: symbol)

flush_receive(id) :-
  recv_start(id, func, _, _),
  cancels_timer(func),
  !waits_for_other(id).

// A receive with no `after`, running on an OTP process's own stack. This
// is the one that hangs: no timeout means no way out if the expected
// message never arrives, and the supervisor can only brutal-kill.
// A blocking receive init/1 reaches is startup's finding
// (unbounded_effect_in_init, "receive"): it holds the supervisor's start,
// and is reported there once.
receive_in_callback(id, func, callback, behaviour, proximity, "false") :-
  recv_start(id, func, 1, _),
  !recv_down(id, func, _),
  callback_reaches(callback, func, proximity),
  otp_callback(callback, _, _, behaviour),
  !init_function(_, callback),
  !flush_receive(id).

// A receive with no `after` that takes the :DOWN of a monitor its own
// function took (recv_down): the runtime delivers that :DOWN once the
// monitored process exits, or at once if it was already gone, so the
// wait ends no later than that process. Its other clauses can only end
// it sooner. A terminate/2 that stops a process and waits for it to go
// (Broadway's Topology and Terminator) cannot hang on it; what it holds
// is the callback, for as long as that process lives. Reported as a
// bounded receive, "down"; init/1's is startup's, as above.
receive_in_callback(id, func, callback, behaviour, proximity, "down") :-
  recv_start(id, func, 1, _),
  recv_down(id, func, _),
  callback_reaches(callback, func, proximity),
  otp_callback(callback, _, _, behaviour),
  !init_function(_, callback),
  !flush_receive(id).

// A receive WITH a timeout. It cannot hang, but it still consumes from the
// behaviour's mailbox and still re-scans the queue. The flush is the
// exception here too: `receive :tick -> :ok after 0 -> :ok end` after a
// cancel is the form the cancel_timer docs give for taking a timer's
// message that was already delivered, and it takes exactly the message
// the callback means to drop. The facts carry whether a receive can
// block, not its timeout, so a bounded flush is exempt at any bound; a
// bounded receive cannot hang, and this one takes the timer's message.
receive_in_callback(id, func, callback, behaviour, proximity, "true") :-
  recv_start(id, func, 0, _),
  callback_reaches(callback, func, proximity),
  otp_callback(callback, _, _, behaviour),
  !flush_receive(id).

// ══ Remote calls and cluster-wide locks ═════════════════════════════

// ── RPC without timeout ──────────────────────────────────────────

// RPC call using default infinity timeout — hangs while a connected
// peer never answers. A peer that goes away is not forever: erpc (under
// :rpc.call since OTP 23) monitors it, and once net_ticktime notices,
// about a minute by default, :rpc.call returns {:badrpc, :nodedown}
// and :erpc.call raises {:erpc, :noconnection}.
// site is the rpc call instruction. One row per site — finding
// builders dedupe on (func, variant).
// An rpc or a :global op init/1 reaches is startup's finding
// (blocks_on_peer, "remote" and "global"): the same site, with the
// supervisor's start held on it, reported there once.
// `detail` is "caller" when the timeout is a parameter a caller passes
// as :infinity (rpc_infinity_caller names them), empty otherwise.
unbounded_wait(func, call, "rpc", variant, "", "") :-
  rpc_without_timeout(func, call, variant),
  rpc_call(call, _, _, "-1").

unbounded_wait(func, call, "rpc", variant, "caller", "") :-
  rpc_without_timeout(func, call, variant),
  rpc_infinity_caller(func, call, _).

.decl rpc_without_timeout(func: symbol, call: symbol, variant: symbol)

rpc_without_timeout(func, call, variant) :-
  makes_rpc(func, call, variant),
  no_timeout(call),
  !answers_at_once(call),
  !during_init(call).

// An :rpc call a function makes, and which of the rpc functions it is.
.decl makes_rpc(func: symbol, call: symbol, variant: symbol) inline

makes_rpc(f, call, variant) :- rpc_call(call, f, variant, _).

// The variants whose arity leaves the timeout out wait for :infinity,
// as does an explicit :infinity; so does a timeout the function takes
// as a parameter that a caller passes as :infinity.
.decl no_timeout(call: symbol) inline

no_timeout(call) :- rpc_call(call, _, _, "-1").
no_timeout(call) :- rpc_infinity_caller(_, call, _).

// A wrapper's `timeout \\ :infinity` compiles to remote/4 calling
// remote/5 with :infinity, and the rpc in remote/5 reads its timeout
// from the parameter: unknown at the site ("0"), infinity for every call
// through remote/4. `caller` is the function that passes it. Only a
// literal :infinity at the call is followed, not one forwarded through
// a further parameter: call_arg_forward stops at the fourth argument,
// where a timeout is seldom.
.decl rpc_infinity_caller(func: symbol, call: symbol, caller: symbol)
.output rpc_infinity_caller

rpc_infinity_caller(func, call, caller) :-
  rpc_call(call, func, _, "0"),
  rpc_timeout_param(call, p),
  infinity_arg(caller, func, p).

// A remote function that answers without waiting on anything: a BIF,
// an ETS or persistent_term read or write, a clock, a signal. On a
// connected peer it returns; a peer that goes away is noticed within
// net_ticktime. What the call can wait on forever is the callee, and
// this one does not wait. `rpc.call(n, Process, :alive?, [pid])` needs
// no deadline. Vetted one by one: an `:ets` operation on a key (a
// lookup, an insert, a delete, a counter, a step to the next key) and
// `:code.is_loaded` (an ETS read since OTP 26) take no lock another
// process holds; `:ets.delete/1` frees a whole table and tab2list copies
// one, in time proportional to the table and waiting on no process.
// `:ets.select`, `match` and the folds are left out: a match spec over a
// large table can run long. An exit signal or a send is queued and
// returns. A target left off the list is still reported, the direction
// that stays loud about a real wait.
.decl answers_at_once(call: symbol)

answers_at_once(call) :-
  rpc_target(call, target),
  quick_api(mod, fun),
  target = cat(mod, cat(".", fun)).

.decl quick_api(mod: symbol, fun: symbol)

quick_api("Process", "alive?").
quick_api("Process", "whereis").
quick_api("Process", "info").
quick_api("Process", "list").
quick_api("Process", "registered").
quick_api(":erlang", "is_process_alive").
quick_api(":erlang", "whereis").
quick_api(":erlang", "process_info").
quick_api(":erlang", "processes").
quick_api(":erlang", "registered").
quick_api(":erlang", "system_info").
quick_api(":erlang", "memory").
quick_api(":erlang", "statistics").
quick_api(":erlang", "node").
quick_api(":erlang", "nodes").
quick_api(":erlang", "system_time").
quick_api(":erlang", "monotonic_time").
quick_api(":erlang", "exit").
quick_api("Process", "exit").
quick_api(":erlang", "send").
quick_api("Process", "send").
quick_api(":erlang", "function_exported").
quick_api(":erlang", "module_loaded").
quick_api("Node", "self").
quick_api("Node", "list").
quick_api("Node", "alive?").
quick_api("System", "system_time").
quick_api("System", "monotonic_time").
quick_api("System", "os_time").
quick_api("System", "version").
quick_api("System", "otp_release").
quick_api(":os", "timestamp").
quick_api(":os", "system_time").
quick_api(":os", "getpid").
quick_api(":ets", "lookup").
quick_api(":ets", "lookup_element").
quick_api(":ets", "member").
quick_api(":ets", "info").
quick_api(":ets", "tab2list").
quick_api(":ets", "whereis").
quick_api(":ets", "insert").
quick_api(":ets", "insert_new").
quick_api(":ets", "delete").
quick_api(":ets", "delete_object").
quick_api(":ets", "update_counter").
quick_api(":ets", "update_element").
quick_api(":ets", "take").
quick_api(":ets", "first").
quick_api(":ets", "last").
quick_api(":ets", "next").
quick_api(":ets", "prev").
quick_api(":ets", "first_lookup").
quick_api(":ets", "last_lookup").
quick_api(":ets", "next_lookup").
quick_api(":ets", "prev_lookup").
quick_api(":persistent_term", "get").
quick_api(":code", "is_loaded").
quick_api("Application", "get_env").
quick_api("Application", "fetch_env").
quick_api("Application", "fetch_env!").
quick_api(":application", "get_env").

// A site init/1 runs — an rpc or a :global op, in init/1 or in anything
// it calls on its own stack — holds the supervisor's start, and is
// startup's finding (blocks_on_peer, which follows both the same way:
// an rpc over init_reach, a :global op over global_path, the walk
// startup's lock rule reads). Reported there, once. A helper init/1
// shares with handle_call/3 is then reported only as startup's: the
// start is the worse wait.
.init init_reach = SameProcessReach

init_reach.seed(g, site) :- rpc_call(site, g, _, _).

.decl during_init(site: symbol)

during_init(site) :- init_reach.reaches(f, site), is_init(f).
during_init(site) :- global_path(f, _, site), is_init(f).

// ── RPC in GenServer callback ────────────────────────────────────

// Only the RPC directly in the callback is reported. The transitive
// form — `rpc_call(_, g, _, _), call_reachable(func, g)` — was removed:
// call_reachable runs over a function-granularity call graph that
// collapses the clauses of a guarded dispatcher, so on the corpus every
// GenServer callback that reached a library's routing function (Cachex's
// Router.route, whose guards statically pick local vs. RPC) was reported
// as making an RPC, even when the concrete action provably routes local.
// All 13 of the analysis's transitive findings were false; the RPC sites
// themselves are already surfaced by rpc_without_timeout.
unbounded_wait(func, "", "rpc_in_callback", variant, "", "") :-
  rpc_call(_, func, variant, _),
  handler_function(_, func).

// ── Blocking :global synchronization ─────────────────────────────

// :global.set_lock and :global.trans wait without bound when retries
// is :infinity or any positive integer (which retries with backoff);
// retries = "0" means try once and return immediately — non-blocking.
// A lock over the cluster's nodes waits on every one of them and
// stalls on a netsplit; one over `[node()]` waits only on a local
// holder. `nodes` says which (retrying_lock, clientlib/vocabulary.dl).
// site is the :global call instruction. One row per site — finding
// builders dedupe on (func, op, retries, nodes).
unbounded_wait(func, lock, "global", op, retries, nodes) :-
  retrying_lock(lock, func, op, retries, nodes),
  !during_init(lock).

// ══ A peer call that catches :noproc but not :shutdown ══════════════

// ── A peer call that catches :noproc but not :shutdown ───────────────
//
// `catch :exit, {:noproc, _}` around a GenServer.call says the peer may
// not exist. The peer stopping while the call is in flight is the same
// condition, but it arrives as `{:shutdown, _}` (or `{:normal, _}`) —
// and this catch lets it crash the caller. A child LiveView syncing with
// its parent lost the parent's navigation that way
// (phoenixframework/phoenix_live_view#4359). A clause for `{:shutdown,
// _}`, or a bare `:exit, reason`, covers it.
.decl partial_noproc_catch(func: symbol, site: symbol, callee: symbol, call: symbol, guard_end: symbol)
.output partial_noproc_catch

partial_noproc_catch(func, id, callee, call, guard_end) :-
  try_call(id, func, callee, call, guard_end),
  peer_call(callee),
  catch_tag(id, func, "exit", ":noproc"),
  !catch_tag(id, func, "exit", ":shutdown"),
  !catch_tag(id, func, "exit", ":normal"),
  !site_catches_class(id, func, "exit").
