// Unsafe task detection.
//
// Detects two patterns:
//
// 1. Leaked async tasks: Task.async calls in functions that never await
//    the result (directly or transitively through the call graph).
//
// 2. Unchecked start_child: Task.Supervisor.start_child calls where the
//    result is not examined — the call is not in tail position and no
//    branch/test instruction follows it in the function.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"

// ── Additional base facts ──────────────────────────────────────────────

// ── Task.async detection ───────────────────────────────────────────────

.decl task_async_call(func: symbol, id: symbol)

task_async_call(func, id) :-
  remote_call(id, func, "Task", "async", _).

// Also detect Task.Supervisor.async (returns a Task that must be
// awaited/yielded, just like Task.async).
task_async_call(func, id) :-
  remote_call(id, func, "Task.Supervisor", "async", _).

// Task.Supervisor.async_nolink is intentionally excluded: it returns a
// task that is NOT linked to the caller. The supervisor manages the
// lifecycle, making it safe for fire-and-forget patterns.

// ── Task.await/yield detection ─────────────────────────────────────────

.decl task_await_call(func: symbol, id: symbol)

task_await_call(func, id) :-
  remote_call(id, func, "Task", "await", _).

task_await_call(func, id) :-
  remote_call(id, func, "Task", "await_many", _).

task_await_call(func, id) :-
  remote_call(id, func, "Task", "yield", _).

task_await_call(func, id) :-
  remote_call(id, func, "Task", "yield_many", _).

task_await_call(func, id) :-
  remote_call(id, func, "Task", "shutdown", _).

// ── Function-level await reachability ──────────────────────────────────

// Function has an await/yield (directly or through callees).
.init await_reach = CallReachSet

await_reach.seed(func) :- task_await_call(func, _).

// ── Process task handler suppression ─────────────────────────────────

// A process with a callback that can consume task results from its
// mailbox (mailbox_handler: any handle_info/2, or a gen_statem's
// handle_event/4) collects them there rather than by an explicit await.
// ── Task factory suppression ─────────────────────────────────────────

// A function that creates an async task in tail position returns the
// task struct to its caller. The caller is responsible for awaiting —
// this function is a factory, not a leak.
.decl task_factory(func: symbol, id: symbol)

task_factory(func, id) :-
  task_async_call(func, id),
  tail_call(id).

// ── Leaked async task ──────────────────────────────────────────────────

// Function creates an async task but never awaits (directly or
// transitively). The task reference is either discarded or returned
// to a caller that may not await it.
//
// Suppressed for process modules with message-receiving callbacks,
// which consume task results through their mailbox rather than
// explicit await/yield.
// Suppressed for task factories that return the task to the caller.
.decl leaked_async_task(func: symbol, id: symbol)
.output leaked_async_task

leaked_async_task(func, id) :-
  task_async_call(func, id),
  !await_reach.reaches(func),
  function_def(func, mod, _, _, _),
  !mailbox_handler(mod),
  !task_factory(func, id).




// ── Yielding on a linked task ────────────────────────────────────────
//
// Task.async and Task.Supervisor.async link the task to the caller.
// Task.yield/yield_many document an `{:exit, reason}` result for a task
// that crashed — but the link delivers the crash to the caller first, so
// unless the caller traps exits that branch never runs: the caller is
// dead (whatyouhide/redix#317's cluster fan-out, whose partial-failure
// path was unreachable). async_nolink is the tool for that shape.
.decl yield_on_linked_task(func: symbol, id: symbol)
.output yield_on_linked_task

// A closure's calls belong to the function that defines it: the task is
// usually started inside an Enum.map fn and collected outside it.
yield_on_linked_task(owner, id) :-
  task_async_call(f, id),
  enclosing_function(f, owner),
  !closure_def(_, owner),
  (remote_call(_, g, "Task", "yield", _) ; remote_call(_, g, "Task", "yield_many", _)),
  enclosing_function(g, owner),
  function_def(owner, mod, _, _, _),
  !trap_exit(_, mod).

// ── A linked task inside library code ────────────────────────────────
//
// Task.async in a function that is not itself a process's callback links
// the task to whoever called the function. In a caller that traps exits
// the task's normal exit then arrives as an `{:EXIT, pid, :normal}`
// message Task.await never consumes (elixir-ecto/ecto#2246: a GenServer
// preloading in parallel), and a crashing task takes an unrelated
// caller down with it. A module that is a process itself owns its
// callers' expectations; a plain library function does not.
.decl linked_task_in_library(func: symbol, id: symbol)
.output linked_task_in_library

linked_task_in_library(owner, id) :-
  task_async_call(f, id),
  enclosing_function(f, owner),
  !closure_def(_, owner),
  function_def(owner, mod, _, _, _),
  !process_module(mod),
  !task_factory(owner, _),
  await_reach.reaches(owner).

// ── async_nolink whose messages nothing handles ───────────────────────
//
// Task.Supervisor.async_nolink sends the caller two messages it did not
// ask for by name: `{ref, result}` and `{:DOWN, ref, :process, pid,
// reason}`. A GenServer that starts one from a callback and does not
// collect it there must handle both in handle_info/2; a partial
// handle_info is a FunctionClauseError on the first task that finishes
// (archethic-node#1306, sentry-elixir#172, Engram#1552). GenServer's
// default handle_info logs and ignores, so only a module with its own
// partial handle_info/2 is at risk.
.init nolink_reach = CallReach

nolink_reach.seed(f, f) :- mailbox_writer(_, f, "task_nolink").

.decl nolink_messages_unhandled(mod: symbol, start: symbol, handler: symbol, missing: symbol)
.output nolink_messages_unhandled

nolink_messages_unhandled(mod, s, h, "reply") :-
  process_entry(mod, c),
  nolink_reach.reaches(c, s),
  partial_handle_info(mod, h),
  !callback_ref_head(h, "handle_info").

nolink_messages_unhandled(mod, s, h, "down") :-
  process_entry(mod, c),
  nolink_reach.reaches(c, s),
  partial_handle_info(mod, h),
  !callback_tag(h, "handle_info", ":DOWN").
