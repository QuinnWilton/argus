// Unsafe task detection.
//
// Detects two patterns:
//
// 1. Leaked async tasks: Task.async calls in functions that never await
//    the result (directly or transitively through the call graph).
//
// 2. Unchecked start_child: Task.Supervisor.start_child calls where the
//    result is not examined — the call is not in tail position and no
//    branch/test instruction follows it in the function.

.include "../clientlib/imports.dl"

// ── Additional base facts ──────────────────────────────────────────────

.decl tail_call(id: symbol)
.input tail_call

.decl implements_behaviour(mod: symbol, behaviour: symbol)
.input implements_behaviour

// ── Task.async detection ───────────────────────────────────────────────

.decl task_async_call(func: symbol, id: symbol)

task_async_call(func, id) :-
  remote_call(id, "Task", "async", _),
  instruction(id, func, _, _).

// Also detect Task.Supervisor.async (returns a Task that must be
// awaited/yielded, just like Task.async).
task_async_call(func, id) :-
  remote_call(id, "Task.Supervisor", "async", _),
  instruction(id, func, _, _).

// Task.Supervisor.async_nolink is intentionally excluded: it returns a
// task that is NOT linked to the caller. The supervisor manages the
// lifecycle, making it safe for fire-and-forget patterns.

// ── Task.await/yield detection ─────────────────────────────────────────

.decl task_await_call(func: symbol, id: symbol)

task_await_call(func, id) :-
  remote_call(id, "Task", "await", _),
  instruction(id, func, _, _).

task_await_call(func, id) :-
  remote_call(id, "Task", "await_many", _),
  instruction(id, func, _, _).

task_await_call(func, id) :-
  remote_call(id, "Task", "yield", _),
  instruction(id, func, _, _).

task_await_call(func, id) :-
  remote_call(id, "Task", "yield_many", _),
  instruction(id, func, _, _).

task_await_call(func, id) :-
  remote_call(id, "Task", "shutdown", _),
  instruction(id, func, _, _).

// ── Function-level await reachability ──────────────────────────────────

// Function has an await/yield (directly or through callees).
.decl has_await(func: symbol)

has_await(func) :- task_await_call(func, _).
has_await(func) :- call_reachable(func, g), task_await_call(g, _).

// ── Process task handler suppression ─────────────────────────────────

// Process module with a message-receiving callback that can consume
// task results from its mailbox. Covers GenServer, LiveView,
// gen_statem, and similar process-hosting behaviours.
.decl process_task_handler(mod: symbol)

// GenServer with handle_info/2.
process_task_handler(mod) :-
  implements_behaviour(mod, "GenServer"),
  function_def(_, mod, "handle_info", 2, _).

// Phoenix.LiveView with handle_info/2.
process_task_handler(mod) :-
  implements_behaviour(mod, "Phoenix.LiveView"),
  function_def(_, mod, "handle_info", 2, _).

// Phoenix.LiveComponent with handle_info/2.
process_task_handler(mod) :-
  implements_behaviour(mod, "Phoenix.LiveComponent"),
  function_def(_, mod, "handle_info", 2, _).

// :gen_statem with handle_event/4.
process_task_handler(mod) :-
  implements_behaviour(mod, ":gen_statem"),
  function_def(_, mod, "handle_event", 4, _).

// GenStateMachine (Elixir wrapper) with handle_event/4.
process_task_handler(mod) :-
  implements_behaviour(mod, "GenStateMachine"),
  function_def(_, mod, "handle_event", 4, _).

// ── Task factory suppression ─────────────────────────────────────────

// A function that creates an async task in tail position returns the
// task struct to its caller. The caller is responsible for awaiting —
// this function is a factory, not a leak.
.decl task_factory(func: symbol, id: symbol)

task_factory(func, id) :-
  task_async_call(func, id),
  tail_call(id).

// ── Leaked async task ──────────────────────────────────────────────────

// Function creates an async task but never awaits (directly or
// transitively). The task reference is either discarded or returned
// to a caller that may not await it.
//
// Suppressed for process modules with message-receiving callbacks,
// which consume task results through their mailbox rather than
// explicit await/yield.
// Suppressed for task factories that return the task to the caller.
.decl leaked_async_task(func: symbol, id: symbol)
.output leaked_async_task

leaked_async_task(func, id) :-
  task_async_call(func, id),
  !has_await(func),
  function_def(func, mod, _, _, _),
  !process_task_handler(mod),
  !task_factory(func, id).

// ── Task.Supervisor.start_child detection ──────────────────────────────

.decl task_start_child_call(func: symbol, id: symbol)

task_start_child_call(func, id) :-
  remote_call(id, "Task.Supervisor", "start_child", _),
  instruction(id, func, _, _).

// ── Unchecked start_child ──────────────────────────────────────────────

// A start_child call whose result is checked: either in tail position
// (result propagated to caller) or followed by a branch instruction in
// the same function (result pattern-matched).
.decl start_child_result_checked(func: symbol, id: symbol)

// Tail position: result goes to the caller.
start_child_result_checked(func, id) :-
  task_start_child_call(func, id),
  tail_call(id).

// Branch after start_child: result is pattern-matched.
start_child_result_checked(func, id) :-
  task_start_child_call(func, id),
  instruction(id, func, sc_idx, _),
  instruction(bid, func, bidx, _),
  branch(bid, _, _),
  bidx > sc_idx.

// start_child call whose result is not checked by any of the above.
.decl unchecked_start_child(func: symbol, id: symbol)
.output unchecked_start_child

unchecked_start_child(func, id) :-
  task_start_child_call(func, id),
  !start_child_result_checked(func, id).
