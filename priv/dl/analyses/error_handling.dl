// Error handling analysis.
//
// Detects error handling anti-patterns: swallowed errors, trap_exit without
// handlers, exit in callbacks, and ignored start results.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
// ── Swallowed errors ─────────────────────────────────────────────

// Catch-all rescue that silently discards exceptions.
.decl swallowed_error(func: symbol)
.output swallowed_error

swallowed_error(func) :-
  bare_rescue(_, func).

// ── Trap exit without handler ────────────────────────────────────

// Module traps exits but defines no handle_info callback that could
// receive {:EXIT, ...} messages. This is a heuristic — we check if
// the module has any handle_info function.
.decl has_handle_info(mod: symbol)

has_handle_info(mod) :-
  function_def(_, mod, "handle_info", _, _).

// gen_statem / GenStateMachine modules deliver info events (including
// {:EXIT, ...}) to their state functions or handle_event/4, not to a
// handle_info callback, so the has_handle_info check is meaningless for
// them — every trapping gen_statem would be a false positive (Swarm's
// Tracker even matches {:EXIT, ...} explicitly). Exclude them.
.decl statem_like(mod: symbol)

statem_like(mod) :- behaves_as(mod, "GenStateMachine").

// `witness` is the function that sets trap_exit. One row per witness —
// finding builders dedupe on (mod).
.decl trap_exit_without_handler(mod: symbol, witness: symbol)
.output trap_exit_without_handler

trap_exit_without_handler(mod, func) :-
  trap_exit(func, mod),
  !has_handle_info(mod),
  !statem_like(mod).

// ── Trap exit with a handle_info that never matches {:EXIT, ...} ──
//
// The module defines handle_info/2 — so the check above is satisfied —
// but no clause discriminates on :EXIT and none is a catch-all. The
// trapped exit arrives as a message no clause accepts, and the process
// dies with a FunctionClauseError on the very signal trapping was meant
// to absorb. Bandit's HTTP/1 handler shipped this shape: trap_exit set
// by `use ThousandIsland.Handler`, one handle_info clause for
// {:plug_conn, :sent}, and a Plug that spawned a port took the
// connection down.
//
// callback_tag over-approximates (every atom compared anywhere in the
// body counts), so a module that mentions :EXIT at all is not reported —
// the direction that keeps the rule quiet rather than noisy.
.decl trap_exit_without_exit_clause(mod: symbol, witness: symbol)
.output trap_exit_without_exit_clause

trap_exit_without_exit_clause(mod, func) :-
  trap_exit(func, mod),
  function_def(h, mod, "handle_info", 2, _),
  !callback_total(h, "handle_info"),
  !callback_tag(h, "handle_info", ":EXIT"),
  !statem_like(mod).

// ── handle_info without a catch-all, in a process the runtime writes to ──
//
// Once a GenServer defines handle_info/2, any message no clause matches
// is a FunctionClauseError, not the default log-and-continue. That only
// matters for messages the process did not ask for by protocol — and a
// process that monitors or traps exits has asked the runtime to send it
// messages whose timing it does not control: a late {:DOWN, ...} after a
// demonitor without :flush, an {:EXIT, ...} from a Plug's port. Bandit's
// connection process crashed on exactly those until a catch-all landed.
//
// Subsumed by trap_exit_without_exit_clause when that fires: one
// finding per module, the more specific one.
.decl receives_runtime_messages(mod: symbol)

receives_runtime_messages(mod) :- trap_exit(_, mod).

receives_runtime_messages(mod) :-
  monitor_call(_, f, _),
  function_def(f, mod, _, _, _).

.decl handle_info_without_catchall(mod: symbol, func: symbol)
.output handle_info_without_catchall

handle_info_without_catchall(mod, h) :-
  (behaves_as(mod, "GenServer") ; behaves_as(mod, "GenStage")),
  function_def(h, mod, "handle_info", 2, _),
  !callback_total(h, "handle_info"),
  receives_runtime_messages(mod),
  !trap_exit_without_exit_clause(mod, _).

// ── handle_info without a catch-all, with a late-message source ──
//
// The variant above needs the module itself to invite runtime messages.
// A mailbox is written by more than its owner: a timed call that gave
// up leaves a late reply (gen_stage#238, an hackney message crashing a
// Flow producer), a Task.async replies, a timer fires after the state
// that expected it is gone, a subscription broadcasts, a start-up
// message is re-sent by a restart loop (cachex#314), and code the
// process runs through a closure or apply is not its own to vouch for
// (gen_stage#238's producer ran the user's stream). A partial
// handle_info/2 in a process whose callbacks reach such a source is a
// FunctionClauseError waiting for that message. Without any source in
// reach the shape is a style note, and stays quiet. Info: the two rules
// above stay the warning-grade shapes.
.decl reaches_mailbox_writer(func: symbol)

reaches_mailbox_writer(f) :- mailbox_writer(_, f, _).
reaches_mailbox_writer(f) :- sync_call_timeout(f, _, ms), ms != -1.
reaches_mailbox_writer(f) :- call_edge(f, g), reaches_mailbox_writer(g).

.decl late_message_source(mod: symbol)

late_message_source(mod) :-
  process_entry(mod, c),
  reaches_mailbox_writer(c).

.decl handle_info_partial(mod: symbol, func: symbol)
.output handle_info_partial

handle_info_partial(mod, h) :-
  (behaves_as(mod, "GenServer") ; behaves_as(mod, "GenStage")),
  function_def(h, mod, "handle_info", 2, _),
  !callback_total(h, "handle_info"),
  late_message_source(mod),
  !receives_runtime_messages(mod),
  !trap_exit_without_exit_clause(mod, _),
  !statem_like(mod).

// ── Exit in GenServer callback ───────────────────────────────────

// Only exit *signals* — Process.exit/2, :erlang.exit/2 — count here.
// `:erlang.exit/1` (target "self") *raises* an exit in the current
// process: the "let it crash on an impossible state" idiom
// (`exit(:unexpected_checkout)`) and ordinary client-call failure
// propagation, both fully supervision-visible and not a bypass. It is
// excluded via `target != "self"`, the sentinel the extractor uses for
// the /1 form.
.decl reaches_exit(func: symbol, target: symbol)

reaches_exit(f, target) :-
  call_edge(f, g),
  exit_call(_, g, target).

reaches_exit(f, target) :-
  call_edge(f, g),
  reaches_exit(g, target).

.decl exit_in_callback(func: symbol, target: symbol)
.output exit_in_callback

exit_in_callback(func, target) :-
  exit_call(_, func, target),
  handler_function(_, func),
  target != "self".

exit_in_callback(func, target) :-
  reaches_exit(func, target),
  handler_function(_, func),
  target != "self".

// ── Ignored start results ────────────────────────────────────────

// GenServer/Supervisor start result not checked.
//
// callee is rendered as "Mod.func/arity", so the function name is
// always preceded by "." and followed by "/" — matching the delimited
// name keeps a callee like "Mod.restart_link/1" from substring-matching
// "start_link".
//
// NOTE Souffle's contains(needle, haystack) takes the needle FIRST. The
// rule originally wrote contains(callee, "start_link") — "is the callee
// a substring of 'start_link'" — which is false for every real callee,
// so this relation had never produced a single row.
.decl ignored_start_result(func: symbol, callee: symbol)
.output ignored_start_result

ignored_start_result(func, callee) :-
  ignored_error_result(_, func, callee),
  (contains(".start_link/", callee) ; contains(".start/", callee)).

// ── A peer call that catches :noproc but not :shutdown ───────────────
//
// `catch :exit, {:noproc, _}` around a GenServer.call says the peer may
// not exist. The peer stopping while the call is in flight is the same
// condition, but it arrives as `{:shutdown, _}` (or `{:normal, _}`) —
// and this catch lets it crash the caller. A child LiveView syncing with
// its parent lost the parent's navigation that way
// (phoenixframework/phoenix_live_view#4359). A clause for `{:shutdown,
// _}`, or a bare `:exit, reason`, covers it.
.decl peer_call(callee: symbol)

peer_call("GenServer:call/2").
peer_call("GenServer:call/3").
peer_call(":gen_server:call/2").
peer_call(":gen_server:call/3").
peer_call(":gen_statem:call/2").
peer_call(":gen_statem:call/3").
peer_call("GenStateMachine:call/2").
peer_call("GenStateMachine:call/3").

.decl partial_noproc_catch(func: symbol, site: symbol, callee: symbol)
.output partial_noproc_catch

partial_noproc_catch(func, id, callee) :-
  try_call(id, func, callee),
  peer_call(callee),
  catch_tag(id, func, "exit", ":noproc"),
  !catch_tag(id, func, "exit", ":shutdown"),
  !catch_tag(id, func, "exit", ":normal"),
  !catch_total(id, func, "exit"),
  !catch_total(id, func, "*").

// ── A timer cancelled but not flushed ────────────────────────────────
//
// Process.cancel_timer/1 does not remove a message the timer already
// delivered. A process that cancels and re-arms a timer whose message
// is a bare atom (`:tick`) cannot tell the stale message from the next
// one: the action fires twice, or early (MongooseIM#3502, beam-bots/bb
// #214; nebulex's generation rotation and cachex's warmer have the
// shape). A message that carries the timer's ref (`{:tick, ref}`, or
// :erlang.start_timer's `{:timeout, ref, _}`) is matched against the
// current ref; a `receive :tick -> :ok after 0 -> :ok end` flushes.
// Cancelling only in terminate/2 arms nothing again.
.decl flushes_mailbox(mod: symbol)

flushes_mailbox(mod) :-
  recv_start(_, f, 0, _),
  function_def(f, mod, _, _, _).

// A timer armed for the arming process whose message is a literal: at
// the site, or a parameter the callers fill with a literal (nebulex's
// `start_timer(time, ref, event)` with `event \\ :heartbeat`).
.decl bare_self_timer(func: symbol, mod: symbol)

bare_self_timer(a, mod) :-
  timer_arm(_, a, "self", "bare", _),
  function_def(a, mod, _, _, _).

bare_self_timer(a, mod) :-
  timer_arm(_, a, "self", "param", pos),
  resolved_arg(a, pos, _),
  function_def(a, mod, _, _, _).

// The module whose mailbox the timer lands in: a process module, or a
// helper that arms timers for whichever process calls it (bb's
// BB.Loop, a struct that a component's callbacks drive).
.decl timer_owner(mod: symbol)

timer_owner(mod) :- process_entry(mod, _).
timer_owner(mod) :- bare_self_timer(_, mod).

.decl timer_cancel_without_flush(mod: symbol, cancel: symbol, arm: symbol)
.output timer_cancel_without_flush

timer_cancel_without_flush(mod, c, a) :-
  mailbox_writer(_, c, "cancel"),
  function_def(c, mod, _, _, _),
  !terminate_callback(c, mod, _),
  bare_self_timer(a, mod),
  timer_owner(mod),
  !flushes_mailbox(mod).
