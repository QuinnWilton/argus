// Error handling analysis.
//
// Detects error handling anti-patterns: swallowed errors, trap_exit without
// handlers, exit in callbacks, and ignored start results.

.include "../clientlib/imports.dl"

// ── Swallowed errors ─────────────────────────────────────────────

// Catch-all rescue that silently discards exceptions.
.decl swallowed_error(func: symbol)
.output swallowed_error

swallowed_error(func) :-
  bare_rescue(_, func).

// ── Trap exit without handler ────────────────────────────────────

// Module traps exits but defines no handle_info callback that could
// receive {:EXIT, ...} messages. This is a heuristic — we check if
// the module has any handle_info function.
.decl has_handle_info(mod: symbol)

has_handle_info(mod) :-
  function_def(_, mod, "handle_info", _, _).

// gen_statem / GenStateMachine modules deliver info events (including
// {:EXIT, ...}) to their state functions or handle_event/4, not to a
// handle_info callback, so the has_handle_info check is meaningless for
// them — every trapping gen_statem would be a false positive (Swarm's
// Tracker even matches {:EXIT, ...} explicitly). Exclude them.
.decl statem_like(mod: symbol)

statem_like(mod) :- implements_behaviour(mod, ":gen_statem").
statem_like(mod) :- implements_behaviour(mod, "GenStateMachine").

// `witness` is the function that sets trap_exit. One row per witness —
// finding builders dedupe on (mod).
.decl trap_exit_without_handler(mod: symbol, witness: symbol)
.output trap_exit_without_handler

trap_exit_without_handler(mod, func) :-
  trap_exit(func, mod),
  !has_handle_info(mod),
  !statem_like(mod).

// ── Exit in GenServer callback ───────────────────────────────────

// Detect explicit Process.exit/2 in GenServer callbacks.
.decl genserver_callback(func: symbol, mod: symbol)

genserver_callback(func, mod) :-
  function_def(func, mod, "handle_call", _, _),
  implements_behaviour(mod, "GenServer").

genserver_callback(func, mod) :-
  function_def(func, mod, "handle_cast", _, _),
  implements_behaviour(mod, "GenServer").

genserver_callback(func, mod) :-
  function_def(func, mod, "handle_info", _, _),
  implements_behaviour(mod, "GenServer").

// Only exit *signals* — Process.exit/2, :erlang.exit/2 — count here.
// `:erlang.exit/1` (target "self") *raises* an exit in the current
// process: the "let it crash on an impossible state" idiom
// (`exit(:unexpected_checkout)`) and ordinary client-call failure
// propagation, both fully supervision-visible and not a bypass. It is
// excluded via `target != "self"`, the sentinel the extractor uses for
// the /1 form.
.decl exit_in_callback(func: symbol, target: symbol)
.output exit_in_callback

exit_in_callback(func, target) :-
  exit_call(_, func, target),
  genserver_callback(func, _),
  target != "self".

exit_in_callback(func, target) :-
  exit_call(_, callee_func, target),
  call_reachable(func, callee_func),
  genserver_callback(func, _),
  target != "self".

// ── Ignored start results ────────────────────────────────────────

// GenServer/Supervisor start result not checked.
//
// callee is rendered as "Mod.func/arity", so the function name is
// always preceded by "." and followed by "/" — matching the delimited
// name keeps a callee like "Mod.restart_link/1" from substring-matching
// "start_link".
//
// NOTE Souffle's contains(needle, haystack) takes the needle FIRST. The
// rule originally wrote contains(callee, "start_link") — "is the callee
// a substring of 'start_link'" — which is false for every real callee,
// so this relation had never produced a single row.
.decl ignored_start_result(func: symbol, callee: symbol)
.output ignored_start_result

ignored_start_result(func, callee) :-
  ignored_error_result(_, func, callee),
  (contains(".start_link/", callee) ; contains(".start/", callee)).
