// Coverage and precision meta-analysis.
//
// Measures where the extractor pipeline either fell back to a dynamic
// placeholder (active instrumentation) or recognized a BEAM/OTP shape
// but couldn't recover its detail (passive shape-gap queries). Together
// these surface the "recall-side" gaps: places where a smarter extractor
// could produce more concrete facts.
//
// The active side flows through the :imprecision fact relation (only
// populated when the pipeline runs with trace_imprecision: true, which
// Argus.Analysis sets automatically for this analysis). The passive side
// is derived from the existing Layer 2 fact base — no extractor changes
// required, which means adding a new shape-gap rule is a pure .dl edit.
//
// Output is intentionally raw events plus shape-level counts; aggregation
// into category histograms happens in the consumer so diff tools can
// slice the data however they want.

.include "../clientlib/imports.dl"

// ── Input facts ──────────────────────────────────────────────────────

.decl imprecision(category: symbol, func: symbol, relation: symbol, reason: symbol)
.input imprecision

.decl supervisor(mod: symbol, strategy: symbol, site: symbol)
.input supervisor

.decl supervisor_child(sup: symbol, position: number, child_mod: symbol, restart: symbol, type: symbol)
.input supervisor_child

.decl dynamic_child(sup: symbol, child_mod: symbol, caller_func: symbol)
.input dynamic_child

.decl implements_behaviour(mod: symbol, behaviour: symbol)
.input implements_behaviour

.decl sync_call(caller_func: symbol, callee_mod: symbol)
.input sync_call

.decl async_cast(caller_func: symbol, callee_mod: symbol)
.input async_cast

.decl ets_new(id: symbol, func: symbol, name: symbol)
.input ets_new

.decl ets_op(id: symbol, func: symbol, table_ref: symbol, op: symbol, kind: symbol)
.input ets_op

.decl statem_module(mod: symbol, callback_mode: symbol)
.input statem_module

.decl statem_state(mod: symbol, state: symbol, site: symbol)
.input statem_state

.decl statem_transition(mod: symbol, from_state: symbol, event: symbol, to_state: symbol)
.input statem_transition

.decl named_process(mod: symbol, name: symbol)
.input named_process

// ── Active instrumentation passthrough ──────────────────────────────
//
// Expose the raw imprecision events so the consumer can aggregate them
// however it wants (by category, by function, by relation, etc.).
// No Datalog aggregation is done here — keeping the rule trivial makes
// it easy to extend without rewriting the schema.

.decl imprecision_event(category: symbol, func: symbol, relation: symbol, reason: symbol)
.output imprecision_event

imprecision_event(c, f, r, why) :- imprecision(c, f, r, why).

// ── Passive shape-gap queries ───────────────────────────────────────

// A supervisor that was recognized (we extracted its strategy) but no
// static children — neither supervisor_child nor dynamic_child fires.
// Either init/1 builds children at runtime via Enum.map/comprehensions,
// or the child spec shape isn't recognized by the extractor. Both are
// recall gaps worth surfacing.
.decl coverage_supervisor_no_children(sup: symbol)
.output coverage_supervisor_no_children

coverage_supervisor_no_children(sup) :-
  supervisor(sup, _, _),
  !supervisor_child(sup, _, _, _, _),
  !dynamic_child(sup, _, _).

// A GenServer behaviour module that is never the target of a sync_call
// or async_cast AND is not a supervisor child (static or dynamic).
// Supervised modules are definitively reachable — the supervisor starts
// them — so they shouldn't be flagged as "isolated" even when we can't
// see their callers.
.decl coverage_genserver_isolated(mod: symbol)
.output coverage_genserver_isolated

coverage_genserver_isolated(mod) :-
  implements_behaviour(mod, "GenServer"),
  !sync_call(_, mod),
  !async_cast(_, mod),
  !supervisor_child(_, _, mod, _, _),
  !dynamic_child(_, mod, _).

// An ETS table was created with a statically known name but we see no
// read or write operations against that name anywhere in the corpus.
// Most commonly means all access sites fell through to "dynamic" and
// lost the table name. Excluding "dynamic" itself from the join is
// critical — otherwise every project with any dynamic ETS access would
// fire this on every statically-named table.
//
// Also excluded: tables whose creating module has ANY ets_ops (even
// with dynamic table refs). When a module creates one named table and
// also accesses ETS via a tid parameter, the dynamic ops almost
// certainly refer to the same table — the name-based join just can't
// see the connection. Flagging these as "unused" is misleading.
.decl ets_module_has_ops(name: symbol, mod: symbol)

ets_module_has_ops(name, mod) :-
  ets_new(_, create_func, name),
  name != "dynamic",
  function_def(create_func, mod, _, _, _, _),
  ets_op(_, op_func, _, _, _),
  function_def(op_func, mod, _, _, _, _).

.decl coverage_ets_unused(name: symbol)
.output coverage_ets_unused

coverage_ets_unused(name) :-
  ets_new(_, _, name),
  name != "dynamic",
  !ets_op(_, _, name, _, _),
  !ets_module_has_ops(name, _).

// A named process was registered but no sync or async traffic targets it.
// Excludes "dynamic" names — they can't be meaningfully joined with
// callers, so flagging them as unreachable is vacuous.
.decl coverage_named_process_unreachable(name: symbol, mod: symbol)
.output coverage_named_process_unreachable

coverage_named_process_unreachable(name, mod) :-
  named_process(mod, name),
  name != "dynamic",
  !sync_call(_, name),
  !async_cast(_, name).
