// Process bottleneck detection.
//
// Identifies GenServer modules with high synchronous call fan-in:
// many distinct caller modules make GenServer.call to the same target.
// These are serialization points that can become throughput bottlenecks
// under load.

.include "../clientlib/imports.dl"

// ── Layer 2 facts ──────────────────────────────────────────────────────

.decl sync_call(caller_func: symbol, callee_mod: symbol)
.input sync_call

.decl implements_behaviour(mod: symbol, behaviour: symbol)
.input implements_behaviour

// ── GenServer API identification ───────────────────────────────────────

// otp.dl requires async_cast — declare an empty relation since
// process_bottleneck only uses sync paths.
.decl async_cast(caller_func: symbol, callee_mod: symbol)
.input async_cast

.include "../clientlib/otp.dl"

// ── Module-level sync callers ──────────────────────────────────────────

// Module caller_mod has at least one function that sync-calls target_mod.
.decl sync_caller(caller_mod: symbol, target_mod: symbol)

// Direct: a function in caller_mod has a sync_call with resolved target.
sync_caller(caller_mod, target_mod) :-
  function_def(f, caller_mod, _, _, _, _),
  sync_call(f, target_mod),
  target_mod != "dynamic",
  caller_mod != target_mod.

// Indirect via callgraph: a function in caller_mod reaches a function
// that has a sync_call with resolved target.
sync_caller(caller_mod, target_mod) :-
  function_def(f, caller_mod, _, _, _, _),
  call_reachable(f, g),
  sync_call(g, target_mod),
  target_mod != "dynamic",
  caller_mod != target_mod.

// Indirect via GenServer API: a function in caller_mod calls an exported
// sync API function of target_mod.
sync_caller(caller_mod, target_mod) :-
  function_def(f, caller_mod, _, _, _, _),
  call_edge(f, g),
  genserver_sync_api(g, target_mod),
  caller_mod != target_mod.

// ── Fan-in aggregation ─────────────────────────────────────────────────

// Count of distinct caller modules for each GenServer target.
.decl sync_call_fan_in(target_mod: symbol, cnt: number)
.output sync_call_fan_in

sync_call_fan_in(target_mod, cnt) :-
  implements_behaviour(target_mod, "GenServer"),
  cnt = count : { sync_caller(_, target_mod) },
  cnt >= 5.

// ── Bottleneck callers ──────────────────────────────────────────────────

// Sync callers filtered to only targets that exceed the fan-in threshold.
// This separates normal centralized services (1–4 callers) from true
// serialization bottlenecks.
.decl bottleneck_caller(caller_mod: symbol, target_mod: symbol)
.output bottleneck_caller

bottleneck_caller(caller_mod, target_mod) :-
  sync_caller(caller_mod, target_mod),
  sync_call_fan_in(target_mod, _).
