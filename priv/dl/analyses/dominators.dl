// Dominator and post-dominator analysis.
//
// Computes instruction-level dominance within each function's CFG.
// Uses a negation-based approach: A dominates B iff every path from the
// function entry to B passes through A.
//
// Adapted from Gigahorse's clientlib/dominators.dl.

.include "../clientlib/cfg.dl"

// function_def, label_at, instruction are declared via base.dl (included by cfg.dl).

// ── Function entry points ────────────────────────────────────────────

// The entry instruction of a function (first instruction after entry label).
.decl function_entry(func: symbol, entry_id: symbol)

function_entry(func, entry_id) :-
  function_def(func, _, _, _, entry_label, _),
  label_at(entry_label, entry_id).

// Map each instruction to its containing function.
.decl in_function(id: symbol, func: symbol)

in_function(id, func) :-
  instruction(id, func, _, _).

// ── Dominators ───────────────────────────────────────────────────────

// Instruction A does NOT dominate B if there is a path from the function
// entry to B that bypasses A entirely.

// Base: entry reaches itself without going through A (as long as A != entry).
.decl does_not_dominate(a: symbol, b: symbol, func: symbol)

does_not_dominate(a, entry_id, func) :-
  function_entry(func, entry_id),
  in_function(a, func),
  a != entry_id.

// Step: if A doesn't dominate some node C, and C flows to B (and B != A),
// then A doesn't dominate B either.
does_not_dominate(a, b, func) :-
  does_not_dominate(a, c, func),
  cfg_edge(c, b),
  in_function(b, func),
  a != b.

// A dominates B iff A doesn't NOT dominate B, both are in the same function,
// and A != B (strict dominance).
.decl dominates(dominator: symbol, id: symbol, func: symbol)
.output dominates

dominates(a, b, func) :-
  in_function(a, func),
  in_function(b, func),
  a != b,
  !does_not_dominate(a, b, func).

// ── Post-dominators ──────────────────────────────────────────────────

// A post-dominates B iff every path from B to a function exit passes
// through A. We identify exits as instructions with no CFG successor
// within the same function.

.decl function_exit(func: symbol, exit_id: symbol)

function_exit(func, id) :-
  in_function(id, func),
  !has_successor_in_function(id, func).

// Helper: instruction has at least one successor in the same function.
.decl has_successor_in_function(id: symbol, func: symbol)

has_successor_in_function(id, func) :-
  cfg_edge(id, succ),
  in_function(id, func),
  in_function(succ, func).

// A does NOT post-dominate B if there's a path from B to an exit
// that avoids A.

.decl does_not_post_dominate(a: symbol, b: symbol, func: symbol)

// Base: an exit reaches itself without going through A (as long as A != exit).
does_not_post_dominate(a, exit_id, func) :-
  function_exit(func, exit_id),
  in_function(a, func),
  a != exit_id.

// Step: if A doesn't post-dominate C, and B flows to C (and B != A),
// then A doesn't post-dominate B either.
does_not_post_dominate(a, b, func) :-
  does_not_post_dominate(a, c, func),
  cfg_edge(b, c),
  in_function(b, func),
  a != b.

// Strict post-dominance.
.decl post_dominates(post_dominator: symbol, id: symbol, func: symbol)
.output post_dominates

post_dominates(a, b, func) :-
  in_function(a, func),
  in_function(b, func),
  a != b,
  !does_not_post_dominate(a, b, func).

// ── Immediate dominator ──────────────────────────────────────────────

// The immediate dominator of B is the closest strict dominator — it
// dominates B but doesn't dominate any other dominator of B.

.decl idom(id: symbol, immediate_dominator: symbol, func: symbol)
.output idom

// A is NOT the immediate dominator of B if there's a dominator C of B
// that A also dominates (i.e., A dominates C dominates B, so A isn't closest).
.decl not_idom(a: symbol, b: symbol, func: symbol)

not_idom(a, b, func) :-
  dominates(a, b, func),
  dominates(a, c, func),
  dominates(c, b, func),
  a != c.

idom(b, a, func) :-
  dominates(a, b, func),
  !not_idom(a, b, func).
