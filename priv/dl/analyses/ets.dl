// ETS table ownership, concurrency, and lifecycle analysis.
//
// Detects common ETS anti-patterns:
// - Tables owned by processes without heir protection.
// - Cross-module access without concurrency settings.
// - Write contention on ordered_set tables.
// - Unnamed tables in processes (stale reference risk).
//
// Tables whose name resolves to "dynamic" are excluded from derived rules
// because their identity is unknown — joining on "dynamic" conflates
// independent tables and produces false positives.

.include "../clientlib/imports.dl"
.include "../clientlib/behaviours.dl"

// ── Ownership & lifecycle ──────────────────────────────────────────

// Module that creates a table and implements a behaviour (is a process).
.decl ets_owner_process(name: symbol, mod: symbol, behaviour: symbol)

ets_owner_process(name, mod, behaviour) :-
  ets_new(id, func, name),
  name != "dynamic",
  function_def(func, mod, _, _, _),
  behaves_as(mod, behaviour).

// Owner under a permanent supervisor child — the table will be
// recreated on restart, so the missing heir is not a real risk.
.decl ets_permanent_owner(name: symbol, mod: symbol)

ets_permanent_owner(name, mod) :-
  ets_owner_process(name, mod, _),
  supervisor_child(_, _, mod, "permanent", _).

// Owner under a DynamicSupervisor.start_child — we don't know the
// child spec's restart strategy without further analysis, but the
// module is at least supervised, which is a strong enough signal
// that we shouldn't false-positive on missing-heir for it.
ets_permanent_owner(name, mod) :-
  ets_owner_process(name, mod, _),
  dynamic_child(_, mod, _).

// Application modules live for the entire app — table loss is not practical.
.decl ets_application_owner(name: symbol, mod: symbol)

ets_application_owner(name, mod) :-
  ets_owner_process(name, mod, "Application").

// Table without heir protection in a behaviour process.
// If the owner crashes, the table vanishes.
// Suppressed for permanent supervisor children (table recreated on restart)
// and Application modules (live for the entire app lifetime).
// site is the :ets.new/2 instruction — the creation line.
.decl ets_unprotected_owner(name: symbol, mod: symbol, site: symbol)
.output ets_unprotected_owner

ets_unprotected_owner(name, mod, id) :-
  ets_owner_process(name, mod, _),
  ets_new(id, _, name),
  name != "dynamic",
  !ets_option(id, "heir", "true"),
  !ets_permanent_owner(name, mod),
  !ets_application_owner(name, mod).

// ── Concurrent access patterns ─────────────────────────────────────

// Module reading from a table.
.decl ets_reader_module(name: symbol, mod: symbol)

ets_reader_module(name, mod) :-
  ets_op(_, func, name, _, "read"),
  name != "dynamic",
  function_def(func, mod, _, _, _).

// Module writing to a table.
.decl ets_writer_module(name: symbol, mod: symbol)

ets_writer_module(name, mod) :-
  ets_op(_, func, name, _, "write"),
  name != "dynamic",
  function_def(func, mod, _, _, _).

// Cross-module reads without read_concurrency.
.decl ets_missing_read_concurrency(name: symbol)
.output ets_missing_read_concurrency

ets_missing_read_concurrency(name) :-
  ets_reader_module(name, m1),
  ets_reader_module(name, m2),
  name != "dynamic",
  m1 < m2,
  ets_new(id, _, name),
  !ets_option(id, "read_concurrency", "true").

// Cross-module writes without write_concurrency.
.decl ets_missing_write_concurrency(name: symbol)
.output ets_missing_write_concurrency

ets_missing_write_concurrency(name) :-
  ets_writer_module(name, m1),
  ets_writer_module(name, m2),
  name != "dynamic",
  m1 < m2,
  ets_new(id, _, name),
  !ets_option(id, "write_concurrency", "true"),
  !ets_option(id, "write_concurrency", "auto").

// Write contention on ordered_set (higher lock contention).
// site is the :ets.new/2 instruction that chose ordered_set.
.decl ets_ordered_set_contention(name: symbol, mod1: symbol, mod2: symbol, site: symbol)
.output ets_ordered_set_contention

ets_ordered_set_contention(name, mod1, mod2, id) :-
  ets_writer_module(name, mod1),
  ets_writer_module(name, mod2),
  name != "dynamic",
  mod1 < mod2,
  ets_new(id, _, name),
  ets_option(id, "type", "ordered_set").

// ── Stale reference risk ───────────────────────────────────────────

// Table created without named_table by a process —
// the reference becomes invalid if the owner restarts.
// site is the :ets.new/2 instruction — the creation line.
.decl ets_unnamed_in_process(name: symbol, mod: symbol, site: symbol)
.output ets_unnamed_in_process

ets_unnamed_in_process(name, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  function_def(func, mod, _, _, _),
  implements_behaviour(mod, _),
  !ets_option(id, "named_table", "true").

// ── Write-only tables ──────────────────────────────────────────────
//
// A named table that the code inserts into from outside init/1 and
// never deletes from is a table that only grows. Sentry's check-in ID
// mapping was one: every check-in inserted a row, nothing ever removed
// one, and the process held the table for the life of the VM. A table
// filled once in init/1 and read thereafter is a cache, not a leak, and
// is not reported.
//
// Any removal on a dynamic table reference in the owner's module is
// taken as possibly this table — the direction that stays quiet.
.decl ets_removal_op(op: symbol)

ets_removal_op("delete").
ets_removal_op("delete_object").
ets_removal_op("delete_all_objects").
ets_removal_op("select_delete").
ets_removal_op("match_delete").
ets_removal_op("take").

.decl ets_table_shrinks(name: symbol, owner: symbol)

ets_table_shrinks(name, owner) :-
  ets_new(_, func, name),
  function_def(func, owner, _, _, _),
  ets_op(_, _, name, op, _),
  ets_removal_op(op).

ets_table_shrinks(name, owner) :-
  ets_new(_, func, name),
  function_def(func, owner, _, _, _),
  ets_op(_, f, "dynamic", op, _),
  ets_removal_op(op),
  function_def(f, owner, _, _, _).

.decl ets_grows_outside_init(name: symbol)

ets_grows_outside_init(name) :-
  ets_op(_, f, name, op, "write"),
  (op = "insert" ; op = "insert_new"),
  function_def(f, _, fname, _, _),
  fname != "init".

.decl ets_write_only_table(name: symbol, mod: symbol, site: symbol)
.output ets_write_only_table

ets_write_only_table(name, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  ets_option(id, "named_table", "true"),
  function_def(func, mod, _, _, _),
  ets_grows_outside_init(name),
  !ets_table_shrinks(name, mod).
