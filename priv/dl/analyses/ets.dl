// ETS table ownership, concurrency, and lifecycle analysis.
//
// Detects common ETS anti-patterns:
// - Tables owned by processes without heir protection.
// - Cross-module access without concurrency settings.
// - Write contention on ordered_set tables.
// - Unnamed tables in processes (stale reference risk).
//
// Tables whose name resolves to "dynamic" are excluded from derived rules
// because their identity is unknown — joining on "dynamic" conflates
// independent tables and produces false positives.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/request_entry.dl"
.include "../clientlib/concurrency.dl"
.include "../clientlib/check_then_act.dl"
.include "../clientlib/specs.dl"

// ── Ownership & lifecycle ──────────────────────────────────────────

// Module that creates a table and implements a behaviour (is a process).
.decl ets_owner_process(name: symbol, mod: symbol, behaviour: symbol)

ets_owner_process(name, mod, behaviour) :-
  ets_new(_, func, name),
  name != "dynamic",
  function_def(func, mod, _, _, _),
  behaves_as(mod, behaviour).

// Owner under a permanent supervisor child — the table will be
// recreated on restart, so the missing heir is not a real risk.
.decl ets_permanent_owner(name: symbol, mod: symbol)

ets_permanent_owner(name, mod) :-
  ets_owner_process(name, mod, _),
  supervisor_child(_, _, mod, "permanent", _).

// Owner under a DynamicSupervisor.start_child — we don't know the
// child spec's restart strategy without further analysis, but the
// module is at least supervised, which is a strong enough signal
// that we shouldn't false-positive on missing-heir for it.
ets_permanent_owner(name, mod) :-
  ets_owner_process(name, mod, _),
  dynamic_child(_, mod, _).

// Application modules live for the entire app — table loss is not practical.
.decl ets_application_owner(name: symbol, mod: symbol)

ets_application_owner(name, mod) :-
  ets_owner_process(name, mod, "Application").

// Table without heir protection in a behaviour process.
// If the owner crashes, the table vanishes.
// Suppressed for permanent supervisor children (table recreated on restart)
// and Application modules (live for the entire app lifetime).
// site is the :ets.new/2 instruction — the creation line.
.decl ets_unprotected_owner(name: symbol, mod: symbol, site: symbol)
.output ets_unprotected_owner

ets_unprotected_owner(name, mod, id) :-
  ets_owner_process(name, mod, _),
  ets_new(id, _, name),
  name != "dynamic",
  !ets_option(id, "heir", "true"),
  !ets_permanent_owner(name, mod),
  !ets_application_owner(name, mod).

// ── Concurrent access patterns ─────────────────────────────────────

// Module reading from a table.
.decl ets_reader_module(name: symbol, mod: symbol)

ets_reader_module(name, mod) :-
  ets_op(_, func, name, _, "read"),
  name != "dynamic",
  function_def(func, mod, _, _, _).

// Module writing to a table.
.decl ets_writer_module(name: symbol, mod: symbol)

ets_writer_module(name, mod) :-
  ets_op(_, func, name, _, "write"),
  name != "dynamic",
  function_def(func, mod, _, _, _).

// Cross-module reads without read_concurrency.
.decl ets_missing_read_concurrency(name: symbol)
.output ets_missing_read_concurrency

ets_missing_read_concurrency(name) :-
  ets_reader_module(name, m1),
  ets_reader_module(name, m2),
  name != "dynamic",
  m1 < m2,
  ets_new(id, _, name),
  !ets_option(id, "read_concurrency", "true").

// Cross-module writes without write_concurrency.
.decl ets_missing_write_concurrency(name: symbol)
.output ets_missing_write_concurrency

ets_missing_write_concurrency(name) :-
  ets_writer_module(name, m1),
  ets_writer_module(name, m2),
  name != "dynamic",
  m1 < m2,
  ets_new(id, _, name),
  !ets_option(id, "write_concurrency", "true"),
  !ets_option(id, "write_concurrency", "auto").

// Write contention on ordered_set (higher lock contention).
// site is the :ets.new/2 instruction that chose ordered_set.
.decl ets_ordered_set_contention(name: symbol, mod1: symbol, mod2: symbol, site: symbol)
.output ets_ordered_set_contention

ets_ordered_set_contention(name, mod1, mod2, id) :-
  ets_writer_module(name, mod1),
  ets_writer_module(name, mod2),
  name != "dynamic",
  mod1 < mod2,
  ets_new(id, _, name),
  ets_option(id, "type", "ordered_set").

// ── Stale reference risk ───────────────────────────────────────────

// Table created without named_table by a process —
// the reference becomes invalid if the owner restarts.
// site is the :ets.new/2 instruction — the creation line.
.decl ets_unnamed_in_process(name: symbol, mod: symbol, site: symbol)
.output ets_unnamed_in_process

ets_unnamed_in_process(name, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  function_def(func, mod, _, _, _),
  process_module(mod),
  !ets_option(id, "named_table", "true").

// ── Write-only tables ──────────────────────────────────────────────
//
// A named table that the code inserts into from outside init/1 and
// never deletes from is a table that only grows. Sentry's check-in ID
// mapping was one: every check-in inserted a row, nothing ever removed
// one, and the process held the table for the life of the VM. A table
// filled once in init/1 and read thereafter is a cache, not a leak, and
// is not reported.
//
// Any removal on a dynamic table reference in the owner's module is
// taken as possibly this table — the direction that stays quiet.
.decl ets_removal_op(op: symbol)

ets_removal_op("delete").
ets_removal_op("delete_object").
ets_removal_op("delete_all_objects").
ets_removal_op("select_delete").
ets_removal_op("match_delete").
ets_removal_op("take").

.decl ets_table_shrinks(name: symbol, owner: symbol)

ets_table_shrinks(name, owner) :-
  ets_new(_, func, name),
  function_def(func, owner, _, _, _),
  ets_op(_, _, name, op, _),
  ets_removal_op(op).

ets_table_shrinks(name, owner) :-
  ets_new(_, func, name),
  function_def(func, owner, _, _, _),
  ets_op(_, f, "dynamic", op, _),
  ets_removal_op(op),
  function_def(f, owner, _, _, _).

.decl ets_grows_outside_init(name: symbol)

ets_grows_outside_init(name) :-
  ets_op(_, f, name, op, "write"),
  (op = "insert" ; op = "insert_new"),
  function_def(f, _, fname, _, _),
  fname != "init".

.decl ets_write_only_table(name: symbol, mod: symbol, site: symbol)
.output ets_write_only_table

ets_write_only_table(name, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  ets_option(id, "named_table", "true"),
  function_def(func, mod, _, _, _),
  ets_grows_outside_init(name),
  !ets_table_shrinks(name, mod).

// ── Reads from outside the owner ─────────────────────────────────────
//
// A named table created by a process's own callbacks disappears with
// the process and comes back only when its restart reaches :ets.new
// again. Its module's API (`lookup/1`, run in the caller's process)
// reads the table in that window and raises ArgumentError in the caller
// instead of returning a value — Redix.Cluster callers saw exactly that
// during a :one_for_all restart (whatyouhide/redix#338). A heir keeps
// the table alive; a rescue in the reader (or in a wrapper the reader
// hands its closure to) turns the window into a result.
//
// The reader is "outside the owner" when the owner's callbacks do not
// reach it: what only the API reaches runs in callers.
// Backward from the table functions (creators and readers) to the
// callbacks that reach them, so the closure is bounded by functions x
// table functions rather than by every process's whole reach.
.init ets_reach = ClosureReach

ets_reach.seed(f, f) :- ets_new(_, f, _).
ets_reach.seed(f, f) :- ets_op(_, f, _, _, "read").
ets_reach.seed(f, f) :- named_read(_, f, _).

.decl owner_reaches(mod: symbol, func: symbol)

owner_reaches(mod, t) :- process_entry(mod, c), ets_reach.reaches(c, t).

// A rescue that would catch the ArgumentError a missing table raises:
// a bare rescue, a catch-all, or one naming ArgumentError. `rescue
// SomeOtherError` is not a guard.
.decl rescues(func: symbol)

rescues(f) :- catches_class(f, "error").
rescues(f) :- catch_tag(_, f, "error", "ArgumentError").

// The rescue may sit in the function that built the closure, at any
// depth, or in a function that one of those parents calls.
.decl guarded(func: symbol)

guarded(g) :- enclosing_function(g, a), rescues(a).
guarded(g) :- enclosing_function(g, a), closure_def(p, a), call_edge(p, t), rescues(t).

.decl ets_read_outside_owner(name: symbol, owner: symbol, reader: symbol, site: symbol, created: symbol)
.output ets_read_outside_owner

// A read through a helper that takes the table as a parameter
// (`defp fetch(table, key), do: :ets.lookup(table, key)`): the name is
// the literal a caller passes, possibly forwarded through more than one
// parameter. The caller passing the literal is the reader that matters —
// it is the API someone calls — and the site stays the lookup.
.decl table_param(func: symbol, pos: number, site: symbol)

table_param(reader, pos, site) :-
  ets_op(site, reader, "dynamic", _, "read"),
  ets_op_param(site, pos).

table_param(f, p, site) :-
  call_arg_forward(f, g, q, p),
  table_param(g, q, site).

.decl named_read(name: symbol, reader: symbol, site: symbol)

named_read(name, reader, site) :- ets_op(site, reader, name, _, "read"), name != "dynamic".

named_read(name, caller, site) :-
  call_arg(caller, g, q, name),
  table_param(g, q, site).

ets_read_outside_owner(name, owner, reader, site, id) :-
  ets_new(id, creator, name),
  name != "dynamic",
  function_def(creator, owner, _, _, _),
  owner_reaches(owner, creator),
  !ets_option(id, "heir", "true"),
  named_read(name, reader, site),
  !owner_reaches(owner, reader),
  !guarded(reader).

// A table under a name computed at runtime: only the owner's own API
// can be tied to it.
ets_read_outside_owner("dynamic", owner, reader, site, id) :-
  ets_new(id, creator, "dynamic"),
  function_def(creator, owner, _, _, _),
  owner_reaches(owner, creator),
  !ets_option(id, "heir", "true"),
  ets_op(site, reader, _, _, "read"),
  function_def(reader, owner, _, _, _),
  !owner_reaches(owner, reader),
  !guarded(reader).

// ── Read, then write ─────────────────────────────────────────────
//
// `case :ets.lookup(t, k) do [] -> :ets.insert(t, {k, v})` decides on a
// row that another process can write between the read and the write
// (Christakis and Sagonas, 2010, on ETS). The pair is a race when both
// touch the same key, the table is public — a protected table has one
// writer — and a second process can write it: the function where the
// pair meets runs in more than one process, or some function outside
// that process writes the table. insert_new, update_counter and
// select_replace are the atomic forms and the fix.
//
// The read and the write may sit in different functions
// (clientlib/check_then_act.dl), and the table may arrive as a
// parameter: by name, or as the reference :ets.new returned in some
// caller — the paper's own example builds an unnamed public table and
// hands it to a closure that spawned processes run.

.init rows = CheckThenAct

.decl ets_deciding_read(op: symbol)

ets_deciding_read("lookup").
ets_deciding_read("lookup_element").
ets_deciding_read("member").

.decl ets_plain_write(op: symbol)

ets_plain_write("insert").
ets_plain_write("delete").
ets_plain_write("delete_object").
ets_plain_write("update_element").

// The table in the operation's own function's terms.
.decl ets_table_ident(id: symbol, ts: symbol, t: symbol)

ets_table_ident(id, "literal", name) :- ets_op(id, _, name, _, _), name != "dynamic".
ets_table_ident(id, "param", to_string(p)) :- ets_op(id, _, "dynamic", _, _), ets_op_param(id, p).

rows.check(r, f, ts, t, ks, k) :-
  ets_op(r, f, _, op, "read"),
  ets_deciding_read(op),
  ets_table_ident(r, ts, t),
  ets_key(r, ks, k).

rows.act(w, f, ts, t, ks, k) :-
  ets_op(w, f, _, op, "write"),
  ets_plain_write(op),
  ets_table_ident(w, ts, t),
  ets_key(w, ks, k).

// The table a parameter holds where a pair meets on it: a name a caller
// passes there, or the reference :ets.new returned in a caller, through
// any forwarding. Asked only for the parameters a pair meets on.
.decl table_param_needed(func: symbol, pos: symbol)

table_param_needed(f, p) :- rows.meets(f, _, _, "param", p, _, _).
table_param_needed(f, p) :- records.meets(f, _, _, "param", p, _, _).

table_param_needed(c, to_string(m)) :-
  table_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n).

.decl table_at_param(func: symbol, pos: symbol, name: symbol)

table_at_param(f, p, name) :-
  table_param_needed(f, p),
  call_arg(_, f, n, name),
  name != "dynamic",
  p = to_string(n).

table_at_param(f, p, name) :-
  table_param_needed(f, p),
  ets_tid_arg(_, f, n, name),
  p = to_string(n).

table_at_param(f, p, name) :-
  table_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n),
  table_at_param(c, to_string(m), name).

.decl ets_pair(func: symbol, read: symbol, write: symbol, name: symbol, key: symbol)

ets_pair(f, r, w, name, k) :- rows.meets(f, r, w, "literal", name, _, k).
ets_pair(f, r, w, name, k) :- rows.meets(f, r, w, "param", p, _, k), table_at_param(f, p, name).

.init write_runs = RunsConcurrently

write_runs.seed(f) :- ets_pair(f, _, _, _, _).
write_runs.seed(f) :- ets_op(_, f, _, _, "write").

.decl ets_concurrent_write(name: symbol, func: symbol)

ets_concurrent_write(name, f) :-
  ets_pair(f, _, _, name, _),
  !write_runs.single_process(f).

ets_concurrent_write(name, f) :-
  ets_pair(f, _, _, name, _),
  write_runs.single_process(f),
  write_runs.entry_reaches(m, f),
  ets_op(_, g, name, _, "write"),
  !write_runs.entry_reaches(m, g).

// ── Races both racers win ────────────────────────────────────────
//
// A check-then-act pair is a lost update when the write carries what the
// read said — two racers each add one to the count they read, and one
// increment vanishes — or when a blind write lands on a row another
// writer accumulates into (Hammer's insert over a key update_counter
// bumps). Three shapes are neither, and are not reported, as long as
// nothing in the program writes the table back from a read or counts in
// it (`writes_back`):
//
// - a delete: deleting twice is deleting once (an invalidation, the
//   cleanup of a row the read found stale);
// - a refill: a write whose value a call, or a read of another store
//   (Mnesia behind an ETS cache), makes — the cache-aside `[] -> v =
//   load(k); :ets.insert(t, {k, v})` — where both racers compute the
//   same thing and either write is right;
// - a trip: a write of a value made of neither the read nor a call
//   (`{key, :blocked_until, t}`), where the decision stays in the
//   program: no caller branches on what the function returns, and no
//   exported function hands it out. A claim — `[] -> insert({k,
//   :in_flight}); :ok` — hands its decision to a caller that acts on it
//   alone, and is reported: both racers are told they won.
//
// "Made of" is data dependence alone (site_reads, call_arg_reads): a
// value computed under a test on the read, but not from it, does not
// carry it.

// The ETS data a write carries: a read at its own site, what a helper
// that returns a read hands it, or either through a parameter.
// Only a write of a value counts; a delete writes nothing back, and the
// key it names may well be the one the read's row held.
.decl value_write(w: symbol)

value_write(w) :- ets_op(w, _, _, op, "write"), (op = "insert" ; op = "update_element").

.decl carries_read(w: symbol)

carries_read(w) :-
  value_write(w),
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "site", r),
  ets_op(r, _, _, _, "read").

carries_read(w) :-
  value_write(w),
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  returns_depends(g, "site", _).

// A local helper's result is made of the arguments it returns from:
// `insert({k, next(n)})` writes the read's `n` back through `next/1`.
carries_read(w) :-
  value_write(w),
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  returns_depends(g, "param", q),
  call_arg_reads(h, g, n, "site", r),
  ets_op(r, _, _, _, "read"),
  q = to_string(n).

carries_read(w) :-
  value_write(w),
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, "site", r),
  ets_op(r, _, _, _, "read"),
  p = to_string(n).

carries_read(w) :-
  value_write(w),
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, "call", g),
  returns_depends(g, "site", _),
  p = to_string(n).

// The table a write or a counter bump touches, by name.
.decl ets_op_table(id: symbol, name: symbol)

ets_op_table(id, name) :- ets_op(id, _, name, _, _), name != "dynamic".

ets_op_table(id, name) :-
  ets_op(id, f, "dynamic", _, _),
  ets_op_param(id, p),
  table_at_param(f, to_string(p), name).

table_param_needed(f, to_string(p)) :-
  ets_op(id, f, "dynamic", op, "write"),
  ets_op_param(id, p),
  (op = "update_counter" ; ets_plain_write(op)).

.decl writes_back(name: symbol)

writes_back(name) :- ets_op(id, _, _, "update_counter", _), ets_op_table(id, name).
writes_back(name) :- carries_read(w), ets_op_table(w, name).

// A write made by a call, or by a read of some other store (Mnesia, the
// registry): the refill.
.decl refill_source(kind: symbol, src: symbol)

refill_source("call", g) :- site_reads(_, _, "call", g).
refill_source("call", g) :- call_arg_reads(_, _, _, "call", g).
refill_source("site", r) :- site_reads(_, _, "site", r), !ets_op(r, _, _, _, _).
refill_source("site", r) :- call_arg_reads(_, _, _, "site", r), !ets_op(r, _, _, _, _).

.decl recomputed(w: symbol)

recomputed(w) :-
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, kind, src),
  refill_source(kind, src).

recomputed(w) :-
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, kind, src),
  refill_source(kind, src),
  p = to_string(n).

// The decision a pair makes leaves the function: returned — by the
// function the pair meets in, or by a caller that returns that result on
// — to a caller that branches on it, or to callers the program does not
// show (an exported function). A spec that says the function returns a
// single value (`@spec record_failure(term, atom) :: :ok`) says the
// result carries no decision.
.decl decision_returned(func: symbol, check: symbol)

decision_returned(f, c) :-
  ets_pair(f, c, _, _, _),
  rows.carries(f, kind, src, c, _, _, _, _),
  returns_depends(f, kind, src).

decision_returned(g, c) :-
  decision_returned(f, c),
  rows.carries(g, "call", f, c, _, _, _, _),
  returns_depends(g, "call", f).

.decl decision_escapes(check: symbol)

decision_escapes(c) :-
  decision_returned(g, c),
  call_decided(_, _, "call", g).

decision_escapes(c) :-
  decision_returned(g, c),
  function_def(g, _, _, _, 1),
  !callee_returns(g, "constant").

.decl benign_pair(func: symbol, read: symbol, write: symbol)

benign_pair(f, r, w) :-
  ets_pair(f, r, w, name, _),
  ets_op(w, _, _, op, _),
  (op = "delete" ; op = "delete_object"),
  !writes_back(name).

benign_pair(f, r, w) :-
  ets_pair(f, r, w, name, _),
  !carries_read(w),
  recomputed(w),
  !writes_back(name).

benign_pair(f, r, w) :-
  ets_pair(f, r, w, name, _),
  !carries_read(w),
  !writes_back(name),
  !decision_escapes(r).

.decl ets_check_act(mod: symbol, func: symbol, name: symbol, key: symbol, read: symbol, write: symbol)
.output ets_check_act

ets_check_act(mod, func, name, key, read, write) :-
  ets_pair(func, read, write, name, key),
  ets_new(id, _, name),
  ets_option(id, "access", "public"),
  function_def(func, mod, _, _, _),
  ets_concurrent_write(name, func),
  !benign_pair(func, read, write).

// ── Dirty read, then dirty write ─────────────────────────────────
//
// Mnesia serializes what runs inside a transaction; its dirty operations
// bypass that, and a dirty_read whose result decides or feeds a
// dirty_write of the same record is the read-modify-write another process
// can interleave. The paper's instance is the snmp agent's time-stamp
// counter: read, add one, write back. A Mnesia table is shared by every
// process on every node, so no access mode excuses it; one process that
// is the table's only writer does. :mnesia.transaction/1 and
// dirty_update_counter are the fixes.

.init records = CheckThenAct

records.check(r, f, ts, t, ks, k) :- mnesia_op(r, f, _, "read", ts, t, ks, k).
records.act(w, f, ts, t, ks, k) :- mnesia_op(w, f, _, "write", ts, t, ks, k).

.decl mnesia_pair(func: symbol, read: symbol, write: symbol, table: symbol, key: symbol)

mnesia_pair(f, r, w, t, k) :- records.meets(f, r, w, "literal", t, _, k).
mnesia_pair(f, r, w, t, k) :- records.meets(f, r, w, "param", p, _, k), table_at_param(f, p, t).

.init record_runs = RunsConcurrently

record_runs.seed(f) :- mnesia_pair(f, _, _, _, _).
record_runs.seed(f) :- mnesia_op(_, f, _, "write", _, _, _, _).

.decl mnesia_concurrent_write(table: symbol, func: symbol)

mnesia_concurrent_write(t, f) :-
  mnesia_pair(f, _, _, t, _),
  !record_runs.single_process(f).

mnesia_concurrent_write(t, f) :-
  mnesia_pair(f, _, _, t, _),
  record_runs.single_process(f),
  record_runs.entry_reaches(m, f),
  mnesia_op(_, g, _, "write", "literal", t, _, _),
  !record_runs.entry_reaches(m, g).

.decl mnesia_check_act(mod: symbol, func: symbol, table: symbol, key: symbol, read: symbol, write: symbol, op: symbol)
.output mnesia_check_act

// A dirty_delete of the record the read found (the cleanup of an
// expired nonce) is not a lost update unless the program also writes the
// table back from a read: deleting twice is deleting once. dirty_update_counter
// is not extracted, so a table only it counts into is not known to
// accumulate.
.decl record_carries_read(w: symbol)

record_carries_read(w) :-
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "site", _).

record_carries_read(w) :-
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  returns_depends(g, "site", _).

record_carries_read(w) :-
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  returns_depends(g, "param", q),
  call_arg_reads(h, g, n, "site", _),
  q = to_string(n).

record_carries_read(w) :-
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, "site", _),
  p = to_string(n).

record_carries_read(w) :-
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, "call", g),
  returns_depends(g, "site", _),
  p = to_string(n).

.decl record_writes_back(table: symbol)

record_writes_back(t) :-
  record_carries_read(w),
  mnesia_op(w, _, _, "write", "literal", t, _, _).

record_writes_back(t) :-
  record_carries_read(w),
  mnesia_op(w, f, _, "write", "param", p, _, _),
  table_at_param(f, p, t).

table_param_needed(f, p) :- mnesia_op(_, f, _, "write", "param", p, _, _).

mnesia_check_act(mod, func, table, key, read, write, op) :-
  mnesia_pair(func, read, write, table, key),
  function_def(func, mod, _, _, _),
  mnesia_concurrent_write(table, func),
  mnesia_op(write, _, op, _, _, _, _, _),
  !deletes_unaccumulated(write, table).

.decl deletes_unaccumulated(write: symbol, table: symbol)

deletes_unaccumulated(w, t) :-
  mnesia_pair(_, _, w, t, _),
  mnesia_op(w, _, op, _, _, _, _, _),
  (op = "dirty_delete" ; op = "dirty_delete_object"),
  !record_writes_back(t).
