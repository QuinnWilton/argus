// ETS ownership, lifetime, and concurrency checks: missing heirs, restart-window reads,
// concurrency options, ordered_set contention, growing tables, and stale unnamed-table
// references. Key-level read/write races belong to races.dl.
// Use `ets_table` from clientlib/tables.dl for identity: names for named tables,
// allocation sites for unnamed tables. Unresolved operations join no table unless a
// rule explicitly treats them as possibly touching an owner's table. Findings label
// creation sites by their supplied name; computed names are handled only where
// specified.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/tables.dl"
.include "../clientlib/tooling.dl"
.include "../clientlib/escape.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ── Ownership & lifecycle ──────────────────────────────────────────

// Table ownership
//
// The process executing :ets.new/2 owns the table. Roots identify server processes,
// separately spawned processes, application processes, and framework-run behaviour
// callbacks. SameProcessReach follows each root's stack across modules; client APIs run
// in the caller's process.
// Named tables created by helpers count as shared state. Unnamed tables returned by
// another module or a behaviour are treated as caller-owned data. Assumption: returned
// references are not also stored elsewhere.
// `may_hold_table` requires creation on some path and supports lifetime findings.
// failure.dl requires creation on every init path and exclusive owner execution to
// prove operations safe. races.dl separately checks ownership of rows by freshly minted
// keys.
// Traverse backward from creators and readers so reachability is limited to relevant
// table functions.
.init ets_reach = SameProcessReach

ets_reach.seed(f, f) :- ets_new(_, f, _).
ets_reach.seed(f, f) :- ets_op(_, f, _, _, "read").
ets_reach.seed(f, f) :- table_read(_, f, _, _).
// A function that spawns a linked process: which process runs it says
// what the spawn ends with (linked_by, below).
ets_reach.seed(f, f) :- spawn_call(_, f, _, _, _, "spawn_link", _, _, _, _).
// An export of a module that makes a table: which process runs it says
// whether its callers are in view (called_from_outside, below).
ets_reach.seed(e, e) :-
  api_export(e),
  function_def(e, m, _, _, _),
  ets_new(_, c, _),
  function_def(c, m, _, _, _).

.decl process_root(root: symbol, proc: symbol, mod: symbol, kind: symbol)

process_root(c, cat("server ", m), m, "server") :- process_entry(m, c).

process_root(g, cat("server ", m), m, "server") :- own_start(g, m).

// Special-process sys callbacks run in the process handling sys:handle_system_msg/6,
// including callbacks that resume its loop.
process_root(c, cat("server ", m), m, "server") :-
  own_start(_, m),
  function_def(c, m, n, a, _),
  sys_callback(n, a).

.decl sys_callback(name: symbol, arity: number)

sys_callback("system_continue", 3).
sys_callback("system_terminate", 4).
sys_callback("system_code_change", 4).
sys_callback("system_get_state", 1).
sys_callback("system_replace_state", 2).

process_root(g, cat("spawn ", g), m, "spawn") :-
  process_start(_, _, _, kind, g),
  kind != "server",
  function_def(g, m, _, _, _),
  !own_start(g, m).

process_root(g, cat("spawn ", g), m, "spawn") :-
  fun_handed_to(_, g, h),
  fun_sink(h, "start"),
  function_def(g, m, _, _, _),
  !own_start(g, m).

process_root(c, cat("app ", m), m, "app") :-
  behaves_as(m, "Application"),
  function_def(c, m, "start", 2, _).

process_root(f, cat("behaviour ", m), m, "behaviour") :-
  behaves_as(m, b),
  b != "Application",
  !process_behaviour_module(m),
  function_def(f, m, _, _, _),
  !known_reaches(f).

// A module's start function creates its own process and returns its pid, or starts no
// separate server. Excludes sidecar keepers. Includes a supervisor_bridge subsystem
// started on the module's own code, linked and stopped by the bridge.
.decl own_start(root: symbol, mod: symbol)

own_start(g, m) :-
  process_start(id, s, _, kind, g),
  kind != "server",
  start_function(s, m),
  function_def(g, m, _, _, _),
  pid_return(s, "obj", id).

own_start(g, m) :-
  process_start(_, s, p, kind, g),
  kind != "server",
  start_function(s, m),
  function_def(g, m, _, _, _),
  pid_return(s, "proc", p).

own_start(g, m) :-
  process_start(_, s, _, kind, g),
  kind != "server",
  start_function(s, m),
  function_def(g, m, _, _, _),
  !process_start(_, s, _, "server", _).

own_start(g, m) :-
  process_start(_, s, _, kind, g),
  kind != "server",
  behaves_as(m, ":supervisor_bridge"),
  function_def(s, m, "init", 1, _),
  function_def(g, m, _, _, _).

.decl start_function(func: symbol, mod: symbol)

start_function(s, m) :-
  function_def(s, m, n, _, _),
  (n = "start" ; n = "start_link" ; n = "start_monitor").

// A function a server, a spawned process or an application runs.
.decl known_root(root: symbol)

known_root(c) :- process_entry(_, c).
known_root(g) :- process_start(_, _, _, kind, g), kind != "server".
known_root(g) :- fun_handed_to(_, g, h), fun_sink(h, "start").
known_root(c) :- behaves_as(m, "Application"), function_def(c, m, "start", 2, _).

.decl known_reaches(func: symbol)

known_reaches(t) :- known_root(c), ets_reach.reaches(c, t).

// The process `proc` (of module `mod`) runs `func` on its own stack.
.decl owner_reaches(proc: symbol, mod: symbol, func: symbol)

owner_reaches(p, m, t) :- process_root(c, p, m, _), ets_reach.reaches(c, t).

// Process proc may own the table allocated at site: some path on its stack creates it.
// failure.dl's always_holds_table requires every path.
.decl may_hold_table(name: symbol, proc: symbol, mod: symbol, site: symbol)

may_hold_table(name, p, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  owner_reaches(p, mod, func),
  function_def(func, mod, _, _, _),
  !handed_back(id, p).

// A named table belongs to the process executing :ets.new/2, including creation in
// helpers. handed_back applies only to unnamed tables.
may_hold_table(name, p, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  owner_reaches(p, mod, func),
  ets_option(id, "named_table", "true").

// An unnamed table returned by a behaviour module, directly or nested in a returned
// term. pid_return and pid_field track it as caller-owned data.
.decl handed_back(site: symbol, proc: symbol)

handed_back(id, p) :-
  process_root(_, p, _, "behaviour"),
  ets_new(id, f, _),
  !ets_option(id, "named_table", "true"),
  table_alloc(id, f, t),
  returns_table(f, t).

.decl returns_table(func: symbol, table: symbol)

returns_table(f, t) :- pid_return(f, "table", t).
returns_table(f, t) :- returned_term(f, o), pid_field(f, o, _, "table", t).

.decl returned_term(func: symbol, obj: symbol)

returned_term(f, o) :- pid_return(f, "obj", o).
returned_term(f, o) :- returned_term(f, p), pid_field(f, p, _, "obj", o).

// ── A table that dies with its owner ──

// A readable table dies with an owner lacking an heir, permanent restart, or
// application lifetime. `create` anchors the finding at :ets.new/2.
.decl table_dies_with_owner(table: symbol, owner: symbol, owner_mod: symbol, create: symbol)

table_dies_with_owner(table, owner, owner_mod, create) :-
  may_hold_table(table, owner, owner_mod, create),
  !has_heir(create),
  !private_table(create),
  !restarted_by_supervisor(owner),
  !lives_with_application(owner).

// A private table is inaccessible to other processes. Its contents die with its owner,
// so no external reader can observe its disappearance.
.decl private_table(create: symbol) inline

private_table(create) :- ets_option(create, "access", "private").

// A module-owned server, application, or behaviour process. Excludes separately spawned
// keepers, whose lifetime is independent of the module's supervision. A start function
// spawning its own implementation is a server root.
.decl module_process(owner: symbol, mod: symbol)

module_process(p, mod) :- process_root(_, p, mod, kind), kind != "spawn".

// The owner's module is a permanent static, dynamic, or added child whose restart
// recreates the table. Transient, temporary, and unresolved policies do not establish
// recovery.
.decl restarted_by_supervisor(owner: symbol)

restarted_by_supervisor(p) :-
  module_process(p, mod),
  restart_policy(_, mod, "permanent").

// An application process or root supervisor owns the table for the application's
// lifetime, so it is not lost while that application continues.
.decl lives_with_application(owner: symbol)

lives_with_application(p) :- module_process(p, mod), behaves_as(mod, "Application").
lives_with_application(p) :- module_process(p, mod), application_root(mod).

.decl ets_unprotected_owner(name: symbol, mod: symbol, site: symbol)
.output ets_unprotected_owner

ets_unprotected_owner(name, mod, site) :- table_dies_with_owner(name, _, mod, site).

// ── Concurrent access patterns ─────────────────────────────────────

// Two modules read a table made without :read_concurrency, whose readers
// then take the table's lock in turn.
.decl reads_without_read_concurrency(table: symbol, create: symbol)

reads_without_read_concurrency(table, create) :-
  read_by_two_modules(create, _, _),
  makes_table(create, table),
  !made_for_concurrent_reads(create).

// Two modules write a table made without :write_concurrency, whose
// writers then take the table's lock in turn.
.decl writes_without_write_concurrency(table: symbol, create: symbol)

writes_without_write_concurrency(table, create) :-
  written_by_two_modules(create, _, _),
  makes_table(create, table),
  !made_for_concurrent_writes(create).

// Two modules write a table made as an ordered_set, whose writers contend
// more than a hash table's do.
.decl ordered_set_written_by_two_modules(table: symbol, first: symbol, second: symbol, create: symbol)

ordered_set_written_by_two_modules(table, first, second, create) :-
  written_by_two_modules(create, first, second),
  makes_table(create, table),
  ordered_set(create).

// Two modules, `first` before `second`, read the table made at `create`
// (each pair once).
.decl read_by_two_modules(create: symbol, first: symbol, second: symbol)

read_by_two_modules(create, m1, m2) :-
  reads_in_module(create, m1),
  reads_in_module(create, m2),
  m1 < m2.

// Two modules, `first` before `second`, write the table made at `create`
// (each pair once).
.decl written_by_two_modules(create: symbol, first: symbol, second: symbol)

written_by_two_modules(create, m1, m2) :-
  writes_in_module(create, m1),
  writes_in_module(create, m2),
  m1 < m2.

// Code of `mod` reads the table made at `create`.
.decl reads_in_module(create: symbol, mod: symbol)

reads_in_module(create, mod) :-
  ets_op(id, func, _, _, "read"),
  touches_made_table(id, create),
  function_def(func, mod, _, _, _).

// Code of `mod` writes the table made at `create`.
.decl writes_in_module(create: symbol, mod: symbol)

writes_in_module(create, mod) :-
  ets_op(id, func, _, _, "write"),
  touches_made_table(id, create),
  function_def(func, mod, _, _, _).

// The operation at `id` may touch the table the :ets.new/2 at `create`
// makes (clientlib/tables.dl: the same table, by kind and identity).
.decl touches_made_table(id: symbol, create: symbol)

touches_made_table(id, create) :-
  ets_op(id, _, _, _, _),
  ets_table(id, k, t),
  table_made_at(k, t, create).

// Use the literal name from :ets.new/2 for display. "dynamic" denotes a computed,
// unknown name.
.decl makes_table(create: symbol, table: symbol)

makes_table(create, table) :- ets_new(create, _, table), table != "dynamic".

.decl made_for_concurrent_reads(create: symbol) inline

made_for_concurrent_reads(create) :- ets_option(create, "read_concurrency", "true").

// :write_concurrency true, or :auto.
.decl made_for_concurrent_writes(create: symbol)

made_for_concurrent_writes(create) :- ets_option(create, "write_concurrency", "true").
made_for_concurrent_writes(create) :- ets_option(create, "write_concurrency", "auto").

.decl ordered_set(create: symbol) inline

ordered_set(create) :- ets_option(create, "type", "ordered_set").

// The module that makes the table at `create`.
.decl made_in(create: symbol, mod: symbol) inline

made_in(create, mod) :- ets_new(create, func, _), function_def(func, mod, _, _, _).

.decl ets_missing_read_concurrency(name: symbol, mod: symbol, site: symbol)
.output ets_missing_read_concurrency

ets_missing_read_concurrency(name, mod, site) :-
  reads_without_read_concurrency(name, site),
  made_in(site, mod).

.decl ets_missing_write_concurrency(name: symbol, mod: symbol, site: symbol)
.output ets_missing_write_concurrency

ets_missing_write_concurrency(name, mod, site) :-
  writes_without_write_concurrency(name, site),
  made_in(site, mod).

// site is the :ets.new/2 instruction that chose ordered_set.
.decl ets_ordered_set_contention(name: symbol, mod1: symbol, mod2: symbol, site: symbol)
.output ets_ordered_set_contention

ets_ordered_set_contention(name, mod1, mod2, site) :-
  ordered_set_written_by_two_modules(name, mod1, mod2, site).

// ── Stale reference risk ───────────────────────────────────────────

// A server creates an unnamed table. Restarting creates a new table, leaving retained
// references stale. `create` anchors the finding at :ets.new/2.
.decl unnamed_table_in_server(table: symbol, owner_mod: symbol, create: symbol)

unnamed_table_in_server(table, owner_mod, create) :-
  may_hold_table(table, owner, owner_mod, create),
  runs_as_server(owner),
  !named_site(create).

// `owner` is a process module's own process (process_root's "server").
.decl runs_as_server(owner: symbol)

runs_as_server(p) :- process_root(_, p, mod, "server"), process_module(mod).

.decl ets_unnamed_in_process(name: symbol, mod: symbol, site: symbol)
.output ets_unnamed_in_process

ets_unnamed_in_process(name, mod, site) :- unnamed_table_in_server(name, mod, site).

// Tables that only grow
//
// A named table receives inserts outside init and has no known removal. Init-only
// population is excluded. An unresolved removal in the owner's module is treated as
// possibly removing this table and suppresses the finding.

// A named table gains rows outside init/1, and nothing ever removes one.
.decl table_only_grows(table: symbol, create: symbol)

table_only_grows(table, create) :-
  makes_table(create, table),
  named_site(create),
  grows_outside_init(create),
  !loses_rows(create).

// An insert outside initialization adds a row without overwriting its key. Treat
// functions named init, at any arity, as initialization.
.decl grows_outside_init(create: symbol)

grows_outside_init(create) :-
  ets_op(id, f, _, op, "write"),
  (op = "insert" ; op = "insert_new"),
  touches_made_table(id, create),
  function_def(f, _, fname, _, _),
  fname != "init",
  !overwrites_row(id).

// Possible row removal: an operation on this table, or an unresolved table operation in
// the creating module. Either suppresses growth warnings.
.decl loses_rows(create: symbol)

loses_rows(create) :-
  ets_op(id, _, _, op, _),
  ets_removal_op(op),
  touches_made_table(id, create).

loses_rows(create) :-
  made_in(create, mod),
  ets_op(id, f, _, op, _),
  ets_removal_op(op),
  may_touch_any_table(id),
  function_def(f, mod, _, _, _).

// A literal-key insert overwrites a single row when the table is a set with default key
// position. Bags and custom key positions do not establish this bound.
.decl overwrites_row(id: symbol)

overwrites_row(id) :-
  ets_key(id, "literal", _),
  touches_made_table(id, t),
  !bag_table(t),
  !keyed_elsewhere(t).

// A keypos other than 1 keys the table on another element than the one
// ets_key read; vernemq's cluster-state table spells the default out.
.decl keyed_elsewhere(table: symbol)

keyed_elsewhere(t) :- ets_option(t, "keypos", p), p != "1".

.decl bag_table(table: symbol)

bag_table(t) :- ets_option(t, "type", "bag").
bag_table(t) :- ets_option(t, "type", "duplicate_bag").

.decl ets_write_only_table(name: symbol, mod: symbol, site: symbol)
.output ets_write_only_table

ets_write_only_table(name, mod, site) :-
  table_only_grows(name, site),
  made_in(site, mod).

// Reads outside the owner
//
// A reader that outlives a table's owner may access it between owner exit and
// recreation, raising ArgumentError. Heirs preserve the table; covering rescues handle
// the missing-table error.
// Exclude the owner, processes ended with it by supervision, and owners whose lifetime
// is the application's. Readers outside visible process roots may outlive the owner.
// See docs/analyses/ets.md#reads-during-an-owners-restart.

// A reader outlives the table's owner. After the owner exits, reads raise ArgumentError
// until restart recreates the table.
.decl read_while_owner_restarts(reader: symbol, read: symbol, create: symbol, owner: symbol, owner_mod: symbol)

read_while_owner_restarts(reader, read, create, owner, owner_mod) :-
  reads_held_table(read, reader, create, owner, owner_mod),
  !has_heir(create),
  reader_outlives(reader, owner, owner_mod),
  !handles_missing_table(read, reader).

// A read of a table held by owner, matched by allocation identity or by the
// computed-name fallback for unresolved reads in the owner's module.
.decl reads_held_table(read: symbol, reader: symbol, create: symbol, owner: symbol, owner_mod: symbol)

// Use may_hold_table to identify the owning process, including named tables allocated
// by helpers called on its stack.
reads_held_table(read, reader, create, owner, owner_mod) :-
  may_hold_table(_, owner, owner_mod, create),
  reads_made_table(read, reader, create).

// For computed-name tables, check only the owner's API: the reader must outlive the
// owner and the missing-table error must escape.
reads_held_table(read, reader, create, owner, owner_mod) :-
  computed_read(owner, owner_mod, reader, read, create).

// The read handles a missing table through rescue or a presence guard. Computed table
// names receive no extracted presence guard.
.decl handles_missing_table(read: symbol, reader: symbol)

handles_missing_table(read, reader) :- read_rescued(read, reader).

handles_missing_table(read, reader) :- read_when_present(read), table_read(read, reader, _, _).

.decl ets_read_outside_owner(name: symbol, owner: symbol, reader: symbol, site: symbol, created: symbol)
.output ets_read_outside_owner

ets_read_outside_owner(name, owner_mod, reader, read, create) :-
  read_while_owner_restarts(reader, read, create, _, owner_mod),
  read_names(read, reader, create, name).

// Display the name used by the read, falling back to the creation name or "dynamic"
// when computed.
.decl read_names(read: symbol, reader: symbol, create: symbol, name: symbol)

read_names(read, reader, create, name) :-
  read_while_owner_restarts(reader, read, create, _, _),
  table_read(read, reader, "named", name),
  table_made_at("named", name, create).

read_names(read, reader, create, name) :-
  read_while_owner_restarts(reader, read, create, _, _),
  !reads_named_table(read, reader, create),
  ets_new(create, _, name).

.decl reads_named_table(read: symbol, reader: symbol, create: symbol)

reads_named_table(read, reader, create) :-
  table_read(read, reader, "named", name),
  table_made_at("named", name, create).

// Reads that raise when a table is missing. Exclude :ets.info/1,2, which return
// :undefined; see ets_answers_missing_table. races.dl separately handles missing rows.
.decl raises_if_table_missing(site: symbol)

raises_if_table_missing(site) :- ets_op(site, _, _, op, "read"), !ets_answers_missing_table(op).

// The missing-table ArgumentError is caught at the read, along every path through
// helpers, or at every call to the reader (`Escape`). Closures require coverage of
// every call receiving them. Unrelated rescues do not qualify.
.decl read_rescued(site: symbol, func: symbol)

read_rescued(site, reader) :- table_miss.rescued(site, reader, "badarg").

.init table_miss = Escape

table_miss.asked(site, g, reader, "badarg") :- table_read(site, reader, _, _), ets_op(site, g, _, _, _).
table_miss.asked(site, reader, reader, "badarg") :- computed_read(_, _, reader, site, _).
table_miss.asked(create, f, start, "badarg") :- makes_on_its_stack(start, create), ets_new(create, f, _).

// Every path to the read confirms table presence or creates the table
// (`ets_read_when_present`). A lookup in another clause or unchecked result does not
// qualify. This leaves a check/read race window; reader-created tables still receive
// ownership checks.
.decl read_when_present(site: symbol)

read_when_present(site) :- ets_read_when_present(site, _).

// A read that raises if its identified table disappears. Attribute parameter-based
// reads to the caller supplying a literal name, while retaining the actual read site.
.decl table_read(site: symbol, reader: symbol, kind: symbol, ident: symbol)

table_read(site, reader, k, t) :-
  ets_op(site, reader, _, _, "read"),
  raises_if_table_missing(site),
  !ets_op_param(site, _),
  ets_table(site, k, t).

// A table read in a helper whose table parameter receives a literal name, possibly
// through forwarding. The caller supplying the name is the reader; the lookup remains
// the site. Literal names resolve only to named tables.
table_read(site, caller, "named", name) :-
  call_arg(caller, g, q, name),
  name != "dynamic",
  table_param(g, q, site).

.decl table_param(func: symbol, pos: number, site: symbol)

table_param(reader, pos, site) :-
  ets_op(site, reader, "dynamic", _, "read"),
  raises_if_table_missing(site),
  ets_op_param(site, pos).

table_param(f, p, site) :-
  call_arg_forward(f, g, q, p),
  table_param(g, q, site).

// `reader` reads, at `read`, the table the :ets.new/2 at `create` makes.
.decl reads_made_table(read: symbol, reader: symbol, create: symbol)

reads_made_table(read, reader, create) :-
  table_read(read, reader, k, t),
  table_made_at(k, t, create).

// A reader process can continue after owner process `p` exits. Excludes the owner,
// processes ended with it, and application-lifetime owners. External entry points still
// count even when an internal process also reaches the reader; unassigned readers are
// treated as external.
.decl reader_outlives(reader: symbol, proc: symbol, owner: symbol)

reader_outlives(reader, p, owner) :-
  read_owner(p, owner, reader),
  !application_lifetime(p),
  owner_reaches(q, qm, reader),
  q != p,
  !ended_with(p, owner, q, qm).

reader_outlives(reader, p, owner) :-
  read_owner(p, owner, reader),
  !application_lifetime(p),
  called_from_outside(reader).

reader_outlives(reader, p, owner) :-
  read_owner(p, owner, reader),
  !application_lifetime(p),
  !runs_somewhere(reader).

.decl read_owner(proc: symbol, owner: symbol, reader: symbol)

read_owner(p, owner, reader) :- may_hold_table(_, p, owner, create), reads_made_table(_, reader, create).
read_owner(p, owner, reader) :- computed_read(p, owner, reader, _, _).

.decl runs_somewhere(func: symbol)

runs_somewhere(f) :- read_owner(_, _, f), owner_reaches(_, _, f).

// A reader reachable on an external caller's stack from a library-facing export, or an
// unused client API of the owner's module. Process-root functions are excluded. Such
// callers may not appear among the analyzed process roots.
.decl called_from_outside(func: symbol)

called_from_outside(f) :-
  read_owner(_, _, f),
  library_face(e),
  !process_root(e, _, _, _),
  ets_reach.reaches(e, f).

called_from_outside(f) :-
  read_owner(_, owner, f),
  api_export(e),
  function_def(e, owner, _, _, _),
  !process_root(e, _, _, _),
  ets_reach.reaches(e, f),
  !owner_reaches(_, _, e).

// The reader ends with the owner through supervision or a spawn_link chain. Assumption:
// linked spawned processes do not trap exits; treating them as ending suppresses
// findings.
.decl ended_with(proc: symbol, owner: symbol, q: symbol, qm: symbol)

ended_with(p, owner, q, qm) :-
  read_owner(p, owner, reader),
  process_root(_, p, owner, "server"),
  owner_reaches(q, qm, reader),
  process_root(_, q, qm, "server"),
  ends_with(owner, qm).

ended_with(p, owner, q, qm) :-
  read_owner(p, owner, reader),
  owner_reaches(q, qm, reader),
  linked_by(q, r),
  ends_by(p, owner, r).

// The process `q` (process_root's "spawn <function it runs>") is
// spawned linked by a function the process `r` runs.
.decl linked_by(q: symbol, starter: symbol)

linked_by(cat("spawn ", g), r) :-
  process_start(id, s, _, "spawn", g),
  spawn_call(id, s, _, _, _, "spawn_link", _, _, _, _),
  owner_reaches(r, _, s).

// `r` is the owner's process p, or a process that ends with it.
.decl ends_by(proc: symbol, owner: symbol, r: symbol)

ends_by(p, owner, p) :- read_owner(p, owner, _).

ends_by(p, owner, r) :-
  read_owner(p, owner, _),
  process_root(_, p, owner, "server"),
  process_root(_, r, rm, "server"),
  ends_with(owner, rm).

// An application process or its uniquely started root supervisor. Its exit ends the
// application, so there is no in-application restart window. Workers, shared
// supervisors, sidecar keepers, and child-owned tables have separate lifetimes.
.decl application_lifetime(proc: symbol)

application_lifetime(p) :- process_root(_, p, _, "app").
application_lifetime(p) :- process_root(_, p, m, "server"), application_root(m).

// Tables with computed names
//
// Use known allocation/read links where available. Otherwise, an unresolved read in the
// owner's module may refer to its computed-name table. Reads known to target another
// visible allocation are excluded.
.decl computed_read(proc: symbol, owner: symbol, reader: symbol, site: symbol, id: symbol)

computed_read(p, owner, reader, site, id) :-
  computed_name_held(p, owner, id),
  reads_made_table(site, reader, id).

computed_read(p, owner, reader, site, id) :-
  computed_name_held(p, owner, id),
  ets_op(site, reader, "dynamic", _, "read"),
  raises_if_table_missing(site),
  !reads_table_made_in_view(site),
  function_def(reader, owner, _, _, _).

// A visible allocation identifies the accessed table, avoiding fallback to an unknown
// runtime name.
.decl reads_table_made_in_view(site: symbol)

reads_table_made_in_view(site) :-
  ets_op(site, _, "dynamic", _, "read"),
  ets_table(site, k, t),
  table_made_at(k, t, _).

// The owner's server makes the table at `id` under a computed name, and
// no heir takes it over.
.decl computed_name_held(proc: symbol, owner: symbol, id: symbol)

computed_name_held(p, owner, id) :-
  ets_new(id, creator, "dynamic"),
  function_def(creator, owner, _, _, _),
  process_root(_, p, owner, "server"),
  owner_reaches(p, owner, creator),
  !has_heir(id).

// Named tables created by start functions
//
// start_link runs in the starter's process, often the supervisor. A named table created
// there can survive the server and collide with its next start. Follow only the start
// function's own stack; exclude tables also created by the server's callbacks.
// Suppress when creation requires an absent name, ArgumentError is caught, the table
// may be given away, the table is unnamed, or the child is temporary. Library starts
// still count when their supervisors are outside the analyzed program.

// A start function creates a named table in its caller's process. The table survives
// the server, so restarting fails when :ets.new/2 reuses its name.
.decl table_made_in_start(mod: symbol, start: symbol, create: symbol)

table_made_in_start(mod, start, create) :-
  starts_server(start, mod),
  makes_on_its_stack(start, create),
  named_site(create),
  !made_by_server(create, mod),
  !made_only_when_free(create, start),
  !given_away(create, start),
  !rescued_when_taken(create, start).

.decl starts_server_api(mod: symbol, func: symbol)

starts_server_api("GenServer", "start_link").
starts_server_api("GenServer", "start").
starts_server_api(":gen_server", "start_link").
starts_server_api(":gen_server", "start").
starts_server_api(":gen_statem", "start_link").
starts_server_api(":gen_statem", "start").
starts_server_api("GenStateMachine", "start_link").
starts_server_api("GenStage", "start_link").
starts_server_api("Agent", "start_link").
starts_server_api("Supervisor", "start_link").
starts_server_api(":supervisor", "start_link").

// `start` is mod's `start_link`, and starts a server itself (a call to
// one of the APIs above).
.decl starts_server(start: symbol, mod: symbol)

starts_server(s, m) :-
  function_def(s, m, "start_link", _, 1),
  process_behaviour_module(m),
  remote_call(_, s, api, op, _),
  starts_server_api(api, op),
  !child_spec_restart(m, "temporary").

.init start_side = SameProcessReach

start_side.seed(f, f) :- ets_new(n, f, _), ets_option(n, "named_table", "true").

// The :ets.new/2 at `create` runs on start's own stack: in the start
// function, or a function it calls in the same process.
.decl makes_on_its_stack(start: symbol, create: symbol)

makes_on_its_stack(start, create) :-
  starts_server(start, _),
  start_side.reaches(start, f),
  ets_new(create, f, _).

// The module's own process makes it: init/1 or a callback reaches it.
.decl made_by_server(site: symbol, mod: symbol)

made_by_server(n, m) :-
  ets_new(n, f, _),
  process_entry(m, c),
  start_side.reaches(c, f).

// Creation is guarded by :ets.whereis/1 or :ets.info/1,2 returning :undefined, in
// either the creator or start function.
.decl made_only_when_free(create: symbol, start: symbol)

made_only_when_free(create, start) :-
  makes_on_its_stack(start, create),
  ets_new(create, f, name),
  ets_made_when_absent(f, name, _).

made_only_when_free(create, start) :-
  makes_on_its_stack(start, create),
  ets_new(create, _, name),
  ets_made_when_absent(start, name, _).

// The creator or start function gives this table, or a possible alias, away. Its owner
// is then no longer the caller.
.decl given_away(create: symbol, start: symbol)

given_away(create, start) :-
  makes_on_its_stack(start, create),
  ets_new(create, f, _),
  (gives_table_away(f, create) ; gives_some_table_away(f)).

given_away(create, start) :-
  makes_on_its_stack(start, create),
  (gives_table_away(start, create) ; gives_some_table_away(start)).

// `func` gives away the table made at `create`.
.decl gives_table_away(func: symbol, create: symbol)

gives_table_away(f, create) :- ets_op(id, f, _, "give_away", _), touches_made_table(id, create).

// `func` gives away a table no view names: it may be any.
.decl gives_some_table_away(func: symbol)

gives_some_table_away(f) :- ets_op(id, f, _, "give_away", _), may_touch_any_table(id).

// The start function cannot leak the table-name collision ArgumentError because every
// path to creation, or every caller of the start, has a matching handler (`Escape`).
.decl rescued_when_taken(create: symbol, start: symbol)

rescued_when_taken(create, start) :- table_miss.rescued(create, start, "badarg").

.decl ets_created_in_start(name: symbol, mod: symbol, site: symbol, start: symbol)
.output ets_created_in_start

ets_created_in_start(name, mod, site, start) :-
  table_made_in_start(mod, start, site),
  ets_new(site, _, name).
