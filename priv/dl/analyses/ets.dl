// ETS table ownership, concurrency, and lifecycle analysis.
//
// Detects common ETS anti-patterns:
// - Tables owned by processes without heir protection.
// - Reads from callers' processes while the owner may be restarting.
// - Cross-module access without concurrency settings.
// - Write contention on ordered_set tables.
// - Tables that only grow.
// - Unnamed tables in processes (stale reference risk).
//
// The read-then-write race on a key is races.dl's.
//
// Which table an operation touches is clientlib/tables.dl's ets_table,
// the identity races.dl compares too: a named table by its name, an
// unnamed one by its :ets.new/2 site (followed through returns, fields
// and a server's state by points-to), so two unnamed tables made under
// one atom are two tables. An operation no view names a table for
// (may_touch_any_table) joins no table, except where a rule says it is
// taken to be any of its module's (the quiet direction). A creation site
// is reported by the name its :ets.new/2 gave, and one whose name is
// computed at run time only where a rule says so.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/tables.dl"
.include "../clientlib/tooling.dl"
.include "../clientlib/escape.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ── Ownership & lifecycle ──────────────────────────────────────────

// A table's owner is the process that runs its `:ets.new/2`. The
// processes that run the program's code, each named by what starts it
// (process_root):
// - "server <mod>": a process module's own process, which runs its
//   callbacks (process_entry, callbacks.dl; a supervisor_bridge's
//   init/1 among them), and what its start function spawns on its own
//   code (`proc_lib:start_link(?MODULE, init, _)`, an
//   `Agent.start_link(fn -> ... end)`): the process the start returns,
//   the one a supervisor restarts;
// - "spawn <root>": any other process a spawn, a task or an agent starts
//   (process_start; a fun handed to a helper that starts one,
//   runs_elsewhere.dl's fun_sink), running `root` — a keeper a server's
//   init/1 spawns to hold a table is a process of its own, and outlives
//   neither its own crash nor the end of its function;
// - "app <mod>": an Application's start/2, which runs in the process
//   that lives as long as the application does;
// - "behaviour <mod>": a module under a behaviour that is not a
//   process's (an Oban worker's perform/1, a plug's call/2), run by
//   whichever process its framework calls it from — a job's, a
//   request's — which the program does not show. Each function of the
//   module that no root above reaches is a root.
// A root's own stack (owner_reaches: SameProcessReach, into any module)
// is its process's. A server module's client function, run by its
// callers, makes its caller's table: the process of whichever root
// reaches it (another server's callback, a spawned task, a job).
//
// Code of another module makes a table the owner holds when the table is
// named: shared state the helper sets up for the process
// (`Metrics.init()` from the server's init/1). An unnamed table another
// module makes is a value it hands back — a digraph's, a query cache's,
// a connection's statement table — the caller's data, held as its state
// is and gone when it is, by design. So is an unnamed table a behaviour
// module makes and returns (grpc's load-balancing strategies, whose
// init/1 hands the table back in the state its caller keeps): the
// caller holds it, not the module. Soundness assumption: a reference
// handed back is held only by the caller it goes to; one also kept
// elsewhere (in persistent_term, another table) is not seen.
//
// Three words about who holds ETS state, apart on purpose:
// - this one (and owner_reaches): the process a table dies with,
//   anywhere on its stack — the direction that reports (a crash takes
//   the table, a caller's read raises); both rules below that ask who
//   owns a table (it dies with its owner; it is read outside its owner)
//   read it;
// - failure.dl's `table_owner`/`in_owner`/`seeded_row`: a table (and
//   rows) created on EVERY path through init/1 and never dropped, and a
//   function only that process runs — what makes an operation unable to
//   fail, the direction that stays quiet, so it asks more;
// - races.dl's `held_table`/`held_row`: rows, not tables — a row only
//   the writer that minted its key can name.
//
// Backward from the table functions (creators and readers) to the roots
// that reach them, so the closure is bounded by functions x table
// functions rather than by every process's whole reach.
.init ets_reach = SameProcessReach

ets_reach.seed(f, f) :- ets_new(_, f, _).
ets_reach.seed(f, f) :- ets_op(_, f, _, _, "read").
ets_reach.seed(f, f) :- table_read(_, f, _, _).
// A function that spawns a linked process: which process runs it says
// what the spawn ends with (linked_by, below).
ets_reach.seed(f, f) :- spawn_call(_, f, _, _, _, "spawn_link", _, _, _, _).
// An export of a module that makes a table: which process runs it says
// whether its callers are in view (called_from_outside, below).
ets_reach.seed(e, e) :-
  api_export(e),
  function_def(e, m, _, _, _),
  ets_new(_, c, _),
  function_def(c, m, _, _, _).

.decl process_root(root: symbol, proc: symbol, mod: symbol, kind: symbol)

process_root(c, cat("server ", m), m, "server") :- process_entry(m, c).

process_root(g, cat("server ", m), m, "server") :- own_start(g, m).

// A special process's sys callbacks run in its own process: its loop
// hands a system message to sys:handle_system_msg/6, which calls them
// back there (vmq_queue_sup's system_continue/3 re-enters its loop).
process_root(c, cat("server ", m), m, "server") :-
  own_start(_, m),
  function_def(c, m, n, a, _),
  sys_callback(n, a).

.decl sys_callback(name: symbol, arity: number)

sys_callback("system_continue", 3).
sys_callback("system_terminate", 4).
sys_callback("system_code_change", 4).
sys_callback("system_get_state", 1).
sys_callback("system_replace_state", 2).

process_root(g, cat("spawn ", g), m, "spawn") :-
  process_start(_, _, _, kind, g),
  kind != "server",
  function_def(g, m, _, _, _),
  !own_start(g, m).

process_root(g, cat("spawn ", g), m, "spawn") :-
  fun_handed_to(_, g, h),
  fun_sink(h, "start"),
  function_def(g, m, _, _, _),
  !own_start(g, m).

process_root(c, cat("app ", m), m, "app") :-
  behaves_as(m, "Application"),
  function_def(c, m, "start", 2, _).

process_root(f, cat("behaviour ", m), m, "behaviour") :-
  behaves_as(m, b),
  b != "Application",
  !process_behaviour_module(m),
  function_def(f, m, _, _, _),
  !known_reaches(f).

// A module's start function starts a process on the module's own code
// and returns it (PidFlow's pid_return: the start's `{:ok, pid}`, or the
// pid), or starts no server beside it (application_controller:start/1
// spawns its process and answers with the ack it waits for): the
// module's own process, the one its supervisor restarts. A keeper the
// start function spawns beside the server it returns is not. Nor is one
// spawned anywhere else — but the subsystem a supervisor_bridge's
// init/1 spawns on the module's own code, which the bridge links to and
// stops, and whose exit ends the bridge for its supervisor to restart.
.decl own_start(root: symbol, mod: symbol)

own_start(g, m) :-
  process_start(id, s, p, kind, g),
  kind != "server",
  start_function(s, m),
  function_def(g, m, _, _, _),
  (pid_return(s, "obj", id) ; pid_return(s, "proc", p)).

own_start(g, m) :-
  process_start(_, s, _, kind, g),
  kind != "server",
  start_function(s, m),
  function_def(g, m, _, _, _),
  !process_start(_, s, _, "server", _).

own_start(g, m) :-
  process_start(_, s, _, kind, g),
  kind != "server",
  behaves_as(m, ":supervisor_bridge"),
  function_def(s, m, "init", 1, _),
  function_def(g, m, _, _, _).

.decl start_function(func: symbol, mod: symbol)

start_function(s, m) :-
  function_def(s, m, n, _, _),
  (n = "start" ; n = "start_link" ; n = "start_monitor").

// A function a server, a spawned process or an application runs.
.decl known_root(root: symbol)

known_root(c) :- process_entry(_, c).
known_root(g) :- process_start(_, _, _, kind, g), kind != "server".
known_root(g) :- fun_handed_to(_, g, h), fun_sink(h, "start").
known_root(c) :- behaves_as(m, "Application"), function_def(c, m, "start", 2, _).

.decl known_reaches(func: symbol)

known_reaches(t) :- known_root(c), ets_reach.reaches(c, t).

// The process `proc` (of module `mod`) runs `func` on its own stack.
.decl owner_reaches(proc: symbol, mod: symbol, func: symbol)

owner_reaches(p, m, t) :- process_root(c, p, m, _), ets_reach.reaches(c, t).

.decl table_held(name: symbol, proc: symbol, mod: symbol, site: symbol)

table_held(name, p, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  owner_reaches(p, mod, func),
  function_def(func, mod, _, _, _),
  !handed_back(id, p).

// A named table is held by whichever process runs its :ets.new/2, in
// that process's module or in a helper's (`Metrics.setup()`): a named
// table is never handed back (handed_back asks an unnamed one).
table_held(name, p, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  owner_reaches(p, mod, func),
  ets_option(id, "named_table", "true").

// An unnamed table a behaviour module makes and returns — itself, or in
// a term its function builds and returns, any depth down (PidFlow's
// pid_return and pid_field): the caller's data.
.decl handed_back(site: symbol, proc: symbol)

handed_back(id, p) :-
  process_root(_, p, _, "behaviour"),
  ets_new(id, f, _),
  !ets_option(id, "named_table", "true"),
  table_alloc(id, f, t),
  returns_table(f, t).

.decl returns_table(func: symbol, table: symbol)

returns_table(f, t) :- pid_return(f, "table", t).
returns_table(f, t) :- returned_term(f, o), pid_field(f, o, _, "table", t).

.decl returned_term(func: symbol, obj: symbol)

returned_term(f, o) :- pid_return(f, "obj", o).
returned_term(f, o) :- returned_term(f, p), pid_field(f, p, _, "obj", o).

// ── A table that dies with its owner ──

// A table other processes can read goes with the process that owns it,
// and nothing keeps it or makes it again: no heir takes it over, no
// supervisor restarts the owner, and the owner does not live as long as
// the application. `create` is the :ets.new/2 instruction, the creation
// line.
.decl table_dies_with_owner(table: symbol, owner: symbol, owner_mod: symbol, create: symbol)

table_dies_with_owner(table, owner, owner_mod, create) :-
  table_held(table, owner, owner_mod, create),
  !has_heir(create),
  !private_table(create),
  !restarted_by_supervisor(owner),
  !lives_with_application(owner).

// The table made at `create` is :private: no other process can read it,
// so no reader meets it gone, and its rows are the owner's state, lost
// with the process as its heap is (zotonic's mod_logging dedup table).
.decl private_table(create: symbol) inline

private_table(create) :- ets_option(create, "access", "private").

// `owner` is a module's own process (a server's, an application's, a
// behaviour's), not one spawned beside it: a keeper an init/1 spawns is
// not the child its supervisor restarts, and a table it holds dies with
// it however the spawning module is supervised. (What a module's start
// function spawns on its own code is the child, and a "server" root.)
.decl module_process(owner: symbol, mod: symbol)

module_process(p, mod) :- process_root(_, p, mod, kind), kind != "spawn".

// A supervisor restarts the owner's module permanently, and the restart
// makes the table again: listed in a child list, started by a
// DynamicSupervisor.start_child or added by a start_child (dets_server's
// ensure_started puts it under kernel_safe_sup), under :permanent
// (restart_policy: the spec's, or a shorthand's own child_spec/1's). A
// `use GenServer, restart: :temporary` owner started by its shorthand is
// never restarted, and its table is gone for good once it crashes; a
// transient or temporary spec, or one whose restart the extractor could
// not read, is no excuse.
.decl restarted_by_supervisor(owner: symbol)

restarted_by_supervisor(p) :-
  module_process(p, mod),
  restart_policy(_, mod, "permanent").

// The owner lives as long as the application, so its table is never lost
// while the application runs: an Application module's, or the supervisor
// the Application starts (application_root, supervision.dl: partisan_sup
// keeps its membership snapshot in a table it creates in init/1 so the
// table outlives the managers it restarts).
.decl lives_with_application(owner: symbol)

lives_with_application(p) :- module_process(p, mod), behaves_as(mod, "Application").
lives_with_application(p) :- module_process(p, mod), application_root(mod).

.decl ets_unprotected_owner(name: symbol, mod: symbol, site: symbol)
.output ets_unprotected_owner

ets_unprotected_owner(name, mod, site) :- table_dies_with_owner(name, _, mod, site).

// ── Concurrent access patterns ─────────────────────────────────────

// Two modules read a table made without :read_concurrency, whose readers
// then take the table's lock in turn.
.decl reads_without_read_concurrency(table: symbol, create: symbol)

reads_without_read_concurrency(table, create) :-
  read_by_two_modules(create, _, _),
  makes_table(create, table),
  !made_for_concurrent_reads(create).

// Two modules write a table made without :write_concurrency, whose
// writers then take the table's lock in turn.
.decl writes_without_write_concurrency(table: symbol, create: symbol)

writes_without_write_concurrency(table, create) :-
  written_by_two_modules(create, _, _),
  makes_table(create, table),
  !made_for_concurrent_writes(create).

// Two modules write a table made as an ordered_set, whose writers contend
// more than a hash table's do.
.decl ordered_set_written_by_two_modules(table: symbol, first: symbol, second: symbol, create: symbol)

ordered_set_written_by_two_modules(table, first, second, create) :-
  written_by_two_modules(create, first, second),
  makes_table(create, table),
  ordered_set(create).

// Two modules, `first` before `second`, read the table made at `create`
// (each pair once).
.decl read_by_two_modules(create: symbol, first: symbol, second: symbol)

read_by_two_modules(create, m1, m2) :-
  reads_in_module(create, m1),
  reads_in_module(create, m2),
  m1 < m2.

// Two modules, `first` before `second`, write the table made at `create`
// (each pair once).
.decl written_by_two_modules(create: symbol, first: symbol, second: symbol)

written_by_two_modules(create, m1, m2) :-
  writes_in_module(create, m1),
  writes_in_module(create, m2),
  m1 < m2.

// Code of `mod` reads the table made at `create`.
.decl reads_in_module(create: symbol, mod: symbol)

reads_in_module(create, mod) :-
  ets_op(id, func, _, _, "read"),
  touches_made_table(id, create),
  function_def(func, mod, _, _, _).

// Code of `mod` writes the table made at `create`.
.decl writes_in_module(create: symbol, mod: symbol)

writes_in_module(create, mod) :-
  ets_op(id, func, _, _, "write"),
  touches_made_table(id, create),
  function_def(func, mod, _, _, _).

// The operation at `id` may touch the table the :ets.new/2 at `create`
// makes (clientlib/tables.dl: the same table, by kind and identity).
.decl touches_made_table(id: symbol, create: symbol)

touches_made_table(id, create) :-
  ets_op(id, _, _, _, _),
  ets_table(id, k, t),
  table_made_at(k, t, create).

// The :ets.new/2 at `create` makes the table of that name, the name a
// finding spells it by ("dynamic", a name computed at run time, is
// none).
.decl makes_table(create: symbol, table: symbol)

makes_table(create, table) :- ets_new(create, _, table), table != "dynamic".

.decl made_for_concurrent_reads(create: symbol) inline

made_for_concurrent_reads(create) :- ets_option(create, "read_concurrency", "true").

// :write_concurrency true, or :auto.
.decl made_for_concurrent_writes(create: symbol)

made_for_concurrent_writes(create) :- ets_option(create, "write_concurrency", "true").
made_for_concurrent_writes(create) :- ets_option(create, "write_concurrency", "auto").

.decl ordered_set(create: symbol) inline

ordered_set(create) :- ets_option(create, "type", "ordered_set").

// The module that makes the table at `create`.
.decl made_in(create: symbol, mod: symbol) inline

made_in(create, mod) :- ets_new(create, func, _), function_def(func, mod, _, _, _).

.decl ets_missing_read_concurrency(name: symbol, mod: symbol, site: symbol)
.output ets_missing_read_concurrency

ets_missing_read_concurrency(name, mod, site) :-
  reads_without_read_concurrency(name, site),
  made_in(site, mod).

.decl ets_missing_write_concurrency(name: symbol, mod: symbol, site: symbol)
.output ets_missing_write_concurrency

ets_missing_write_concurrency(name, mod, site) :-
  writes_without_write_concurrency(name, site),
  made_in(site, mod).

// site is the :ets.new/2 instruction that chose ordered_set.
.decl ets_ordered_set_contention(name: symbol, mod1: symbol, mod2: symbol, site: symbol)
.output ets_ordered_set_contention

ets_ordered_set_contention(name, mod1, mod2, site) :-
  ordered_set_written_by_two_modules(name, mod1, mod2, site).

// ── Stale reference risk ───────────────────────────────────────────

// A process module's own server makes a table without a name: whoever
// keeps the reference holds a dead one once the server restarts and
// makes the table again. `create` is the :ets.new/2 instruction, the
// creation line.
.decl unnamed_table_in_server(table: symbol, owner_mod: symbol, create: symbol)

unnamed_table_in_server(table, owner_mod, create) :-
  table_held(table, owner, owner_mod, create),
  runs_as_server(owner),
  !named_site(create).

// `owner` is a process module's own process (process_root's "server").
.decl runs_as_server(owner: symbol)

runs_as_server(p) :- process_root(_, p, mod, "server"), process_module(mod).

.decl ets_unnamed_in_process(name: symbol, mod: symbol, site: symbol)
.output ets_unnamed_in_process

ets_unnamed_in_process(name, mod, site) :- unnamed_table_in_server(name, mod, site).

// ── Write-only tables ──────────────────────────────────────────────
//
// A named table that the code inserts into from outside init/1 and
// never deletes from is a table that only grows. Sentry's check-in ID
// mapping was one: every check-in inserted a row, nothing ever removed
// one, and the process held the table for the life of the VM. A table
// filled once in init/1 and read thereafter is a cache, not a leak, and
// is not reported.
//
// Any removal (ets_removal_op, clientlib/effect_model.dl) of a table no
// view names (may_touch_any_table) in the owner's module is taken as
// possibly this table — the direction that stays quiet.

// A named table gains rows outside init/1, and nothing ever removes one.
.decl table_only_grows(table: symbol, create: symbol)

table_only_grows(table, create) :-
  makes_table(create, table),
  named_site(create),
  grows_outside_init(create),
  !loses_rows(create).

// An insert outside init/1 adds a row to the table made at `create`: one
// that does not overwrite the row its key names (overwrites_row). A
// function named init, of any arity, counts as init/1.
.decl grows_outside_init(create: symbol)

grows_outside_init(create) :-
  ets_op(id, f, _, op, "write"),
  (op = "insert" ; op = "insert_new"),
  touches_made_table(id, create),
  function_def(f, _, fname, _, _),
  fname != "init",
  !overwrites_row(id).

// Code removes rows from the table made at `create`: any removal of that
// table, or any removal of a table no view names in the module that
// makes it, taken as possibly this table (quiet).
.decl loses_rows(create: symbol)

loses_rows(create) :-
  ets_op(id, _, _, op, _),
  ets_removal_op(op),
  touches_made_table(id, create).

loses_rows(create) :-
  made_in(create, mod),
  ets_op(id, f, _, op, _),
  ets_removal_op(op),
  may_touch_any_table(id),
  function_def(f, mod, _, _, _).

// An insert whose key is a literal (ets_key) into a set table keyed on
// the first element overwrites the one row that key names: however often
// it runs, the table holds one row for it. rabbit_disk_monitor keeps its
// four settings that way. A bag keeps every insert, and a table with a
// keypos of its own is keyed on another element.
.decl overwrites_row(id: symbol)

overwrites_row(id) :-
  ets_key(id, "literal", _),
  touches_made_table(id, t),
  !bag_table(t),
  !keyed_elsewhere(t).

// A keypos other than 1 keys the table on another element than the one
// ets_key read; vernemq's cluster-state table spells the default out.
.decl keyed_elsewhere(table: symbol)

keyed_elsewhere(t) :- ets_option(t, "keypos", p), p != "1".

.decl bag_table(table: symbol)

bag_table(t) :- ets_option(t, "type", "bag").
bag_table(t) :- ets_option(t, "type", "duplicate_bag").

.decl ets_write_only_table(name: symbol, mod: symbol, site: symbol)
.output ets_write_only_table

ets_write_only_table(name, mod, site) :-
  table_only_grows(name, site),
  made_in(site, mod).

// ── Reads from outside the owner ─────────────────────────────────────
//
// A named table created by a process's own callbacks disappears with
// the process and comes back only when its restart reaches :ets.new
// again. Its module's API (`lookup/1`, run in the caller's process)
// reads the table in that window and raises ArgumentError in the caller
// instead of returning a value — Redix.Cluster callers saw exactly that
// during a :one_for_all restart (whatyouhide/redix#338). A heir keeps
// the table alive; a rescue in the reader (or in a wrapper the reader
// hands its closure to) turns the window into a result.
//
// The window needs a reader that outlives the owner (reader_outlives,
// below): a process that runs the read goes on after the owner's process
// ends. The owner's own process does not (owner_reaches); nor does one
// its supervisors end with it (ends_with, supervision.dl: a child of the
// owner's subtree, a sibling a one_for_all or rest_for_one restarts with
// it), nor any when the owner's end is the application's
// (application_lifetime). A reader no process in view runs is called
// from outside them, and goes on. docs/design/restart-state.md is the
// model: what one process holds that another's end discards.

// A read of a table, from a process that goes on after the table's owner
// ends: the table goes with its owner, and the read raises ArgumentError
// until the owner's restart makes it again.
.decl read_while_owner_restarts(reader: symbol, read: symbol, create: symbol, owner: symbol, owner_mod: symbol)

read_while_owner_restarts(reader, read, create, owner, owner_mod) :-
  reads_held_table(read, reader, create, owner, owner_mod),
  !has_heir(create),
  reader_outlives(reader, owner, owner_mod),
  !handles_missing_table(read, reader).

// `reader` reads, at `read`, the table made at `create`, which the process
// `owner` (of `owner_mod`'s code) holds (table_held): the read's table is
// that one (reads_made_table); or the table's name is computed at run
// time, and the read is one the owner's own module makes of a table no
// view names (computed_read).
.decl reads_held_table(read: symbol, reader: symbol, create: symbol, owner: symbol, owner_mod: symbol)

// The owner is table_held's: the process whose stack runs the
// :ets.new/2, a helper module's named table included (the server whose
// init/1 calls `Metrics.setup()` holds it, and `Metrics.lookup/1`, run
// by callers, reads it from outside).
reads_held_table(read, reader, create, owner, owner_mod) :-
  table_held(_, owner, owner_mod, create),
  reads_made_table(read, reader, create).

// A table under a name computed at runtime: only the owner's own API can
// be tied to it. It is judged as a named read is: a reader outlives the
// owner (a shard's `get/2` its callers run, though the shard's own
// handle_call also runs it), and the read is not rescued.
reads_held_table(read, reader, create, owner, owner_mod) :-
  computed_read(owner, owner_mod, reader, read, create).

// The read meets a missing table without raising out of the reader: it
// is rescued (read_rescued), or it is made only while the table is there
// (read_when_present; the extractor gives no read of a computed name
// one).
.decl handles_missing_table(read: symbol, reader: symbol)

handles_missing_table(read, reader) :- read_rescued(read, reader).

handles_missing_table(read, reader) :- read_when_present(read), table_read(read, reader, _, _).

.decl ets_read_outside_owner(name: symbol, owner: symbol, reader: symbol, site: symbol, created: symbol)
.output ets_read_outside_owner

ets_read_outside_owner(name, owner_mod, reader, read, create) :-
  read_while_owner_restarts(reader, read, create, _, owner_mod),
  read_names(read, reader, create, name).

// The name a finding spells the table by: the named table the read names,
// made at `create`, or else the name its :ets.new/2 gave ("dynamic" when
// computed at run time).
.decl read_names(read: symbol, reader: symbol, create: symbol, name: symbol)

read_names(read, reader, create, name) :-
  read_while_owner_restarts(reader, read, create, _, _),
  table_read(read, reader, "named", name),
  table_made_at("named", name, create).

read_names(read, reader, create, name) :-
  read_while_owner_restarts(reader, read, create, _, _),
  !reads_named_table(read, reader, create),
  ets_new(create, _, name).

.decl reads_named_table(read: symbol, reader: symbol, create: symbol)

reads_named_table(read, reader, create) :-
  table_read(read, reader, "named", name),
  table_made_at("named", name, create).

// The read at `site` raises when its table is gone (races'
// raises_if_row_missing asks of a missing row). :ets.info/1,2 answers
// :undefined for a table that is gone; it is how a reader asks, not a
// read that raises (ets_answers_missing_table, clientlib/effect_model.dl).
.decl raises_if_table_missing(site: symbol)

raises_if_table_missing(site) :- ets_op(site, _, _, op, "read"), !ets_answers_missing_table(op).

// The ArgumentError a missing table raises does not escape the reader
// (Escape, clientlib/escape.dl): a try that takes it and goes on covers
// the read, or a call on every path from the reader down to it (a read
// through a caller's literal is made in the helper the literal is handed
// to), or every call to the reader. A rescue around unrelated code
// elsewhere in the reader does not take it, as ets_missing_row learned
// (9406a24). A read in a closure is rescued where every call the closure
// is handed to is covered.
.decl read_rescued(site: symbol, func: symbol)

read_rescued(site, reader) :- table_miss.rescued(site, reader, "badarg").

.init table_miss = Escape

table_miss.asked(site, g, reader, "badarg") :- table_read(site, reader, _, _), ets_op(site, g, _, _, _).
table_miss.asked(site, reader, reader, "badarg") :- computed_read(_, _, reader, site, _).
table_miss.asked(create, f, start, "badarg") :- makes_on_its_stack(start, create), ets_new(create, f, _).

// A reader that asks `:ets.whereis/1` of the table before reading it
// (hackney's HTTP/3 connection table, Sentry's dedupe), or makes it on
// its way when it is missing (an ensure helper before each read:
// blockster's SystemConfig, sequin's Benchmark.Stats), reads only while
// the table is there — when every path to the read passes the side of
// the answer's test that found it, or an instruction that makes it
// (ets_read_when_present, from the ETS extractor). A whereis in another
// clause, one whose answer is logged and the table read anyway, a read
// on the `:undefined` side, or a make on one path only guards nothing.
// The window between the question and the read is left, and a table the
// reader makes is its own (dies-with-owner's row for it stands).
.decl read_when_present(site: symbol)

read_when_present(site) :- ets_read_when_present(site, _).

// `reader` reads, at `site`, a table of that kind and identity
// (clientlib/tables.dl), with a read that raises when the table is gone:
// the read's own function, or, for a read of the function's parameter, a
// caller whose literal names the table through it.
.decl table_read(site: symbol, reader: symbol, kind: symbol, ident: symbol)

table_read(site, reader, k, t) :-
  ets_op(site, reader, _, _, "read"),
  raises_if_table_missing(site),
  !ets_op_param(site, _),
  ets_table(site, k, t).

// A read through a helper that takes the table as a parameter
// (`defp fetch(table, key), do: :ets.lookup(table, key)`): the name is
// the literal a caller passes, possibly forwarded through more than one
// parameter, and a name reaches only a named table. The caller passing
// the literal is the reader that matters — it is the API someone calls —
// and the site stays the lookup.
table_read(site, caller, "named", name) :-
  call_arg(caller, g, q, name),
  name != "dynamic",
  table_param(g, q, site).

.decl table_param(func: symbol, pos: number, site: symbol)

table_param(reader, pos, site) :-
  ets_op(site, reader, "dynamic", _, "read"),
  raises_if_table_missing(site),
  ets_op_param(site, pos).

table_param(f, p, site) :-
  call_arg_forward(f, g, q, p),
  table_param(g, q, site).

// `reader` reads, at `read`, the table the :ets.new/2 at `create` makes.
.decl reads_made_table(read: symbol, reader: symbol, create: symbol)

reads_made_table(read, reader, create) :-
  table_read(read, reader, k, t),
  table_made_at(k, t, create).

// A process that runs `reader` goes on after the owner's process `p`
// ends: not p itself, not one p's end takes (ends_with, for a
// supervised owner's own process), and none at all when p's end is the
// application's. A caller outside the program runs a reader a way in
// reaches (called_from_outside), whatever process in view also runs it:
// a library's `get/2` its own handle_call also calls is its users' read
// too. A reader no process in view runs is run by a caller outside them.
.decl reader_outlives(reader: symbol, proc: symbol, owner: symbol)

reader_outlives(reader, p, owner) :-
  read_owner(p, owner, reader),
  !application_lifetime(p),
  owner_reaches(q, qm, reader),
  q != p,
  !ended_with(p, owner, q, qm).

reader_outlives(reader, p, owner) :-
  read_owner(p, owner, reader),
  !application_lifetime(p),
  called_from_outside(reader).

reader_outlives(reader, p, owner) :-
  read_owner(p, owner, reader),
  !application_lifetime(p),
  !runs_somewhere(reader).

.decl read_owner(proc: symbol, owner: symbol, reader: symbol)

read_owner(p, owner, reader) :- table_held(_, p, owner, create), reads_made_table(_, reader, create).
read_owner(p, owner, reader) :- computed_read(p, owner, reader, _, _).

.decl runs_somewhere(func: symbol)

runs_somewhere(f) :- read_owner(_, _, f), owner_reaches(_, _, f).

// A way in from outside the program reaches `f` on its caller's stack:
// an export of a module the program is the client of nowhere
// (library_face, ways_in.dl) that roots no process in view — its
// callers are the library's users, in processes of their own; or an
// export of the owner's own module, its client API, that roots no
// process and that no process in view runs: the code in view that calls
// it runs in its callers' processes, which the program does not show
// (Phoenix.Tracker's `list/2`, which Phoenix.Presence's functions call
// for their users, reaching `pool_size/1`).
.decl called_from_outside(func: symbol)

called_from_outside(f) :-
  read_owner(_, _, f),
  library_face(e),
  !process_root(e, _, _, _),
  ets_reach.reaches(e, f).

called_from_outside(f) :-
  read_owner(_, owner, f),
  api_export(e),
  function_def(e, owner, _, _, _),
  !process_root(e, _, _, _),
  ets_reach.reaches(e, f),
  !owner_reaches(_, _, e).

// The reader's process q (of qm's code) ends when the owner's process p
// ends: q is a supervised module's own process its supervisors end with
// the owner's server (ends_with), or q is spawned linked
// (`spawn_link`) by a process that is p or ends with it — the link ends
// it too. A linked process that traps exits outlives its peer and is
// taken as ended (quiet): a spawned loader rarely traps.
.decl ended_with(proc: symbol, owner: symbol, q: symbol, qm: symbol)

ended_with(p, owner, q, qm) :-
  read_owner(p, owner, reader),
  process_root(_, p, owner, "server"),
  owner_reaches(q, qm, reader),
  process_root(_, q, qm, "server"),
  ends_with(owner, qm).

ended_with(p, owner, q, qm) :-
  read_owner(p, owner, reader),
  owner_reaches(q, qm, reader),
  linked_by(q, r),
  ends_by(p, owner, r).

// The process `q` (process_root's "spawn <function it runs>") is
// spawned linked by a function the process `r` runs.
.decl linked_by(q: symbol, starter: symbol)

linked_by(cat("spawn ", g), r) :-
  process_start(id, s, _, "spawn", g),
  spawn_call(id, s, _, _, _, "spawn_link", _, _, _, _),
  owner_reaches(r, _, s).

// `r` is the owner's process p, or a process that ends with it.
.decl ends_by(proc: symbol, owner: symbol, r: symbol)

ends_by(p, owner, p) :- read_owner(p, owner, _).

ends_by(p, owner, r) :-
  read_owner(p, owner, _),
  process_root(_, p, owner, "server"),
  process_root(_, r, rm, "server"),
  ends_with(owner, rm).

// A process whose exit is its application's: the process an
// Application's start/2 runs in, and the supervisor that start/2 starts
// and no other supervisor in view does (application_root,
// supervision.dl), whose death stops the application. Nothing restarts
// either, so no read meets the table gone while the application runs:
// the lifetime lives_with_application excuses from dying with its owner,
// asked of the process here. A worker start/2 starts, a supervisor
// another tree also starts, a keeper a root supervisor spawns and a
// table one of its children makes each have a restart of their own.
.decl application_lifetime(proc: symbol)

application_lifetime(p) :- process_root(_, p, _, "app").
application_lifetime(p) :- process_root(_, p, m, "server"), application_root(m).

// ── A table under a computed name ──
//
// A table whose :ets.new/2 is given a name computed at run time, by a
// server of the module, is judged as a named one is where its reads name
// it (reads_made_table). A read of a table no site in view is known to
// make (none named, a name no site is known to give, a field or a
// handed-in table), in the owner's own module, is taken to be it: only
// the owner's own API can be tied to it (vmq_diversity_cache's
// `ets:new(table(T), ...)` over a list, read through `match_/3`'s
// parameter). A read the facts say is a table made in view is not.
.decl computed_read(proc: symbol, owner: symbol, reader: symbol, site: symbol, id: symbol)

computed_read(p, owner, reader, site, id) :-
  computed_name_held(p, owner, id),
  reads_made_table(site, reader, id).

computed_read(p, owner, reader, site, id) :-
  computed_name_held(p, owner, id),
  ets_op(site, reader, "dynamic", _, "read"),
  raises_if_table_missing(site),
  !reads_table_made_in_view(site),
  function_def(reader, owner, _, _, _).

// The read touches a table some site in view is known to make: then it
// is that table, not one under a name computed at run time.
.decl reads_table_made_in_view(site: symbol)

reads_table_made_in_view(site) :-
  ets_op(site, _, "dynamic", _, "read"),
  ets_table(site, k, t),
  table_made_at(k, t, _).

// The owner's server makes the table at `id` under a computed name, and
// no heir takes it over.
.decl computed_name_held(proc: symbol, owner: symbol, id: symbol)

computed_name_held(p, owner, id) :-
  ets_new(id, creator, "dynamic"),
  function_def(creator, owner, _, _, _),
  process_root(_, p, owner, "server"),
  owner_reaches(p, owner, creator),
  !has_heir(id).

// ── A named table a start function creates ─────────────────────────
//
// A server's `start_link` runs in whoever starts the server — its
// supervisor, when the server is a child — not in the server: only the
// callbacks the start leads to run in the new process. A named table
// `start_link` creates belongs to that caller. It outlives the server's
// crash, and the restart, which calls `start_link` again in the same
// supervisor, raises ArgumentError on the `:ets.new/2` of a name that is
// still taken: the child cannot restart, and its supervisor retries until
// its intensity is spent and exits (ex_uid2's Dsp moved the call into
// init/1; blockscout's ContractCreator and policr-mini's UpdatesPoller
// guarded it with `:ets.whereis/1`; joken_jwks#40 reported the crash).
//
// A start function is a process module's `start_link` that starts a
// server itself (a GenServer, gen_statem, GenStage, Agent or Supervisor
// start). The table is made on its own stack (SameProcessReach, so not in
// what it spawns), and none of the module's own callbacks, init/1
// included, make the same table: those run in the server. Not judged: a
// table made only where the name is free (the function that creates it,
// or the start function, makes it only past the `:undefined` side of its
// own `:ets.whereis/1` or `:ets.info/1,2` of that table:
// ets_made_when_absent; a lookup of another table guards nothing), one
// rescued of the ArgumentError at the call, one given away
// (`:ets.give_away/3` of the same table, or of an operand that may be
// it), an unnamed table (a second one does not collide), and a module
// whose child spec says `restart: :temporary` (never restarted). A start
// function the program's own supervisors never call is still judged: a
// library's server is started by its users'.

// A server's start function makes a named table in its caller's process,
// so the table outlives the server, and the restart's `:ets.new/2` of the
// taken name raises before the server can start again.
.decl table_made_in_start(mod: symbol, start: symbol, create: symbol)

table_made_in_start(mod, start, create) :-
  starts_server(start, mod),
  makes_on_its_stack(start, create),
  named_site(create),
  !made_by_server(create, mod),
  !made_only_when_free(create, start),
  !given_away(create, start),
  !rescued_when_taken(create, start).

.decl starts_server_api(mod: symbol, func: symbol)

starts_server_api("GenServer", "start_link").
starts_server_api("GenServer", "start").
starts_server_api(":gen_server", "start_link").
starts_server_api(":gen_server", "start").
starts_server_api(":gen_statem", "start_link").
starts_server_api(":gen_statem", "start").
starts_server_api("GenStateMachine", "start_link").
starts_server_api("GenStage", "start_link").
starts_server_api("Agent", "start_link").
starts_server_api("Supervisor", "start_link").
starts_server_api(":supervisor", "start_link").

// `start` is mod's `start_link`, and starts a server itself (a call to
// one of the APIs above).
.decl starts_server(start: symbol, mod: symbol)

starts_server(s, m) :-
  function_def(s, m, "start_link", _, 1),
  process_behaviour_module(m),
  remote_call(_, s, api, op, _),
  starts_server_api(api, op),
  !child_spec_restart(m, "temporary").

.init start_side = SameProcessReach

start_side.seed(f, f) :- ets_new(n, f, _), ets_option(n, "named_table", "true").

// The :ets.new/2 at `create` runs on start's own stack: in the start
// function, or a function it calls in the same process.
.decl makes_on_its_stack(start: symbol, create: symbol)

makes_on_its_stack(start, create) :-
  starts_server(start, _),
  start_side.reaches(start, f),
  ets_new(create, f, _).

// The module's own process makes it: init/1 or a callback reaches it.
.decl made_by_server(site: symbol, mod: symbol)

made_by_server(n, m) :-
  ets_new(n, f, _),
  process_entry(m, c),
  start_side.reaches(c, f).

// The function that makes the table, or the start function, makes it only
// past the `:undefined` side of its own `:ets.whereis/1` or `:ets.info/1,2`
// of that table (ets_made_when_absent): where the name is free.
.decl made_only_when_free(create: symbol, start: symbol)

made_only_when_free(create, start) :-
  makes_on_its_stack(start, create),
  ets_new(create, f, name),
  ets_made_when_absent(f, name, _).

made_only_when_free(create, start) :-
  makes_on_its_stack(start, create),
  ets_new(create, _, name),
  ets_made_when_absent(start, name, _).

// The function that makes the table, or the start function, gives the
// table away (`:ets.give_away/3` of the same table, or of an operand
// that may be it): its new owner is no longer the caller.
.decl given_away(create: symbol, start: symbol)

given_away(create, start) :-
  makes_on_its_stack(start, create),
  ets_new(create, f, _),
  (gives_table_away(f, create) ; gives_some_table_away(f)).

given_away(create, start) :-
  makes_on_its_stack(start, create),
  (gives_table_away(start, create) ; gives_some_table_away(start)).

// `func` gives away the table made at `create`.
.decl gives_table_away(func: symbol, create: symbol)

gives_table_away(f, create) :- ets_op(id, f, _, "give_away", _), touches_made_table(id, create).

// `func` gives away a table no view names: it may be any.
.decl gives_some_table_away(func: symbol)

gives_some_table_away(f) :- ets_op(id, f, _, "give_away", _), may_touch_any_table(id).

// The ArgumentError a taken name raises at the `:ets.new/2` does not
// escape the start function (Escape): a try that takes it covers the
// :ets.new/2, a call on every path from the start down to it, or every
// call to the start.
.decl rescued_when_taken(create: symbol, start: symbol)

rescued_when_taken(create, start) :- table_miss.rescued(create, start, "badarg").

.decl ets_created_in_start(name: symbol, mod: symbol, site: symbol, start: symbol)
.output ets_created_in_start

ets_created_in_start(name, mod, site, start) :-
  table_made_in_start(mod, start, site),
  ets_new(site, _, name).
