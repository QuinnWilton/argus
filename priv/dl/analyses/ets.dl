// ETS table ownership, concurrency, and lifecycle analysis.
//
// Detects common ETS anti-patterns:
// - Tables owned by processes without heir protection.
// - Reads from callers' processes while the owner may be restarting.
// - Cross-module access without concurrency settings.
// - Write contention on ordered_set tables.
// - Tables that only grow.
// - Unnamed tables in processes (stale reference risk).
//
// The read-then-write race on a key is races.dl's.
//
// Tables whose name resolves to "dynamic" are excluded from derived rules
// because their identity is unknown — joining on "dynamic" conflates
// independent tables and produces false positives.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ── Ownership & lifecycle ──────────────────────────────────────────

// A table's owner is the process that runs its `:ets.new/2`: the one of
// module `mod` whose own stack reaches the creating function
// (owner_reaches, below: its process entries, in its process, into any
// module). A server module's client function makes its caller's table (a
// start function's table is the caller's: the start-function rule
// below), and a behaviour whose functions no process of its own runs (a
// plug, a storage module a library's server calls) owns none. The owner
// is known only when the program starts it — a behaviour module's
// process (process_behaviour_module) — and `behaviour` is that module's.
// A module of another behaviour — grpc's load-balancing strategies,
// whose init/1 makes an unnamed table and hands it back in the state
// its caller keeps — runs in whoever calls it, and owns nothing of its
// own.
//
// Code of another module makes a table the owner holds when the table is
// named: shared state the helper sets up for the process
// (`Metrics.init()` from the server's init/1). An unnamed table another
// module makes is a value it hands back — a digraph's, a query cache's,
// a connection's statement table — the caller's data, held as its state
// is and gone when it is, by design.
//
// Three words about who holds ETS state, apart on purpose:
// - this one (and owner_reaches): the process a table dies with,
//   anywhere on its stack — the direction that reports (a crash takes
//   the table, a caller's read raises);
// - failure.dl's `table_owner`/`in_owner`/`seeded_row`: a table (and
//   rows) created on EVERY path through init/1 and never dropped, and a
//   function only that process runs — what makes an operation unable to
//   fail, the direction that stays quiet, so it asks more;
// - races.dl's `held_table`/`held_row`: rows, not tables — a row only
//   the writer that minted its key can name.
.decl table_held(name: symbol, mod: symbol, site: symbol)

table_held(name, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  owner_reaches(mod, func),
  function_def(func, mod, _, _, _).

table_held(name, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  owner_reaches(mod, func),
  !function_def(func, mod, _, _, _),
  ets_option(id, "named_table", "true").

.decl ets_owner_process(name: symbol, mod: symbol, behaviour: symbol, site: symbol)

ets_owner_process(name, mod, behaviour, id) :-
  table_held(name, mod, id),
  behaves_as(mod, behaviour),
  process_behaviour_module(mod).

// Owner under a permanent supervisor child — the table will be
// recreated on restart, so the missing heir is not a real risk.
.decl ets_permanent_owner(name: symbol, mod: symbol)

ets_permanent_owner(name, mod) :-
  ets_owner_process(name, mod, _, _),
  supervisor_child(_, _, mod, "permanent", _).

// Owner under a DynamicSupervisor.start_child — we don't know the
// child spec's restart strategy without further analysis, but the
// module is at least supervised, which is a strong enough signal
// that we shouldn't false-positive on missing-heir for it.
ets_permanent_owner(name, mod) :-
  ets_owner_process(name, mod, _, _),
  dynamic_child(_, mod, _).

// Application modules live for the entire app — table loss is not practical.
.decl ets_application_owner(name: symbol, mod: symbol)

ets_application_owner(name, mod) :-
  ets_owner_process(name, mod, "Application", _).

// Table without heir protection in a behaviour process.
// If the owner crashes, the table vanishes.
// Suppressed for permanent supervisor children (table recreated on restart)
// and Application modules (live for the entire app lifetime).
// site is the :ets.new/2 instruction — the creation line.
.decl ets_unprotected_owner(name: symbol, mod: symbol, site: symbol)
.output ets_unprotected_owner

ets_unprotected_owner(name, mod, id) :-
  ets_owner_process(name, mod, _, id),
  !ets_option(id, "heir", "true"),
  !ets_permanent_owner(name, mod),
  !ets_application_owner(name, mod).

// ── Concurrent access patterns ─────────────────────────────────────

// Module reading from a table.
.decl ets_reader_module(name: symbol, mod: symbol)

ets_reader_module(name, mod) :-
  ets_op(_, func, name, _, "read"),
  name != "dynamic",
  function_def(func, mod, _, _, _).

// Module writing to a table.
.decl ets_writer_module(name: symbol, mod: symbol)

ets_writer_module(name, mod) :-
  ets_op(_, func, name, _, "write"),
  name != "dynamic",
  function_def(func, mod, _, _, _).

// Cross-module reads without read_concurrency.
.decl ets_missing_read_concurrency(name: symbol, mod: symbol, site: symbol)
.output ets_missing_read_concurrency

ets_missing_read_concurrency(name, mod, id) :-
  ets_reader_module(name, m1),
  ets_reader_module(name, m2),
  name != "dynamic",
  m1 < m2,
  ets_new(id, func, name),
  function_def(func, mod, _, _, _),
  !ets_option(id, "read_concurrency", "true").

// Cross-module writes without write_concurrency.
.decl ets_missing_write_concurrency(name: symbol, mod: symbol, site: symbol)
.output ets_missing_write_concurrency

ets_missing_write_concurrency(name, mod, id) :-
  ets_writer_module(name, m1),
  ets_writer_module(name, m2),
  name != "dynamic",
  m1 < m2,
  ets_new(id, func, name),
  function_def(func, mod, _, _, _),
  !ets_option(id, "write_concurrency", "true"),
  !ets_option(id, "write_concurrency", "auto").

// Write contention on ordered_set (higher lock contention).
// site is the :ets.new/2 instruction that chose ordered_set.
.decl ets_ordered_set_contention(name: symbol, mod1: symbol, mod2: symbol, site: symbol)
.output ets_ordered_set_contention

ets_ordered_set_contention(name, mod1, mod2, id) :-
  ets_writer_module(name, mod1),
  ets_writer_module(name, mod2),
  name != "dynamic",
  mod1 < mod2,
  ets_new(id, _, name),
  ets_option(id, "type", "ordered_set").

// ── Stale reference risk ───────────────────────────────────────────

// Table created without named_table by a process —
// the reference becomes invalid if the owner restarts.
// site is the :ets.new/2 instruction — the creation line.
.decl ets_unnamed_in_process(name: symbol, mod: symbol, site: symbol)
.output ets_unnamed_in_process

ets_unnamed_in_process(name, mod, id) :-
  table_held(name, mod, id),
  process_module(mod),
  !ets_option(id, "named_table", "true").

// ── Write-only tables ──────────────────────────────────────────────
//
// A named table that the code inserts into from outside init/1 and
// never deletes from is a table that only grows. Sentry's check-in ID
// mapping was one: every check-in inserted a row, nothing ever removed
// one, and the process held the table for the life of the VM. A table
// filled once in init/1 and read thereafter is a cache, not a leak, and
// is not reported.
//
// Any removal (ets_removal_op, clientlib/effect_model.dl) on a dynamic table
// reference in the owner's module is taken as possibly this table — the
// direction that stays quiet.

.decl ets_table_shrinks(name: symbol, owner: symbol)

ets_table_shrinks(name, owner) :-
  ets_new(_, func, name),
  function_def(func, owner, _, _, _),
  ets_op(_, _, name, op, _),
  ets_removal_op(op).

ets_table_shrinks(name, owner) :-
  ets_new(_, func, name),
  function_def(func, owner, _, _, _),
  ets_op(_, f, "dynamic", op, _),
  ets_removal_op(op),
  function_def(f, owner, _, _, _).

.decl ets_grows_outside_init(name: symbol)

ets_grows_outside_init(name) :-
  ets_op(id, f, name, op, "write"),
  (op = "insert" ; op = "insert_new"),
  function_def(f, _, fname, _, _),
  fname != "init",
  !overwrites_row(id).

// An insert whose key is a literal (ets_key) into a set table keyed on
// the first element overwrites the one row that key names: however often
// it runs, the table holds one row for it. rabbit_disk_monitor keeps its
// four settings that way. A bag keeps every insert, and a table with a
// keypos of its own is keyed on another element.
.decl overwrites_row(id: symbol)

overwrites_row(id) :-
  ets_op(id, _, name, _, _),
  ets_key(id, "literal", _),
  ets_new(t, _, name),
  !bag_table(t),
  !keyed_elsewhere(t).

// A keypos other than 1 keys the table on another element than the one
// ets_key read; vernemq's cluster-state table spells the default out.
.decl keyed_elsewhere(table: symbol)

keyed_elsewhere(t) :- ets_option(t, "keypos", p), p != "1".

.decl bag_table(table: symbol)

bag_table(t) :- ets_option(t, "type", "bag").
bag_table(t) :- ets_option(t, "type", "duplicate_bag").

.decl ets_write_only_table(name: symbol, mod: symbol, site: symbol)
.output ets_write_only_table

ets_write_only_table(name, mod, id) :-
  ets_new(id, func, name),
  name != "dynamic",
  ets_option(id, "named_table", "true"),
  function_def(func, mod, _, _, _),
  ets_grows_outside_init(name),
  !ets_table_shrinks(name, mod).

// ── Reads from outside the owner ─────────────────────────────────────
//
// A named table created by a process's own callbacks disappears with
// the process and comes back only when its restart reaches :ets.new
// again. Its module's API (`lookup/1`, run in the caller's process)
// reads the table in that window and raises ArgumentError in the caller
// instead of returning a value — Redix.Cluster callers saw exactly that
// during a :one_for_all restart (whatyouhide/redix#338). A heir keeps
// the table alive; a rescue in the reader (or in a wrapper the reader
// hands its closure to) turns the window into a result.
//
// The reader is "outside the owner" when the owner's callbacks do not
// reach it: what only the API reaches runs in callers.
// Backward from the table functions (creators and readers) to the
// callbacks that reach them, so the closure is bounded by functions x
// table functions rather than by every process's whole reach. The
// owner's process's own stack (SameProcessReach): a table a closure the
// owner spawns creates is that process's, and a read in it is made from
// outside the owner, the table gone as soon as the owner restarts.
.init ets_reach = SameProcessReach

ets_reach.seed(f, f) :- ets_new(_, f, _).
ets_reach.seed(f, f) :- ets_op(_, f, _, _, "read").
ets_reach.seed(f, f) :- named_read(_, f, _).

.decl owner_reaches(mod: symbol, func: symbol)

owner_reaches(mod, t) :- process_entry(mod, c), ets_reach.reaches(c, t).

// :ets.info/1,2 answers :undefined for a table that is gone; it is how a
// reader asks, not a read that raises (ets_answers_missing_table,
// clientlib/effect_model.dl).
.decl raising_read(site: symbol)

raising_read(site) :- ets_op(site, _, _, op, "read"), !ets_answers_missing_table(op).

// A rescue that catches the ArgumentError a missing table raises, around
// the read itself (site_rescues_argument_error, in exceptions.dl): a
// rescue around unrelated code elsewhere in the reader does not take it,
// as ets_missing_row learned (9406a24). A read in a closure is rescued
// where the closure is handed to a call a rescue covers, in its builder
// or any function enclosing it, or to a function that rescues around
// what it runs (a rescuing wrapper). A read through a caller's literal
// (named_read's second clause) has no site in the caller, and asks the
// caller's function as a whole (quiet).
.decl read_rescued(site: symbol, func: symbol)

read_rescued(site, g) :- ets_op(site, g, _, _, _), site_rescues_argument_error(site, g).

read_rescued(site, g) :-
  ets_op(site, g, _, _, _),
  enclosing_function(g, a),
  closure_def(b, a),
  fun_handed(call, b, a, _),
  site_rescues_argument_error(call, b).

read_rescued(site, g) :-
  ets_op(site, g, _, _, _),
  enclosing_function(g, a),
  closure_def(b, a),
  fun_handed_to(b, a, t),
  rescues_argument_error(t).

.decl caller_rescues(func: symbol)

caller_rescues(f) :- rescues_argument_error(f).

// A reader that asks `:ets.whereis/1` of the table before reading it
// (hackney's HTTP/3 connection table, Sentry's dedupe) reads only while
// the table is there. Asked of the reader's function, as the rescue is;
// the window between the question and the read is left.
.decl asks_before_reading(func: symbol, name: symbol)

asks_before_reading(g, name) :- enclosing_function(g, a), ets_op(_, a, name, "whereis", _).

.decl ets_read_outside_owner(name: symbol, owner: symbol, reader: symbol, site: symbol, created: symbol)
.output ets_read_outside_owner

// A read through a helper that takes the table as a parameter
// (`defp fetch(table, key), do: :ets.lookup(table, key)`): the name is
// the literal a caller passes, possibly forwarded through more than one
// parameter. The caller passing the literal is the reader that matters —
// it is the API someone calls — and the site stays the lookup.
.decl table_param(func: symbol, pos: number, site: symbol)

table_param(reader, pos, site) :-
  ets_op(site, reader, "dynamic", _, "read"),
  raising_read(site),
  ets_op_param(site, pos).

table_param(f, p, site) :-
  call_arg_forward(f, g, q, p),
  table_param(g, q, site).

.decl named_read(name: symbol, reader: symbol, site: symbol)

named_read(name, reader, site) :-
  ets_op(site, reader, name, _, "read"),
  name != "dynamic",
  raising_read(site).

named_read(name, caller, site) :-
  call_arg(caller, g, q, name),
  table_param(g, q, site).

ets_read_outside_owner(name, owner, reader, site, id) :-
  ets_new(id, creator, name),
  name != "dynamic",
  function_def(creator, owner, _, _, _),
  owner_reaches(owner, creator),
  !ets_option(id, "heir", "true"),
  named_read(name, reader, site),
  !owner_reaches(owner, reader),
  !read_guarded(reader, site),
  !asks_before_reading(reader, name).

// The read at `site`, made by (or through a literal passed by) `reader`,
// is rescued.
.decl read_guarded(reader: symbol, site: symbol)

read_guarded(reader, site) :- named_read(_, reader, site), read_rescued(site, reader).

read_guarded(reader, site) :-
  named_read(_, reader, site),
  !ets_op(site, reader, _, _, _),
  caller_rescues(reader).

// A table under a name computed at runtime: only the owner's own API
// can be tied to it.
ets_read_outside_owner("dynamic", owner, reader, site, id) :-
  ets_new(id, creator, "dynamic"),
  function_def(creator, owner, _, _, _),
  owner_reaches(owner, creator),
  !ets_option(id, "heir", "true"),
  ets_op(site, reader, "dynamic", _, "read"),
  raising_read(site),
  function_def(reader, owner, _, _, _),
  !owner_reaches(owner, reader),
  !read_rescued(site, reader).

// ── A named table a start function creates ─────────────────────────
//
// A server's `start_link` runs in whoever starts the server — its
// supervisor, when the server is a child — not in the server: only the
// callbacks the start leads to run in the new process. A named table
// `start_link` creates belongs to that caller. It outlives the server's
// crash, and the restart, which calls `start_link` again in the same
// supervisor, raises ArgumentError on the `:ets.new/2` of a name that is
// still taken: the child cannot restart, and its supervisor retries until
// its intensity is spent and exits (ex_uid2's Dsp moved the call into
// init/1; blockscout's ContractCreator and policr-mini's UpdatesPoller
// guarded it with `:ets.whereis/1`; joken_jwks#40 reported the crash).
//
// A start function is a process module's `start_link` that starts a
// server itself (a GenServer, gen_statem, GenStage, Agent or Supervisor
// start). The table is made on its own stack (SameProcessReach, so not in
// what it spawns), and none of the module's own callbacks, init/1
// included, make the same table: those run in the server. Not judged: a
// start function that asks first (`:ets.whereis/1` or `:ets.info/1`, in
// the function that creates the table or in the start function), one that
// rescues the ArgumentError at the call, one that gives the table away
// (`:ets.give_away/3`), an unnamed table (a second one does not collide),
// and a module whose child spec says `restart: :temporary` (never
// restarted). A start function the program's own supervisors never call
// is still judged: a library's server is started by its users'.
.decl starts_server_api(mod: symbol, func: symbol)

starts_server_api("GenServer", "start_link").
starts_server_api("GenServer", "start").
starts_server_api(":gen_server", "start_link").
starts_server_api(":gen_server", "start").
starts_server_api(":gen_statem", "start_link").
starts_server_api(":gen_statem", "start").
starts_server_api("GenStateMachine", "start_link").
starts_server_api("GenStage", "start_link").
starts_server_api("Agent", "start_link").
starts_server_api("Supervisor", "start_link").
starts_server_api(":supervisor", "start_link").

.decl server_start_function(mod: symbol, start: symbol)

server_start_function(m, s) :-
  function_def(s, m, "start_link", _, 1),
  process_behaviour_module(m),
  remote_call(_, s, api, op, _),
  starts_server_api(api, op),
  !child_spec_restart(m, "temporary").

.init start_side = SameProcessReach

start_side.seed(f, f) :- ets_new(n, f, _), ets_option(n, "named_table", "true").

// The module's own process makes it: init/1 or a callback reaches it.
.decl made_by_server(site: symbol, mod: symbol)

made_by_server(n, m) :-
  ets_new(n, f, _),
  process_entry(m, c),
  start_side.reaches(c, f).

.decl asks_first(func: symbol)

asks_first(f) :- ets_op(_, f, _, op, _), (op = "whereis" ; op = "info").

.decl gives_table_away(func: symbol)

gives_table_away(f) :- ets_op(_, f, _, "give_away", _).

.decl ets_created_in_start(name: symbol, mod: symbol, site: symbol, start: symbol)
.output ets_created_in_start

ets_created_in_start(name, m, n, s) :-
  server_start_function(m, s),
  start_side.reaches(s, f),
  ets_new(n, f, name),
  ets_option(n, "named_table", "true"),
  !made_by_server(n, m),
  !asks_first(f),
  !asks_first(s),
  !gives_table_away(f),
  !gives_table_away(s),
  !site_rescues_argument_error(n, f).
