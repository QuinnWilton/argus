// A monitor whose {:DOWN, ...} nobody is waiting for any more.
//
// `Process.monitor/1` is a promise the runtime keeps: a
// {:DOWN, ref, :process, object, reason} WILL arrive unless cancelled.
// Waiting for it in a `receive` with an `after` clause means the wait can
// end without the message. The monitor is still live, so the message
// arrives later — into a callback that has moved on, in a state where the
// reason no longer means anything.
//
// `Process.demonitor(ref)` does not fix it: a {:DOWN, ...} already sent
// stays in the mailbox. Only `Process.demonitor(ref, [:flush])` removes it.
// That is why the flush option is a separate fact rather than a detail.
//
// The timeout is the whole discriminator. A `receive` with no `after`
// consumes either the reply or the {:DOWN, ...} and cannot leak; every
// monitor-plus-receive in Livebook is that shape and none is reported.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"

// Over calls that stay on this process's stack: a closure may run
// anywhere, so an edge into one does not count.
.init timed_wait = SameProcessReachSet

timed_wait.seed(func) :- timed_receive(func).

.init flush = SameProcessReachSet

flush.seed(func) :- demonitor_call(_, func, "flush").

.decl leaked_monitor(func: symbol, id: symbol)
.output leaked_monitor

leaked_monitor(func, id) :-
  monitor_call(id, func, _),
  timed_wait.reaches(func),
  !flush.reaches(func).

// Runs on the server's own stack: a callback, a statem state function,
// or what those reach without leaving the module.
.init server_reach = ForwardIntraModuleReach

server_reach.root(mod, func) :-
  otp_callback(func, mod, _, _).

server_reach.root(mod, func) :-
  statem_process(mod),
  statem_state(mod, _, func),
  function_def(func, mod, _, _, _).

.decl server_side(mod: symbol, func: symbol)

server_side(mod, func) :- server_reach.reaches(mod, func).

.decl module_demonitors(mod: symbol)

module_demonitors(mod) :-
  demonitor_call(_, f, _),
  function_def(f, mod, _, _, _).

// Removing an entry from a map, set, keyword or ETS table (removal_api,
// in effects.dl) — the bookkeeping paths a monitor's release belongs
// on. Anywhere in the module: Phoenix PubSub's Local removed
// subscriptions from a public table in its client API, and the monitor
// taken in handle_call stayed live all the same.

.decl removes_entries(mod: symbol)

removes_entries(mod) :-
  function_def(f, mod, _, _, _),
  remote_call(_, f, m, op, _),
  removal_api(m, op).

.decl monitor_never_released(mod: symbol, site: symbol)
.output monitor_never_released

monitor_never_released(mod, site) :-
  server_side(mod, f),
  monitor_call(site, f, _),
  !monitor_ref_dropped(site, f),
  removes_entries(mod),
  !module_demonitors(mod).


// ── A monitor whose ref is thrown away ───────────────────────────────
//
// `Process.monitor(pid)` with the result discarded, in a server's
// callbacks: the monitor can only ever end with the monitored process,
// since nothing holds what a demonitor would need. Phoenix PubSub's
// Local did this for every subscriber and removed subscriptions from a
// table in another module; every unsubscribe left a monitor behind.
// Reported separately from monitor_never_released because it needs no
// removal path in evidence — the ref being gone is the whole story.
.decl monitor_ref_discarded(mod: symbol, site: symbol)
.output monitor_ref_discarded

monitor_ref_discarded(mod, site) :-
  server_side(mod, f),
  monitor_call(site, f, _),
  monitor_ref_dropped(site, f).
