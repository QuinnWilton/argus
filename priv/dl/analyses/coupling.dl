// Two owners of one relationship across supervisor branches.
//
// A supervisor restarts what it owns: the restarted child starts from
// what its init/1 makes, without what a sibling put into it (a hook, a
// subscription, a monitor, a row: clientlib/restart_state.dl), and a
// sibling that cached its pid keeps a dead one. The sibling is not
// restarted with it. The strategy decides: under one_for_one the caller
// survives the callee's restart, under rest_for_one an earlier child
// survives a later one's, and a child a process both starts under a
// supervisor and restarts from its own :DOWN handler has two restart
// authorities.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/signals.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/tooling.dl"
.include "../clientlib/restart_state.dl"
.include "../clientlib/answers.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ══ A registration a sibling's restart loses ═══════════════════════
//
// docs/design/restart-state.md is the model.

// Two children a one_for_one supervisor restarts apart, one of which
// registered with the other while starting: when the keeper restarts
// alone its init/1 builds afresh without the registration, and the
// registrant, not restarted, never makes it again.
.decl lost_registration(sup: symbol, caller: symbol, keeper: symbol)

lost_registration(sup, caller, keeper) :-
  restarted_apart(sup, caller, keeper),
  registers_with(caller, keeper),
  !only_own_instances(caller, keeper),
  !linked(caller, keeper).

// sup is a one_for_one supervisor and the two modules sit in different
// branches of it, so the restart of one leaves the other running.
.decl restarted_apart(sup: symbol, a: symbol, b: symbol) inline

restarted_apart(sup, a, b) :-
  supervisor(sup, "one_for_one"),
  child_subtree(sup, a_branch, a),
  child_subtree(sup, b_branch, b),
  a_branch != b_branch.

// The caller's once code — init/1 and what runs on its stack before it
// serves, a handle_continue/2 — made a request the keeper keeps: an ETS
// row, a monitor, a state field, its process dictionary, or code outside
// the program it hands the request to (holds_in,
// clientlib/restart_state.dl). A call made on each use is not one: the
// next call reaches the new process by name and nothing is lost that the
// caller holds. When the caller restarts alone it registers again beside
// its old incarnation's registration.
.decl registers_with(caller: symbol, keeper: symbol) inline

registers_with(caller, keeper) :- holds_in(caller, keeper, _, _, _, _).

// Every resolved call `from` makes to `to`'s module goes to an instance
// it started for itself (private_module_dep, calls.dl): a supervisor
// restarting its child does not touch the one a sibling keeps.
.decl only_own_instances(from: symbol, to: symbol)

only_own_instances(from, to) :- private_module_dep(from, to).

// The two modules' processes are linked, one way or the other: an exit
// propagates through the link and both restart together.
.decl linked(a: symbol, b: symbol)

linked(a, b) :- links_to(a, b).
linked(a, b) :- links_to(b, a).

// `from` links to `to`: a link the extractor names, a supervisor's link
// to its child, or a link to a pid the extractor could not name
// ("dynamic") that the points-to analysis follows to a server started
// with `to`'s callbacks.
.decl links_to(from: symbol, to: symbol)

links_to(from, to) :- process_link(from, to).
links_to(sup, child) :- supervisor_child(sup, _, child, _, _).

links_to(from, to) :-
  signal_target(_, func, "link", pid),
  function_def(func, from, _, _, _),
  server_process(pid, to).

// Where the caller registers: the step of its once phase that makes the
// request or leads to it (once_step, runs.dl). The phase runs at its own
// level in a start callback and at the sites of the phase (a
// handle_continue/2 clause init/1 continues to): a request made there is
// its own step, and one made below it — in a helper of the caller's, or
// in the keeper's client API the phase calls (eusapia's Sonar calling
// `Notifier.listen(server, channel)` from handle_continue/2, ejabberd's
// acl:init/1 calling ejabberd_hooks:add/4) — is the phase's call that
// leads to it. The step is the caller's own code, never the keeper's:
// the finding shows where the caller, starting, registers. The walk
// back from the request takes the edges once_code's walk takes.
.init once_path = SameProcessReachCut

once_path.cut(f, g) :- side_call(f, g).
once_path.seed(g, g) :- holds_in(_, _, g, _, _, _).

.decl step_site(caller: symbol, keeper: symbol, site: symbol, how: symbol, store: symbol)

step_site(caller, keeper, site, how, store) :-
  lost_registration(_, caller, keeper),
  holds_in(caller, keeper, func, tag, how, store),
  start_callback(caller, func),
  request_site(func, site, keeper, tag).

step_site(caller, keeper, site, how, store) :-
  lost_registration(_, caller, keeper),
  holds_in(caller, keeper, func, tag, how, store),
  once_phase_site(caller, func, site),
  request_site(func, site, keeper, tag).

step_site(caller, keeper, step, how, store) :-
  lost_registration(_, caller, keeper),
  holds_in(caller, keeper, func, _, how, store),
  once_step(caller, _, step, callee),
  once_path.reaches(callee, func).

// The instruction of func that makes the request to mod's process, a
// call's or a cast's, with the tag it carries.
.decl request_site(func: symbol, site: symbol, mod: symbol, tag: symbol)

request_site(func, site, mod, tag) :- sync_request_at(func, site, mod, tag), site != "".
request_site(func, site, mod, tag) :- async_request_at(func, site, mod, tag), site != "".

.decl stepped(caller: symbol, keeper: symbol, how: symbol)

stepped(caller, keeper, how) :- step_site(caller, keeper, _, how, _).

.decl holds_site(caller: symbol, keeper: symbol, site: symbol, how: symbol, store: symbol)

holds_site(caller, keeper, site, how, store) :- step_site(caller, keeper, site, how, store).

// No step of the keeping has an instruction (a request in init/1 whose
// call the facts place at no site of its own, a closure init/1 builds
// and keeps): the start callback that reaches the request. Every keeping
// holds_in finds has a site, so the frame never decides which keeping
// the row reports (chosen_keeping).
holds_site(caller, keeper, start, how, store) :-
  lost_registration(_, caller, keeper),
  holds_in(caller, keeper, func, _, how, store),
  start_callback(caller, start),
  once_path.reaches(start, func),
  !stepped(caller, keeper, how).

// ══ The one output: a child depending on a sibling ═══════════════════
//
// One relationship, three reasons it goes stale. `reason` says which,
// `detail` qualifies it:
//   restart_isolation — two branches of a one_for_one supervisor, one
//     holding something in the other; detail is how the other keeps it
//     (table, monitor, state, dict, handed), witness what keeps it (an
//     instruction or function of the keeper) and site the step of the
//     caller's once phase that makes the request or leads to it
//     (holds_site): the caller's own code.
//   restart_policy — a permanent child depends on a sibling that may
//     never come back; detail is the sibling's restart policy.
//   cached_pid — init/1 looks the sibling up by name under one_for_one
//     and the handlers call the cached pid; detail is empty.
// For the last two, `witness` is the function in the caller the
// dependency flows through and `site` the witness. Finding builders
// dedupe on (sup, caller, callee, reason). `site` anchors with
// `Findings.at_site/2` either way.
//
// `basis` says how a restart_policy dependency was established: `resolved`
// through a call or cast whose target is known, `inferred` through the
// module-level clause of stateful_module_dep alone — the caller reaches
// some function of the sibling and the sibling has a call somewhere — and
// `doubted` when that inference is all there is and a prior
// (Argus.Priors, off by default) puts the sibling's API at 0.3 or below
// for messaging a process: a helper with a call in its start_link, not a
// facade. The finding steps down a severity for a doubted row; `permille`
// is the prior's probability that the module does talk to a process. A
// restart_isolation row is always resolved: the request the keeper keeps
// is known.
.decl dep_resolved(from: symbol, to: symbol)

dep_resolved(f, t) :- module_sync_dep(f, t, _).

dep_resolved(f, t) :-
  function_def(w, f, _, _, _),
  reaches_async_dep(w, t),
  f != t.

.decl dep_doubted(from: symbol, to: symbol, permille: number)

dep_doubted(f, t, p) :-
  stateful_module_dep(f, t, _),
  !dep_resolved(f, t),
  prior_talks_to_process(t, p),
  p <= 300.

.decl dep_basis(from: symbol, to: symbol, basis: symbol, permille: number)

dep_basis(f, t, "resolved", 0) :- dep_resolved(f, t).
dep_basis(f, t, "doubted", p) :- dep_doubted(f, t, p).

dep_basis(f, t, "inferred", 0) :-
  stateful_module_dep(f, t, _),
  !dep_resolved(f, t),
  !dep_doubted(f, t, _).

.decl sibling_dependency(sup: symbol, caller: symbol, callee: symbol, reason: symbol, detail: symbol, sup_site: symbol, witness: symbol, site: symbol, basis: symbol, permille: number)
.output sibling_dependency

// A supervisor with no site of its own is not reported. What the keeper
// does with code outside the program is inferred, and the row says so; a
// keeping the program shows is preferred to it.
sibling_dependency(sup, caller, keeper, "restart_isolation", how, sup_site, store, site, basis, 0) :-
  lost_registration(sup, caller, keeper),
  supervisor_site(sup, sup_site),
  chosen_keeping(caller, keeper, how),
  holds_site(caller, keeper, site, how, store),
  keeping_basis(how, basis).

.decl chosen_keeping(caller: symbol, keeper: symbol, how: symbol)

chosen_keeping(caller, keeper, how) :-
  holds_site(caller, keeper, _, how, _),
  keeping_basis(how, "resolved").

chosen_keeping(caller, keeper, "handed") :-
  holds_site(caller, keeper, _, "handed", _),
  !shown_keeping(caller, keeper).

.decl shown_keeping(caller: symbol, keeper: symbol)

shown_keeping(caller, keeper) :-
  holds_site(caller, keeper, _, how, _),
  keeping_basis(how, "resolved").

.decl keeping_basis(how: symbol, basis: symbol)

keeping_basis("table", "resolved").
keeping_basis("monitor", "resolved").
keeping_basis("state", "resolved").
keeping_basis("dict", "resolved").
keeping_basis("handed", "inferred").

// ══ A permanent child depending on a sibling that may not come back ═
//
// A transient child that stops normally is never restarted, and a
// temporary child is never restarted at all — strictly worse. One row
// per witness — finding builders dedupe on (sup, permanent, sibling).

// A permanent child depends on a sibling whose restart policy can leave
// it down, and keeps running against a process that no longer exists.
.decl dependency_on_unrestarted_sibling(sup: symbol, child: symbol, sibling: symbol, restart: symbol, witness: symbol)

dependency_on_unrestarted_sibling(sup, child, sibling, restart, witness) :-
  restart_policy(sup, child, "permanent"),
  may_stay_down(sup, sibling, restart),
  depends_on(child, sibling, witness),
  !teardown_only(witness),
  !only_own_instances(child, sibling).

// The witness runs only as its process ends: it is a terminate/2, or
// nothing reaches it but a terminate/2. A process whose sole use of a
// sibling is in its own teardown does not keep running against it: it
// is going away when it asks (thousand_island's ShutdownListener stops
// its transient Listener from terminate/2, which is why the Listener is
// transient; phoenix_pubsub's Tracker.ShutdownHandler drains its shards
// the same way). The witness runs outside teardown when a root other
// than terminate/2 reaches it: a function with no caller in view (a
// callback, an exported API function, one only a dependency calls). A
// closure is reached from where it is built (call_edge follows closure
// construction), so one built in terminate/2 is teardown too. Known
// limit: a function called only from a cycle of its own module's
// functions that nothing enters is read as teardown.
.decl teardown_only(witness: symbol)

teardown_only(w) :-
  sibling_witness(w),
  !runs_outside_teardown(w).

.decl sibling_witness(witness: symbol)

sibling_witness(w) :-
  restart_policy(sup, child, "permanent"),
  may_stay_down(sup, sibling, _),
  depends_on(child, sibling, w).

.init teardown_reach = CallReach

teardown_reach.seed(w, w) :- sibling_witness(w).

.decl runs_outside_teardown(witness: symbol)

runs_outside_teardown(w) :-
  teardown_reach.reaches(root, w),
  function_def(root, _, name, _, _),
  name != "terminate",
  !call_edge(_, root).

// `sibling` is a child of sup under a restart policy that can leave it
// dead (`restart`; restart_policy: its spec's, or a shorthand's own
// child_spec/1's). A start_child whose supervisor the extractor could
// not resolve ("dynamic") names no sibling.
.decl may_stay_down(sup: symbol, sibling: symbol, restart: symbol)

may_stay_down(sup, sibling, restart) :-
  restart_policy(sup, sibling, restart),
  sup != "dynamic",
  leaves_down(restart).

// A restart policy under which a child can exit and stay gone.
.decl leaves_down(restart: symbol)

leaves_down("transient").
leaves_down("temporary").

// A function of `from` (`witness`) depends on `to`'s process, through a
// call, a cast, or a reach to `to`'s module that makes a call somewhere
// (stateful_module_dep, calls.dl; how is `basis`).
.decl depends_on(from: symbol, to: symbol, witness: symbol) inline

depends_on(from, to, witness) :- stateful_module_dep(from, to, witness).

// A supervisor with no site of its own is not reported.
sibling_dependency(sup, child, sibling, "restart_policy", restart, sup_site, witness, witness, basis, permille) :-
  dependency_on_unrestarted_sibling(sup, child, sibling, restart, witness),
  supervisor_site(sup, sup_site),
  dep_basis(child, sibling, basis, permille).

// ── A sibling's pid cached in init/1 under one_for_one ───────────────
//
// k8s 99c05d6 replaced such pids with :via names; oban#1413 and #1499
// are the inverse, registrations made with a sibling that its restart
// forgets. :rest_for_one and :one_for_all restart the holder too.

// init/1 looks a sibling up by name and keeps the pid, and a handler
// calls it: under one_for_one the sibling restarts alone and the cached
// pid is a dead process from then on — every call :noproc, every send
// lost.
.decl cached_sibling_pid(sup: symbol, mod: symbol, name: symbol, init: symbol)

cached_sibling_pid(sup, mod, name, init) :-
  caches_pid(mod, init, name),
  sibling_restarts_alone(sup, mod, name),
  handler_calls_cached_pid(mod, name).

// mod's init/1 looks up the process registered under a literal `name`
// (whereis).
.decl caches_pid(mod: symbol, init: symbol, name: symbol)

caches_pid(mod, init, name) :-
  init_function(mod, init),
  name_lookup(_, init, "whereis", _, "literal", name, _).

// mod is a child of a one_for_one supervisor, and so is the process
// `name` names (a child module or a child's registered name): the
// supervisor restarts that sibling without restarting mod.
.decl sibling_restarts_alone(sup: symbol, mod: symbol, name: symbol)

sibling_restarts_alone(sup, mod, name) :-
  supervisor_child(sup, _, mod, _, _),
  supervisor(sup, "one_for_one"),
  child_named(sup, name).

// `name` is a child of sup's module or registered name.
.decl child_named(sup: symbol, name: symbol)

child_named(sup, name) :- supervisor_child(sup, _, name, _, _).
child_named(sup, name) :- supervisor_child_name(sup, _, name).

// A handler of mod uses the pid rather than the name: process points-to
// follows a handler's call, cast or send to the process registered under
// the name, through anything but the name itself (a call by name each
// time is the fix). Where the name resolves to no process points-to
// knows, a handler's call to some pid it cannot follow stands in, as it
// did before points-to.
.decl handler_calls_cached_pid(mod: symbol, name: symbol)

handler_calls_cached_pid(mod, name) :-
  handler_function(mod, handler),
  process_call(handler, _, site, _, pid),
  named_pid(name, pid),
  pid_use(site, _, _, target_kind, _),
  target_kind != "name".

handler_calls_cached_pid(mod, name) :-
  caches_pid(mod, _, name),
  handler_function(mod, handler),
  !named_pid(name, _),
  calls_unknown_pid(handler).

// func calls or casts to a pid the extractor could not name.
.decl calls_unknown_pid(func: symbol)

calls_unknown_pid(func) :- sync_call(func, "dynamic").
calls_unknown_pid(func) :- async_cast(func, "dynamic").

// A supervisor with no site of its own is not reported.
sibling_dependency(sup, mod, name, "cached_pid", "", sup_site, init, init, "resolved", 0) :-
  cached_sibling_pid(sup, mod, name, init),
  supervisor_site(sup, sup_site).

// ── rest_for_one: a later child owns processes inside an earlier one ──
//
// rest_for_one restarts the crashed child and everything after it; the
// children before it keep running. That is the right shape when earlier
// children are dependencies of later ones, and exactly wrong when a later
// child starts processes inside an earlier one: Oban's producer (position
// 1) running jobs under the Task.Supervisor at position 0 left the old
// producer's jobs running beside the new producer's, duplicate
// long-running jobs and `attempt > max_attempts`. Oban's fix was
// :one_for_all.

// Under rest_for_one a later child starts processes under an earlier
// one: when the later child restarts, what it started keeps running
// under the earlier one, which is not restarted, and is started again.
.decl orphaned_children(sup: symbol, owner: symbol, owner_pos: number, holder: symbol, holder_pos: number, start: symbol, basis: symbol)

orphaned_children(sup, owner, owner_pos, holder, holder_pos, start, basis) :-
  restarts_only_later_children(sup),
  runs_in_child(sup, owner_pos, owner),
  starts_child(owner, start),
  starts_under_earlier_child(start, sup, owner_pos, holder_pos, basis),
  child_at(sup, holder_pos, holder).

// sup's strategy is rest_for_one: a child's restart restarts the
// children after it, not the ones before (shutdown's
// restarts_later_siblings also holds of one_for_all).
.decl restarts_only_later_children(sup: symbol)

restarts_only_later_children(sup) :- supervisor(sup, "rest_for_one").

// `mod` runs in the branch of sup's child at `pos`: the child or any
// module below it.
.decl runs_in_child(sup: symbol, pos: number, mod: symbol) inline

runs_in_child(sup, pos, mod) :-
  supervisor_child(sup, pos, branch, _, _),
  child_subtree(sup, branch, mod).

// A function of `owner` starts a process under a supervisor at `start`:
// a start_child, a Task.Supervisor async or async_nolink.
.decl starts_child(owner: symbol, start: symbol)

starts_child(owner, start) :-
  function_def(func, owner, _, _, _),
  sup_management_call(start, func, _, op, _),
  child_creating_op(op).

// The start puts its process under sup's child at `holder_pos`, earlier
// than `owner_pos`, and `basis` says how that is known, in
// sibling_dependency's words. `resolved`: the call names the earlier
// child's registered name.
.decl starts_under_earlier_child(start: symbol, sup: symbol, owner_pos: number, holder_pos: number, basis: symbol)

starts_under_earlier_child(start, sup, owner_pos, holder_pos, "resolved") :-
  sup_management_call(start, _, _, _, name),
  supervisor_child_name(sup, holder_pos, name),
  supervisor_child(sup, owner_pos, _, _, _),
  holder_pos < owner_pos.

// `inferred`: the call's supervisor is a pid ("dynamic"), and the earlier
// child is the only one before the owner whose module is the API called —
// a Task.Supervisor.async_nolink into an unresolvable pid, with exactly
// one Task.Supervisor started earlier under the same rest_for_one, is not
// much of an inference. Process points-to does not follow the pid: a
// supervisor management call is not a pid use (pid_call covers calls,
// casts and sends; sup_call's target is its own extractor's).
starts_under_earlier_child(start, sup, owner_pos, holder_pos, "inferred") :-
  sup_management_call(start, _, api, _, "dynamic"),
  sole_earlier_sibling_of_kind(sup, holder_pos, api, owner_pos).

// sup's child at `pos` is `mod`.
.decl child_at(sup: symbol, pos: number, mod: symbol) inline

child_at(sup, pos, mod) :- supervisor_child(sup, pos, mod, _, _).

// sup's child at `pos` runs `api`'s module and comes before the child at
// `owner_pos`.
.decl earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  supervisor_child(sup, pos, api, _, _),
  supervisor_child(sup, owner_pos, _, _, _),
  pos < owner_pos.

// ... and is the only such child before `owner_pos`.
.decl sole_earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

sole_earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  earlier_sibling_of_kind(sup, pos, api, owner_pos),
  !other_earlier_sibling_of_kind(sup, pos, api, owner_pos).

.decl other_earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

other_earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  earlier_sibling_of_kind(sup, pos, api, owner_pos),
  earlier_sibling_of_kind(sup, other, api, owner_pos),
  other != pos.

.decl rest_for_one_orphaned_children(sup: symbol, owner: symbol, holder: symbol, owner_pos: number, holder_pos: number, site: symbol, basis: symbol)
.output rest_for_one_orphaned_children

rest_for_one_orphaned_children(sup, owner, holder, owner_pos, holder_pos, start, basis) :-
  orphaned_children(sup, owner, owner_pos, holder, holder_pos, start, basis).

// ── Two restart authorities ──────────────────────────────────────────
//
// A process that starts a child under a DynamicSupervisor, monitors it,
// and starts it again from its :DOWN handler has taken over restarting —
// while the supervisor, for a :permanent child, does the same. A child
// that fails on a semantic error crash-loops under both, blows the
// supervisor's intensity and takes the tree with it (redix#334). The
// supervisor restarts the child when the start gives it a restart other
// than :temporary (dynamic_restart: the spec the start hands over, so
// redix's own fix, Supervisor.child_spec({Redix, opts}, restart:
// :temporary), is quiet, and a map spec with no :restart is permanent
// whatever the module's child_spec/1 says).
//
// The start, the monitor and the :DOWN handling are usually spread over
// private helpers (redix: start_connection/7, start_and_monitor_connection/5,
// handle_down/2), so each is asked of a function's reach within its own
// module. The monitor must be OF the started child — the pid a
// supervisor start returned — not of some other process the module
// watches (Oban.Queues monitors its notifier and restarts queues from a
// signal: two facts about two processes, not two restart authorities).
// The :DOWN handler is whichever function of the module matches :DOWN
// (matches_down): handle_info/2 for a GenServer, a private helper its
// state functions' catch-alls dispatch to for a gen_statem.
//
// Walked back from the only targets these rules ask about — the functions
// that start a dynamic child and the ones that monitor what they started
// — rather than closed over every function of the program: seeded at every
// function, the closure held every intra-module path (6.1M rows from 43k
// edges on a deps tree) to answer questions about a handful.
.init module_reach = IntraModuleReach

module_reach.seed(s, s) :- dynamic_child(_, _, s).
module_reach.seed(m, m) :- monitors_started_child(_, m).

// A process starts a child under a DynamicSupervisor that will restart
// it, monitors it, and starts it again from its :DOWN handler: two
// restart authorities for one child.
.decl two_restart_authorities(mod: symbol, sup: symbol, child: symbol, via: symbol, handler: symbol)

two_restart_authorities(mod, sup, child, via, handler) :-
  starts_and_monitors(mod, sup, child, via),
  down_handler(mod, handler),
  starts_supervised_again(handler, sup, child).

// `via`, a function of mod, reaches a start of a named child under sup
// and a monitor of a child a supervisor started. Task children and
// children the extractor could not name are left out.
.decl starts_and_monitors(mod: symbol, sup: symbol, child: symbol, via: symbol)

starts_and_monitors(mod, sup, child, via) :-
  function_def(via, mod, _, _, _),
  module_reach.reaches(via, start),
  dynamic_child(sup, child, start),
  child != "dynamic",
  child != "Task",
  module_reach.reaches(via, monitor),
  monitors_started_child(_, monitor).

// A monitor of a pid a supervisor's start_child returned: on every path,
// directly or through the program's wrappers (monitor_answer and
// call_origin, clientlib/answers.dl: redix's start_connection/7 hands
// back DynamicSupervisor.start_child's answer), or a pid the points-to
// analysis follows to a process a DynamicSupervisor.start_child may have
// started.
.decl monitors_started_child(id: symbol, func: symbol)

monitors_started_child(id, func) :-
  monitor_answer(id, func, _, _),
  !monitors_other(id).

answer_demand(c, f) :- monitor_answer(_, f, c, _).

// The pid monitored at `id` may be something other than a child a
// supervisor's start_child started.
.decl monitors_other(id: symbol)

monitors_other(id) :- monitor_answer(id, _, c, _), call_opaque(c).
monitors_other(id) :- monitor_answer(id, _, c, k), call_origin(c, _, j), k + j > 1.

monitors_other(id) :-
  monitor_answer(id, _, c, _),
  call_origin(c, o, _),
  !supervisor_start_child(o).

// A supervisor's start_child, which answers the child it started.
.decl supervisor_start_child(site: symbol)

supervisor_start_child(o) :- call_site(o, _, "DynamicSupervisor", "start_child", _).
supervisor_start_child(o) :- call_site(o, _, "Supervisor", "start_child", _).

monitors_started_child(id, func) :-
  signal_target(id, func, "monitor", pid),
  instance(pid, base),
  process_start(start, _, base, _, _),
  call_site(start, _, "DynamicSupervisor", "start_child", _).

// A function of mod that handles a :DOWN message (matches_down).
.decl down_handler(mod: symbol, handler: symbol)

down_handler(mod, handler) :-
  function_def(handler, mod, _, _, _),
  matches_down(handler).

// The handler reaches a start of `child` under sup whose spec gives it
// a restart other than :temporary (dynamic_restart), so the supervisor
// restarts it too.
.decl starts_supervised_again(handler: symbol, sup: symbol, child: symbol)

starts_supervised_again(handler, sup, child) :-
  module_reach.reaches(handler, start),
  dynamic_restart(sup, child, start, restart),
  restart != "temporary".

.decl dual_restart_authority(mod: symbol, sup: symbol, child: symbol, via: symbol, start_site: symbol, monitor_site: symbol, handler: symbol)
.output dual_restart_authority

dual_restart_authority(mod, sup, child, via, start_site, monitor_site, handler) :-
  two_restart_authorities(mod, sup, child, via, handler),
  start_site_of(via, sup, child, start_site),
  monitor_site_of(via, monitor_site).

// The start_child call `via` reaches for this child, and the monitor it
// reaches; empty when the function is known but not the instruction.
.decl start_site_of(via: symbol, sup: symbol, child: symbol, site: symbol)

start_site_of(via, sup, child, id) :-
  starts_and_monitors(_, sup, child, via),
  module_reach.reaches(via, s),
  dynamic_child(sup, child, s),
  call_site(id, s, "DynamicSupervisor", "start_child", _).

start_site_of(via, sup, child, "") :-
  starts_and_monitors(_, sup, child, via),
  !start_site_of_known(via, sup, child).

.decl start_site_of_known(via: symbol, sup: symbol, child: symbol)

start_site_of_known(via, sup, child) :-
  starts_and_monitors(_, sup, child, via),
  module_reach.reaches(via, s),
  dynamic_child(sup, child, s),
  call_site(_, s, "DynamicSupervisor", "start_child", _).

.decl monitor_site_of(via: symbol, site: symbol)

monitor_site_of(via, id) :-
  starts_and_monitors(_, _, _, via),
  module_reach.reaches(via, m),
  monitors_started_child(id, m).
