// Relationships that become stale across supervisor branches: registrations lost on
// restart, cached pids, incompatible restart policies, and competing restart
// authorities. one_for_one preserves siblings; rest_for_one preserves earlier children.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/signals.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/tooling.dl"
.include "../clientlib/restart_state.dl"
.include "../clientlib/answers.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ══ A registration a sibling's restart loses ═══════════════════════
//
// docs/analyses/coupling.md#restart-isolation is the model.

// A one_for_one sibling registers during startup. If the registration holder restarts
// alone, it loses the registration and the surviving sibling does not register again.
.decl lost_registration(sup: symbol, caller: symbol, keeper: symbol)

lost_registration(sup, caller, keeper) :-
  restarted_apart(sup, caller, keeper),
  registers_with(caller, keeper),
  !only_own_instances(caller, keeper),
  !linked(caller, keeper).

// sup is a one_for_one supervisor and the two modules sit in different
// branches of it, so the restart of one leaves the other running.
.decl restarted_apart(sup: symbol, a: symbol, b: symbol)

restarted_apart(sup, a, b) :-
  supervisor(sup, "one_for_one"),
  child_subtree(sup, a_branch, a),
  child_subtree(sup, b_branch, b),
  a_branch != b_branch.

// A request made during the caller's once phase that the keeper stores in a table,
// monitor, state, dictionary, or external code (`holds_in`). Per-use requests are
// excluded. Restarting either side alone can lose the relationship or leave an old
// registration.
.decl registers_with(caller: symbol, keeper: symbol)

registers_with(caller, keeper) :- holds_in(caller, keeper, _, _, _, _).

// All resolved calls from `from` to `to` use privately started instances
// (private_module_dep). Restarting the supervisor's instance does not affect them.
.decl only_own_instances(from: symbol, to: symbol)

only_own_instances(from, to) :- private_module_dep(from, to).

// The two modules' processes are linked, one way or the other: an exit
// propagates through the link and both restart together.
.decl linked(a: symbol, b: symbol)

linked(a, b) :- links_to(a, b).
linked(a, b) :- links_to(b, a).

// Links from `from` to `to`: explicit links, supervisor-child links, or dynamic PID
// links resolved by points-to analysis.
.decl links_to(from: symbol, to: symbol)

links_to(from, to) :- process_link(from, to).
links_to(sup, child) :- supervisor_child(sup, _, child, _, _).

links_to(from, to) :-
  signal_target(_, func, "link", pid),
  function_def(func, from, _, _, _),
  server_process(pid, to).

// The caller's once-phase step that registers with the keeper, directly or through
// helpers/client APIs. Anchor in the caller's startup or continuation code. The
// backward traversal uses the same edges as `once_code`.
.init once_path = SameProcessReachCut

once_path.cut(f, g) :- side_call(f, g).
once_path.seed(g, g) :- holds_in(_, _, g, _, _, _).

.decl step_site(caller: symbol, keeper: symbol, site: symbol, how: symbol, store: symbol)

step_site(caller, keeper, site, how, store) :-
  lost_registration(_, caller, keeper),
  holds_in(caller, keeper, func, tag, how, store),
  start_callback(caller, func),
  request_site(func, site, keeper, tag).

step_site(caller, keeper, site, how, store) :-
  lost_registration(_, caller, keeper),
  holds_in(caller, keeper, func, tag, how, store),
  once_phase_site(caller, func, site),
  request_site(func, site, keeper, tag).

step_site(caller, keeper, step, how, store) :-
  lost_registration(_, caller, keeper),
  holds_in(caller, keeper, func, _, how, store),
  once_step(caller, _, step, callee),
  once_path.reaches(callee, func).

// The instruction of func that makes the request to mod's process, a
// call's or a cast's, with the tag it carries.
.decl request_site(func: symbol, site: symbol, mod: symbol, tag: symbol)

request_site(func, site, mod, tag) :- sync_request_at(func, site, mod, tag), site != "".
request_site(func, site, mod, tag) :- async_request_at(func, site, mod, tag), site != "".

.decl stepped(caller: symbol, keeper: symbol, how: symbol)

stepped(caller, keeper, how) :- step_site(caller, keeper, _, how, _).

.decl holds_site(caller: symbol, keeper: symbol, site: symbol, how: symbol, store: symbol)

holds_site(caller, keeper, site, how, store) :- step_site(caller, keeper, site, how, store).

// If no once-phase call instruction anchors the request, use the reaching start
// callback. Every holds_in result retains an anchor; anchor selection does not choose
// the stored relationship.
holds_site(caller, keeper, start, how, store) :-
  lost_registration(_, caller, keeper),
  holds_in(caller, keeper, func, _, how, store),
  start_callback(caller, start),
  once_path.reaches(start, func),
  !stepped(caller, keeper, how).

// Sibling dependency output
// `restart_isolation`: one_for_one branches with a stored relationship. Detail
// identifies storage kind; witness identifies the keeper's storage; site identifies the
// caller's once-phase request.
// `restart_policy`: a permanent child depends on a sibling that may not restart. Detail
// is that sibling's policy.
// `cached_pid`: init caches a named sibling's pid and handlers use it under
// one_for_one. Detail is empty.
// For the last two, witness and site identify the caller function. Findings deduplicate
// by (sup, caller, callee, reason).
// `basis` is `resolved` for known call/cast targets, `inferred` for module-level
// dependencies, or `doubted` when only that inference exists and the process-role prior
// is at most 0.3. Doubted findings have lower severity; `permille` retains confidence.
// Restart-isolation rows are always resolved.
.decl dep_resolved(from: symbol, to: symbol)

dep_resolved(f, t) :- module_sync_dep(f, t, _).

dep_resolved(f, t) :-
  function_def(w, f, _, _, _),
  reaches_async_dep(w, t),
  f != t.

.decl dep_doubted(from: symbol, to: symbol, permille: number)

dep_doubted(f, t, p) :-
  stateful_module_dep(f, t, _),
  !dep_resolved(f, t),
  prior_talks_to_process(t, p),
  p <= 300.

.decl dep_basis(from: symbol, to: symbol, basis: symbol, permille: number)

dep_basis(f, t, "resolved", 0) :- dep_resolved(f, t).
dep_basis(f, t, "doubted", p) :- dep_doubted(f, t, p).

dep_basis(f, t, "inferred", 0) :-
  stateful_module_dep(f, t, _),
  !dep_resolved(f, t),
  !dep_doubted(f, t, _).

.decl sibling_dependency(sup: symbol, caller: symbol, callee: symbol, reason: symbol, detail: symbol, sup_site: symbol, witness: symbol, site: symbol, basis: symbol, permille: number)
.output sibling_dependency

// Require a source site for the supervisor. Mark retention inferred from external code,
// preferring direct program evidence when available.
sibling_dependency(sup, caller, keeper, "restart_isolation", how, sup_site, store, site, basis, 0) :-
  lost_registration(sup, caller, keeper),
  supervisor_site(sup, sup_site),
  chosen_keeping(caller, keeper, how),
  holds_site(caller, keeper, site, how, store),
  keeping_basis(how, basis).

.decl chosen_keeping(caller: symbol, keeper: symbol, how: symbol)

chosen_keeping(caller, keeper, how) :-
  holds_site(caller, keeper, _, how, _),
  keeping_basis(how, "resolved").

chosen_keeping(caller, keeper, "handed") :-
  holds_site(caller, keeper, _, "handed", _),
  !shown_keeping(caller, keeper).

.decl shown_keeping(caller: symbol, keeper: symbol)

shown_keeping(caller, keeper) :-
  holds_site(caller, keeper, _, how, _),
  keeping_basis(how, "resolved").

.decl keeping_basis(how: symbol, basis: symbol)

keeping_basis("table", "resolved").
keeping_basis("monitor", "resolved").
keeping_basis("state", "resolved").
keeping_basis("dict", "resolved").
keeping_basis("handed", "inferred").

// Permanent children depending on non-restarting siblings
//
// Transient children do not restart after normal stops; temporary children never
// restart. Keep witnesses and deduplicate by supervisor, permanent child, and sibling.

// A permanent child depends on a sibling whose restart policy can leave
// it down, and keeps running against a process that no longer exists.
.decl dependency_on_unrestarted_sibling(sup: symbol, child: symbol, sibling: symbol, restart: symbol, witness: symbol)

dependency_on_unrestarted_sibling(sup, child, sibling, restart, witness) :-
  restart_policy(sup, child, "permanent"),
  may_stay_down(sup, sibling, restart),
  stateful_module_dep(child, sibling, witness),
  !teardown_only(witness),
  !only_own_instances(child, sibling).

// A witness reached only from terminate/2, including closures built there.
// Teardown-only use does not create an ongoing sibling dependency. Any other visible
// root disqualifies it. Known limit: an unreachable intra-module cycle may also be
// classified as teardown-only.
.decl teardown_only(witness: symbol)

teardown_only(w) :-
  sibling_witness(w),
  !runs_outside_teardown(w).

.decl sibling_witness(witness: symbol)

sibling_witness(w) :-
  restart_policy(sup, child, "permanent"),
  may_stay_down(sup, sibling, _),
  stateful_module_dep(child, sibling, w).

.init teardown_reach = CallReach

teardown_reach.seed(w, w) :- sibling_witness(w).

.decl runs_outside_teardown(witness: symbol)

runs_outside_teardown(w) :-
  teardown_reach.reaches(root, w),
  function_def(root, _, name, _, _),
  name != "terminate",
  !call_edge(_, root).

// A child whose restart policy may leave it stopped. Unresolved start_child targets do
// not identify a sibling.
.decl may_stay_down(sup: symbol, sibling: symbol, restart: symbol)

may_stay_down(sup, sibling, restart) :-
  restart_policy(sup, sibling, restart),
  sup != "dynamic",
  leaves_down(restart).

// A restart policy under which a child can exit and stay gone.
.decl leaves_down(restart: symbol)

leaves_down("transient").
leaves_down("temporary").

// A supervisor with no site of its own is not reported.
sibling_dependency(sup, child, sibling, "restart_policy", restart, sup_site, witness, witness, basis, permille) :-
  dependency_on_unrestarted_sibling(sup, child, sibling, restart, witness),
  supervisor_site(sup, sup_site),
  dep_basis(child, sibling, basis, permille).

// Cached sibling pids under one_for_one
//
// A restarted sibling has a new pid. Name-based calls can resolve it again;
// rest_for_one or one_for_all may instead restart the holder with it.

// Init caches a sibling's pid and handlers reuse it. Under one_for_one, the sibling can
// restart alone, leaving calls to the cached pid failing and sends undelivered.
.decl cached_sibling_pid(sup: symbol, mod: symbol, name: symbol, init: symbol)

cached_sibling_pid(sup, mod, name, init) :-
  caches_pid(mod, init, name),
  sibling_restarts_alone(sup, mod, name),
  handler_calls_cached_pid(mod, name).

// mod's init/1 looks up the process registered under a literal `name`
// (whereis).
.decl caches_pid(mod: symbol, init: symbol, name: symbol)

caches_pid(mod, init, name) :-
  init_function(mod, init),
  name_lookup(_, init, "whereis", _, "literal", name, _).

// `mod` and the process identified by `name` are one_for_one siblings. The named
// sibling can restart independently of mod.
.decl sibling_restarts_alone(sup: symbol, mod: symbol, name: symbol)

sibling_restarts_alone(sup, mod, name) :-
  supervisor_child(sup, _, mod, _, _),
  supervisor(sup, "one_for_one"),
  child_named(sup, name).

// `name` is a child of sup's module or registered name.
.decl child_named(sup: symbol, name: symbol)

child_named(sup, name) :- supervisor_child(sup, _, name, _, _).
child_named(sup, name) :- supervisor_child_name(sup, _, name).

// A handler uses a stored pid for the named process, as resolved by points-to, rather
// than looking up the name on each call. If the name has no known process, an
// unresolved pid call serves as the fallback.
.decl handler_calls_cached_pid(mod: symbol, name: symbol)

handler_calls_cached_pid(mod, name) :-
  handler_function(mod, handler),
  process_call(handler, _, site, _, pid),
  named_pid(name, pid),
  pid_use(site, _, _, target_kind, _),
  target_kind != "name".

handler_calls_cached_pid(mod, name) :-
  caches_pid(mod, _, name),
  handler_function(mod, handler),
  !named_pid(name, _),
  calls_unknown_pid(handler).

// func calls or casts to a pid the extractor could not name.
.decl calls_unknown_pid(func: symbol)

calls_unknown_pid(func) :- sync_call(func, "dynamic").
calls_unknown_pid(func) :- async_cast(func, "dynamic").

// A supervisor with no site of its own is not reported.
sibling_dependency(sup, mod, name, "cached_pid", "", sup_site, init, init, "resolved", 0) :-
  cached_sibling_pid(sup, mod, name, init),
  supervisor_site(sup, sup_site).

// rest_for_one ownership inversion
//
// A later child starts processes under an earlier sibling. Restarting the later child
// leaves its old workers alive and may create duplicates, because rest_for_one
// preserves earlier children.

// Under rest_for_one, a later child starts processes under an earlier sibling.
// Restarting the later child leaves those processes alive and starts duplicates.
.decl orphaned_children(sup: symbol, owner: symbol, owner_pos: number, holder: symbol, holder_pos: number, start: symbol, basis: symbol)

orphaned_children(sup, owner, owner_pos, holder, holder_pos, start, basis) :-
  restarts_only_later_children(sup),
  runs_in_child(sup, owner_pos, owner),
  starts_child(owner, start),
  !adopts_running_child(start),
  starts_under_earlier_child(start, sup, owner_pos, holder_pos, basis),
  child_at(sup, holder_pos, holder).

// sup's strategy is rest_for_one: a child's restart restarts the
// children after it, not the ones before (shutdown's
// restarts_later_siblings also holds of one_for_all).
.decl restarts_only_later_children(sup: symbol)

restarts_only_later_children(sup) :- supervisor(sup, "rest_for_one").

// `mod` runs in the branch of sup's child at `pos`: the child or any
// module below it.
.decl runs_in_child(sup: symbol, pos: number, mod: symbol)

runs_in_child(sup, pos, mod) :-
  supervisor_child(sup, pos, branch, _, _),
  child_subtree(sup, branch, mod).

// A function of `owner` starts a process under a supervisor at `start`:
// a start_child, a Task.Supervisor async or async_nolink.
.decl starts_child(owner: symbol, start: symbol)

starts_child(owner, start) :-
  function_def(func, owner, _, _, _),
  sup_management_call(start, func, _, op, _),
  child_creating_op(op).

// The start takes `{:error, {:already_started, pid}}` for success: the
// child is registered under a name, and a restarted owner adopts the one
// its last incarnation started instead of starting a second. The function
// making the start or its caller compares the error (start_error_compared,
// anywhere in the function, as races.dl's start_error_handled reads it).
// An anonymous child (a task, a worker without a name) is never
// already started, so its start is not one of these.
.decl adopts_running_child(start: symbol)

adopts_running_child(start) :-
  sup_management_call(start, f, _, _, _),
  start_error_compared(f, ":already_started").

adopts_running_child(start) :-
  sup_management_call(start, f, _, _, _),
  call_edge(g, f),
  start_error_compared(g, ":already_started").

// The process is started under an earlier sibling at holder_pos. `basis` uses
// sibling_dependency's evidence categories; "resolved" means a literal registered
// target.
.decl starts_under_earlier_child(start: symbol, sup: symbol, owner_pos: number, holder_pos: number, basis: symbol)

starts_under_earlier_child(start, sup, owner_pos, holder_pos, "resolved") :-
  sup_management_call(start, _, _, _, name),
  supervisor_child_name(sup, holder_pos, name),
  supervisor_child(sup, owner_pos, _, _, _),
  holder_pos < owner_pos.

// Infer the holder when the management-call target is dynamic and exactly one earlier
// sibling matches the supervisor API. Supervisor management calls are not represented
// by `process_call_source`, so points-to cannot resolve this pid.
starts_under_earlier_child(start, sup, owner_pos, holder_pos, "inferred") :-
  sup_management_call(start, _, api, _, "dynamic"),
  sole_earlier_sibling_of_kind(sup, holder_pos, api, owner_pos).

// sup's child at `pos` is `mod`.
.decl child_at(sup: symbol, pos: number, mod: symbol)

child_at(sup, pos, mod) :- supervisor_child(sup, pos, mod, _, _).

// sup's child at `pos` runs `api`'s module and comes before the child at
// `owner_pos`.
.decl earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  supervisor_child(sup, pos, api, _, _),
  supervisor_child(sup, owner_pos, _, _, _),
  pos < owner_pos.

// ... and is the only such child before `owner_pos`.
.decl sole_earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

sole_earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  earlier_sibling_of_kind(sup, pos, api, owner_pos),
  !other_earlier_sibling_of_kind(sup, pos, api, owner_pos).

.decl other_earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

other_earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  earlier_sibling_of_kind(sup, pos, api, owner_pos),
  earlier_sibling_of_kind(sup, other, api, owner_pos),
  other != pos.

.decl rest_for_one_orphaned_children(sup: symbol, owner: symbol, holder: symbol, owner_pos: number, holder_pos: number, site: symbol, basis: symbol)
.output rest_for_one_orphaned_children

rest_for_one_orphaned_children(sup, owner, holder, owner_pos, holder_pos, start, basis) :-
  orphaned_children(sup, owner, owner_pos, holder, holder_pos, start, basis).

// Competing restart authorities
//
// A process starts and monitors a DynamicSupervisor child, then starts it again from a
// :DOWN handler while the supervisor also restarts it. Resolve the supplied spec's
// policy; temporary children are exempt. The monitor must target the started child's
// pid.
// Follow same-module helpers for starts, monitors, and :DOWN matching, including
// gen_statem helpers. Seed traversal only at relevant start and monitor functions to
// avoid materializing every intra-module path.
.init module_reach = IntraModuleReach

module_reach.seed(s, s) :- dynamic_child(_, _, s).
module_reach.seed(m, m) :- monitors_started_child(_, m).

// A monitored child has two restart owners: its DynamicSupervisor and a process that
// restarts it from a DOWN handler.
.decl two_restart_authorities(mod: symbol, sup: symbol, child: symbol, via: symbol, handler: symbol)

two_restart_authorities(mod, sup, child, via, handler) :-
  starts_and_monitors(mod, sup, child, via),
  down_handler(mod, handler),
  starts_supervised_again(handler, sup, child).

// `via` reaches both a named child start under sup and a monitor of a supervised child.
// Exclude task children and unresolved children.
.decl starts_and_monitors(mod: symbol, sup: symbol, child: symbol, via: symbol)

starts_and_monitors(mod, sup, child, via) :-
  function_def(via, mod, _, _, _),
  module_reach.reaches(via, start),
  dynamic_child(sup, child, start),
  child != "dynamic",
  child != "Task",
  module_reach.reaches(via, monitor),
  monitors_started_child(_, monitor).

// A monitor targeting a supervisor-started child, established by all-path answer
// origins through wrappers or by points-to reaching a possible DynamicSupervisor
// allocation.
.decl monitors_started_child(id: symbol, func: symbol)

monitors_started_child(id, func) :-
  monitor_answer(id, func, _, _),
  !monitors_other(id).

answer_demand(c, f) :- monitor_answer(_, f, c, _).

// The pid monitored at `id` may be something other than a child a
// supervisor's start_child started.
.decl monitors_other(id: symbol)

monitors_other(id) :- monitor_answer(id, _, c, _), call_opaque(c).
monitors_other(id) :- monitor_answer(id, _, c, k), call_origin(c, _, j), k + j > 1.

monitors_other(id) :-
  monitor_answer(id, _, c, _),
  call_origin(c, o, _),
  !supervisor_start_child(o).

// A supervisor's start_child, which answers the child it started.
.decl supervisor_start_child(site: symbol)

supervisor_start_child(o) :- call_site(o, _, "DynamicSupervisor", "start_child", _).
supervisor_start_child(o) :- call_site(o, _, "Supervisor", "start_child", _).

monitors_started_child(id, func) :-
  signal_target(id, func, "monitor", pid),
  instance(pid, base),
  process_start(start, _, base, _, _),
  call_site(start, _, "DynamicSupervisor", "start_child", _).

// A function of mod that handles a :DOWN message (matches_down).
.decl down_handler(mod: symbol, handler: symbol)

down_handler(mod, handler) :-
  function_def(handler, mod, _, _, _),
  matches_down(handler).

// The handler starts `child` under sup with a non-temporary restart policy, so the
// supervisor also restarts it.
.decl starts_supervised_again(handler: symbol, sup: symbol, child: symbol)

starts_supervised_again(handler, sup, child) :-
  module_reach.reaches(handler, start),
  dynamic_restart(sup, child, start, restart),
  known_restart(restart),
  restart != "temporary".

.decl dual_restart_authority(mod: symbol, sup: symbol, child: symbol, via: symbol, start_site: symbol, monitor_site: symbol, handler: symbol)
.output dual_restart_authority

dual_restart_authority(mod, sup, child, via, start_site, monitor_site, handler) :-
  two_restart_authorities(mod, sup, child, via, handler),
  start_site_of(via, sup, child, start_site),
  monitor_site_of(via, monitor_site).

// The start_child call `via` reaches for this child, and the monitor it
// reaches; empty when the function is known but not the instruction.
.decl start_site_of(via: symbol, sup: symbol, child: symbol, site: symbol)

start_site_of(via, sup, child, id) :-
  starts_and_monitors(_, sup, child, via),
  module_reach.reaches(via, s),
  dynamic_child(sup, child, s),
  call_site(id, s, "DynamicSupervisor", "start_child", _).

start_site_of(via, sup, child, "") :-
  starts_and_monitors(_, sup, child, via),
  !start_site_of_known(via, sup, child).

.decl start_site_of_known(via: symbol, sup: symbol, child: symbol)

start_site_of_known(via, sup, child) :-
  starts_and_monitors(_, sup, child, via),
  module_reach.reaches(via, s),
  dynamic_child(sup, child, s),
  call_site(_, s, "DynamicSupervisor", "start_child", _).

.decl monitor_site_of(via: symbol, site: symbol)

monitor_site_of(via, id) :-
  starts_and_monitors(_, _, _, via),
  module_reach.reaches(via, m),
  monitors_started_child(id, m).
