// Two owners of one relationship across supervisor branches.
//
// A supervisor restarts what it owns; a sibling that holds a pid, a
// monitor or a cached reply of the restarted child is not restarted
// with it and keeps a stale reference. The strategy decides: under
// one_for_one the caller survives the callee's restart, under
// rest_for_one an earlier child survives a later one's, and a child a
// process both starts under a supervisor and restarts from its own
// :DOWN handler has two restart authorities.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/signals.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ══ Coupling under one_for_one ══════════════════════════════════════
.decl derived_process_link(from_mod: symbol, to_mod: symbol)

derived_process_link(a, b) :- process_link(a, b).
derived_process_link(sup, child) :- supervisor_child(sup, _, child, _, _).

// A link to a pid the extractor could not name ("dynamic"), which the
// points-to analysis follows to a server started with b's callbacks.
derived_process_link(a, b) :-
  signal_target(_, f, "link", p),
  function_def(f, a, _, _, _),
  server_process(p, b).

// Two modules under a one_for_one supervisor where one depends on the
// other through GenServer message passing, and they belong to different
// child branches. Under one_for_one, if the callee's branch crashes,
// the caller's branch keeps running in a degraded state.
//
// Linked pairs are excluded: an exit propagates through the link, both
// processes restart together, and no stale state survives — the hazard
// this analysis reports is already mitigated.
//
// sup_site anchors the finding at the instruction that defines the tree
// (the strategy line); witness is a function in caller_mod through which
// the coupling flows. One row per witness — finding builders dedupe on
// (sup, caller_mod, callee_mod).
.decl coupling(sup: symbol, caller_mod: symbol, callee_mod: symbol, sup_site: symbol, witness: symbol)

// A caller whose every resolved call to the callee's module goes to an
// instance it started for itself (private_module_dep, calls.dl) is not
// coupled to the sibling the supervisor starts.
coupling(sup, caller_mod, callee_mod, sup_site, witness) :-
  supervisor(sup, "one_for_one"),
  supervisor_site(sup, sup_site),
  child_subtree(sup, caller_branch, caller_mod),
  child_subtree(sup, callee_branch, callee_mod),
  stateful_module_dep(caller_mod, callee_mod, witness),
  !private_module_dep(caller_mod, callee_mod),
  !derived_process_link(caller_mod, callee_mod),
  !derived_process_link(callee_mod, caller_mod),
  caller_branch != callee_branch.

// The instruction inside the witness that makes the coupling call —
// the call into the sibling module itself when the witness calls it
// directly, otherwise the GenServer.call/cast the witness performs (both
// come from the stage-0 `call_site` relation). A witness may have
// several; the finding builder keeps one per pair.
.decl coupling_site(witness: symbol, callee_mod: symbol, site: symbol)

.decl direct_coupling_site(witness: symbol, callee_mod: symbol, site: symbol)

direct_coupling_site(w, callee_mod, id) :-
  coupling(_, _, callee_mod, _, w),
  call_site(id, w, callee_mod, _, _).

// A call the dependency is resolved at (sync_site: the call itself, or
// the witness's call into a helper that makes it), before any GenServer
// call of the witness.
direct_coupling_site(w, callee_mod, id) :-
  coupling(_, _, callee_mod, _, w),
  !call_site(_, w, callee_mod, _, _),
  sync_site(w, callee_mod, id).

direct_coupling_site(w, callee_mod, id) :-
  coupling(_, _, callee_mod, _, w),
  !call_site(_, w, callee_mod, _, _),
  !sync_site(w, callee_mod, _),
  call_site(id, w, m, _, _),
  (m = "GenServer" ; m = ":gen_server" ; m = ":gen_statem" ; m = "GenStateMachine").

coupling_site(w, callee_mod, id) :-
  direct_coupling_site(w, callee_mod, id).

// The witness is the function the dependency is proven through (often a
// callback), and the call into the sibling may live several local calls
// below it. Anchor at that call rather than at the witness's head.
// Walked back from the functions that call a coupled sibling, which are
// few, rather than forward from every witness over all it calls (8.8k
// rows against 250 on blockster).
//
// The call INTO the sibling: one made from outside its module. The
// sibling's own functions call each other (a default-argument head calls
// the full arity, a client API its helper), and the walk reaches them
// through the call that entered; anchored there, every caller's finding
// showed the same line of the sibling's API (sentry-elixir's
// ClientReport.Sender.record_discarded_events/2, for each of its callers).
.init sibling_caller_reach = CallReach

.decl sibling_entry_call(id: symbol, g: symbol, callee_mod: symbol)

sibling_entry_call(id, g, callee_mod) :-
  coupling(_, _, callee_mod, _, _),
  call_site(id, g, callee_mod, _, _),
  function_def(g, gm, _, _, _),
  gm != callee_mod.

sibling_caller_reach.seed(g, g) :- sibling_entry_call(_, g, _).

coupling_site(w, callee_mod, id) :-
  coupling(_, _, callee_mod, _, w),
  !direct_coupling_site(w, callee_mod, _),
  sibling_caller_reach.reaches(w, g),
  sibling_entry_call(id, g, callee_mod).

// ══ The one output: a child depending on a sibling ═══════════════════
//
// One relationship, three reasons it goes stale. `reason` says which,
// `detail` qualifies it:
//   restart_isolation — two branches of a one_for_one supervisor, one
//     depending on the other; detail is "call" when the caller waits on
//     the sibling anywhere, "cast" when every path is one-way.
//   restart_policy — a permanent child depends on a sibling that may
//     never come back; detail is the sibling's restart policy.
//   cached_pid — init/1 looks the sibling up by name under one_for_one
//     and the handlers call the cached pid; detail is empty.
// `witness` is the function in the caller the dependency flows through
// and `site` the instruction that makes the call when one is known, the
// witness function ID otherwise. One row per witness; finding builders
// dedupe on (sup, caller, callee, reason). `site` anchors with
// `Findings.at_site/2` either way.
//
// `basis` says how the dependency was established: `resolved` through a
// call or cast whose target is known, `inferred` through the module-level
// clause of stateful_module_dep alone — the caller reaches some function
// of the sibling and the sibling has a call somewhere — and `doubted`
// when that inference is all there is and a prior (Argus.Priors, off by
// default) puts the sibling's API at 0.3 or below for messaging a
// process: a helper with a call in its start_link, not a facade. The
// finding steps down a severity for a doubted row; `permille` is the
// prior's probability that the module does talk to a process.
.decl dep_resolved(from: symbol, to: symbol)

dep_resolved(f, t) :- module_sync_dep(f, t, _).

dep_resolved(f, t) :-
  function_def(w, f, _, _, _),
  reaches_async_dep(w, t),
  f != t.

.decl dep_doubted(from: symbol, to: symbol, permille: number)

dep_doubted(f, t, p) :-
  stateful_module_dep(f, t, _),
  !dep_resolved(f, t),
  prior_talks_to_process(t, p),
  p <= 300.

.decl dep_basis(from: symbol, to: symbol, basis: symbol, permille: number)

dep_basis(f, t, "resolved", 0) :- dep_resolved(f, t).
dep_basis(f, t, "doubted", p) :- dep_doubted(f, t, p).

dep_basis(f, t, "inferred", 0) :-
  stateful_module_dep(f, t, _),
  !dep_resolved(f, t),
  !dep_doubted(f, t, _).

.decl sibling_dependency(sup: symbol, caller: symbol, callee: symbol, reason: symbol, detail: symbol, sup_site: symbol, witness: symbol, site: symbol, basis: symbol, permille: number)
.output sibling_dependency

sibling_dependency(sup, caller_mod, callee_mod, "restart_isolation", kind, sup_site, witness, site, basis, p) :-
  coupling(sup, caller_mod, callee_mod, sup_site, witness),
  coupling_site(witness, callee_mod, site),
  stateful_module_dep_kind(caller_mod, callee_mod, kind),
  dep_basis(caller_mod, callee_mod, basis, p).

sibling_dependency(sup, caller_mod, callee_mod, "restart_isolation", kind, sup_site, witness, witness, basis, p) :-
  coupling(sup, caller_mod, callee_mod, sup_site, witness),
  !coupling_site(witness, callee_mod, _),
  stateful_module_dep_kind(caller_mod, callee_mod, kind),
  dep_basis(caller_mod, callee_mod, basis, p).

// ══ A permanent child depending on a sibling that may not come back ═
//
// Permanent child that depends (transitively) on a sibling whose
// restart policy can leave it dead: a transient child that stops
// normally is never restarted, and a temporary child is never restarted
// at all — strictly worse. Either way the permanent child keeps running
// against a process that no longer exists.
//
// sup_site anchors at the tree definition; witness is a function in the
// permanent child through which the dependency flows. One row per
// witness — finding builders dedupe on (sup, permanent, sibling).
sibling_dependency(sup, perm, sibling, "restart_policy", restart, sup_site, witness, witness, basis, p) :-
  supervisor(sup, _),
  supervisor_site(sup, sup_site),
  supervisor_child(sup, _, perm, "permanent", _),
  supervisor_child(sup, _, sibling, restart, _),
  (restart = "transient" ; restart = "temporary"),
  stateful_module_dep(perm, sibling, witness),
  !private_module_dep(perm, sibling),
  dep_basis(perm, sibling, basis, p).

// ── A sibling's pid cached in init/1 under one_for_one ───────────────
//
// init/1 looks a sibling up by name and keeps the pid; under
// :one_for_one the sibling restarts alone and the cached pid is a
// dead process from then on — every call :noproc, every send lost
// (k8s 99c05d6 replaced such pids with :via names; oban#1413 and
// #1499 are the inverse, registrations made with a sibling that its
// restart forgets). :rest_for_one and :one_for_all restart the holder
// too; a :temporary target is never restarted. A handler must use the
// pid: process points-to follows a handler's call, cast or send to the
// process registered under the name, through anything but the name
// itself (a call by name each time is the fix). Where the name resolves
// to no process points-to knows, a handler's call to some pid it cannot
// follow stands in, as it did before points-to.
sibling_dependency(sup, mod, name, "cached_pid", "", sup_site, f, f, "resolved", 0) :-
  init_function(mod, f),
  name_lookup(_, f, "whereis", _, "literal", name, _),
  supervisor_child(sup, _, mod, _, _),
  supervisor(sup, "one_for_one"),
  supervisor_site(sup, sup_site),
  (supervisor_child(sup, _, name, _, _) ; supervisor_child_name(sup, _, name)),
  handler_function(mod, h),
  uses_cached_pid(h, name).

.decl uses_cached_pid(handler: symbol, name: symbol)

uses_cached_pid(h, name) :-
  process_call(h, _, site, _, p),
  named_pid(name, p),
  pid_use(site, _, _, sk, _),
  sk != "name".

uses_cached_pid(h, name) :-
  name_lookup(_, f, "whereis", _, "literal", name, _),
  init_function(mod, f),
  handler_function(mod, h),
  !named_pid(name, _),
  (sync_call(h, "dynamic") ; async_cast(h, "dynamic")).

// ── rest_for_one: a later child owns processes inside an earlier one ──
//
// rest_for_one restarts the crashed child and everything after it; the
// children before it keep running. That is the right shape when earlier
// children are dependencies of later ones. It is exactly wrong when a
// later child starts processes inside an earlier one — Oban's producer
// (position 1) running jobs under the Task.Supervisor at position 0.
// When the producer crashes, the supervisor restarts it, the jobs the
// old producer started keep running under the surviving supervisor, and
// the new producer starts them again: duplicate long-running jobs and
// `attempt > max_attempts`. Oban's fix was :one_for_all.
//
// The owner is the child that calls start_child / async / async_nolink
// (any module in its branch); the holder is an earlier direct child.
// Two ways to connect them, `basis` in sibling_dependency's words.
// `resolved`: the call names the holder's registered name. `inferred`:
// the target is a runtime value and the
// holder is the only earlier sibling whose module is the API called —
// a Task.Supervisor.async_nolink into an unresolvable pid, with exactly
// one Task.Supervisor started earlier under the same rest_for_one, is
// not much of an inference.
.decl earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  supervisor_child(sup, pos, api, _, _),
  supervisor_child(sup, owner_pos, _, _, _),
  pos < owner_pos.

.decl sole_earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

sole_earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  earlier_sibling_of_kind(sup, pos, api, owner_pos),
  !other_earlier_sibling_of_kind(sup, pos, api, owner_pos).

.decl other_earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

other_earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  earlier_sibling_of_kind(sup, pos, api, owner_pos),
  earlier_sibling_of_kind(sup, other, api, owner_pos),
  other != pos.

.decl rest_for_one_orphaned_children(sup: symbol, owner: symbol, holder: symbol, owner_pos: number, holder_pos: number, site: symbol, basis: symbol)
.output rest_for_one_orphaned_children

rest_for_one_orphaned_children(sup, owner, holder, opos, hpos, site, "resolved") :-
  supervisor(sup, "rest_for_one"),
  supervisor_child(sup, opos, owner_branch, _, _),
  child_subtree(sup, owner_branch, owner),
  supervisor_child(sup, hpos, holder, _, _),
  hpos < opos,
  supervisor_child_name(sup, hpos, name),
  function_def(f, owner, _, _, _),
  sup_management_call(site, f, _, op, name),
  child_creating_op(op).

// The call's supervisor is a pid here ("dynamic"). Process points-to
// does not follow it: a supervisor management call is not a pid use
// (pid_call covers calls, casts and sends; sup_call's target is its own
// extractor's), so the one earlier sibling of the API's kind stands in.
rest_for_one_orphaned_children(sup, owner, holder, opos, hpos, site, "inferred") :-
  supervisor(sup, "rest_for_one"),
  supervisor_child(sup, opos, owner_branch, _, _),
  child_subtree(sup, owner_branch, owner),
  function_def(f, owner, _, _, _),
  sup_management_call(site, f, api, op, "dynamic"),
  child_creating_op(op),
  sole_earlier_sibling_of_kind(sup, hpos, api, opos),
  supervisor_child(sup, hpos, holder, _, _).

// ── Two restart authorities ──────────────────────────────────────────
//
// A process that starts a child under a DynamicSupervisor, monitors it,
// and starts it again from its :DOWN handler has taken over restarting —
// while the supervisor, for a :permanent child, does the same. A child
// that fails on a semantic error crash-loops under both, blows the
// supervisor's intensity and takes the tree with it (redix#334). A
// :temporary child_spec, or a :temporary spec the start hands over
// (dynamic_child_restart: redix's own fix, Supervisor.child_spec({Redix,
// opts}, restart: :temporary)), leaves the supervisor out of it.
//
// The start, the monitor and the :DOWN handling are usually spread over
// private helpers (redix: start_connection/7, start_and_monitor_connection/5,
// handle_down/2), so each is asked of a function's reach within its own
// module. The monitor must be OF the started child — the pid a
// supervisor start returned — not of some other process the module
// watches (Oban.Queues monitors its notifier and restarts queues from a
// signal: two facts about two processes, not two restart authorities). The :DOWN handler is whichever function of the module matches
// :DOWN (matches_down): handle_info/2 for a GenServer, a private helper
// its state functions' catch-alls dispatch to for a gen_statem.
//
// Walked back from the only targets these rules ask about — the functions
// that start a dynamic child and the ones that monitor what they started
// — rather than closed over every function of the program: seeded at every
// function, the closure held every intra-module path (6.1M rows from 43k
// edges on a deps tree) to answer questions about a handful.
.init module_reach = IntraModuleReach

module_reach.seed(s, s) :- dynamic_child(_, _, s).
module_reach.seed(m, m) :- monitors_started_child(_, m).

.decl starts_and_monitors(mod: symbol, sup: symbol, child: symbol, via: symbol)

starts_and_monitors(mod, sup, child, f) :-
  function_def(f, mod, _, _, _),
  module_reach.reaches(f, s),
  dynamic_child(sup, child, s),
  child != "dynamic",
  child != "Task",
  module_reach.reaches(f, m),
  monitors_started_child(_, m).

// A monitor of a pid a supervisor's start_child returned: named so by
// the extractor, or a pid it could not name that the points-to analysis
// follows to a process a DynamicSupervisor.start_child started.
.decl monitors_started_child(id: symbol, func: symbol)

monitors_started_child(id, f) :- monitor_call(id, f, "started_child").

monitors_started_child(id, f) :-
  monitor_call(id, f, "dynamic"),
  signal_target(id, f, "monitor", p),
  process_start(s, _, p, _, _),
  call_site(s, _, "DynamicSupervisor", "start_child", _).

.decl down_handler(mod: symbol, handler: symbol)

down_handler(mod, h) :-
  function_def(h, mod, _, _, _),
  matches_down(h).

.decl dual_restart_authority(mod: symbol, sup: symbol, child: symbol, via: symbol, start_site: symbol, monitor_site: symbol, handler: symbol)
.output dual_restart_authority

dual_restart_authority(mod, sup, child, via, start_site, monitor_site, h) :-
  starts_and_monitors(mod, sup, child, via),
  down_handler(mod, h),
  module_reach.reaches(h, s),
  dynamic_child(sup, child, s),
  !child_spec_restart(child, "temporary"),
  !dynamic_child_restart(sup, child, s, "temporary"),
  start_site_of(via, sup, child, start_site),
  monitor_site_of(via, monitor_site).

// The start_child call `via` reaches for this child, and the monitor it
// reaches; empty when the function is known but not the instruction.
.decl start_site_of(via: symbol, sup: symbol, child: symbol, site: symbol)

start_site_of(via, sup, child, id) :-
  starts_and_monitors(_, sup, child, via),
  module_reach.reaches(via, s),
  dynamic_child(sup, child, s),
  call_site(id, s, "DynamicSupervisor", "start_child", _).

start_site_of(via, sup, child, "") :-
  starts_and_monitors(_, sup, child, via),
  !start_site_of_known(via, sup, child).

.decl start_site_of_known(via: symbol, sup: symbol, child: symbol)

start_site_of_known(via, sup, child) :-
  starts_and_monitors(_, sup, child, via),
  module_reach.reaches(via, s),
  dynamic_child(sup, child, s),
  call_site(_, s, "DynamicSupervisor", "start_child", _).

.decl monitor_site_of(via: symbol, site: symbol)

monitor_site_of(via, id) :-
  starts_and_monitors(_, _, _, via),
  module_reach.reaches(via, m),
  monitors_started_child(id, m).
