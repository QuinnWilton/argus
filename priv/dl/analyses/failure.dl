// An error path swallowed, half-caught or ignored.
//
// A failure the code could have seen and did not: a rescue that keeps
// every exception, a remote call whose failure value nothing matches,
// a start result discarded, a lookup used without its nil case, a
// process spawned with nothing watching it, an exit signal sent from a
// callback past the supervisor that owns the target; and failures the
// code makes certain: a local-only BIF handed another node's pid, an
// rpc to a function its module does not export, a handle an error path
// loses.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/signals.dl"
.include "../clientlib/specs.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/remote_pids.dl"
.include "../clientlib/rpc_targets.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ══ The outputs ═════════════════════════════════════════════════════
//
// A failure the code could have seen and did not, in these shapes (the
// ones another node and a lost handle make follow them):
//
// `unhandled_failure(func, site, kind, shape)` — a failure value or
//   exception that nothing takes. `kind` is "rescue" (a catch-all rescue
//   discards the exception; site is the try), "erpc_transport" (a
//   rescue around :erpc.call has no clause for transport failures; site
//   is the guarded call), or the rpc variant "rpc" | "block_call" |
//   "yield" | "multicall" | "erpc" whose
//   result is matched by shape with no {:badrpc, _} clause (`shape` =
//   "case") or used as a boolean (`shape` = "boolean"); site is the call.
// `unchecked_result(func, site, api, name)` — a result used without its
//   failure case: Task.Supervisor.start_child discarded, or a
//   Process.whereis of `name` used without its nil case.
// `orphan_process(func, site, kind, target, callback)` — a process
//   nothing supervises: a bare spawn (`kind` = "spawn"), a
//   `:proc_lib.start` whose process lives on past its ack (`kind` =
//   "start"; site is the call for both), or an exit signal sent to
//   `target` from a callback, past the supervisor that owns it (`kind` =
//   "exit", or "exit_supervised" when `target` is a supervisor's child;
//   site is the exit call, `func` the function making it and `callback`
//   a callback running it).
.decl unhandled_failure(func: symbol, site: symbol, kind: symbol, shape: symbol, span_end: symbol)
.output unhandled_failure

.decl unchecked_result(func: symbol, site: symbol, api: symbol, name: symbol)
.output unchecked_result

.decl orphan_process(func: symbol, site: symbol, kind: symbol, target: symbol, callback: symbol)
.output orphan_process

.decl inconsistent_handling(func: symbol, site: symbol, callee: symbol, belief: symbol, agree: number, deviate: number, target: symbol, raises: symbol, cover: symbol, caught: symbol)
.output inconsistent_handling

// ══ Another node ════════════════════════════════════════════════
//
// Two defects a cluster shows and a single node never does: a BIF that
// acts on a local process only, handed another node's pid, and an rpc
// to a function the program's module does not export.

// `remote_pid_probe(func, anchor, site, bif, api, kind)` — a BIF that
//   acts on a local process only (`bif` at `site`), handed a pid that
//   may be another node's: one `api` answered (`kind` = "lookup": a
//   cluster-wide registry or a process group), or one a conflict
//   resolver is handed (`kind` = "resolver"). `anchor` is the site the
//   finding points at: the BIF's call, or `func`'s call into the helper
//   that makes it.
.decl remote_pid_probe(func: symbol, anchor: symbol, site: symbol, bif: symbol, api: symbol, kind: symbol)
.output remote_pid_probe

// A BIF that acts on a local process only is handed a pid that may be
// another node's, and no try takes the ArgumentError it raises there.
// `prober` is the function the BIF is in, where a try can take it too.
.decl local_bif_on_remote_pid(func: symbol, anchor: symbol, probe: symbol, origin: symbol)

local_bif_on_remote_pid(func, anchor, probe, origin) :-
  probes_local_process(probe, prober),
  hands_remote_pid(func, anchor, probe, origin),
  !site_takes_argument_error(probe, prober),
  !site_takes_argument_error(anchor, func).

remote_pid_probe(func, anchor, probe, bif, api, kind) :-
  local_bif_on_remote_pid(func, anchor, probe, origin),
  pid_probe(probe, _, bif, _, _),
  remote_origin(origin, api, kind).

// The BIF at `probe`, in `prober`, acts on a process of this node only,
// and raises badarg on another node's pid (pid_probe, remote_pids.dl).
.decl probes_local_process(probe: symbol, prober: symbol) inline

probes_local_process(probe, prober) :- pid_probe(probe, prober, _, _, _).

// `func` hands the BIF a pid the call at `origin` answered, which may be
// another node's: at the BIF itself (`anchor` is the BIF), or at func's
// call (`anchor`) into the helper that makes it (remote_probe).
.decl hands_remote_pid(func: symbol, anchor: symbol, probe: symbol, origin: symbol) inline

hands_remote_pid(func, anchor, probe, origin) :- remote_probe(func, anchor, probe, origin).

// site_takes_argument_error (exceptions.dl) is a try around the BIF, or
// around the call into its helper, that takes the ArgumentError and goes
// on: a rescue of ArgumentError or of every error that does not re-raise,
// or Erlang's `catch`. It handles the other node's pid.

// `rpc_undefined(func, anchor, site, callee, why)` — the rpc at `site`
//   runs `callee`, a function of one of the program's modules that the
//   module does not export (`why` = "missing": no such function at that
//   arity; "private": defined but not exported). `anchor` is the rpc, or
//   `func`'s call into the wrapper that makes it.
.decl rpc_undefined(func: symbol, anchor: symbol, site: symbol, callee: symbol, why: symbol)
.output rpc_undefined

// An rpc runs a function of a module whose code Argus has, and the module
// does not define it.
.decl rpc_to_missing_function(func: symbol, anchor: symbol, rpc: symbol, callee: symbol)

rpc_to_missing_function(func, anchor, rpc, callee) :-
  rpc_runs(rpc, callee, module, func, anchor),
  code_is_known(module),
  !defines(module, callee).

// An rpc runs a function the module defines but does not export.
.decl rpc_to_private_function(func: symbol, anchor: symbol, rpc: symbol, callee: symbol)

rpc_to_private_function(func, anchor, rpc, callee) :-
  rpc_runs(rpc, callee, module, func, anchor),
  defines(module, callee),
  !exports(module, callee).

rpc_undefined(func, anchor, rpc, callee, "missing") :-
  rpc_to_missing_function(func, anchor, rpc, callee).

rpc_undefined(func, anchor, rpc, callee, "private") :-
  rpc_to_private_function(func, anchor, rpc, callee).

// Argus has the module's code: it is one of the analyzed beams, so what it
// defines and exports is known (the same release runs on every node). A
// module it never saw, OTP or a dependency, defines nothing as far as the
// facts go, so without this every rpc into one would look "missing".
// `defines` implies it, so the private rule needs no such line.
.decl code_is_known(module: symbol) inline

code_is_known(module) :- program_module(module).

// The module defines the function, exported or not.
.decl defines(module: symbol, func: symbol) inline

defines(module, func) :- function_def(func, module, _, _, _).

// The module exports the function.
.decl exports(module: symbol, func: symbol) inline

exports(module, func) :- function_def(func, module, _, _, 1).

// ══ A handle lost on an error path ══════════════════════════════

// `resource_dropped(func, site, api, drop)` — the file, socket or port
//   the call at `site` (`api`) opens is lost at `drop` on some path that
//   returns: only read, written, sent on or tested on the way, never
//   closed, returned, stored or handed on (handle_dropped,
//   Argus.Extractors.Handles). The process that opened it holds it
//   until it exits.
.decl resource_dropped(func: symbol, site: symbol, api: symbol, drop: symbol)
.output resource_dropped

// A function opens a file, socket or port, and a path that returns loses
// the handle without closing it.
.decl lost_handle(func: symbol, open: symbol, drop: symbol)

lost_handle(func, open, drop) :-
  opens_handle(open, func),
  loses_handle(open, drop).

resource_dropped(func, open, api, drop) :-
  lost_handle(func, open, drop),
  handle_dropped(open, func, api, drop).

// The call at `open`, in `func`, opens a file, socket or port that some
// path from it drops (handle_dropped).
.decl opens_handle(open: symbol, func: symbol) inline

opens_handle(open, func) :- handle_dropped(open, func, _, _).

// On a path from the open that returns, the handle is gone at `drop`:
// only read, written, sent on or tested on the way, never closed,
// returned, stored or handed on (handle_dropped, Argus.Extractors.Handles).
.decl loses_handle(open: symbol, drop: symbol) inline

loses_handle(open, drop) :- handle_dropped(open, _, _, drop).

// ── Swallowed errors ─────────────────────────────────────────────

// A catch-all rescue discards every exception around the program's own
// logic, where it turns a bug into silence.
.decl swallowed_exception(func: symbol, try: symbol)

swallowed_exception(func, try) :-
  discards_every_exception(try, func),
  !protects_only_boundaries(try, func),
  !library_written(func).

unhandled_failure(func, try, "rescue", "", guard_end) :-
  swallowed_exception(func, try),
  bare_rescue(try, func, guard_end).

// The try at `try` catches every exception without filtering or
// re-raising (bare_rescue).
.decl discards_every_exception(try: symbol, func: symbol) inline

discards_every_exception(try, func) :- bare_rescue(try, func, _).

// The try protects only sends, signals, calls into other processes and
// name operations, or a log line (try_boundary), directly or through a
// client API (boundary_through_api): it takes a dead peer, a timeout, a
// taken name or a failed log handler, which is what it was written to
// tolerate. A catch-all a library wrote (library_written,
// clientlib/generated.dl: yecc's runtime in a generated parser, a `use`'s
// expansion) is the library's, not the program's.
.decl protects_only_boundaries(try: symbol, func: symbol) inline

protects_only_boundaries(try, func) :- try_boundary(try, func).
protects_only_boundaries(try, func) :- boundary_through_api(try, func).

// The same boundary one hop away: every call the try protects that is
// not a boundary operation itself is a call to a client API that is
// (boundary_function: hackney's `hackney_conn:stop(Pid) ->
// gen_statem:stop(Pid)`, vernemq's `vmq_queue:status/1`).
.decl boundary_through_api(try: symbol, func: symbol)

boundary_through_api(try, func) :-
  try_wrapper_call(try, func, _),
  !protects_other_call(try, func).

// A protected call that is no boundary function, or one the call graph
// does not resolve (it names no known boundary), keeps the try reported.
.decl protects_other_call(try: symbol, func: symbol)

protects_other_call(try, func) :-
  try_wrapper_call(try, func, call),
  call_instr(func, callee, call),
  !boundary_function(callee).

protects_other_call(try, func) :-
  try_wrapper_call(try, func, call),
  !call_instr(func, _, call).

// ── Exit in GenServer callback ───────────────────────────────────

// A server's callback sends an exit signal to a process the server did
// not start and no supervisor is known to own, stopping it behind the
// back of whatever supervises it.
.decl exit_past_supervisor(func: symbol, exit: symbol, target: symbol, callback: symbol)

exit_past_supervisor(func, exit, target, callback) :-
  sends_exit_signal(exit, func, target),
  runs_in_callback(exit, callback),
  !exit_to_own_process(exit, _),
  !exits_supervised_child(exit, _, _).

// A server's callback sends an exit signal to a supervisor's child, which
// the supervisor will restart: a stop that fights the supervisor.
.decl exit_to_supervised_child(func: symbol, exit: symbol, child: symbol, callback: symbol)

exit_to_supervised_child(func, exit, child, callback) :-
  sends_exit_signal(exit, func, _),
  runs_in_callback(exit, callback),
  exits_supervised_child(exit, child, _).

// One finding per exit call, in the function that makes it, whichever
// callbacks run it: Exq's Redis connection helper kills the connection
// on a failover from every server that queries Redis, and that is one
// exit, not ten. `callback` is one of the callbacks that reach it (the
// finding keeps the least). "exit" is to a process the rule knows only
// as a value, "exit_supervised" to a supervisor's child.
orphan_process(func, exit, "exit", target, callback) :-
  exit_past_supervisor(func, exit, target, callback).

orphan_process(func, exit, "exit_supervised", child, callback) :-
  exit_to_supervised_child(func, exit, child, callback).

// The supervisor that owns an exit's target: evidence on its finding.
.decl exit_target_owner(func: symbol, target: symbol, sup: symbol, sup_site: symbol)
.output exit_target_owner

exit_target_owner(func, child, sup, sup_site) :-
  exit_to_supervised_child(func, exit, child, _),
  exits_supervised_child(exit, child, sup),
  supervisor_site(sup, sup_site).

// `func` sends an exit signal to `target` at `exit`: Process.exit/2 or
// :erlang.exit/2. `:erlang.exit/1` (target "self", the sentinel the
// extractor uses for the /1 form) *raises* an exit in the current
// process: the "let it crash on an impossible state" idiom
// (`exit(:unexpected_checkout)`) and ordinary client-call failure
// propagation, both fully supervision-visible and not a bypass.
.decl sends_exit_signal(exit: symbol, func: symbol, target: symbol) inline

sends_exit_signal(exit, func, target) :- exit_call(exit, func, target), target != "self".

// A message handler of a server runs the exit, itself or in what it runs
// in its own process.
.init exit_reach = SameProcessReach

exit_reach.seed(func, exit) :- sends_exit_signal(exit, func, _).

.decl runs_in_callback(exit: symbol, callback: symbol)

runs_in_callback(exit, callback) :-
  handler_function(_, callback),
  exit_reach.reaches(callback, exit).

// Where process points-to (signals.dl) resolves the signal: a process
// the sending module started itself — a helper kept in the state, a
// worker it spawned — is its own to stop (exit_to_own_process), and a
// child a supervisor owns is the bypass the finding is about, named with
// its supervisor.
.decl exits_supervised_child(exit: symbol, child: symbol, sup: symbol)

exits_supervised_child(exit, child, sup) :-
  signal_target(exit, _, "exit", p),
  supervised_process(p, sup, pos),
  supervisor_child(sup, pos, child, _, _).

// ══ Remote calls whose failure is not a value ═══════════════════════

// A rescue around :erpc.call unwraps only its :exception errors, so a
// transport failure ({:erpc, :noconnection}) falls through the handler.
.decl transport_failure_unhandled(func: symbol, try: symbol, call: symbol)

transport_failure_unhandled(func, try, call) :-
  guards_erpc_call(try, func, call),
  unwraps_remote_exception(try, func),
  !takes_transport_failure(try, func),
  falls_through_after_exception(try, func).

unhandled_failure(func, call, "erpc_transport", "", guard_end) :-
  transport_failure_unhandled(func, try, call),
  try_call(try, func, callee, call, guard_end),
  erpc_call_api(callee).

// The try guards an :erpc.call at `call` (try_call).
.decl guards_erpc_call(try: symbol, func: symbol, call: symbol) inline

guards_erpc_call(try, func, call) :-
  try_call(try, func, callee, call, _),
  erpc_call_api(callee).

.decl erpc_call_api(callee: symbol)

erpc_call_api(":erpc:call/4").
erpc_call_api(":erpc:call/5").

// A clause of the handler takes an error tagged :exception: the remote
// function raised, and :erpc re-raises it here.
.decl unwraps_remote_exception(try: symbol, func: symbol) inline

unwraps_remote_exception(try, func) :- catch_tag(try, func, "error", ":exception").

// A clause names :erpc: it takes the transport failure.
.decl takes_transport_failure(try: symbol, func: symbol) inline

takes_transport_failure(try, func) :- catch_tag(try, func, "error", ":erpc").

// After comparing :exception the handler reaches a case with no clause
// for some reason: the one it did not name raises there.
.decl falls_through_after_exception(try: symbol, func: symbol) inline

falls_through_after_exception(try, func) :- catch_falls_through(try, func, ":exception").

// ── An rpc result that is not a value ─────────────────────────────────
//
// :rpc.call answers a node that is gone with {:badrpc, :nodedown} (a
// timeout, a remote exit: {:badrpc, reason} too). Matched by shape with
// no clause for it, that is a CaseClauseError (rabbitmq-cli#193,
// phoenix_live_dashboard#218, livebook#972); tested as a boolean it is
// TRUE — `member?(n) && :rpc.call(n, Process, :alive?, [pid])` says the
// process on a gone node is alive (horde, until 30bb1a1). :erpc.call
// raises instead, so in a boolean context it needs a rescue (horde's
// fix: catch {:erpc, :noconnection} -> false).

// An rpc answers a gone node with {:badrpc, _}, and the code matches the
// answer by shape with no clause for it.
.decl badrpc_unmatched(func: symbol, rpc: symbol, variant: symbol)

badrpc_unmatched(func, rpc, variant) :-
  may_answer_badrpc(rpc, func, variant),
  matched_by_shape(rpc, func).

unhandled_failure(func, rpc, variant, "case", "") :-
  badrpc_unmatched(func, rpc, variant).

// An rpc answers a gone node with {:badrpc, _}, and the code tests the
// answer as a boolean, where the tuple is true.
.decl badrpc_as_true(func: symbol, rpc: symbol, variant: symbol)

badrpc_as_true(func, rpc, variant) :-
  may_answer_badrpc(rpc, func, variant),
  used_as_boolean(rpc, func).

unhandled_failure(func, rpc, variant, "boolean", "") :-
  badrpc_as_true(func, rpc, variant).

// An :erpc call raises when the node is gone, the code tests its answer as
// a boolean, and nothing in the function takes the error.
.decl erpc_raise_in_boolean(func: symbol, rpc: symbol)

erpc_raise_in_boolean(func, rpc) :-
  erpc_call(rpc, func),
  used_as_boolean(rpc, func),
  !catches_class(func, "error"),
  !takes_erpc_error(func).

unhandled_failure(func, rpc, "erpc", "boolean", "") :-
  erpc_raise_in_boolean(func, rpc).

// The rpc at `rpc` (`variant`) answers {:badrpc, _} itself when the
// node is gone (badrpc_variant).
.decl may_answer_badrpc(rpc: symbol, func: symbol, variant: symbol) inline

may_answer_badrpc(rpc, func, variant) :-
  rpc_call(rpc, func, variant, _),
  badrpc_variant(variant).

// The :rpc forms whose answer is the {:badrpc, _} itself: call,
// block_call, the yield that collects an async_call, and multicall
// (whose failures are its bad-nodes list; the shape a rule matches is
// the pair). nb_yield wraps the answer in {:value, _}, so a case over it
// has a clause for the wrapper, and the badrpc it leaves out is nested:
// not this rule's shape.
.decl badrpc_variant(variant: symbol)

badrpc_variant("rpc").
badrpc_variant("block_call").
badrpc_variant("yield").
badrpc_variant("multicall").

// The answer is matched by shape in a function that compares nothing to
// :badrpc and has a clause-less exit (rpc_result "case").
.decl matched_by_shape(rpc: symbol, func: symbol) inline

matched_by_shape(rpc, func) :- rpc_result(rpc, func, "case").

// Used as a boolean: tested against true/false/nil after the call, or
// returned as the result of a predicate (a function named `...?`), whose
// callers test it.
.decl used_as_boolean(rpc: symbol, func: symbol)

used_as_boolean(rpc, func) :- rpc_result(rpc, func, "boolean").

used_as_boolean(rpc, func) :-
  rpc_result(rpc, func, "returned"),
  named_as_predicate(func).

// The function's name ends in `?`: its callers test what it returns.
.decl named_as_predicate(func: symbol) inline

named_as_predicate(func) :-
  function_def(func, _, name, _, _),
  match(".*\\?", name).

// An :erpc call that waits for its answer.
.decl erpc_call(rpc: symbol, func: symbol) inline

erpc_call(rpc, func) :- rpc_call(rpc, func, "erpc", _).

// A clause somewhere in the function takes an error tagged :erpc.
.decl takes_erpc_error(func: symbol) inline

takes_erpc_error(func) :- catch_tag(_, func, "error", ":erpc").

// ── An rpc answer a wrapper returns ───────────────────────────────────
//
// The answer of an rpc a function returns (rpc_result "returned") is its
// callers' to judge: EMQX's BPAPI proto modules are one `rpc:call` each,
// a facade returns the proto's answer, and the HTTP handler matched the
// facade's result for ok and error only, so a gone node was a
// CaseClauseError and a 500 (emqx#18287 fixed about fifteen such
// callers). A wrapper returns an rpc's answer, or another wrapper's
// (result_tested "returned", remote callees included); where its caller
// matches that result by shape, or tests it as a boolean, in a function
// comparing nothing to :badrpc (result_tested), the {:badrpc, _} meets
// the test there. A function that takes the failure itself (a :badrpc
// clause, rpc_result "badrpc") wraps nothing. `rpc_wrapped` names the
// rpc for the finding's frame.

// A wrapper returns an rpc's answer, and its caller matches the result by
// shape with no clause for {:badrpc, _}.
.decl wrapped_badrpc_unmatched(caller: symbol, call: symbol, wrapper: symbol, variant: symbol)

wrapped_badrpc_unmatched(caller, call, wrapper, variant) :-
  rpc_wrapper(wrapper, variant, _),
  matches_result_by_shape(call, caller, wrapper).

unhandled_failure(caller, call, variant, "case", wrapper) :-
  wrapped_badrpc_unmatched(caller, call, wrapper, variant).

// A wrapper returns an rpc's answer, and its caller tests the result as a
// boolean, where a {:badrpc, _} is true.
.decl wrapped_badrpc_as_true(caller: symbol, call: symbol, wrapper: symbol, variant: symbol)

wrapped_badrpc_as_true(caller, call, wrapper, variant) :-
  rpc_wrapper(wrapper, variant, _),
  tests_result_as_boolean(call, caller, wrapper).

unhandled_failure(caller, call, variant, "boolean", wrapper) :-
  wrapped_badrpc_as_true(caller, call, wrapper, variant).

// `wrapper` returns the answer of the rpc at `rpc` (`variant`), its own
// or another wrapper's, and takes no failure itself. A predicate's
// answer is reported where the predicate is, not at its callers.
.decl rpc_wrapper(wrapper: symbol, variant: symbol, rpc: symbol)

rpc_wrapper(wrapper, variant, rpc) :-
  rpc_call(rpc, wrapper, variant, _),
  wrapped_answer(variant),
  rpc_result(rpc, wrapper, "returned"),
  !predicate_function(wrapper).

rpc_wrapper(outer, variant, rpc) :-
  result_tested(_, outer, wrapper, "returned"),
  rpc_wrapper(wrapper, variant, rpc),
  !predicate_function(outer).

// The answers that are a {:badrpc, _} themselves. A multicall's is the
// {results, bad_nodes} pair, which a caller's `{replies, _bad} =` match
// always takes (mnesia's own multicall wrappers): its failures are in
// the lists, not this rule's shape.
.decl wrapped_answer(variant: symbol)

wrapped_answer("rpc").
wrapped_answer("block_call").
wrapped_answer("yield").

// A function named as a predicate that returns an rpc's or a wrapper's
// answer: it hands its callers the answer as a boolean.
.decl predicate_function(func: symbol)

predicate_function(func) :-
  rpc_result(_, func, "returned"),
  named_as_predicate(func).

predicate_function(func) :-
  result_tested(_, func, _, "returned"),
  named_as_predicate(func).

// The caller matches the wrapper's result, got at `call`, by shape, in a
// function with a clause-less exit (result_tested "case").
.decl matches_result_by_shape(call: symbol, caller: symbol, wrapper: symbol) inline

matches_result_by_shape(call, caller, wrapper) :- result_tested(call, caller, wrapper, "case").

// The caller tests the wrapper's result as a boolean, or is a predicate
// that returns it (a cluster facade's `alive?/2` returning the proto's
// `:rpc.call`): its name is the test, and it is reported at its call of
// the wrapper, as a predicate making the rpc itself is at the rpc
// (used_as_boolean).
.decl tests_result_as_boolean(call: symbol, caller: symbol, wrapper: symbol)

tests_result_as_boolean(call, caller, wrapper) :- result_tested(call, caller, wrapper, "boolean").

tests_result_as_boolean(call, caller, wrapper) :-
  result_tested(call, caller, wrapper, "returned"),
  predicate_function(caller).

// The rpc a wrapper's finding names in its frame.
.decl rpc_wrapped(func: symbol, site: symbol, rpc: symbol, wrapper: symbol)
.output rpc_wrapped

rpc_wrapped(caller, call, rpc, wrapper) :-
  matches_result_by_shape(call, caller, wrapper),
  rpc_wrapper(wrapper, _, rpc).

rpc_wrapped(caller, call, rpc, wrapper) :-
  tests_result_as_boolean(call, caller, wrapper),
  rpc_wrapper(wrapper, _, rpc).

// ══ Results discarded ═══════════════════════════════════════════════

// A Task.Supervisor.start_child's result is dropped, so a start that
// fails goes unnoticed.
.decl discarded_task_start(func: symbol, start: symbol)

discarded_task_start(func, start) :-
  starts_supervised_task(start, func),
  !start_result_checked(start).

unchecked_result(func, start, "Task.Supervisor.start_child", "") :-
  discarded_task_start(func, start).

// The call at `start` is Task.Supervisor.start_child.
.decl starts_supervised_task(start: symbol, func: symbol)

starts_supervised_task(start, func) :-
  remote_call(start, func, "Task.Supervisor", "start_child", _).

// The start's result is checked: in tail position (propagated to the
// caller), or followed by a branch in the same function (pattern-matched).
.decl start_result_checked(start: symbol)

start_result_checked(start) :-
  starts_supervised_task(start, _),
  tail_call(start).

// `call_followed_by_branch` is emitted by the extractor and holds exactly
// what the two `instruction` joins used to compute: this call has some
// branch later in its function. Asking Datalog to compare two instruction
// INDEXES meant joining `instruction` — 343k rows on a 531-module project,
// rewritten whenever any function body changes — to answer a yes/no
// question, and it made unsafe_task the last analysis reading that
// relation and by far the most expensive one.
//
// The predicate is as coarse as it ever was: a branch anywhere later in
// the function counts, including one in an unrelated clause, so this is a
// weak proxy for "the result was pattern-matched". That weakness is
// preserved on purpose — moving where it is computed must not change what
// it computes. Sharpening it (asking whether the call's result register is
// actually inspected, which the extractor helpers can do) changes findings
// and belongs in its own commit.
start_result_checked(start) :-
  starts_supervised_task(start, _),
  call_followed_by_branch(start).

// A Process.whereis of a literal name is used without testing for nil,
// and no try around the use takes how a nil pid fails there.
.decl whereis_without_nil_case(func: symbol, lookup: symbol, name: symbol)

whereis_without_nil_case(func, lookup, name) :-
  used_untested(lookup, func, name),
  !nil_use_caught(lookup, func).

unchecked_result(func, lookup, "Process.whereis", name) :-
  whereis_without_nil_case(func, lookup, name).

// The Process.whereis at `lookup` looks up the literal `name`, and its
// result is used without a test against nil (name_lookup "unchecked").
.decl used_untested(lookup: symbol, func: symbol, name: symbol) inline

used_untested(lookup, func, name) :- name_lookup(lookup, func, "whereis", _, "literal", name, "unchecked").

// A lookup whose first use fails, on a nil or :undefined pid, the way a
// try around that use takes (nil_use, from ProcessRegistry: the use, and
// how it fails): its missing case is handled where it is used. A BIF or
// a send raises badarg, which a handler of the error class takes, or one
// naming :badarg (`process_info(whereis(n), ...)` under `catch
// error:badarg`, rabbit_vm's memory/0); a call to the name exits with
// :noproc, which only a handler of the exit class takes — a `rescue`
// around `GenServer.call(Process.whereis(n), ...)` takes nothing of it; a
// use nothing is known of needs a handler of both. The coverage asked is
// the use's own (nil_use's `use` column), or the lookup's when the use
// is no call (a `send`), which a try covers with it.
.decl nil_use_caught(lookup: symbol, func: symbol)

nil_use_caught(lookup, f) :- nil_use(lookup, f, u, "error"), covered_by_catch(u, f, _, "error").

nil_use_caught(lookup, f) :-
  nil_use(lookup, f, u, "error"),
  try_covers(t, f, u, "try"),
  catch_tag(t, f, "error", ":badarg").

nil_use_caught(lookup, f) :- nil_use(lookup, f, u, "exit"), covered_by_catch(u, f, _, "exit").

nil_use_caught(lookup, f) :-
  nil_use(lookup, f, u, "any"),
  covered_by_catch(u, f, _, "error"),
  covered_by_catch(u, f, _, "exit").

// ══ Processes nobody watches ════════════════════════════════════════

// A bare spawn starts a process nothing monitors or links to, so its
// crash goes unnoticed.
.decl unwatched_spawn(func: symbol, spawn: symbol)

unwatched_spawn(func, spawn) :-
  bare_spawn(spawn, func),
  !watched_spawn(spawn).

orphan_process(func, spawn, "spawn", "", "") :-
  unwatched_spawn(func, spawn).

// A :proc_lib.start's process goes on past its ack, and nothing monitors
// or links to it.
.decl unwatched_start(func: symbol, start: symbol)

unwatched_start(func, start) :-
  proc_lib_start(start, func),
  lives_past_ack(start, func),
  !watched_spawn(start).

orphan_process(func, start, "start", "", "") :-
  unwatched_start(func, start).

// The call at `spawn` is a spawn with nothing of its own watching the
// process: not spawn_link or spawn_monitor (spawn_call's variant
// "spawn"). `spawn_call` carries its caller, so this analysis does not
// join `instruction`, the largest relation in the schema, to find it:
// that cost 1.56 s an edit on a 531-module project with no spawn at all.
.decl bare_spawn(spawn: symbol, func: symbol) inline

bare_spawn(spawn, func) :- spawn_call(spawn, func, _, _, _, "spawn", _, _, _, _).

// The call at `start` is a `:proc_lib.start` (spawn_call's variant
// "start"). It waits for the process's init_ack and hands back a failed
// start as a value, but the ack covers only the start: a worker that goes
// on to loop after it is as unwatched as one proc_lib:spawn started, and
// dies unnoticed.
.decl proc_lib_start(start: symbol, func: symbol) inline

proc_lib_start(start, func) :- spawn_call(start, func, _, _, _, "start", _, _, _, _).

// The process the start runs does more after its ack: not a process whose
// life ends at the ack, the start the caller waited on being all of it.
.decl lives_past_ack(start: symbol, func: symbol) inline

lives_past_ack(start, func) :-
  process_start(start, func, _, "spawn", started),
  !ends_at_ack(started).

// The started function acknowledges its start and then makes no call
// and no receive (start_acked has no row for it): it returns, and its
// process ends.
.decl ends_at_ack(func: symbol)

ends_at_ack(g) :-
  remote_call(_, g, ":proc_lib", "init_ack", _),
  !start_acked(_, g).

// A spawn whose process something monitors or links to afterwards
// (signals.dl): its crash is observed.
.decl watched_spawn(spawn: symbol)

watched_spawn(spawn) :-
  process_start(spawn, _, b, _, _),
  instance(p, b),
  watched_process(p, _).

// ── The belief the other call sites hold ────────────────────────
//
// No list says which results must be checked or which calls must be
// guarded; the program does. When every other site of a callee matches
// its result and one discards it, the one is the finding — the rule
// Engler et al. named "bugs as deviant behavior". The belief needs
// three agreeing sites before it counts, and the deviants must be a
// quarter or fewer of the population: three checked against three
// ignored is a convention, not a slip. In the result belief only the
// used and ignored fates take part: a tail call hands its result on and
// says nothing about it. In the exception belief every site takes part,
// a tail call too: what it raises reaches its callers, whose tries
// guard it as they guard any call in the function (guarded_by_callers).
//
// The population a site is judged in (`scope`) is its target's own
// sites — the table, the server, the name — when the site's first
// argument is a literal, and only then: mnesia reads its gvar table under
// a catch 120 times and its stats table bare once, on purpose; gvar's
// habit is not a belief about stats, and inet_db's guarded host lookups
// say nothing of the lookups mnesia, dets_server and digraph make on
// tables of their own. A process call whose target is the calling
// function's own parameter, in a module that runs a process loop — the
// client API of a GenServer or a gen_statem, `def checkout(pid, ...),
// do: :gen_statem.call(pid, ...)` — has one target too: that module's
// processes. A process call whose target a local helper builds
// (`via(id)`, `{:via, Registry, {reg, id}}`) is scoped by where it comes
// from: every call on what `via/1` makes names the same kind of server,
// and holds or breaks a belief about it. Any other
// site's target is not known, and it neither holds a belief nor breaks
// one.
//
// Whether a call can fail depends on its arguments, and a site that
// cannot takes no part either (`cannot_fail`): a send to anything but a
// registered name, an ETS operation that fails only on a missing table,
// made inside the process that created it in init/1 and never deletes
// it, and a lookup_element of a row the owner's init/1 always seeds and
// nothing removes. A call on a value that is never a literal — a send to
// a pid, a timer cancelled by its reference, with `async: true` or not —
// has no target, and so no population.
//
// Known limit: an Erlang macro's expansions (mnesia's `?catch_val`, one
// guarded lookup written once and expanded a hundred times) count as
// that many sites. The preprocessor gives the expansion the line of each
// use, and the BEAM keeps nothing that says a macro wrote it; keying the
// belief on the target bounds what such a count can decide.

// A site drops the callee's result where a clear majority of the callee's
// sites judged with it bind the result.
.decl ignored_where_most_are_used(func: symbol, site: symbol, callee: symbol, used: number, ignored: number, scope: symbol)

ignored_where_most_are_used(func, site, callee, used, ignored, scope) :-
  result_ignored(site, func, callee, scope),
  !returns_no_failure(callee),
  times_used(callee, scope, used),
  times_ignored(callee, scope, ignored),
  clear_majority(used, ignored),
  !reported_elsewhere(site).

// A site calls the callee with no try that takes what it raises, where a
// clear majority of the callee's sites judged with it are guarded.
.decl bare_where_most_are_guarded(func: symbol, site: symbol, callee: symbol, guarded: number, bare: number, scope: symbol)

bare_where_most_are_guarded(func, site, callee, guarded, bare, scope) :-
  called_bare(site, func, callee, scope),
  times_guarded(callee, scope, guarded),
  times_bare(callee, scope, bare),
  clear_majority(guarded, bare).

inconsistent_handling(func, site, callee, "result_checked", used, ignored, scope, "", "", "") :-
  ignored_where_most_are_used(func, site, callee, used, ignored, scope).

inconsistent_handling(func, site, callee, "exception_guarded", guarded, bare, scope, raises, cover, caught) :-
  bare_where_most_are_guarded(func, site, callee, guarded, bare, scope),
  call_result(site, func, callee, _, raises, _),
  bare_cover(site, cover, caught).

// A result is worth checking only if the callee can fail by returning:
// a callee whose spec names no failure value (`:ets.new/2` returns a
// table or raises, `:ets.delete/2` returns `true`) or never returns has
// nothing in its result for a site to miss, however many other sites
// happen to bind it. A callee with no spec is unknown and stays in: the
// spec may only quiet the rule. Every callee call_result counts ships
// specs, except the program's own start functions, whose OTP convention
// is {:ok, pid} | {:error, _}; so there is no table of hand-written
// shapes to keep.
.decl returns_no_failure(callee: symbol)

returns_no_failure(c) :- callee_returns(c, "total").
returns_no_failure(c) :- callee_returns(c, "no_return").

// A site unchecked_result or startup already owns is not reported twice.
.decl reported_elsewhere(site: symbol)

reported_elsewhere(site) :- unchecked_result(_, site, _, _).
reported_elsewhere(site) :- start_result_owned(site).

// A discarded start result is startup.ignored_start_result's finding,
// whatever the other sites do; the same site is not reported twice, by
// two concerns, under two titles.
.decl start_result_owned(site: symbol)

start_result_owned(site) :-
  ignored_error_result(site, _, callee),
  (contains(".start_link/", callee) ; contains(".start/", callee)).

// A call site in a function another module's macro wrote, every clause
// of it (macro_written, clientlib/generated.dl) — `use Ecto.Repo` defines
// `stop/1` in every repo, on the `use` line — or in a closure inside one
// is the macro's choice, not the module's: it neither holds a belief nor
// breaks one. The program's own macro is left out too, not only a
// library's (library_written): its expansion repeats one line of the
// macro in every module that uses it, and a belief would count that line
// once per use. A function whose first clause a `use` injected ahead of
// the module's own clauses is the module's. `guard` is "try" when a try
// takes what the call raises (guarded_site), else "bare".
.decl program_site(site: symbol, func: symbol, callee: symbol, fate: symbol, guard: symbol, target: symbol)

program_site(site, f, callee, fate, "try", t) :-
  program_call(site, f, callee, fate, t),
  guarded_site(site).

program_site(site, f, callee, fate, "bare", t) :-
  program_call(site, f, callee, fate, t),
  !guarded_site(site).

.decl program_call(site: symbol, func: symbol, callee: symbol, fate: symbol, target: symbol)

program_call(site, f, callee, fate, scope) :-
  call_result(site, f, callee, fate, _, _),
  enclosing_function(f, owner),
  !macro_written(owner),
  !cannot_fail(site),
  site_scope(site, scope).

// ── Whose convention a site is judged by ────────────────────────
.decl site_scope(site: symbol, scope: symbol)

site_scope(site, t) :- call_result(site, _, _, _, _, t), t != "".

site_scope(site, cat("processes of ", m)) :-
  call_result(site, f, callee, _, "exit", ""),
  call_arg_forward(f, callee, 0, _),
  function_def(f, m, _, _, _),
  behaves_as(m, b),
  process_behaviour(b, "loop").

// A target a local helper returns: what that helper builds.
site_scope(site, cat("what ", g, " returns")) :-
  call_result(site, f, _, _, "exit", ""),
  pid_call(site, f, _, "result", r),
  local_call(r, f, g, _).

// ── What a call's arguments rule out ────────────────────────────
.decl cannot_fail(site: symbol)

// A send raises only when its destination is a name nothing holds: a
// pid, a port or a {name, node} never raises. Only a literal atom is
// known to be a name; a send to anything else is taken to be to a pid.
cannot_fail(site) :-
  call_result(site, _, callee, _, _, t),
  sends(callee),
  !names_a_process(t).

// An ETS operation that fails only when the table is gone, made inside
// the process that created the named table: while the process runs, its
// table is there.
cannot_fail(site) :-
  call_result(site, f, callee, _, _, t),
  fails_on_missing_table(callee),
  in_owner(f, t).

// A lookup_element of a row the table's owner seeds and nothing removes.
cannot_fail(site) :-
  call_result(site, _, ":ets:lookup_element/3", _, _, t),
  ets_key(site, "literal", k),
  seeded_row(t, k).

.decl sends(callee: symbol)

sends(":erlang:send/2").
sends(":erlang:send/3").

// A literal destination that is an atom, not a tuple.
.decl names_a_process(target: symbol)

names_a_process(t) :- call_result(_, _, c, _, _, t), sends(c), t != "", !match("[{].*", t).

// The ETS operations that raise only on a missing table (or no access to
// it): not lookup_element or update_counter, which also raise on a
// missing row.
.decl fails_on_missing_table(callee: symbol)

fails_on_missing_table(":ets:delete/2").
fails_on_missing_table(":ets:delete/1").
fails_on_missing_table(":ets:insert/2").
fails_on_missing_table(":ets:insert_new/2").
fails_on_missing_table(":ets:lookup/2").
fails_on_missing_table(":ets:member/2").
fails_on_missing_table(":ets:delete_object/2").
fails_on_missing_table(":ets:match_delete/2").
fails_on_missing_table(":ets:select_delete/2").
fails_on_missing_table(":ets:take/2").

// `func` runs only in the process of module m that created the named
// table `t`: reached from m's callbacks in m's own process, from no other
// module's, and no caller outside those callbacks can call it (a private
// function, or one of m's callbacks). m creates the table on every path
// through its init/1, before the start returns and so before any
// callback runs, and nothing deletes it: a table made later (in a
// handle_call, on demand) or only when an option says so can be missing
// when a callback asks, and a table `:ets.delete/1` drops is missing
// after.
.init own = SameProcessReach

own.seed(f, f) :- ets_new(_, f, t), t != "dynamic".
own.seed(f, f) :- call_result(_, f, c, _, _, t), t != "", fails_on_missing_table(c).
own.seed(f, f) :- call_result(_, f, ":ets:lookup_element/3", _, _, _).

// What init/1 runs on every path through it, in its own process.
.decl init_always_runs(mod: symbol, func: symbol)

init_always_runs(m, i) :- init_function(m, i).

init_always_runs(m, g) :-
  init_always_runs(m, f),
  unconditional_call_edge(f, g),
  !runs_elsewhere(f, g),
  function_def(g, _, _, _, _).

.decl table_owner(table: symbol, mod: symbol)

table_owner(t, m) :-
  ets_new(n, g, t),
  t != "dynamic",
  !conditional_call(n),
  init_always_runs(m, g),
  !table_deleted(t).

.decl table_deleted(table: symbol)

table_deleted(t) :- ets_op(w, _, t, "delete", _), remote_call(w, _, ":ets", "delete", 1).

.decl reached_by_other(func: symbol, mod: symbol)

reached_by_other(f, m) :- table_owner(_, m), process_entry(m2, c), m2 != m, own.reaches(c, f).

.decl in_owner(func: symbol, table: symbol)

in_owner(f, t) :-
  table_owner(t, m),
  process_entry(m, c),
  own.reaches(c, f),
  !reached_by_other(f, m),
  (function_def(f, _, _, _, 0) ; process_entry(m, f)).

// A row the table's owner writes while it starts, on every path through
// its init/1 — in init/1, or in a function init/1 always runs — at a
// literal key, and that no operation removes: no delete, take or
// delete_object at that key or at one not known, no clearing of the
// table. An insert only some starts make (`if opts[:seed]`) seeds
// nothing a reader can count on.
.decl seeded_row(table: symbol, key: symbol)

seeded_row(t, k) :-
  table_owner(t, m),
  ets_op(w, g, t, op, "write"),
  (op = "insert" ; op = "insert_new"),
  ets_key(w, "literal", k),
  !conditional_call(w),
  init_always_runs(m, g),
  !removes_row(t, k).

.decl removes_row(table: symbol, key: symbol)

// A removal at the key, one at a key not known (it may be any of the
// table's literal keys), or one that clears every key: the last clause
// alone already names every literal key of a cleared table.
removes_row(t, k) :-
  ets_op(w, _, t, op, "write"),
  ets_key(w, "literal", k),
  ets_removal_op(op).

removes_row(t, k) :-
  ets_op(w, _, t, op, "write"),
  ets_key(w, ks, _),
  ks != "literal",
  ets_removal_op(op),
  ets_op(w2, _, t, _, _),
  ets_key(w2, "literal", k).

removes_row(t, k) :-
  ets_op(_, _, t, op, "write"),
  ets_removes_every_key(op),
  ets_op(w2, _, t, _, _),
  ets_key(w2, "literal", k).

own.seed(f, f) :- ets_op(_, f, t, _, "write"), t != "dynamic".

// ── What guards a call ──────────────────────────────────────────
//
// A try guards a call when it covers the call (try_covers: on a path
// from the try that has not passed its end, so not in its `else` or
// after it) and its handler takes the class the call raises when it
// fails (call_result's `raises`; try_takes, in exceptions.dl): an exit
// for a call into a process, an error for a BIF or an ETS operation. A
// try that takes nothing — an `after`, a rescue that re-raises — guards
// nothing, and neither does `catch :exit` around a badarg. Erlang's
// `catch Expr` takes every class.
.decl guarded_site(site: symbol)

guarded_site(site) :- guarded_here(site, _).

guarded_site(site) :-
  call_result(site, f, _, _, class, _),
  guarded_by_callers(f, class).

// The try in the site's own function that guards it, and where its
// handler ends: the evidence frame's span.
.decl guarded_here(site: symbol, span_end: symbol)

guarded_here(site, span_end) :-
  call_result(site, _, _, _, class, _),
  try_covers(id, _, site, _),
  try_takes(id, class),
  catch_class(id, _, _, span_end).

// ── A guard the callers hold ────────────────────────────────────
//
// A try guards what runs inside it in the same process, not only the
// calls written between its `try` and its `end`: a helper called only
// from inside `try ... rescue`, and a closure handed to Enum.each there,
// fail into that handler. So a site's function is guarded for a class
// when every way the program has into it passes a try that takes the
// class. An exported function is an entry: callers outside the program
// may call it bare. A closure built in a function that starts a process
// may run in that process instead, where no try of the builder's
// reaches, and so is an entry too.
//
// Computed as its complement: the functions some path from an entry
// reaches past no such try (ForwardUnguardedSet, in reach.dl).
.decl guarded_by_callers(func: symbol, class: symbol)

guarded_by_callers(f, class) :-
  called_internally(f),
  raised_class(class),
  !exposed.reaches(f, class).

// A private function the program calls, or a closure it builds: one
// with no way in is dead, not guarded.
.decl called_internally(func: symbol)

called_internally(g) :-
  call_instr(_, g, _),
  function_def(g, _, _, _, 0).

called_internally(g) :- closure_def(_, g).

// The classes the program's sites raise: what the walk asks about.
.decl raised_class(class: symbol)

raised_class(class) :- call_result(_, _, _, _, class, _).

.init exposed = ForwardUnguardedSet

exposed.root(f, class) :-
  api_export(f),
  raised_class(class).

exposed.root(g, class) :-
  closure_def(f, g),
  starts_process(f),
  raised_class(class).

exposed.guarded(call, class) :-
  try_covers(id, _, call, _),
  try_takes(id, class).

exposed.guarded_edge(f, g, class) :-
  try_covers_closure(id, f, g),
  try_takes(id, class).

// "try", a kind no call raises: whether a try of any kind — one that
// takes nothing included — stands on every way in. It tells a site no
// try reaches from one whose callers' tries take other classes.
exposed.root(f, "try") :- api_export(f).

exposed.root(g, "try") :-
  closure_def(f, g),
  starts_process(f).

exposed.guarded(call, "try") :- try_covers(_, _, call, _).

exposed.guarded_edge(f, g, "try") :- try_covers_closure(_, f, g).

.decl starts_process(func: symbol)

starts_process(f) :- process_start(_, f, _, kind, _), kind != "server".
starts_process(f) :- hands_funs_off(f).

.decl fate_count(callee: symbol, scope: symbol, fate: symbol, n: number)

fate_count(callee, t, fate, n) :-
  program_site(_, _, callee, fate, _, t),
  n = count : { program_site(_, _, callee, fate, _, t) }.

.decl guard_count(callee: symbol, scope: symbol, guard: symbol, n: number)

guard_count(callee, t, guard, n) :-
  program_site(_, _, callee, _, guard, t),
  n = count : { program_site(_, _, callee, _, guard, t) }.

// The program's belief is its clear majority: three or more sites that
// agree, and the deviants a quarter or fewer of the population.
.decl clear_majority(agree: number, deviate: number) inline

clear_majority(agree, deviate) :-
  agree >= 3,
  deviate * 4 <= agree + deviate.

// How many of the callee's sites in `scope` bind its result, drop it,
// guard the call with a try, or make it bare.
.decl times_used(callee: symbol, scope: symbol, n: number) inline
.decl times_ignored(callee: symbol, scope: symbol, n: number) inline
.decl times_guarded(callee: symbol, scope: symbol, n: number) inline
.decl times_bare(callee: symbol, scope: symbol, n: number) inline

times_used(c, t, n) :- fate_count(c, t, "used", n).
times_ignored(c, t, n) :- fate_count(c, t, "ignored", n).
times_guarded(c, t, n) :- guard_count(c, t, "try", n).
times_bare(c, t, n) :- guard_count(c, t, "bare", n).

// The one site in question, its result dropped or the call made bare,
// and the population (`scope`) it is judged in.
.decl result_ignored(site: symbol, func: symbol, callee: symbol, scope: symbol) inline
.decl called_bare(site: symbol, func: symbol, callee: symbol, scope: symbol) inline

result_ignored(site, f, c, scope) :-
  program_site(site, f, c, "ignored", _, _),
  judged_in(site, "result_checked", scope).

called_bare(site, f, c, scope) :-
  program_site(site, f, c, _, "bare", _),
  judged_in(site, "exception_guarded", scope).

// How each site stands with each belief, and on what target.
.decl stance(site: symbol, callee: symbol, belief: symbol, side: symbol, target: symbol)

stance(site, c, "result_checked", "agree", t) :- program_site(site, _, c, "used", _, t).
stance(site, c, "result_checked", "deviate", t) :- program_site(site, _, c, "ignored", _, t).
stance(site, c, "exception_guarded", "agree", t) :- program_site(site, _, c, _, "try", t).
stance(site, c, "exception_guarded", "deviate", t) :- program_site(site, _, c, _, "bare", t).

// A scope some of whose sites agree: a deviant in it is judged by its
// own.
.decl own_convention(callee: symbol, belief: symbol, scope: symbol)

own_convention(c, b, t) :- stance(_, c, b, "agree", t).

.decl judged_in(site: symbol, belief: symbol, scope: symbol)

judged_in(site, b, t) :-
  stance(site, c, b, "deviate", t),
  own_convention(c, b, t).

// ── How a bare site stands ──────────────────────────────────────
//
// What the finding says of a site no guard takes, each true of it:
// "try", a try in its own function covers it but takes other classes,
// or nothing (an `after`, a handler that raises again), and `caught`
// names what it does take, space-separated; "callers", no try covers it
// here, and every way into its function passes one, not all of which
// take the class; "none", no try covers it here, and some way in passes
// none.
.decl bare_cover(site: symbol, cover: symbol, caught: symbol)

bare_cover(site, "try", caught) :-
  deviant_site(site),
  try_covers(_, _, site, _),
  caught_upto(site, 3, caught).

bare_cover(site, "callers", "") :-
  deviant_site(site),
  !try_covers(_, _, site, _),
  program_call(site, f, _, _, _),
  covered_on_every_way_in(f).

bare_cover(site, "none", "") :-
  deviant_site(site),
  !try_covers(_, _, site, _),
  program_call(site, f, _, _, _),
  !covered_on_every_way_in(f).

.decl deviant_site(site: symbol)

deviant_site(site) :- bare_where_most_are_guarded(_, site, _, _, _, _).

.decl covered_on_every_way_in(func: symbol)

covered_on_every_way_in(f) :-
  called_internally(f),
  !exposed.reaches(f, "try").

// The classes the tries covering a deviant site take, joined in a fixed
// order: `caught_upto(site, i, s)` has looked at the first `i`.
.decl class_order(i: number, class: symbol)

class_order(0, "error").
class_order(1, "exit").
class_order(2, "throw").

.decl deviant_catches(site: symbol, class: symbol)

deviant_catches(site, class) :-
  deviant_site(site),
  try_covers(id, _, site, _),
  try_takes(id, class),
  class != "*".

.decl caught_upto(site: symbol, i: number, caught: symbol)

caught_upto(site, 0, "") :- deviant_site(site), try_covers(_, _, site, _).

caught_upto(site, i + 1, c) :-
  caught_upto(site, i, ""),
  class_order(i, c),
  deviant_catches(site, c).

caught_upto(site, i + 1, cat(s, " ", c)) :-
  caught_upto(site, i, s),
  s != "",
  class_order(i, c),
  deviant_catches(site, c).

caught_upto(site, i + 1, s) :-
  caught_upto(site, i, s),
  class_order(i, c),
  !deviant_catches(site, c).

// The sites that follow the convention, attached to the finding as its
// evidence: what the convention looks like, drawn from the
// population the deviant was judged against.
.decl handling_site(callee: symbol, belief: symbol, site: symbol, func: symbol, guard: symbol, guard_end: symbol, target: symbol)
.output handling_site

// `guard` is "here" for a try in the site's own function, with the
// handler's end, and "callers" for a site its callers guard.
handling_site(callee, "exception_guarded", site, f, "here", guard_end, t) :-
  inconsistent_handling(_, _, callee, "exception_guarded", _, _, t, _, _, _),
  program_site(site, f, callee, _, "try", t),
  guarded_here(site, guard_end).

handling_site(callee, "exception_guarded", site, f, "callers", "", t) :-
  inconsistent_handling(_, _, callee, "exception_guarded", _, _, t, _, _, _),
  program_site(site, f, callee, _, "try", t),
  !guarded_here(site, _).

handling_site(callee, "result_checked", site, f, "", "", t) :-
  inconsistent_handling(_, _, callee, "result_checked", _, _, t, _, _, _),
  program_site(site, f, callee, "used", _, t).
