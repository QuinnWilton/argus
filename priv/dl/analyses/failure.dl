// An error path swallowed, half-caught or ignored.
//
// A failure the code could have seen and did not: a rescue that keeps
// every exception, a remote call whose failure value nothing matches,
// a start result discarded, a lookup used without its nil case, a
// process spawned with nothing watching it, an exit signal sent from a
// callback past the supervisor that owns the target.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/signals.dl"
.include "../clientlib/specs.dl"
.include "../clientlib/vocabulary.dl"

// ══ The three outputs ═══════════════════════════════════════════════
//
// A failure the code could have seen and did not, in three shapes:
//
// `unhandled_failure(func, site, kind, shape)` — a failure value or
//   exception that nothing takes. `kind` is "rescue" (a catch-all rescue
//   discards the exception; site is the try), "erpc_transport" (a
//   rescue around :erpc.call has no clause for transport failures; site
//   is the guarded call), or the rpc variant "rpc" | "block_call" |
//   "yield" | "multicall" | "erpc" whose
//   result is matched by shape with no {:badrpc, _} clause (`shape` =
//   "case") or used as a boolean (`shape` = "boolean"); site is the call.
// `unchecked_result(func, site, api, name)` — a result used without its
//   failure case: Task.Supervisor.start_child discarded, or a
//   Process.whereis of `name` used without its nil case.
// `orphan_process(func, site, kind, target, callback)` — a process
//   nothing supervises: a bare spawn (`kind` = "spawn", site is the
//   call) or an exit signal sent to `target` from a callback, past the
//   supervisor that owns it (`kind` = "exit", site is the exit call,
//   `func` the function making it and `callback` a callback running it).
.decl unhandled_failure(func: symbol, site: symbol, kind: symbol, shape: symbol, span_end: symbol)
.output unhandled_failure

.decl unchecked_result(func: symbol, site: symbol, api: symbol, name: symbol)
.output unchecked_result

.decl orphan_process(func: symbol, site: symbol, kind: symbol, target: symbol, callback: symbol)
.output orphan_process

.decl inconsistent_handling(func: symbol, site: symbol, callee: symbol, belief: symbol, agree: number, deviate: number, target: symbol, raises: symbol, cover: symbol, caught: symbol)
.output inconsistent_handling

// ── Swallowed errors ─────────────────────────────────────────────

// Catch-all rescue that silently discards exceptions: around the
// program's own logic, where it turns a bug into silence. A try that
// protects only sends, signals, calls into other processes and name
// operations (try_boundary) takes a dead peer, a timeout or a taken
// name, which is what it was written to tolerate, and the peer that
// crashed logged its own crash.
unhandled_failure(func, id, "rescue", "", guard_end) :-
  bare_rescue(id, func, guard_end),
  !try_boundary(id, func).

// ── Exit in GenServer callback ───────────────────────────────────

// Only exit *signals* — Process.exit/2, :erlang.exit/2 — count here.
// `:erlang.exit/1` (target "self") *raises* an exit in the current
// process: the "let it crash on an impossible state" idiom
// (`exit(:unexpected_checkout)`) and ordinary client-call failure
// propagation, both fully supervision-visible and not a bypass. It is
// excluded via `target != "self"`, the sentinel the extractor uses for
// the /1 form. The exit is the callback's own or in what the callback
// runs in its own process.
.init exit_reach = SameProcessReach

exit_reach.seed(g, id) :- exit_call(id, g, target), target != "self".

.decl callback_exit(func: symbol, id: symbol, target: symbol)

callback_exit(func, id, target) :-
  handler_function(_, func),
  exit_reach.reaches(func, id),
  exit_call(id, _, target).

// Where process points-to (signals.dl) resolves the signal: a process
// the sending module started itself — a helper kept in the state, a
// worker it spawned — is its own to stop, and a child a supervisor
// owns is the bypass the finding is about, named with its supervisor.
.decl exit_to_supervised(id: symbol, child: symbol, sup: symbol)

exit_to_supervised(id, child, sup) :-
  signal_target(id, _, "exit", p),
  supervised_process(p, sup, pos),
  supervisor_child(sup, pos, child, _, _).

// One finding per exit call, in the function that makes it, whichever
// callbacks run it: Exq's Redis connection helper kills the connection
// on a failover from every server that queries Redis, and that is one
// exit, not ten. `callback` is one of the callbacks that reach it (the
// finding keeps the least).
orphan_process(g, id, "exit", target, callback) :-
  callback_exit(callback, id, target),
  exit_call(id, g, target),
  !exit_to_own_process(id, _),
  !exit_to_supervised(id, _, _).

orphan_process(g, id, "exit", child, callback) :-
  callback_exit(callback, id, _),
  exit_call(id, g, _),
  exit_to_supervised(id, child, _).

// The supervisor that owns an exit's target: evidence on its finding.
.decl exit_target_owner(func: symbol, target: symbol, sup: symbol, sup_site: symbol)
.output exit_target_owner

exit_target_owner(g, child, sup, sup_site) :-
  callback_exit(_, id, _),
  exit_call(id, g, _),
  exit_to_supervised(id, child, sup),
  supervisor_site(sup, sup_site).

// ══ Remote calls whose failure is not a value ═══════════════════════
unhandled_failure(func, call, "erpc_transport", "", guard_end) :-
  try_call(id, func, callee, call, guard_end),
  (callee = ":erpc:call/4" ; callee = ":erpc:call/5"),
  catch_tag(id, func, "error", ":exception"),
  !catch_tag(id, func, "error", ":erpc"),
  catch_falls_through(id, func, ":exception").

// ── An rpc result that is not a value ─────────────────────────────────
//
// :rpc.call answers a node that is gone with {:badrpc, :nodedown} (a
// timeout, a remote exit: {:badrpc, reason} too). Matched by shape with
// no clause for it, that is a CaseClauseError (rabbitmq-cli#193,
// phoenix_live_dashboard#218, livebook#972); tested as a boolean it is
// TRUE — `member?(n) && :rpc.call(n, Process, :alive?, [pid])` says the
// process on a gone node is alive (horde, until 30bb1a1). :erpc.call
// raises instead, so in a boolean context it needs a rescue (horde's
// fix: catch {:erpc, :noconnection} -> false).
unhandled_failure(f, id, v, "case", "") :-
  rpc_call(id, f, v, _),
  answers_badrpc(v),
  rpc_result(id, f, "case").

// The :rpc forms whose answer is the {:badrpc, _} itself: call,
// block_call, the yield that collects an async_call, and multicall
// (whose failures are its bad-nodes list; the shape a rule matches is
// the pair). nb_yield wraps the answer in {:value, _}, so a case over it
// has a clause for the wrapper, and the badrpc it leaves out is nested:
// not this rule's shape.
.decl answers_badrpc(variant: symbol)

answers_badrpc("rpc").
answers_badrpc("block_call").
answers_badrpc("yield").
answers_badrpc("multicall").

// Used as a boolean: tested against true/false/nil after the call, or
// returned as the result of a predicate (a function named `...?`), whose
// callers test it.
.decl rpc_boolean_use(id: symbol, func: symbol)

rpc_boolean_use(id, f) :- rpc_result(id, f, "boolean").

rpc_boolean_use(id, f) :-
  rpc_result(id, f, "returned"),
  function_def(f, _, name, _, _),
  match(".*\\?", name).

unhandled_failure(f, id, v, "boolean", "") :-
  rpc_call(id, f, v, _),
  answers_badrpc(v),
  rpc_boolean_use(id, f).

unhandled_failure(f, id, "erpc", "boolean", "") :-
  rpc_call(id, f, "erpc", _),
  rpc_boolean_use(id, f),
  !catches_class(f, "error"),
  !catch_tag(_, f, "error", ":erpc").

// ══ Results discarded ═══════════════════════════════════════════════

// ── Task.Supervisor.start_child detection ──────────────────────────────

.decl task_start_child_call(func: symbol, id: symbol)

task_start_child_call(func, id) :-
  remote_call(id, func, "Task.Supervisor", "start_child", _).

// ── Unchecked start_child ──────────────────────────────────────────────

// A start_child call whose result is checked: either in tail position
// (result propagated to caller) or followed by a branch instruction in
// the same function (result pattern-matched).
.decl start_child_result_checked(func: symbol, id: symbol)

// Tail position: result goes to the caller.
start_child_result_checked(func, id) :-
  task_start_child_call(func, id),
  tail_call(id).

// Branch after start_child: result is pattern-matched.
//
// `call_followed_by_branch` is emitted by the extractor and holds exactly
// what the two `instruction` joins used to compute: this call has some
// branch later in its function. Asking Datalog to compare two instruction
// INDEXES meant joining `instruction` — 343k rows on a 531-module project,
// rewritten whenever any function body changes — to answer a yes/no
// question, and it made unsafe_task the last analysis reading that
// relation and by far the most expensive one.
//
// The predicate is as coarse as it ever was: a branch anywhere later in
// the function counts, including one in an unrelated clause, so this is a
// weak proxy for "the result was pattern-matched". That weakness is
// preserved on purpose — moving where it is computed must not change what
// it computes. Sharpening it (asking whether the call's result register is
// actually inspected, which the extractor helpers can do) changes findings
// and belongs in its own commit.
start_child_result_checked(func, id) :-
  task_start_child_call(func, id),
  call_followed_by_branch(id).

// start_child call whose result is not checked by any of the above.
unchecked_result(func, id, "Task.Supervisor.start_child", "") :-
  task_start_child_call(func, id),
  !start_child_result_checked(func, id).

// ══ Processes nobody watches ════════════════════════════════════════

orphan_process(func, id, "spawn", "", "") :-
  spawn_call(id, func, _, _, _, "spawn", _, _, _, _),
  !watched_spawn(id).

// A spawn whose process something monitors or links to afterwards
// (signals.dl): its crash is observed.
.decl watched_spawn(id: symbol)

watched_spawn(id) :-
  process_start(id, _, b, _, _),
  instance(p, b),
  watched_process(p, _).

// This analysis used to join `instruction(id, func, _, _)` purely to
// recover the spawning function. Its input set was therefore
// {instruction, spawn_call} — and `instruction` is the largest relation in
// the schema. On a 531-module project that is 343,352 rows serialized and
// re-read to accompany a `spawn_call` relation with ZERO rows: 1.56s per
// edit to look at nothing. `spawn_call` now carries its caller.

unchecked_result(func, id, "Process.whereis", name) :-
  name_lookup(id, func, "whereis", _, "literal", name, "unchecked"),
  !nil_use_caught(id, func).

// A lookup inside a try that takes the badarg a BIF raises on a nil or
// :undefined pid (`process_info(whereis(n), ...)` under `catch
// error:badarg`, rabbit_vm's memory/0): its missing case is handled
// where it is used. Only the error class: a call to the name exits
// instead, and that is not what these catches take.
.decl nil_use_caught(id: symbol, func: symbol)

nil_use_caught(id, f) :- covered_by_catch(id, f, _, "error").
nil_use_caught(id, f) :- try_covers(t, f, id, "try"), catch_tag(t, f, "error", ":badarg").

// ── The belief the other call sites hold ────────────────────────
//
// No list says which results must be checked or which calls must be
// guarded; the program does. When every other site of a callee matches
// its result and one discards it, the one is the finding — the rule
// Engler et al. named "bugs as deviant behavior". The belief needs
// three agreeing sites before it counts, and the deviants must be a
// quarter or fewer of the population: three checked against three
// ignored is a convention, not a slip. In the result belief only the
// used and ignored fates take part: a tail call hands its result on and
// says nothing about it. In the exception belief every site takes part,
// a tail call too: what it raises reaches its callers, whose tries
// guard it as they guard any call in the function (guarded_by_callers).
//
// The population a site is judged in (`scope`) is its target's own
// sites — the table, the server, the name — when the site's first
// argument is a literal, and only then: mnesia reads its gvar table under
// a catch 120 times and its stats table bare once, on purpose; gvar's
// habit is not a belief about stats, and inet_db's guarded host lookups
// say nothing of the lookups mnesia, dets_server and digraph make on
// tables of their own. A process call whose target is the calling
// function's own parameter, in a module that runs a process loop — the
// client API of a GenServer or a gen_statem, `def checkout(pid, ...),
// do: :gen_statem.call(pid, ...)` — has one target too: that module's
// processes. Any other site's target is not known, and it neither holds a
// belief nor breaks one.
//
// Whether a call can fail depends on its arguments, and a site that
// cannot takes no part either (`cannot_fail`): a send to anything but a
// registered name, an ETS operation that fails only on a missing table,
// made inside the process that owns the table, and a lookup_element of a
// row the owner seeds and nothing removes. A call on a value that is
// never a literal — a send to a pid, a timer cancelled by its reference,
// with `async: true` or not — has no target, and so no population.
//
// Known limit: an Erlang macro's expansions (mnesia's `?catch_val`, one
// guarded lookup written once and expanded a hundred times) count as
// that many sites. The preprocessor gives the expansion the line of each
// use, and the BEAM keeps nothing that says a macro wrote it; keying the
// belief on the target bounds what such a count can decide.

// A call site in a function another module's macro wrote — `use
// Ecto.Repo` defines `stop/1` in every repo, on the `use` line — or in a
// closure inside one is the library's choice, not the program's: it
// neither holds a belief nor breaks one. `guard` is "try" when a try
// takes what the call raises (guarded_site), else "bare".
.decl program_site(site: symbol, func: symbol, callee: symbol, fate: symbol, guard: symbol, target: symbol)

program_site(site, f, callee, fate, "try", t) :-
  program_call(site, f, callee, fate, t),
  guarded_site(site).

program_site(site, f, callee, fate, "bare", t) :-
  program_call(site, f, callee, fate, t),
  !guarded_site(site).

.decl program_call(site: symbol, func: symbol, callee: symbol, fate: symbol, target: symbol)

program_call(site, f, callee, fate, scope) :-
  call_result(site, f, callee, fate, _, _),
  enclosing_function(f, owner),
  !macro_generated(owner, _),
  !cannot_fail(site),
  site_scope(site, scope).

// ── Whose convention a site is judged by ────────────────────────
.decl site_scope(site: symbol, scope: symbol)

site_scope(site, t) :- call_result(site, _, _, _, _, t), t != "".

site_scope(site, cat("processes of ", m)) :-
  call_result(site, f, callee, _, "exit", ""),
  call_arg_forward(f, callee, 0, _),
  function_def(f, m, _, _, _),
  behaves_as(m, b),
  process_behaviour(b, "loop").

// ── What a call's arguments rule out ────────────────────────────
.decl cannot_fail(site: symbol)

// A send raises only when its destination is a name nothing holds: a
// pid, a port or a {name, node} never raises. Only a literal atom is
// known to be a name; a send to anything else is taken to be to a pid.
cannot_fail(site) :-
  call_result(site, _, callee, _, _, t),
  sends(callee),
  !names_a_process(t).

// An ETS operation that fails only when the table is gone, made inside
// the process that created the named table: while the process runs, its
// table is there.
cannot_fail(site) :-
  call_result(site, f, callee, _, _, t),
  fails_on_missing_table(callee),
  in_owner(f, t).

// A lookup_element of a row the table's owner seeds and nothing removes.
cannot_fail(site) :-
  call_result(site, _, ":ets:lookup_element/3", _, _, t),
  ets_key(site, "literal", k),
  seeded_row(t, k).

.decl sends(callee: symbol)

sends(":erlang:send/2").
sends(":erlang:send/3").

// A literal destination that is an atom, not a tuple.
.decl names_a_process(target: symbol)

names_a_process(t) :- call_result(_, _, c, _, _, t), sends(c), t != "", !match("[{].*", t).

// The ETS operations that raise only on a missing table (or no access to
// it): not lookup_element or update_counter, which also raise on a
// missing row.
.decl fails_on_missing_table(callee: symbol)

fails_on_missing_table(":ets:delete/2").
fails_on_missing_table(":ets:delete/1").
fails_on_missing_table(":ets:insert/2").
fails_on_missing_table(":ets:insert_new/2").
fails_on_missing_table(":ets:lookup/2").
fails_on_missing_table(":ets:member/2").
fails_on_missing_table(":ets:delete_object/2").
fails_on_missing_table(":ets:match_delete/2").
fails_on_missing_table(":ets:select_delete/2").
fails_on_missing_table(":ets:take/2").

// `func` runs only in the process of module m that created the named
// table `t`: reached from m's callbacks in m's own process, from no other
// module's, and no caller outside those callbacks can call it (a private
// function, or one of m's callbacks).
.init own = SameProcessReach

own.seed(f, f) :- ets_new(_, f, t), t != "dynamic".
own.seed(f, f) :- call_result(_, f, c, _, _, t), t != "", fails_on_missing_table(c).
own.seed(f, f) :- call_result(_, f, ":ets:lookup_element/3", _, _, _).

.decl table_owner(table: symbol, mod: symbol)

table_owner(t, m) :- ets_new(_, g, t), t != "dynamic", process_entry(m, c), own.reaches(c, g).

.decl reached_by_other(func: symbol, mod: symbol)

reached_by_other(f, m) :- table_owner(_, m), process_entry(m2, c), m2 != m, own.reaches(c, f).

.decl in_owner(func: symbol, table: symbol)

in_owner(f, t) :-
  table_owner(t, m),
  process_entry(m, c),
  own.reaches(c, f),
  !reached_by_other(f, m),
  (function_def(f, _, _, _, 0) ; process_entry(m, f)).

// A row the table's owner writes while it starts — in init/1, or in a
// function init/1 runs — at a literal key, and that no operation removes:
// no delete, take or delete_object at that key or at one not known, no
// clearing of the table.
.decl seeded_row(table: symbol, key: symbol)

seeded_row(t, k) :-
  ets_op(w, g, t, op, "write"),
  (op = "insert" ; op = "insert_new"),
  ets_key(w, "literal", k),
  init_function(_, i),
  own.reaches(i, g),
  !removes_row(t, k).

.decl removes_row(table: symbol, key: symbol)

removes_row(t, k) :-
  ets_op(w, _, t, op, "write"),
  ets_key(w, "literal", k),
  (op = "delete" ; op = "take" ; op = "delete_object").

removes_row(t, k) :-
  ets_op(w, _, t, op, "write"),
  ets_key(w, ks, _),
  ks != "literal",
  (op = "delete" ; op = "take" ; op = "delete_object"),
  ets_op(w2, _, t, _, _),
  ets_key(w2, "literal", k).

removes_row(t, k) :-
  ets_op(_, _, t, op, "write"),
  (op = "delete_all_objects" ; op = "select_delete" ; op = "match_delete"),
  ets_op(w2, _, t, _, _),
  ets_key(w2, "literal", k).

own.seed(f, f) :- ets_op(_, f, t, _, "write"), t != "dynamic".

// ── What guards a call ──────────────────────────────────────────
//
// A try guards a call when it covers the call (try_covers: on a path
// from the try that has not passed its end, so not in its `else` or
// after it) and its handler takes the class the call raises when it
// fails (call_result's `raises`; try_takes, in exceptions.dl): an exit
// for a call into a process, an error for a BIF or an ETS operation. A
// try that takes nothing — an `after`, a rescue that re-raises — guards
// nothing, and neither does `catch :exit` around a badarg. Erlang's
// `catch Expr` takes every class.
.decl guarded_site(site: symbol)

guarded_site(site) :- guarded_here(site, _).

guarded_site(site) :-
  call_result(site, f, _, _, class, _),
  guarded_by_callers(f, class).

// The try in the site's own function that guards it, and where its
// handler ends: the evidence frame's span.
.decl guarded_here(site: symbol, span_end: symbol)

guarded_here(site, span_end) :-
  call_result(site, _, _, _, class, _),
  try_covers(id, _, site, _),
  try_takes(id, class),
  catch_class(id, _, _, span_end).

// ── A guard the callers hold ────────────────────────────────────
//
// A try guards what runs inside it in the same process, not only the
// calls written between its `try` and its `end`: a helper called only
// from inside `try ... rescue`, and a closure handed to Enum.each there,
// fail into that handler. So a site's function is guarded for a class
// when every way the program has into it passes a try that takes the
// class. An exported function is an entry: callers outside the program
// may call it bare. A closure built in a function that starts a process
// may run in that process instead, where no try of the builder's
// reaches, and so is an entry too.
//
// Computed as its complement: the functions some path from an entry
// reaches past no such try (ForwardUnguardedSet, in reach.dl).
.decl guarded_by_callers(func: symbol, class: symbol)

guarded_by_callers(f, class) :-
  called_internally(f),
  raised_class(class),
  !exposed.reaches(f, class).

// A private function the program calls, or a closure it builds: one
// with no way in is dead, not guarded.
.decl called_internally(func: symbol)

called_internally(g) :-
  call_instr(_, g, _),
  function_def(g, _, _, _, 0).

called_internally(g) :- closure_def(_, g).

// The classes the program's sites raise: what the walk asks about.
.decl raised_class(class: symbol)

raised_class(class) :- call_result(_, _, _, _, class, _).

.init exposed = ForwardUnguardedSet

exposed.root(f, class) :-
  function_def(f, _, _, _, 1),
  raised_class(class).

exposed.root(g, class) :-
  closure_def(f, g),
  starts_process(f),
  raised_class(class).

exposed.guarded(call, class) :-
  try_covers(id, _, call, _),
  try_takes(id, class).

exposed.guarded_edge(f, g, class) :-
  try_covers_closure(id, f, g),
  try_takes(id, class).

// "try", a kind no call raises: whether a try of any kind — one that
// takes nothing included — stands on every way in. It tells a site no
// try reaches from one whose callers' tries take other classes.
exposed.root(f, "try") :- function_def(f, _, _, _, 1).

exposed.root(g, "try") :-
  closure_def(f, g),
  starts_process(f).

exposed.guarded(call, "try") :- try_covers(_, _, call, _).

exposed.guarded_edge(f, g, "try") :- try_covers_closure(_, f, g).

.decl starts_process(func: symbol)

starts_process(f) :- process_start(_, f, _, kind, _), kind != "server".
starts_process(f) :- hands_funs_off(f).

.decl fate_count(callee: symbol, scope: symbol, fate: symbol, n: number)

fate_count(callee, t, fate, n) :-
  program_site(_, _, callee, fate, _, t),
  n = count : { program_site(_, _, callee, fate, _, t) }.

.decl guard_count(callee: symbol, scope: symbol, guard: symbol, n: number)

guard_count(callee, t, guard, n) :-
  program_site(_, _, callee, _, guard, t),
  n = count : { program_site(_, _, callee, _, guard, t) }.

// A result is worth checking only if the callee can fail by returning:
// a callee whose spec names no failure value (`:ets.new/2` returns a
// table or raises, `:ets.delete/2` returns `true`) or never returns has
// nothing in its result for a site to miss, however many other sites
// happen to bind it. A callee with no spec is unknown and stays in: the
// spec may only quiet the rule. Every callee call_result counts ships
// specs, except the program's own start functions, whose OTP convention
// is {:ok, pid} | {:error, _}; so there is no table of hand-written
// shapes to keep.
.decl result_uncheckable(callee: symbol)

result_uncheckable(c) :- callee_returns(c, "total").
result_uncheckable(c) :- callee_returns(c, "no_return").

// A discarded start result is startup.ignored_start_result's finding,
// whatever the other sites do; the same site is not reported twice, by
// two concerns, under two titles.
.decl start_result_owned(site: symbol)

start_result_owned(site) :-
  ignored_error_result(site, _, callee),
  (contains(".start_link/", callee) ; contains(".start/", callee)).

// The program's belief is its clear majority: three or more sites that
// agree, and the deviants a quarter or fewer of the population.
.decl clear_majority(agree: number, deviate: number) inline

clear_majority(agree, deviate) :-
  agree >= 3,
  deviate * 4 <= agree + deviate.

// How many of the callee's sites in `scope` bind its result, drop it,
// guard the call with a try, or make it bare.
.decl times_used(callee: symbol, scope: symbol, n: number) inline
.decl times_ignored(callee: symbol, scope: symbol, n: number) inline
.decl times_guarded(callee: symbol, scope: symbol, n: number) inline
.decl times_bare(callee: symbol, scope: symbol, n: number) inline

times_used(c, t, n) :- fate_count(c, t, "used", n).
times_ignored(c, t, n) :- fate_count(c, t, "ignored", n).
times_guarded(c, t, n) :- guard_count(c, t, "try", n).
times_bare(c, t, n) :- guard_count(c, t, "bare", n).

// The one site in question, its result dropped or the call made bare,
// and the population (`scope`) it is judged in.
.decl result_ignored(site: symbol, func: symbol, callee: symbol, scope: symbol) inline
.decl called_bare(site: symbol, func: symbol, callee: symbol, scope: symbol) inline

result_ignored(site, f, c, scope) :-
  program_site(site, f, c, "ignored", _, _),
  judged_in(site, "result_checked", scope).

called_bare(site, f, c, scope) :-
  program_site(site, f, c, _, "bare", _),
  judged_in(site, "exception_guarded", scope).

// How each site stands with each belief, and on what target.
.decl stance(site: symbol, callee: symbol, belief: symbol, side: symbol, target: symbol)

stance(site, c, "result_checked", "agree", t) :- program_site(site, _, c, "used", _, t).
stance(site, c, "result_checked", "deviate", t) :- program_site(site, _, c, "ignored", _, t).
stance(site, c, "exception_guarded", "agree", t) :- program_site(site, _, c, _, "try", t).
stance(site, c, "exception_guarded", "deviate", t) :- program_site(site, _, c, _, "bare", t).

// A scope some of whose sites agree: a deviant in it is judged by its
// own.
.decl own_convention(callee: symbol, belief: symbol, scope: symbol)

own_convention(c, b, t) :- stance(_, c, b, "agree", t).

.decl judged_in(site: symbol, belief: symbol, scope: symbol)

judged_in(site, b, t) :-
  stance(site, c, b, "deviate", t),
  own_convention(c, b, t).

inconsistent_handling(func, site, callee, "result_checked", used, ignored, scope, "", "", "") :-
  ignored_where_most_are_used(func, site, callee, used, ignored, scope).

inconsistent_handling(func, site, callee, "exception_guarded", guarded, bare, scope, raises, cover, caught) :-
  bare_where_most_are_guarded(func, site, callee, guarded, bare, scope),
  call_result(site, func, callee, _, raises, _),
  bare_cover(site, cover, caught).

// ── How a bare site stands ──────────────────────────────────────
//
// What the finding says of a site no guard takes, each true of it:
// "try", a try in its own function covers it but takes other classes,
// or nothing (an `after`, a handler that raises again), and `caught`
// names what it does take, space-separated; "callers", no try covers it
// here, and every way into its function passes one, not all of which
// take the class; "none", no try covers it here, and some way in passes
// none.
.decl bare_cover(site: symbol, cover: symbol, caught: symbol)

bare_cover(site, "try", caught) :-
  deviant_site(site),
  try_covers(_, _, site, _),
  caught_upto(site, 3, caught).

bare_cover(site, "callers", "") :-
  deviant_site(site),
  !try_covers(_, _, site, _),
  program_call(site, f, _, _, _),
  covered_on_every_way_in(f).

bare_cover(site, "none", "") :-
  deviant_site(site),
  !try_covers(_, _, site, _),
  program_call(site, f, _, _, _),
  !covered_on_every_way_in(f).

.decl deviant_site(site: symbol)

deviant_site(site) :- bare_where_most_are_guarded(_, site, _, _, _, _).

.decl covered_on_every_way_in(func: symbol)

covered_on_every_way_in(f) :-
  called_internally(f),
  !exposed.reaches(f, "try").

// The classes the tries covering a deviant site take, joined in a fixed
// order: `caught_upto(site, i, s)` has looked at the first `i`.
.decl class_order(i: number, class: symbol)

class_order(0, "error").
class_order(1, "exit").
class_order(2, "throw").

.decl deviant_catches(site: symbol, class: symbol)

deviant_catches(site, class) :-
  deviant_site(site),
  try_covers(id, _, site, _),
  try_takes(id, class),
  class != "*".

.decl caught_upto(site: symbol, i: number, caught: symbol)

caught_upto(site, 0, "") :- deviant_site(site), try_covers(_, _, site, _).

caught_upto(site, i + 1, c) :-
  caught_upto(site, i, ""),
  class_order(i, c),
  deviant_catches(site, c).

caught_upto(site, i + 1, cat(s, " ", c)) :-
  caught_upto(site, i, s),
  s != "",
  class_order(i, c),
  deviant_catches(site, c).

caught_upto(site, i + 1, s) :-
  caught_upto(site, i, s),
  class_order(i, c),
  !deviant_catches(site, c).

// A site unchecked_result or startup already owns is not reported twice.
.decl ignored_where_most_are_used(func: symbol, site: symbol, callee: symbol, used: number, ignored: number, scope: symbol)

ignored_where_most_are_used(func, site, callee, used, ignored, scope) :-
  result_ignored(site, func, callee, scope),
  !result_uncheckable(callee),
  times_used(callee, scope, used),
  times_ignored(callee, scope, ignored),
  clear_majority(used, ignored),
  !unchecked_result(func, site, _, _),
  !start_result_owned(site).

.decl bare_where_most_are_guarded(func: symbol, site: symbol, callee: symbol, guarded: number, bare: number, scope: symbol)

bare_where_most_are_guarded(func, site, callee, guarded, bare, scope) :-
  called_bare(site, func, callee, scope),
  times_guarded(callee, scope, guarded),
  times_bare(callee, scope, bare),
  clear_majority(guarded, bare).

// The sites that follow the convention, attached to the finding as its
// evidence: what the convention looks like, drawn from the
// population the deviant was judged against.
.decl handling_site(callee: symbol, belief: symbol, site: symbol, func: symbol, guard: symbol, guard_end: symbol, target: symbol)
.output handling_site

// `guard` is "here" for a try in the site's own function, with the
// handler's end, and "callers" for a site its callers guard.
handling_site(callee, "exception_guarded", site, f, "here", guard_end, t) :-
  inconsistent_handling(_, _, callee, "exception_guarded", _, _, t, _, _, _),
  program_site(site, f, callee, _, "try", t),
  guarded_here(site, guard_end).

handling_site(callee, "exception_guarded", site, f, "callers", "", t) :-
  inconsistent_handling(_, _, callee, "exception_guarded", _, _, t, _, _, _),
  program_site(site, f, callee, _, "try", t),
  !guarded_here(site, _).

handling_site(callee, "result_checked", site, f, "", "", t) :-
  inconsistent_handling(_, _, callee, "result_checked", _, _, t, _, _, _),
  program_site(site, f, callee, "used", _, t).
