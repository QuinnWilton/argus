// An error path swallowed, half-caught or ignored.
//
// A failure the code could have seen and did not: a rescue that keeps
// every exception, a remote call whose failure value nothing matches,
// a start result discarded, a lookup used without its nil case, a
// process spawned with nothing watching it, an exit signal sent from a
// callback past the supervisor that owns the target.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/signals.dl"
.include "../clientlib/specs.dl"
.include "../clientlib/vocabulary.dl"

// ══ The three outputs ═══════════════════════════════════════════════
//
// A failure the code could have seen and did not, in three shapes:
//
// `unhandled_failure(func, site, kind, shape)` — a failure value or
//   exception that nothing takes. `kind` is "rescue" (a catch-all rescue
//   discards the exception; site is the try), "erpc_transport" (a
//   rescue around :erpc.call has no clause for transport failures; site
//   is the guarded call), or the rpc variant "rpc" | "multicall" | "erpc" whose
//   result is matched by shape with no {:badrpc, _} clause (`shape` =
//   "case") or used as a boolean (`shape` = "boolean"); site is the call.
// `unchecked_result(func, site, api, name)` — a result used without its
//   failure case: Task.Supervisor.start_child discarded, or a
//   Process.whereis of `name` used without its nil case.
// `orphan_process(func, site, kind, target)` — a process nothing
//   supervises: a bare spawn (`kind` = "spawn", site is the call) or an
//   exit signal sent to `target` from a callback, past the supervisor
//   that owns it (`kind` = "exit", site is the callback).
.decl unhandled_failure(func: symbol, site: symbol, kind: symbol, shape: symbol, span_end: symbol)
.output unhandled_failure

.decl unchecked_result(func: symbol, site: symbol, api: symbol, name: symbol)
.output unchecked_result

.decl orphan_process(func: symbol, site: symbol, kind: symbol, target: symbol)
.output orphan_process

.decl inconsistent_handling(func: symbol, site: symbol, callee: symbol, belief: symbol, agree: number, deviate: number, target: symbol)
.output inconsistent_handling

// ── Swallowed errors ─────────────────────────────────────────────

// Catch-all rescue that silently discards exceptions.
unhandled_failure(func, id, "rescue", "", guard_end) :-
  bare_rescue(id, func, guard_end).

// ── Exit in GenServer callback ───────────────────────────────────

// Only exit *signals* — Process.exit/2, :erlang.exit/2 — count here.
// `:erlang.exit/1` (target "self") *raises* an exit in the current
// process: the "let it crash on an impossible state" idiom
// (`exit(:unexpected_checkout)`) and ordinary client-call failure
// propagation, both fully supervision-visible and not a bypass. It is
// excluded via `target != "self"`, the sentinel the extractor uses for
// the /1 form. The exit is the callback's own or in what the callback
// runs in its own process.
.init exit_reach = SameProcessReach

exit_reach.seed(g, id) :- exit_call(id, g, target), target != "self".

.decl callback_exit(func: symbol, id: symbol, target: symbol)

callback_exit(func, id, target) :-
  handler_function(_, func),
  exit_reach.reaches(func, id),
  exit_call(id, _, target).

// Where process points-to (signals.dl) resolves the signal: a process
// the sending module started itself — a helper kept in the state, a
// worker it spawned — is its own to stop, and a child a supervisor
// owns is the bypass the finding is about, named with its supervisor.
.decl exit_to_supervised(id: symbol, child: symbol, sup: symbol)

exit_to_supervised(id, child, sup) :-
  signal_target(id, _, "exit", p),
  supervised_process(p, sup, pos),
  supervisor_child(sup, pos, child, _, _).

orphan_process(func, func, "exit", target) :-
  callback_exit(func, id, target),
  !exit_to_own_process(id, _),
  !exit_to_supervised(id, _, _).

orphan_process(func, func, "exit", child) :-
  callback_exit(func, id, _),
  exit_to_supervised(id, child, _).

// The supervisor that owns an exit's target: evidence on its finding.
.decl exit_target_owner(func: symbol, target: symbol, sup: symbol, sup_site: symbol)
.output exit_target_owner

exit_target_owner(func, child, sup, sup_site) :-
  callback_exit(func, id, _),
  exit_to_supervised(id, child, sup),
  supervisor_site(sup, sup_site).

// ══ Remote calls whose failure is not a value ═══════════════════════
unhandled_failure(func, call, "erpc_transport", "", guard_end) :-
  try_call(id, func, callee, call, guard_end),
  (callee = ":erpc:call/4" ; callee = ":erpc:call/5"),
  catch_tag(id, func, "error", ":exception"),
  !catch_tag(id, func, "error", ":erpc"),
  catch_falls_through(id, func, ":exception").

// ── An rpc result that is not a value ─────────────────────────────────
//
// :rpc.call answers a node that is gone with {:badrpc, :nodedown} (a
// timeout, a remote exit: {:badrpc, reason} too). Matched by shape with
// no clause for it, that is a CaseClauseError (rabbitmq-cli#193,
// phoenix_live_dashboard#218, livebook#972); tested as a boolean it is
// TRUE — `member?(n) && :rpc.call(n, Process, :alive?, [pid])` says the
// process on a gone node is alive (horde, until 30bb1a1). :erpc.call
// raises instead, so in a boolean context it needs a rescue (horde's
// fix: catch {:erpc, :noconnection} -> false).
unhandled_failure(f, id, v, "case", "") :-
  rpc_call(id, f, v, _),
  (v = "rpc" ; v = "multicall"),
  rpc_result(id, f, "case").

// Used as a boolean: tested against true/false/nil after the call, or
// returned as the result of a predicate (a function named `...?`), whose
// callers test it.
.decl rpc_boolean_use(id: symbol, func: symbol)

rpc_boolean_use(id, f) :- rpc_result(id, f, "boolean").

rpc_boolean_use(id, f) :-
  rpc_result(id, f, "returned"),
  function_def(f, _, name, _, _),
  match(".*\\?", name).

unhandled_failure(f, id, v, "boolean", "") :-
  rpc_call(id, f, v, _),
  (v = "rpc" ; v = "multicall"),
  rpc_boolean_use(id, f).

unhandled_failure(f, id, "erpc", "boolean", "") :-
  rpc_call(id, f, "erpc", _),
  rpc_boolean_use(id, f),
  !catches_class(f, "error"),
  !catch_tag(_, f, "error", ":erpc").

// ══ Results discarded ═══════════════════════════════════════════════

// ── Task.Supervisor.start_child detection ──────────────────────────────

.decl task_start_child_call(func: symbol, id: symbol)

task_start_child_call(func, id) :-
  remote_call(id, func, "Task.Supervisor", "start_child", _).

// ── Unchecked start_child ──────────────────────────────────────────────

// A start_child call whose result is checked: either in tail position
// (result propagated to caller) or followed by a branch instruction in
// the same function (result pattern-matched).
.decl start_child_result_checked(func: symbol, id: symbol)

// Tail position: result goes to the caller.
start_child_result_checked(func, id) :-
  task_start_child_call(func, id),
  tail_call(id).

// Branch after start_child: result is pattern-matched.
//
// `call_followed_by_branch` is emitted by the extractor and holds exactly
// what the two `instruction` joins used to compute: this call has some
// branch later in its function. Asking Datalog to compare two instruction
// INDEXES meant joining `instruction` — 343k rows on a 531-module project,
// rewritten whenever any function body changes — to answer a yes/no
// question, and it made unsafe_task the last analysis reading that
// relation and by far the most expensive one.
//
// The predicate is as coarse as it ever was: a branch anywhere later in
// the function counts, including one in an unrelated clause, so this is a
// weak proxy for "the result was pattern-matched". That weakness is
// preserved on purpose — moving where it is computed must not change what
// it computes. Sharpening it (asking whether the call's result register is
// actually inspected, which the extractor helpers can do) changes findings
// and belongs in its own commit.
start_child_result_checked(func, id) :-
  task_start_child_call(func, id),
  call_followed_by_branch(id).

// start_child call whose result is not checked by any of the above.
unchecked_result(func, id, "Task.Supervisor.start_child", "") :-
  task_start_child_call(func, id),
  !start_child_result_checked(func, id).

// ══ Processes nobody watches ════════════════════════════════════════

orphan_process(func, id, "spawn", "") :-
  spawn_call(id, func, _, _, _, "spawn", _, _, _, _),
  !watched_spawn(id).

// A spawn whose process something monitors or links to afterwards
// (signals.dl): its crash is observed.
.decl watched_spawn(id: symbol)

watched_spawn(id) :-
  process_start(id, _, b, _, _),
  instance(p, b),
  watched_process(p, _).

// This analysis used to join `instruction(id, func, _, _)` purely to
// recover the spawning function. Its input set was therefore
// {instruction, spawn_call} — and `instruction` is the largest relation in
// the schema. On a 531-module project that is 343,352 rows serialized and
// re-read to accompany a `spawn_call` relation with ZERO rows: 1.56s per
// edit to look at nothing. `spawn_call` now carries its caller.

unchecked_result(func, id, "Process.whereis", name) :-
  name_lookup(id, func, "whereis", _, "literal", name, "unchecked").

// ── The belief the other call sites hold ────────────────────────
//
// No list says which results must be checked or which calls must be
// guarded; the program does. When every other site of a callee matches
// its result and one discards it, the one is the finding — the rule
// Engler et al. named "bugs as deviant behavior". The belief needs
// three agreeing sites before it counts, and the deviants must be a
// quarter or fewer of the population: three checked against three
// ignored is a convention, not a slip. Only the used/ignored and
// try/bare fates take part; a tail call hands its result on and says
// nothing about either belief.
//
// The population is the callee's sites on the same target — the table,
// the server — when the site's first argument is a literal: mnesia
// reads its gvar table under a catch 120 times and its stats table bare
// once, on purpose, and pooling the two made the one a deviant. A site
// whose target is unknown (`scope` "") is judged against every site of
// the callee.

// A call site in a function another module's macro wrote — `use
// Ecto.Repo` defines `stop/1` in every repo, on the `use` line — or in a
// closure inside one is the library's choice, not the program's: it
// neither holds a belief nor breaks one.
.decl program_site(site: symbol, func: symbol, callee: symbol, fate: symbol, guard: symbol, guard_end: symbol, target: symbol)

program_site(site, f, callee, fate, guard, guard_end, t) :-
  call_result(site, f, callee, fate, guard, guard_end, t),
  enclosing_function(f, owner),
  !macro_generated(owner, _).

.decl fate_count(callee: symbol, scope: symbol, fate: symbol, n: number)

fate_count(callee, "", fate, n) :-
  program_site(_, _, callee, fate, _, _, _),
  n = count : { program_site(_, _, callee, fate, _, _, _) }.

fate_count(callee, t, fate, n) :-
  program_site(_, _, callee, fate, _, _, t),
  t != "",
  n = count : { program_site(_, _, callee, fate, _, _, t) }.

.decl guard_count(callee: symbol, scope: symbol, guard: symbol, n: number)

guard_count(callee, "", guard, n) :-
  program_site(_, _, callee, _, guard, _, _),
  n = count : { program_site(_, _, callee, _, guard, _, _) }.

guard_count(callee, t, guard, n) :-
  program_site(_, _, callee, _, guard, _, t),
  t != "",
  n = count : { program_site(_, _, callee, _, guard, _, t) }.

// A result is worth checking only if the callee can fail by returning:
// a callee whose spec names no failure value (`:ets.new/2` returns a
// table or raises, `:ets.delete/2` returns `true`) or never returns has
// nothing in its result for a site to miss, however many other sites
// happen to bind it. A callee with no spec is unknown and stays in: the
// spec may only quiet the rule. Every callee call_result counts ships
// specs, except the program's own start functions, whose OTP convention
// is {:ok, pid} | {:error, _}; so there is no table of hand-written
// shapes to keep.
.decl result_uncheckable(callee: symbol)

result_uncheckable(c) :- callee_returns(c, "total").
result_uncheckable(c) :- callee_returns(c, "no_return").

// A discarded start result is startup.ignored_start_result's finding,
// whatever the other sites do; the same site is not reported twice, by
// two concerns, under two titles.
.decl start_result_owned(site: symbol)

start_result_owned(site) :-
  ignored_error_result(site, _, callee),
  (contains(".start_link/", callee) ; contains(".start/", callee)).

// The program's belief is its clear majority: three or more sites that
// agree, and the deviants a quarter or fewer of the population.
.decl clear_majority(agree: number, deviate: number) inline

clear_majority(agree, deviate) :-
  agree >= 3,
  deviate * 4 <= agree + deviate.

// How many of the callee's sites in `scope` bind its result, drop it,
// guard the call with a try, or make it bare.
.decl times_used(callee: symbol, scope: symbol, n: number) inline
.decl times_ignored(callee: symbol, scope: symbol, n: number) inline
.decl times_guarded(callee: symbol, scope: symbol, n: number) inline
.decl times_bare(callee: symbol, scope: symbol, n: number) inline

times_used(c, t, n) :- fate_count(c, t, "used", n).
times_ignored(c, t, n) :- fate_count(c, t, "ignored", n).
times_guarded(c, t, n) :- guard_count(c, t, "try", n).
times_bare(c, t, n) :- guard_count(c, t, "bare", n).

// The one site in question: its result dropped, or the call made bare.
.decl result_ignored(site: symbol, func: symbol, callee: symbol, scope: symbol) inline
.decl called_bare(site: symbol, func: symbol, callee: symbol, scope: symbol) inline

result_ignored(site, f, c, t) :- program_site(site, f, c, "ignored", _, _, t).
called_bare(site, f, c, t) :- program_site(site, f, c, _, "bare", _, t).

// A site unchecked_result or startup already owns is not reported twice.
inconsistent_handling(func, site, callee, "result_checked", used, ignored, scope) :-
  result_ignored(site, func, callee, scope),
  !result_uncheckable(callee),
  times_used(callee, scope, used),
  times_ignored(callee, scope, ignored),
  clear_majority(used, ignored),
  !unchecked_result(func, site, _, _),
  !start_result_owned(site).

inconsistent_handling(func, site, callee, "exception_guarded", guarded, bare, scope) :-
  called_bare(site, func, callee, scope),
  times_guarded(callee, scope, guarded),
  times_bare(callee, scope, bare),
  clear_majority(guarded, bare).

// The sites that follow the convention, attached to the finding as its
// evidence: what "every other call site" looks like, drawn from the
// population the deviant was judged against.
.decl handling_site(callee: symbol, belief: symbol, site: symbol, func: symbol, guard_end: symbol, target: symbol)
.output handling_site

handling_site(callee, "exception_guarded", site, f, guard_end, t) :-
  inconsistent_handling(_, _, callee, "exception_guarded", _, _, t),
  program_site(site, f, callee, _, "try", guard_end, t2),
  (t = "" ; t = t2).

handling_site(callee, "result_checked", site, f, "", t) :-
  inconsistent_handling(_, _, callee, "result_checked", _, _, t),
  program_site(site, f, callee, "used", _, _, t2),
  (t = "" ; t = t2).
