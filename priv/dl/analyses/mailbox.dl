// A message arrives and nothing takes it, or takes it wrongly.
//
// A process's mailbox is written by more than its owner: a task's
// reply, a monitor's :DOWN, a timer that fired before it was cancelled,
// a late reply to a timed call, a subscription's broadcast, the module's
// own client API. Every finding here is a message and the clause that
// is not there for it, or the reply a caller waits for that never
// comes: a handle_info without a catch-all, an async_nolink task whose
// reply lands unhandled, a monitor left live past its wait, a cancelled
// timer's stale message, a tag the module sends itself and cannot
// handle, a handle_call that defers a reply it cannot send, a statem
// timeout no clause matches.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/sends.dl"
.include "../clientlib/replies.dl"
.include "../clientlib/test_code.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/generated.dl"

// ══ The outputs ═════════════════════════════════════════════════════
//
// `partial_handler(mod, handler, source, missing, detail)` — a message
//   with no clause for it. `source` says who writes it: "runtime" (the
//   process monitors or traps exits), "late_message" (its callbacks reach
//   a task, timer, subscription or timed call), "task_nolink" (an
//   async_nolink task started in `detail`; `missing` is "reply" or
//   "down"), "statem_timeout" (`handler` is the state arming a timeout of
//   kind `missing`), "statem_info" (the state function `handler`, for
//   state `detail`, lacks the :info catch-all its siblings have).
// `unconsumed_monitor(mod, func, site, kind)` — a monitor left live:
//   "timed_wait" (past a receive with an after clause, never flushed),
//   "never_released" (a server that removes entries but never
//   demonitors), "ref_discarded" (the ref thrown away).
// `task_result_defect(func, site, kind)` — a Task.async whose result
//   goes wrong: "never_awaited", "yield_linked" (collected with
//   Task.yield in a process that does not trap exits),
//   "linked_in_library" (started in library code, linked to whoever
//   called it).
// `reply_defect(mod, func, site, kind, tag)` — a reply that never comes:
//   "self_call" | "self_cast" (the module sends its own server `tag` and
//   has no clause for it; `func` is the sender), "dropped_from" (a
//   handle_call defers a reply without keeping `from`; `site` is the
//   return), "statem_unreplied" (a {:call, from} clause answers nothing).
.decl partial_handler(mod: symbol, handler: symbol, source: symbol, missing: symbol, detail: symbol)
.output partial_handler

.decl unconsumed_monitor(mod: symbol, func: symbol, site: symbol, kind: symbol)
.output unconsumed_monitor

.decl task_result_defect(func: symbol, site: symbol, kind: symbol)
.output task_result_defect

.decl reply_defect(mod: symbol, func: symbol, site: symbol, kind: symbol, tag: symbol)
.output reply_defect

// ══ handle_info without a catch-all, and stale timers ═══════════════
// ── handle_info without a catch-all, in a process the runtime writes to ──
//
// Once a GenServer defines handle_info/2, any message no clause matches
// is a FunctionClauseError, not the default log-and-continue. That only
// matters for messages the process did not ask for by protocol — and a
// process that monitors or traps exits has asked the runtime to send it
// messages whose timing it does not control: a late {:DOWN, ...} after a
// demonitor without :flush, an {:EXIT, ...} from a Plug's port. Bandit's
// connection process crashed on exactly those until a catch-all landed.
//
// Subsumed by trap_exit_without_exit_clause when that fires, and by
// unhandled_info's "crash" when a message the module is sent names the
// clause that is missing: one finding per module, the more specific one.
.decl receives_runtime_messages(mod: symbol)

receives_runtime_messages(mod) :- module_traps(_, mod).

// A monitor the server itself holds: taken on its own stack (a callback,
// or what one reaches in the module). A client function of the same
// module — `def await_up, do: Process.monitor(whereis(__MODULE__))` —
// runs in the caller, and its :DOWN lands in the caller's mailbox.
receives_runtime_messages(mod) :-
  monitor_call(_, f, _),
  server_side(mod, f).

partial_handler(mod, h, "runtime", "catchall", "") :-
  (behaves_as(mod, "GenServer") ; behaves_as(mod, "GenStage")),
  partial_handle_info(mod, h),
  receives_runtime_messages(mod),
  !trap_exit_without_exit_clause(mod, _),
  !info_crash(mod).

// ── handle_info without a catch-all, with a late-message source ──
//
// The variant above needs the module itself to invite runtime messages.
// A mailbox is written by more than its owner: a timed call that gave
// up leaves a late reply (gen_stage#238, an hackney message crashing a
// Flow producer), a Task.async replies, a timer fires after the state
// that expected it is gone, a subscription broadcasts, a start-up
// message is re-sent by a restart loop (cachex#314), and code the
// process runs through a closure or apply is not its own to vouch for
// (gen_stage#238's producer ran the user's stream). A partial
// handle_info/2 in a process whose callbacks reach such a source is a
// FunctionClauseError waiting for that message. Without any source in
// reach the shape is a style note, and stays quiet. Info: the two rules
// above stay the warning-grade shapes. A source in what a callback
// spawns or hands a task writes to that process's mailbox, not this one.
//
// Not sources:
// - a timed GenServer (gen) call: since OTP 24 gen waits on an alias
//   it deactivates when it gives up, and a reply sent after that is
//   dropped. gen_stage#238's late message was hackney's, from the
//   stream it ran (an apply, below);
// - the logging and telemetry APIs (side_call, clientlib/calls.dl):
//   their handlers are dispatched by value and write to no mailbox of
//   the caller's that the program can see, and :telemetry's own apply
//   of a handler fun is that dispatch;
// - a call through a fun or a module the process's own code builds or
//   names (apply_param resolved at its callers, below): what it runs is
//   in the call graph, and walked.
.init mailbox_reach = SameProcessReachSetCut

mailbox_reach.cut(f, g) :- side_call(f, g).
mailbox_reach.seed(f) :- mailbox_writer(id, f, kind), kind != "cancel", !handled_self_timer(id).
mailbox_reach.seed(c) :- hands_unseen(c).

// A function that calls through its parameter runs what its callers hand
// it (apply_param). A caller that forwards its own parameter into that
// position asks its callers in turn; one that hands, in that position, a
// fun it builds or a literal external fun (fun_handed at the position),
// or names a literal module, shows what runs. Any other caller hands
// code the program does not show — a fun it read from its state, a
// module it was sent, a fun in one argument beside a closure in another
// — and is a source, as is a callback calling through its own
// parameter: the behaviour fills those, with the message or the state (a
// server whose state is the fun it runs). A closure calling through a
// variable it captured runs what its builder captured: made of the
// builder's parameter (call_arg_derived, a make_fun3's environment), the
// builder's callers are asked; anything else — a fun the builder read
// from its state (`cb = state.callback`, then `Enum.each(items, fn i ->
// cb.(i) end)`), a call's result — the builder hands unseen.
.decl applies_through(func: symbol, pos: number)

applies_through(f, k) :- apply_param(_, f, k).
applies_through(c, k2) :- applies_through(f, k), call_arg_forward(c, f, k, k2).
applies_through(c, p) :- applies_through(f, k), captures(c, f, k, p).

// The closure `closure` its builder makes holds, in its parameter `k`,
// something made of the builder's parameter `p`.
.decl captures(builder: symbol, closure: symbol, k: number, p: number)

captures(c, f, k, p) :- closure_def(c, f), call_arg_derived(c, f, k, p).

.decl hands_unseen(caller: symbol)

hands_unseen(c) :-
  applies_through(f, k),
  call_instr(c, f, id),
  !fun_handed(id, c, _, k),
  !call_arg_forward(c, f, k, _),
  !names_module(c, f, k).

hands_unseen(c) :-
  applies_through(f, k),
  closure_def(c, f),
  !call_arg_derived(c, f, k, _).

hands_unseen(f) :- applies_through(f, _), process_entry(_, f).

// `caller` hands `callee` a literal module at `pos` on every call.
.decl names_module(caller: symbol, callee: symbol, pos: number)

names_module(c, f, k) :-
  applies_through(f, k),
  call_arg(c, f, k, v),
  v != "dynamic",
  !call_arg(c, f, k, "dynamic").

// A timer the process arms for itself whose message its own
// handle_info/2 takes — the tag (timer_tag: the atom, or a tuple's first
// element) compared, in a clause of the message's shape — leaves nothing
// unhandled behind: the late message is one the process takes (a
// janitor's :purge, a metrics loop's :check, a warmer's `{:warm, nil}`).
// A cancel writes nothing; the timer it stops was armed somewhere, and
// that arm is the source if any.
.decl handled_self_timer(id: symbol)

handled_self_timer(id) :-
  timer_arm(id, f, "self", _, _, _),
  timer_tag(id, tag, _),
  function_def(f, mod, _, _, _),
  callback_tag(h, "handle_info", tag),
  function_def(h, mod, _, _, _),
  !timer_refused(h, id).

// :erlang.start_timer/3,4 (no timer_arm: its message carries the ref,
// and the flush rules do not ask of it) sends `{:timeout, ref, msg}`: a
// 3-tuple, which GenServer's idle `handle_info(:timeout, s)` does not
// take.
handled_self_timer(id) :-
  mailbox_writer(id, f, "timer"),
  !timer_arm(id, _, _, _, _, _),
  timer_tag(id, tag, _),
  function_def(f, mod, _, _, _),
  callback_tag(h, "handle_info", tag),
  function_def(h, mod, _, _, _),
  !timer_refused(h, id).

// The handler's clause heads take the timer's tag only in other shapes
// (callback_tag_shape): `{:tick, n}` for a `{:tick, 1, :slow}` timer, the
// atom `:timeout` for a start_timer's `{:timeout, ref, msg}`. A handler
// whose heads say nothing of the tag (it compares it in its body), or
// with a clause that takes a message by its shape alone, is not asked.
.decl timer_refused(handler: symbol, id: symbol)

timer_refused(h, id) :-
  timer_tag(id, tag, ar),
  callback_tag_shape(h, "handle_info", tag, _),
  !callback_tag_shape(h, "handle_info", tag, ar),
  !callback_tag_shape(h, "handle_info", tag, -1),
  !callback_open(h, "handle_info", _).

.decl late_message_source(mod: symbol)

late_message_source(mod) :-
  process_entry(mod, c),
  mailbox_reach.reaches(c).

// A handle_info/2 every clause of which a library's macro wrote
// (library_written, clientlib/generated.dl: `use Cachex.Warmer`'s) is
// that library's protocol for its own messages, and the finding would
// point at the `use` line, where the module has nothing to add a clause
// to. One the program's own macro wrote is the program's: the clause
// belongs in that macro.

partial_handler(mod, h, "late_message", "catchall", "") :-
  (behaves_as(mod, "GenServer") ; behaves_as(mod, "GenStage")),
  partial_handle_info(mod, h),
  !library_written(h),
  late_message_source(mod),
  !receives_runtime_messages(mod),
  !trap_exit_without_exit_clause(mod, _),
  !statem_process(mod),
  !info_crash(mod).

// ── A timer cancelled but not flushed ────────────────────────────────
//
// Process.cancel_timer/1 does not remove a message the timer already
// delivered. A process that cancels and re-arms a timer whose message
// is a bare atom (`:tick`) cannot tell the stale message from the next
// one: the action fires twice, or early (MongooseIM#3502, beam-bots/bb
// #214; nebulex's generation rotation and cachex's warmer have the
// shape). A message that carries the timer's ref (`{:tick, ref}`, or
// :erlang.start_timer's `{:timeout, ref, _}`) is matched against the
// current ref; a `receive :tick -> :ok after 0 -> :ok end` flushes.
// Cancelling only in terminate/2 arms nothing again.
//
// The timer's identity is followed through the state: the ref the arm
// site produces is returned or stored under a map key (timer_ref,
// returns_call, timer_store), and the ref a cancel site takes was read
// from a map key or handed in as a parameter (timer_cancel,
// call_arg_field). A cancel and an arm pair up only on the same key,
// so a module with a heartbeat and a reconnect timer gets two verdicts.
// The flush must name the armed message (recv_pattern), or match
// anything, and be where the cancel is: in the function that cancels,
// or one it calls (flushes_after_cancel). A receive for the message in
// an unrelated function of the module is no flush.

// The map key the ref armed in `a` ends up under.
.decl timer_key(arm: symbol, key: symbol)

timer_key(a, key) :- timer_ref(_, a, "stored", key).

timer_key(a, key) :-
  timer_ref(_, a, "returned", _),
  returns_to_key(a, key).

.decl returns_to_key(func: symbol, key: symbol)

returns_to_key(f, key) :- timer_store(_, key, f).

returns_to_key(f, key) :-
  returns_call(g, f),
  returns_to_key(g, key).

// The map key a parameter carries a field of, from the callers that
// read it and passed it down.
.decl param_field(func: symbol, pos: number, key: symbol)

param_field(f, pos, key) :- call_arg_field(_, f, pos, key).

param_field(f, pos, key) :-
  call_arg_forward(g, f, pos, gpos),
  param_field(g, gpos, key).

// The literal a timer armed for the arming process carries: at the
// site, or a parameter the callers fill with a literal (nebulex's
// `start_timer(time, ref, event)` with `event \\ :heartbeat`).
.decl armed_message(arm: symbol, message: symbol)

armed_message(a, lit) :- timer_arm(_, a, "self", "bare", _, lit).

armed_message(a, lit) :-
  timer_arm(_, a, "self", "param", pos, _),
  resolved_arg(a, pos, lit).

// The message the timer kept under `key` carries. A literal at the arm
// site is it. A parameter is filled along the calls that store the ref
// — the storing function's own call to the arming function, or a
// wrapper it goes through that fills the parameter itself or forwards
// one the storing function filled — so two keys armed through one
// helper each get their own message: nebulex's
// `start_timer(time, ref, event \\ :heartbeat)` keeps :cleanup under
// one key and :heartbeat under another. When the arming function stores
// the ref itself, its callers are the only source, and any literal they
// pass is taken (armed_message).
.decl stored_message(key: symbol, arm: symbol, message: symbol)

stored_message(key, a, lit) :-
  timer_key(a, key),
  timer_arm(_, a, "self", "bare", _, lit).

stored_message(key, a, lit) :-
  timer_ref(_, a, "stored", key),
  timer_arm(_, a, "self", "param", _, _),
  armed_message(a, lit).

stored_message(key, a, lit) :-
  timer_ref(_, a, "returned", _),
  timer_arm(_, a, "self", "param", pos, _),
  timer_store(f, key, callee),
  literal_toward(f, callee, a, pos, lit).

// `lit` fills parameter `pos` of `to` on the way from `from`'s call to
// `callee`: at that call when the callee is `to`, else through a
// wrapper that returns `to`'s result and either fills the parameter or
// forwards one of its own that `from` filled. One wrapper deep, which
// is what default arguments compile to.
.decl literal_toward(from: symbol, callee: symbol, to: symbol, pos: number, lit: symbol)

literal_toward(f, a, a, pos, lit) :-
  call_arg(f, a, pos, lit),
  lit != "dynamic".

literal_toward(f, w, a, pos, lit) :-
  returns_call(w, a),
  call_arg(w, a, pos, lit),
  lit != "dynamic",
  call_arg(f, w, _, _).

literal_toward(f, w, a, pos, lit) :-
  returns_call(w, a),
  call_arg_forward(w, a, pos, wpos),
  call_arg(f, w, wpos, lit),
  lit != "dynamic".

.decl timer_cancel_without_flush(mod: symbol, cancel: symbol, arm: symbol, key: symbol, message: symbol, cancel_site: symbol, arm_site: symbol)
.output timer_cancel_without_flush

// The cancel_timer instruction in `cancel` that read the ref from `key`:
// at the site, or at a caller that read it and passed it down.
.decl cancel_site(cancel: symbol, key: symbol, id: symbol)

cancel_site(c, key, id) :- timer_cancel(id, c, "field", key, _).

cancel_site(c, key, id) :-
  timer_cancel(id, c, "param", _, pos),
  param_field(c, pos, key).

// A cancel that cannot leave a stale message behind for the process to
// mistake for the next one:
//
// - one in terminate/2, or in a helper only terminate/2 calls (directly,
//   or through one more helper only such helpers call): the process is
//   going away, and no later message is handled. A helper nothing in the
//   program calls is not one: BB.Loop.cancel/1's docs said "call from
//   terminate/2", and its callers also called it before re-arming at a
//   new rate (bb#214, fixed with the flush);
// - one in the `handle_info/2` clause of the very message the timer
//   sends (`def handle_info(:heartbeat, s)` cancelling heartbeat_ref):
//   that timer has already fired, and its message is the one being
//   handled (cancel_clause).
.decl terminate_helper(func: symbol)
.decl called_outside_terminate(func: symbol)

called_outside_terminate(g) :- call_edge(f, g), !terminate_callback(f, _, _).

terminate_helper(g) :-
  call_edge(f, g),
  terminate_callback(f, _, _),
  !called_outside_terminate(g).

.decl terminate_helper2(func: symbol)
.decl called_outside_terminate2(func: symbol)

called_outside_terminate2(h) :-
  call_edge(g, h),
  !terminate_callback(g, _, _),
  !terminate_helper(g).

terminate_helper2(h) :-
  call_edge(g, h),
  (terminate_callback(g, _, _) ; terminate_helper(g)),
  !called_outside_terminate2(h).

.decl runs_only_on_the_way_out(func: symbol)

runs_only_on_the_way_out(c) :- terminate_callback(c, _, _).
runs_only_on_the_way_out(c) :- terminate_helper(c).
runs_only_on_the_way_out(c) :- terminate_helper2(c).

// The cancel is in the handle_info/2 clause of the timer's own message:
// the message is the one being handled, not one left behind.
.decl handles_that_message(cancel: symbol, message: symbol) inline

handles_that_message(cancel, msg) :- cancel_clause(cancel, _, msg).

// A ref that never leaves the function: armed, then cancelled from the
// local the send_after returned (`ref = send_after(...); work();
// cancel_timer(ref)`). No state key pairs them; the arming site does.
// The function runs again on the next request, so a message the timer
// delivered before the cancel is handled as the next run's.
timer_cancel_without_flush(mod, cancel, cancel, "", message, cancel_site, arm_site) :-
  cancels_local(cancel_site, cancel, arm_site),
  local_message(arm_site, message),
  in_module(cancel, mod),
  !init_function(mod, cancel),
  !runs_only_on_the_way_out(cancel),
  !flushes_after_cancel(cancel_site, message),
  !handles_that_message(cancel_site, message).

// A cancel of a timer the same function armed and kept in a local.
.decl cancels_local(cancel_site: symbol, cancel: symbol, arm_site: symbol) inline

cancels_local(cs, c, arm_id) :-
  timer_cancel(cs, c, "local", arm_id, _),
  timer_arm(arm_id, c, "self", _, _, _).

.decl local_message(arm_site: symbol, message: symbol)

local_message(id, lit) :- timer_arm(id, _, "self", "bare", _, lit).

local_message(id, lit) :-
  timer_arm(id, a, "self", "param", pos, _),
  resolved_arg(a, pos, lit).

// A ref kept under a state key: cancelled from it in one place, and
// armed again under it — with the message it carries — in another. The
// arm must be one that can follow the cancel: a timer armed only in
// init/1 and cancelled later is stopped, not re-armed, and its stale
// message is handled once as an ordinary one.
//
// `cancel` and `arm` are the cancel_timer and send_after instructions;
// the functions holding them are the output's cancel and arm columns.
.decl cancel_without_flush(cancel: symbol, arm: symbol, key: symbol, message: symbol)

cancel_without_flush(cancel, arm, key, message) :-
  cancels_under(cancel, key),
  rearms_under(arm, key, message),
  in_same_module(cancel, arm),
  !cancelled_on_the_way_out(cancel),
  !flushes_after_cancel(cancel, message),
  !handles_that_message(cancel, message).

timer_cancel_without_flush(mod, cancel, arm, key, message, cancel_site, arm_site) :-
  timer_ranked(mod, cancel, arm, key, message, cancel_site, arm_site),
  !site_under_test(arm_site).

timer_cancel_without_flush(mod, cancel, arm, key, message, cancel_site, arm_site) :-
  timer_ranked(mod, cancel, arm, key, message, cancel_site, arm_site),
  !arm_off_test(mod, key).

// Every cancel and arm that pair up under a key.
.decl timer_pair(mod: symbol, cancel: symbol, arm: symbol, key: symbol, message: symbol, cancel_site: symbol, arm_site: symbol)

timer_pair(mod, cancel, arm, key, message, cancel_site, arm_site) :-
  cancel_without_flush(cancel_site, arm_site, key, message),
  cancel_site(cancel, key, cancel_site),
  rearm_site(arm_site, arm, key, message),
  in_module(cancel, mod).

// ── Where a key's finding points ──
//
// A key is one finding however many cancels and arms pair up under it
// (the relation's dedupe key), and the finding points at the least row,
// which orders by function name. Plausible's WriteBuffer cancels its
// :tick timer in handle_cast's buffer-full branch, the path every
// insert can take, and in handle_call(:flush), which only its test
// helpers request; the name put handle_call first. The rows keep a
// cancel the program itself runs over one only its tests reach
// (test_code.dl), and then an arm likewise; a key whose cancels are all
// under test keeps them all. The cancels left out are the finding's
// related frames (timer_cancel_under_test). Which modules and keys are
// reported does not change.
.decl timer_ranked(mod: symbol, cancel: symbol, arm: symbol, key: symbol, message: symbol, cancel_site: symbol, arm_site: symbol)

timer_ranked(mod, cancel, arm, key, message, cancel_site, arm_site) :-
  timer_pair(mod, cancel, arm, key, message, cancel_site, arm_site),
  !site_under_test(cancel_site).

timer_ranked(mod, cancel, arm, key, message, cancel_site, arm_site) :-
  timer_pair(mod, cancel, arm, key, message, cancel_site, arm_site),
  !cancel_off_test(mod, key).

// Some cancel under the key runs outside the tests.
.decl cancel_off_test(mod: symbol, key: symbol)

cancel_off_test(mod, key) :-
  timer_pair(mod, _, _, key, _, cancel_site, _),
  !site_under_test(cancel_site).

// Some arm of the ranked rows runs outside the tests.
.decl arm_off_test(mod: symbol, key: symbol)

arm_off_test(mod, key) :-
  timer_ranked(mod, _, _, key, _, _, arm_site),
  !site_under_test(arm_site).

// A cancel or arm site whose function runs only under test, or is a
// callback every request for which comes from code that does.
.decl site_under_test(site: symbol)

site_under_test(id) :- cancel_site(c, _, id), runs_under_test(c).
site_under_test(id) :- cancel_site(c, _, id), requested_only_under_test(c).
site_under_test(id) :- rearm_site(id, a, _, _), runs_under_test(a).
site_under_test(id) :- rearm_site(id, a, _, _), requested_only_under_test(a).

// A handle_call/3 or handle_cast/2 whose requests the program sends
// only from code under test: some site sends one of the tags it
// compares, of its kind, and every such site runs only under test.
// Over-approximated by callback_tag (every atom its body compares), so a
// callback with any request sent from elsewhere is not one.
.decl requested_only_under_test(callback: symbol)
.decl requested_outside_tests(callback: symbol)

requested_outside_tests(h) :-
  kind_callback(kind, cb),
  function_def(h, _, cb, _, _),
  callback_tag(h, cb, tag),
  call_tag(_, s, kind, tag),
  !runs_under_test(s).

requested_only_under_test(h) :-
  kind_callback(kind, cb),
  function_def(h, _, cb, _, _),
  callback_tag(h, cb, tag),
  call_tag(_, s, kind, tag),
  runs_under_test(s),
  !requested_outside_tests(h).

// ── Evidence: a cancel only the tests reach ──
.decl timer_cancel_under_test(mod: symbol, key: symbol, site: symbol, func: symbol)
.output timer_cancel_under_test

timer_cancel_under_test(mod, key, cancel_site, cancel) :-
  timer_pair(mod, cancel, _, key, _, cancel_site, _),
  site_under_test(cancel_site),
  cancel_off_test(mod, key).

// The cancel_timer `cancel` takes the ref kept under `key` (cancel_site
// above).
.decl cancels_under(cancel: symbol, key: symbol) inline

cancels_under(cancel, key) :- cancel_site(_, key, cancel).

// The send_after `arm` keeps its ref under `key`, and the timer carries
// `message`.
.decl rearms_under(arm: symbol, key: symbol, message: symbol) inline

rearms_under(arm, key, msg) :- rearm_site(arm, _, key, msg).

// The send_after at `arm_site` in `arm` keeps its ref under `key`, and
// the timer carries `message`; an arm in init/1 does not re-arm.
.decl rearm_site(arm_site: symbol, arm: symbol, key: symbol, message: symbol)

rearm_site(arm_site, a, key, msg) :-
  timer_key(a, key),
  stored_message(key, a, msg),
  timer_arm(arm_site, a, "self", _, _, _),
  in_module(a, mod),
  !init_function(mod, a).

// The functions holding the cancel and the arm are in one module.
.decl in_same_module(cancel: symbol, arm: symbol)

in_same_module(cancel, arm) :-
  cancel_site(c, _, cancel),
  rearm_site(arm, a, _, _),
  in_module(c, mod),
  in_module(a, mod).

// The cancel is in terminate/2, or a helper only it runs.
.decl cancelled_on_the_way_out(cancel: symbol)

cancelled_on_the_way_out(cancel) :- cancel_site(c, _, cancel), runs_only_on_the_way_out(c).

// A receive where the cancel is takes the message: by name, or a clause
// that matches anything (`after 0` with a wildcard, the cancel_timer
// docs' blocking receive, Ostinato.Eager). Where the cancel is means the
// function holding it, a caller that read the ref and handed it down to
// a cancel helper, or a function one of those calls in the same process
// (a `flush_tick/0` helper). A receive for the message elsewhere in the
// module runs on some other path: one handle_cast/2 waits in does not
// flush the heartbeat handle_call/3 cancels, and used to silence it.
// Whether the receive runs after the cancel inside the function is not
// asked: the order needs the instruction-level CFG facts stage 0 keeps
// out of the analyses' inputs.
.decl flushes_after_cancel(cancel: symbol, message: symbol)

flushes_after_cancel(cancel, msg) :-
  cancel_scope.reaches(cancel, f),
  recv_pattern(_, f, msg).

flushes_after_cancel(cancel, msg) :-
  cancel_scope.reaches(cancel, f),
  recv_pattern(_, f, "any"),
  armed_message(_, msg).

// The functions the cancel_timer `cancel` belongs to, and what they run
// in their own process.
.init cancel_scope = ForwardSameProcessReach

cancel_scope.root(cancel, c) :- timer_cancel(cancel, c, _, _, _).
cancel_scope.root(cancel, g) :- hands_down_ref(cancel, g).

// `func` passes the ref the cancel_timer `cancel` takes as a parameter,
// read from its state or its own parameter (param_field's path).
.decl hands_down_ref(cancel: symbol, func: symbol)
.decl ref_param(cancel: symbol, func: symbol, pos: number)

ref_param(cancel, c, pos) :- timer_cancel(cancel, c, "param", _, pos).

ref_param(cancel, g, gpos) :-
  ref_param(cancel, f, pos),
  call_arg_forward(g, f, pos, gpos).

hands_down_ref(cancel, g) :-
  ref_param(cancel, f, pos),
  (call_arg_field(g, f, pos, _) ; call_arg_forward(g, f, pos, _)).

// ── Evidence: where a monitored entry is removed, where a task is yielded ─
.decl monitored_entry_removal(mod: symbol, kind: symbol, site: symbol, func: symbol)
.output monitored_entry_removal

// The :DOWN handler's own removal is the one path where the monitor is
// already gone; every other removal leaves it live.
monitored_entry_removal(mod, "never_released", id, f) :-
  unconsumed_monitor(mod, _, _, "never_released"),
  function_def(f, mod, _, _, _),
  !matches_down(f),
  remote_call(id, f, m, op, _),
  removal_api(m, op).

.decl task_yield_site(func: symbol, kind: symbol, site: symbol)
.output task_yield_site

task_yield_site(owner, "yield_linked", id) :-
  task_result_defect(owner, _, "yield_linked"),
  (remote_call(id, g, "Task", "yield", _) ; remote_call(id, g, "Task", "yield_many", _)),
  enclosing_function(g, owner).

// ══ Tasks whose messages land unhandled ═════════════════════════════
.decl task_async_call(func: symbol, id: symbol)

task_async_call(func, id) :-
  remote_call(id, func, "Task", "async", _).

// Also detect Task.Supervisor.async (returns a Task that must be
// awaited/yielded, just like Task.async).
task_async_call(func, id) :-
  remote_call(id, func, "Task.Supervisor", "async", _).

// Task.Supervisor.async_nolink is intentionally excluded: it returns a
// task that is NOT linked to the caller. The supervisor manages the
// lifecycle, making it safe for fire-and-forget patterns.

// ── Task.await/yield detection ─────────────────────────────────────────

.decl task_await_call(func: symbol, id: symbol)

task_await_call(func, id) :-
  remote_call(id, func, "Task", "await", _).

task_await_call(func, id) :-
  remote_call(id, func, "Task", "await_many", _).

task_await_call(func, id) :-
  remote_call(id, func, "Task", "yield", _).

task_await_call(func, id) :-
  remote_call(id, func, "Task", "yield_many", _).

task_await_call(func, id) :-
  remote_call(id, func, "Task", "shutdown", _).

// ── Function-level await reachability ──────────────────────────────────

// Function has an await/yield (directly or through callees).
.init await_reach = CallReachSet

await_reach.seed(func) :- task_await_call(func, _).

// ── Task factory suppression ─────────────────────────────────────────

// A function that creates an async task in tail position returns the
// task struct to its caller. The caller is responsible for awaiting —
// this function is a factory, not a leak.
.decl task_factory(func: symbol, id: symbol)

task_factory(func, id) :-
  task_async_call(func, id),
  tail_call(id).

// ── Leaked async task ──────────────────────────────────────────────────

// Function creates an async task but never awaits (directly or
// transitively). The task reference is either discarded or returned
// to a caller that may not await it.
//
// Suppressed for a module with a callback that can consume task results
// from its mailbox (mailbox_handler: any handle_info/2, or a gen_statem's
// handle_event/4), which collects them there rather than by an explicit
// await, and for task factories that return the task to the caller.
task_result_defect(func, id, "never_awaited") :-
  task_async_call(func, id),
  !await_reach.reaches(func),
  function_def(func, mod, _, _, _),
  !mailbox_handler(mod),
  !task_factory(func, id).

// ── Yielding on a linked task ────────────────────────────────────────
//
// Task.async and Task.Supervisor.async link the task to the caller.
// Task.yield/yield_many document an `{:exit, reason}` result for a task
// that crashed — but the link delivers the crash to the caller first, so
// unless the caller traps exits that branch never runs: the caller is
// dead (whatyouhide/redix#317's cluster fan-out, whose partial-failure
// path was unreachable). async_nolink is the tool for that shape.
// A closure's calls belong to the function that defines it: the task is
// usually started inside an Enum.map fn and collected outside it.
task_result_defect(owner, id, "yield_linked") :-
  task_async_call(f, id),
  enclosing_function(f, owner),
  !closure_def(_, owner),
  (remote_call(_, g, "Task", "yield", _) ; remote_call(_, g, "Task", "yield_many", _)),
  enclosing_function(g, owner),
  function_def(owner, mod, _, _, _),
  !module_traps(_, mod).

// ── A linked task inside library code ────────────────────────────────
//
// Task.async in a function that is not itself a process's callback links
// the task to whoever called the function. In a caller that traps exits
// the task's normal exit then arrives as an `{:EXIT, pid, :normal}`
// message Task.await never consumes (elixir-ecto/ecto#2246: a GenServer
// preloading in parallel), and a crashing task takes an unrelated
// caller down with it. A behaviour module that runs no process of its
// own (a plug, a type) owns its callers' expectations. A process
// module's callbacks, and what they reach in the module, run in its own
// process (server_side), but its client API runs in whoever calls it,
// like a library function: elixir-nodejs#45's `NodeJS.Supervisor.call/3`,
// a `use Supervisor` module's public call, linked every caller to the
// pool worker's task (PoolCallSupervisor; ServerSideTaskAwait is quiet).
task_result_defect(owner, id, "linked_in_library") :-
  task_async_call(f, id),
  enclosing_function(f, owner),
  !closure_def(_, owner),
  function_def(owner, mod, _, _, _),
  runs_in_callers(owner, mod),
  !task_factory(owner, _),
  await_reach.reaches(owner).

.decl task_owner(func: symbol, mod: symbol)

task_owner(owner, mod) :-
  task_async_call(f, _),
  enclosing_function(f, owner),
  function_def(owner, mod, _, _, _).

.decl runs_in_callers(func: symbol, mod: symbol)

runs_in_callers(func, mod) :-
  task_owner(func, mod),
  !behaviour_module(mod).

runs_in_callers(func, mod) :-
  task_owner(func, mod),
  process_behaviour_module(mod),
  !server_side(mod, func).

// ── async_nolink whose messages nothing handles ───────────────────────
//
// Task.Supervisor.async_nolink sends the caller two messages it did not
// ask for by name: `{ref, result}` and `{:DOWN, ref, :process, pid,
// reason}`. A GenServer that starts one from a callback and does not
// collect it there must handle both in handle_info/2; a partial
// handle_info is a FunctionClauseError on the first task that finishes
// (archethic-node#1306, sentry-elixir#172, Engram#1552). GenServer's
// default handle_info logs and ignores, so only a module with its own
// partial handle_info/2 is at risk. An async_nolink inside a task the
// server starts sends its messages to the task.
.init nolink_reach = SameProcessReach

nolink_reach.seed(f, f) :- mailbox_writer(_, f, "task_nolink").

partial_handler(mod, h, "task_nolink", "reply", s) :-
  process_entry(mod, c),
  nolink_reach.reaches(c, s),
  partial_handle_info(mod, h),
  !callback_ref_head(h, "handle_info").

partial_handler(mod, h, "task_nolink", "down", s) :-
  process_entry(mod, c),
  nolink_reach.reaches(c, s),
  partial_handle_info(mod, h),
  !callback_tag(h, "handle_info", ":DOWN").

// ══ Monitors nobody waits for ═══════════════════════════════════════
.init timed_wait = SameProcessReachSet

timed_wait.seed(func) :- timed_receive(func).

.init flush = SameProcessReachSet

flush.seed(func) :- demonitor_call(_, func, "flush").

unconsumed_monitor(mod, func, id, "timed_wait") :-
  monitor_call(id, func, _),
  function_def(func, mod, _, _, _),
  outlives_its_wait(func),
  !waited_out(id),
  !collected_by_callers(func).

// A monitor whose :DOWN a receive with no `after` in its own function
// takes (recv_down) is waited out there, as a blocking receive's is
// everywhere in this rule. Phoenix's Channel.Server.close/2 gives the
// channel a grace period, then kills it and waits for the :DOWN. Read
// per function, as the timed wait is: that the timeout's path reaches
// the wait is not asked. So is one after which every path to the
// function's return waits for a :DOWN (awaits_down_after): qlc's
// stop_cursor/1 looks for an :EXIT with `after 0`, and on both branches
// then waits for the cursor's :DOWN.
.decl waited_out(monitor: symbol)

waited_out(m) :- recv_down(r, f, m), recv_start(r, f, 1, _).
waited_out(m) :- monitor_call(m, f, _), awaits_down_after(f, m).

// A function that monitors and waits with an `after`, and neither
// flushes nor ends its process: the monitor is live when the wait gives
// up, and the function returns with it.
.decl outlives_its_wait(func: symbol)

outlives_its_wait(func) :-
  monitor_call(_, func, _),
  timed_wait.reaches(func),
  !flush.reaches(func),
  !ends_its_process(func).

// ── A monitor its callers collect ────────────────────────────────────
//
// Returning with a monitor live is the protocol, not a leak, when the
// caller goes on to wait for the :DOWN. OTP's old supervisor shutdown,
// which GenStage's ConsumerSupervisor and Horde's ProcessesSupervisor
// copy, monitors each child in monitor_child/1, looks once with `after
// 0` for an {:EXIT, ...} already queued, and returns :ok; its caller
// then blocks in wait_children until every child's {:DOWN, ...} has
// come. awaits_down_after names the calls such a wait follows on every
// path (a receive with no `after` taking any :DOWN, or the one for the
// ref the call returned, or a demonitor with :flush of that ref).
//
// The monitor is collected when every way the program has into the
// monitoring function passes such a call. Walked backward from each
// function the rule would report, over the ways in no wait follows
// (BackwardUnguarded, in reach.dl). A walk that reaches an exported
// function (its callers are outside the program), one nothing calls,
// or what a spawn runs (its process is not the caller's, and its wait
// collects nothing of this one) leaves the monitor exposed. A
// monitoring function nothing reaches but through one uncovered cycle
// is not collected either: some way in must be a covered call.
.init uncollected = BackwardUnguarded

uncollected.seed(g, g) :- outlives_its_wait(g).
uncollected.seed(g, g) :- monitor_ref_dropped(_, g).
uncollected.guarded(id) :- awaits_down_after(_, id).

.decl collection_exposed(func: symbol)

collection_exposed(g) :- uncollected.reaches(f, g), function_def(f, _, _, _, 1).
collection_exposed(g) :- uncollected.reaches(f, g), !call_edge(_, f).
collection_exposed(g) :- uncollected.reaches(h, g), runs_elsewhere(_, h).

.decl collected_by_callers(func: symbol)

collected_by_callers(g) :-
  uncollected.reaches(h, g),
  call_instr(f, h, id),
  awaits_down_after(f, id),
  !collection_exposed(g).

collected_by_callers(g) :-
  uncollected.reaches(h, g),
  fun_handed(id, f, h, _),
  awaits_down_after(f, id),
  !collection_exposed(g).

// A function whose return ends the process that runs it: what a spawn
// or a task runs, or what that runs as its last call, when nothing else
// calls it and it does not call itself again. The monitor it leaves live
// ends with the process (hexpm's streaming task gives up on a slow
// consumer and returns).
.decl process_tail(func: symbol)

process_tail(r) :-
  process_start(_, _, _, "spawn", r),
  monitor_call(_, m, _),
  (r = m ; call_edge(r, m)).

process_tail(g) :-
  process_tail(f),
  call_instr(f, g, id),
  tail_call(id),
  monitor_call(_, g, _).

.decl called_otherwise(func: symbol)

called_otherwise(g) :-
  process_tail(g),
  call_edge(f, g),
  !process_tail(f).

called_otherwise(g) :-
  process_tail(g),
  call_instr(_, g, id),
  !tail_call(id).

.init monitor_loop = SameProcessReach

monitor_loop.seed(g, g) :- process_tail(g).

.decl ends_its_process(func: symbol)

ends_its_process(g) :-
  process_tail(g),
  !called_otherwise(g),
  !recurses(g).

ends_its_process(g) :- on_the_way_out(_, g).

// ── What only terminate runs ──────────────────────────────────────────
//
// terminate/2,3 is the last callback: the process exits when it
// returns, and a monitor it takes, drops the ref of or leaves live
// after a timed wait ends with it. exq's WorkerDrainer monitors every
// worker from terminate/2 and waits out a grace period for their :DOWNs;
// what the grace period leaves is gone a moment later. A function any
// other callback (or state function) also reaches is not on the way
// out: the same monitor taken in handle_call/3 is judged as ever.
.init live_reach = ForwardIntraModuleSameProcessReach

live_reach.root(mod, func) :-
  otp_callback(func, mod, _, _),
  !function_def(func, mod, "terminate", _, _).

live_reach.root(mod, func) :-
  statem_process(mod),
  statem_state(mod, _, func),
  function_def(func, mod, _, _, _).

.decl on_the_way_out(mod: symbol, func: symbol)

on_the_way_out(mod, f) :- server_side(mod, f), !live_reach.reaches(mod, f).

.decl recurses(func: symbol)

recurses(g) :- process_tail(g), call_edge(g, h), monitor_loop.reaches(h, g).

// Removing an entry from a map, set, keyword or ETS table (removal_api,
// in effects.dl) — the bookkeeping paths a monitor's release belongs
// on. Anywhere in the module: Phoenix PubSub's Local removed
// subscriptions from a public table in its client API, and the monitor
// taken in handle_call stayed live all the same.

.decl removes_entries(mod: symbol)

removes_entries(mod) :-
  function_def(f, mod, _, _, _),
  remote_call(_, f, m, op, _),
  removal_api(m, op).

unconsumed_monitor(mod, f, site, "never_released") :-
  server_side(mod, f),
  !on_the_way_out(mod, f),
  monitor_call(site, f, _),
  !monitor_ref_dropped(site, f),
  removes_entries(mod),
  !module_demonitors(mod).

// ── A monitor whose ref is thrown away ───────────────────────────────
//
// `Process.monitor(pid)` with the result discarded, in a server's
// callbacks: the monitor can only ever end with the monitored process,
// since nothing holds what a demonitor would need. Phoenix PubSub's
// Local did this for every subscriber and removed subscriptions from a
// table in another module; every unsubscribe left a monitor behind.
// Reported separately from monitor_never_released because it needs no
// removal path in evidence — the ref being gone is the whole story.
//
// A dropped ref whose :DOWN is waited for all the same is collected, not
// lost: by the function itself (waited_out), or by every caller
// (collected_by_callers). OTP's old supervisor, as rabbit's supervisor2
// and brod's brod_supervisor3 copy it, monitors in monitor_child/1
// without keeping the ref, and shutdown/2 waits for the child's :DOWN by
// its pid.
unconsumed_monitor(mod, f, site, "ref_discarded") :-
  server_side(mod, f),
  !on_the_way_out(mod, f),
  monitor_call(site, f, _),
  monitor_ref_dropped(site, f),
  !waited_out(site),
  !collected_by_callers(f).

// ══ A message the module sends itself and cannot handle ═════════════
//
// The tag a call or cast sends is staged by stage 0 (`call_tag`).
.decl kind_callback(kind: symbol, callback: symbol)

kind_callback("call", "handle_call").
kind_callback("cast", "handle_cast").

.decl handler(mod: symbol, callback: symbol, func: symbol)

handler(mod, "handle_call", func) :- handle_call_function(mod, func).
handler(mod, "handle_cast", func) :- handle_cast_function(mod, func).

// A function that calls or casts to a DIFFERENT module is a proxy, and its
// tags are that module's business. Excluded wholesale: wrapping someone
// else's server is a legitimate shape, and getting it wrong means reporting
// correct code.
.decl proxies(func: symbol)

proxies(func) :-
  sync_call(func, callee),
  function_def(func, mod, _, _, _),
  callee != mod,
  callee != "dynamic".

proxies(func) :-
  async_cast(func, callee),
  function_def(func, mod, _, _, _),
  callee != mod,
  callee != "dynamic".

// A call or cast process points-to follows to another module's server.
proxies(func) :-
  call_target(func, kind, p),
  (kind = "call" ; kind = "cast"),
  server_process(p, other),
  function_def(func, mod, _, _, _),
  other != mod.

// A dynamic-target call whose tag some OTHER module's handler
// discriminates on is that module's business (horde's ProcessesSupervisor
// calling its DynamicSupervisorImpl through a pid), not a self-send.
proxies(func) :-
  call_tag(_, func, kind, tag),
  tag_handler(other, kind, tag),
  function_def(func, mod, _, _, _),
  other != mod.

reply_defect(mod, sender, "", cat("self_", kind), tag) :-
  call_tag(_, sender, kind, tag),
  function_def(sender, mod, _, _, _),
  kind_callback(kind, callback),
  handler(mod, callback, h),
  !proxies(sender),
  !callback_tag(h, callback, tag),
  !callback_total(h, callback).

// ══ A reply that can never be sent ══════════════════════════════════
//
// A handle_call/3 that defers its reply (`defers_reply`,
// clientlib/replies.dl) has promised the caller one.

// ── The promise cannot be kept ───────────────────────────────────
//
// `callback_drops_from` is per return site: some execution reaches this
// {:noreply, _} having never read `from`. That execution cannot reply, no
// matter what the rest of the program does.

reply_defect(mod, func, id, "dropped_from", "") :-
  defers_reply(mod, func, id),
  callback_drops_from(id, func).

// ── Not attempted: the reply that is stored and never sent ───────
//
// A module that keeps `from` and calls GenServer.reply/2 nowhere hangs its
// callers just as surely. It is not reported here, because stating it
// precisely needs escape analysis this does not have: `from` leaves the
// callback through a send, a spawned closure, an ETS write, or any call
// that happens to take it as an argument, and whoever receives it can
// reply. Suppressing on the routes one can enumerate leaves the rest as
// false positives.
//
// The heuristic version was written, measured against roughly six thousand
// modules, found nothing, and was removed. `defers_reply` above is where a
// real version would start.

// ══ gen_statem events without a clause ══════════════════════════════

// ── A state without an :info catch-all, beside states that have one ──
//
// In state_functions mode every state is its own callback, and a stray
// message is handled per state. Redix's Cluster.Manager gave
// disconnected/3 and cooling_down/3 an `(:info, _msg, _data)` clause and
// ready/3 none; an unexpected message in :ready was a FunctionClauseError
// that took the whole :one_for_all cluster tree with it. The sibling
// asymmetry is the precision gate: a module that handles stray messages
// in some states and not others has forgotten, not decided.
// statem_state carries one row per site a state is seen at — its own
// function and every transition targeting it — so the function_def join
// picks the definition.
partial_handler(mod, func, "statem_info", "catchall", state) :-
  statem_module(mod, "state_functions"),
  statem_state(mod, state, func),
  function_def(func, mod, _, _, _),
  !unhandled_info(_, _, _, _, _, mod, func, "state_crash"),
  !statem_info_catchall(mod, func),
  !statem_event_catchall(mod, func),
  statem_state(mod, other, g),
  other != state,
  statem_info_catchall(mod, g).

// ── A timeout armed that no clause handles ──────────────────────────
//
// {:timeout, ms, content} arms an event of type :timeout; {:state_timeout,
// ms, content} one of type :state_timeout. Postgrex's SimpleConnection
// armed the former and matched `handle_event(:info, :timeout, ...)` —
// the idle ping never ran and the event fell through to the generic
// :info clause. The module-level question is enough: some callback has
// a clause for the type, or accepts any type.
.decl statem_handles_event(mod: symbol, event_type: symbol)

statem_handles_event(mod, type) :- statem_event_clause(mod, _, type).
statem_handles_event(mod, "timeout") :- statem_event_catchall(mod, _).
statem_handles_event(mod, "state_timeout") :- statem_event_catchall(mod, _).
statem_handles_event(mod, "{timeout}") :- statem_event_catchall(mod, _).

partial_handler(mod, state, "statem_timeout", "event_timeout", "") :-
  statem_timeout(mod, state, "event_timeout", _),
  !statem_handles_event(mod, "timeout").

// A generic timeout {{:timeout, name}, ms, content} arrives as the
// event type {:timeout, name}: a tagged tuple, not the :timeout atom.
partial_handler(mod, state, "statem_timeout", "generic_timeout", "") :-
  statem_timeout(mod, state, "generic", _),
  !statem_handles_event(mod, "{timeout}").

partial_handler(mod, state, "statem_timeout", "state_timeout", "") :-
  statem_timeout(mod, state, "state_timeout", _),
  !statem_handles_event(mod, "state_timeout").

// ── A call that is never answered ────────────────────────────────────
//
// The extractor walks every {:call, from} clause to its returns and
// reports the ones that reply nothing, postpone nothing and keep `from`
// nowhere. The caller of :gen_statem.call/2 waits :infinity by default
// (sneako/finch#213: a cancel while disconnected blocked for days).
reply_defect(mod, func, site, "statem_unreplied", tag) :- statem_call_unreplied(mod, func, site, tag).

// ══ A message its process never takes ═══════════════════════════════
//
// A send that process points-to (sends.dl) follows to a spawned process
// none of whose receives has a clause for the message. It is not
// dropped: it stays in the mailbox for the life of the process, and
// every later receive scans past it. The receives are every one the
// process runs: the spawned function's and those of what it calls in
// its own process (a loop entered after a handshake), not only the
// spawned function's own, which on OTP's kernel was 6 of 56 sends to a
// spawned process. Judged only for a literal atom or a tuple with a
// literal tag, and only when the process runs some receive; never when a
// clause recv_pattern reads as "any" (a variable, a tuple pattern, a
// guard) could take it, and never when the process runs code whose
// receives are not the program's to read: a call through a fun or an
// apply, a gen_server or gen_statem enter_loop (its callbacks take the
// mailbox), a hibernate that resumes in an MFA.
.decl unreceived_message(mod: symbol, func: symbol, site: symbol, message: symbol, runs: symbol, starter: symbol, spawn: symbol, recv: symbol)
.output unreceived_message

.decl spawned_target(runs: symbol)

spawned_target(runs) :-
  send_target(_, _, m, p),
  m != "dynamic",
  instance(p, b),
  process_start(_, _, b, "spawn", runs).

.init spawned_reach = ForwardSameProcessReach

spawned_reach.root(r, r) :- spawned_target(r).

// A receive the process runs, and the messages its clauses take.
.decl process_receive(runs: symbol, recv: symbol)

process_receive(r, id) :- spawned_reach.reaches(r, g), recv_pattern(id, g, _).

.decl process_takes(runs: symbol, message: symbol)

process_takes(r, m) :- spawned_reach.reaches(r, g), recv_pattern(_, g, m).

.decl process_opaque(runs: symbol)

process_opaque(r) :- spawned_reach.reaches(r, g), dynamic_call(_, g, _).

process_opaque(r) :-
  spawned_reach.reaches(r, g),
  remote_call(_, g, m, "enter_loop", _),
  (m = ":gen_server" ; m = ":gen_statem" ; m = ":gen_event").

process_opaque(r) :-
  spawned_reach.reaches(r, g),
  remote_call(_, g, m, "hibernate", _),
  (m = ":erlang" ; m = ":proc_lib").

unreceived_message(mod, func, site, m, runs, starter, spawn, recv) :-
  send_target(site, func, m, p),
  m != "dynamic",
  instance(p, b),
  process_start(spawn, starter, b, "spawn", runs),
  process_receive(runs, recv),
  !process_takes(runs, m),
  !process_takes(runs, "any"),
  !process_opaque(runs),
  function_def(func, mod, _, _, _).

// ══ A message its server has no clause for ═════════════════════════
//
// The GenServer half of the question unreceived_message asks of a
// spawned process. A message reaches a server's handle_info/2 four
// ways the program spells out: a send process points-to follows to the
// server (sends.dl), a timer the server arms for itself, a monitor
// the server takes, whose {:DOWN, …} the runtime sends, and a socket the
// server makes active, whose close the runtime sends. When no clause
// of handle_info/2 takes the message, what happens depends on what the
// module has in its place (`fallback`):
//
// - "crash": clauses and no catch-all. The message is a
//   FunctionClauseError that takes the server down, every time it is
//   sent (sequin's SlotMessageStore armed :max_memory_check and handled
//   it nowhere; astarte's AMQPEventsProducer re-armed :init after a
//   refactor removed its clause).
// - "catch_all": a catch-all that does nothing with the message but log
//   it or ignore it (callback_drops). The message is dropped: the
//   monitor's :DOWN that should have removed a listener (oban's
//   Notifiers.PG leaked every dead listener), the timer whose work
//   never runs (teslamate's Repair armed :repair beside a handle_cast
//   for it). A catch-all may be meant, so this is its own kind.
// - "default": no handle_info/2 but GenServer's own, which logs the
//   message as an error and drops it.
// - "state_crash": a gen_statem's state function (or handle_event/4)
//   with no :info catch-all, where no callback of the machine takes the
//   message (below).
//
// A catch-all that hands the message on — to a helper, into the state —
// may take it there, and is not judged. Neither is a message a clause
// could take by its shape alone (callback_open: `msg when is_atom(msg)`
// takes any atom, `{ref, result}` a tuple of any tag). Judged for a
// literal atom and a tuple with a literal tag, :DOWN included. A message
// the server's own receives could take (a selective receive in a
// callback), and a monitor whose function waits on it or demonitors with
// :flush, are not judged.
.decl unhandled_info(mod: symbol, func: symbol, site: symbol, message: symbol, source: symbol, server: symbol, handler: symbol, fallback: symbol)
.output unhandled_info

// A message a server is sent, and where it comes from: `func` sends it
// at `site`, to a server running `server`'s callbacks.
.decl info_message(server: symbol, func: symbol, site: symbol, message: symbol, source: symbol)

info_message(m, f, id, msg, "send") :-
  send_target(id, f, msg, p),
  msg != "dynamic",
  !gen_envelope(msg),
  server_process(p, m).

// A timer or a monitor in a function a server's callbacks run: the
// callback's process arms it, so the message comes back to that server.
.init info_reach = SameProcessReach

info_reach.seed(f, f) :- timer_arm(id, f, "self", _, _, _), timer_tag(id, _, _).
info_reach.seed(f, f) :- monitor_call(_, f, _).
info_reach.seed(f, f) :- socket_activation(f, _, _).
info_reach.seed(f, f) :- socket_opened(f, _).

.decl runs_in_server(mod: symbol, func: symbol)

runs_in_server(m, f) :-
  process_entry(m, c),
  info_reach.reaches(c, f),
  server_process(_, m).

// Judged, as a send is, when the message is an atom or a tuple with an
// atom first (timer_tag): a literal is named as it is written, a tuple
// the site builds as pid_send spells one, `{:tag, …}`.
info_message(m, f, id, lit, "timer") :-
  timer_arm(id, f, "self", "bare", _, lit),
  timer_tag(id, _, _),
  runs_in_server(m, f).

info_message(m, f, id, cat("{", tag, ", …}"), "timer") :-
  timer_arm(id, f, "self", "dynamic", _, _),
  timer_tag(id, tag, _),
  runs_in_server(m, f).

// A monitor its own function waits on, in a receive or behind a
// demonitor with :flush, is consumed where it is taken.
.init receive_reach = SameProcessReachSet

receive_reach.seed(f) :- recv_pattern(_, f, _).

info_message(m, f, id, "{:DOWN, …}", "monitor") :-
  monitor_call(id, f, _),
  runs_in_server(m, f),
  !receive_reach.reaches(f),
  !flush.reaches(f).

// ── The close of a socket the server holds ───────────────────────────
//
// An active socket (`active: true`, `:once` or a count) sends what it
// receives to the process that controls it, and its end the same way:
// `{:tcp_closed, socket}` for TCP, `{:ssl_closed, socket}` for TLS, when
// the peer closes, the network drops or an alert ends the session. With
// no clause for it the first disconnect is a crash (kafka_ex#381's new
// client took only its own :update_metadata); a catch-all that only logs
// it leaves the server holding a socket that is gone (cqerl's TLS clients
// took `{:tcp_closed, _}`, let `{:ssl_closed, _}` fall into the catch-all,
// and answered every query after a server restart with a timeout).
//
// The server's process makes a socket active where it connects one
// (`:gen_tcp.connect/3,4`, `:ssl.connect/2,3,4`, active unless the
// options say otherwise) or sets its options (`:inet.setopts/2`,
// `:ssl.setopts/2`, a transport module's `setopts/2` through a variable)
// with a literal mode, or where it hands a wrapper of the program's the
// literal list the wrapper sets (`Socket.setopts(s, [:binary, active:
// true])`, through any chain of parameters). Which close that means
// follows the socket: `:ssl.setopts/2` a TLS one's, `:inet.setopts/2` a
// TCP one's when the server's process connects TCP sockets (it may be a
// UDP one, which has no close), a transport in a variable either kind the
// process connects. Soundness rests on the extractor's literal reading:
// options it cannot read say nothing, so a socket made active by options
// built at runtime is missed, never assumed. A function that hands its
// socket to another process (controlling_process) is not judged: the
// messages go to that process. Nor is an accepted socket, which takes
// its mode from the listening socket.
.decl socket_active_mode(mode: symbol)

socket_active_mode("true").
socket_active_mode("once").
socket_active_mode("n").
socket_active_mode("default").

// The literal a caller hands a wrapper's options parameter, directly or
// forwarded through its own parameters.
.decl socket_opts_needed(func: symbol, pos: number)

socket_opts_needed(g, p) :- socket_active(_, g, _, "param", p).
socket_opts_needed(f, q) :- socket_opts_needed(g, p), call_arg_forward(f, g, p, q).

.decl socket_opts_at(func: symbol, pos: number, site: symbol, caller: symbol, mode: symbol)

socket_opts_at(g, p, id, c, mode) :- socket_opts_needed(g, p), socket_opts_arg(id, c, g, p, mode).

socket_opts_at(g, p, id, c, mode) :-
  socket_opts_needed(g, p),
  call_arg_forward(f, g, p, q),
  socket_opts_at(f, q, id, c, mode).

// `func` makes a socket of `transport` active at `site`: the call itself,
// or the call handing a wrapper the literal it sets.
.decl socket_activation(func: symbol, site: symbol, transport: symbol)

socket_activation(f, id, t) :- socket_active(id, f, t, mode, _), socket_active_mode(mode).

socket_activation(c, id, t) :-
  socket_active(_, g, t, "param", p),
  socket_opts_at(g, p, id, c, mode),
  socket_active_mode(mode).

// A function that connects, or sets options on, a socket of a known kind.
.decl socket_opened(func: symbol, transport: symbol)

socket_opened(f, t) :- socket_active(_, f, t, _, _), (t = "tcp" ; t = "ssl").

// A function that hands a socket to another process.
.decl hands_socket_off(func: symbol)

hands_socket_off(f) :- remote_call(_, f, ":gen_tcp", "controlling_process", 2).
hands_socket_off(f) :- remote_call(_, f, ":ssl", "controlling_process", 2).

// The kinds of socket a server's process connects.
.decl server_holds(server: symbol, transport: symbol)

server_holds(m, t) :- socket_opened(f, t), runs_in_server(m, f).

.decl socket_close(transport: symbol, message: symbol)

socket_close("tcp", "{:tcp_closed, …}").
socket_close("ssl", "{:ssl_closed, …}").

.decl activation_close(func: symbol, site: symbol, server: symbol, message: symbol)

activation_close(f, id, m, msg) :-
  socket_activation(f, id, t),
  socket_close(t, msg),
  runs_in_server(m, f).

activation_close(f, id, m, msg) :-
  socket_activation(f, id, "inet"),
  runs_in_server(m, f),
  server_holds(m, "tcp"),
  socket_close("tcp", msg).

activation_close(f, id, m, msg) :-
  socket_activation(f, id, "any"),
  runs_in_server(m, f),
  server_holds(m, t),
  socket_close(t, msg).

info_message(m, f, id, msg, "socket") :-
  activation_close(f, id, m, msg),
  !hands_socket_off(f).

// Whether `tag` is what `message` is told apart by: the atom itself, or
// a tuple's literal tag (`{:tag, …}`, as pid_send spells it). Joined from
// the tag's side with cat/2: the message is not parsed. A timer's is its
// timer_tag: a literal tuple (`{:warm_up, 5}`) is spelled whole, and the
// join would find no tag for it.
.decl tag_of(message: symbol, tag: symbol)

tag_of(msg, tag) :- info_message(_, _, id, msg, "timer"), timer_tag(id, tag, _).

tag_of(msg, tag) :- info_message(_, _, _, msg, _), callback_tag(_, "handle_info", tag), msg = tag.

tag_of(msg, tag) :-
  info_message(_, _, _, msg, _),
  callback_tag(_, "handle_info", tag),
  msg = cat("{", cat(tag, ", …}")).

tag_of(msg, tag) :- info_message(_, _, _, msg, _), statem_info_tag(_, _, tag), msg = tag.

tag_of(msg, tag) :-
  info_message(_, _, _, msg, _),
  statem_info_tag(_, _, tag),
  msg = cat("{", cat(tag, ", …}")).

// A receive in the server's own code that could take the message.
.decl server_receives(mod: symbol, message: symbol)

server_receives(m, msg) :-
  info_message(m, _, _, msg, _),
  server_side(m, g),
  recv_pattern(_, g, x),
  (x = msg ; x = "any").

// Where the message goes instead of a clause of its own.
.decl info_fallback(mod: symbol, message: symbol, handler: symbol, fallback: symbol)

info_fallback(m, msg, h, "crash") :-
  info_message(m, _, _, msg, _),
  partial_handle_info(m, h).

info_fallback(m, msg, h, "catch_all") :-
  info_message(m, _, _, msg, _),
  function_def(h, m, "handle_info", 2, _),
  callback_drops(h, "handle_info"),
  !macro_generated(h, _).

info_fallback(m, msg, h, "default") :-
  info_message(m, _, _, msg, _),
  function_def(h, m, "handle_info", 2, _),
  callback_drops(h, "handle_info"),
  macro_generated(h, _).

// A message some clause could take: its tag is compared, or a clause
// tests the message by shape alone and a tuple of any tag, or an atom,
// could pass it.
.decl info_taken(handler: symbol, message: symbol)

info_taken(h, msg) :-
  info_fallback(_, msg, h, _),
  tag_of(msg, tag),
  callback_tag(h, "handle_info", tag).

// A timer's message a clause head takes in its own shape: a literal
// tuple head (`handle_info({:tick, :fast}, s)` is one comparison with
// the tuple) compares no atom callback_tag sees.
info_taken(h, msg) :-
  info_fallback(_, msg, h, _),
  info_message(_, _, id, msg, "timer"),
  timer_tag(id, tag, ar),
  callback_tag_shape(h, "handle_info", tag, ar).

info_taken(h, msg) :- info_fallback(_, msg, h, _), callback_open(h, "handle_info", "any").

info_taken(h, msg) :-
  info_fallback(_, msg, h, _),
  match("[{].*", msg),
  callback_open(h, "handle_info", "tuple").

unhandled_info(mod, f, id, msg, source, m, h, fallback) :-
  info_message(m, f, id, msg, source),
  (behaves_as(m, "GenServer") ; behaves_as(m, "GenStage")),
  !statem_process(m),
  info_fallback(m, msg, h, fallback),
  !info_taken(h, msg),
  !server_receives(m, msg),
  function_def(f, mod, _, _, _).

// A timer whose tag a clause compares, but whose shape no clause head
// takes (timer_refused: a `{:tick, 1, :slow}` beside `{:tick, n}`), is
// as unhandled as one whose tag none compares.
unhandled_info(mod, f, id, msg, "timer", m, h, fallback) :-
  info_message(m, f, id, msg, "timer"),
  (behaves_as(m, "GenServer") ; behaves_as(m, "GenStage")),
  !statem_process(m),
  info_fallback(m, msg, h, fallback),
  info_taken(h, msg),
  timer_refused(h, id),
  !server_receives(m, msg),
  function_def(f, mod, _, _, _).

// ── The same message sent to a gen_statem ──────────────────────────
//
// It arrives as an :info event, in whatever state the machine is in: a
// state function (or handle_event/4) with neither an :info catch-all nor
// one for every event crashes on it. Judged only when no callback of the
// machine compares its tag or takes it by shape (statem_info_tag,
// statem_info_open): a message some state takes may be one the program
// only sends while the machine is in that state. A catch-all is not
// judged here — whether it drops the content is not read for a machine.
.decl statem_takes(mod: symbol, message: symbol)

statem_takes(m, msg) :-
  info_message(m, _, _, msg, _),
  tag_of(msg, tag),
  statem_info_tag(m, _, tag).

statem_takes(m, msg) :- info_message(m, _, _, msg, _), statem_info_open(m, _, "any").

statem_takes(m, msg) :-
  info_message(m, _, _, msg, _),
  match("[{].*", msg),
  statem_info_open(m, _, "tuple").

// A callback of the machine's that crashes on an :info it has no clause
// for: a state function, or handle_event/4.
.decl statem_info_partial(mod: symbol, func: symbol)

statem_info_partial(m, h) :-
  statem_process(m),
  statem_event_clause(m, h, _),
  !statem_info_catchall(m, h),
  !statem_event_catchall(m, h).

unhandled_info(mod, f, id, msg, source, m, h, "state_crash") :-
  info_message(m, f, id, msg, source),
  statem_info_partial(m, h),
  !statem_takes(m, msg),
  !server_receives(m, msg),
  function_def(f, mod, _, _, _).

// The module's partial handle_info/2 is already named by a message it
// cannot take: partial_handler's catch-all findings step aside.
.decl info_crash(mod: symbol)

info_crash(m) :- unhandled_info(_, _, _, _, _, m, _, "crash").
