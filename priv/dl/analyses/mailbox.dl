// A message arrives and nothing takes it, or takes it wrongly.
//
// A process's mailbox is written by more than its owner: a task's
// reply, a monitor's :DOWN, a timer that fired before it was cancelled,
// a subscription's broadcast, the module's own client API. Every finding
// here is a message the program is shown to send and the clause that is
// not there for it, or the reply a caller waits for that never comes: a
// message a server is sent and cannot take (a send, a timer, a monitor's
// :DOWN, a socket's close, node events, a port's output, an async_nolink
// task's reply and :DOWN, what a timed receive leaves behind), a monitor
// taken again before the last one is released, a cancelled timer's stale
// message, a tag the module sends itself and cannot handle, a
// handle_call that defers a reply it cannot send, a statem timeout no
// clause matches. A handle_info/2 with no catch-all is no finding by
// itself: only a message that falls through it is.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/sends.dl"
.include "../clientlib/replies.dl"
.include "../clientlib/test_code.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/order.dl"
.include "../clientlib/timer_flush.dl"
.include "../clientlib/live_view.dl"
.include "../clientlib/runs.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ══ The outputs ═════════════════════════════════════════════════════
//
// `monitor_leak(mod, func, site, how)` — a monitor taken again before the
//   one before it is released, in code that runs again: "wait" (a way
//   out of the wait keeps it), "ended" (the server drops its record of
//   the process and keeps the monitor), "dropped" (the ref thrown away,
//   taken without asking the state). See "Monitors that pile up".
// `task_result_defect(func, site, kind)` — a Task.async whose result
//   goes wrong: "never_awaited", "yield_linked" (collected with
//   Task.yield in a process that does not trap exits),
//   "linked_in_library" (started in library code, linked to whoever
//   called it).
// `reply_defect(mod, func, site, kind, tag)` — a reply that never comes:
//   "unhandled_call" | "unhandled_cast" (the module sends its own server
//   `tag` and has no clause for it; `func` is the sender — not
//   clientlib's `self_call`, a call provably to the calling process), "dropped_from" (a
//   handle_call defers a reply without keeping `from`; `site` is the
//   return), "statem_unreplied" (a {:call, from} clause answers nothing).

.decl task_result_defect(func: symbol, site: symbol, kind: symbol)
.output task_result_defect

.decl reply_defect(mod: symbol, func: symbol, site: symbol, kind: symbol, tag: symbol)
.output reply_defect

// ══ Stale timers ══════════════════════════════════════════════════
// ── A timer cancelled but not flushed ────────────────────────────────
//
// Process.cancel_timer/1 does not remove a message the timer already
// delivered. A process that cancels and re-arms a timer whose message
// is a bare atom (`:tick`) cannot tell the stale message from the next
// one: the action fires twice, or early (MongooseIM#3502, beam-bots/bb
// #214; nebulex's generation rotation and cachex's warmer have the
// shape). A message that carries the timer's ref (`{:tick, ref}`, or
// :erlang.start_timer's `{:timeout, ref, _}`) is matched against the
// current ref; a `receive :tick -> :ok after 0 -> :ok end` flushes.
// Cancelling only in terminate/2 arms nothing again.
//
// The timer's identity is followed through the state: the ref the arm
// site produces is returned or stored under a map key (timer_ref,
// returns_call, timer_store), and the ref a cancel site takes was read
// from a map key or handed in as a parameter (timer_cancel,
// call_arg_field). A cancel and an arm pair up only on the same key,
// so a module with a heartbeat and a reconnect timer gets two verdicts.
// The flush must name the armed message (recv_pattern), or match
// anything, and be where the cancel is: in the function that cancels,
// or one a call after the cancel runs (flushes_after_cancel). A receive
// for the message before the cancel, or in an unrelated function of the
// module, is no flush.

// The map key the ref armed in `a` ends up under.
.decl timer_key(arm: symbol, key: symbol)

timer_key(a, key) :- timer_ref(_, a, "stored", key).

timer_key(a, key) :-
  timer_ref(_, a, "returned", _),
  returns_to_key(a, key).

.decl returns_to_key(func: symbol, key: symbol)

returns_to_key(f, key) :- timer_store(_, key, f).

returns_to_key(f, key) :-
  returns_call(g, f),
  returns_to_key(g, key).

// The map key a parameter carries a field of, from the callers that
// read it and passed it down.
.decl param_field(func: symbol, pos: number, key: symbol)

param_field(f, pos, key) :- call_arg_field(_, f, pos, key).

param_field(f, pos, key) :-
  call_arg_forward(g, f, pos, gpos),
  param_field(g, gpos, key).

// The literal a timer armed for the arming process carries: at the
// site, or a parameter the callers fill with a literal (nebulex's
// `start_timer(time, ref, event)` with `event \\ :heartbeat`).
.decl armed_message(arm: symbol, message: symbol)

armed_message(a, lit) :- armed_literal(_, a, "self", lit).

// The message the timer kept under `key` carries. A literal at the arm
// site is it. A parameter is filled along the calls that store the ref
// — the storing function's own call to the arming function, or a
// wrapper it goes through that fills the parameter itself or forwards
// one the storing function filled — so two keys armed through one
// helper each get their own message: nebulex's
// `start_timer(time, ref, event \\ :heartbeat)` keeps :cleanup under
// one key and :heartbeat under another. When the arming function stores
// the ref itself, its callers are the only source, and any literal they
// pass is taken (armed_message).
.decl stored_message(key: symbol, arm: symbol, message: symbol)

stored_message(key, a, lit) :-
  timer_key(a, key),
  timer_arm(_, a, "self", "bare", _, lit).

stored_message(key, a, lit) :-
  timer_ref(_, a, "stored", key),
  timer_arm(_, a, "self", "param", _, _),
  armed_message(a, lit).

stored_message(key, a, lit) :-
  timer_ref(_, a, "returned", _),
  timer_arm(_, a, "self", "param", pos, _),
  timer_store(f, key, callee),
  literal_toward(f, callee, a, pos, lit).

// `lit` fills parameter `pos` of `to` on the way from `from`'s call to
// `callee`: at that call when the callee is `to`, else through a
// wrapper that returns `to`'s result and either fills the parameter or
// forwards one of its own that `from` filled. One wrapper deep, which
// is what default arguments compile to.
.decl literal_toward(from: symbol, callee: symbol, to: symbol, pos: number, lit: symbol)

literal_toward(f, a, a, pos, lit) :-
  call_arg(f, a, pos, lit),
  lit != "dynamic".

literal_toward(f, w, a, pos, lit) :-
  returns_call(w, a),
  call_arg(w, a, pos, lit),
  lit != "dynamic",
  call_arg(f, w, _, _).

literal_toward(f, w, a, pos, lit) :-
  returns_call(w, a),
  call_arg_forward(w, a, pos, wpos),
  call_arg(f, w, wpos, lit),
  lit != "dynamic".

.decl timer_cancel_without_flush(mod: symbol, cancel: symbol, arm: symbol, key: symbol, message: symbol, cancel_site: symbol, arm_site: symbol)
.output timer_cancel_without_flush

// The cancel_timer instruction in `cancel` that read the ref from `key`:
// at the site, or at a caller that read it and passed it down.
.decl cancel_site(cancel: symbol, key: symbol, id: symbol)

cancel_site(c, key, id) :- timer_cancel(id, c, "field", key, _).

cancel_site(c, key, id) :-
  timer_cancel(id, c, "param", _, pos),
  param_field(c, pos, key).

// A cancel that cannot leave a stale message behind for the process to
// mistake for the next one:
//
// - one in terminate/2, or in a helper only terminate/2 calls (directly,
//   or through one more helper only such helpers call): the process is
//   going away, and no later message is handled. A helper nothing in the
//   program calls is not one: BB.Loop.cancel/1's docs said "call from
//   terminate/2", and its callers also called it before re-arming at a
//   new rate (bb#214, fixed with the flush);
// - one in the `handle_info/2` clause of the very message the timer
//   sends (`def handle_info(:heartbeat, s)` cancelling heartbeat_ref):
//   that timer has already fired, and its message is the one being
//   handled (cancel_clause).
.decl terminate_helper(func: symbol)
.decl called_outside_terminate(func: symbol)

called_outside_terminate(g) :- call_edge(f, g), !terminate_callback(f, _, _).

terminate_helper(g) :-
  call_edge(f, g),
  terminate_callback(f, _, _),
  !called_outside_terminate(g).

.decl terminate_helper2(func: symbol)
.decl called_outside_terminate2(func: symbol)

called_outside_terminate2(h) :-
  call_edge(g, h),
  !terminate_callback(g, _, _),
  !terminate_helper(g).

terminate_helper2(h) :-
  call_edge(g, h),
  (terminate_callback(g, _, _) ; terminate_helper(g)),
  !called_outside_terminate2(h).

.decl runs_only_on_the_way_out(func: symbol)

runs_only_on_the_way_out(c) :- terminate_callback(c, _, _).
runs_only_on_the_way_out(c) :- terminate_helper(c).
runs_only_on_the_way_out(c) :- terminate_helper2(c).

// The cancel is in the handle_info/2 clause of the timer's own message:
// the message is the one being handled, not one left behind.
.decl handles_that_message(cancel: symbol, message: symbol) inline

handles_that_message(cancel, msg) :- cancel_clause(cancel, _, msg).

// ── A timer kept in a local ──

// A function arms a timer, keeps its ref in a local and cancels it, the
// function runs again, and nothing takes the old timer's message out of
// the mailbox: the next run handles it as its own.
//
// `cancel` and `arm` are the cancel_timer and send_after instructions
// (the function holding both is the output's cancel and arm columns).
.decl local_cancel_without_flush(cancel: symbol, arm: symbol, message: symbol)

local_cancel_without_flush(cancel, arm, message) :-
  cancels_timer_kept_in_local(cancel, arm),
  carries_message(arm, message),
  !cancelled_in_init(cancel),
  !cancelled_on_the_way_out(cancel),
  !flushes_after_cancel(cancel, message).

// init/1 cancels a watchdog it armed and kept in a local, the server's
// handle_info/2 has a clause for the watchdog's message, and nothing
// takes a message the watchdog already delivered: once init/1 returns,
// that clause acts on a timer init/1 cancelled.
.decl init_cancel_without_flush(cancel: symbol, arm: symbol, message: symbol)

init_cancel_without_flush(cancel, arm, message) :-
  cancels_timer_kept_in_local(cancel, arm),
  carries_message(arm, message),
  cancelled_in_init(cancel),
  server_has_clause_for(cancel, message),
  !flushes_after_cancel(cancel, message).

timer_cancel_without_flush(mod, func, func, "", message, cancel, arm) :-
  local_cancel_without_flush(cancel, arm, message),
  timer_cancel(cancel, func, _, _, _),
  in_module(func, mod).

timer_cancel_without_flush(mod, func, func, "", message, cancel, arm) :-
  init_cancel_without_flush(cancel, arm, message),
  timer_cancel(cancel, func, _, _, _),
  in_module(func, mod).

// The cancel_timer `cancel` takes the ref of the send_after `arm`, which
// the same function made and kept in a local (`ref = send_after(...);
// work(); cancel_timer(ref)`). No state key pairs them; the arming site
// does. The clause that takes the same message is no excuse here
// (handles_that_message is the kept key's): this timer was armed after
// the message being handled arrived, so what it delivers is always one
// left behind.
.decl cancels_timer_kept_in_local(cancel: symbol, arm: symbol) inline

cancels_timer_kept_in_local(cancel, arm) :-
  timer_cancel(cancel, c, "local", arm, _),
  timer_arm(arm, c, "self", _, _, _).

// The timer armed at `arm` carries the literal `message` (armed_literal,
// clientlib/timer_flush.dl).
.decl carries_message(arm: symbol, message: symbol)

carries_message(arm, lit) :- armed_literal(arm, _, "self", lit).

// The cancel is in init/1, which runs once: what its watchdog delivers
// is no next run's, and handle_info/2 takes it once init/1 returns, as
// if the timer had just fired. Left to a catch-all, it is dropped.
.decl cancelled_in_init(cancel: symbol)

cancelled_in_init(cancel) :- timer_cancel(cancel, c, _, _, _), is_init(c).

// The module of the cancel has a handle_info/2 whose clauses compare the
// message (callback_tag).
.decl server_has_clause_for(cancel: symbol, message: symbol)

server_has_clause_for(cancel, message) :-
  timer_cancel(cancel, c, _, _, _),
  in_module(c, mod),
  function_def(h, mod, "handle_info", 2, _),
  callback_tag(h, "handle_info", message).

// ── A timer kept under a state key ──

// A timer kept under a state key is cancelled and armed again under that
// key, and nothing takes the old timer's message out of the mailbox.
//
// `cancel` and `rearm` are the cancel_timer and send_after instructions
// (the functions holding them are the output's cancel and arm columns);
// `key` is what pairs them, and `message` is what a flush must take.
.decl cancel_without_flush(cancel: symbol, rearm: symbol, key: symbol, message: symbol)

cancel_without_flush(cancel, rearm, key, message) :-
  cancels_timer_kept_under(cancel, key),
  rearms_timer_kept_under(rearm, key, message),
  in_same_module(cancel, rearm),
  !cancelled_on_the_way_out(cancel),
  !takes_old_message(cancel, message).

timer_cancel_without_flush(mod, cancel, arm, key, message, cancel_site, arm_site) :-
  timer_ranked(mod, cancel, arm, key, message, cancel_site, arm_site),
  !site_under_test(arm_site).

timer_cancel_without_flush(mod, cancel, arm, key, message, cancel_site, arm_site) :-
  timer_ranked(mod, cancel, arm, key, message, cancel_site, arm_site),
  !arm_off_test(mod, key).

// Every cancel and arm that pair up under a key.
.decl timer_pair(mod: symbol, cancel: symbol, arm: symbol, key: symbol, message: symbol, cancel_site: symbol, arm_site: symbol)

timer_pair(mod, cancel, arm, key, message, cancel_site, arm_site) :-
  cancel_without_flush(cancel_site, arm_site, key, message),
  cancel_site(cancel, key, cancel_site),
  rearm_site(arm_site, arm, key, message),
  in_module(cancel, mod).

// ── Where a key's finding points ──
//
// A key is one finding however many cancels and arms pair up under it
// (the relation's dedupe key), and the finding points at the least row,
// which orders by function name. Plausible's WriteBuffer cancels its
// :tick timer in handle_cast's buffer-full branch, the path every
// insert can take, and in handle_call(:flush), which only its test
// helpers request; the name put handle_call first. The rows keep a
// cancel the program itself runs over one only its tests reach
// (test_code.dl), and then an arm likewise; a key whose cancels are all
// under test keeps them all. The cancels left out are the finding's
// related frames (timer_cancel_under_test). Which modules and keys are
// reported does not change.
.decl timer_ranked(mod: symbol, cancel: symbol, arm: symbol, key: symbol, message: symbol, cancel_site: symbol, arm_site: symbol)

timer_ranked(mod, cancel, arm, key, message, cancel_site, arm_site) :-
  timer_pair(mod, cancel, arm, key, message, cancel_site, arm_site),
  !site_under_test(cancel_site).

timer_ranked(mod, cancel, arm, key, message, cancel_site, arm_site) :-
  timer_pair(mod, cancel, arm, key, message, cancel_site, arm_site),
  !cancel_off_test(mod, key).

// Some cancel under the key runs outside the tests.
.decl cancel_off_test(mod: symbol, key: symbol)

cancel_off_test(mod, key) :-
  timer_pair(mod, _, _, key, _, cancel_site, _),
  !site_under_test(cancel_site).

// Some arm of the ranked rows runs outside the tests.
.decl arm_off_test(mod: symbol, key: symbol)

arm_off_test(mod, key) :-
  timer_ranked(mod, _, _, key, _, _, arm_site),
  !site_under_test(arm_site).

// A cancel or arm site whose function runs only under test, or is a
// callback every request for which comes from code that does.
.decl site_under_test(site: symbol)

site_under_test(id) :- cancel_site(c, _, id), runs_under_test(c).
site_under_test(id) :- cancel_site(c, _, id), requested_only_under_test(c).
site_under_test(id) :- rearm_site(id, a, _, _), runs_under_test(a).
site_under_test(id) :- rearm_site(id, a, _, _), requested_only_under_test(a).

// A handle_call/3 or handle_cast/2 whose requests the program sends
// only from code under test: some site sends one of the tags it
// compares, of its kind, and every such site runs only under test.
// Over-approximated by callback_tag (every atom its body compares), so a
// callback with any request sent from elsewhere is not one.
.decl requested_only_under_test(callback: symbol)
.decl requested_outside_tests(callback: symbol)

requested_outside_tests(h) :-
  kind_callback(kind, cb),
  function_def(h, _, cb, _, _),
  callback_tag(h, cb, tag),
  call_tag(_, s, kind, tag),
  !runs_under_test(s).

requested_only_under_test(h) :-
  kind_callback(kind, cb),
  function_def(h, _, cb, _, _),
  callback_tag(h, cb, tag),
  call_tag(_, s, kind, tag),
  runs_under_test(s),
  !requested_outside_tests(h).

// ── Evidence: a cancel only the tests reach ──
.decl timer_cancel_under_test(mod: symbol, key: symbol, site: symbol, func: symbol)
.output timer_cancel_under_test

timer_cancel_under_test(mod, key, cancel_site, cancel) :-
  timer_pair(mod, cancel, _, key, _, cancel_site, _),
  site_under_test(cancel_site),
  cancel_off_test(mod, key).

// The cancel_timer `cancel` takes the ref kept under `key` (cancel_site
// above).
.decl cancels_timer_kept_under(cancel: symbol, key: symbol) inline

cancels_timer_kept_under(cancel, key) :- cancel_site(_, key, cancel).

// The send_after `rearm` keeps its ref under `key`, and the timer carries
// `message`. The arm must be one that can follow the cancel (rearm_site
// below): a timer armed only in init/1 and cancelled later is stopped,
// not re-armed, and its stale message is handled once as an ordinary one.
.decl rearms_timer_kept_under(rearm: symbol, key: symbol, message: symbol) inline

rearms_timer_kept_under(rearm, key, msg) :- rearm_site(rearm, _, key, msg).

// The send_after at `arm_site` in `arm` keeps its ref under `key`, and
// the timer carries `message`; an arm in init/1 does not re-arm.
.decl rearm_site(arm_site: symbol, arm: symbol, key: symbol, message: symbol)

rearm_site(arm_site, a, key, msg) :-
  timer_key(a, key),
  stored_message(key, a, msg),
  timer_arm(arm_site, a, "self", _, _, _),
  in_module(a, mod),
  !init_function(mod, a).

// The functions holding the cancel and the arm are in one module.
.decl in_same_module(cancel: symbol, arm: symbol)

in_same_module(cancel, arm) :-
  cancel_site(c, _, cancel),
  rearm_site(arm, a, _, _),
  in_module(c, mod),
  in_module(a, mod).

// The cancel is in terminate/2, or a helper only it runs.
.decl cancelled_on_the_way_out(cancel: symbol)

cancelled_on_the_way_out(cancel) :- timer_cancel(cancel, c, _, _, _), runs_only_on_the_way_out(c).

// The old timer's message leaves the mailbox where the cancel is: a
// receive flushes it (flushes_after_cancel), or the cancel is in the
// handle_info/2 clause taking that very message (handles_that_message),
// so the timer has fired and its message is the one being handled.
.decl takes_old_message(cancel: symbol, message: symbol)

takes_old_message(cancel, msg) :- flushes_after_cancel(cancel, msg).
takes_old_message(cancel, msg) :- handles_that_message(cancel, msg).

// A receive after the cancel takes the message: by name, or a clause
// that matches anything (`after 0` with a wildcard, the cancel_timer
// docs' blocking receive, Ostinato.Eager). After the cancel means later
// on a path through the function holding it (runs_after,
// clientlib/order.dl), or in a function a call there runs in the same
// process (a `flush_tick/0` helper); where a caller hands the ref down
// to a cancel helper, or calls a helper that reads the field and cancels
// it, it means after that call in the caller. A receive before the
// cancel, in another clause of the function or elsewhere in the module
// runs on some other path: one handle_cast/2 waits in does not flush the
// heartbeat handle_call/3 cancels, and a receive the timer can fire
// after leaves its message behind.
.decl flushes_after_cancel(cancel: symbol, message: symbol)

// The cancel's own function flushes after it: every caller's path
// passes it.
flushes_after_cancel(cancel, msg) :-
  timer_cancel(cancel, _, _, _, _),
  flushes_after(cancel, msg).

// The cancel is made on its callers' behalf (helper_cancel): flushed
// only when every call toward it, from a caller that is not on the way
// out, is followed by a flush. One caller's flush is not another's: a
// :pause that flushes does not cover a :reset that re-arms without
// flushing (review 2, item 19).
flushes_after_cancel(cancel, msg) :-
  helper_cancel(cancel, _, site),
  flushes_after(site, msg),
  !unflushed_caller(cancel, msg).

.decl unflushed_caller(cancel: symbol, message: symbol)

unflushed_caller(cancel, msg) :-
  helper_cancel(cancel, g, site),
  !runs_only_on_the_way_out(g),
  armed_message(_, msg),
  !flushes_after(site, msg).

// A receive that takes the message runs after the instruction `site`
// (a cancel, or a call toward one): in its function, or in a function a
// later call there runs in the same process.
.decl flushes_after(site: symbol, message: symbol)

flushes_after(site, msg) :-
  after_cancel.runs_after(site, recv),
  takes_message(recv, msg).

flushes_after(site, msg) :-
  after_cancel.runs_after(site, call),
  calls_in_process(call, h),
  flushes_in(h, msg).

.init after_cancel = RunsAfter

after_cancel.asked(cancel) :- timer_cancel(cancel, _, _, _, _).
after_cancel.asked(site) :- helper_cancel(_, _, site).

// The receive `recv` takes the message: a clause names it, or matches
// anything.
.decl takes_message(recv: symbol, message: symbol)

takes_message(recv, msg) :- recv_pattern(recv, _, msg).

takes_message(recv, msg) :-
  recv_pattern(recv, _, "any"),
  armed_message(_, msg).

// The call at `call` runs `h` in the caller's process: a function of the
// program called there, or a closure handed to it that is not run
// elsewhere. A side path (side_call) is not the caller's flush.
.decl calls_in_process(call: symbol, callee: symbol)

calls_in_process(call, h) :-
  call_instr(f, h, call),
  !runs_elsewhere(f, h),
  !side_call(f, h).

calls_in_process(call, h) :-
  fun_handed(call, f, h, _),
  !runs_elsewhere(f, h),
  !side_call(f, h).

// `f`, or what it runs in its own process, has a receive that takes the
// message.
.decl flushes_in(func: symbol, message: symbol)

flushes_in(f, msg) :- flush_scope.reaches(f, g), recv_pattern(recv, g, _), takes_message(recv, msg).

.init flush_scope = ForwardSameProcessReachCut

flush_scope.cut(f, g) :- side_call(f, g).
flush_scope.root(h, h) :- after_cancel.runs_after(_, call), calls_in_process(call, h).

// The call at `site` in `func` makes the cancel_timer `cancel` through a
// helper: it hands the ref down (hands_down_ref), or it calls, in its
// process, a function of its module that reads the field and cancels it
// (helper_cancels_field, clientlib/timer_flush.dl: MongooseIM's
// maybe_cancel_timer/2).
.decl helper_cancel(cancel: symbol, func: symbol, site: symbol)

helper_cancel(cancel, g, site) :- hands_down_ref(cancel, g, site).
helper_cancel(cancel, g, site) :- helper_cancels_field(g, site, cancel, _).

// `func` passes the ref the cancel_timer `cancel` takes as a parameter,
// read from its state or its own parameter (param_field's path), at its
// calls to the function taking it (`site`: every call to that function,
// as the argument facts name no call).
.decl hands_down_ref(cancel: symbol, func: symbol, site: symbol)
.decl ref_param(cancel: symbol, func: symbol, pos: number)

ref_param(cancel, c, pos) :- timer_cancel(cancel, c, "param", _, pos).

ref_param(cancel, g, gpos) :-
  ref_param(cancel, f, pos),
  call_arg_forward(g, f, pos, gpos).

hands_down_ref(cancel, g, site) :-
  ref_param(cancel, f, pos),
  (call_arg_field(g, f, pos, _) ; call_arg_forward(g, f, pos, _)),
  call_instr(g, f, site).

// ══ Tasks whose messages land unhandled ═════════════════════════════
//
// A task a function starts linked to itself (Task.async,
// Task.Supervisor.async) must be awaited or yielded: its reply,
// `{ref, result}`, and its :DOWN land in the mailbox of the process that
// started it. Task.Supervisor.async_nolink is not one: it is not linked
// to the caller, and its messages are unhandled_info's source "task"
// below.

// ── A task never awaited ──

// A function starts a task linked to it and nothing takes the task's
// reply: its path never awaits, it does not hand the task to its caller,
// and no mailbox callback of its server takes the reply. A handle_info/2
// that takes other messages only crashes on the reply, and a catch-all —
// the one `use GenServer` injects, or the program's own — drops it with
// the result.
.decl unawaited_task(func: symbol, start: symbol)

unawaited_task(func, start) :-
  starts_linked_task(func, start),
  !collects_a_task(func),
  !returns_task(func, start),
  !reply_taken(func).

task_result_defect(func, start, "never_awaited") :- unawaited_task(func, start).

// The call at `start` in `func` starts a task linked to the calling
// process (task_start_api "linked", clientlib/runs_elsewhere.dl).
.decl starts_linked_task(func: symbol, start: symbol)

starts_linked_task(func, id) :-
  remote_call(id, func, m, a, _),
  task_start_api(m, a, "linked").

// `func`, or a function it calls, awaits, yields or shuts down a task
// (task_collect): any task, not only the one it starts.
.decl collects_a_task(func: symbol) inline

collects_a_task(func) :- await_reach.reaches(func).

.init await_reach = CallReachSet

await_reach.seed(func) :- remote_call(_, func, "Task", w, _), task_collect(w).

// The task started at `start` is the function's tail call: the function
// returns the task struct to its caller, which is responsible for
// awaiting it. The function is a factory, not a leak.
.decl returns_task(func: symbol, start: symbol)

returns_task(func, start) :-
  starts_linked_task(func, start),
  tail_call(start).

// A mailbox callback takes the reply of the task started at `func`:
// - a handle_info/2 clause headed by a reference (`{ref, result} when
//   is_reference(ref)`) in the starting function's own module — a clause
//   written for task replies, whichever process of the module's runs it
//   (a LiveView's helper, a module whose host delegates its messages) —
//   or a handle_info/2 of that module that collects a task where it takes
//   the reply (an await, a yield or a shutdown on its stack: Phoenix.
//   Presence's `{task_ref, {:phoenix, ref, diffs}}` clause shuts the task
//   down);
// - or, on the stack of a server that starts the task (task_runs_in:
//   its callbacks' own module code, or any module's code a started
//   server runs), that server's handle_info/2 clause headed by a
//   reference or open to a tuple of any tag (`{_ref, result}`), or its
//   gen_statem :info clause open to a tuple of any tag.
.decl reply_taken(func: symbol)

reply_taken(f) :-
  starts_linked_task(f, _),
  function_def(f, m, _, _, _),
  function_def(h, m, "handle_info", 2, _),
  callback_ref_head(h, "handle_info").

reply_taken(f) :-
  starts_linked_task(f, _),
  function_def(f, m, _, _, _),
  function_def(h, m, "handle_info", 2, _),
  collects_a_task(h).

reply_taken(f) :-
  starts_linked_task(f, _),
  task_runs_in(m, f),
  function_def(h, m, "handle_info", 2, _),
  takes_task_reply(h).

reply_taken(f) :-
  starts_linked_task(f, _),
  task_runs_in(m, f),
  statem_info_open(m, _, "tuple").

.decl task_runs_in(mod: symbol, func: symbol)

task_runs_in(m, f) :- starts_linked_task(f, _), server_side(m, f).
task_runs_in(m, f) :- starts_linked_task(f, _), runs_in_server(m, f).

.decl takes_task_reply(handler: symbol)

takes_task_reply(h) :- callback_ref_head(h, "handle_info").
takes_task_reply(h) :- callback_open(h, "handle_info", "tuple", 2).
takes_task_reply(h) :- callback_open(h, "handle_info", "tuple", -1).

// ── Yielding on a linked task ────────────────────────────────────────
//
// Task.yield/yield_many document an `{:exit, reason}` result for a task
// that crashed — but the link delivers the crash to the caller first, so
// unless the caller traps exits that branch never runs: the caller is
// dead (whatyouhide/redix#317's cluster fan-out, whose partial-failure
// path was unreachable). async_nolink is the tool for that shape.

// A function yields on the tasks it starts linked to its process, and
// the process does not trap exits: a crashing task kills the caller
// before yield can report the crash.
.decl yield_on_linked_task(owner: symbol, start: symbol)

yield_on_linked_task(owner, start) :-
  starts_linked_task_in(owner, start),
  yields_on_task(owner, _),
  !runs_trapping(owner).

task_result_defect(owner, start, "yield_linked") :- yield_on_linked_task(owner, start).

// The linked task started at `start` belongs to `owner`: the named
// function that starts it, or that defines the closure that does. A
// closure's calls belong to the function that defines it: the task is
// usually started inside an Enum.map fn and collected outside it.
.decl starts_linked_task_in(owner: symbol, start: symbol)

starts_linked_task_in(owner, start) :-
  starts_linked_task(f, start),
  enclosing_function(f, owner),
  !closure_def(_, owner).

// `owner`, or a closure it defines, calls Task.yield or Task.yield_many
// at `site`.
.decl yields_on_task(owner: symbol, site: symbol)

yields_on_task(owner, id) :- remote_call(id, g, "Task", "yield", _), enclosing_function(g, owner).
yields_on_task(owner, id) :- remote_call(id, g, "Task", "yield_many", _), enclosing_function(g, owner).

// The function runs on the stack of a server that traps exits
// (module_traps: the process whose entries reach the trap). The trap is
// the owner's process's, not its module's: a client function of a
// trapping server's module runs in its callers, which the module's trap
// says nothing of; a library function's callers are not known, and trap
// or not.
.decl runs_trapping(func: symbol)

runs_trapping(f) :- server_side(mod, f), module_traps(_, mod).

// ── Evidence: where a task is yielded ─────────────────────────────────
.decl task_yield_site(func: symbol, kind: symbol, site: symbol)
.output task_yield_site

task_yield_site(owner, "yield_linked", id) :-
  task_result_defect(owner, _, "yield_linked"),
  yields_on_task(owner, id).

// ── A linked task inside library code ────────────────────────────────
//
// In a caller that traps exits the task's normal exit arrives as an
// `{:EXIT, pid, :normal}` message Task.await never consumes
// (elixir-ecto/ecto#2246: a GenServer preloading in parallel), and a
// crashing task takes an unrelated caller down with it. A behaviour
// module that runs no process of its own (a plug, a type) owns its
// callers' expectations. A process module's callbacks, and what they
// reach in the module, run in its own process (server_side), but its
// client API runs in whoever calls it, like a library function:
// elixir-nodejs#45's `NodeJS.Supervisor.call/3`, a `use Supervisor`
// module's public call, linked every caller to the pool worker's task
// (PoolCallSupervisor; ServerSideTaskAwait is quiet).

// A function that runs in whoever calls it starts a task linked to that
// caller and awaits it: the task's exit and crash become the caller's.
// One that returns a task (returns_task) hands its caller the link with
// it, in plain sight.
.decl linked_task_in_library(owner: symbol, start: symbol)

linked_task_in_library(owner, start) :-
  starts_linked_task_in(owner, start),
  runs_in_callers(owner),
  collects_a_task(owner),
  !returns_task(owner, _).

task_result_defect(owner, start, "linked_in_library") :- linked_task_in_library(owner, start).

// The function a task belongs to runs in its callers' process: its
// module is no behaviour's (a library), or it is a process module's
// function its own process does not run (its client API).
.decl runs_in_callers(func: symbol)

runs_in_callers(func) :-
  task_owner(func, mod),
  !behaviour_module(mod).

runs_in_callers(func) :-
  task_owner(func, mod),
  process_behaviour_module(mod),
  !server_side(mod, func).

.decl task_owner(func: symbol, mod: symbol)

task_owner(owner, mod) :-
  starts_linked_task(f, _),
  enclosing_function(f, owner),
  function_def(owner, mod, _, _, _).

// ══ Monitors that pile up ═══════════════════════════════════════════
//
// A monitor costs its holder until it is released: its :DOWN taken, its
// ref demonitored, or the holder gone. One taken once, or one per
// process the holder keeps a relationship with and forgets when that
// process's :DOWN comes, is bounded by what the holder keeps. It leaks
// when the holder can hold two live monitors on one process: the site
// runs again (again_code, clientlib/runs.dl), meets a process it
// already monitors, and the monitor it took before is still live. Each
// such run leaves one more, and each is a :DOWN that comes later
// (docs/design/monitor-leaks.md).
//
// `monitor_leak(mod, func, site, how)`: the monitor at `site`, in `func`,
// piles up. `how` is what shows the one before is still live:
//   "wait"    — the run waits for the process's :DOWN (a receive with a
//               :DOWN clause) and some way out of it keeps the monitor:
//               the wait gave up, or the answer came first. The next run
//               asks the same process again (Livebook's Evaluator.call/2,
//               LiveViewTest's render_chunk/3).
//   "ended"   — the run records the process in the server (a field of
//               its state, a row of a table) and another run drops that
//               record while the process may live, without releasing the
//               monitor: its next registration monitors it again
//               (postgrex#781's Parameters, eventstore's AdvisoryLocks).
//   "dropped" — the ref is thrown away, so nothing but the process's
//               death releases the monitor, and the run takes it without
//               asking its state whether it holds one: each time the same
//               process is named again, one more (ejabberd's route
//               owners, rabbit_alarm's alertees).
.decl monitor_leak(mod: symbol, func: symbol, site: symbol, how: symbol)
.output monitor_leak

// A monitor is taken again while the one before it is still live: the
// run waits for the process's :DOWN, and a way out of the wait (it gave
// up, or the answer came first) keeps the monitor.
.decl monitor_kept_by_wait(monitor: symbol)

monitor_kept_by_wait(monitor) :-
  monitor_taken_again(monitor),
  waits_for_down(monitor).

// A monitor is taken again while the one before it is still live: the
// server dropped its record of the process while the process may live,
// and kept the monitor, so the next registration monitors it again.
.decl monitor_kept_past_record(monitor: symbol)

monitor_kept_past_record(monitor) :-
  monitor_taken_again(monitor),
  drops_record_of(_, monitor).

// A monitor whose ref is thrown away is taken without asking the state
// whether it holds one already: each time the same process is named
// again, one more.
.decl monitor_taken_unasked(monitor: symbol)

monitor_taken_unasked(monitor) :-
  monitor_taken_again(monitor),
  throws_ref_away(monitor),
  taken_without_asking_state(monitor).

monitor_leak(mod, func, monitor, "wait") :-
  monitor_kept_by_wait(monitor),
  monitor_in(monitor, mod, func).

monitor_leak(mod, func, monitor, "ended") :-
  monitor_kept_past_record(monitor),
  monitor_in(monitor, mod, func).

monitor_leak(mod, func, monitor, "dropped") :-
  monitor_taken_unasked(monitor),
  monitor_in(monitor, mod, func).

// The monitor call `monitor` is in `func`, of `mod`.
.decl monitor_in(monitor: symbol, mod: symbol, func: symbol) inline

monitor_in(s, m, f) :- monitor_call(s, f, _), function_def(f, m, _, _, _).

// What the function runs in its own process, apart from the logging and
// telemetry APIs (side_call, calls.dl): a demonitor with :flush there,
// on any path, flushes a monitor's :DOWN (unhandled_info's question).
.init flush = SameProcessReachSetCut

flush.cut(f, g) :- side_call(f, g).

flush.seed(func) :- demonitor_call(_, func, "flush").

// ── A monitor that can be taken again ───────────────────────────────
//
// A monitor the program's own code (a library's macro wrote nothing of
// it: library_written) takes again on a later run: its function runs
// again, and its site is not in a clause that runs once (once_site,
// runs.dl); its process is not one the run itself starts, and the run
// does not release it.
.decl monitor_taken_again(monitor: symbol)

monitor_taken_again(s) :-
  monitor_call(s, f, _),
  function_def(f, _, _, _, _),
  again_code(f),
  !once_site(s, f),
  !library_written(f),
  !starts_its_target(s),
  !released_by_run(s, f).

// A process the monitoring function starts itself is new on every run,
// and this monitor is the only one on it: its :DOWN ends both. The pid
// is, on every path, what a start in the function answered
// (monitor_started: the pid, or the one in its `{:ok, pid}`, never the
// `{:error, {:already_started, pid}}` of a process others hold), and the
// start is one the process facts know (process_start: exq's worker and
// the Task it starts for the job) or a library's (`:gun.open`). A pid a
// function of the program answers is not taken as new: a lookup-or-start
// wrapper hands back a process others hold (review 2, item 25).
.decl starts_its_target(site: symbol)

starts_its_target(s) :- monitor_started(s, f, c), process_start(c, f, _, _, _).

starts_its_target(s) :-
  monitor_started(s, f, c),
  remote_call(c, f, m, _, _),
  !program_module(m).

// Released by the run: every path from the monitor to its function's
// return takes the :DOWN or demonitors the ref (monitor_released,
// clientlib/receive.dl), or every way into the function passes a caller
// that does so after the call (collected_by_callers, below).
.decl released_by_run(site: symbol, func: symbol)

released_by_run(s, f) :- monitor_call(s, f, _), monitor_released(s).
released_by_run(s, f) :- monitor_call(s, f, _), collected_by_callers(f).

// ── A monitor its callers release ───────────────────────────────────
//
// Returning with a monitor live is the protocol, not a leak, when the
// caller goes on to take the :DOWN. OTP's old supervisor shutdown,
// which GenStage's ConsumerSupervisor and Horde's ProcessesSupervisor
// copy, monitors each child in monitor_child/1, looks once with `after
// 0` for an {:EXIT, ...} already queued, and returns :ok; its caller
// then blocks in wait_children until every child's {:DOWN, ...} has
// come. monitor_released_after names the calls such a release follows
// on every path (a receive with no `after` taking any :DOWN, or the one
// for the ref the call returned, or a demonitor of that ref).
//
// The monitor is released when every way the program has into the
// monitoring function passes such a call. Walked backward from each
// monitoring function, over the ways in no release follows
// (BackwardUnguarded, in reach.dl). A walk that reaches an exported
// function (its callers are outside the program), one nothing calls,
// or what a spawn runs (its process is not the caller's, and its wait
// releases nothing of this one) leaves the monitor exposed. A
// monitoring function nothing reaches but through one uncovered cycle
// is not released either: some way in must be a covered call.
.init uncollected = BackwardUnguarded

uncollected.seed(g, g) :- monitor_call(_, g, _).
uncollected.guarded(id) :- monitor_released_after(_, id).

.decl collection_exposed(func: symbol)

collection_exposed(g) :- uncollected.reaches(f, g), api_export(f).
collection_exposed(g) :- uncollected.reaches(f, g), !call_edge(_, f).
collection_exposed(g) :- uncollected.reaches(h, g), runs_elsewhere(_, h).

.decl collected_by_callers(func: symbol)

collected_by_callers(g) :-
  uncollected.reaches(h, g),
  call_instr(f, h, id),
  monitor_released_after(f, id),
  !collection_exposed(g).

collected_by_callers(g) :-
  uncollected.reaches(h, g),
  fun_handed(id, f, h, _),
  monitor_released_after(f, id),
  !collection_exposed(g).

// ── "wait": the run waits on the process, and a way out keeps it ────
//
// A receive with a :DOWN clause (recv_takes_down) in the monitoring
// function's own reach: the monitor was taken for a wait inside the
// run. When the monitor is the function's tail call, its ref goes back
// to the caller, and the wait may be the caller's (exq's WorkerDrainer
// maps its workers' refs into a set and awaits them). The monitor is not
// released on some way out (monitor_taken_again): a timed receive's
// `after`, the clause for the answer, a path that never enters the
// receive.
.init down_wait = SameProcessReachSetCut

down_wait.cut(f, g) :- side_call(f, g).
down_wait.seed(f) :- recv_takes_down(_, f).

.decl waits_for_down(monitor: symbol)

waits_for_down(s) :- monitor_call(s, f, _), down_wait.reaches(f).

waits_for_down(s) :-
  monitor_call(s, f, _),
  tail_call(s),
  call_edge(g, f),
  !runs_elsewhere(g, f),
  down_wait.reaches(g).

// ── "dropped": nothing can release it, and nothing asks first ───────
//
// A ref thrown away (monitor_ref_dropped) leaves the monitor to the
// process's death. Taken without a look at the process's own state, it
// is taken again each time the same process is named: some way from a
// root that runs again reaches the site with no call on it the state
// decides (state_decided, the guard a repeated subscription's walk asks
// of the same callbacks: a `MapSet.member?(state.monitored, pid)`, a
// pid compared with the one stored). Whether the same process is ever
// named again is the protocol's, not the code's: loud, at info.
.init unasked = BackwardUnguardedSameProcess

unasked.seed(f, s) :- monitor_ref_dropped(s, f), !state_decided(s).
unasked.guarded(c) :- state_decided(c).

// A call in a clause that runs once is no way from code that runs again
// (once_site, runs.dl).
unasked.guarded(c) :- once_site(c, _).

.decl taken_without_asking_state(monitor: symbol)

taken_without_asking_state(s) :- unasked.reaches(r, s), again_root(r, _).

// The monitor's ref is thrown away (monitor_ref_dropped).
.decl throws_ref_away(monitor: symbol) inline

throws_ref_away(s) :- monitor_ref_dropped(s, _).

// ── "ended": the server drops its record, and keeps the monitor ─────
//
// The clause of a callback that runs again in which the monitor is
// taken: the callback's own clause for its own sites, or the clause
// whose call leads, on the callback's stack, to the monitoring function.
// A clause that runs once (once_clause, runs.dl) is not one.
.init toward_monitor = SameProcessReach

toward_monitor.seed(f, f) :- monitor_call(_, f, _).

.decl monitor_clause(site: symbol, callback: symbol, tag: symbol)

monitor_clause(s, f, tag) :-
  monitor_call(s, f, _),
  again_root(f, _),
  clause_call(s, f, tag),
  !once_clause(f, tag).

monitor_clause(s, f, "*") :-
  monitor_call(s, f, _),
  again_root(f, _),
  !clause_call(s, f, _).

monitor_clause(s, h, tag) :-
  monitor_call(s, f, _),
  again_root(h, _),
  call_instr(h, g, c),
  clause_call(c, h, tag),
  !once_clause(h, tag),
  !runs_elsewhere(h, g),
  toward_monitor.reaches(g, f).

monitor_clause(s, h, tag) :-
  monitor_call(s, f, _),
  again_root(h, _),
  fun_handed(c, h, g, _),
  clause_call(c, h, tag),
  !once_clause(h, tag),
  !runs_elsewhere(h, g),
  toward_monitor.reaches(g, f).

// What the run records of the monitored process: a field of the state
// the clause returns (returned_update, by the clause's tag; the whole
// state, `*`, where a map is the state), a field a helper that monitors
// returns, a table the clause or that helper writes. The record is read
// by where it is kept, not by its key: a field or a table, of the
// monitoring module.
.decl monitor_record(site: symbol, mod: symbol, record: symbol)

monitor_record(s, m, k) :-
  monitor_clause(s, h, tag),
  function_def(h, m, _, _, _),
  returned_update(h, k, _, tag).

monitor_record(s, m, k) :-
  monitor_call(s, f, _),
  !again_root(f, _),
  function_def(f, m, _, _, _),
  returned_update(f, k, _, _),
  k != "*".

monitor_record(s, m, cat("table ", t)) :-
  monitor_clause(s, h, tag),
  function_def(h, m, _, _, _),
  ets_op(x, h, t, _, "write"),
  clause_call(x, h, tag).

monitor_record(s, m, cat("table ", t)) :-
  monitor_call(s, f, _),
  !again_root(f, _),
  function_def(f, m, _, _, _),
  ets_op(_, f, t, _, "write").

// Where a clause of a callback that runs again drops records of `record`
// (`func`, the callback or the helper its clause calls), while the
// process they name may live: a clause other than a :DOWN one removes an
// entry (removal_api, effect_model.dl) and returns the field it removed
// from, or deletes rows of the table; or any clause empties the field,
// :DOWN clauses included (eventstore's AdvisoryLocks resets every lock
// when its connection's :DOWN comes, and the owners' monitors stay). The
// removal a :DOWN clause makes is that monitor's own end: its process is
// gone.
.decl record_drop(mod: symbol, record: symbol, func: symbol, callback: symbol, tag: symbol)

record_drop(m, k, h, h, tag) :-
  monitor_record(_, m, k),
  again_root(h, _),
  function_def(h, m, _, _, _),
  remote_call(x, h, rm, op, _),
  removal_api(rm, op),
  clause_call(x, h, tag),
  tag != ":DOWN",
  returned_update(h, k, _, tag).

record_drop(m, k, g, h, tag) :-
  monitor_record(_, m, k),
  k != "*",
  again_root(h, _),
  function_def(h, m, _, _, _),
  call_instr(h, g, c),
  clause_call(c, h, tag),
  tag != ":DOWN",
  function_def(g, m, _, _, _),
  remote_call(_, g, rm, op, _),
  removal_api(rm, op),
  returned_update(g, k, _, _).

record_drop(m, k, h, h, tag) :-
  monitor_record(_, m, k),
  again_root(h, _),
  function_def(h, m, _, _, _),
  returned_update(h, k, v, tag),
  emptied(v).

record_drop(m, cat("table ", t), h, h, tag) :-
  monitor_record(_, m, cat("table ", t)),
  again_root(h, _),
  function_def(h, m, _, _, _),
  ets_op(x, h, t, op, _),
  ets_removal_op(op),
  clause_call(x, h, tag),
  tag != ":DOWN".

record_drop(m, cat("table ", t), g, h, tag) :-
  monitor_record(_, m, cat("table ", t)),
  again_root(h, _),
  function_def(h, m, _, _, _),
  call_instr(h, g, c),
  clause_call(c, h, tag),
  tag != ":DOWN",
  function_def(g, m, _, _, _),
  ets_op(_, g, t, op, _),
  ets_removal_op(op).

// A field set to an empty collection: every record in it goes.
.decl emptied(value: symbol)

emptied("%{}").
emptied("[]").
emptied("#{}").

// The drop releases the monitor, or ends its process, when the clause
// (or the helper) demonitors, or stops a process: a supervisor's
// terminate_child, a gen behaviour's stop, an exit signal. The process's
// :DOWN then comes, or none does.
.init release_reach = SameProcessReachSetCut

release_reach.cut(f, g) :- side_call(f, g).
release_reach.seed(g) :- demonitor_call(_, g, _).
release_reach.seed(g) :- stop_site(_, g).

.decl stop_site(site: symbol, func: symbol)

stop_site(x, g) :- sup_call(x, g, _, "terminate_child", _).
stop_site(x, g) :- pid_signal(x, g, "exit", _, _).

stop_site(x, g) :-
  remote_call(x, g, gm, "stop", _),
  (gm = "GenServer" ; gm = ":gen_server" ; gm = ":gen_statem" ; gm = ":proc_lib" ;
   gm = "Supervisor" ; gm = ":supervisor" ; gm = "DynamicSupervisor" ; gm = "Agent").

.decl clause_releases(callback: symbol, tag: symbol)

clause_releases(h, tag) :- demonitor_call(x, h, _), clause_call(x, h, tag).
clause_releases(h, tag) :- stop_site(x, h), clause_call(x, h, tag).

clause_releases(h, tag) :-
  call_instr(h, g, c),
  clause_call(c, h, tag),
  release_reach.reaches(g).

// `func` drops the record the monitor at `monitor` keeps, while its
// process may live, and neither it nor its clause releases the monitor:
// a helper a callback's clause calls, or the callback itself.
.decl drops_record_of(func: symbol, monitor: symbol)

drops_record_of(g, s) :-
  monitor_record(s, m, k),
  record_drop(m, k, g, h, tag),
  !clause_releases(h, tag),
  !release_reach.reaches(g),
  g != h.

drops_record_of(h, s) :-
  monitor_record(s, m, k),
  record_drop(m, k, h, h, tag),
  !clause_releases(h, tag).

// What the finding relates (role): where the record is dropped
// ("drop"), and the callbacks that run the monitoring function again
// ("runs"), when it is not one itself. A callback runs it again on a
// way that passes no site that runs once (once_site, runs.dl: a clause
// the start's own messages enter, a site a gate on the state closes),
// the way monitor_taken_again's again_code takes; for a ref thrown away,
// the way taken_without_asking_state walks, which passes no call the
// state decides either.
.decl monitor_leak_frame(mod: symbol, site: symbol, how: symbol, role: symbol, func: symbol)
.output monitor_leak_frame

monitor_leak_frame(m, s, "ended", "drop", g) :- monitor_leak(m, _, s, "ended"), drops_record_of(g, s).

.init again_toward = BackwardUnguardedSameProcess

again_toward.seed(f, f) :- monitor_taken_again(s), monitor_call(s, f, _).
again_toward.guarded(c) :- once_site(c, _).

monitor_leak_frame(m, s, how, "runs", r) :-
  monitor_leak(m, f, s, how),
  how != "dropped",
  again_toward.reaches(r, f),
  r != f,
  again_root(r, _).

monitor_leak_frame(m, s, "dropped", "runs", r) :-
  monitor_leak(m, f, s, "dropped"),
  unasked.reaches(r, s),
  r != f,
  again_root(r, _).

// ══ A message the module sends itself and cannot handle ═════════════
//
// The tag a call or cast sends is staged by stage 0 (`call_tag`).

// The module sends its own server a call or cast whose tag no clause of
// the server's handler takes, and the handler has no catch-all: the
// request crashes the server.
.decl unhandled_own_request(request: symbol, kind: symbol, tag: symbol)

unhandled_own_request(request, kind, tag) :-
  sends_own_server(request, kind, tag),
  request_enters(request, kind, handler),
  !has_clause_for(handler, kind, tag),
  !takes_any(handler, kind).

reply_defect(mod, sender, "", cat("unhandled_", kind), tag) :-
  unhandled_own_request(request, kind, tag),
  call_tag(request, sender, kind, tag),
  function_def(sender, mod, _, _, _).

// The call or cast at `request` sends `tag` to its module's own server
// (to_own_server, below).
.decl sends_own_server(request: symbol, kind: symbol, tag: symbol) inline

sends_own_server(request, kind, tag) :- call_tag(request, _, kind, tag), to_own_server(_, request).

// A request of `kind` from `request` enters `handler`: the sender's
// module's handle_call/3 for a call, its handle_cast/2 for a cast.
.decl request_enters(request: symbol, kind: symbol, handler: symbol) inline

request_enters(request, kind, h) :-
  call_tag(request, sender, kind, _),
  function_def(sender, mod, _, _, _),
  kind_callback(kind, callback),
  handler(mod, callback, h).

// Some clause of the handler compares the tag (callback_tag).
.decl has_clause_for(handler: symbol, kind: symbol, tag: symbol)

has_clause_for(h, kind, tag) :- kind_callback(kind, callback), callback_tag(h, callback, tag).

// The handler has a catch-all (callback_total).
.decl takes_any(handler: symbol, kind: symbol)

takes_any(h, kind) :- kind_callback(kind, callback), callback_total(h, callback).

.decl kind_callback(kind: symbol, callback: symbol)

kind_callback("call", "handle_call").
kind_callback("cast", "handle_cast").

.decl handler(mod: symbol, callback: symbol, func: symbol)

handler(mod, "handle_call", func) :- handle_call_function(mod, func).
handler(mod, "handle_cast", func) :- handle_cast_function(mod, func).

// Judged per call site, by where that site sends: a function that
// casts an audit log to another server and then calls its own server
// with a stale tag sends its own server that tag all the same.
//
// The site at `id` sends to its module's own server when its target
// resolves to one of the module's processes (call_site_target, the
// points-to stage: a name the module registers, self(), a pid the
// module's start returned), or when it resolves to no process and names
// no other server — neither a literal name the module does not register
// nor a tag another module's handler discriminates on (horde's
// ProcessesSupervisor calling its DynamicSupervisorImpl through a pid).
// A site that resolves to another module's server is that server's
// business.
.decl to_own_server(mod: symbol, id: symbol)

to_own_server(mod, id) :-
  call_tag(id, f, kind, _),
  function_def(f, mod, _, _, _),
  call_site_target(id, f, kind, p),
  server_process(p, mod).

to_own_server(mod, id) :-
  call_tag(id, f, kind, _),
  function_def(f, mod, _, _, _),
  !call_site_target(id, f, kind, _),
  !names_other_server(id),
  !tag_elsewhere(id).

// The site names a server by a literal that is not its module's own: a
// name its module does not register (a sync_call_site's callee, or the
// name pid_call reads).
.decl names_other_server(id: symbol)

names_other_server(id) :-
  call_tag(id, f, "call", _),
  sync_call_site(id, f, callee, _),
  function_def(f, mod, _, _, _),
  callee != mod,
  callee != "dynamic",
  !named_process(mod, callee).

names_other_server(id) :-
  call_tag(id, f, kind, _),
  pid_call(id, f, kind, "name", n),
  function_def(f, mod, _, _, _),
  n != mod,
  !named_process(mod, n).

.decl tag_elsewhere(id: symbol)

tag_elsewhere(id) :-
  call_tag(id, f, kind, tag),
  tag_handler(other, kind, tag),
  function_def(f, mod, _, _, _),
  other != mod.

// ══ A reply that can never be sent ══════════════════════════════════
//
// A handle_call/3 that defers its reply (`defers_reply`,
// clientlib/replies.dl) has promised the caller one.

// ── The promise cannot be kept ───────────────────────────────────
//
// `callback_drops_from` is per return site: some execution reaches this
// {:noreply, _} having never read `from`. That execution cannot reply, no
// matter what the rest of the program does.

// A handle_call/3 defers its reply at a return some execution reaches
// without ever reading `from`: nothing can send that reply, and the
// caller waits.
.decl unsendable_reply(func: symbol, return: symbol)

unsendable_reply(func, return) :-
  defers_reply(_, func, return),
  callback_drops_from(return, func).

reply_defect(mod, func, return, "dropped_from", "") :-
  unsendable_reply(func, return),
  defers_reply(mod, func, return).

// ── Not attempted: the reply that is stored and never sent ───────
//
// A module that keeps `from` and calls GenServer.reply/2 nowhere hangs its
// callers just as surely. It is not reported here, because stating it
// precisely needs escape analysis this does not have: `from` leaves the
// callback through a send, a spawned closure, an ETS write, or any call
// that happens to take it as an argument, and whoever receives it can
// reply. Suppressing on the routes one can enumerate leaves the rest as
// false positives.
//
// The heuristic version was written, measured against roughly six thousand
// modules, found nothing, and was removed. `defers_reply` above is where a
// real version would start.

// ══ gen_statem events without a clause ══════════════════════════════

// ── A timeout armed that no clause handles ──────────────────────────
//
// `unhandled_timeout(mod, state, kind)` — the witness is the timeout: a
// state (or handle_event/4) returns an action that arms it, and the
// runtime delivers it as an event of its own type, which no clause of
// the machine takes. Not an :info message: its own relation, not
// unhandled_info's.
//
// {:timeout, ms, content} arms an event of type :timeout; {:state_timeout,
// ms, content} one of type :state_timeout. Postgrex's SimpleConnection
// armed the former and matched `handle_event(:info, :timeout, ...)` —
// the idle ping never ran and the event fell through to the generic
// :info clause. The module-level question is enough: some callback has
// a clause for the type, or accepts any type.
.decl unhandled_timeout(mod: symbol, state: symbol, kind: symbol)
.output unhandled_timeout

// A state arms a timeout whose event no clause of the machine takes.
.decl timeout_without_clause(mod: symbol, state: symbol, kind: symbol)

timeout_without_clause(mod, state, kind) :-
  arms_timeout(mod, state, kind, event_type),
  !statem_handles_event(mod, event_type).

unhandled_timeout(mod, state, kind) :- timeout_without_clause(mod, state, kind).

// `state` (or handle_event/4) returns an action arming a timeout of
// `kind`, which the runtime delivers as an event of `event_type`:
// {:timeout, ms, content} one of type :timeout, {:state_timeout, ms,
// content} one of type :state_timeout, and a generic timeout
// {{:timeout, name}, ms, content} one of type {:timeout, name}, a tagged
// tuple, not the :timeout atom.
.decl arms_timeout(mod: symbol, state: symbol, kind: symbol, event_type: symbol)

arms_timeout(mod, state, "event_timeout", "timeout") :- statem_timeout(mod, state, "event_timeout", _).
arms_timeout(mod, state, "generic_timeout", "{timeout}") :- statem_timeout(mod, state, "generic", _).
arms_timeout(mod, state, "state_timeout", "state_timeout") :- statem_timeout(mod, state, "state_timeout", _).

// Some callback of the machine has a clause for the event type, or
// accepts any type.
.decl statem_handles_event(mod: symbol, event_type: symbol)

statem_handles_event(mod, type) :- statem_event_clause(mod, _, type).
statem_handles_event(mod, "timeout") :- statem_event_catchall(mod, _).
statem_handles_event(mod, "state_timeout") :- statem_event_catchall(mod, _).
statem_handles_event(mod, "{timeout}") :- statem_event_catchall(mod, _).

// ── A call that is never answered ────────────────────────────────────
//
// The extractor walks every {:call, from} clause to its returns and
// reports the ones that reply nothing, postpone nothing and keep `from`
// nowhere. The caller of :gen_statem.call/2 waits :infinity by default
// (sneako/finch#213: a cancel while disconnected blocked for days).
reply_defect(mod, func, site, "statem_unreplied", tag) :- statem_call_unreplied(mod, func, site, tag).

// ══ A message its process never takes ═══════════════════════════════
//
// A send that process points-to (sends.dl) follows to a spawned process
// none of whose receives has a clause for the message. It is not
// dropped: it stays in the mailbox for the life of the process, and
// every later receive scans past it. The receives are every one the
// process runs: the spawned function's and those of what it calls in
// its own process (a loop entered after a handshake), not only the
// spawned function's own, which on OTP's kernel was 6 of 56 sends to a
// spawned process. Judged only for a literal atom or a tuple with a
// literal tag, and only when the process runs some receive; never when a
// clause recv_pattern reads as "any" (a variable, a tuple pattern, a
// guard) could take it, and never when the process runs code whose
// receives are not the program's to read: a call through a fun or an
// apply, a gen_server or gen_statem enter_loop (its callbacks take the
// mailbox), a hibernate that resumes in an MFA.
.decl unreceived_message(mod: symbol, func: symbol, site: symbol, message: symbol, runs: symbol, starter: symbol, spawn: symbol, recv: symbol)
.output unreceived_message

// A send reaches a spawned process that runs receives, and none of them
// can take the message: it stays in the mailbox for the life of the
// process.
//
// `runs` is the function the process started at `spawn` runs: a spawn
// site may start more than one, and each is judged by its own receives.
.decl message_never_received(send: symbol, spawn: symbol, runs: symbol, message: symbol)

message_never_received(send, spawn, runs, message) :-
  sends_to_spawned(send, spawn, runs, message),
  runs_a_receive(runs),
  !receive_takes(runs, message),
  !receive_takes_anything(runs),
  !receives_out_of_sight(runs).

unreceived_message(mod, func, send, message, runs, starter, spawn, recv) :-
  message_never_received(send, spawn, runs, message),
  send_target(send, func, message, _),
  function_def(func, mod, _, _, _),
  process_start(spawn, starter, _, "spawn", runs),
  process_receive(runs, recv).

// The send at `send` sends a literal `message` that process points-to
// (sends.dl) follows to the process started at `spawn`, running `runs`.
.decl sends_to_spawned(send: symbol, spawn: symbol, runs: symbol, message: symbol)

sends_to_spawned(send, spawn, runs, message) :-
  send_target(send, _, message, p),
  message != "dynamic",
  instance(p, b),
  process_start(spawn, _, b, "spawn", runs).

// What the process runs: the spawned function and what it calls in its
// own process.
.init spawned_reach = ForwardSameProcessReachCut

spawned_reach.cut(f, g) :- side_call(f, g).

spawned_reach.root(r, r) :- sends_to_spawned(_, _, r, _).

// A receive the process runs.
.decl process_receive(runs: symbol, recv: symbol)

process_receive(r, id) :- spawned_reach.reaches(r, g), recv_pattern(id, g, _).

.decl runs_a_receive(runs: symbol) inline

runs_a_receive(r) :- process_receive(r, _).

// A clause of a receive the process runs takes the message by name.
.decl receive_takes(runs: symbol, message: symbol)

receive_takes(r, m) :- spawned_reach.reaches(r, g), recv_pattern(_, g, m).

// A clause of a receive the process runs matches anything recv_pattern
// reads as "any" (a variable, a tuple pattern, a guard).
.decl receive_takes_anything(runs: symbol)

receive_takes_anything(r) :- receive_takes(r, "any").

// The process runs code whose receives are not the program's to read
// (hides_receives, clientlib/receive.dl).
.decl receives_out_of_sight(runs: symbol)

receives_out_of_sight(r) :- spawned_reach.reaches(r, g), hides_receives(g).

// ══ A message its server has no clause for ═════════════════════════
//
// The GenServer half of the question unreceived_message asks of a
// spawned process. A message reaches a server's handle_info/2 in ways
// the program spells out, each a witness (`source`): a send process
// points-to follows to the server (sends.dl), a timer the server arms
// for itself, a monitor the server takes, whose {:DOWN, …} the runtime
// sends, a socket the server makes active, whose close the runtime
// sends, the node monitoring it turns on, a port it opens, an
// async_nolink task it starts and does not collect, and a timed receive
// on its stack that can give up before the message it asked for comes.
// Each is below. A handle_info/2 with no catch-all is no finding by
// itself (the retired "handle_info/2 has no catch-all"): what a server
// runs that it did not build — a fun from its state, a caller's stream —
// shows no message, and is not judged. When no clause of handle_info/2
// takes the message, what happens depends on what the module has in its
// place (`fallback`):
//
// - "crash": clauses and no catch-all. The message is a
//   FunctionClauseError that takes the server down, every time it is
//   sent (sequin's SlotMessageStore armed :max_memory_check and handled
//   it nowhere; astarte's AMQPEventsProducer re-armed :init after a
//   refactor removed its clause).
// - "catch_all": a catch-all that does nothing with the message but log
//   it or ignore it (callback_drops). The message is dropped: the
//   monitor's :DOWN that should have removed a listener (oban's
//   Notifiers.PG leaked every dead listener), the timer whose work
//   never runs (teslamate's Repair armed :repair beside a handle_cast
//   for it). A catch-all may be meant, so this is its own kind.
// - "default": no handle_info/2 but GenServer's own, which logs the
//   message as an error and drops it.
// - "state_crash": a gen_statem's state function (or handle_event/4)
//   with no :info catch-all, where no callback of the machine takes the
//   message (below).
//
// A catch-all that hands the message on — to a helper, into the state —
// may take it there, and is not judged. Neither is a message a clause
// could take by its shape alone (callback_open: `msg when is_atom(msg)`
// takes any atom, `{ref, result}` a tuple of any tag). Judged for a
// literal atom and a tuple with a literal tag, :DOWN included, and the
// shapes the runtime writes (a port's output, a task's `{ref, …}`). A
// runtime :DOWN is taken only by a clause for every reason of it. A
// message the server's own receives could take (a selective receive in
// a callback), and a monitor whose function waits on it or demonitors
// with :flush, are not judged; what a timed receive leaves behind is its
// own source (below).
.decl unhandled_info(mod: symbol, func: symbol, site: symbol, message: symbol, source: symbol, server: symbol, handler: symbol, fallback: symbol)
.output unhandled_info

// A server is sent a message no clause of its handle_info/2 takes, and
// no receive of its own could take it: the message crashes the server,
// or a catch-all drops it.
.decl unhandled_message(server: symbol, site: symbol, message: symbol, source: symbol, handler: symbol, fallback: symbol)

unhandled_message(server, site, message, source, handler, fallback) :-
  sent_to_server(server, _, site, message, source),
  runs_gen_server(server),
  info_fallback(server, message, handler, fallback),
  fallback_judged(source, fallback),
  !taken_at(handler, site, message),
  !server_receives(server, message).

// A server that traps exits takes some :EXIT messages, and no clause
// takes the exit of a process linked to it, whatever its reason: the
// exit crashes the server.
.decl unhandled_exit(server: symbol, link: symbol, message: symbol, handler: symbol)

unhandled_exit(server, link, message, handler) :-
  trapped_exit(server, _, link, message),
  runs_gen_server(server),
  partial_handle_info(server, handler),
  takes_some_exits(handler),
  !taken_at(handler, link, message).

// A timed receive on a server's stack gives up, and the message it waited
// for comes later to a handle_info/2 with no clause for it: the server
// crashes. That receive is why the message comes, so a receive of the
// server's own is no excuse.
.decl late_message_unhandled(server: symbol, recv: symbol, message: symbol, handler: symbol)

late_message_unhandled(server, recv, message, handler) :-
  left_by_timed_receive(server, _, recv, message),
  runs_gen_server(server),
  partial_handle_info(server, handler),
  !taken_at(handler, recv, message).

// A server arms a timer for itself whose tag a clause of handle_info/2
// compares, but whose shape no clause head takes (timer_refused: a
// `{:tick, 1, :slow}` beside `{:tick, n}`): it is as unhandled as one
// whose tag none compares.
.decl timer_shape_unhandled(server: symbol, arm: symbol, message: symbol, handler: symbol, fallback: symbol)

timer_shape_unhandled(server, arm, message, handler, fallback) :-
  timer_to_itself(server, _, arm, message),
  runs_gen_server(server),
  info_fallback(server, message, handler, fallback),
  info_taken(handler, message),
  timer_refused(handler, arm),
  !server_receives(server, message).

// A gen_statem is sent a message no callback of the machine takes, and a
// state function with no :info catch-all crashes on it (below).
.decl statem_message_unhandled(machine: symbol, site: symbol, message: symbol, callback: symbol)

statem_message_unhandled(machine, site, message, callback) :-
  sent_to_server(machine, _, site, message, _),
  statem_info_partial(machine, callback),
  !statem_takes(machine, message),
  !server_receives(machine, message).

// A timed receive on a gen_statem's stack gives up, and the message it
// waited for comes later as an :info no callback of the machine takes.
.decl statem_late_message_unhandled(machine: symbol, recv: symbol, message: symbol, callback: symbol)

statem_late_message_unhandled(machine, recv, message, callback) :-
  left_by_timed_receive(machine, _, recv, message),
  statem_info_partial(machine, callback),
  !statem_takes(machine, message).

unhandled_info(mod, f, id, msg, source, m, h, fallback) :-
  unhandled_message(m, id, msg, source, h, fallback),
  sent_to_server(m, f, id, msg, source),
  function_def(f, mod, _, _, _).

unhandled_info(mod, f, id, msg, "exit", m, h, "crash") :-
  unhandled_exit(m, id, msg, h),
  trapped_exit(m, f, id, msg),
  function_def(f, mod, _, _, _).

unhandled_info(mod, g, r, msg, "late", m, h, "crash") :-
  late_message_unhandled(m, r, msg, h),
  left_by_timed_receive(m, g, r, msg),
  function_def(g, mod, _, _, _).

unhandled_info(mod, f, id, msg, "timer", m, h, fallback) :-
  timer_shape_unhandled(m, id, msg, h, fallback),
  timer_to_itself(m, f, id, msg),
  function_def(f, mod, _, _, _).

unhandled_info(mod, f, id, msg, source, m, h, "state_crash") :-
  statem_message_unhandled(m, id, msg, h),
  sent_to_server(m, f, id, msg, source),
  function_def(f, mod, _, _, _).

unhandled_info(mod, g, r, msg, "late", m, h, "state_crash") :-
  statem_late_message_unhandled(m, r, msg, h),
  left_by_timed_receive(m, g, r, msg),
  function_def(g, mod, _, _, _).

// `func` sends `server` `message` at `site` (info_message, below), from
// any source but a timed receive's leftover.
.decl sent_to_server(server: symbol, func: symbol, site: symbol, message: symbol, source: symbol) inline

sent_to_server(m, f, id, msg, source) :- info_message(m, f, id, msg, source), source != "late".

// What a timed receive at `recv` in `func` leaves behind for `server`
// (info_message's source "late").
.decl left_by_timed_receive(server: symbol, func: symbol, recv: symbol, message: symbol) inline

left_by_timed_receive(m, g, r, msg) :- info_message(m, g, r, msg, "late").

// The exit of a process `func` links to at `link`, in a server that
// traps exits (info_message's source "exit").
.decl trapped_exit(server: symbol, func: symbol, link: symbol, message: symbol) inline

trapped_exit(m, f, id, msg) :- info_message(m, f, id, msg, "exit").

// A timer `func` arms at `arm` for the server it runs in (info_message's
// source "timer").
.decl timer_to_itself(server: symbol, func: symbol, arm: symbol, message: symbol) inline

timer_to_itself(m, f, id, msg) :- info_message(m, f, id, msg, "timer").

// The server takes its messages in handle_info/2: a gen_server-like
// behaviour's, not a gen_statem's.
.decl runs_gen_server(server: symbol)

runs_gen_server(m) :- gen_server_like(m), !statem_process(m).

// A message a server is sent, and where it comes from: `func` sends it
// at `site`, to a server running `server`'s callbacks.
.decl info_message(server: symbol, func: symbol, site: symbol, message: symbol, source: symbol)

info_message(m, f, id, msg, "send") :-
  send_target(id, f, msg, p),
  msg != "dynamic",
  !send_envelope(id),
  server_process(p, m).

// A timer or a monitor in a function a server's callbacks run: the
// callback's process arms it, so the message comes back to that server
// (RunsInServer, clientlib/process_kind.dl: any module's code on the server's
// stack).
.init info_reach = RunsInServer

info_reach.seed(f) :- timer_arm(id, f, "self", _, _, _), timer_tag(id, _, _).
info_reach.seed(f) :- start_timer_arm(_, f, "self").
info_reach.seed(f) :- monitor_call(_, f, _).
info_reach.seed(f) :- socket_activation(f, _, _).
info_reach.seed(f) :- socket_opened(f, _).
info_reach.seed(f) :- node_events(_, f, _).
info_reach.seed(f) :- port_opened(_, f).
info_reach.seed(f) :- mailbox_writer(_, f, "task_nolink").
info_reach.seed(f) :- starts_linked_task(f, _).
info_reach.seed(f) :- late_wait(_, f, _).
info_reach.seed(f) :- link_site(_, f).

.decl runs_in_server(mod: symbol, func: symbol)

runs_in_server(m, f) :- info_reach.runs(m, f).

// Judged, as a send is, when the message is an atom or a tuple with an
// atom first (timer_tag): a literal is named as it is written, a tuple
// the site builds as pid_send spells one, `{:tag, …}`.
info_message(m, f, id, lit, "timer") :-
  timer_arm(id, f, "self", "bare", _, lit),
  timer_tag(id, _, _),
  runs_in_server(m, f).

info_message(m, f, id, cat("{", tag, ", …}"), "timer") :-
  timer_arm(id, f, "self", "dynamic", _, _),
  timer_tag(id, tag, _),
  runs_in_server(m, f).

// :erlang.start_timer/3,4 armed for the server itself sends `{:timeout,
// ref, msg}`: a 3-tuple tagged :timeout (timer_tag), which GenServer's
// idle `handle_info(:timeout, s)` does not take. A start timer is most
// often a wait's own deadline: armed by the function that then waits for
// it, or for what it bounds, in a receive and cancels and flushes it
// (mongoose_lib:pmap/3). Like a monitor its function waits on, its
// message is taken where it is armed.
info_message(m, f, id, "{:timeout, …}", "timer") :-
  start_timer_arm(id, f, "self"),
  runs_in_server(m, f),
  !receive_reach.reaches(f).

// A monitor its own function waits on, in a receive or behind a
// demonitor with :flush, is consumed where it is taken.
.init receive_reach = SameProcessReachSetCut

receive_reach.cut(f, g) :- side_call(f, g).

receive_reach.seed(f) :- recv_pattern(_, f, _).

info_message(m, f, id, "{:DOWN, …}", "monitor") :-
  monitor_call(id, f, _),
  monitor_type(id, t),
  sends_down(t),
  runs_in_server(m, f),
  !receive_reach.reaches(f),
  !flush.reaches(f).

// A process's or a port's monitor sends a `{:DOWN, ref, type, object,
// reason}`; one whose type is not a literal is taken for one of them. A
// :time_offset monitor sends a clock service's {:CHANGE, …} instead.
.decl sends_down(type: symbol)

sends_down("process").
sends_down("port").
sends_down("dynamic").

// The :DOWN the runtime sends for the monitor at `id`, and the monitor's
// type: a monitor's own, or, for an async_nolink task, a process's.
.decl down_type_at(id: symbol, type: symbol)

down_type_at(id, t) :- info_message(_, _, id, "{:DOWN, …}", "monitor"), monitor_type(id, t).
down_type_at(id, "process") :- info_message(_, _, id, "{:DOWN, …}", "task").

// A clause of `h` takes every :DOWN the monitor at `id` sends, whatever
// reason the runtime gives it (callback_takes_down): one for its type,
// or for any type. The ref, the object and the state are the program's
// (a clause pinning the ref takes the monitor whose ref the state keeps);
// the reason is the runtime's, and a clause guarding it
// (`when reason != :normal`) leaves the others to no clause. A monitor
// whose type is not a literal is read as a process's.
.decl down_taken(handler: symbol, id: symbol)

down_taken(h, id) :- down_type_at(id, t), callback_takes_down(h, "handle_info", t).
down_taken(h, id) :- down_type_at(id, _), callback_takes_down(h, "handle_info", "any").
down_taken(h, id) :- down_type_at(id, "dynamic"), callback_takes_down(h, "handle_info", "process").

// ── An async_nolink task's reply and its :DOWN ───────────────────────
//
// Task.Supervisor.async_nolink sends the process that starts it two
// messages it did not ask for by name: the task's reply, `{ref, result}`,
// and, the task being monitored, `{:DOWN, ref, :process, pid, reason}`
// when it ends — after the reply, or in its place when it crashes
// (archethic-node#1306, sentry-elixir#172, Engram#1552). A start the
// function collects where it starts (an await, a yield, a shutdown:
// mailbox_writer "task") leaves neither behind. A start a library's macro
// wrote (library_written) is that library's protocol with its own
// handle_info/2; the program's own start under a library's handle_info/2
// lands there all the same (review 2, item 23).
info_message(m, f, id, "{ref, …}", "task") :-
  mailbox_writer(id, f, "task_nolink"),
  runs_in_server(m, f),
  !library_written(f).

info_message(m, f, id, "{:DOWN, …}", "task") :-
  mailbox_writer(id, f, "task_nolink"),
  runs_in_server(m, f),
  !library_written(f).

// ── A message a timed receive leaves behind ─────────────────────────
//
// A function on a server's stack asks for a message and then waits for
// it with an `after`. It spawns a process and takes the reply by a value
// it holds (`{ref, …}`): vernemq's vmq_ql_query spawn_links a row
// initializer and waits RowQueryTimeout for `{CallerRef, …}`, then kills
// it. Or it subscribes and waits for one event of the subscription:
// realtime's Connect.wait_for_connection, which the replication Watchdog
// reaches, subscribes to a tenant's topic and waits for a "ready" map
// about one pid. The wait can give up before the message comes, and a
// reply sent as the timeout fires, or an event broadcast before the
// unsubscribe (or about another pid, which the receive never selects),
// stays in the mailbox: the server's handle_info/2 is where it lands.
// The message is the shape the receive waits for (recv_shape; a receive
// that waits, not an `after 0` poll). A gen call is no such wait: it
// neither spawns nor subscribes, and it waits on an alias it deactivates.
// Only the crash is judged: a catch-all dropping a late reply is what it
// is for.
.init subscribe_reach = SameProcessReachSetCut

subscribe_reach.cut(f, g) :- side_call(f, g).
subscribe_reach.seed(f) :- mailbox_writer(_, f, "pubsub").

.decl late_wait(recv: symbol, func: symbol, message: symbol)

late_wait(r, g, "{ref, …}") :-
  recv_start(r, g, 0, _),
  recv_shape(r, g, "{ref, …}"),
  spawn_call(_, g, _, _, _, _, _, _, _, _).

late_wait(r, g, shape) :-
  recv_start(r, g, 0, _),
  recv_shape(r, g, shape),
  shape != "any",
  subscribe_reach.reaches(g).

info_message(m, g, r, msg, "late") :- late_wait(r, g, msg), runs_in_server(m, g).

// ── A linked process's exit, in a server that traps exits ────────────
//
// A server that traps exits (module_traps) receives the end of every
// process or port linked to it as `{:EXIT, from, reason}`, the reason
// whatever the linked process ended with. A link its own stack makes is
// the witness: a spawn_link, a link/1, a port it opens, a start_link of
// anything (a worker started from a callback is linked to the server).
// The exit is taken as a :DOWN is: by a clause for every reason of it
// (callback_takes_exit), whatever it pins of `from` or asks of the state,
// or by an open clause that can hold three elements. vernemq's
// vmq_tracer spawn_links its rate tracer and takes only its :normal
// exit. (sequin's Redis ConnectionCache takes only `{:EXIT, _pid,
// :normal}` too, but start_links through a fun in its state, which the
// call graph does not follow.) A handler that names no :EXIT
// at all is shutdown's finding (unhandled_exit_signal "no_exit_clause");
// this judges one that takes some exits (it compares :EXIT) and not
// others. The links are link_site's (clientlib/receive.dl).

info_message(m, f, id, "{:EXIT, …}", "exit") :-
  link_site(id, f),
  runs_in_server(m, f),
  module_traps(_, m).

// ── Node events and a port's output ─────────────────────────────────
//
// What the runtime writes a process that asks for it. `:net_kernel.
// monitor_nodes/1,2` with `true` subscribes the calling process to every
// node's `{:nodeup, node}` and `{:nodedown, node}` (a third element with
// options); `:erlang.monitor_node/2,3` and `Node.monitor/2,3` with `true`
// to one node's `{:nodedown, node}`. A flag the program computes shows
// nothing, and `false` turns the events off. A port a server's process
// opens (`Port.open/2`, which compiles to `:erlang.open_port/2`) is
// connected to it: what the port's program writes arrives as `{port,
// {:data, data}}`. A function that hands the port to another process
// (`Port.connect/2`), or that waits in a receive of its own (the port's
// output taken where it is read, as `System.cmd/3` does), is not judged.
.decl node_events(id: symbol, func: symbol, message: symbol)

node_events(id, f, "{:nodeup, …}") :-
  remote_call(id, f, ":net_kernel", "monitor_nodes", _),
  (call_arg(f, ":net_kernel:monitor_nodes/1", 0, "true") ;
   call_arg(f, ":net_kernel:monitor_nodes/2", 0, "true")).

node_events(id, f, "{:nodedown, …}") :-
  remote_call(id, f, ":net_kernel", "monitor_nodes", _),
  (call_arg(f, ":net_kernel:monitor_nodes/1", 0, "true") ;
   call_arg(f, ":net_kernel:monitor_nodes/2", 0, "true")).

node_events(id, f, "{:nodedown, …}") :-
  remote_call(id, f, ":erlang", "monitor_node", _),
  (call_arg(f, ":erlang:monitor_node/2", 1, "true") ;
   call_arg(f, ":erlang:monitor_node/3", 1, "true")).

node_events(id, f, "{:nodedown, …}") :-
  remote_call(id, f, "Node", "monitor", _),
  (call_arg(f, "Node:monitor/2", 1, "true") ; call_arg(f, "Node:monitor/3", 1, "true")).

info_message(m, f, id, msg, "node") :- node_events(id, f, msg), runs_in_server(m, f).

.decl port_opened(id: symbol, func: symbol)

port_opened(id, f) :- remote_call(id, f, ":erlang", "open_port", 2).
port_opened(id, f) :- remote_call(id, f, "Port", "open", 2).

.decl hands_port_off(func: symbol)

hands_port_off(f) :- remote_call(_, f, ":erlang", "port_connect", 2).
hands_port_off(f) :- remote_call(_, f, "Port", "connect", 2).

info_message(m, f, id, "{port, {:data, …}}", "port") :-
  port_opened(id, f),
  runs_in_server(m, f),
  !hands_port_off(f),
  !receive_reach.reaches(f).

// ── The close of a socket the server holds ───────────────────────────
//
// An active socket (`active: true`, `:once` or a count) sends what it
// receives to the process that controls it, and its end the same way:
// `{:tcp_closed, socket}` for TCP, `{:ssl_closed, socket}` for TLS, when
// the peer closes, the network drops or an alert ends the session. With
// no clause for it the first disconnect is a crash (kafka_ex#381's new
// client took only its own :update_metadata); a catch-all that only logs
// it leaves the server holding a socket that is gone (cqerl's TLS clients
// took `{:tcp_closed, _}`, let `{:ssl_closed, _}` fall into the catch-all,
// and answered every query after a server restart with a timeout).
//
// The server's process makes a socket active where it connects one
// (`:gen_tcp.connect/3,4`, `:ssl.connect/2,3,4`, active unless the
// options say otherwise) or sets its options (`:inet.setopts/2`,
// `:ssl.setopts/2`, a transport module's `setopts/2` through a variable)
// with a literal mode, or where it hands a wrapper of the program's the
// literal list the wrapper sets (`Socket.setopts(s, [:binary, active:
// true])`, through any chain of parameters). Which close that means
// follows the socket: `:ssl.setopts/2` a TLS one's, `:inet.setopts/2` a
// TCP one's when the server's process connects TCP sockets (it may be a
// UDP one, which has no close), a transport in a variable either kind the
// process connects. Soundness rests on the extractor's literal reading:
// options it cannot read say nothing, so a socket made active by options
// built at runtime is missed, never assumed. A function that hands its
// socket to another process (controlling_process) is not judged: the
// messages go to that process. Nor is an accepted socket, which takes
// its mode from the listening socket.
.decl socket_active_mode(mode: symbol)

socket_active_mode("true").
socket_active_mode("once").
socket_active_mode("n").
socket_active_mode("default").

// The literal a caller hands a wrapper's options parameter, directly or
// forwarded through its own parameters.
.decl socket_opts_needed(func: symbol, pos: number)

socket_opts_needed(g, p) :- socket_active(_, g, _, "param", p).
socket_opts_needed(f, q) :- socket_opts_needed(g, p), call_arg_forward(f, g, p, q).

.decl socket_opts_at(func: symbol, pos: number, site: symbol, caller: symbol, mode: symbol)

socket_opts_at(g, p, id, c, mode) :- socket_opts_needed(g, p), socket_opts_arg(id, c, g, p, mode).

socket_opts_at(g, p, id, c, mode) :-
  socket_opts_needed(g, p),
  call_arg_forward(f, g, p, q),
  socket_opts_at(f, q, id, c, mode).

// `func` makes a socket of `transport` active at `site`: the call itself,
// or the call handing a wrapper the literal it sets.
.decl socket_activation(func: symbol, site: symbol, transport: symbol)

socket_activation(f, id, t) :- socket_active(id, f, t, mode, _), socket_active_mode(mode).

socket_activation(c, id, t) :-
  socket_active(_, g, t, "param", p),
  socket_opts_at(g, p, id, c, mode),
  socket_active_mode(mode).

// A function that connects, or sets options on, a socket of a known kind.
.decl socket_opened(func: symbol, transport: symbol)

socket_opened(f, t) :- socket_active(_, f, t, _, _), (t = "tcp" ; t = "ssl").

// A function that hands a socket to another process.
.decl hands_socket_off(func: symbol)

hands_socket_off(f) :- remote_call(_, f, ":gen_tcp", "controlling_process", 2).
hands_socket_off(f) :- remote_call(_, f, ":ssl", "controlling_process", 2).

// The kinds of socket a server's process connects.
.decl server_holds(server: symbol, transport: symbol)

server_holds(m, t) :- socket_opened(f, t), runs_in_server(m, f).

.decl socket_close(transport: symbol, message: symbol)

socket_close("tcp", "{:tcp_closed, …}").
socket_close("ssl", "{:ssl_closed, …}").

.decl activation_close(func: symbol, site: symbol, server: symbol, message: symbol)

activation_close(f, id, m, msg) :-
  socket_activation(f, id, t),
  socket_close(t, msg),
  runs_in_server(m, f).

activation_close(f, id, m, msg) :-
  socket_activation(f, id, "inet"),
  runs_in_server(m, f),
  server_holds(m, "tcp"),
  socket_close("tcp", msg).

activation_close(f, id, m, msg) :-
  socket_activation(f, id, "any"),
  runs_in_server(m, f),
  server_holds(m, t),
  socket_close(t, msg).

info_message(m, f, id, msg, "socket") :-
  activation_close(f, id, m, msg),
  !hands_socket_off(f).

// Whether `tag` is what `message` is told apart by: the atom itself, or
// a tuple's literal tag (`{:tag, …}`, as pid_send spells it). Joined from
// the tag's side with cat/2: the message is not parsed. A timer's is its
// timer_tag: a literal tuple (`{:warm_up, 5}`) is spelled whole, and the
// join would find no tag for it.
.decl tag_of(message: symbol, tag: symbol)

tag_of(msg, tag) :- info_message(_, _, id, msg, "timer"), timer_tag(id, tag, _).

tag_of(msg, tag) :- info_message(_, _, _, msg, _), callback_tag(_, "handle_info", tag), msg = tag.

tag_of(msg, tag) :-
  info_message(_, _, _, msg, _),
  callback_tag(_, "handle_info", tag),
  msg = cat("{", cat(tag, ", …}")).

tag_of(msg, tag) :- info_message(_, _, _, msg, _), statem_info_tag(_, _, tag), msg = tag.

tag_of(msg, tag) :-
  info_message(_, _, _, msg, _),
  statem_info_tag(_, _, tag),
  msg = cat("{", cat(tag, ", …}")).

// A receive in the server's own code that could take the message.
.decl server_receives(mod: symbol, message: symbol)

server_receives(m, msg) :-
  info_message(m, _, _, msg, _),
  server_side(m, g),
  recv_pattern(_, g, x),
  (x = msg ; x = "any").

// Where the message goes instead of a clause of its own.
.decl info_fallback(mod: symbol, message: symbol, handler: symbol, fallback: symbol)

info_fallback(m, msg, h, "crash") :-
  info_message(m, _, _, msg, _),
  partial_handle_info(m, h).

// A catch-all that drops the message is the module's own, or code no
// clause of which the module wrote (macro_written, clientlib/generated.dl:
// GenServer's default logs and drops): a handler whose first clause a
// `use` injected ahead of the module's own clauses is the module's.
info_fallback(m, msg, h, "catch_all") :-
  info_message(m, _, _, msg, _),
  function_def(h, m, "handle_info", 2, _),
  callback_drops(h, "handle_info"),
  !macro_written(h).

info_fallback(m, msg, h, "default") :-
  info_message(m, _, _, msg, _),
  function_def(h, m, "handle_info", 2, _),
  callback_drops(h, "handle_info"),
  macro_written(h).

// A message some clause could take: its tag is compared, or a clause
// tests the message by shape alone and a tuple of any tag, or an atom,
// could pass it.
.decl info_taken(handler: symbol, message: symbol)

info_taken(h, msg) :-
  info_fallback(_, msg, h, _),
  tag_of(msg, tag),
  callback_tag(h, "handle_info", tag).

// A timer's message a clause head takes in its own shape: a literal
// tuple head (`handle_info({:tick, :fast}, s)` is one comparison with
// the tuple) compares no atom callback_tag sees.
info_taken(h, msg) :-
  info_fallback(_, msg, h, _),
  info_message(_, _, id, msg, "timer"),
  timer_tag(id, tag, ar),
  callback_tag_shape(h, "handle_info", tag, ar).

info_taken(h, msg) :- info_fallback(_, msg, h, _), callback_open(h, "handle_info", "any", _).

// A port's output is told apart by the `{:data, …}` inside it: a clause
// that compares :data anywhere may take it (`{^port, {:data, line}}`).
info_taken(h, "{port, {:data, …}}") :-
  info_fallback(_, "{port, {:data, …}}", h, _),
  callback_tag(h, "handle_info", ":data").

info_taken(h, msg) :-
  info_fallback(_, msg, h, _),
  match("[{].*", msg),
  callback_open(h, "handle_info", "tuple", _).

// A tuple of any tag a timed receive waits for.
info_taken(h, "tuple") :-
  info_fallback(_, "tuple", h, _),
  callback_open(h, "handle_info", "tuple", _).

// How the message at `id` is told taken: a :DOWN the runtime sends for a
// monitor (a monitor's, a task's) by a clause for every reason of it
// ("reason"), anything else by its tag or its shape ("tag").
.decl taken_by(id: symbol, message: symbol, how: symbol)

taken_by(id, msg, "reason") :- down_type_at(id, _), info_message(_, _, id, msg, _), msg = "{:DOWN, …}".
taken_by(id, "{:EXIT, …}", "exit") :- info_message(_, _, id, "{:EXIT, …}", "exit").

taken_by(id, msg, "tag") :-
  info_message(_, _, id, msg, source),
  (source = "send" ; source = "timer" ; source = "socket" ; source = "node" ; source = "port" ;
   source = "late").

taken_by(id, "{ref, …}", "tag") :- info_message(_, _, id, "{ref, …}", "task").

// A message some clause of `h` takes as the source at `id` sends it: a
// runtime :DOWN by a clause for every reason of it (down_taken), or by
// one that takes any tuple; a message the program writes by its tag or
// its shape (info_taken); a task's reply by a clause headed by a
// reference as well.
.decl taken_at(handler: symbol, id: symbol, message: symbol)

taken_at(h, id, msg) :-
  taken_by(id, msg, "reason"),
  info_message(m, _, id, msg, _),
  info_fallback(m, msg, h, _),
  down_taken(h, id).

// An open clause takes a :DOWN only if it can hold five elements: a
// task's `{ref, result} when is_reference(ref)` takes no :DOWN.
taken_at(h, id, msg) :-
  taken_by(id, msg, "reason"),
  info_message(m, _, id, msg, _),
  info_fallback(m, msg, h, _),
  (callback_open(h, "handle_info", "any", _) ;
   callback_open(h, "handle_info", "tuple", -1) ;
   callback_open(h, "handle_info", "tuple", 5)).

taken_at(h, id, msg) :-
  taken_by(id, msg, "tag"),
  info_message(m, _, id, msg, _),
  info_fallback(m, msg, h, _),
  info_taken(h, msg).

// A trapped exit, by a clause for every reason of it, or an open clause
// that can hold three elements.
taken_at(h, id, msg) :-
  taken_by(id, msg, "exit"),
  info_message(m, _, id, msg, _),
  info_fallback(m, msg, h, _),
  (callback_takes_exit(h, "handle_info") ;
   callback_open(h, "handle_info", "any", _) ;
   callback_open(h, "handle_info", "tuple", -1) ;
   callback_open(h, "handle_info", "tuple", 3)).

taken_at(h, id, "{ref, …}") :-
  taken_by(id, "{ref, …}", "tag"),
  info_message(m, _, id, "{ref, …}", _),
  info_fallback(m, "{ref, …}", h, _),
  callback_ref_head(h, "handle_info").

// Which fallback of a source's message unhandled_message judges: a
// crash, for every source but the two with rules of their own (a timed
// receive's leftover, a trapped exit); a catch-all's drop, or
// GenServer's default, only for a message the program sends or arms, a
// monitor's :DOWN and a socket's close.
.decl fallback_judged(source: symbol, fallback: symbol)

fallback_judged("send", "crash").
fallback_judged("timer", "crash").
fallback_judged("monitor", "crash").
fallback_judged("task", "crash").
fallback_judged("node", "crash").
fallback_judged("port", "crash").
fallback_judged("socket", "crash").

fallback_judged("send", "catch_all").
fallback_judged("timer", "catch_all").
fallback_judged("monitor", "catch_all").
fallback_judged("socket", "catch_all").

fallback_judged("send", "default").
fallback_judged("timer", "default").
fallback_judged("monitor", "default").
fallback_judged("socket", "default").

// The handler's clause heads take the timer's tag only in other shapes
// (callback_tag_shape): `{:tick, n}` for a `{:tick, 1, :slow}` timer, the
// atom `:timeout` for a start_timer's `{:timeout, ref, msg}`. A handler
// whose heads say nothing of the tag (it compares it in its body), or
// with a clause that takes a message by its shape alone, is not asked.
.decl timer_refused(handler: symbol, id: symbol)

timer_refused(h, id) :-
  timer_tag(id, tag, ar),
  callback_tag_shape(h, "handle_info", tag, _),
  !callback_tag_shape(h, "handle_info", tag, ar),
  !callback_tag_shape(h, "handle_info", tag, -1),
  !callback_open(h, "handle_info", _, _).

// ── The same message sent to a gen_statem ──────────────────────────
//
// It arrives as an :info event, in whatever state the machine is in: a
// state function (or handle_event/4) with neither an :info catch-all nor
// one for every event crashes on it. Judged only when no callback of the
// machine compares its tag or takes it by shape (statem_info_tag,
// statem_info_open): a message some state takes may be one the program
// only sends while the machine is in that state. A catch-all is not
// judged here — whether it drops the content is not read for a machine.
.decl statem_takes(mod: symbol, message: symbol)

statem_takes(m, msg) :-
  info_message(m, _, _, msg, _),
  tag_of(msg, tag),
  statem_info_tag(m, _, tag).

statem_takes(m, msg) :- info_message(m, _, _, msg, _), statem_info_open(m, _, "any").

statem_takes(m, "tuple") :-
  info_message(m, _, _, "tuple", _),
  statem_info_open(m, _, "tuple").

statem_takes(m, "{port, {:data, …}}") :-
  info_message(m, _, _, "{port, {:data, …}}", "port"),
  statem_info_tag(m, _, ":data").

statem_takes(m, msg) :-
  info_message(m, _, _, msg, _),
  match("[{].*", msg),
  statem_info_open(m, _, "tuple").

// A callback of the machine's that crashes on an :info it has no clause
// for: a state function, or handle_event/4.
.decl statem_info_partial(mod: symbol, func: symbol)

statem_info_partial(m, h) :-
  statem_process(m),
  statem_event_clause(m, h, _),
  !statem_info_catchall(m, h),
  !statem_event_catchall(m, h).


// ══ A periodic timer loop armed again while it runs ═════════════════
//
// A server whose handle_info/2 clause for a message arms a timer with
// that message for itself, on every path the clause goes on by, runs a
// periodic loop: each tick arms the next. Another callback that arms the
// message again — a send_after of it, or a send of it to self() — while
// the loop's timer is pending starts a second loop beside the first, and
// each later run of that callback one more: the loop's work multiplies
// with every config change, reset or owner change (vernemq's acl and
// passwd reloaders, Livebook's RuntimeServer before e9ea88e).
//
// The second path can stop the running loop only by cancelling its
// timer, through the ref the loop keeps:
// - a loop whose re-arm drops its ref (timer_ref "discarded") cannot be
//   stopped from anywhere, and every second arm multiplies it
//   (ReloadLoop, SelfKick);
// - a loop that keeps its ref under a state key is stopped by a second
//   path that cancels that key first (CancelFirst), and folds a second
//   chain into its own when its clause cancels the key before re-arming
//   (IdempotentLoop: realtime's subscribe loop, where a second arm costs
//   one stale tick, the flush rule's defect, not a loop);
// - a loop whose ref goes where the walk does not follow (a record
//   field, a tuple, a library's assign) is not judged: the quiet
//   direction.
// Only a periodic loop is asked: a clause that re-arms on one branch
// only (after a failed connect) retries until it is done, and the second
// arm of a retry loop comes, most often, from the event that stopped
// being connected, when no retry runs (RetryLoop: ejabberd_redis's and
// MongooseIM's LDAP reconnects). Only a literal message is asked
// (armed_literal): one carrying a ref or a counter (`{:tick, ref}`,
// start_timer's `{:timeout, ref, msg}`) is told apart by the loop's
// clause (RefTagged). Code that runs once per incarnation (runs.dl's
// once clauses: init/1, mount/3, and a clause only their messages enter —
// a handle_continue/2 init/1 continues to, a Channel's `:after_join`,
// MongooseIM's `initial_loading` cast, sequin's `:init` clause that arms
// the loop) arms the loop the ticks then carry, and is no second path
// (InitOnly, ContinueArm, AfterJoin, CastFromInit).

.decl timer_loop_rearmed(mod: symbol, message: symbol, entry: symbol, site: symbol, arm_site: symbol, loop_site: symbol, keeps: symbol)
.output timer_loop_rearmed

// A second path arms a periodic loop's message while the loop's timer is
// pending, and the loop throws its ref away: nothing can stop the
// running loop, so each second arm starts one more beside it.
//
// `site` is where the callback `entry` arms, or calls what does; `arm`
// is the arm itself, and `loop_arm` the loop's own re-arm.
.decl unstoppable_loop_armed_again(mod: symbol, message: symbol, entry: symbol, site: symbol, arm: symbol, loop_arm: symbol)

unstoppable_loop_armed_again(mod, message, entry, site, arm, loop_arm) :-
  second_arm(mod, message, entry, site, _, arm),
  loop_drops_ref(mod, message, loop_arm).

// A second path arms a periodic loop's message while the loop's timer,
// kept under a state key, is pending, and nothing cancels the kept timer
// first: a second loop starts beside the first.
.decl kept_loop_armed_again(mod: symbol, message: symbol, entry: symbol, site: symbol, arm: symbol, loop_arm: symbol, key: symbol)

kept_loop_armed_again(mod, message, entry, site, arm, loop_arm, key) :-
  second_arm(mod, message, entry, site, _, arm),
  loop_keeps_ref_under(mod, message, loop_arm, key),
  !loop_drops_ref(mod, message, _),
  !idempotent_loop(mod, message, key),
  !cancels_before(entry, site, key),
  !arms_when_empty(entry, site, key).

timer_loop_rearmed(mod, message, entry, site, arm, loop_arm, "") :-
  unstoppable_loop_armed_again(mod, message, entry, site, arm, loop_arm).

timer_loop_rearmed(mod, message, entry, site, arm, loop_arm, key) :-
  kept_loop_armed_again(mod, message, entry, site, arm, loop_arm, key).

// A server that handles its own messages in handle_info/2: the callback
// of a loop behaviour (otp_callback, a GenServer, a GenStage, a Channel,
// a LiveView, a gen_server2) but a gen_statem's, which takes its info
// messages in its state functions.
.decl looping_server(mod: symbol, handler: symbol)

looping_server(mod, h) :-
  otp_callback(h, mod, "handle_info", b),
  function_def(h, mod, "handle_info", 2, _),
  b != "GenStateMachine",
  b != "Supervisor".

// The literal message a timer armed for the process carries
// (armed_literal: at the site, or filled in by the arming function's
// callers), and the tag a clause head tells it apart by: timer_tag's, or
// the atom itself for one a caller filled in.
.decl self_arm_tag(site: symbol, func: symbol, lit: symbol, tag: symbol)

self_arm_tag(a, f, lit, tag) :-
  armed_literal(a, f, "self", lit),
  timer_tag(a, tag, _).

self_arm_tag(a, f, lit, lit) :-
  armed_literal(a, f, "self", lit),
  !timer_tag(a, _, _),
  !match("[{].*", lit).

// A literal message some timer of the module's arms for its own process.
.decl self_timer_tag(mod: symbol, tag: symbol)

self_timer_tag(mod, tag) :-
  self_arm_tag(_, f, _, tag),
  function_def(f, mod, _, _, _).

// What a call the clause of handle_info/2 for `tag` makes on every path
// runs in the module.
.init tick_path = ForwardIntraModuleSameProcessReach

tick_path.root(c, g) :-
  looping_server(mod, h),
  info_clause_always(c, h, tag),
  self_timer_tag(mod, tag),
  call_instr(h, g, c).

// `site` re-arms the periodic loop of `lit`: a timer the clause of
// handle_info/2 for the message's tag arms with that message for the
// process on every path it goes on by — in the clause (`via` is `site`
// itself), or on every completing path of what the clause's call `via`
// runs.
.decl loop_arm(mod: symbol, lit: symbol, site: symbol, func: symbol, via: symbol)

loop_arm(mod, lit, a, h, a) :-
  looping_server(mod, h),
  self_arm_tag(a, h, lit, tag),
  info_clause_always(a, h, tag).

loop_arm(mod, lit, a, f, c) :-
  looping_server(mod, h),
  info_clause_always(c, h, tag),
  tick_path.reaches(c, f),
  self_arm_tag(a, f, lit, tag),
  !conditional_call(a).

// The clause the loop runs in: of the handler, for the loop's tag.
.decl tick_clause(id: symbol, handler: symbol, lit: symbol)

tick_clause(id, h, lit) :-
  loop_arm(mod, lit, a, _, _),
  self_arm_tag(a, _, lit, tag),
  looping_server(mod, h),
  clause_call(id, h, tag).

// A callback that runs again and again, whenever its request or message
// comes (again_root, runs.dl): not init/1 or mount/3. handle_continue/2
// is one, and its clauses that run once are no second path
// (once_site, below).
.decl rearm_entry(mod: symbol, entry: symbol)

rearm_entry(mod, e) :-
  looping_server(mod, _),
  again_root(e, "callback"),
  function_def(e, mod, _, _, _).


// `site` arms the literal message `lit` for the process itself: a timer,
// or a send to self() (pid_send spells an atom as the timer's literal
// does; a tuple it spells `{:tag, …}`, which no literal equals).
.decl self_arm(site: symbol, func: symbol, lit: symbol)

self_arm(b, g, lit) :- armed_literal(b, g, "self", lit).
self_arm(b, g, lit) :- pid_send(b, g, lit, "self", _).

// What each call a looping module's callback makes runs in the module,
// in its process, without going back into handle_info/2: a callback that
// hands a message on to handle_info/2 (a deferred one drained later,
// vernemq's vmq_swc_store; `handle_info(:disconnect, socket)` from
// another clause) dispatches it to the clause that message enters, and
// a call that hands it the loop's own literal is a second arm below.
.init arm_path = ForwardIntraModuleSameProcessReachCut

arm_path.root(c, g) :-
  loop_arm(mod, _, _, _, _),
  rearm_entry(mod, e),
  call_instr(e, g, c),
  !looping_server(mod, g).

arm_path.cut(g, h) :- looping_server(_, h), call_edge(g, h).

// A second arm of `lit`'s loop: `site` is where the callback `entry`
// arms it (the arm itself) or makes the call that does (`arm_site` in
// `func`), outside the clause of handle_info/2 the loop runs in and
// outside a site that runs once (once_site, runs.dl).
.decl second_arm(mod: symbol, lit: symbol, entry: symbol, site: symbol, func: symbol, arm_site: symbol)

second_arm(mod, lit, e, b, e, b) :-
  loop_arm(mod, lit, _, _, _),
  rearm_entry(mod, e),
  self_arm(b, e, lit),
  !tick_clause(b, e, lit),
  !once_site(b, e).

second_arm(mod, lit, e, c, g, b) :-
  loop_arm(mod, lit, _, _, _),
  rearm_entry(mod, e),
  call_instr(e, _, c),
  arm_path.reaches(c, g),
  self_arm(b, g, lit),
  !tick_clause(c, e, lit),
  !once_site(c, e).

// A callback that runs the loop's clause itself, handing handle_info/2
// the loop's own message (`def handle_cast(:now, s), do: handle_info(:tick, s)`).
// The loop's own clause is no exception: it arms on every path, so its
// call back into itself arms a second timer beside its own re-arm.
second_arm(mod, lit, e, c, f, a) :-
  loop_arm(mod, lit, a, f, _),
  looping_server(mod, h),
  rearm_entry(mod, e),
  call_instr(e, h, c),
  call_arg(e, h, 0, lit),
  !once_site(c, e).

// How the loop keeps its ref: dropped where it is armed, or under a
// state key (timer_key: stored there, or returned to a caller that
// stores it).
.decl loop_drops_ref(mod: symbol, lit: symbol, site: symbol)

loop_drops_ref(mod, lit, a) :-
  loop_arm(mod, lit, a, f, _),
  timer_ref(a, f, "discarded", _).

// Armed in a helper that returns the ref, which the loop's clause, or a
// function the clause runs, drops (timer_dropped): ant's
// `schedule_check(ms)`, xandra's `schedule_refresh_topology(t)`.
loop_drops_ref(mod, lit, a) :-
  loop_arm(mod, lit, a, f, via),
  timer_ref(a, f, "returned", _),
  timer_dropped(via, _, _).

loop_drops_ref(mod, lit, a) :-
  loop_arm(mod, lit, a, f, via),
  timer_ref(a, f, "returned", _),
  timer_dropped(_, g, f),
  tick_path.reaches(via, g).

// The loop's re-arm at `site` keeps its ref under `key`. A loop any arm
// of which drops its ref (loop_drops_ref) cannot be stopped by any
// cancel: unstoppable_loop_armed_again reports it, and
// kept_loop_armed_again would repeat it under the key.
.decl loop_keeps_ref_under(mod: symbol, lit: symbol, site: symbol, key: symbol)

loop_keeps_ref_under(mod, lit, a, key) :-
  loop_arm(mod, lit, a, f, _),
  timer_ref(a, f, "stored", key).

loop_keeps_ref_under(mod, lit, a, key) :-
  loop_arm(mod, lit, a, f, _),
  timer_ref(a, f, "returned", _),
  returns_to_key(f, key).

// The call at `site` in `func` cancels the timer kept under `key`: the
// cancel_timer that reads the field, or a call handing the field to a
// function that cancels what it is handed (realtime's
// `Helpers.cancel_timer(pg_sub_ref)`).
.decl cancels_param(func: symbol, pos: number)

cancels_param(g, pos) :- timer_cancel(_, g, "param", _, pos).

cancels_param(g, pos) :-
  call_arg_forward(g, h, hpos, pos),
  cancels_param(h, hpos).

.decl cancel_call(func: symbol, site: symbol, key: symbol)

cancel_call(f, s, key) :- timer_cancel(s, f, "field", key, _).

cancel_call(f, s, key) :-
  call_arg_field(f, g, pos, key),
  cancels_param(g, pos),
  call_instr(f, g, s).

// A call to a function of the module that reads the field and cancels
// it itself (helper_cancels_field, clientlib/timer_flush.dl: MongooseIM's
// `maybe_cancel_timer(IsInitial, State)`). One level, and only a helper
// whose own code is the cancel: a function that cancels in one clause
// (through another helper) and arms in another is no cancel of the path
// that arms (review 2, item 21: 041f72e6 took any cancel anywhere below).
cancel_call(f, s, key) :- helper_cancels_field(f, s, _, key).

// Two call sites of `func` run in the same clause: one the tag of its
// first argument names for both, or two that no tag names. A clause
// whose head is a map or a struct names no tag, so the untagged clauses
// of one function share a verdict: a cancel in one quiets an arm in
// another (the quiet direction). The loop's own clause always has its
// tag.
.decl has_clause(site: symbol)

has_clause(s) :- clause_call(s, _, _).

.decl same_clause(func: symbol, first: symbol, then: symbol)

same_clause(f, s, t) :-
  clause_call(s, f, tag),
  clause_call(t, f, tag).

same_clause(f, s, t) :-
  cancel_call(f, s, _),
  second_arm(_, _, f, t, _, _),
  !has_clause(s),
  !has_clause(t).

// The loop's own clause cancels its kept timer before arming the next:
// a second chain folds into it at the next tick. In the handler's clause
// for the tag, or anywhere in the function that re-arms.
.decl idempotent_loop(mod: symbol, lit: symbol, key: symbol)

idempotent_loop(mod, lit, key) :-
  loop_keeps_ref_under(mod, lit, a, key),
  loop_arm(mod, lit, a, f, _),
  cancel_call(f, _, key),
  !looping_server(mod, f).

idempotent_loop(mod, lit, key) :-
  loop_keeps_ref_under(mod, lit, a, key),
  loop_arm(mod, lit, a, _, via),
  looping_server(mod, h),
  cancel_call(h, s, key),
  same_clause(h, s, via).

// The second path cancels the loop's kept timer before it arms: in the
// callback's clause that arms, or in the function holding the arm.
.decl cancels_before(entry: symbol, site: symbol, key: symbol)

cancels_before(e, c, key) :-
  second_arm(_, _, e, c, g, _),
  cancel_call(e, s, key),
  same_clause(e, s, c),
  !cancels_in_arming(e, s, g).

// The call at `site` cancels in `arm`, the very function that arms: its
// cancel and its arm may be on two branches (two clauses of a
// `configure/2`), so the call is asked as the arming function is, below.
.decl cancels_in_arming(func: symbol, site: symbol, arm: symbol)

cancels_in_arming(e, s, g) :-
  helper_cancels_field(e, s, cancel, _),
  timer_cancel(cancel, g, _, _, _).

// The function holding the arm cancels on every path through it: a
// cancel on another branch than the arm is none of the arm's.
cancels_before(e, c, key) :-
  second_arm(_, _, e, c, g, _),
  g != e,
  cancel_call(g, s, key),
  !conditional_call(s).

// The second path arms only while the key is empty: the arming function
// or the callback tests the kept field against nil or undefined
// (field_nil_test) — a Broadway producer's `handle_receive_messages(%{receive_timer:
// nil} = state)`, mbta's `schedule_fetch(%{ref: nil})`. The loop keeps the
// key full while its timer is pending, so that path arms only when no
// loop runs. Which branch arms is not asked: the quiet direction.
.decl arms_when_empty(entry: symbol, site: symbol, key: symbol)

arms_when_empty(e, c, key) :-
  second_arm(_, _, e, c, g, _),
  loop_keeps_ref_under(_, _, _, key),
  (field_nil_test(g, key) ; field_nil_test(e, key)).


// ══ A registration made on the static render ══════════════════════
//
// A callback that runs on the static render too (static_render_callback,
// clientlib/live_view.dl) and reaches, in its own process, what
// registers the process for later messages — a subscription (a PubSub
// subscription or a Registry or :pg join, mailbox_writer "pubsub"; an
// endpoint's, subscription_call), a timer to self, a monitor — registers
// the HTTP connection's process on the first run: a keep-alive
// connection takes every broadcast and tick meant for the LiveView
// (Bandit logs each as unexpected), and the work is done twice. A
// registration on the arm where connected?/1 answered true
// (connected_guarded), or reached only through calls on such arms, is
// not one.
//
// `static_render_registration(mod, entry, func, site, kind)` — the
// registration at `site` in `func`, reached from `entry` of `mod`
// without a connected?/1 test that answered true: `kind` "subscribe",
// "timer" or "monitor".
.decl static_render_registration(mod: symbol, entry: symbol, func: symbol, site: symbol, kind: symbol)
.output static_render_registration

// A callback that runs on the static render too reaches a registration
// of its process for later messages without a connected?/1 test that
// answered true: the HTTP connection's process is the one registered.
.decl registered_on_static_render(entry: symbol, registration: symbol)

registered_on_static_render(entry, registration) :-
  runs_on_static_render(entry),
  reaches_unconnected(entry, registration),
  registers_process(registration).

static_render_registration(m, e, f, id, kind) :-
  registered_on_static_render(e, id),
  static_render_callback(m, e),
  process_registration(id, f, kind).

// The callback runs on the static render as well as the connected one
// (static_render_callback, clientlib/live_view.dl).
.decl runs_on_static_render(entry: symbol) inline

runs_on_static_render(e) :- static_render_callback(_, e).

// The call at `registration` registers the process for later messages
// (process_registration).
.decl registers_process(registration: symbol) inline

registers_process(id) :- process_registration(id, _, _).

// `entry` reaches the registration in its own process along calls not on
// a true arm of connected?/1 (render_reach).
.decl reaches_unconnected(entry: symbol, registration: symbol) inline

reaches_unconnected(e, id) :- render_reach.reaches(e, id).

.decl process_registration(site: symbol, func: symbol, kind: symbol)

process_registration(id, f, "subscribe") :- mailbox_writer(id, f, "pubsub").
process_registration(id, f, "subscribe") :- subscription_call(id, f, "subscribe").
process_registration(id, f, "timer") :- timer_arm(id, f, "self", _, _, _).
process_registration(id, f, "monitor") :- monitor_call(id, f, _).

// Walked back from each registration along the calls not on a true
// arm of connected?/1 (BackwardUnguardedSameProcess: a fun handed to a
// call is held against that call; an edge into another process is not
// followed). A subscription inside an endpoint's own subscribe/1,2 is
// the caller's, at its call of the endpoint (subscription_call names
// it).
.init render_reach = BackwardUnguardedSameProcess

render_reach.seed(f, id) :-
  process_registration(id, f, _),
  !connected_guarded(id, f),
  !in_endpoint(f).

render_reach.guarded(id) :- connected_guarded(id, _).


// ══ A subscription made again and again ═══════════════════════════
//
// Subscribing a process to a topic it is already subscribed to adds a
// second subscription: Phoenix.PubSub delivers each broadcast once per
// subscription, and a :pg join is a second membership. A callback that
// runs again and again (again_root, runs.dl: a handle_info, handle_cast,
// handle_call or handle_continue, a LiveView's handle_params or
// handle_event, a channel's handle_in) and subscribes each time
// multiplies every later message
// (oban's Sonar re-listened every 5 s; nerves_hub_web's device list
// re-subscribed its devices on every refresh; livebook's
// App.unsubscribe/1 subscribed). The subscription is judged by where it
// is made, not by its topic, which is rarely literal: a callback that
// also undoes a subscription on its way (subscription_call
// "unsubscribe") is taken to swap them, and is not judged. An
// unsubscribe in another callback — terminate/2, a separate handler —
// leaves the repeated one standing. A clause that runs once per
// incarnation (runs.dl's once clauses: one only init/1, join/3 or
// mount/3's messages enter) subscribes once, and a subscription reached
// only from such clauses is not judged.
//
// `repeated_subscription(mod, entry, func, site)` — `entry`, a callback
// of `mod` that runs again and again, reaches in its own process the
// subscription at `site` in `func`, and unsubscribes nothing itself.
.decl repeated_subscription(mod: symbol, entry: symbol, func: symbol, site: symbol)
.output repeated_subscription

// A callback that runs again and again subscribes its process on every
// run, and unsubscribes nothing on its way: each run adds one more
// subscription.
.decl subscribes_again(entry: symbol, subscription: symbol)

subscribes_again(entry, subscription) :-
  callback_runs_again(entry),
  reached_every_run(entry, subscription),
  subscribes(subscription),
  !entry_unsubscribes(entry).

repeated_subscription(m, e, f, id) :-
  subscribes_again(e, id),
  function_def(e, m, _, _, _),
  subscription_call(id, f, "subscribe").

// A callback that runs again and again, whenever its request or message
// comes (again_root, runs.dl).
.decl callback_runs_again(entry: symbol) inline

callback_runs_again(e) :- again_root(e, "callback").

// The call at `subscription` subscribes (subscription_call).
.decl subscribes(subscription: symbol) inline

subscribes(id) :- subscription_call(id, _, "subscribe").

// `entry` reaches the subscription, in its own process, on a way that
// passes no site that runs once and no call its state decides
// (repeat_reach).
.decl reached_every_run(entry: symbol, subscription: symbol) inline

reached_every_run(e, id) :- repeat_reach.reaches(e, id).

.init subscription_reach = SameProcessReach

subscription_reach.seed(f, id) :- subscription_call(id, f, _).

.decl entry_unsubscribes(entry: symbol)

entry_unsubscribes(e) :-
  subscription_reach.reaches(e, id),
  subscription_call(id, _, "unsubscribe").

// Walked back from each subscription along the calls that do not run
// only at a site that runs once (once_site, runs.dl)
// (BackwardUnguardedSameProcess, in the callback's own process). A
// subscription inside an endpoint's own subscribe/1,2 is the caller's,
// at its call of the endpoint.
.init repeat_reach = BackwardUnguardedSameProcess

repeat_reach.seed(f, id) :-
  subscription_call(id, f, "subscribe"),
  !once_site(id, f),
  !state_decided(id),
  !in_endpoint(f).

repeat_reach.guarded(s) :- once_site(s, _).

// A callback that asks its own state before it subscribes — a stored
// scope pid compared with the current one, a membership test, a field
// matched in the head — keeps its subscriptions: the test reads the
// callback's last parameter, or the parameter of a helper it hands the
// state to (param_decided, call_arg_forward).
repeat_reach.guarded(s) :- state_decided(s).

.decl state_param(func: symbol, pos: number)

state_param(e, a - 1) :- again_root(e, "callback"), function_def(e, _, _, a, _).

state_param(g, k) :- state_param(f, j), call_arg_forward(f, g, k, j).

.decl state_decided(site: symbol)

state_decided(s) :- param_decided(s, f, k), state_param(f, k).

