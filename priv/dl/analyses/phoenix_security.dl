// Phoenix/Plug security analysis.
//
// Detects web application security issues: raw SQL queries reachable
// from controller actions and open redirects.

.include "../clientlib/imports.dl"

// Layer 2 input declarations.
.decl plug_pipeline(mod: symbol, plug_mod: symbol, position: number)
.input plug_pipeline

.decl controller_action(mod: symbol, action: symbol, arity: number)
.input controller_action

.decl raw_sql_call(id: symbol, func: symbol, api: symbol)
.input raw_sql_call

.decl redirect_call(id: symbol, func: symbol, target_type: symbol)
.input redirect_call

// ── SQL injection risk ───────────────────────────────────────────

// Raw SQL query in a function reachable from a controller action.
.decl sql_injection_risk(func: symbol, api: symbol)
.output sql_injection_risk

sql_injection_risk(func, api) :-
  raw_sql_call(_, func, api),
  function_def(func, mod, _, _, _, _),
  controller_action(mod, _, _).

sql_injection_risk(func, api) :-
  raw_sql_call(_, target_func, api),
  call_reachable(func, target_func),
  function_def(func, mod, _, _, _, _),
  controller_action(mod, _, _).

// ── Open redirect risk ───────────────────────────────────────────

// Redirect with dynamic target.
.decl open_redirect_risk(func: symbol)
.output open_redirect_risk

open_redirect_risk(func) :-
  redirect_call(_, func, "dynamic").
