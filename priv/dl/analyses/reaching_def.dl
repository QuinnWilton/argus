// Reaching definitions analysis.
//
// Computes which register definitions (writes) can reach which uses (reads)
// through the control flow graph.

.include "../clientlib/cfg.dl"

.decl def(id: symbol, reg: symbol)
.input def

.decl use(id: symbol, reg: symbol)
.input use

// A definition reaches a point if there's a CFG path from the def
// to the point without an intervening redefinition of the same register.

// Gen: instruction id defines register reg.
.decl gen(id: symbol, reg: symbol)
gen(id, reg) :- def(id, reg).

// A definition reaches the next instruction if it's not killed.
.decl reaching_def(def_id: symbol, reg: symbol, point: symbol)
.output reaching_def

// A definition reaches the immediately next instruction.
reaching_def(id, reg, to) :-
  gen(id, reg),
  cfg_edge(id, to).

// A definition propagates through instructions that don't redefine the register.
reaching_def(id, reg, to) :-
  reaching_def(id, reg, through),
  cfg_edge(through, to),
  !def(through, reg).

// Def-use chains: which definitions reach which uses.
.decl def_use(def_id: symbol, use_id: symbol, reg: symbol)
.output def_use

def_use(def_id, use_id, reg) :-
  reaching_def(def_id, reg, use_id),
  use(use_id, reg).
