// Unlinked spawn detection.
//
// Flags calls to erlang:spawn/* (without _link or _monitor) that create
// processes with no supervision or failure propagation link. These
// "orphan" processes silently disappear on crash.

// base.dl directly: this analysis needs the `instruction` declaration but
// never reads cfg_edge, and including cfg.dl would drag its derivation
// rules (and so branch/jump/next/label_at/select_branch facts) into the
// input set for nothing.
.include "../base.dl"
.include "../layer2.dl"

.decl unlinked_spawn(func: symbol, id: symbol)
.output unlinked_spawn

unlinked_spawn(func, id) :-
  spawn_call(id, func, _, _, _, "spawn").

// This analysis used to join `instruction(id, func, _, _)` purely to
// recover the spawning function. Its input set was therefore
// {instruction, spawn_call} — and `instruction` is the largest relation in
// the schema. On a 531-module project that is 343,352 rows serialized and
// re-read to accompany a `spawn_call` relation with ZERO rows: 1.56s per
// edit to look at nothing. `spawn_call` now carries its caller.
