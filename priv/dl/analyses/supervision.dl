// Magic-set transformed: reachability is computed only from the roots
// these rules ask about, not as the full transitive closure.
.pragma "magic-transform" "*"

// Supervision tree analysis.
//
// Detects common supervision anti-patterns:
// - Transient children depended upon by permanent children.
// - Coupled siblings under one_for_one without links.
// - Children started before their dependencies (wrong order).
//
// Uses transitive stateful_module_dep to catch indirect dependencies
// (e.g. A calls helper H which calls GenServer.call(B)).

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
// (The supervision extractor also emits named_process; no rule here
// consumes it.)

// ── OTP helpers ──────────────────────────────────────────────────────


// ── Supervision helpers ──────────────────────────────────────────────


// ── Anti-patterns ────────────────────────────────────────────────

// Permanent child that depends (transitively) on a sibling whose
// restart policy can leave it dead: a transient child that stops
// normally is never restarted, and a temporary child is never restarted
// at all — strictly worse. Either way the permanent child keeps running
// against a process that no longer exists.
//
// sup_site anchors at the tree definition; witness is a function in the
// permanent child through which the dependency flows. One row per
// witness — finding builders dedupe on (sup, permanent, sibling).
.decl suspect_nonpermanent_dependency(sup: symbol, permanent: symbol, sibling: symbol, restart: symbol, sup_site: symbol, witness: symbol)
.output suspect_nonpermanent_dependency

suspect_nonpermanent_dependency(sup, perm, sibling, restart, sup_site, witness) :-
  supervisor(sup, _),
  supervisor_site(sup, sup_site),
  supervisor_child(sup, _, perm, "permanent", _),
  supervisor_child(sup, _, sibling, restart, _),
  (restart = "transient" ; restart = "temporary"),
  stateful_module_dep(perm, sibling, witness).

// A child's init/1 depends on another process, synchronously or by cast:
// during startup that process may not be alive yet.
.decl init_process_dep(child: symbol, dep: symbol, witness: symbol)

init_process_dep(child, dep, func) :-
  init_function(child, func),
  reaches_sync_dep(func, dep),
  child != dep.

init_process_dep(child, dep, func) :-
  init_function(child, func),
  reaches_async_dep(func, dep),
  child != dep.

.decl wrong_start_order(sup: symbol, child: symbol, dep: symbol, child_pos: number, dep_pos: number, sup_site: symbol, witness: symbol)
.output wrong_start_order

wrong_start_order(sup, child, dep, cpos, dpos, sup_site, witness) :-
  supervisor_site(sup, sup_site),
  starts_before(sup, child, dep, cpos, dpos),
  init_process_dep(child, dep, witness).


// ── A supervisor registered as a worker ──────────────────────────
//
// OTP requires a child that is itself a supervisor to be registered with
// `type: :supervisor` and `shutdown: :infinity`. A supervisor given a finite
// shutdown is killed part-way through unlinking its own children, and its
// grandchildren are orphaned rather than terminated.
//
// RabbitMQ e40387e4 is the fixed instance: three modules carrying
// -behaviour(supervisor) were registered through a helper that builds
// `worker` specs with a finite shutdown, and the fix switched them to the
// supervisor-building helper.
//
// The form join is load-bearing, not a detail. `supervisor_child.type` is a
// DEFAULT for the `{Module, args}` and bare-`Module` shorthands — those
// state no type, `Module.child_spec/1` decides, and `use Supervisor`
// generates `type: :supervisor` where the extractor writes `worker`. A first
// version of this rule without the join reported 26 modules on the corpus
// and every one was that artefact. Only a spec that SAID `worker` counts.

.decl child_is_a_supervisor(child: symbol)

child_is_a_supervisor(child) :- behaves_as(child, "Supervisor").

.decl supervisor_registered_as_worker(sup: symbol, child: symbol, position: number)
.output supervisor_registered_as_worker

supervisor_registered_as_worker(sup, child, position) :-
  supervisor_child(sup, position, child, _, "worker"),
  supervisor_child_form(sup, position, "explicit"),
  child_is_a_supervisor(child).

// ── Permanent child that stops itself normally ────────────────────────
//
// A supervisor restarts a :permanent child whatever the exit reason —
// :normal and :shutdown included. So a permanent child whose callback
// returns {:stop, :normal, ...} has asked to go away and will be started
// straight back; the code that follows the stop (graceful permdown,
// drain-and-quit) is undone at once. Phoenix PubSub's tracker shards did
// this on graceful permdown until their spec became :transient.
//
// Only a literal reason counts (callback_stop_reason), and terminate/2
// is excluded: it does not return a stop tuple. One row per stop site —
// finding builders dedupe on (sup, child).
.decl permanent_child_stops_normally(sup: symbol, child: symbol, reason: symbol, site: symbol, sup_site: symbol)
.output permanent_child_stops_normally

permanent_child_stops_normally(sup, child, reason, site, sup_site) :-
  supervisor(sup, _),
  supervisor_site(sup, sup_site),
  supervisor_child(sup, _, child, "permanent", _),
  function_def(func, child, name, _, _),
  name != "terminate",
  callback_stop_reason(site, func, reason),
  (reason = ":normal" ; reason = ":shutdown").

// ── rest_for_one: a later child owns processes inside an earlier one ──
//
// rest_for_one restarts the crashed child and everything after it; the
// children before it keep running. That is the right shape when earlier
// children are dependencies of later ones. It is exactly wrong when a
// later child starts processes inside an earlier one — Oban's producer
// (position 1) running jobs under the Task.Supervisor at position 0.
// When the producer crashes, the supervisor restarts it, the jobs the
// old producer started keep running under the surviving supervisor, and
// the new producer starts them again: duplicate long-running jobs and
// `attempt > max_attempts`. Oban's fix was :one_for_all.
//
// The owner is the child that calls start_child / async / async_nolink
// (any module in its branch); the holder is an earlier direct child.
// Two ways to connect them. `named`: the call names the holder's
// registered name. `inferred`: the target is a runtime value and the
// holder is the only earlier sibling whose module is the API called —
// a Task.Supervisor.async_nolink into an unresolvable pid, with exactly
// one Task.Supervisor started earlier under the same rest_for_one, is
// not much of an inference.
.decl child_creating_op(op: symbol)

child_creating_op("start_child").
child_creating_op("async").
child_creating_op("async_nolink").

.decl earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  supervisor_child(sup, pos, api, _, _),
  supervisor_child(sup, owner_pos, _, _, _),
  pos < owner_pos.

.decl sole_earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

sole_earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  earlier_sibling_of_kind(sup, pos, api, owner_pos),
  !other_earlier_sibling_of_kind(sup, pos, api, owner_pos).

.decl other_earlier_sibling_of_kind(sup: symbol, pos: number, api: symbol, owner_pos: number)

other_earlier_sibling_of_kind(sup, pos, api, owner_pos) :-
  earlier_sibling_of_kind(sup, pos, api, owner_pos),
  earlier_sibling_of_kind(sup, other, api, owner_pos),
  other != pos.

.decl rest_for_one_orphaned_children(sup: symbol, owner: symbol, holder: symbol, owner_pos: number, holder_pos: number, site: symbol, confidence: symbol)
.output rest_for_one_orphaned_children

rest_for_one_orphaned_children(sup, owner, holder, opos, hpos, site, "named") :-
  supervisor(sup, "rest_for_one"),
  supervisor_child(sup, opos, owner_branch, _, _),
  child_subtree(sup, owner_branch, owner),
  supervisor_child(sup, hpos, holder, _, _),
  hpos < opos,
  supervisor_child_name(sup, hpos, name),
  function_def(f, owner, _, _, _),
  sup_call(site, f, _, op, name),
  child_creating_op(op).

rest_for_one_orphaned_children(sup, owner, holder, opos, hpos, site, "inferred") :-
  supervisor(sup, "rest_for_one"),
  supervisor_child(sup, opos, owner_branch, _, _),
  child_subtree(sup, owner_branch, owner),
  function_def(f, owner, _, _, _),
  sup_call(site, f, api, op, "dynamic"),
  child_creating_op(op),
  sole_earlier_sibling_of_kind(sup, hpos, api, opos),
  supervisor_child(sup, hpos, holder, _, _).
