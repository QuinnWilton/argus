// Live variable analysis.
//
// A register is live at a program point if there exists a path from that
// point to a use of the register without an intervening definition.

.include "../clientlib/cfg.dl"

.decl def(id: symbol, reg: symbol)
.input def

.decl use(id: symbol, reg: symbol)
.input use

// A register is live-out at a point if it's live-in at a successor.
// A register is live-in at a point if it's used there, or if it's
// live-out and not defined there.

// Live-in: register is used at this instruction.
.decl live_in(id: symbol, reg: symbol)
.output live_in

live_in(id, reg) :- use(id, reg).
live_in(id, reg) :- live_out(id, reg), !def(id, reg).

// Live-out: register is live-in at some successor.
.decl live_out(id: symbol, reg: symbol)
.output live_out

live_out(id, reg) :- cfg_edge(id, succ), live_in(succ, reg).

// Dead definitions: def with no use reachable.
.decl dead_def(id: symbol, reg: symbol)
.output dead_def

dead_def(id, reg) :- def(id, reg), !live_out(id, reg).
