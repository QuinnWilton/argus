// A child spec, registration or tree shape that is wrong on its own.
//
// No dependency between processes is needed to see these: a supervisor
// registered with type: :worker, a ConsumerSupervisor template that
// restarts finished children, a name two modules register, a :global
// registration with no conflict resolver.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/request_entry.dl"
.include "../clientlib/concurrency.dl"

// ── A supervisor registered as a worker ──────────────────────────
//
// OTP requires a child that is itself a supervisor to be registered with
// `type: :supervisor` and `shutdown: :infinity`. A supervisor given a finite
// shutdown is killed part-way through unlinking its own children, and its
// grandchildren are orphaned rather than terminated.
//
// RabbitMQ e40387e4 is the fixed instance: three modules carrying
// -behaviour(supervisor) were registered through a helper that builds
// `worker` specs with a finite shutdown, and the fix switched them to the
// supervisor-building helper.
//
// The form join is load-bearing, not a detail. `supervisor_child.type` is a
// DEFAULT for the `{Module, args}` and bare-`Module` shorthands — those
// state no type, `Module.child_spec/1` decides, and `use Supervisor`
// generates `type: :supervisor` where the extractor writes `worker`. A first
// version of this rule without the join reported 26 modules on the corpus
// and every one was that artefact. Only a spec that SAID `worker` counts.

.decl child_is_a_supervisor(child: symbol)

child_is_a_supervisor(child) :- behaves_as(child, "Supervisor").

.decl supervisor_registered_as_worker(sup: symbol, child: symbol, position: number)
.output supervisor_registered_as_worker

supervisor_registered_as_worker(sup, child, position) :-
  supervisor_child(sup, position, child, _, "worker"),
  supervisor_child_form(sup, position, "explicit"),
  child_is_a_supervisor(child).

// ── ConsumerSupervisor children that never finish ────────────────────
//
// A ConsumerSupervisor's child spec is a template: one child per event,
// which exits :normal when it is done. A :permanent template restarts
// every finished child, which fails again, consumes demand and trips
// the restart intensity (elixir-lang/gen_stage#195). The spec must say
// :temporary or :transient.
.decl consumer_supervisor_permanent_child(sup: symbol, child: symbol, sup_site: symbol)
.output consumer_supervisor_permanent_child

consumer_supervisor_permanent_child(sup, child, sup_site) :-
  behaves_as(sup, "ConsumerSupervisor"),
  supervisor_child(sup, _, child, "permanent", _),
  supervisor_site(sup, sup_site).

// ══ Names ═══════════════════════════════════════════════════════════

// ── Duplicate process names ──────────────────────────────────────

// Module that registers a specific name. `site` is the registration
// instruction — anchor-grade evidence.
.decl module_registers_name(mod: symbol, name: symbol, site: symbol)

module_registers_name(mod, name, id) :-
  process_register(id, func, name, _),
  name != "dynamic",
  name != ":dynamic",
  function_def(func, mod, _, _, _).

// Same name registered by two different modules. One row per pair of
// registration sites — finding builders dedupe on (name, mod1, mod2).
.decl duplicate_process_name(name: symbol, mod1: symbol, mod2: symbol, site1: symbol, site2: symbol)
.output duplicate_process_name

duplicate_process_name(name, mod1, mod2, site1, site2) :-
  module_registers_name(mod1, name, site1),
  module_registers_name(mod2, name, site2),
  mod1 < mod2.

// ── Global register without conflict resolution ──────────────────

// :global.register_name/2 (without resolve function) is race-prone
// during network partitions. register_name/3 supplies an explicit
// conflict-resolution function — the fixed form — so only /2 is
// flagged. site is the registration instruction.
.decl global_register_risk(func: symbol, name: symbol, site: symbol)
.output global_register_risk

global_register_risk(func, name, id) :-
  global_register(id, func, name, "2").

// ── Lookup, then start ───────────────────────────────────────────
//
// `case whereis(name) do nil -> start(name)` asks whether a name is
// taken and claims it when the answer is no, and nothing holds the name
// between the two: a second caller that asks in the same window gets
// the same answer, and one of the two starts loses. Christakis and
// Sagonas found this shape on the process registry in 2010 and Dialyzer
// reported it until OTP 25; the Elixir spellings are Registry.lookup
// before start_child, and whereis before register or a named start.
//
// The lookup and the act are the same name when they agree on registry,
// source and key; a start_child hides its name in the child spec, so any
// checked lookup that decides it counts. The race is not a bug when the
// loser's outcome is taken — {:error, {:already_started, pid}} compared
// in the function or in a caller of it, an ArgumentError from register/2
// rescued, or a wrapper returning this function's result to a taker — or
// when only one process ever runs the function.

.decl same_name(check: symbol, act: symbol)

same_name(check, act) :-
  guarded_create(act, check),
  name_lookup(check, func, _, scope, source, key, "checked"),
  creating_op(act, func, _, scope, source, key),
  source != "dynamic".

same_name(check, act) :-
  guarded_create(act, check),
  name_lookup(check, func, _, _, _, _, "checked"),
  creating_op(act, func, "start_child", _, _, _).

.decl start_error_handled(func: symbol)

start_error_handled(f) :- start_error_compared(f, _).
start_error_handled(f) :- call_edge(g, f), start_error_compared(g, _).
start_error_handled(f) :- catches_class(f, "error").
start_error_handled(f) :- catch_tag(_, f, "error", "ArgumentError").
start_error_handled(f) :- returns_call(g, f), start_error_handled(g).

.init create_runs = RunsConcurrently

create_runs.seed(f) :- creating_op(_, f, _, _, _, _).

.decl registry_race(mod: symbol, func: symbol, lookup_api: symbol, create_api: symbol, key: symbol, check: symbol, act: symbol)
.output registry_race

registry_race(mod, func, lookup_api, create_api, key, check, act) :-
  same_name(check, act),
  name_lookup(check, func, lookup_api, _, _, key, _),
  creating_op(act, func, create_api, _, _, _),
  function_def(func, mod, _, _, _),
  !start_error_handled(func),
  !create_runs.single_process(func).
