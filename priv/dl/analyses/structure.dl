// Structural defects independent of process dependencies: incorrect supervisor child
// types, restarting ConsumerSupervisor templates, duplicate registered names, and
// global registration without a resolver.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// Supervisors registered as workers
//
// Supervisor children need supervisor type and an infinite shutdown allowance. A finite
// worker shutdown can interrupt their child cleanup and leave grandchildren running.

.decl supervisor_registered_as_worker(sup: symbol, child: symbol, position: number)
.output supervisor_registered_as_worker

// A supervisor's child spec says in so many words that its child is a
// worker, and the child is itself a supervisor.
supervisor_registered_as_worker(sup, child, position) :-
  spec_says_worker(sup, position, child),
  is_supervisor(child).

// For shorthand children, inspect the module's child_spec type. A supervisor module can
// override child_spec with a map lacking type and thereby default to worker.

// A supervisor's own child_spec/1 leaves its type to the worker default,
// and a supervisor starts it by that spec.
.decl own_spec_registered_as_worker(child: symbol, sup: symbol, via: symbol)
.output own_spec_registered_as_worker

own_spec_registered_as_worker(child, sup, via) :-
  is_supervisor(child),
  started_by_own_spec(child, sup, via, at),
  own_spec_says_worker(child, sup, at).

// The module declares the Supervisor behaviour (behaves_as, so Erlang's
// -behaviour(supervisor) counts).
.decl is_supervisor(mod: symbol)

is_supervisor(mod) :- behaves_as(mod, "Supervisor").

// Require an explicit worker spec, including a map's default worker type. Shorthand
// forms defer to Module.child_spec/1, so the extractor's provisional worker value is
// insufficient. Also exclude custom starts in the supervisor's own module: its
// behaviour does not establish what those functions start.
.decl spec_says_worker(sup: symbol, position: number, child: symbol)

spec_says_worker(sup, position, child) :-
  supervisor_child(sup, position, child, _, "worker"),
  supervisor_child_form(sup, position, "explicit"),
  child != sup.

// Require every resolved child_spec type for the supplied arguments to be worker.
// Conflicting supervisor values or unreadable types suppress the finding.
.decl own_spec_says_worker(child: symbol, sup: symbol, at: symbol)

own_spec_says_worker(child, sup, at) :-
  own_field(sup, child, at, "type", "worker"),
  !own_field(sup, child, at, "type", "supervisor"),
  !own_field(sup, child, at, "type", "dynamic").

// A shorthand static or dynamic start using the child's child_spec. at is its list
// position or dynamic start identity; via is the dynamic caller, empty for static
// lists. Exclude the parent's own module spec.
.decl started_by_own_spec(child: symbol, sup: symbol, via: symbol, at: symbol)

started_by_own_spec(child, sup, "", to_string(position)) :-
  supervisor_child(sup, position, child, _, _),
  supervisor_child_form(sup, position, "shorthand"),
  child != sup.

started_by_own_spec(child, sup, via, via) :- dynamic_child(sup, child, via).

// ConsumerSupervisor templates
//
// Permanent templates restart children after successful normal completion, consuming
// demand and restart intensity. Event workers should use temporary or transient restart
// policy.
.decl consumer_supervisor_permanent_child(sup: symbol, child: symbol, sup_site: symbol)
.output consumer_supervisor_permanent_child

// A ConsumerSupervisor uses a permanent child template, causing completed event workers
// to restart immediately.
.decl permanent_consumer_template(sup: symbol, child: symbol)

permanent_consumer_template(sup, child) :-
  is_consumer_supervisor(sup),
  restart_policy(sup, child, "permanent").

// The module declares the ConsumerSupervisor behaviour.
.decl is_consumer_supervisor(mod: symbol) inline

is_consumer_supervisor(mod) :- behaves_as(mod, "ConsumerSupervisor").

consumer_supervisor_permanent_child(sup, child, sup_site) :-
  permanent_consumer_template(sup, child),
  supervisor_site(sup, sup_site).

// ══ Names ═══════════════════════════════════════════════════════════

// ── Duplicate process names ──────────────────────────────────────

// Same name registered by two different modules. One row per pair of
// registration sites — finding builders dedupe on (name, mod1, mod2).
.decl duplicate_process_name(name: symbol, mod1: symbol, mod2: symbol, site1: symbol, site2: symbol)
.output duplicate_process_name

// Two modules register the same name, so the second registration fails. Order mod1
// before mod2 to report each pair once.
duplicate_process_name(name, mod1, mod2, site1, site2) :-
  registers_name(mod1, name, site1),
  registers_name(mod2, name, site2),
  mod1 < mod2.

// A literal registration name with instruction-level evidence at site. Exclude dynamic
// and :dynamic placeholders.
.decl registers_name(mod: symbol, name: symbol, site: symbol)

registers_name(mod, name, site) :-
  process_register(site, func, name, _),
  name != "dynamic",
  name != ":dynamic",
  function_def(func, mod, _, _, _).

// ── Global register without conflict resolution ──────────────────

.decl global_register_risk(func: symbol, name: symbol, site: symbol)
.output global_register_risk

// A :global registration names no conflict resolver, so after a
// partition heals :global kills one of the name's two holders at random.
.decl global_name_without_resolver(func: symbol, name: symbol, register: symbol)

global_name_without_resolver(func, name, register) :-
  registers_globally(register, func, name),
  !names_resolver(register).

// :global.register_name/2 or /3 at `register`, the registration
// instruction, in `func`.
.decl registers_globally(register: symbol, func: symbol, name: symbol) inline

registers_globally(register, func, name) :- global_register(register, func, name, _).

// The registration is register_name/3, which supplies an explicit
// conflict-resolution function: the fixed form, taken as deliberate even
// when it passes :global's own random_exit_name/3.
.decl names_resolver(register: symbol)

names_resolver(register) :- global_register(register, _, _, "3").

global_register_risk(func, name, site) :- global_name_without_resolver(func, name, site).
