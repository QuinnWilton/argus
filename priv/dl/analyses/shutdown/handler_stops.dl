// Handlers stopping supervised siblings
//
// A stop can trigger a permanent sibling's restart or fail with noproc if supervision
// already stopped it. terminate-path calls are checked separately.

// A handler stops a sibling the supervisor owns: the supervisor restarts
// it, or has stopped it already and the stop exits in the handler.
.decl stop_of_owned_sibling(mod: symbol, handler: symbol, via: symbol, sibling: symbol, sup: symbol)

stop_of_owned_sibling(mod, handler, via, sibling, sup) :-
  handler_function(mod, handler),
  stops_process_of(handler, via, sibling),
  sibling(sup, mod, sibling).

// `handler` reaches a stop of mod's process through GenServer.stop or mod's API.
// Exclude calls whose targets are all privately owned (private_stop).
.decl stops_process_of(handler: symbol, via: symbol, mod: symbol)

stops_process_of(h, via, m) :-
  handler_function(_, h),
  stop_reach.reaches(h, via),
  stops_process(via, m).

stops_process_of(h, via, m) :-
  handler_function(_, h),
  stop_reach.reaches(h, via),
  function_def(via, m, _, _, _),
  !private_stop(h, via, m).

// `func` stops a process with GenServer.stop, `target` the module it
// names.
.decl stops_process(func: symbol, target: symbol)

stops_process(f, target) :- sup_call(_, f, "GenServer", "stop", target).

// What reaches a function that stops a process.
.init stop_reach = CallReach

stop_reach.seed(f, f) :- stops_process(f, _).

teardown_touches_sibling(mod, sib, "handler", "stop", via, sup, h, site, sup_site) :-
  stop_of_owned_sibling(mod, h, via, sib, sup),
  site_or_empty_call(h, via, site),
  supervisor_site_or_empty(sup, sup_site).

// The call in `h` toward `via`, when h calls it directly.
.decl site_or_empty_call(func: symbol, callee: symbol, site: symbol)

site_or_empty_call(f, g, id) :- call_instr(f, g, id).
site_or_empty_call(f, g, "") :- stop_reach.reaches(f, g), !call_instr(f, g, _).

// A process `handler` hands `via` as its first parameter (points-to).
.decl stop_arg(handler: symbol, via: symbol, proc: symbol)

stop_arg(h, via, p) :-
  handler_function(_, h),
  value_arg(_, h, via, "0", "call", sk, s),
  source_process(h, sk, s, p).

// Every process of sib's that `handler` hands `via` is one a function
// keeps for itself (private_process), and there is one.
.decl private_stop(handler: symbol, via: symbol, sib: symbol)

private_stop(h, via, sib) :-
  stop_arg(h, via, p),
  server_process(p, sib),
  private_process(p, _, _),
  !shared_stop(h, via, sib).

// A process of sib's that `handler` hands `via` is one no function keeps
// for itself.
.decl shared_stop(handler: symbol, via: symbol, sib: symbol)

shared_stop(h, via, sib) :-
  stop_arg(h, via, p),
  server_process(p, sib),
  !private_process(p, _, _).
