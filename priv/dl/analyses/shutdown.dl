// Cleanup that cannot run, or teardown that hurts a peer.
//
// OTP's rule for terminate/2 is narrower than it reads: it runs when a
// callback returns {:stop, ...} or raises, and on a supervisor shutdown
// only if the process traps exits. Trapping brings its own obligations:
// the {:EXIT, ...} that arrives as a message needs a clause, and the
// work must finish inside the shutdown timeout. And a process being
// torn down still has neighbours: a sibling that may already be gone,
// children started in another tree that will outlive this one, a
// monitored child whose :DOWN will read as a crash, a permanent child
// that stops itself only to be restarted.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/signals.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ══ terminate/2 and the exits it needs to trap ══════════════════════
.decl traps_exits(mod: symbol)

traps_exits(mod) :- module_traps(_, mod).

// ── What runs when a supervisor stops the process ────────────────
//
// A supervisor stops a child with exit(pid, :shutdown) (supervisor.erl's
// shutdown/1, DynamicSupervisor's terminate_children/2), so a process
// that traps exits runs terminate/2 with the reason :shutdown, the bare
// atom. {:shutdown, _} is a reason a process stops itself with, or a
// parent that is no supervisor passes: neither is the stop these rules
// are about. terminate/2 may choose its work by the reason, and it may
// hand the reason to a function that does: mnesia's servers call
// mnesia_monitor:terminate_proc(who, reason, state), whose clause for
// `R /= shutdown` reports a fatal error and whose other clause only logs.
// What runs on the stop is what that value reaches (ShutdownReason):
// - terminate/2 (gen_statem's terminate/3) holds it in its first
//   parameter;
// - a function that chooses its clause by the parameter holding it runs
//   the calls :shutdown reaches (shutdown_runs), and one that does not
//   choose by it runs every call;
// - a call that runs, and hands the value on unchanged, enters its
//   callee holding it where it lands (shutdown_handed).
// `pos` is -1 in a function that holds it in no parameter: every call
// runs there. An edge with no call instruction (a closure built there, a
// function reference) has no site the reason test places, and runs.

// The call at `id` in `func` runs when func holds the reason in `pos`.
.decl runs_holding(func: symbol, pos: number, id: symbol) inline

runs_holding(f, pos, id) :- shutdown_runs(id, f, pos).
runs_holding(f, pos, id) :- !shutdown_chooses(f, pos).

// Where the call at `id` hands on the reason `func` holds in `pos`: the
// callee's argument `arg`, or -1 when it hands it on in none.
.decl hands_holding(func: symbol, pos: number, id: symbol, arg: number) inline

hands_holding(f, pos, id, arg) :- shutdown_handed(id, f, pos, arg).
hands_holding(f, pos, id, -1) :- !shutdown_handed(id, f, pos, _).

// ── Cleanup worth running ────────────────────────────────────────
//
// WRITES only, and not logging. A terminate/2 that logs "shutting down"
// loses nothing when it is skipped; one that flushes a buffer, releases a
// lease, or tells another system it is going away loses something real.
// Reads are excluded for the same reason they are excluded from
// transaction safety: there is nothing there to lose. The categories are
// the effect model's durable ones (effect_model.dl). Releasing what the
// process holds — a monitor, a link, a timer, its own socket, port or
// file (released_at_exit) — is not among them: the runtime releases each
// when the process exits, however it exits.
//
// Only what terminate/2 does when a supervisor stops the process counts:
// work in a clause for other reasons (`terminate(:normal, s)`), or on a
// branch :shutdown does not take (the crash report elixir-ls's servers
// write for every reason but :normal and :shutdown), was never meant for
// that stop, and skipping terminate/2 there loses nothing. A call made in
// terminate/2 counts when it runs for :shutdown (runs_holding); a helper,
// when some call that does leads to it.
.decl runs_on_shutdown(terminate: symbol, callee: symbol)

runs_on_shutdown(t, g) :-
  terminate_callback(t, _, _),
  call_instr(t, g, id),
  runs_holding(t, 0, id).

runs_on_shutdown(t, g) :-
  terminate_callback(t, _, _),
  call_edge(t, g),
  !call_instr(t, g, _).

// Bounded, not the full `call_reachable` closure.
//
// Cleanup a module is responsible for sits close to its terminate/2. The
// unbounded closure walks out of the module, through a client library, into
// that library's connection pool, and credits the module with whatever it
// finds: Sequin's MutexOwner was reported for `:ets.insert/2 via
// :wpool_pool:store_wpool/1`, five hops down Mutex.release -> Redis ->
// wpool. The verdict was right and the evidence was noise, which is the
// same "right for the wrong reason" failure that the effect model's
// dispatch precedence was fixed for.
//
// Three hops covers terminate -> your cleanup function -> the API it calls,
// which is the shape real cleanup has: the first is runs_on_shutdown, the
// walk takes the other two.
.init terminate_reach = ForwardBoundedCallReach

terminate_reach.root(t, g) :- runs_on_shutdown(t, g).
terminate_reach.limit(2).

// ── Cleanup a supervisor shutdown skips ──────────────────────────

// A terminate/2 callback does cleanup, and its process doesn't trap
// exits: a supervisor's shutdown kills the process without running it.
.decl skipped_cleanup(mod: symbol, terminate: symbol, cleanup: symbol)

skipped_cleanup(mod, terminate, cleanup) :-
  terminate_callback(terminate, mod, _),
  does_cleanup(terminate, cleanup),
  !traps_exits(mod).

// terminate/2 does cleanup at `write`: a write on the path a supervisor
// stop takes whose effect outlasts the process, not one the runtime
// releases when the process exits anyway.
.decl does_cleanup(terminate: symbol, write: symbol)

does_cleanup(terminate, write) :-
  writes_on_shutdown(terminate, write),
  outlasts_process(write),
  !released_by_exit(write, terminate).

// A write terminate/2 makes when a supervisor stops the process: one in
// terminate/2 that runs for :shutdown (runs_holding), or one in a function
// it reaches (terminate_reach).
.decl writes_on_shutdown(terminate: symbol, write: symbol)

writes_on_shutdown(t, id) :-
  terminate_callback(t, _, _),
  impure_call(id, t, _, _, "write"),
  runs_holding(t, 0, id).

writes_on_shutdown(t, id) :-
  terminate_callback(t, _, _),
  terminate_reach.reaches(t, via, _),
  via != t,
  impure_call(id, via, _, _, "write").

// The call's effect leaves the process and stays done when it exits
// (durable_effect, effect_model.dl).
.decl outlasts_process(call: symbol) inline

outlasts_process(id) :- impure_call(id, _, _, category, _), durable_effect(category).

// The process's exit releases what the call releases, or takes what it
// writes with it: an API released_at_exit names (a monitor, a link, a
// timer, its own socket, port or file), or a write to an ETS table the
// process owns (own_table_released). The effect model gives a call one
// API, so asking it of the call is asking it of that API.
.decl released_by_exit(call: symbol, terminate: symbol)

released_by_exit(id, t) :-
  writes_on_shutdown(t, id),
  impure_call(id, _, api, _, _),
  released_at_exit(api).

released_by_exit(id, t) :-
  writes_on_shutdown(t, id),
  terminate_callback(t, mod, _),
  own_table_released(mod, id).

// An ETS table goes with the process that owns it, unless it has an
// heir: a write to one the process owns, its deletion included, is
// released at its exit as a socket it owns is. released_at_exit cannot
// name `:ets.delete/1` by its API alone (the table may be another
// process's, or have an heir); the table's own facts can. The call at
// `id`, run by `mod`'s terminate/2 or a function it reaches, works on a
// named table mod's init/1 makes: the process running the terminate/2
// made it (own_named_table). pg_local's and emqx_lwm2m_xml_object_db's
// terminate/2 delete the tables their init/1 made. A table named at run
// time, or made by another module's process (ejabberd_iq's, which
// mod_muc_rtbl's terminate/2 writes through ejabberd_iq:route/4), may
// outlive the process, and its write stays cleanup.
.decl own_table_released(mod: symbol, id: symbol)

own_table_released(mod, id) :-
  cleanup_candidate(mod, id),
  ets_op(id, _, t, _, _),
  own_named_table(mod, t).

// An ETS call terminate/2's cleanup rules ask about.
.decl cleanup_candidate(mod: symbol, id: symbol)

cleanup_candidate(mod, id) :-
  terminate_callback(t, mod, _),
  impure_call(id, t, _, "ets", "write").

cleanup_candidate(mod, id) :-
  terminate_callback(t, mod, _),
  terminate_reach.reaches(t, via, _),
  impure_call(id, via, _, "ets", "write").

// A named table `mod`'s init/1 makes, with an options list read whole
// that gives it no heir, that nothing gives away, renames or sets
// options on: the process running mod owns it until it exits.
.decl own_named_table(mod: symbol, table: symbol)

own_named_table(m, t) :-
  init_function(m, i),
  ets_new(n, i, t),
  t != "dynamic",
  ets_options_known(n),
  ets_option(n, "named_table", "true"),
  !ets_option(n, "heir", "true"),
  !passed_on(t).

// Ownership or options the table's code can change after it is made.
.decl passed_on(table: symbol)

passed_on(t) :- ets_op(_, _, t, "give_away", _).
passed_on(t) :- ets_op(_, _, t, "rename", _).
passed_on(t) :- ets_op(_, _, t, "setopts", _).

// ── Findings ─────────────────────────────────────────────────────
//
// One relation for terminate/2's cleanup, `kind` saying what goes wrong
// with it: "never_runs" (durable cleanup, and the process does not trap
// exits, so a supervisor shutdown skips terminate/2 entirely), "unclear"
// (work the effect model cannot classify, skipped the same way; category
// is empty), "truncated" (the module traps, but the cleanup has no bound
// of its own inside the shutdown timeout). One finding per module and
// kind: the rows name one cleanup, and cleanup_site every call of it.
.decl cleanup_defect(mod: symbol, behaviour: symbol, kind: symbol, category: symbol, api: symbol, via: symbol)
.output cleanup_defect

// The headline: cleanup that a supervisor shutdown will skip entirely.
cleanup_defect(mod, behaviour, "never_runs", category, api, via) :-
  skipped_cleanup(mod, terminate, cleanup),
  terminate_callback(terminate, mod, behaviour),
  impure_call(cleanup, via, api, category, _).

// Cleanup the effect model cannot classify — terminate/2 calling into the
// application's own code, which is where most real cleanup lives.
//
// Reported separately and less confidently. The analysis cannot say WHAT
// the work is, only that terminate/2 does something beyond logging and that
// a supervisor shutdown will skip it. That is still the useful half of the
// question: releasing a lease, closing a session and flushing a buffer all
// look like an ordinary call to your own module.

// A terminate/2 callback does work the effect model cannot classify, its
// process doesn't trap exits, and it does no cleanup the model knows: a
// supervisor's shutdown skips what may be cleanup.
.decl unclear_cleanup(mod: symbol, terminate: symbol, work: symbol)

unclear_cleanup(mod, terminate, work) :-
  terminate_callback(terminate, mod, _),
  does_unclassified_work(terminate, work),
  !traps_exits(mod),
  !terminate_does_cleanup(mod).

// terminate/2 makes the call at `work` on the path a supervisor stop
// takes, and the effect model has no entry for it (unknown_call): a call
// in terminate/2 that runs for :shutdown (runs_holding), or one in a
// function it reaches (terminate_reach). In a function it reaches,
// building a struct or a message is not cleanup (structural_call,
// effect_model.dl): DBConnection.Connection was reported for
// `Kernel.struct!/2` inside an exception constructor. A soundness choice
// made for one contract should not become noise in another.
.decl does_unclassified_work(terminate: symbol, work: symbol)

does_unclassified_work(t, id) :-
  terminate_callback(t, _, _),
  unknown_call(id, t, _, _),
  runs_holding(t, 0, id).

does_unclassified_work(t, id) :-
  terminate_callback(t, _, _),
  terminate_reach.reaches(t, via, _),
  via != t,
  unknown_call(id, via, api, _),
  !structural_call(api).

// terminate/2 in `mod` does cleanup the effect model knows: a module
// whose terminate/2 does is reported "never_runs" already, and "unclear"
// would repeat it less surely.
.decl terminate_does_cleanup(mod: symbol)

terminate_does_cleanup(mod) :- terminate_callback(t, mod, _), does_cleanup(t, _).

cleanup_defect(mod, behaviour, "unclear", "", api, via) :-
  unclear_cleanup(mod, terminate, work),
  terminate_callback(terminate, mod, behaviour),
  unknown_call(work, via, api, _).

// Slow work inside terminate, for a module that DOES trap exits — so the
// callback is reached, but may not finish.

// A terminate/2 callback does cleanup with no bound of its own, and its
// process traps exits: terminate/2 runs, and may not finish inside the
// shutdown timeout.
.decl truncated_cleanup(mod: symbol, terminate: symbol, cleanup: symbol)

truncated_cleanup(mod, terminate, cleanup) :-
  terminate_callback(terminate, mod, _),
  does_cleanup(terminate, cleanup),
  traps_exits(mod),
  unbounded(cleanup).

// The call has no bound of its own inside the shutdown timeout: network
// and port calls (slow_effect, effect_model.dl).
.decl unbounded(call: symbol) inline

unbounded(id) :- impure_call(id, _, _, category, _), slow_effect(category).

cleanup_defect(mod, behaviour, "truncated", category, api, via) :-
  truncated_cleanup(mod, terminate, cleanup),
  terminate_callback(terminate, mod, behaviour),
  impure_call(cleanup, via, api, category, _).

// Every call a cleanup_defect finding is about, where it is: the frames
// of the module's finding of that kind.
.decl cleanup_site(mod: symbol, kind: symbol, api: symbol, via: symbol, site: symbol)
.output cleanup_site

cleanup_site(mod, "never_runs", api, via, id) :-
  skipped_cleanup(mod, _, id),
  impure_call(id, via, api, _, _).

cleanup_site(mod, "unclear", api, via, id) :-
  unclear_cleanup(mod, _, id),
  unknown_call(id, via, api, _).

cleanup_site(mod, "truncated", api, via, id) :-
  truncated_cleanup(mod, _, id),
  impure_call(id, via, api, _, _).

// ── A synchronous call to a sibling from terminate/2 ─────────────────
//
// A supervisor stops its children in reverse start order, one at a
// time. terminate/2 runs while that is under way, so a sibling under the
// same supervisor may already be gone: the call exits with :noproc and
// terminate/2 itself crashes, taking whatever cleanup followed with it
// (oban#21's Watchman pausing its Producer). Siblings are the modules
// whose lifetimes one supervisor sequences: its children, and what sits
// under them.
// A catch that takes the :noproc exit (oban's fix) is the shape that
// survives the sibling being gone, but only for the call it covers: a
// try around some other call, with the sibling call after its `end`,
// guards nothing. The call usually goes through the sibling's API
// (`Producer.pause()`), so the try may cover the call in terminate/2
// that leads to the helper making the sibling call rather than that
// call itself; either counts.
//
// The call at `call` is covered by a try whose handler takes the exit
// (covered_by_catch, exceptions.dl), or names the :noproc reason a
// synchronous call exits with: `{:noproc, _}`, a tuple (catch_tuple_tag).
// A bare `catch :exit, :noproc` is GenServer.stop's reason, and never
// matches a call's `{:noproc, {GenServer, :call, _}}`; every call this
// rule guards leads to such a call.
.decl exit_guarded(call: symbol)

exit_guarded(call) :- covered_by_catch(call, _, _, "exit").

exit_guarded(call) :-
  try_covers(t, f, call, "try"),
  catch_tuple_tag(t, f, "exit", ":noproc").

// Some try in the function takes the exit. What is left to ask of a
// dependency with no call site to hold against a try, and of an edge
// into a fun that no call is handed (a fun stored, then called through a
// variable): any exit-catching try in the function counts, which errs
// quiet.
.decl catches_exit(func: symbol)

catches_exit(f) :- catches_class(f, "exit").
catches_exit(f) :- catch_tuple_tag(_, f, "exit", ":noproc").

// A call that waits for another module's process to answer. A call to a
// connection the module started for itself (private_dep, calls.dl) is
// not a call to the sibling.
.decl waits_on(func: symbol, mod: symbol) inline

waits_on(f, m) :- sync_dep(f, m), !private_dep(f, m).

// The call in `func` that runs a fun value `callee`: the call it is
// handed to (`Enum.each(ids, &Directory.unregister/1)`), or an apply
// whose target resolves to it.
.decl fun_site(func: symbol, callee: symbol, id: symbol)

fun_site(f, g, id) :- fun_handed(id, f, g, _).
fun_site(f, g, id) :- resolved_apply(id, f, g).

// The call in `func` that waits on `mod`: sync_site, a call that a
// message tag attributed to mod (sync_dep's tag clause, calls.dl), and
// the call a fun of mod's synchronous API is handed to — the call that
// runs it, and that a try must cover.
.decl wait_site(func: symbol, mod: symbol, id: symbol)

wait_site(f, m, id) :- sync_site(f, m, id).

wait_site(f, m, id) :-
  genserver_sync_api(g, m),
  fun_site(f, g, id),
  !call_instr(f, g, _),
  function_def(f, fm, _, _, _),
  fm != m.

wait_site(f, m, id) :-
  tag_resolved_site(id, f, "call", m),
  sync_call_site(id, f, t, _),
  unresolved_target(t).

// ── The stop's path, and the waits on it ─────────────────────────
//
// On terminate/2's stop, `func` runs on its stack holding the reason in
// `pos` (-1: in none), `depth` calls from terminate/2 along calls that
// run there and that no exit-catching try covers, within three calls;
// `first` is the path's call in terminate/2 ("" through an edge with no
// call instruction). A try around any call on the path guards what lies
// beyond it: the call in terminate/2 into the helper, a call between
// helpers, the helper's own call to the sibling's API. An edge with no
// call instruction (a closure, a function reference) is held against the
// call that runs it (fun_site): Horde's `Enum.each(signal_to, fn ... end)`
// is open because no try covers the Enum.each, whatever another try in
// terminate/2 catches. Only a fun no call is handed falls back to the
// function-wide reading (catches_exit). A fun handed to a spawn or a
// task's start runs in another process: its :noproc ends that process,
// not terminate/2, so the path stops there (started_elsewhere,
// runs_elsewhere). A fun enters its body holding no reason.
.decl stop_path(terminate: symbol, func: symbol, pos: number, depth: number, first: symbol)

stop_path(t, t, 0, 0, "") :- is_terminate(t, _).

stop_path(t, g, arg, 1, call) :-
  stop_path(t, t, 0, 0, _),
  stop_call_edge(t, 0, g, arg, call).

stop_path(t, g, -1, 1, "") :-
  stop_path(t, t, 0, 0, _),
  stop_fun_edge(t, 0, g).

stop_path(t, h, arg, d + 1, first) :-
  stop_path(t, g, pos, d, first),
  d > 0,
  d < 3,
  stop_call_edge(g, pos, h, arg, _).

stop_path(t, h, -1, d + 1, first) :-
  stop_path(t, g, pos, d, first),
  d > 0,
  d < 3,
  stop_fun_edge(g, pos, h).

// A call of `func`'s that runs on the stop, where func holds the reason
// in `pos`, and that no exit-catching try covers, entering `callee`
// holding it in `arg`.
.decl stop_call_edge(func: symbol, pos: number, callee: symbol, arg: number, call: symbol)

stop_call_edge(f, pos, g, arg, call) :-
  stop_path(_, f, pos, _, _),
  call_instr(f, g, call),
  runs_holding(f, pos, call),
  !exit_guarded(call),
  hands_holding(f, pos, call, arg).

// An edge with no call instruction the stop takes: the call a fun is
// handed to runs, no exit-catching try covers it, and it starts no other
// process; or no call is handed the fun and no try in `func` takes an
// exit.
.decl stop_fun_edge(func: symbol, pos: number, callee: symbol)

stop_fun_edge(f, pos, g) :-
  stop_path(_, f, pos, _, _),
  fun_site(f, g, call),
  !call_instr(f, g, _),
  runs_holding(f, pos, call),
  !exit_guarded(call),
  !started_elsewhere(call),
  !runs_elsewhere(f, g).

stop_fun_edge(f, pos, g) :-
  stop_path(_, f, pos, _, _),
  call_edge(f, g),
  !call_instr(f, g, _),
  !fun_site(f, g, _),
  !catches_exit(f),
  !runs_elsewhere(f, g).

// The call starts a process that runs what it is handed.
.decl started_elsewhere(call: symbol)

started_elsewhere(call) :- process_start(call, _, _, kind, _), kind != "server".

// On terminate/2's stop, `func` waits on `mod` at `site`: a wait site
// that runs there with no exit-catching try around it, or, for a
// dependency with no site in it, in a function where no try takes an
// exit (`site` empty). A call that hands the reason to a client API of
// mod's waits when the API's clauses for :shutdown do (api_waits_holding):
// mnesia_monitor:terminate_proc/3 waits on mnesia_monitor only in its
// clause for other reasons.
.decl stop_wait(terminate: symbol, func: symbol, mod: symbol, site: symbol)

stop_wait(t, f, m, id) :-
  stop_path(t, f, pos, _, _),
  waits_on(f, m),
  wait_site(f, m, id),
  runs_holding(f, pos, id),
  !exit_guarded(id),
  !api_handed(f, pos, id, m, _, _).

stop_wait(t, f, m, id) :-
  stop_path(t, f, pos, _, _),
  waits_on(f, m),
  wait_site(f, m, id),
  runs_holding(f, pos, id),
  !exit_guarded(id),
  api_handed(f, pos, id, m, g, arg),
  api_waits_holding(g, arg, m).

stop_wait(t, f, m, "") :-
  stop_path(t, f, _, _, _),
  waits_on(f, m),
  !wait_site(f, m, _),
  !catches_exit(f).

// The call at `id`, where `func` holds the reason in `pos`, hands it to
// mod's client API `api` (genserver_sync_api) as argument `arg`.
.decl api_handed(func: symbol, pos: number, id: symbol, mod: symbol, api: symbol, arg: number)

api_handed(f, pos, id, m, g, arg) :-
  stop_path(_, f, pos, _, _),
  shutdown_handed(id, f, pos, arg),
  call_instr(f, g, id),
  genserver_sync_api(g, m).

// `func`, entered holding :shutdown in parameter `pos`, reaches a
// synchronous call as mod's client API does (genserver_sync_api): its
// own, or one in a function of mod's that a call of its leads to, along
// calls that run for :shutdown. A call that hands the reason on is
// followed with it; one that does not enters its callee holding nothing,
// where every call runs (sync_caller_in).
.decl api_waits_holding(func: symbol, pos: number, mod: symbol)

// What api_waits_holding is asked of: the APIs a stop's call hands the
// reason to, and what they hand it on to.
.decl holding_asked(func: symbol, pos: number, mod: symbol)

holding_asked(g, arg, m) :- api_handed(_, _, _, m, g, arg).

holding_asked(h, arg, m) :-
  holding_asked(g, pos, m),
  call_instr(g, h, id),
  runs_holding(g, pos, id),
  shutdown_handed(id, g, pos, arg).

api_waits_holding(g, pos, m) :-
  holding_asked(g, pos, m),
  function_def(g, m, _, _, _),
  sync_call_site(id, g, _, _),
  runs_holding(g, pos, id),
  !calls_other_server(g, m).

api_waits_holding(g, pos, m) :-
  holding_asked(g, pos, m),
  call_instr(g, h, id),
  runs_holding(g, pos, id),
  hands_holding(g, pos, id, -1),
  sync_caller_in(h, m).

api_waits_holding(g, pos, m) :-
  holding_asked(g, pos, m),
  call_instr(g, h, id),
  runs_holding(g, pos, id),
  shutdown_handed(id, g, pos, arg),
  api_waits_holding(h, arg, m).

api_waits_holding(g, pos, m) :-
  holding_asked(g, pos, m),
  call_edge(g, h),
  !call_instr(g, h, _),
  sync_caller_in(h, m).

// `func` is a function of mod's that makes a synchronous call, or reaches
// one (reaches_sync_caller_in, calls.dl), whatever it holds.
.decl sync_caller_in(func: symbol, mod: symbol)

sync_caller_in(h, m) :-
  function_def(h, m, _, _, _),
  sync_call(h, _),
  !calls_other_server(h, m).

sync_caller_in(h, m) :- reaches_sync_caller_in(h, m).

// Teardown that touches a sibling the supervisor owns, in one relation:
// `phase` is "terminate" (terminate/2 waits on a sibling that may already
// be gone; `kind` = "call") or "handler" (a handler stops a sibling the
// supervisor still owns; `kind` = "stop"). `handler` is the callback the
// row belongs to, `site` the unguarded call in `via` that makes the
// dependency when it is direct (else empty), `sup_site` where the
// supervisor places both.
.decl teardown_touches_sibling(mod: symbol, sibling: symbol, phase: symbol, kind: symbol, via: symbol, sup: symbol, handler: symbol, site: symbol, sup_site: symbol)
.output teardown_touches_sibling

// The call is the bug when the supervisor itself has stopped the sibling
// before it terminates mod — two of its own sequences do:
//
// - its shutdown ("call"). Children stop in reverse start order, so from
//   mod's terminate/2 a sibling started after mod is already gone, under
//   any strategy.
// - its restart ("call_restart"). Under rest_for_one or one_for_all, a
//   sibling started before mod that crashes is why the supervisor
//   terminates mod, and mod's terminate/2 then calls the one that died
//   (oban#21: the Producer exits, rest_for_one takes the Watchman down,
//   the Watchman pauses the Producer; Horde's SignalShutdown under
//   one_for_all). Under one_for_one an earlier sibling's crash does not
//   touch mod, and its restart is ordinary let-it-crash, not this rule.
//
// The order is the branches': a supervisor stops a whole later child,
// a nested supervisor and everything under it, before an earlier one.
// So the sibling may sit deep in a later branch, and mod deep in an
// earlier one (`[WorkerSup, Directory]` with Writer under WorkerSup:
// Directory is gone before WorkerSup stops Writer); `sup` is the
// supervisor where their branches meet (starts_before, supervision.dl).
// A restart needs the crash to reach sup: the sibling is sup's own child.
// One nested in an earlier branch is restarted by its own supervisor,
// which leaves mod alone.
//
// Both run terminate/2 while the supervisor stops mod, which it does
// with exit(pid, :shutdown): only a process that traps exits runs
// terminate/2 then (traps_exits). One that does not is killed without
// it, and its terminate/2 runs only after a {:stop, ...} or a crash,
// while the sibling is up; that cleanup never running is
// cleanup_defect's "never_runs", not this.
//
// Known limits, each erring toward a report or toward quiet as noted:
// - A child spec with `shutdown: :brutal_kill` kills the caller even when
//   it traps exits, so its terminate/2 never runs on the shutdown. The
//   row stays: supervisor_child does not carry the shutdown value, and a
//   spec usually takes it from the child's own child_spec/1 or `use`
//   options, which the supervision extractor does not read. (Reports.)
// - A restart that escalates — a sibling nested in an earlier branch
//   crashing past its own supervisor's intensity — is not followed; the
//   restart kind needs the sibling to be sup's own child. (Quiet.)
// - The reason is followed as the value it is (stop_path): a test on
//   something computed from it (an element of a tuple built around it,
//   its inspected string) takes both edges, a fun or an apply enters its
//   callee holding nothing, and a call into the runtime hands it to
//   nothing (shutdown_handed); each runs every call it can reach.
//   (Reports.)
//
// When the listing or the strategy does not settle which applies — the
// same module started on both sides of mod, or a strategy argus did not
// read — the row stays, as "call_unordered", for the builder to report
// less surely.
//
// `via` is the function on terminate/2's path that makes the call:
// terminate/2 itself, or a helper it reaches.

// terminate/2 calls a sibling with no try taking the exit, its process
// traps exits, and the supervisor's shutdown stops that sibling first.
.decl call_to_stopped_sibling(mod: symbol, terminate: symbol, via: symbol, sibling: symbol, sup: symbol)

call_to_stopped_sibling(mod, terminate, via, sibling, sup) :-
  terminate_waits_unguarded(mod, terminate, via, sibling),
  traps_exits(mod),
  stops_before(sup, sibling, mod).

// terminate/2 calls a sibling with no try taking the exit, its process
// traps exits, and the supervisor terminates mod when that sibling
// crashes: the sibling was started first, and its crash takes the
// children started after it down.
.decl call_to_crashed_sibling(mod: symbol, terminate: symbol, via: symbol, sibling: symbol, sup: symbol)

call_to_crashed_sibling(mod, terminate, via, sibling, sup) :-
  terminate_waits_unguarded(mod, terminate, via, sibling),
  traps_exits(mod),
  stops_before(sup, mod, sibling),
  crash_restarts_later(sup, sibling).

// terminate/2 calls a sibling with no try taking the exit, its process
// traps exits, and the supervisor's listing or strategy leaves open
// whether the sibling is gone first.
.decl call_to_sibling_in_unknown_order(mod: symbol, terminate: symbol, via: symbol, sibling: symbol, sup: symbol)

call_to_sibling_in_unknown_order(mod, terminate, via, sibling, sup) :-
  terminate_waits_unguarded(mod, terminate, via, sibling),
  traps_exits(mod),
  order_unsettled(sup, sibling, mod).

// mod's terminate/2 waits on `other` on the stop, with no try taking the
// exit (stop_wait): in terminate/2 itself (`via` is terminate), or in a
// helper it reaches along the stop's path (`via` is the helper).
.decl terminate_waits_unguarded(mod: symbol, terminate: symbol, via: symbol, other: symbol)

terminate_waits_unguarded(mod, t, via, other) :-
  is_terminate(t, mod),
  stop_wait(t, via, other, _).

// `later` sits in a branch of sup listed after one that holds
// `earlier`: the branch is `later` itself, or a supervisor above it.
.decl started_after(sup: symbol, later: symbol, earlier: symbol)

started_after(sup, later, earlier) :-
  starts_before(sup, earlier, later, _, _),
  later != earlier.

// sup's shutdown stops `first` before `other`: first's branch was
// started after other's, and never before it.
.decl stops_before(sup: symbol, first: symbol, other: symbol)

stops_before(sup, first, other) :-
  started_after(sup, first, other),
  !started_after(sup, other, first).

// A strategy under which a child's crash makes the supervisor terminate
// the children started after it.
.decl restarts_later_siblings(sup: symbol)

restarts_later_siblings(sup) :- supervisor(sup, "rest_for_one").
restarts_later_siblings(sup) :- supervisor(sup, "one_for_all").

// `child`'s crash makes sup terminate the children started after it:
// child is sup's own, under rest_for_one or one_for_all.
.decl crash_restarts_later(sup: symbol, child: symbol)

crash_restarts_later(sup, child) :-
  supervisor_child(sup, _, child, _, _),
  restarts_later_siblings(sup).

// sup's strategy is one argus read: one_for_one, rest_for_one or
// one_for_all.
.decl strategy_known(sup: symbol)

strategy_known(sup) :- supervisor(sup, "one_for_one").
strategy_known(sup) :- restarts_later_siblings(sup).

// Whether sup has stopped `sibling` before `mod` is open: each is
// started on both sides of the other, or the sibling, sup's own child,
// was started first and sup's strategy, which says whether its crash
// takes mod down, is one argus did not read.
.decl order_unsettled(sup: symbol, sibling: symbol, mod: symbol)

order_unsettled(sup, sibling, mod) :-
  started_after(sup, sibling, mod),
  started_after(sup, mod, sibling).

order_unsettled(sup, sibling, mod) :-
  stops_before(sup, mod, sibling),
  supervisor_child(sup, _, sibling, _, _),
  !strategy_known(sup).

teardown_touches_sibling(mod, sibling, "terminate", "call", via, sup, func, site, sup_site) :-
  call_to_stopped_sibling(mod, func, via, sibling, sup),
  stop_wait(func, via, sibling, site),
  supervisor_site_or_empty(sup, sup_site).

teardown_touches_sibling(mod, sibling, "terminate", "call_restart", via, sup, func, site, sup_site) :-
  call_to_crashed_sibling(mod, func, via, sibling, sup),
  stop_wait(func, via, sibling, site),
  supervisor_site_or_empty(sup, sup_site).

teardown_touches_sibling(mod, sibling, "terminate", "call_unordered", via, sup, func, site, sup_site) :-
  call_to_sibling_in_unknown_order(mod, func, via, sibling, sup),
  stop_wait(func, via, sibling, site),
  supervisor_site_or_empty(sup, sup_site).

// Where terminate/2's path to a helper that calls the sibling begins:
// the first call of the stop's path (stop_path). A path
// through something with no call instruction (a closure it hands to a
// call) points at terminate/2 itself, `call` empty — unless the helper
// is an anonymous function written inside terminate/2 (Horde's
// `Enum.each(signal_to, fn ... end)`), whose line the finding's anchor
// already is. The earliest such call is kept.
.decl terminate_path(handler: symbol, via: symbol, call: symbol)
.output terminate_path

.decl terminate_step(handler: symbol, via: symbol, call: symbol)

terminate_step(t, via, call) :-
  teardown_touches_sibling(_, _, "terminate", _, via, _, t, _, _),
  stop_path(t, via, _, _, call),
  call != "".

.decl terminate_stepped(handler: symbol, via: symbol)

terminate_stepped(t, via) :- terminate_step(t, via, _).

terminate_path(t, via, call) :- terminate_step(t, via, call).

terminate_path(t, via, "") :-
  teardown_touches_sibling(_, _, "terminate", _, via, _, t, _, _),
  via != t,
  !closure_in_terminate(t, via),
  !terminate_stepped(t, via).

// The helper is an anonymous function written inside terminate/2
// (`M:-terminate/2-fun-0-/1`): its line is inside terminate/2's source.
.decl closure_in_terminate(handler: symbol, via: symbol)

closure_in_terminate(t, via) :-
  teardown_touches_sibling(_, _, "terminate", _, via, _, t, _, _),
  function_def(t, m, n, a, _),
  contains(cat(m, ":-", n, "/", to_string(a), "-fun-"), via).

// A supervisor the facts place without the instruction that defines its
// tree anchors with an empty site: every rule's `sup` has a row here.
.decl supervisor_site_or_empty(sup: symbol, site: symbol)

supervisor_site_or_empty(sup, site) :- supervisor_site(sup, site).
supervisor_site_or_empty(sup, "") :- sibling(sup, _, _), !supervisor_site(sup, _).
supervisor_site_or_empty(sup, "") :- dynamic_child(sup, _, _), !supervisor_site(sup, _).

// ── Children started into another tree's supervisor ──────────────────
//
// A process that starts children onto a DynamicSupervisor it does not
// sit under ties their lifetime to that supervisor's tree, not its own.
// When its own tree shuts down, the children stay — reconnecting,
// logging, calling into applications that have already stopped
// (postgrex#763: pool connections under :db_connection's supervisor
// outliving the user's Repo). Unless terminate/2 stops them.
.decl foreign_dynamic_children(mod: symbol, sup: symbol, via: symbol, site: symbol, sup_site: symbol)
.output foreign_dynamic_children

.decl terminate_stops_children(mod: symbol)

terminate_stops_children(mod) :-
  terminate_callback(func, mod, _),
  (via = func ; teardown_reach.reaches(func, via, _)),
  sup_management_call(_, via, _, op, _),
  stopping_sup_op(op).

// What terminate/2 reaches within three calls, whatever its reason.
.init teardown_reach = ForwardBoundedCallReach

teardown_reach.root(func, func) :- terminate_callback(func, _, _).
teardown_reach.limit(3).

// A tree's members by module, and by the registered name a child spec
// gave them (`{DynamicSupervisor, name: Pool}` is a child named Pool).
.decl tree_member(root: symbol, member: symbol)

tree_member(root, mod) :- child_subtree(root, _, mod).
tree_member(root, name) :- supervisor_child_name(root, _, name).

tree_member(root, name) :-
  child_subtree(root, _, mid),
  supervisor_child_name(mid, _, name).

// The starter is the process whose callbacks reach the start — not the
// module the start function happens to live in, which may be a plain
// helper called from several processes (or from a request surface).
.init start_reach = CallReach

start_reach.seed(s, s) :- dynamic_child(_, _, s).

.decl starter_process(mod: symbol, start: symbol)

starter_process(mod, s) :- process_entry(mod, c), start_reach.reaches(c, s).

// A start function that lives in the supervisor's own module
// (`Postgrex.TypeSupervisor.start_server/2`, `DBConnection.Task.run_child/4`)
// is that tree offering a shared service; the children are meant to
// belong to it, whoever asks. A supervisor held as a pid ("dynamic") has
// no tree to place: process points-to does not follow start_child's
// supervisor argument, which is not a pid use. One named through a
// registry (`Oban.Registry.via(Foreman)`) is no tree member either.
foreign_dynamic_children(mod, sup, func, site, sup_site) :-
  dynamic_child(sup, _, func),
  sup != "dynamic",
  function_def(func, fmod, _, _, _),
  fmod != sup,
  starter_process(mod, func),
  mod != sup,
  tree_member(root, sup),
  !tree_member(root, mod),
  !terminate_stops_children(mod),
  dynamic_start_site_or_empty(func, site),
  supervisor_site_or_empty(sup, sup_site).

// The DynamicSupervisor.start_child call in `func`.
.decl dynamic_start_site(func: symbol, id: symbol)

dynamic_start_site(f, id) :- call_site(id, f, "DynamicSupervisor", "start_child", _).

// A start with no DynamicSupervisor.start_child instruction (a
// Task.Supervisor start) anchors at its function, the site empty.
.decl dynamic_start_site_or_empty(func: symbol, site: symbol)

dynamic_start_site_or_empty(f, id) :- dynamic_start_site(f, id).
dynamic_start_site_or_empty(f, "") :- dynamic_child(_, _, f), !dynamic_start_site(f, _).

// ── A callback stops a sibling the supervisor owns ───────────────────
//
// GenServer.stop on a sibling child of the same supervisor, from a
// handler: the supervisor still owns that child and restarts it (a
// permanent one), or has already stopped it during shutdown and the
// stop exits with :noproc in the caller (horde#154, #193: the
// DynamicSupervisorImpl stopping its ProcessesSupervisor sibling on
// quorum loss, crashing at SIGTERM). terminate/2 is the other rule.
.decl stops_process(func: symbol, target: symbol)

stops_process(f, target) :- sup_call(_, f, "GenServer", "stop", target).

.init stop_reach = CallReach

stop_reach.seed(f, f) :- stops_process(f, _).

// The stop names the sibling module.
teardown_touches_sibling(mod, sib, "handler", "stop", via, sup, h, site, sup_site) :-
  handler_function(mod, h),
  stop_reach.reaches(h, via),
  stops_process(via, sib),
  sibling(sup, mod, sib),
  site_or_empty_call(h, via, site),
  supervisor_site_or_empty(sup, sup_site).

// The call in `h` toward `via`, when h calls it directly.
.decl site_or_empty_call(func: symbol, callee: symbol, site: symbol)

site_or_empty_call(f, g, id) :- call_instr(f, g, id).
site_or_empty_call(f, g, "") :- stop_reach.reaches(f, g), !call_instr(f, g, _).

// The stop is the sibling's own API (`Sibling.stop/1`), target unknown —
// unless the handler hands it only processes it started for itself.
teardown_touches_sibling(mod, sib, "handler", "stop", via, sup, h, site, sup_site) :-
  handler_function(mod, h),
  stop_reach.reaches(h, via),
  function_def(via, sib, _, _, _),
  sibling(sup, mod, sib),
  !private_stop(h, via, sib),
  site_or_empty_call(h, via, site),
  supervisor_site_or_empty(sup, sup_site).

// Every process `h` hands `via`'s first parameter is one of sib's that
// a function keeps for itself (points-to), and there is one.
.decl stop_arg(handler: symbol, via: symbol, proc: symbol)

stop_arg(h, via, p) :-
  handler_function(_, h),
  pid_arg(_, h, via, "0", "call", sk, s),
  source_process(h, sk, s, p).

.decl private_stop(handler: symbol, via: symbol, sib: symbol)

private_stop(h, via, sib) :-
  stop_arg(h, via, p),
  server_process(p, sib),
  private_process(p, _, _),
  !shared_stop(h, via, sib).

.decl shared_stop(handler: symbol, via: symbol, sib: symbol)

shared_stop(h, via, sib) :-
  stop_arg(h, via, p),
  server_process(p, sib),
  !private_process(p, _, _).

// ── Trap exit without handler ────────────────────────────────────

// Module traps exits but defines no handle_info callback that could
// receive {:EXIT, ...} messages. This is a heuristic — we check if
// the module has any handle_info function.
//
// gen_statem / GenStateMachine modules deliver info events (including
// {:EXIT, ...}) to their state functions or handle_event/4, not to a
// handle_info callback, so the has_handle_info check is meaningless for
// them — every trapping gen_statem would be a false positive (Swarm's
// Tracker even matches {:EXIT, ...} explicitly). Exclude them.

// `witness` is the function that sets trap_exit. One row per witness —
// finding builders dedupe on (mod, kind). `kind` is "no_handler" (no
// handle_info at all) or "no_exit_clause" (a handle_info that never
// matches {:EXIT, ...}).
.decl unhandled_exit_signal(mod: symbol, kind: symbol, witness: symbol)
.output unhandled_exit_signal

unhandled_exit_signal(mod, "no_handler", func) :-
  module_traps(func, mod),
  gen_server_like(mod),
  !has_handle_info(mod).

// A process whose trapped exits gen_server hands to handle_info/2: a
// GenServer (or a wrapper that runs one), a GenStage, or a server under
// a behaviour the table does not list that answers calls
// (gen_server_like, callbacks.dl: rabbit's gen_server2). Another listed
// loop (a LiveView, a channel, a GenEvent) takes them its own way, and a
// process under a behaviour argus does not know (gen_batch_server
// passes `{info, {'EXIT', ...}}` to handle_batch/2, a cowboy_loop
// handler to info/3) runs a receive argus does not see.
//
// ── A hand-rolled loop that traps and takes no exit ─────────────────
//
// A process no behaviour runs reads its mailbox in its own receive: a
// spawn_link'ed loop, a proc_lib process. When it traps exits and none
// of the receives it runs has a clause that can take an `{:EXIT, pid,
// reason}` (recv_takes_exit: one for :EXIT, or one that fixes no tag), a
// linked process's exit becomes a message nothing takes: it stays in the
// mailbox, every receive scans past it, and the exit trapping was meant
// to answer (the parent's shutdown among them) goes unanswered. The
// receives are what the trapping function runs after it in its process,
// and what a spawned function that reaches it there runs: a loop entered
// after a setup that traps. The trap is any not on a process module's
// own stack (trap_on_process_stack, process_kind.dl: a behaviour's loop
// reads that mailbox, not these receives): one in a module no behaviour
// runs, and one in what a spawn or proc_lib runs, which module_traps
// leaves out (traps_elsewhere) because it is not the module's server's.
// Not asked of a process that runs no receive (grpc's Mint adapter traps
// for its caller), or one that runs code whose receives are not the
// program's to read: a call through a fun or an apply, an enter_loop, a
// hibernate.
.decl trap_loop_candidate(func: symbol)

trap_loop_candidate(func) :-
  trap_exit(func, mod),
  !trap_on_process_stack(func),
  !statem_process(mod).

.init trap_loop_caller = SameProcessReach

trap_loop_caller.seed(f, f) :- trap_loop_candidate(f).

.init trap_loop = ForwardSameProcessReachCut

trap_loop.cut(f, g) :- side_call(f, g).
trap_loop.root(f, f) :- trap_loop_candidate(f).

trap_loop.root(f, r) :-
  trap_loop_candidate(f),
  trap_loop_caller.reaches(r, f),
  process_start(_, _, _, "spawn", r).

.decl trap_loop_receives(func: symbol)

trap_loop_receives(f) :- trap_loop.reaches(f, g), recv_start(_, g, _, _).

.decl trap_loop_takes_exit(func: symbol)

trap_loop_takes_exit(f) :- trap_loop.reaches(f, g), recv_takes_exit(_, g).

.decl trap_loop_opaque(func: symbol)

trap_loop_opaque(f) :- trap_loop.reaches(f, g), dynamic_call(_, g, _).

trap_loop_opaque(f) :-
  trap_loop.reaches(f, g),
  remote_call(_, g, m, "enter_loop", _),
  (m = ":gen_server" ; m = ":gen_statem" ; m = ":gen_event").

trap_loop_opaque(f) :-
  trap_loop.reaches(f, g),
  remote_call(_, g, m, "hibernate", _),
  (m = ":erlang" ; m = ":proc_lib").

unhandled_exit_signal(mod, "no_receive_clause", func) :-
  trap_loop_candidate(func),
  function_def(func, mod, _, _, _),
  trap_loop_receives(func),
  !trap_loop_takes_exit(func),
  !trap_loop_opaque(func).

// ── Trap exit with a handle_info that never matches {:EXIT, ...} ──
//
// The module defines handle_info/2 — so the check above is satisfied —
// but no clause discriminates on :EXIT and none is a catch-all. The
// trapped exit arrives as a message no clause accepts, and the process
// dies with a FunctionClauseError on the very signal trapping was meant
// to absorb. Bandit's HTTP/1 handler shipped this shape: trap_exit set
// by `use ThousandIsland.Handler`, one handle_info clause for
// {:plug_conn, :sent}, and a Plug that spawned a port took the
// connection down.
//
// callback_tag over-approximates (every atom compared anywhere in the
// body counts), so a module that mentions :EXIT at all is not reported —
// the direction that keeps the rule quiet rather than noisy.
unhandled_exit_signal(mod, "no_exit_clause", func) :-
  trap_exit_without_exit_clause(mod, func).

// ══ Teardown that hurts a monitored child ═══════════════════════════

// ── Terminating a process the server still monitors ───────────────────
//
// terminate_child (and GenServer.stop) on a pid this server monitors,
// with the monitor not released on the way to the kill: the {:DOWN, ...}
// for a death the server caused is delivered like any other, into the
// clause written for crashes. Oban's producer terminated a job's process
// on pkill and then handled its own :DOWN as a crash; Redix's cluster
// manager terminated a departed node's connection and its :DOWN clause
// reconnected it.
.decl kills_monitored_child(mod: symbol, site: symbol, kill_site: symbol)
.output kills_monitored_child

//
// The monitor is the server's when it is taken on the server's own stack
// (server_side): one a Task or a spawn the server starts takes is that
// process's, and so is its :DOWN. The kill is the server's doing wherever
// its callbacks make it happen, a process they start included (`spawn(fn
// -> GenServer.stop(conn) end)`): the :DOWN still comes to the server
// that monitors (server_caused, clientlib/process_kind.dl).
//
// The kill must be of the monitored process (kills_what_it_monitors):
// both resolve to one process (signal_target, the points-to stage: the
// monitor's and the stop's), or either does not resolve, and may be it.
// A kill of one process and a monitor of another (a watcher's) are no
// pair. And the kill's own way does not release the monitor
// (released_with_kill: a demonitor in the killing function, in one that
// calls it, or in one it calls): a demonitor of some other monitor, in
// another callback, releases nothing the kill's :DOWN would bring.

kills_monitored_child(mod, site, kill_site) :-
  server_side(mod, f),
  monitor_call(site, f, _),
  server_caused(mod, g),
  kill_call(kill_site, g),
  kills_what_it_monitors(site, f, kill_site, g),
  !released_with_kill(g).

// A stop of a process: a supervisor's terminate_child, GenServer.stop.
.decl kill_call(site: symbol, func: symbol)

kill_call(x, g) :- sup_call(x, g, _, "terminate_child", _).
kill_call(x, g) :- remote_call(x, g, "GenServer", "stop", _).

.decl kills_what_it_monitors(monitor: symbol, mfunc: symbol, kill: symbol, kfunc: symbol)

kills_what_it_monitors(m, f, k, g) :-
  signal_target(m, f, "monitor", p),
  signal_target(k, g, "stop", p).

kills_what_it_monitors(m, f, k, g) :-
  monitor_call(m, f, _),
  kill_call(k, g),
  !signal_target(m, f, "monitor", _).

kills_what_it_monitors(m, f, k, g) :-
  monitor_call(m, f, _),
  kill_call(k, g),
  !signal_target(k, g, "stop", _).

// The kill's own way releases a monitor: a demonitor in the function that
// kills, in a function that calls it, or in one it calls.
.decl released_with_kill(func: symbol)

released_with_kill(g) :- kill_call(_, g), demonitor_call(_, g, _).
released_with_kill(g) :- kill_call(_, g), call_edge(c, g), demonitor_call(_, c, _).
released_with_kill(g) :- kill_call(_, g), call_edge(g, h), demonitor_call(_, h, _).

// ══ A permanent child that stops itself ═════════════════════════════

// ── Permanent child that stops itself normally ────────────────────────
//
// A supervisor restarts a :permanent child whatever the exit reason —
// :normal and :shutdown included. So a permanent child whose callback
// returns {:stop, :normal, ...} has asked to go away and will be started
// straight back; the code that follows the stop (graceful permdown,
// drain-and-quit) is undone at once. Phoenix PubSub's tracker shards did
// this on graceful permdown until their spec became :transient.
//
// Only a literal reason counts (callback_stop_reason), and terminate/2
// is excluded: it does not return a stop tuple. One row per stop site —
// finding builders dedupe on (sup, child).
.decl permanent_child_stops_normally(sup: symbol, child: symbol, reason: symbol, site: symbol, sup_site: symbol)
.output permanent_child_stops_normally

permanent_child_stops_normally(sup, child, reason, site, sup_site) :-
  supervisor(sup, _),
  supervisor_site(sup, sup_site),
  child_restart(sup, _, child, "permanent"),
  function_def(func, child, name, _, _),
  name != "terminate",
  callback_stop_reason(site, func, reason),
  (reason = ":normal" ; reason = ":shutdown").

// ══ A Broadway producer that drains by cancelling its poll ═════════
//
// Since Broadway 1.1 a producer is no longer switched to :accumulate
// while its pipeline drains (GenStage 1.2): processors still send
// demand, and stopping the fetch is the producer's own job in
// prepare_for_draining/1. A drain that cancels the poll timer and clears
// the field holding its ref (`%{state | receive_timer: nil}`) sets the
// very value the fetch's clause asks for (`handle_receive_messages(
// %{receive_timer: nil} = state)`, field_nil_test): the next demand
// fetches again, and what it fetches — SQS messages whose visibility
// timeout has started, entries popped from a queue — is never processed
// before the pipeline stops (broadway_sqs, broadway_cloud_pub_sub,
// off_broadway_redis_stream, all fixed with a `draining: true` flag and a
// clause that takes it first).
//
// `drain_keeps_fetching(mod, drain, gate, key)` — `drain` (the
// producer's prepare_for_draining/1) sets `key` to nil in the state it
// returns, and `gate`, which handle_demand/2 reaches in the module,
// tests `key` against nil; and no other field the drain sets to a
// literal is one a function handle_demand/2 reaches compares with a
// literal (a `draining: true` the fetch takes first). Whether the drain
// cancels a timer is not asked: one that only clears the field lets the
// fetch run all the same.
.decl drain_keeps_fetching(mod: symbol, drain: symbol, gate: symbol, key: symbol)
.output drain_keeps_fetching

.init drain_reach = ForwardIntraModuleSameProcessReach

drain_reach.root(f, f) :-
  behaves_as(m, "Broadway.Producer"),
  function_def(f, m, "handle_demand", 2, _).

.decl drain_flag_read(mod: symbol, drain: symbol)

drain_flag_read(m, d) :-
  function_def(d, m, "prepare_for_draining", 1, _),
  returned_update(d, k, v, _),
  v != "nil",
  v != "dynamic",
  function_def(h, m, "handle_demand", 2, _),
  drain_reach.reaches(h, g),
  field_value_test(g, k, _).

drain_keeps_fetching(m, d, g, key) :-
  behaves_as(m, "Broadway.Producer"),
  function_def(d, m, "prepare_for_draining", 1, _),
  returned_update(d, key, "nil", _),
  function_def(h, m, "handle_demand", 2, _),
  drain_reach.reaches(h, g),
  field_nil_test(g, key),
  !drain_flag_read(m, d).
