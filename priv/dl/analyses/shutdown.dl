// Shutdown defects: skipped or unbounded cleanup, unhandled trapped exits, teardown
// calls to stopped siblings, children outliving their owner, deliberate kills handled
// as crashes, and permanent children restarting after normal stops. Supervisor shutdown
// runs terminate only when the process traps exits.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/signals.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/order.dl"
.include "../clientlib/trapping.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// Shutdown trapping requirements. Use server_traps: some process entry leaves trap_exit
// set, allowing supervisor shutdown signals to reach terminate/2.

// Follow the supervisor shutdown reason
//
// Supervisors stop children with bare :shutdown. Start terminate/2 or terminate/3 with
// that value in parameter 0, follow only selected calls (`shutdown_runs`), and
// propagate unchanged arguments (`shutdown_handed`). `pos = -1` means no tracked
// reason, so all calls remain reachable. Closure/reference edges without sites are also
// followed. Tuple shutdown reasons describe different stop paths.

// The call at `id` in `func` runs when func holds the reason in `pos`.
.decl runs_holding(func: symbol, pos: number, id: symbol) inline

runs_holding(f, pos, id) :- shutdown_runs(id, f, pos).
runs_holding(f, pos, _id) :- !shutdown_chooses(f, pos).

// The call at id forwards the reason from func's parameter pos to callee argument arg.
// Use -1 if it does not forward the reason.
.decl hands_holding(func: symbol, pos: number, id: symbol, arg: number) inline

hands_holding(f, pos, id, arg) :- shutdown_handed(id, f, pos, arg).
hands_holding(f, pos, id, -1) :- !shutdown_handed(id, f, pos, _).

// Cleanup that matters on supervisor shutdown
//
// Count durable writes other than logging. Reads and resources automatically released
// at process exit are excluded. Follow only calls reachable with reason :shutdown;
// cleanup for other stop reasons is not expected on this path.
.decl runs_on_shutdown(terminate: symbol, callee: symbol)

runs_on_shutdown(t, g) :-
  terminate_callback(t, _, _),
  call_instr(t, g, id),
  runs_holding(t, 0, id).

runs_on_shutdown(t, g) :-
  terminate_callback(t, _, _),
  call_edge(t, g),
  !call_instr(t, g, _).

// Limit cleanup evidence to three calls from terminate: the direct shutdown call plus
// two further hops. This captures nearby cleanup APIs without attributing deep
// client-library internals to the terminating module.
.init terminate_reach = ForwardBoundedCallReach

terminate_reach.root(t, g) :- runs_on_shutdown(t, g).
terminate_reach.limit(2).

// ── Cleanup a supervisor shutdown skips ──────────────────────────

// terminate/2 performs cleanup, but the server does not trap exits, so supervisor
// shutdown skips it. Unknown trap flags (may_trap) suppress this finding.
.decl skipped_cleanup(mod: symbol, terminate: symbol, cleanup: symbol)

skipped_cleanup(mod, terminate, cleanup) :-
  terminate_callback(terminate, mod, _),
  does_cleanup(terminate, cleanup),
  !may_trap(mod).

// Cleanup at write has effects beyond the process's lifetime. Exclude resources the
// runtime automatically releases on exit.
.decl does_cleanup(terminate: symbol, write: symbol)

does_cleanup(terminate, write) :-
  writes_on_shutdown(terminate, write),
  outlasts_process(write),
  !released_by_exit(write, terminate).

// A cleanup write reachable during supervisor shutdown, directly in terminate/2 or
// through terminate_reach helpers.
.decl writes_on_shutdown(terminate: symbol, write: symbol)

writes_on_shutdown(t, id) :-
  terminate_callback(t, _, _),
  impure_call(id, t, _, _, "write"),
  runs_holding(t, 0, id).

writes_on_shutdown(t, id) :-
  terminate_callback(t, _, _),
  terminate_reach.reaches(t, via, _),
  via != t,
  impure_call(id, via, _, _, "write").

// The call's effect leaves the process and stays done when it exits
// (durable_effect, effect_model.dl).
.decl outlasts_process(call: symbol) inline

outlasts_process(id) :- impure_call(id, _, _, category, _), durable_effect(category).

// Automatic release includes APIs in released_at_exit and writes to an owner-held ETS
// table that dies with the process. Classify the concrete call's effect API.
.decl released_by_exit(call: symbol, terminate: symbol)

released_by_exit(id, t) :-
  writes_on_shutdown(t, id),
  impure_call(id, _, api, _, _),
  released_at_exit(api).

released_by_exit(id, t) :-
  writes_on_shutdown(t, id),
  terminate_callback(t, mod, _),
  own_table_released(mod, id).

// Writes to named tables created by the module's init are released at exit when no heir
// preserves them. This includes table deletion. Unknown names, other owners, and
// heir-backed tables may survive, so their writes remain cleanup.
.decl own_table_released(mod: symbol, id: symbol)

own_table_released(mod, id) :-
  cleanup_candidate(mod, id),
  ets_op(id, _, t, _, _),
  own_named_table(mod, t).

// An ETS call terminate/2's cleanup rules ask about.
.decl cleanup_candidate(mod: symbol, id: symbol)

cleanup_candidate(mod, id) :-
  terminate_callback(t, mod, _),
  impure_call(id, t, _, "ets", "write").

cleanup_candidate(mod, id) :-
  terminate_callback(t, mod, _),
  terminate_reach.reaches(t, via, _),
  impure_call(id, via, _, "ets", "write").

// A named table created by init/1 remains owned until exit when its fully known options
// specify no heir and no operation transfers, renames or reconfigures it.
.decl own_named_table(mod: symbol, table: symbol)

own_named_table(m, t) :-
  init_function(m, i),
  ets_new(n, i, t),
  t != "dynamic",
  ets_options_known(n),
  named_site(n),
  !has_heir(n),
  !passed_on(t).

// Ownership or options the table's code can change after it is made.
.decl passed_on(table: symbol)

passed_on(t) :- ets_op(_, _, t, "give_away", _).
passed_on(t) :- ets_op(_, _, t, "rename", _).
passed_on(t) :- ets_op(_, _, t, "setopts", _).

// Cleanup findings: `never_runs` for known durable cleanup skipped without exit
// trapping, `unclear` for unclassified work skipped the same way, and `truncated` for
// trapping processes with cleanup unbounded by the shutdown timeout. Report once per
// module and kind; `cleanup_site` supplies call locations.
.decl cleanup_defect(mod: symbol, behaviour: symbol, kind: symbol, category: symbol, api: symbol, via: symbol)
.output cleanup_defect

// The headline: cleanup that a supervisor shutdown will skip entirely.
cleanup_defect(mod, behaviour, "never_runs", category, api, via) :-
  skipped_cleanup(mod, terminate, cleanup),
  terminate_callback(terminate, mod, behaviour),
  impure_call(cleanup, via, api, category, _).

// Report unclassified terminate work separately and with lower confidence. The rule
// establishes that supervisor shutdown skips it, but cannot establish what cleanup the
// call performs.

// A non-trapping server's terminate/2 contains unclassified work but no known cleanup.
// Supervisor shutdown may skip required cleanup.
.decl unclear_cleanup(mod: symbol, terminate: symbol, work: symbol)

unclear_cleanup(mod, terminate, work) :-
  terminate_callback(terminate, mod, _),
  does_unclassified_work(terminate, work),
  !may_trap(mod),
  !terminate_does_cleanup(mod).

// An unclassified call reachable during :shutdown, directly or within the bounded
// cleanup traversal. Exclude structural helper calls such as constructing structs or
// messages.
.decl does_unclassified_work(terminate: symbol, work: symbol)

does_unclassified_work(t, id) :-
  terminate_callback(t, _, _),
  unknown_call(id, t, _, _),
  runs_holding(t, 0, id).

does_unclassified_work(t, id) :-
  terminate_callback(t, _, _),
  terminate_reach.reaches(t, via, _),
  via != t,
  unknown_call(id, via, api, _),
  !structural_call(api).

// Known terminate/2 cleanup is already reported as never_runs. Suppress the weaker
// unclear finding for the same module.
.decl terminate_does_cleanup(mod: symbol)

terminate_does_cleanup(mod) :- terminate_callback(t, mod, _), does_cleanup(t, _).

cleanup_defect(mod, behaviour, "unclear", "", api, via) :-
  unclear_cleanup(mod, terminate, work),
  terminate_callback(terminate, mod, behaviour),
  unknown_call(work, via, api, _).

// Slow work inside terminate, for a module that DOES trap exits — so the
// callback is reached, but may not finish.

// A trapping server's terminate/2 performs unbounded cleanup, which may exceed the
// supervisor's shutdown timeout.
.decl truncated_cleanup(mod: symbol, terminate: symbol, cleanup: symbol)

truncated_cleanup(mod, terminate, cleanup) :-
  terminate_callback(terminate, mod, _),
  does_cleanup(terminate, cleanup),
  server_traps(mod),
  unbounded(cleanup).

// The call has no bound of its own inside the shutdown timeout: network
// and port calls (slow_effect, effect_model.dl).
.decl unbounded(call: symbol) inline

unbounded(id) :- impure_call(id, _, _, category, _), slow_effect(category).

cleanup_defect(mod, behaviour, "truncated", category, api, via) :-
  truncated_cleanup(mod, terminate, cleanup),
  terminate_callback(terminate, mod, behaviour),
  impure_call(cleanup, via, api, category, _).

// Every call a cleanup_defect finding is about, where it is: the frames
// of the module's finding of that kind.
.decl cleanup_site(mod: symbol, kind: symbol, api: symbol, via: symbol, site: symbol)
.output cleanup_site

cleanup_site(mod, "never_runs", api, via, id) :-
  skipped_cleanup(mod, _, id),
  impure_call(id, via, api, _, _).

cleanup_site(mod, "unclear", api, via, id) :-
  unclear_cleanup(mod, _, id),
  unknown_call(id, via, api, _).

cleanup_site(mod, "truncated", api, via, id) :-
  truncated_cleanup(mod, _, id),
  impure_call(id, via, api, _, _).

// Synchronous sibling calls during terminate
//
// Reverse shutdown order can leave a sibling unavailable, causing :noproc and aborting
// remaining cleanup. A matching try may cover the peer call or a helper on its path.
// Accept a general exit catch or tuple `{:noproc, _}`; bare :noproc matches stop
// failures, not GenServer.call's wrapped reason.
.decl exit_guarded(call: symbol)

exit_guarded(call) :- covered_by_catch(call, _, _, "exit").

exit_guarded(call) :-
  try_covers(t, f, call, "try"),
  catch_tuple_tag(t, f, "exit", ":noproc").

// For dependencies or fun edges without a call site, any matching exit handler in the
// function suppresses the finding. This fallback may over-suppress.
.decl catches_exit(func: symbol)

catches_exit(f) :- catches_class(f, "exit").
catches_exit(f) :- catch_tuple_tag(_, f, "exit", ":noproc").

// A synchronous dependency on another module's server. Exclude private connections the
// module started for itself (private_dep).
.decl waits_on(func: symbol, mod: symbol) inline

waits_on(f, m) :- sync_dep(f, m), !private_dep(f, m).

// The call that invokes a function value, either through a receiving API such as
// Enum.each or a resolved apply.
.decl fun_site(func: symbol, callee: symbol, id: symbol)

fun_site(f, g, id) :- fun_handed(id, f, g, _).
fun_site(f, g, id) :- resolved_apply(id, f, g).

// The call waiting on mod, resolved directly, by message tag, or through a passed
// synchronous-API fun. For a fun, use its receiving call for try coverage.
.decl wait_site(func: symbol, mod: symbol, id: symbol)

wait_site(f, m, id) :- sync_site(f, m, id).

wait_site(f, m, id) :-
  genserver_sync_api(g, m),
  fun_site(f, g, id),
  !call_instr(f, g, _),
  function_def(f, fm, _, _, _),
  fm != m.

wait_site(f, m, id) :-
  tag_resolved_site(id, f, "call", m),
  sync_call_site(id, f, t, _),
  unresolved_target(t).

// Shutdown call paths
//
// Follow at most three same-process calls reachable for :shutdown, stopping at
// exit-catching handlers. `pos` tracks the reason parameter; `first` records
// terminate's first call site. For fun edges, test the receiving call's coverage
// (`fun_site`); use function-wide catches only when no such site exists. Spawned funs
// are outside terminate's exception scope. Funs enter without a tracked reason.
.decl stop_path(terminate: symbol, func: symbol, pos: number, depth: number, first: symbol)

stop_path(t, t, 0, 0, "") :- is_terminate(t, _).

stop_path(t, g, arg, 1, call) :-
  stop_path(t, t, 0, 0, _),
  stop_call_edge(t, 0, g, arg, call).

stop_path(t, g, -1, 1, "") :-
  stop_path(t, t, 0, 0, _),
  stop_fun_edge(t, 0, g).

stop_path(t, h, arg, d + 1, first) :-
  stop_path(t, g, pos, d, first),
  d > 0,
  d < 3,
  stop_call_edge(g, pos, h, arg, _).

stop_path(t, h, -1, d + 1, first) :-
  stop_path(t, g, pos, d, first),
  d > 0,
  d < 3,
  stop_fun_edge(g, pos, h).

// An unguarded shutdown-path call from func to callee, forwarding the shutdown reason
// from pos to arg when applicable.
.decl stop_call_edge(func: symbol, pos: number, callee: symbol, arg: number, call: symbol)

stop_call_edge(f, pos, g, arg, call) :-
  stop_path(_, f, pos, _, _),
  call_instr(f, g, call),
  runs_holding(f, pos, call),
  !exit_guarded(call),
  hands_holding(f, pos, call, arg).

// A site-less fun edge runs during shutdown if its receiving call is reached,
// unguarded, and same-process. Without such a call, require no function-wide exit
// handler.
.decl stop_fun_edge(func: symbol, pos: number, callee: symbol)

stop_fun_edge(f, pos, g) :-
  stop_path(_, f, pos, _, _),
  fun_site(f, g, call),
  !call_instr(f, g, _),
  runs_holding(f, pos, call),
  !exit_guarded(call),
  !starts_a_process(call),
  !runs_elsewhere(f, g).

stop_fun_edge(f, pos, g) :-
  stop_path(_, f, pos, _, _),
  call_edge(f, g),
  !call_instr(f, g, _),
  !fun_site(f, g, _),
  !catches_exit(f),
  !runs_elsewhere(f, g).

// An unguarded synchronous wait reached on the shutdown path. Use an empty site when
// only a function-level dependency is available and no exit catch exists there.
// Reason-aware client APIs count only if their :shutdown path waits.
.decl stop_wait(terminate: symbol, func: symbol, mod: symbol, site: symbol)

stop_wait(t, f, m, id) :-
  stop_path(t, f, pos, _, _),
  waits_on(f, m),
  wait_site(f, m, id),
  runs_holding(f, pos, id),
  !exit_guarded(id),
  !api_handed(f, pos, id, m, _, _).

stop_wait(t, f, m, id) :-
  stop_path(t, f, pos, _, _),
  waits_on(f, m),
  wait_site(f, m, id),
  runs_holding(f, pos, id),
  !exit_guarded(id),
  api_handed(f, pos, id, m, g, arg),
  api_waits_holding(g, arg, m).

stop_wait(t, f, m, "") :-
  stop_path(t, f, _, _, _),
  waits_on(f, m),
  !wait_site(f, m, _),
  !catches_exit(f).

// The call at `id`, where `func` holds the reason in `pos`, hands it to
// mod's client API `api` (genserver_sync_api) as argument `arg`.
.decl api_handed(func: symbol, pos: number, id: symbol, mod: symbol, api: symbol, arg: number)

api_handed(f, pos, id, m, g, arg) :-
  stop_path(_, f, pos, _, _),
  shutdown_handed(id, f, pos, arg),
  call_instr(f, g, id),
  genserver_sync_api(g, m).

// Follow mod's client API with :shutdown in parameter pos. Retain only selected calls
// while forwarding the reason; calls losing it enter with all clauses possible.
.decl api_waits_holding(func: symbol, pos: number, mod: symbol)

// What api_waits_holding is asked of: the APIs a stop's call hands the
// reason to, and what they hand it on to.
.decl holding_asked(func: symbol, pos: number, mod: symbol)

holding_asked(g, arg, m) :- api_handed(_, _, _, m, g, arg).

holding_asked(h, arg, m) :-
  holding_asked(g, pos, m),
  call_instr(g, h, id),
  runs_holding(g, pos, id),
  shutdown_handed(id, g, pos, arg).

api_waits_holding(g, pos, m) :-
  holding_asked(g, pos, m),
  function_def(g, m, _, _, _),
  sync_call_site(id, g, _, _),
  runs_holding(g, pos, id),
  !calls_other_server(g, m).

api_waits_holding(g, pos, m) :-
  holding_asked(g, pos, m),
  call_instr(g, h, id),
  runs_holding(g, pos, id),
  hands_holding(g, pos, id, -1),
  sync_caller_in(h, m).

api_waits_holding(g, pos, m) :-
  holding_asked(g, pos, m),
  call_instr(g, h, id),
  runs_holding(g, pos, id),
  shutdown_handed(id, g, pos, arg),
  api_waits_holding(h, arg, m).

api_waits_holding(g, pos, m) :-
  holding_asked(g, pos, m),
  call_edge(g, h),
  !call_instr(g, h, _),
  sync_caller_in(h, m).

// `func` is a function of mod's that makes a synchronous call, or reaches
// one (reaches_sync_caller_in, calls.dl), whatever it holds.
.decl sync_caller_in(func: symbol, mod: symbol)

sync_caller_in(h, m) :-
  function_def(h, m, _, _, _),
  sync_call(h, _),
  !calls_other_server(h, m).

sync_caller_in(h, m) :- reaches_sync_caller_in(h, m).

// Sibling teardown output. `phase = terminate` describes waits on possibly stopped
// siblings; `handler` describes stopping a sibling still owned by its supervisor.
// `handler` identifies the callback, `via` the waiting function, `site` its direct
// unguarded call when known, and `sup_site` their common supervision site.
.decl teardown_touches_sibling(mod: symbol, sibling: symbol, phase: symbol, kind: symbol, via: symbol, sup: symbol, handler: symbol, site: symbol, sup_site: symbol)
.output teardown_touches_sibling

// When the sibling is already gone
//
// `call`: reverse shutdown order stops later sibling branches first.
// `call_restart`: an earlier direct child crashes under rest_for_one or one_for_all,
// triggering this module's teardown. A crash contained by a nested supervisor does not
// qualify.
// Use the common supervisor's branch order, and require exit trapping so terminate runs
// on :shutdown. Unknown order or strategy yields the less certain `call_unordered`.
// Limits: unmodeled brutal_kill specs can produce false reports; escalated failures
// from nested supervisors can be missed. Tests of transformed shutdown reasons and
// opaque calls lose the tracked reason and retain every reachable call.

// terminate/2 calls a sibling with no try taking the exit, its process
// traps exits, and the supervisor's shutdown stops that sibling first.
.decl call_to_stopped_sibling(mod: symbol, terminate: symbol, via: symbol, sibling: symbol, sup: symbol)

call_to_stopped_sibling(mod, terminate, via, sibling, sup) :-
  terminate_waits_unguarded(mod, terminate, via, sibling),
  server_traps(mod),
  stops_before(sup, sibling, mod).

// A trapping server's terminate/2 calls an earlier sibling without catching exits.
// Under rest_for_one, that sibling's crash triggers this cleanup after the sibling is
// gone.
.decl call_to_crashed_sibling(mod: symbol, terminate: symbol, via: symbol, sibling: symbol, sup: symbol)

call_to_crashed_sibling(mod, terminate, via, sibling, sup) :-
  terminate_waits_unguarded(mod, terminate, via, sibling),
  server_traps(mod),
  stops_before(sup, mod, sibling),
  crash_restarts_later(sup, sibling).

// A trapping server's terminate/2 calls a sibling without catching exits, and
// supervision order or strategy does not establish whether the sibling remains alive.
.decl call_to_sibling_in_unknown_order(mod: symbol, terminate: symbol, via: symbol, sibling: symbol, sup: symbol)

call_to_sibling_in_unknown_order(mod, terminate, via, sibling, sup) :-
  terminate_waits_unguarded(mod, terminate, via, sibling),
  server_traps(mod),
  order_unsettled(sup, sibling, mod).

// During shutdown, mod waits on other without catching exits. `via` identifies
// terminate/2 or the helper making the wait.
.decl terminate_waits_unguarded(mod: symbol, terminate: symbol, via: symbol, other: symbol)

terminate_waits_unguarded(mod, t, via, other) :-
  is_terminate(t, mod),
  stop_wait(t, via, other, _).

// `later` sits in a branch of sup listed after one that holds
// `earlier`: the branch is `later` itself, or a supervisor above it.
.decl started_after(sup: symbol, later: symbol, earlier: symbol)

started_after(sup, later, earlier) :-
  starts_before(sup, earlier, later, _, _),
  later != earlier.

// sup's shutdown stops `first` before `other`: first's branch was
// started after other's, and never before it.
.decl stops_before(sup: symbol, first: symbol, other: symbol)

stops_before(sup, first, other) :-
  started_after(sup, first, other),
  !started_after(sup, other, first).

// A strategy under which a child's crash makes the supervisor terminate
// the children started after it.
.decl restarts_later_siblings(sup: symbol)

restarts_later_siblings(sup) :- supervisor(sup, "rest_for_one").
restarts_later_siblings(sup) :- supervisor(sup, "one_for_all").

// `child`'s crash makes sup terminate the children started after it:
// child is sup's own, under rest_for_one or one_for_all.
.decl crash_restarts_later(sup: symbol, child: symbol)

crash_restarts_later(sup, child) :-
  supervisor_child(sup, _, child, _, _),
  restarts_later_siblings(sup).

// sup's strategy is one argus read: one_for_one, rest_for_one or
// one_for_all.
.decl strategy_known(sup: symbol)

strategy_known(sup) :- supervisor(sup, "one_for_one").
strategy_known(sup) :- restarts_later_siblings(sup).

// Shutdown order is uncertain when module placements overlap or an earlier direct
// sibling's restart effect depends on an unread supervisor strategy.
.decl order_unsettled(sup: symbol, sibling: symbol, mod: symbol)

order_unsettled(sup, sibling, mod) :-
  started_after(sup, sibling, mod),
  started_after(sup, mod, sibling).

order_unsettled(sup, sibling, mod) :-
  stops_before(sup, mod, sibling),
  supervisor_child(sup, _, sibling, _, _),
  !strategy_known(sup).

teardown_touches_sibling(mod, sibling, "terminate", "call", via, sup, func, site, sup_site) :-
  call_to_stopped_sibling(mod, func, via, sibling, sup),
  stop_wait(func, via, sibling, site),
  supervisor_site_or_empty(sup, sup_site).

teardown_touches_sibling(mod, sibling, "terminate", "call_restart", via, sup, func, site, sup_site) :-
  call_to_crashed_sibling(mod, func, via, sibling, sup),
  stop_wait(func, via, sibling, site),
  supervisor_site_or_empty(sup, sup_site).

teardown_touches_sibling(mod, sibling, "terminate", "call_unordered", via, sup, func, site, sup_site) :-
  call_to_sibling_in_unknown_order(mod, func, via, sibling, sup),
  stop_wait(func, via, sibling, site),
  supervisor_site_or_empty(sup, sup_site).

// Anchor at the earliest terminate call toward the sibling wait. With no call
// instruction, use terminate itself unless the anonymous helper's location already
// supplies the anchor.
.decl terminate_path(handler: symbol, via: symbol, call: symbol)
.output terminate_path

.decl terminate_step(handler: symbol, via: symbol, call: symbol)

terminate_step(t, via, call) :-
  teardown_touches_sibling(_, _, "terminate", _, via, _, t, _, _),
  stop_path(t, via, _, _, call),
  call != "".

.decl terminate_stepped(handler: symbol, via: symbol)

terminate_stepped(t, via) :- terminate_step(t, via, _).

terminate_path(t, via, call) :- terminate_step(t, via, call).

terminate_path(t, via, "") :-
  teardown_touches_sibling(_, _, "terminate", _, via, _, t, _, _),
  via != t,
  !closure_in_terminate(t, via),
  !terminate_stepped(t, via).

// The helper is an anonymous function written inside terminate/2
// (`M:-terminate/2-fun-0-/1`): its line is inside terminate/2's source.
.decl closure_in_terminate(handler: symbol, via: symbol)

closure_in_terminate(t, via) :-
  teardown_touches_sibling(_, _, "terminate", _, via, _, t, _, _),
  function_def(t, m, n, a, _),
  contains(cat(m, ":-", n, "/", to_string(a), "-fun-"), via).

// A supervisor the facts place without the instruction that defines its
// tree anchors with an empty site: every rule's `sup` has a row here.
.decl supervisor_site_or_empty(sup: symbol, site: symbol)

supervisor_site_or_empty(sup, site) :- supervisor_site(sup, site).
supervisor_site_or_empty(sup, "") :- sibling(sup, _, _), !supervisor_site(sup, _).
supervisor_site_or_empty(sup, "") :- dynamic_child(sup, _, _), !supervisor_site(sup, _).

// Children placed in another supervision tree
//
// Dynamic children outside the starter's subtree can survive its shutdown and keep
// using stopped services. Check whether terminate explicitly stops them.
.decl foreign_dynamic_children(mod: symbol, sup: symbol, via: symbol, site: symbol, sup_site: symbol)
.output foreign_dynamic_children

// A process starts children onto a supervisor in another tree, and its
// terminate/2 does not stop them: they outlive the process's own tree.
.decl children_left_behind(mod: symbol, sup: symbol, start: symbol)

children_left_behind(mod, sup, start) :-
  starts_children_under(mod, sup, start),
  started_from_outside(start, sup),
  in_another_tree(mod, sup),
  !terminate_stops_children(mod).

// Attribute child starts to the process whose callbacks reach them, including shared
// helpers. Dynamic supervisor pids have no known tree because these arguments are not
// resolved by points-to.
.decl starts_children_under(mod: symbol, sup: symbol, start: symbol)

starts_children_under(mod, sup, start) :-
  dynamic_child(sup, _, start),
  sup != "dynamic",
  starter_process(mod, start).

// An entry of `mod`'s process (process_entry) reaches `start`
// (reaches_child_start, clientlib/supervision.dl).
.decl starter_process(mod: symbol, start: symbol)

starter_process(mod, s) :- process_entry(mod, c), reaches_child_start(c, s).

// Require a start function outside the supervisor's module. Its own start API may
// intentionally offer shared child ownership to callers.
.decl started_from_outside(start: symbol, sup: symbol)

started_from_outside(start, sup) :-
  dynamic_child(sup, _, start),
  function_def(start, m, _, _, _),
  m != sup.

// `sup` sits in a tree `mod` is no member of. A supervisor named through
// a registry (`Oban.Registry.via(Foreman)`) is no tree member.
.decl in_another_tree(mod: symbol, sup: symbol)

in_another_tree(mod, sup) :-
  starts_children_under(mod, sup, _),
  mod != sup,
  tree_member(root, sup),
  !tree_member(root, mod).

// A tree's members by module, and by the registered name a child spec
// gave them (`{DynamicSupervisor, name: Pool}` is a child named Pool).
.decl tree_member(root: symbol, member: symbol)

tree_member(root, mod) :- child_subtree(root, _, mod).
tree_member(root, name) :- supervisor_child_name(root, _, name).

tree_member(root, name) :-
  child_subtree(root, _, mid),
  supervisor_child_name(mid, _, name).

// Any reachable supervisor stop or child termination suppresses the finding, even if
// its target is unknown.
.decl terminate_stops_children(mod: symbol)

terminate_stops_children(mod) :-
  terminate_callback(func, mod, _),
  (via = func ; teardown_reach.reaches(func, via, _)),
  sup_management_call(_, via, _, op, _),
  stopping_sup_op(op).

// What terminate/2 reaches within three calls, whatever its reason.
.init teardown_reach = ForwardBoundedCallReach

teardown_reach.root(func, func) :- terminate_callback(func, _, _).
teardown_reach.limit(3).

foreign_dynamic_children(mod, sup, start, site, sup_site) :-
  children_left_behind(mod, sup, start),
  dynamic_start_site_or_empty(start, site),
  supervisor_site_or_empty(sup, sup_site).

// The DynamicSupervisor.start_child call in `func`.
.decl dynamic_start_site(func: symbol, id: symbol)

dynamic_start_site(f, id) :- call_site(id, f, "DynamicSupervisor", "start_child", _).

// A start with no DynamicSupervisor.start_child instruction (a
// Task.Supervisor start) anchors at its function, the site empty.
.decl dynamic_start_site_or_empty(func: symbol, site: symbol)

dynamic_start_site_or_empty(f, id) :- dynamic_start_site(f, id).
dynamic_start_site_or_empty(f, "") :- dynamic_child(_, _, f), !dynamic_start_site(f, _).

// Handlers stopping supervised siblings
//
// A stop can trigger a permanent sibling's restart or fail with noproc if supervision
// already stopped it. terminate-path calls are checked separately.

// A handler stops a sibling the supervisor owns: the supervisor restarts
// it, or has stopped it already and the stop exits in the handler.
.decl stop_of_owned_sibling(mod: symbol, handler: symbol, via: symbol, sibling: symbol, sup: symbol)

stop_of_owned_sibling(mod, handler, via, sibling, sup) :-
  handler_function(mod, handler),
  stops_process_of(handler, via, sibling),
  sibling(sup, mod, sibling).

// `handler` reaches a stop of mod's process through GenServer.stop or mod's API.
// Exclude calls whose targets are all privately owned (private_stop).
.decl stops_process_of(handler: symbol, via: symbol, mod: symbol)

stops_process_of(h, via, m) :-
  handler_function(_, h),
  stop_reach.reaches(h, via),
  stops_process(via, m).

stops_process_of(h, via, m) :-
  handler_function(_, h),
  stop_reach.reaches(h, via),
  function_def(via, m, _, _, _),
  !private_stop(h, via, m).

// `func` stops a process with GenServer.stop, `target` the module it
// names.
.decl stops_process(func: symbol, target: symbol)

stops_process(f, target) :- sup_call(_, f, "GenServer", "stop", target).

// What reaches a function that stops a process.
.init stop_reach = CallReach

stop_reach.seed(f, f) :- stops_process(f, _).

teardown_touches_sibling(mod, sib, "handler", "stop", via, sup, h, site, sup_site) :-
  stop_of_owned_sibling(mod, h, via, sib, sup),
  site_or_empty_call(h, via, site),
  supervisor_site_or_empty(sup, sup_site).

// The call in `h` toward `via`, when h calls it directly.
.decl site_or_empty_call(func: symbol, callee: symbol, site: symbol)

site_or_empty_call(f, g, id) :- call_instr(f, g, id).
site_or_empty_call(f, g, "") :- stop_reach.reaches(f, g), !call_instr(f, g, _).

// A process `handler` hands `via` as its first parameter (points-to).
.decl stop_arg(handler: symbol, via: symbol, proc: symbol)

stop_arg(h, via, p) :-
  handler_function(_, h),
  pid_arg(_, h, via, "0", "call", sk, s),
  source_process(h, sk, s, p).

// Every process of sib's that `handler` hands `via` is one a function
// keeps for itself (private_process), and there is one.
.decl private_stop(handler: symbol, via: symbol, sib: symbol)

private_stop(h, via, sib) :-
  stop_arg(h, via, p),
  server_process(p, sib),
  private_process(p, _, _),
  !shared_stop(h, via, sib).

// A process of sib's that `handler` hands `via` is one no function keeps
// for itself.
.decl shared_stop(handler: symbol, via: symbol, sib: symbol)

shared_stop(h, via, sib) :-
  stop_arg(h, via, p),
  server_process(p, sib),
  !private_process(p, _, _).

// Unhandled trapped exits
//
// `kind` distinguishes no handle_info, no :EXIT clause, and no matching receive in a
// manual loop. `witness` sets trap_exit; builders deduplicate by module and kind.
.decl unhandled_exit_signal(mod: symbol, kind: symbol, witness: symbol)
.output unhandled_exit_signal

// A trapping server defines no handle_info for EXIT messages. This heuristic counts any
// handle_info arity as a handler.
.decl exit_without_handler(mod: symbol, trap: symbol)

exit_without_handler(mod, trap) :-
  module_traps(trap, mod),
  hands_exits_to_handle_info(mod),
  !has_handle_info(mod).

// Behaviours delivering trapped exits to handle_info/2, as classified by
// `gen_server_like`. Other frameworks use their own callbacks or hidden receives;
// gen_statem uses state functions or handle_event/4 and must not be checked for
// handle_info.
.decl hands_exits_to_handle_info(mod: symbol) inline

hands_exits_to_handle_info(mod) :- gen_server_like(mod).

unhandled_exit_signal(mod, "no_handler", trap) :-
  exit_without_handler(mod, trap).

// Partial handle_info without an exit clause
//
// A trapping server with neither an :EXIT match nor catch-all crashes on trapped exits.
// `callback_tag` counts any atom comparison, so unrelated :EXIT mentions can suppress
// the finding. `trap_exit_without_exit_clause` excludes gen_statem.
unhandled_exit_signal(mod, "no_exit_clause", trap) :-
  trap_exit_without_exit_clause(mod, trap).

// Manual loops ignoring trapped exits
//
// For processes outside behaviours, check all reachable receives for :EXIT or an
// unrestricted tag. Unmatched exits remain queued, repeatedly scanned, and may leave
// parent shutdown unanswered.

// A process no behaviour runs traps exits, and none of the receives its
// loop runs can take the {:EXIT, ...}.
.decl exit_without_receive(mod: symbol, trap: symbol)

exit_without_receive(mod, trap) :-
  traps_in_own_loop(mod, trap),
  trap_loop_receives(trap),
  !trap_loop_takes_exit(trap),
  !trap_loop_hides_receives(trap).

// The trap at `trap`, a function of `mod`'s, is one no behaviour's loop
// answers (trap_loop_candidate).
.decl traps_in_own_loop(mod: symbol, trap: symbol) inline

traps_in_own_loop(mod, trap) :-
  trap_loop_candidate(trap),
  function_def(trap, mod, _, _, _).

// A trap outside behaviour-managed process stacks, including manual spawn/proc_lib
// loops. Exclude gen_statem; its mailbox is handled through state callbacks.
.decl trap_loop_candidate(func: symbol)

trap_loop_candidate(func) :-
  trap_exit(_, func, mod),
  !trap_on_process_stack(func),
  !statem_process(mod).

// Find loops reached on the same stack after trapping setup, including loops in spawned
// entry functions.
.init trap_loop_caller = SameProcessReach

trap_loop_caller.seed(f, f) :- trap_loop_candidate(f).

.init trap_loop = ForwardSameProcessReachCut

trap_loop.cut(f, g) :- side_call(f, g).
trap_loop.root(f, f) :- trap_loop_candidate(f).

trap_loop.root(f, r) :-
  trap_loop_candidate(f),
  trap_loop_caller.reaches(r, f),
  process_start(_, _, _, "spawn", r).

// The loop runs a receive. One that runs none (grpc's Mint adapter traps
// for its caller) is not asked.
.decl trap_loop_receives(trap: symbol)

trap_loop_receives(f) :- trap_loop.reaches(f, g), recv_start(_, g, _, _).

// Some receive the loop runs can take an {:EXIT, ...} (recv_takes_exit).
.decl trap_loop_takes_exit(trap: symbol)

trap_loop_takes_exit(f) :- trap_loop.reaches(f, g), recv_takes_exit(_, g).

// The loop runs code whose receives are not the program's to read
// (hides_receives, clientlib/receive.dl).
.decl trap_loop_hides_receives(trap: symbol)

trap_loop_hides_receives(f) :- trap_loop.reaches(f, g), hides_receives(g).

unhandled_exit_signal(mod, "no_receive_clause", trap) :-
  exit_without_receive(mod, trap).

// ══ Teardown that hurts a monitored child ═══════════════════════════

// Stopping a monitored child
//
// A server stops a pid while retaining its monitor. The resulting :DOWN can enter
// crash-recovery logic and undo the deliberate stop. Require no release of that monitor
// on the path to the kill.
.decl kills_monitored_child(mod: symbol, site: symbol, kill_site: symbol)
.output kills_monitored_child

// The server stops a monitored process without releasing its monitor. The resulting
// DOWN reaches the handler intended for unexpected crashes.
.decl kill_of_monitored_child(mod: symbol, monitor: symbol, kill: symbol)

kill_of_monitored_child(mod, monitor, kill) :-
  server_monitors(mod, monitor),
  server_kills(mod, kill),
  kills_what_it_monitors(monitor, kill),
  !released_with_kill(kill).

// The monitor belongs to the server's stack. Monitors created in detached tasks or
// spawns belong to those processes instead.
.decl server_monitors(mod: symbol, monitor: symbol)

server_monitors(mod, monitor) :- server_side(mod, f), monitor_call(monitor, f, _).

// The server causes the stop, directly or through a spawned process. DOWN still goes to
// the server that owns the monitor.
.decl server_kills(mod: symbol, kill: symbol)

server_kills(mod, kill) :- server_caused(mod, g), kill_call(kill, g).

// A stop of a process: a supervisor's terminate_child, GenServer.stop.
.decl kill_call(site: symbol, func: symbol)

kill_call(x, g) :- sup_call(x, g, _, "terminate_child", _).
kill_call(x, g) :- remote_call(x, g, "GenServer", "stop", _).

// Pair a kill with a monitor when their targets overlap or either is unresolved.
// Distinct resolved processes do not qualify.
.decl kills_what_it_monitors(monitor: symbol, kill: symbol)

kills_what_it_monitors(m, k) :-
  signal_target(m, _, "monitor", p),
  signal_target(k, _, "stop", p).

kills_what_it_monitors(m, k) :-
  monitor_call(m, f, _),
  kill_call(k, _),
  !signal_target(m, f, "monitor", _).

kills_what_it_monitors(m, k) :-
  monitor_call(m, _, _),
  kill_call(k, g),
  !signal_target(k, g, "stop", _).

// A demonitor in the kill's function, a caller, or a callee can release the monitor on
// that path. Unrelated callbacks do not qualify.
.decl released_with_kill(kill: symbol)

released_with_kill(k) :- kill_call(k, g), demonitor_call(_, g, _).
released_with_kill(k) :- kill_call(k, g), call_edge(c, g), demonitor_call(_, c, _).
released_with_kill(k) :- kill_call(k, g), call_edge(g, h), demonitor_call(_, h, _).

kills_monitored_child(mod, site, kill_site) :-
  kill_of_monitored_child(mod, site, kill_site).

// ══ A permanent child that stops itself ═════════════════════════════

// Permanent children stopping normally
//
// A permanent child restarts even after :normal or :shutdown, potentially undoing
// intentional drain-and-stop behavior. Check literal stop reasons only; emit per stop
// site and deduplicate by supervisor and child.
.decl permanent_child_stops_normally(sup: symbol, child: symbol, reason: symbol, site: symbol, sup_site: symbol)
.output permanent_child_stops_normally

// A permanent child stops itself with :normal or :shutdown, and its
// supervisor starts it straight back.
.decl normal_stop_of_permanent_child(sup: symbol, child: symbol, reason: symbol, stop: symbol)

normal_stop_of_permanent_child(sup, child, reason, stop) :-
  restarts_always(sup, child),
  stops_itself(child, stop, reason),
  normal_reason(reason).

// sup restarts `child` whatever its exit reason: it runs under :permanent
// (restart_policy: its spec's, or a shorthand's own child_spec/1's).
.decl restarts_always(sup: symbol, child: symbol)

restarts_always(sup, child) :-
  supervisor(sup, _),
  restart_policy(sup, child, "permanent").

// A runtime callback returns a literal stop reason. Exclude terminate returns and init
// failures: the latter never create a child for supervision to restart.
.decl stops_itself(child: symbol, stop: symbol, reason: symbol)

stops_itself(child, stop, reason) :-
  function_def(func, child, name, _, _),
  name != "terminate",
  !init_function(child, func),
  callback_stop_reason(stop, func, reason).

// A reason a process stops with to go away for good.
.decl normal_reason(reason: symbol)

normal_reason(":normal").
normal_reason(":shutdown").

// A supervisor with no site of its own is not reported.
permanent_child_stops_normally(sup, child, reason, site, sup_site) :-
  normal_stop_of_permanent_child(sup, child, reason, site),
  supervisor_site(sup, sup_site).

// Broadway draining that re-enables fetching
//
// Since Broadway 1.1, demand continues during draining. Clearing the poll-reference
// field can satisfy the fetcher's nil guard and restart fetching before shutdown.
// Report when prepare_for_draining/1 resets a field tested by handle_demand's
// same-module reach, with no other updated literal field acting as a drain guard. Timer
// cancellation is not required: clearing the field alone can enable fetching.
.decl drain_keeps_fetching(mod: symbol, drain: symbol, gate: symbol, key: symbol)
.output drain_keeps_fetching

// Broadway drain clears the field used by fetch, but fetch checks no drain flag.
// Subsequent demand can restart fetching.
.decl fetch_during_drain(mod: symbol, drain: symbol, gate: symbol, key: symbol)

fetch_during_drain(mod, drain, gate, key) :-
  prepares_for_draining(mod, drain),
  clears_field(drain, key),
  fetches_while_nil(mod, gate, key),
  !fetch_takes_drain_flag(mod, drain).

// `drain` is the Broadway producer's prepare_for_draining/1.
.decl prepares_for_draining(mod: symbol, drain: symbol)

prepares_for_draining(mod, drain) :-
  behaves_as(mod, "Broadway.Producer"),
  function_def(drain, mod, "prepare_for_draining", 1, _).

// The drain returns a state with `key` reset to nil (field_reset,
// vocabulary.dl): the value the fetch's clause asks for.
.decl clears_field(drain: symbol, key: symbol) inline

clears_field(drain, key) :- field_reset(drain, key, "nil", _).

// `gate`, which handle_demand/2 reaches in the module, tests `key`
// against nil (field_nil_test): the fetch runs while the field is nil.
.decl fetches_while_nil(mod: symbol, gate: symbol, key: symbol)

fetches_while_nil(mod, gate, key) :-
  demand_reaches(mod, gate),
  field_nil_test(gate, key).

// A function reached by handle_demand/2 checks a literal-valued field set by drain,
// such as draining: true.
.decl fetch_takes_drain_flag(mod: symbol, drain: symbol)

fetch_takes_drain_flag(mod, drain) :-
  prepares_for_draining(mod, drain),
  sets_to_literal(drain, key),
  demand_reaches(mod, g),
  field_value_test(g, key, _).

// The drain returns a state with `key` set to a literal other than nil.
.decl sets_to_literal(drain: symbol, key: symbol) inline

sets_to_literal(drain, key) :-
  returned_update(drain, key, v, _),
  v != "nil",
  v != "dynamic".

// handle_demand/2 of the producer `mod` reaches `func` in the module, in
// its process.
.decl demand_reaches(mod: symbol, func: symbol) inline

demand_reaches(mod, func) :-
  function_def(h, mod, "handle_demand", 2, _),
  demand_reach.reaches(h, func).

.init demand_reach = ForwardIntraModuleSameProcessReach

demand_reach.root(f, f) :-
  behaves_as(m, "Broadway.Producer"),
  function_def(f, m, "handle_demand", 2, _).

drain_keeps_fetching(mod, drain, gate, key) :-
  fetch_during_drain(mod, drain, gate, key).
