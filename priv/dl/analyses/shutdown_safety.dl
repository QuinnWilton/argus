// Cleanup in `terminate/2` that will not run when it matters.
//
// Another contract nobody writes down. Putting cleanup in `terminate/2`
// looks like saying "run this on the way out". OTP's actual rule is
// narrower, and the gap is silent:
//
//   terminate/2 runs when the callback returns {:stop, ...}, or raises.
//
//   On a SUPERVISOR shutdown — which is how processes normally stop, and
//   the case the cleanup was written for — the parent sends an exit
//   signal. A process that is not trapping exits simply dies. terminate/2
//   is never called. Nothing is logged. The buffer is not flushed.
//
// This is documented GenServer behaviour, and it is still one of the most
// reliably-made mistakes on the BEAM, because the code reads correctly and
// the tests pass: a test that calls GenServer.stop/1 exercises the path
// that DOES run terminate, so the one path that matters in production is
// the one never exercised.
//
// The second obligation applies once you are trapping: terminate/2 must
// finish inside the child's shutdown timeout (5000ms by default), or the
// supervisor brutal-kills and the cleanup is truncated anyway. Slow work
// there buys nothing.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
// ── Behaviours with a terminate callback ─────────────────────────

// ── Does the module trap exits? ──────────────────────────────────
//
// Module-granular on purpose. `Process.flag(:trap_exit, true)` is
// overwhelmingly called in init/1, but some modules set it in a helper or
// on a later transition, and requiring it to be in init would produce
// false positives for code that is correct.

.decl traps_exits(mod: symbol)

traps_exits(mod) :- trap_exit(_, mod).

// ── Cleanup worth running ────────────────────────────────────────
//
// WRITES only, and not logging. A terminate/2 that logs "shutting down"
// loses nothing when it is skipped; one that flushes a buffer, releases a
// lease, or tells another system it is going away loses something real.
// Reads are excluded for the same reason they are excluded from
// transaction safety: there is nothing there to lose.

.decl durable_cleanup(category: symbol)

durable_cleanup("io").        // flushing to disk
durable_cleanup("network").   // deregistering, final report, closing a session
durable_cleanup("ets").       // clearing or handing off shared state
durable_cleanup("process").   // telling another process, releasing a name
durable_cleanup("port").      // closing an external resource
durable_cleanup("node").      // leaving a distributed group

.decl cleanup_in_terminate(mod: symbol, behaviour: symbol, category: symbol, api: symbol, via: symbol)

cleanup_in_terminate(mod, behaviour, category, api, func) :-
  terminate_callback(func, mod, behaviour),
  impure_call(_, func, api, category, "write"),
  durable_cleanup(category).

// Bounded, not the full `call_reachable` closure.
//
// Cleanup a module is responsible for sits close to its terminate/2. The
// unbounded closure walks out of the module, through a client library, into
// that library's connection pool, and credits the module with whatever it
// finds: Sequin's MutexOwner was reported for `:ets.insert/2 via
// :wpool_pool:store_wpool/1`, five hops down Mutex.release -> Redis ->
// wpool. The verdict was right and the evidence was noise, which is the
// same "right for the wrong reason" failure that the effect model's
// dispatch precedence was fixed for.
//
// Three hops covers terminate -> your cleanup function -> the API it calls,
// which is the shape real cleanup has.
.decl reaches_from_terminate(func: symbol, via: symbol, depth: number)

reaches_from_terminate(func, callee, 1) :-
  terminate_callback(func, _, _),
  call_edge(func, callee).

reaches_from_terminate(func, callee, depth + 1) :-
  reaches_from_terminate(func, mid, depth),
  depth < 3,
  call_edge(mid, callee).

cleanup_in_terminate(mod, behaviour, category, api, via) :-
  terminate_callback(func, mod, behaviour),
  reaches_from_terminate(func, via, _),
  impure_call(_, via, api, category, "write"),
  durable_cleanup(category).

// ── Findings ─────────────────────────────────────────────────────

// The headline: cleanup that a supervisor shutdown will skip entirely.
.decl cleanup_never_runs(mod: symbol, behaviour: symbol, category: symbol, api: symbol, via: symbol)
.output cleanup_never_runs

cleanup_never_runs(mod, behaviour, category, api, via) :-
  cleanup_in_terminate(mod, behaviour, category, api, via),
  !traps_exits(mod).

// Cleanup the effect model cannot classify — terminate/2 calling into the
// application's own code, which is where most real cleanup lives.
//
// Reported separately and less confidently. The analysis cannot say WHAT
// the work is, only that terminate/2 does something beyond logging and that
// a supervisor shutdown will skip it. That is still the useful half of the
// question: releasing a lease, closing a session and flushing a buffer all
// look like an ordinary call to your own module.
.decl unclassified_cleanup(mod: symbol, behaviour: symbol, api: symbol, via: symbol)

unclassified_cleanup(mod, behaviour, api, func) :-
  terminate_callback(func, mod, behaviour),
  unknown_call(_, func, api, _callee).

unclassified_cleanup(mod, behaviour, api, via) :-
  terminate_callback(func, mod, behaviour),
  reaches_from_terminate(func, via, _),
  unknown_call(_, via, api, _callee),
  !structural_call(api).

// Building a struct or a message is not cleanup. `Kernel` is deliberately
// NOT in the effect model's pure list — purity found a soundness hole there
// — so its calls arrive as unknown, and DBConnection.Connection was reported
// for `Kernel.struct!/2` inside an exception constructor. A soundness choice
// made for one contract should not become noise in another.
.decl structural_call(api: symbol)

structural_call(api) :- unknown_call(_, _, api, _), match("Kernel\\..*", api).
structural_call(api) :- unknown_call(_, _, api, _), match("Access\\..*", api).
structural_call(api) :- unknown_call(_, _, api, _), match("Enum\\..*", api).
structural_call(api) :- unknown_call(_, _, api, _), match("Map\\..*", api).
structural_call(api) :- unknown_call(_, _, api, _), match("Keyword\\..*", api).
structural_call(api) :- unknown_call(_, _, api, _), match(":lists\\..*", api).
structural_call(api) :- unknown_call(_, _, api, _), match(":maps\\..*", api).

.decl cleanup_unclear(mod: symbol, behaviour: symbol, api: symbol, via: symbol)
.output cleanup_unclear

cleanup_unclear(mod, behaviour, api, via) :-
  unclassified_cleanup(mod, behaviour, api, via),
  !traps_exits(mod),
  !cleanup_in_terminate(mod, _, _, _, _).

// Slow work inside terminate, for a module that DOES trap exits — so the
// callback is reached, but may not finish. Network and port calls are the
// ones with no bound of their own.
.decl slow_category(category: symbol)

slow_category("network").
slow_category("port").

.decl terminate_may_be_truncated(mod: symbol, behaviour: symbol, category: symbol, api: symbol, via: symbol)
.output terminate_may_be_truncated

terminate_may_be_truncated(mod, behaviour, category, api, via) :-
  cleanup_in_terminate(mod, behaviour, category, api, via),
  traps_exits(mod),
  slow_category(category).

// ── A synchronous call to a sibling from terminate/2 ─────────────────
//
// A supervisor stops its children in reverse start order, one at a
// time. terminate/2 runs while that is under way, so a sibling under the
// same supervisor may already be gone: the call exits with :noproc and
// terminate/2 itself crashes, taking whatever cleanup followed with it
// (oban#21's Watchman pausing its Producer). Only direct siblings — the
// modules whose lifetime the same supervisor sequences — count.
.decl terminate_calls_sibling(mod: symbol, sibling: symbol, via: symbol, sup: symbol)
.output terminate_calls_sibling

terminate_calls_sibling(mod, sibling, func, sup) :-
  terminate_callback(func, mod, _),
  sync_dep(func, sibling),
  supervisor_child(sup, _, mod, _, _),
  supervisor_child(sup, _, sibling, _, _),
  sibling != mod.

terminate_calls_sibling(mod, sibling, via, sup) :-
  terminate_callback(func, mod, _),
  reaches_from_terminate(func, via, _),
  sync_dep(via, sibling),
  supervisor_child(sup, _, mod, _, _),
  supervisor_child(sup, _, sibling, _, _),
  sibling != mod.

// ── Children started into another tree's supervisor ──────────────────
//
// A process that starts children onto a DynamicSupervisor it does not
// sit under ties their lifetime to that supervisor's tree, not its own.
// When its own tree shuts down, the children stay — reconnecting,
// logging, calling into applications that have already stopped
// (postgrex#763: pool connections under :db_connection's supervisor
// outliving the user's Repo). Unless terminate/2 stops them.
.decl foreign_dynamic_children(mod: symbol, sup: symbol, via: symbol)
.output foreign_dynamic_children

.decl terminate_stops_children(mod: symbol)

terminate_stops_children(mod) :-
  terminate_callback(func, mod, _),
  (via = func ; reaches_from_terminate(func, via, _)),
  sup_call(_, via, _, op, _),
  (op = "terminate_child" ; op = "stop").

// A tree's members by module, and by the registered name a child spec
// gave them (`{DynamicSupervisor, name: Pool}` is a child named Pool).
.decl tree_member(root: symbol, member: symbol)

tree_member(root, mod) :- child_subtree(root, _, mod).
tree_member(root, name) :- supervisor_child_name(root, _, name).

tree_member(root, name) :-
  child_subtree(root, _, mid),
  supervisor_child_name(mid, _, name).

// The starter is the process whose callbacks reach the start — not the
// module the start function happens to live in, which may be a plain
// helper called from several processes (or from a request surface).
.decl reaches_dynamic_start(func: symbol, start: symbol)

reaches_dynamic_start(s, s) :- dynamic_child(_, _, s).
reaches_dynamic_start(f, s) :- call_edge(f, g), reaches_dynamic_start(g, s).
reaches_dynamic_start(f, s) :- closure_def(f, g), reaches_dynamic_start(g, s).

process_entry(mod, f) :- statem_event_clause(mod, f, _).

.decl starter_process(mod: symbol, start: symbol)

starter_process(mod, s) :- process_entry(mod, c), reaches_dynamic_start(c, s).

// A start function that lives in the supervisor's own module
// (`Postgrex.TypeSupervisor.start_server/2`, `DBConnection.Task.run_child/4`)
// is that tree offering a shared service; the children are meant to
// belong to it, whoever asks.
foreign_dynamic_children(mod, sup, func) :-
  dynamic_child(sup, _, func),
  sup != "dynamic",
  !match("via:.*", sup),
  function_def(func, fmod, _, _, _),
  fmod != sup,
  starter_process(mod, func),
  mod != sup,
  tree_member(root, sup),
  !tree_member(root, mod),
  !terminate_stops_children(mod).
