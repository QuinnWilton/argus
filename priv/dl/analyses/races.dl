// Check, then act: a read of shared state decides a write of the same
// thing, and another process can write it between the two (Christakis
// and Sagonas, PADL 2010). Three stores, one shape:
//
// - registry_race: a lookup of a process name decides a start,
//   registration or unregistration of the name;
// - ets_check_act: an ETS read decides or feeds a plain write of the
//   same key on a public table;
// - ets_missing_row: an ETS read decides a row is there and an act that
//   raises without it follows, while another process can remove the row;
// - mnesia_check_act: a dirty read decides or feeds a dirty write of
//   the same record.
//
// And one that is not check-then-act but shares the stores: a value
// published in one ETS table before the row another table keys by it
// exists (ets_publish_order).
//
// Which table an ETS operation touches is clientlib/tables.dl's
// ets_table, the one identity (EtsTable) every rule below compares.
//
// The check-then-act rules are CheckThenAct instances
// (clientlib/check_then_act.dl), which says where a check's result meets
// an act that depends on it, across functions. A pair is a race when a
// rival can land on its row between the check and the act, and what the
// two do to the row together is a harm no serial order leaves: a lost
// update, a clobbered count, a stale fill, a delete of a row made again,
// a claim, a take, a decision that does more (docs/design/races.md).
// Which processes run a function — the pair's, a rival's — is one
// RunsConcurrently instance for all of them, seeded with every meeting
// and every write the rules ask about: what a function's callers are
// does not depend on which store it touches.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/request_entry.dl"
.include "../clientlib/concurrency.dl"
.include "../clientlib/check_then_act.dl"
.include "../clientlib/specs.dl"
.include "../clientlib/tables.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/tooling.dl"
.include "../clientlib/escape.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

.init runs = RunsConcurrently

// ── Lookup, then start ───────────────────────────────────────────
//
// `case whereis(name) do nil -> start(name)` asks whether a name is
// taken and claims it when the answer is no, and nothing holds the name
// between the two: a second caller that asks in the same window gets
// the same answer, and one of the two starts loses. Christakis and
// Sagonas found this shape on the process registry in 2010 and Dialyzer
// reported it until OTP 25; the Elixir spellings are Registry.lookup
// before start_child, and whereis before register or a named start.
// Deciding on Process.registered/0 is the same race on every name at
// once, and Dialyzer's second registry warning was the release: whereis,
// then unregister, which raises when the process exited or another
// caller unregistered first.
//
// The lookup and the act may sit in different functions and meet where
// the lookup's result is born or returned to (clientlib/check_then_act.dl).
// They name the same thing when they agree on registry, source and key; a
// start_child hides its name in the child spec, so any lookup that is
// tested against nil and decides it counts. The race is not a bug when
// the loser's outcome is taken — {:error, {:already_started, pid}}
// compared where the pair meets, where the act is, or in a caller; an
// ArgumentError from register/2 or unregister/1 rescued — or when only
// one process ever runs the function where they meet.

.init names = CheckThenAct

// A lookup finds a name free and decides a claim of it, another process
// can claim the name in between, and nothing takes the loser's outcome.
// `func` is where the lookup's answer meets the claim.
.decl lookup_then_claim_race(func: symbol, lookup: symbol, claim: symbol, name: ProcessName)

lookup_then_claim_race(func, lookup, claim, name) :-
  decides_claim(func, lookup, claim, name),
  claimed_by_another_process(claim, func),
  !loser_taken(func, claim),
  !loser_dropped(func, claim).

// A name as the lookup and the claim agree on it: its key, and where the
// key comes from (a literal, the caller's argument, ...).
.type ProcessName = [key_source: symbol, key: symbol]

// In `func`, whether the lookup finds the name free decides the claim of
// it (CheckThenAct's meets, followed across calls). A start_child hides
// its name in the child spec, so for it only a lookup whose answer is
// tested against nil counts.
.decl decides_claim(func: symbol, lookup: symbol, claim: symbol, name: ProcessName)

decides_claim(f, c, a, [ks, k]) :-
  names.meets(f, c, a, _, _, ks, k),
  name_act(a, _, api),
  api != "start_child".

decides_claim(f, c, a, [ks, k]) :-
  names.meets(f, c, a, _, _, ks, k),
  name_lookup(c, _, _, _, _, _, "checked").

// The resource is the registry: the local one (empty) or a Registry.
names.check(c, f, "literal", scope, ks, k) :-
  name_lookup(c, f, _, scope, ks, k, _),
  scope != "dynamic".

names.check(c, f, "dynamic", "", ks, k) :- name_lookup(c, f, _, "dynamic", ks, k, _).

names.act(a, f, "any", "", "any", "") :- creating_op(a, f, "start_child", _, _, _).

names.act(a, f, "literal", scope, ks, k) :-
  creating_op(a, f, api, scope, ks, k),
  api != "start_child",
  scope != "dynamic".

names.act(a, f, "dynamic", "", ks, k) :-
  creating_op(a, f, api, "dynamic", ks, k),
  api != "start_child".

names.act(a, f, "literal", "", ks, k) :- name_release(a, f, _, ks, k).

.decl name_act(act: symbol, func: symbol, api: symbol)

name_act(a, f, api) :- creating_op(a, f, api, _, _, _).
name_act(a, f, api) :- name_release(a, f, api, _, _).

// A loser is handled where its start's error is compared, or its :badarg
// rescued (rescues_argument_error, in exceptions.dl: `case catch
// register(N, self()) of true -> ...; _ -> exit({already_started, ...})`
// in inet_gethost_native), here or in a function its result returns to.
.decl start_error_handled(func: symbol)

start_error_handled(f) :- start_error_compared(f, _).
start_error_handled(f) :- call_edge(g, f), start_error_compared(g, _).
start_error_handled(f) :- rescues_argument_error(f).
start_error_handled(f) :- returns_call(g, f), start_error_handled(g).

// The loser's outcome is taken where the pair meets or where the act is.
.decl loser_taken(meet: symbol, act: symbol)

loser_taken(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, g, api),
  api != "unregister",
  (start_error_handled(f) ; start_error_handled(g)).

loser_taken(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, g, "unregister"),
  (rescues_argument_error(f) ; rescues_argument_error(g)).

// The loser's answer is a value — the start's spec can fail:
// {:error, {:already_started, pid}} — and nothing reads it on its way
// back to where the lookup decided: the start's result is not used
// where it is made, and every function that returns it on is one whose
// result nothing in the program uses, the meeting function not among
// them. Whichever start won, the name is registered, and what follows
// goes by the name (ssh_dbg:switch/2 → start/1, which drops
// start_server/0's gen_server:start). Only a named start: a start_child
// hides its name in the child spec, and an unnamed child's "loser" is a
// second process; a Registry.register loser is a process left
// unregistered. A start that raises for the loser (register/2,
// start_supervised!) is not this shape either.
.decl act_callee(act: symbol, callee: symbol)

act_callee(a, cat(m, ":", n, "/", to_string(ar))) :-
  name_act(a, _, _),
  remote_call(a, _, m, n, ar).

.decl act_result_read(act: symbol)

act_result_read(a) :- name_act(a, _, _), site_depends(_, _, "site", a).
act_result_read(a) :- name_act(a, _, _), call_decided(_, _, "site", a).
act_result_read(a) :- name_act(a, _, _), call_arg_depends(_, _, _, "site", a).

.decl act_returned_by(act: symbol, func: symbol)

act_returned_by(a, g) :- name_act(a, _, _), returns_depends(g, "site", a).
act_returned_by(a, h) :- act_returned_by(a, g), returns_depends(h, "call", g).

.decl result_used(func: symbol)

result_used(g) :- act_returned_by(_, g), site_depends(_, _, "call", g).
result_used(g) :- act_returned_by(_, g), call_decided(_, _, "call", g).
result_used(g) :- act_returned_by(_, g), call_arg_depends(_, _, _, "call", g).

// A named start's loser answer is dropped on its way back to the
// meeting function, and the program goes on by the name (above).
.decl loser_dropped(meet: symbol, act: symbol)

loser_dropped(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, _, api),
  (api = "start" ; api = "start_link" ; api = "start_via"),
  act_callee(a, callee),
  callee_returns(callee, "can_fail"),
  !act_result_read(a),
  !act_returned_by(a, f),
  !returned_and_used(a).

.decl returned_and_used(act: symbol)

returned_and_used(a) :- act_returned_by(a, g), result_used(g).

runs.seed(f) :- names.meets(f, _, _, _, _, _, _).

// ── Who else can claim the name ──
//
// The race needs a second claimant in the window: the function where the
// pair meets runs in more than one process, so two of its callers can
// both see the name free; or it runs in one, and another process claims
// the same name — two servers that each start the same cache on first
// use, each with its own copy of the check. A claim of the same name is
// a start, registration or unregistration naming it as a literal, in the
// same registry, where it is made or where a caller hands a claiming
// helper the literal.
.decl claims_name(act: symbol, func: symbol, scope: symbol, key: symbol)

claims_name(a, g, scope, k) :- creating_op(a, g, api, scope, "literal", k), api != "start_child".
claims_name(a, g, "", k) :- name_release(a, g, _, "literal", k).

claims_name(a, g, scope, k) :-
  creating_op(a, h, api, scope, "param", q),
  api != "start_child",
  call_arg(g, h, n, k),
  k != "dynamic",
  q = to_string(n).

runs.seed(g) :- claims_name(_, g, _, _).

.decl pair_scope(func: symbol, act: symbol, scope: symbol)

pair_scope(f, a, scope) :- names.meets(f, _, a, "literal", scope, _, _).

// Another process claims the pair's name while the pair's own process is
// between its lookup and its act.
.decl other_claimant(func: symbol, act: symbol)

other_claimant(f, a) :-
  names.meets(f, _, a, _, _, "literal", k),
  pair_scope(f, a, scope),
  claims_name(a2, g, scope, k),
  a2 != a,
  runs.beside_single_process(f, g).

// Another process can claim the name while `func` is between the lookup
// and the claim: `func` runs in more than one process, so two of its
// callers can both see the name free, or another process claims the
// same literal name (other_claimant).
.decl claimed_by_another_process(claim: symbol, func: symbol)

claimed_by_another_process(a, f) :- names.meets(f, _, a, _, _, _, _), !runs.single_process(f).
claimed_by_another_process(a, f) :- other_claimant(f, a).

.decl registry_race(mod: symbol, func: symbol, lookup_api: symbol, create_api: symbol, key_source: symbol, key: symbol, check: symbol, act: symbol)
.output registry_race

registry_race(mod, func, lookup_api, create_api, key_source, key, lookup, claim) :-
  lookup_then_claim_race(func, lookup, claim, [key_source, key]),
  name_lookup(lookup, _, lookup_api, _, _, _, _),
  name_act(claim, _, create_api),
  function_def(func, mod, _, _, _).

// ── Read, then write ─────────────────────────────────────────────
//
// `case :ets.lookup(t, k) do [] -> :ets.insert(t, {k, v})` decides on a
// row that another process can write between the read and the write
// (Christakis and Sagonas, 2010, on ETS). The pair touches one key of a
// public table — a protected table has one writer — and is a race when a
// rival write can land on that row between the two (below: the pair
// itself in a second process, or another write in a process other than
// the pair's) and the harm it leaves has a witness (below). A cache that
// serializes its read-then-write in its own process is not raced by an
// exported clear/0 no caller in the program calls, when the program
// calls the cache's other functions. insert_new, update_counter and
// select_replace are the atomic forms and the fix.
//
// The read and the write may sit in different functions
// (clientlib/check_then_act.dl), and the table may arrive as a
// parameter: by name, or as the reference :ets.new returned in some
// caller — the paper's own example builds an unnamed public table and
// hands it to a closure that spawned processes run — or from the
// program's users, when no caller in view fills it.

.init rows = CheckThenAct

.decl deciding_read_op(op: symbol)

deciding_read_op("lookup").
deciding_read_op("lookup_element").
deciding_read_op("member").

// A match on the key decides as a lookup does. A select's match spec
// nests its head in a list, and is left out: its key is not extracted,
// as a dynamic key is not.
deciding_read_op("match").
deciding_read_op("match_object").

.decl plain_write_op(op: symbol)

plain_write_op("insert").
plain_write_op("delete").
plain_write_op("delete_object").
plain_write_op("update_element").

// The table in the operation's own function's terms: the parameter it
// is handed, which CheckThenAct renames at each call, so a helper called
// with two tables pairs each call's own; or else the tables it may touch
// (clientlib/tables.dl), each as its kind's source (table_source).
.decl ets_table_ident(id: symbol, ts: symbol, t: symbol)

ets_table_ident(id, "param", to_string(p)) :- ets_op(id, _, "dynamic", _, _), ets_op_param(id, p).

ets_table_ident(id, ts, t) :-
  ets_op(id, _, _, _, _),
  !handed_table(id),
  ets_table(id, k, t),
  table_source(k, ts).

.decl handed_table(id: symbol)

handed_table(id) :- ets_op(id, _, "dynamic", _, _), ets_op_param(id, _).

rows.check(read, func, table_kind, table, key_kind, key) :-
  deciding_read(read, func),
  local_table_and_key(read, table_kind, table, key_kind, key).

rows.act(write, func, table_kind, table, key_kind, key) :-
  plain_write(write, func),
  local_table_and_key(write, table_kind, table, key_kind, key).

// A read whose answer a caller can decide on, and a write that is not
// one of the atomic forms.
.decl deciding_read(read: symbol, func: symbol) inline
.decl plain_write(write: symbol, func: symbol) inline

deciding_read(r, f) :- ets_op(r, f, _, op, "read"), deciding_read_op(op).
plain_write(w, f) :- ets_op(w, f, _, op, "write"), plain_write_op(op).

// An operation's table and key, the table in its own function's terms
// (ets_table_ident) or as clientlib/tables.dl knows it (ets_table).
.decl local_table_and_key(op: symbol, table_kind: symbol, table: symbol, key_kind: symbol, key: symbol) inline
.decl table_and_key(op: symbol, table_kind: symbol, table: symbol, key_kind: symbol, key: symbol) inline

local_table_and_key(op, ts, t, ks, k) :- ets_table_ident(op, ts, t), op_key(op, ks, k).
table_and_key(op, tk, t, ks, k) :- ets_table(op, tk, t), op_key(op, ks, k).

// An operation's key. The extractor takes an inserted object's key from
// its first element (ets_key); on a table made with `keypos: N`, N > 1 —
// an Erlang or Elixir record's, keyed past the record's tag — it is
// element N - 1 (ets_value).
.decl op_key(op: symbol, key_kind: symbol, key: symbol)

op_key(op, ks, k) :- ets_key(op, ks, k), !keyed_past_zero(op, _).

op_key(op, ks, k) :-
  keyed_past_zero(op, v),
  ets_value(op, pos, ks, k),
  to_string(pos + 1) = v.

.decl keyed_past_zero(op: symbol, keypos: symbol)

keyed_past_zero(op, v) :-
  ets_op(op, _, _, o, "write"),
  (o = "insert" ; o = "insert_new"),
  ets_table(op, tk, t),
  site_table(n, tk, t),
  ets_option(n, "keypos", v),
  v != "1".

// ── A pair through an accessor ──
//
// A function whose body is one ETS operation on a named table, and no
// other shared-state operation — mnesia_lib:set/2 is `?ets_insert(
// mnesia_gvar, {Var, Val})`, read_counter/1 one lookup_element — is an
// accessor: its operation is its callers', made at the call. A pair with
// an accessor's operation is reported where the meeting function calls
// the accessor; when it reaches the accessor only through other calls,
// the pair stands all the same and is reported at the operation itself.
// A key an accessor is handed is a key like any other: `put(:count,
// get(:count) + 1)`, or the same through `count/0` and `set_count/1`
// that name the row themselves, is the read-modify-write it would be
// written inline, and is judged as one (below). What keeps mnesia_lib's
// `val(mnesia_status)` in one helper and `set(mnesia_status, stopping)`
// in another quiet is that the write stores a constant no racer read,
// which no other writer of that row makes stale: the witnesses, not the
// accessor.
.decl ets_accessor(func: symbol, op: symbol, key_kind: symbol)

ets_accessor(g, w, "param") :- lone_ets_op(g, w), op_key(w, ks, _), ks != "literal", ks != "dynamic".
ets_accessor(g, w, "fixed") :- lone_ets_op(g, w), op_key(w, "literal", _).

.decl lone_ets_op(func: symbol, op: symbol)

lone_ets_op(g, w) :-
  ets_op(w, g, name, _, _),
  name != "dynamic",
  count : { ets_op(_, g, _, _, _) } = 1,
  !other_shared_op(g).

.decl other_shared_op(func: symbol)

other_shared_op(g) :- mnesia_op(_, g, _, _, _, _, _, _).
other_shared_op(g) :- name_lookup(_, g, _, _, _, _, _).
other_shared_op(g) :- creating_op(_, g, _, _, _, _).
other_shared_op(g) :- name_release(_, g, _, _, _).

// Where `func` calls the accessor holding `op`: the site a lifted
// operation is reported at.
.decl accessor_call(func: symbol, op: symbol, site: symbol)

accessor_call(f, w, c) :-
  rows.meets(f, _, w, _, _, _, _),
  ets_accessor(g, w, _),
  g != f,
  function_def(g, m, n, a, _),
  call_site(c, f, m, n, a).

accessor_call(f, r, c) :-
  rows.meets(f, r, _, _, _, _, _),
  ets_accessor(g, r, _),
  g != f,
  function_def(g, m, n, a, _),
  call_site(c, f, m, n, a).

// The site a pair's operation is reported at in the function where it
// meets: the operation, or the call to the accessor holding it.
.decl reported_at(func: symbol, op: symbol, site: symbol)

reported_at(f, op, c) :- accessor_call(f, op, c).
reported_at(f, op, op) :- rows.meets(f, op, _, _, _, _, _), !accessor_call(f, op, _).
reported_at(f, op, op) :- rows.meets(f, _, op, _, _, _, _), !accessor_call(f, op, _).

// In `func`, the read's result decides whether the write runs, or feeds
// what it stores, on one row (CheckThenAct's meets, followed across
// calls). The row's table is the one identity (EtsTable,
// clientlib/tables.dl) of what the pair meets on in func: a table named
// the same in every function, or func's parameter, which holds what its
// callers pass (param_table: a name, a reference made in a caller, or
// the table the program's users hand in, below).
.decl decides_write(func: symbol, read: symbol, write: symbol, row: EtsRow)

decides_write(f, r, w, [table, ks, k]) :-
  rows.meets(f, r, w, ts, t, ks, k),
  table_in(f, ts, t, table).

// The table a pair meets on in `func`, from how func's terms name it.
.decl table_in(func: symbol, source: symbol, ident: symbol, table: EtsTable)

table_in(f, ts, t, [k, t]) :- rows.meets(f, _, _, ts, t, _, _), table_source(k, ts).
table_in(f, "param", p, [k, t]) :- rows.meets(f, _, _, "param", p, _, _), param_table(f, p, k, t).

// The same pairs, by the table and the key alone: what the rivals and
// the harms below are asked of.
.decl reads_then_writes(func: symbol, read: symbol, write: symbol, table: EtsTable, key: symbol)

reads_then_writes(f, r, w, table, k) :- decides_write(f, r, w, [table, _, k]).

// ── A table the program's users hand in ──
//
// A parameter no caller in view fills — every call passes on a parameter
// of its own, up to an exported function of a module the rest of the
// program does not call into — holds whatever table the program's users
// pass: Hammer's `hit(table, key, ...)`, which `use Hammer` calls with
// the user's own table (clientlib/tables.dl's "handed_in" table, named
// by that way in and its parameter). Where it was made, and with which
// options, is out of view; what is in view is that the function writes
// it from every caller's process, which a protected or private table
// refuses in all but its owner's. A function more than one process runs
// is reported on it as on a public table (ets_check_act); one process's
// is not, since the only other writers of a table nothing names are the
// functions its way in forwards it to.

runs.seed(f) :- reads_then_writes(f, _, _, _, _).

// ── What can land between the read and the write ───────────────────
//
// A pair is a race when a write can land on its row between the read and
// the write — a rival — and what the rival and the pair's write do to
// the row together cannot happen one after the other: a harm (the next
// section). A rival is
//
// - the pair itself, run by a second process: the function where the
//   pair meets runs in more than one process (RunsConcurrently); or
// - another write of the table at a key that can be the pair's, in a
//   function that runs, after its process has started, in a process
//   other than the pair's (runs_beside_up): another entry's once it is
//   up, a request's, a caller's outside the program, or any at all when
//   the pair's own function runs in more than one.
//
// A write is seen where its key is named. A write whose key is its
// function's parameter is its callers' write, at the key each passes:
// `set(:count, n)` writes the `:count` row wherever it is called, and
// mnesia_lib's set/2, called with a hundred keys, is a hundred writes,
// each at its own row, each in the process of the function that names
// it. Only a function callers outside the program call writes "whatever
// key they pass". A write that mints its key where it makes the row
// (a reference, a monitor, a unique integer or a random value) makes a
// row no one could have read before: it is no rival of any pair.
.decl rival_table(table: EtsTable)

rival_table(table) :- reads_then_writes(_, _, _, table, _).

// The tables a write or a counter bump may touch (clientlib/tables.dl).
.decl ets_op_table(id: symbol, table: EtsTable)

ets_op_table(id, [k, t]) :- ets_table(id, k, t), ets_op(id, _, _, _, _).

// A write of a table some pair touches, in the function holding it.
.decl table_write(write: symbol, func: symbol, table: EtsTable)

table_write(w, g, table) :- ets_op(w, g, _, _, "write"), ets_op_table(w, table), rival_table(table).

// The key a write names, made in the write's own function. A key made
// by a call that mints it is "minted": no other key equals it.
.decl write_key(write: symbol, key_kind: symbol, key: symbol)

write_key(w, "minted", w) :- table_write(w, _, _), minted_key(w).
write_key(w, ks, k) :- table_write(w, _, _), op_key(w, ks, k), !minted_key(w).

// A write with no key the extractor names (select_delete, delete_all_
// objects, deleting the table) touches any row.
write_key(w, "any", "") :- table_write(w, _, _), !op_key(w, _, _).

// rival_write(w, h, table, ks, k): calling `h` may make write `w` of
// `table`, at the row h names (ks, k).
.decl rival_write(write: symbol, func: symbol, table: EtsTable, key_kind: symbol, key: symbol)

rival_write(w, g, table, ks, k) :- table_write(w, g, table), write_key(w, ks, k), ks != "param".

// A parameter key, carried up to every caller that fills it.
.decl param_write(write: symbol, func: symbol, table: EtsTable, pos: symbol)

param_write(w, g, table, q) :- table_write(w, g, table), write_key(w, "param", q).

param_write(w, h, table, to_string(p)) :-
  param_write(w, g, table, q),
  call_arg_forward(h, g, n, p),
  q = to_string(n).

rival_write(w, h, table, "literal", v) :-
  param_write(w, g, table, q),
  call_arg(h, g, n, v),
  v != "dynamic",
  q = to_string(n).

// A tuple the caller builds: `add({tab, :where_to_write}, v)`.
rival_write(w, h, table, "tuple", "") :-
  param_write(w, g, table, q),
  call_arg_tuple(h, g, n, _, _, _),
  q = to_string(n).

// Anything else a caller computes is a key the facts cannot name.
rival_write(w, h, table, "dynamic", "") :-
  param_write(w, g, table, q),
  call_arg(h, g, n, "dynamic"),
  q = to_string(n).

rival_write(w, h, table, "element", "") :-
  param_write(w, g, table, q),
  call_arg_element(h, g, n, _, _),
  q = to_string(n).

// A function callers outside the program call writes whatever key they
// pass; so does one whose parameter no call in view fills (a closure
// handed to Enum.each, a function applied or taken as a fun).
rival_write(w, g, table, "param", q) :- param_write(w, g, table, q), outside_entry(g).
rival_write(w, g, table, "param", q) :- param_write(w, g, table, q), !param_filled(g, q).

.decl param_filled(func: symbol, pos: symbol)

param_filled(g, to_string(n)) :- param_write(_, g, _, _), call_arg(_, g, n, _).
param_filled(g, to_string(n)) :- param_write(_, g, _, _), call_arg_forward(_, g, n, _).

// A caller outside the program (RunsConcurrently's outside_caller,
// clientlib/concurrency.dl): an exported function of a module no other
// module of the program calls, that the runtime does not call in a
// process of its own.
.decl outside_entry(func: symbol)

outside_entry(g) :- runs.outside_caller(g).

// Two keys that can never name one row: two different literals; a
// tuple and a literal that is no tuple; a process's own row (self())
// and a literal, or another process's own row; a minted key and any
// other. A literal row and a row keyed by what the program computes are
// taken to be two rows, whichever side is the pair's: a `:__hits__`
// counter or a seeded `{:schema_version, 1}` kept beside the rows callers
// name, mnesia_lib's `mnesia_status` beside the `{Tab, where_to_write}`
// keys its callers build (an assumption: a computed key that happens to
// equal the literal is not seen).
.decl keys_apart(ks: symbol, k: symbol, ks2: symbol, k2: symbol)

keys_apart(ks, k, "literal", k2) :- pair_key(_, _, ks, k), ks = "literal", rival_write(_, _, _, "literal", k2), k != k2.

keys_apart("literal", k, "tuple", k2) :-
  pair_key(_, _, "literal", k),
  !match("[{].*", k),
  rival_write(_, _, _, "tuple", k2).

keys_apart("tuple", k, "literal", k2) :-
  pair_key(_, _, "tuple", k),
  rival_write(_, _, _, "literal", k2),
  !match("[{].*", k2).

keys_apart("literal", k, "self", k2) :- pair_key(_, _, "literal", k), rival_write(_, _, _, "self", k2).
keys_apart("self", k, ks2, k2) :- pair_key(_, _, "self", k), rival_write(_, _, _, ks2, k2), (ks2 = "literal" ; ks2 = "self").
keys_apart(ks, k, "minted", k2) :- pair_key(_, _, ks, k), rival_write(_, _, _, "minted", k2).

keys_apart(ks, k, "literal", k2) :-
  pair_key(_, _, ks, k),
  ks != "literal",
  ks != "any",
  ks != "tuple",
  rival_write(_, _, _, "literal", k2).

keys_apart("literal", k, ks2, k2) :-
  pair_key(_, _, "literal", k),
  rival_write(_, _, _, ks2, k2),
  computed_in_view(ks2).

// A key the program computes where it calls the write: a value made in
// the function (`dynamic`, `local`), read from a map field, or an element
// of a parameter. What a caller outside the program passes, or a
// parameter no call in view fills, is any key.
.decl computed_in_view(key_kind: symbol)

computed_in_view("dynamic").
computed_in_view("local").
computed_in_view("field").
computed_in_view("element").
computed_in_view(ks) :- rival_write(_, _, _, ks, _), match("element [0-9]+", ks).

// The key a pair meets on, in the meeting function's terms, and the
// table it is on.
.decl pair_key(func: symbol, table: EtsTable, key_kind: symbol, key: symbol)

pair_key(f, table, ks, k) :- decides_write(f, _, _, [table, ks, k]).

.decl pair_key_of(func: symbol, read: symbol, write: symbol, key_kind: symbol, key: symbol)

pair_key_of(f, r, w, ks, k) :- reads_then_writes(f, r, w, _, _), rows.meets(f, r, w, _, _, ks, k).

runs.seed(h) :- rival_write(_, h, _, _, _).

// A function that runs once its process is up: reached from a root that
// is no start callback — another callback, a spawned process's body, a
// request, a caller outside the program. A write only an init/1 or an
// Application's start/2 makes runs while its own process starts, which
// an ordered supervisor start runs before it starts the pair's process
// (an assumption: a later sibling's init/1, or a restart of the writer
// alone, re-runs it while the pair runs, and is not seen).
.init writer_walk = SameProcessReach

writer_walk.seed(h, h) :- rival_write(_, h, _, _, _).

.decl writes_after_start(func: symbol)

writes_after_start(g) :- process_entry(_, c), writer_walk.reaches(c, g), !startup_callback(c).
writes_after_start(g) :- outside_entry(c), writer_walk.reaches(c, g).
writes_after_start(g) :- request_entry(e, _), writer_walk.reaches(e, g).
writes_after_start(g) :- runs.spawned(_, _, r), writer_walk.reaches(r, g).

// The write w2, made by calling `h`, can land while the pair in `f` is
// between its read and its write: in any process when f runs in more
// than one, else in a process other than the one f runs in, once it is
// up (runs_beside_up, clientlib/concurrency.dl) and not handed off: the
// write is made in its own function, wherever its key is named.
.decl concurrent(func: symbol, rival_func: symbol, rival_write: symbol)

concurrent(f, h, w2) :-
  reads_then_writes(f, _, _, table, _),
  !runs.single_process(f),
  rival_write(w2, h, table, _, _),
  writes_after_start(h).

concurrent(f, h, w2) :-
  reads_then_writes(f, _, _, table, _),
  runs.single_process(f),
  runs.entry_reaches(m, f),
  rival_write(w2, h, table, _, _),
  table_write(w2, g, _),
  runs.runs_beside_up(m, f, h, g).

runs.seed(g) :- table_write(_, g, _).

// rival(f, r, w, w2, h): the write w2, made by calling h, can land on
// the row of the pair (r, w) meeting in f, between the read and the
// write. The pair's own write is its rival when f runs in more than one
// process and two of them can be at one row: not a row keyed by the
// process's own pid (each is at its own), nor one only its holder writes
// (below).
.decl rival(func: symbol, read: symbol, write: symbol, rival_write: symbol, rival_func: symbol)

rival(f, r, w, w, f) :-
  reads_then_writes(f, r, w, _, _),
  !runs.single_process(f),
  pair_key_of(f, r, w, ks, _),
  ks != "self",
  !held_row(w).

rival(f, r, w, w2, h) :-
  reads_then_writes(f, r, w, table, _),
  pair_key_of(f, r, w, ks, k),
  rival_write(w2, h, table, ks2, k2),
  w2 != w,
  !keys_apart(ks, k, ks2, k2),
  concurrent(f, h, w2).

// The pair's own write, made at another call: an accessor's insert
// another function hands a key of its own. A function that runs the
// pair's function makes the pair's write as the pair, and so does one
// the pair's function runs when the pair itself runs in more than one
// process: that second process is the rule above. One the pair's
// function runs, in a pair of one process, is a rival where another
// process runs it too (concurrent): set_count/1, called by the owner's
// increment and by a resetter's timer.
rival(f, r, w, w, h) :-
  reads_then_writes(f, r, w, table, _),
  runs.single_process(f),
  pair_key_of(f, r, w, ks, k),
  rival_write(w, h, table, ks2, k2),
  h != f,
  !keys_apart(ks, k, ks2, k2),
  concurrent(f, h, w).

rival(f, r, w, w, h) :-
  reads_then_writes(f, r, w, table, _),
  !runs.single_process(f),
  pair_key_of(f, r, w, ks, k),
  rival_write(w, h, table, ks2, k2),
  !writer_walk.reaches(f, h),
  !writer_walk.reaches(h, f),
  !keys_apart(ks, k, ks2, k2),
  concurrent(f, h, w).

writer_walk.seed(f, f) :- reads_then_writes(f, _, _, _, _).

// ── Harm ─────────────────────────────────────────────────────────────
//
// What a rival and the pair's write do to the row together, when the
// rival lands between the pair's read and its write. It is a harm when
// no order of the two, one after the other, ends the same way:
//
// - lost_update: the write stores what the read returned, or a value
//   made of it (PairCarries, this pair's read on this pair's path), and a
//   rival changes the row: the write puts back the value it read plus its
//   own change, and the rival's is lost (two callers each add one to the
//   count they read). A rival that removes the row loses to a write that
//   makes it again, but not to an update_element, which finds no row. A
//   delete stores nothing: a key it takes from the row it found (a pinned
//   match's element) is the row's, not a value made of it;
// - clobber: a write of a value of its own lands on a row a rival counts
//   in (update_counter, a write-back, an `:atomics` array the row holds):
//   Hammer's first insert over the bucket another hit already counted;
// - stale_fill: the write stores a value a call or another store made
//   (a refill, cache-aside) and a rival removes the row or writes it with
//   a value of its own in between: the fill computed before the rival
//   lands after it, and the stale value stays (a cache refilled after
//   its invalidation);
// - state_delete: the write deletes the row on what the row holds (its
//   owner, its expiry), and a rival makes the row again with a value of
//   its own, or counts in it, in between: the delete takes the row the
//   rival just made (a lock's next owner, a fresh ban count), which the
//   decision, made on the old row, would not have taken. A delete made on
//   the row's presence alone ends as the rival's write then the delete
//   would; a row a refill makes is a cached copy, and losing it is a miss;
// - claim: a write that makes the row on a read that found none, whose
//   decision leaves the function as a verdict, not as the row (what the
//   function returns depends on the read by control alone): both racers
//   are told they won;
// - take: a delete whose decision leaves the function, and the function
//   hands out what the row held: both racers take the one row (a
//   callback run twice);
// - decides_more: the decision also sends, calls a peer, makes an
//   outside effect or another shared write, here or one call down: both
//   racers do it;
// - guarded: the decision compares a field of the row with the value the
//   write stores (`[{^k, cur}] when cur < new`): both pass, and the older
//   can land last;
// - minted: the write stores a value minted per call (a random token, a
//   unique integer, a ref) that the function hands out: each racer hands
//   out its own, and only one is stored.
//
// The first four need a rival that changes the row; the last five need a
// rival that makes the same decision: the pair itself in a second
// process, or another pair's write (guarded: any rival). No witness, no
// race: two racers that write the same default, a refill every racer
// computes alike with nothing to make it stale, a delete that deletes
// twice, a marker set twice.
.init ets_carried = PairCarries

ets_carried.pair(f, r, w) :- reads_then_writes(f, r, w, _, _).
ets_carried.read_in(r, g) :- ets_op(r, g, _, _, "read").
ets_carried.write_in(w, h) :- ets_op(w, h, _, _, "write").
ets_carried.fresh(kind, src) :- fill_source(kind, src).

// A write of a value, and the writes that make a row.
.decl value_write(w: symbol)

value_write(w) :- ets_op(w, _, _, op, "write"), (op = "insert" ; op = "update_element").

.decl makes_row(write: symbol)

makes_row(w) :- ets_op(w, _, _, "insert", "write").
makes_row(w) :- ets_op(w, _, _, "insert_new", "write").
makes_row(w) :-
  ets_op(w, _, _, "update_counter", "write"),
  remote_call(w, _, ":ets", "update_counter", 4).

.decl removal(write: symbol)

removal(w) :- ets_op(w, _, _, op, "write"), ets_removal_op(op).

// A write that changes what the row holds: stores a value, counts in it,
// or removes it.
.decl changes_row(write: symbol)

changes_row(w) :- ets_op(w, _, _, op, "write"), op != "insert_new".

// A write that counts in the row, as `func` makes it: update_counter; a
// write of a value made of a read (MadeOfRead: any read, by any caller's
// path); a row that holds an :atomics or :counters array, which each
// racer makes of its own and the other's counts into are lost with it.
.init ets_made = MadeOfRead

ets_made.read(r) :- ets_op(r, _, _, _, "read").
ets_made.write(w, h) :- table_write(w, h, _), value_write(w).

.decl counts_in(write: symbol, func: symbol)

counts_in(w, h) :- rival_write(w, h, _, _, _), ets_op(w, _, _, "update_counter", _).
counts_in(w, h) :- rival_write(w, h, _, _, _), stores_counters(w).
counts_in(w, h) :- rival_write(w, h, _, _, _), rival_value(w, h, k, s), rival_made.made(h, k, s).

// The value a rival write stores, in the terms of the function that
// names its key: its own function's, or, carried up the calls its key is
// lifted through, each caller's (`set_count(v)` hands put/2 its own
// parameter; incr/0 hands set_count/1 `count() + 1`).
.decl rival_value(write: symbol, func: symbol, kind: symbol, src: symbol)

rival_value(w, g, k, s) :- table_write(w, g, _), value_write(w), site_reads(w, g, k, s).

rival_value(w, h, k, s) :-
  rival_value(w, g, "param", p),
  param_write(w, g, _, _),
  call_arg_reads(h, g, n, k, s),
  p = to_string(n).

// Made of a read of the table, in the rival's terms (MadeOfRead, asked
// of the rivals' values).
.init rival_made = MadeOfRead

rival_made.read(r) :- ets_op(r, _, _, _, "read").
rival_made.write(w, g) :- table_write(w, g, _), value_write(w).
rival_made.asked(h, k, s) :- rival_value(w, h, k, s), rival_write(w, h, _, _, _).

.decl stores_counters(write: symbol)

stores_counters(w) :-
  ets_op(w, _, _, op, "write"),
  (op = "insert" ; op = "insert_new"),
  ets_value(w, _, "local", made),
  remote_call(made, _, m, "new", 2),
  (m = ":atomics" ; m = ":counters").

// A write made by a call, or by a read of some other store (Mnesia, the
// registry): a refill. Any other value is the writer's own.
.decl fill_source(kind: symbol, src: symbol)

fill_source("call", g) :- site_reads(_, _, "call", g).
fill_source("call", g) :- call_arg_reads(_, _, _, "call", g).
fill_source("site", r) :- site_reads(_, _, "site", r), !ets_op(r, _, _, _, _).
fill_source("site", r) :- call_arg_reads(_, _, _, "site", r), !ets_op(r, _, _, _, _).

// A cached copy: a write that is some pair's fill, a value a call or
// another store made, written on a read that found the row missing or
// stale (PairCarries' fills). A row any other write makes is state of its
// own — a start's pid, a caller's value, a count — whose loss is a loss.
.decl refill_row(write: symbol)

refill_row(w) :- ets_carried.fills(_, _, w).

// A rival that makes the row with a value of its own, not a refill.
.decl makes_own_row(write: symbol)

makes_own_row(w) :- makes_row(w), !refill_row(w).

// A rival that rewrites the row with a value of its own, or removes it:
// what makes a refill stale.
.decl invalidates(write: symbol, func: symbol)

invalidates(w, h) :- rival_write(w, h, _, _, _), removal(w).
invalidates(w, h) :- rival_write(w, h, _, _, _), value_write(w), !refill_row(w).
invalidates(w, h) :- counts_in(w, h).

// A rival that makes the pair's decision too: the pair itself, or
// another pair's write.
.decl decides_too(func: symbol, read: symbol, write: symbol, rival_write: symbol, rival_func: symbol)

decides_too(f, r, w, w, f) :- rival(f, r, w, w, f).
decides_too(f, r, w, w2, h) :- rival(f, r, w, w2, h), rows.meets(_, _, w2, _, _, _, _).

// A call that mints its value: a random API, a unique integer or a ref,
// or a project function that makes one or returns what one made.
.decl unique_api(api: symbol)

unique_api("System.unique_integer/0").
unique_api("System.unique_integer/1").
unique_api(":erlang.unique_integer/0").
unique_api(":erlang.unique_integer/1").
unique_api(":erlang.make_ref/0").
unique_api("Kernel.make_ref/0").

.decl mints(callee: symbol)

mints(g) :-
  impure_call(id, _, _, "random", _),
  remote_call(id, _, m, n, a),
  g = cat(m, ":", n, "/", to_string(a)).

mints(g) :- function_def(g, _, _, _, _), impure_call(_, g, _, "random", _).
mints(g) :- function_def(g, _, _, _, _), impure_call(_, g, api, _, _), unique_api(api).
mints(g) :- function_def(g, _, _, _, _), returns_depends(g, "call", g2), mints(g2).

// The write's value is minted by a call the writing function also
// returns, to a caller that uses it or one outside the program.
.decl mint_handed_out(w: symbol)

mint_handed_out(w) :-
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  mints(g),
  returns_depends(h, "call", g),
  result_leaves(h).

.decl result_leaves(func: symbol)

result_leaves(h) :- rows.act(_, h, _, _, _, _), api_export(h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), site_depends(_, _, "call", h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), call_decided(_, _, "call", h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), call_arg_depends(_, _, _, "call", h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), returns_depends(_, "call", h).

// The decision a pair makes leaves the function: returned — by the
// function the pair meets in, or by a caller that returns that result on
// — to a caller that branches on it, or to callers the program does not
// show (an exported function). A spec that says the function returns a
// single value (`@spec record_failure(term, atom) :: :ok`) says the
// result carries no decision.
.decl decision_returned(meet: symbol, func: symbol, check: symbol)

decision_returned(f, f, c) :-
  reads_then_writes(f, c, _, _, _),
  rows.carries(f, kind, src, c, _, _, _, _),
  returns_depends(f, kind, src).

decision_returned(f, g, c) :-
  decision_returned(f, h, c),
  rows.carries(g, "call", h, c, _, _, _, _),
  returns_depends(g, "call", h).

.decl decision_escapes(meet: symbol, check: symbol)

decision_escapes(f, c) :-
  decision_returned(f, g, c),
  call_decided(_, _, "call", g).

decision_escapes(f, c) :-
  decision_returned(f, g, c),
  api_export(g),
  !callee_returns(g, "constant").

// A verdict: the decision escapes, and where the pair meets the function
// answers with no value made of the read — `[] -> insert(k, :taken);
// :ok; _ -> {:error, :taken}` — rather than with the row (a get-or-
// create, a cache-aside's value).
.decl verdict_escapes(func: symbol, check: symbol)

verdict_escapes(f, c) :-
  decision_escapes(f, c),
  !ets_carried.answers(f, c).

// The functions on a pair's own path from its read up to where it meets:
// the meeting function, and the helpers below it that return the read's
// value up to it (CheckThenAct's carried_through). What the decision
// looks at, compares, sends or writes besides is asked of these alone:
// an accessor's lookup that ten functions share is ten pairs, each with
// a decision of its own.
.decl pair_path(meet: symbol, check: symbol, func: symbol)

pair_path(f, c, f) :- reads_then_writes(f, c, _, _, _).
pair_path(f, c, g) :- reads_then_writes(f, c, _, _, _), rows.carried_through(f, c, g).

// The read's decision looks at what the row holds, past its key: a test
// of element 1 on, where the read's value is carried on the pair's path,
// or in a helper it is handed to (field_decides). Whether a row is
// there, and whether its key is the one asked for, say nothing of what
// it holds.
.decl tests_row_fields(meet: symbol, read: symbol)

tests_row_fields(f, r) :-
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  field_decides(g, kind, src, pos),
  pos >= 1.

tests_row_fields(f, r) :-
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  call_arg_depends(g, h, n, kind, src),
  field_decides(h, "param", q, pos),
  q = to_string(n),
  pos >= 1.

// A guard on what the row holds: the decision compares a field past the
// key with a value the write then stores (field_compared), where the
// read's value is carried on the pair's path or in a helper it is handed
// to.
.decl guards_row(meet: symbol, read: symbol, write: symbol)

guards_row(f, r, w) :-
  reads_then_writes(f, r, w, _, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  field_compared(g, kind, src, pos, ok, os),
  pos >= 1,
  rows.act(w, g, _, _, _, _),
  site_reads(w, g, ok, os).

guards_row(f, r, w) :-
  reads_then_writes(f, r, w, _, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  field_compared(g, kind, src, pos, ok, os),
  pos >= 1,
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "param", q),
  call_arg_reads(g, h, n, ok, os),
  q = to_string(n).

guards_row(f, r, w) :-
  reads_then_writes(f, r, w, _, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  call_arg_depends(g, h, n, kind, src),
  field_compared(h, "param", q, pos, ok, os),
  q = to_string(n),
  pos >= 1,
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, ok, os).

// The read's decision runs more than the write, on the pair's path: a
// send or an outside effect (effect_decided), or a write of some other
// shared state; or it hands a message on one call down (DecisionSends).
.decl decides_more(meet: symbol, read: symbol, write: symbol)

decides_more(f, r, w) :-
  reads_then_writes(f, r, w, _, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  effect_decided(g, kind, src).

decides_more(f, r, w) :-
  reads_then_writes(f, r, w, table, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  site_depends(s, g, kind, src),
  s != w,
  other_state_write(s, table).

decides_more(f, r, w) :- reads_then_writes(f, r, w, _, _), row_sends.sends(f, r).

// Or it hands a value the read decides or is made into to a helper that
// changes other state on its own stack, however far down: ejabberd's
// stop_module_keep_config/2 hands the registrations its lookup found to
// del_registrations/3, whose closure removes each hook from the hooks'
// tables, and both racers remove them; blockster's weekly movers, found
// not yet written today, hand the article's parameters to the generator,
// and both racers generate it. A helper the decision only calls, handing
// it nothing of the read, is not asked: a refill's fetch runs because of
// the miss, and is how the copy is made, not more.
decides_more(f, r, w) :-
  decision_hands(f, r, w, h),
  reads_then_writes(f, r, w, table, _),
  decision_reach.reaches(h, k),
  changes_table(k, table2),
  table2 != table.

decides_more(f, r, w) :-
  decision_hands(f, r, w, h),
  decision_reach.reaches(h, k),
  changes_other_state(k).

// The helpers a pair's decision hands a value that carries the read, on
// the pair's path, by data (call_arg_reads).
.decl decision_hands(meet: symbol, read: symbol, write: symbol, helper: symbol)

decision_hands(f, r, w, h) :-
  reads_then_writes(f, r, w, _, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  call_arg_reads(g, h, _, kind, src).

// What the helper runs in its caller's process.
.init decision_reach = ForwardSameProcessReachCut

decision_reach.root(h, h) :- decision_hands(_, _, _, h).
decision_reach.cut(f, g) :- side_call(f, g).

// changes_table(func, table): func writes the ETS table `table`.
.decl changes_table(func: symbol, table: EtsTable)

changes_table(k, table) :- ets_op(s, k, _, _, "write"), ets_op_table(s, table).

// changes_other_state(func): func changes something else a process or
// the outside world acts on: another store, a registration, a message, a
// call or cast to a peer, a runtime write of a process, a port, a file,
// the network or a node (Argus.Extractors.Dependence's effect_decided,
// whatever decides it).
.decl changes_other_state(func: symbol)

changes_other_state(k) :- shared_write(s), !ets_op(s, _, _, _, _), (mnesia_op(s, k, _, _, _, _, _, _) ; creating_op(s, k, _, _, _, _) ; name_release(s, k, _, _, _)).
changes_other_state(k) :- delivers_message(k).

changes_other_state(k) :-
  impure_call(_, k, _, category, "write"),
  (category = "io" ; category = "process" ; category = "port" ; category = "node" ; category = "network" ; category = "code_loading").

// A write of shared state other than the pair's table: the same table's
// other writes under the decision are the race's own (its other branch,
// or a later write of it), not more.
.decl other_state_write(site: symbol, table: EtsTable)

other_state_write(s, table) :- rival_table(table), ets_op(s, _, _, _, "write"), ets_op_table(s, table2), table2 != table.
other_state_write(s, table) :- rival_table(table), shared_write(s), !ets_op(s, _, _, _, _).

.decl shared_write(site: symbol)

shared_write(s) :- ets_op(s, _, _, _, "write").
shared_write(s) :- mnesia_op(s, _, _, "write", _, _, _, _).
shared_write(s) :- creating_op(s, _, _, _, _, _).
shared_write(s) :- name_release(s, _, _, _, _).

// A send, a call or a cast, where the read's value decides on the pair's
// path or one call down (DecisionSends, clientlib/check_then_act.dl).
.init row_sends = DecisionSends

row_sends.carried(f, g, kind, src, r) :- pair_path(f, r, g), rows.carries(g, kind, src, r, _, _, _, _).

// A rival other than the pair's own write in the pair's own function:
// another write, or the pair's write made at another call (an accessor's
// insert another function hands a key of its own).
.decl other_site(func: symbol, write: symbol, rival_write: symbol, rival_func: symbol)

other_site(f, w, w2, h) :- rival(f, _, w, w2, h), w2 != w.
other_site(f, w, w, h) :- rival(f, _, w, w, h), h != f.

// A refill whose source can change between the read of it and the write
// of the copy: a read of another store, or a call whose answer is not
// known to be a function of its arguments (it reads a process, a table,
// the process dictionary, a file or the node, or calls code the effect
// model has no word for — an Ecto query). A refill that is a pure
// function of the key (`load(k) = {:loaded, k}`) writes the same copy
// whenever it runs, and cannot be stale.
.decl fills_from_source(func: symbol, read: symbol, write: symbol)

fills_from_source(f, r, w) :- ets_carried.fresh_used(f, r, w, kind, src), changing_source(kind, src).

.decl changing_source(kind: symbol, src: symbol)

changing_source("site", s) :- fill_source("site", s).
changing_source("call", g) :- fill_source("call", g), reads_state(g).

// A function, or a call site's callee outside the program, whose answer
// may depend on state that changes.
.decl reads_state(func: symbol)

reads_state(g) :- fill_source("call", g), unknown_call(_, _, _, g).
reads_state(g) :- fill_source("call", g), protocol_dispatch(id, _, _), remote_call(id, _, m, n, a), g = cat(m, ":", n, "/", to_string(a)).

reads_state(g) :-
  fill_source("call", g),
  impure_call(id, _, _, category, "read"),
  category != "time",
  category != "random",
  remote_call(id, _, m, n, a),
  g = cat(m, ":", n, "/", to_string(a)).

reads_state(g) :- state_reader(g).

// A program function that reads changing state on its own stack.
.decl state_reader(func: symbol)

state_reader(g) :- function_def(g, _, _, _, _), unknown_call(_, g, _, _).
state_reader(g) :- function_def(g, _, _, _, _), protocol_dispatch(_, g, _).
state_reader(g) :- impure_call(_, g, _, category, "read"), category != "time", category != "random".
state_reader(g) :- ets_op(_, g, _, _, "read").
state_reader(g) :- mnesia_op(_, g, _, "read", _, _, _, _).
state_reader(g) :- local_call(_, g, h, _), state_reader(h).
state_reader(g) :- remote_call(_, g, m, n, a), h = cat(m, ":", n, "/", to_string(a)), function_def(h, _, _, _, _), state_reader(h).

// ets_harm_by(f, r, w, kind, w2, h): the rival w2, made by calling h,
// witnesses the harm `kind` of the pair (r, w) meeting in f.
.decl ets_harm_by(func: symbol, read: symbol, write: symbol, kind: symbol, rival_write: symbol, rival_func: symbol)

ets_harm_by(f, r, w, "lost_update", w2, h) :-
  ets_carried.carries(f, r, w),
  value_write(w),
  rival(f, r, w, w2, h),
  changes_row(w2),
  !removal(w2).

ets_harm_by(f, r, w, "lost_update", w2, h) :-
  ets_carried.carries(f, r, w),
  makes_row(w),
  rival(f, r, w, w2, h),
  removal(w2).

ets_harm_by(f, r, w, "clobber", w2, h) :-
  value_write(w),
  rival(f, r, w, w2, h),
  other_site(f, w, w2, h),
  counts_in(w2, h).

// A row that holds a counter array is counted in through the array, and
// each racer inserts an array of its own: the other racer's counts go
// with the array its insert replaced (Hammer's atomic buckets).
ets_harm_by(f, r, w, "clobber", w, f) :- stores_counters(w), rival(f, r, w, w, f).

ets_harm_by(f, r, w, "stale_fill", w2, h) :-
  fills_from_source(f, r, w),
  rival(f, r, w, w2, h),
  other_site(f, w, w2, h),
  invalidates(w2, h),
  !removal(w2).

ets_harm_by(f, r, w, "stale_fill", w2, h) :-
  fills_from_source(f, r, w),
  makes_row(w),
  rival(f, r, w, w2, h),
  other_site(f, w, w2, h),
  removal(w2).

ets_harm_by(f, r, w, "state_delete", w2, h) :-
  ets_op(w, _, _, "delete", _),
  tests_row_fields(f, r),
  rival(f, r, w, w2, h),
  other_site(f, w, w2, h),
  makes_own_row(w2).

ets_harm_by(f, r, w, "state_delete", w2, h) :-
  ets_op(w, _, _, "delete", _),
  tests_row_fields(f, r),
  rival(f, r, w, w2, h),
  other_site(f, w, w2, h),
  counts_in(w2, h).

ets_harm_by(f, r, w, "claim", w2, h) :-
  makes_row(w),
  verdict_escapes(f, r),
  decides_too(f, r, w, w2, h).

ets_harm_by(f, r, w, "take", w2, h) :-
  ets_op(w, _, _, "delete", _),
  !tests_row_fields(f, r),
  decision_escapes(f, r),
  ets_carried.answers(f, r),
  decides_too(f, r, w, w2, h).

ets_harm_by(f, r, w, "decides_more", w2, h) :-
  decides_more(f, r, w),
  decides_too(f, r, w, w2, h).

// A guard over a refilled row orders copies of one source: which copy
// lands last matters only when the source changed, the stale fill's
// witness.
ets_harm_by(f, r, w, "guarded", w2, h) :-
  guards_row(f, r, w),
  !ets_carried.fills(f, r, w),
  rival(f, r, w, w2, h).

ets_harm_by(f, r, w, "minted", w, f) :- mint_handed_out(w), rival(f, r, w, w, f).

// ── Rows only their holder writes ────────────────────────────────
//
// A row whose key is minted where the row is made — a reference
// (make_ref, a monitor) or a unique integer — can be found only by whoever
// the key is handed to. When every write that can make a row of the
// table mints its key so, and the pair's act makes no row (an
// update_element, a delete), the row the pair reads was made for a holder
// of its key, and the pair running in many processes is many holders at
// their own rows: it is not its own rival. Postgrex.Parameters is the
// shape: the owner inserts `{Process.monitor(pid), params}` with
// insert_new and replies the reference to the connection that asked, the
// connection updates its row with update_element, and the owner deletes
// the row when the connection goes down. Where a key goes once it is
// minted the facts do not say, so a program that hands one minted key to
// several processes is not seen.
.decl minting_call(mod: symbol, func: symbol, arity: number)

minting_call(":erlang", "make_ref", 0).
minting_call(":erlang", "monitor", 2).
minting_call(":erlang", "monitor", 3).
minting_call(":erlang", "unique_integer", 0).
minting_call(":erlang", "unique_integer", 1).
minting_call("System", "unique_integer", 0).
minting_call("System", "unique_integer", 1).

.decl minted_key(write: symbol)

minted_key(w) :-
  makes_row(w),
  op_key(w, "local", made),
  remote_call(made, _, m, n, a),
  minting_call(m, n, a).

// A table whose rows are made at minted keys and at no other: some write
// mints, and none that makes a row keys it by what it is given or
// computes.
.decl mints_rows(kind: symbol, table: symbol)
.decl names_rows(kind: symbol, table: symbol)

mints_rows(k, t) :- ets_table(w, k, t), minted_key(w).
names_rows(k, t) :- ets_table(w, k, t), makes_row(w), !minted_key(w).

.decl held_table(kind: symbol, table: symbol)

held_table(k, t) :- mints_rows(k, t), !names_rows(k, t).

// The pair's act makes no row, and every table it may touch is held.
.decl on_unheld_table(write: symbol)

on_unheld_table(w) :- reads_then_writes(_, _, w, _, _), ets_table(w, k, t), !held_table(k, t).

.decl held_row(write: symbol)

held_row(w) :-
  reads_then_writes(_, _, w, _, _),
  ets_table(w, _, _),
  !makes_row(w),
  !on_unheld_table(w).

// A write another process makes, as made by calling `func`: the
// function that names its key (rival, above).
.type RivalWrite = [write: symbol, func: symbol]

// The row's table is one any process can write: created :public
// (table_public, clientlib/tables.dl), or handed in by the program's
// users, which the function writes from every caller's process (above).
.decl on_public_table(row: EtsRow)

on_public_table([[tk, t], ks, k]) :- decides_write(_, _, _, [[tk, t], ks, k]), table_public(tk, t).
on_public_table([["handed_in", t], ks, k]) :- decides_write(_, _, _, [["handed_in", t], ks, k]).

// Another process's write can land on the pair's row between the read
// and the write (rival, above: the pair itself in a second process, or
// another write at a key that can be the pair's).
.decl lands_between(rival: RivalWrite, read: symbol, write: symbol, func: symbol) inline

lands_between([w2, h], r, w, f) :- rival(f, r, w, w2, h).

// What the rival and the pair's write do to the row together is a harm
// no order of the two, one after the other, leaves (ets_harm_by, above):
// every harm is witnessed by a rival that lands between.
.decl harms(rival: RivalWrite, read: symbol, write: symbol, func: symbol, harm: symbol) inline

harms([w2, h], r, w, f, k) :- ets_harm_by(f, r, w, k, w2, h).

// A read decides or feeds a write of the same row, on a table any
// process can write, and another process's write that lands between the
// two leaves a harm. `func` is where the read's result reaches the write.
.decl read_then_write_race(func: symbol, read: symbol, write: symbol, row: EtsRow, harm: symbol)

read_then_write_race(func, read, write, row, harm) :-
  decides_write(func, read, write, row),
  on_public_table(row),
  lands_between(rival, read, write, func),
  harms(rival, read, write, func, harm).

// Every race, at the sites it is reported at: the operations, or the
// calls to the accessors holding them.
.decl ets_race(mod: symbol, func: symbol, name: symbol, key: symbol, read: symbol, write: symbol, kind: symbol)

ets_race(mod, func, name, key, read_at, write_at, harm) :-
  read_then_write_race(func, read, write, [table, _, key], harm),
  table_shown_as(func, table, name),
  reported_at(func, read, read_at),
  reported_at(func, write, write_at),
  in_module(func, mod).

// How a finding spells its table: a named table by its name, an unnamed
// one by the name its :ets.new/2 gave it, a field table by the names its
// sites gave it, and a table the program's users hand in by the
// parameter of `func` it arrives in, counted from 0 as a key's is
// ("param 0"): nothing names it.
.decl table_shown_as(func: symbol, table: EtsTable, name: symbol)

table_shown_as(f, ["named", t], t) :- decides_write(f, _, _, [["named", t], _, _]).

table_shown_as(f, [tk, t], name) :-
  decides_write(f, _, _, [[tk, t], _, _]),
  tk != "named",
  tk != "handed_in",
  table_made_at(tk, t, n),
  ets_new(n, _, name).

table_shown_as(f, ["handed_in", t], cat("param ", p)) :-
  decides_write(f, _, _, [["handed_in", t], _, _]),
  param_table(f, p, "handed_in", t).

// How much an interleaving costs, strongest first: the finding is
// reported at its strongest harm.
.decl ets_harm_rank(kind: symbol, rank: number)

ets_harm_rank("lost_update", 0).
ets_harm_rank("claim", 1).
ets_harm_rank("take", 2).
ets_harm_rank("guarded", 3).
ets_harm_rank("clobber", 4).
ets_harm_rank("state_delete", 5).
ets_harm_rank("minted", 6).
ets_harm_rank("decides_more", 7).
ets_harm_rank("stale_fill", 8).

// One finding per write (OnePerWrite, clientlib/check_then_act.dl), at
// the sites it is reported at: of the pairs a write is in, the strongest
// harm, then the least read, then the least function where they meet;
// the others are frames. A write the same read decides in the same
// function, later than another, is the same race's other branch
// (add_lsort/2's three set/2 calls): a frame of the first.
// The race's writes are grouped by the read and the function alone: a
// read whose decision makes two writes in one function is one race,
// whatever each write alone would cost, reported at its strongest.
.decl ets_best_rank(func: symbol, read: symbol, write: symbol, rank: number)

ets_best_rank(f, r, w, n) :-
  ets_race(_, f, _, _, r, w, _),
  n = min m : { ets_race(_, f, _, _, r, w, k), ets_harm_rank(k, m) }.

.init ets_writes = OnePerWrite

ets_writes.race(f, r, w, "", n) :- ets_best_rank(f, r, w, n).
ets_writes.write_in(s, f) :- ets_race(_, _, _, _, _, s, _), ets_op(s, f, _, _, _).
ets_writes.write_in(s, f) :- ets_race(_, _, _, _, _, s, _), call_site(s, f, _, _, _).

.decl ets_check_act(mod: symbol, func: symbol, name: symbol, key: symbol, read: symbol, write: symbol, kind: symbol)
.output ets_check_act

ets_check_act(mod, f, t, key, r, w, k) :-
  ets_writes.reported(f, r, w, _),
  race_rank(f, r, w, n),
  ets_harm_rank(k, n),
  ets_race(mod, f, t, key, r, w2, k),
  same_race(f, w, w2).

// A reported write and the same race's later writes (its also_writes
// frames): the finding carries the strongest harm among them, where it is
// anchored at the first.
.decl same_race(func: symbol, write: symbol, other: symbol)

same_race(f, w, w) :- ets_writes.reported(f, _, w, _).
same_race(f, w, w2) :- ets_writes.also_writes(w, w2, f).

.decl race_rank(func: symbol, read: symbol, write: symbol, rank: number)

race_rank(f, r, w, n) :-
  ets_writes.reported(f, r, w, _),
  n = min m : { same_race(f, w, w2), ets_best_rank(f, r, w2, m) }.

// The same race's later writes ("also_writes"), the other reads that
// decide or feed the write ("read"), and the rival writes that witness
// its harm ("rival": another process's write the pair's write undoes,
// or that undoes it), each with the function it is reported from.
.decl ets_race_frame(write: symbol, role: symbol, site: symbol, func: symbol)
.output ets_race_frame

ets_race_frame(w1, "also_writes", w2, f) :- ets_writes.also_writes(w1, w2, f).

ets_race_frame(w, "read", r2, f2) :-
  ets_check_act(_, _, _, _, r, w, _),
  ets_race(_, f2, _, _, r2, w, _),
  r2 != r.

ets_race_frame(w_at, "rival", w2, h) :-
  ets_check_act(_, f, _, _, r_at, w_at, k),
  reported_at(f, r, r_at),
  reported_at(f, w, w_at),
  ets_harm_by(f, r, w, k, w2, h),
  other_site(f, w, w2, h).

// ── Published before it is complete ──────────────────────────────
//
// Two tables that map each way — names to ids, ids back to names — and a
// function that writes both: first a row of A holding a value V
// (`{name, id}`), then B's row keyed by V (`{id, name}`). Once the first
// write lands, V can be found: another process that takes V out of A and
// reads B at it before the second write lands finds no row. That is a
// lost update in no sense — both writes happen — but the reader that
// raises on a missing row (lookup_element/3, update_counter/3) crashes
// with badarg in the window. The fix is the order: write B first, then
// publish V in A, and when publishing can lose (insert_new), delete the B
// row it wrote.
//
// The two writes may be the function's own or its callees': a function
// runs an insert where it makes it or at the call whose callee, on the
// same stack, makes it (insert_at), and each is read in the function's
// terms — a callee's key in its parameter is the argument the call
// passes (ets_call_arg). They are in order when the second is reached
// from the first within one trip through the function (ets_effect_order:
// a loop's back edge does not order a pair both ways). Nothing here needs
// V's name: the writes join on V's identity (ets_value against ets_key),
// the tables on what clientlib/tables.dl says each operation may touch.

// A writer publishes a value in one row before it writes the row keyed
// by that value, and a reader in another process that finds the value
// looks up the missing row in the gap and crashes. `reader_func` is the
// reader's function, whose processes are asked about.
.decl publish_order_race(writer: symbol, publish: symbol, complete: symbol, reader: symbol, reader_func: symbol)

publish_order_race(writer, publish, complete, reader, reader_func) :-
  publishes_early(writer, publish, complete),
  fails_if_row_missing(reader, reader_func),
  looks_up_row_of(reader, complete),
  finds_published_value(reader, publish),
  can_read_in_the_gap(writer, reader_func).

// The reader raises when its key has no row, and nothing rescues the
// raise (fails_if_row_missing, asked from the reader's own function): a
// reader that rescues it, or whose every caller does, does not crash in
// the gap.
// The reader reads a table the completing write writes, one another
// process can read.
.decl looks_up_row_of(reader: symbol, complete: symbol) inline

looks_up_row_of(r, w2) :- readable_elsewhere(w2, bk, b), ets_table(r, bk, b).

// A read of the published table hands its values out, and the reader's
// key may be one of them (key_may_come_from, below).
.decl finds_published_value(reader: symbol, publish: symbol) inline

finds_published_value(r, w1) :-
  ets_table(w1, ak, a),
  handed_out_from(ak, a),
  key_may_come_from(r, ak, a).

// A table some read hands a value out of (hands_out, below).
.decl handed_out_from(kind: symbol, table: symbol)

handed_out_from(ak, a) :- ets_op(ra, _, _, _, "read"), ets_table(ra, ak, a), hands_out(ra).

// A call that runs its callee on the caller's stack.
// A call into a function the program defines is a call site of the
// caller's (stage 0's call_site, call_instr), and runs_elsewhere never
// holds for an edge its caller calls: every such call runs on the
// caller's stack.
.decl same_stack_site(site: symbol, caller: symbol, callee: symbol)

same_stack_site(c, f, g) :- local_call(c, f, g, _).

same_stack_site(c, f, g) :-
  remote_call(c, f, m, n, a),
  g = cat(m, ":", n, "/", to_string(a)),
  function_def(g, _, _, _, _).

.decl object_insert(w: symbol, func: symbol)

object_insert(w, f) :- ets_op(w, f, _, "insert", "write").
object_insert(w, f) :- ets_op(w, f, _, "insert_new", "write").

.decl reaches_insert(func: symbol)

reaches_insert(f) :- object_insert(_, f).
reaches_insert(f) :- same_stack_site(_, f, g), reaches_insert(g).

.decl lift_needed(func: symbol)

lift_needed(f) :- ets_effect_order(f, _, _).
lift_needed(g) :- lift_needed(f), same_stack_site(_, f, g), reaches_insert(g).

// `func` runs the insert `w` at `at`: w itself, or a call leading to it.
.decl insert_at(func: symbol, at: symbol, w: symbol)

insert_at(f, w, w) :- lift_needed(f), object_insert(w, f).

insert_at(f, c, w) :-
  lift_needed(f),
  same_stack_site(c, f, g),
  reaches_insert(g),
  insert_at(g, _, w).

// The insert's key and the values past it, in `func`'s terms. A literal
// means the same everywhere; a parameter is what the call passes.
.decl key_in(func: symbol, at: symbol, w: symbol, source: symbol, key: symbol)

key_in(f, w, w, s, k) :- insert_at(f, w, w), ets_key(w, s, k).

key_in(f, c, w, "literal", k) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  key_in(g, _, w, "literal", k).

key_in(f, c, w, s, k) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  key_in(g, _, w, "param", p),
  ets_call_arg(c, g, p, s, k).

.decl value_in(func: symbol, at: symbol, w: symbol, pos: number, source: symbol, value: symbol)

value_in(f, w, w, pos, s, v) :- insert_at(f, w, w), ets_value(w, pos, s, v).

value_in(f, c, w, pos, "literal", v) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  value_in(g, _, w, pos, "literal", v).

value_in(f, c, w, pos, s, v) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  value_in(g, _, w, pos, "param", p),
  ets_call_arg(c, g, p, s, v).

// W1 writes V into A's row, W2 then writes B's row keyed by V. A value
// that is a literal is known without reading A.
.decl publish_candidate(func: symbol, publish: symbol, complete: symbol)

publish_candidate(f, w1, w2) :-
  ets_effect_order(f, a1, a2),
  insert_at(f, a1, w1),
  insert_at(f, a2, w2),
  w1 != w2,
  value_in(f, a1, w1, _, vs, v),
  vs != "literal",
  key_in(f, a2, w2, vs, v).

// The two writes are two rows: the completing row is keyed by V, the
// value the first row holds past its key, and V is not that row's own
// key (`{name, id}` then `{id, name}`), whether they share one table
// (a map that goes both ways) or sit in two. A write of `{k, k}` then
// `{k, ...}` is one row written twice.
.decl publishes_early(func: symbol, publish: symbol, complete: symbol)

publishes_early(f, w1, w2) :-
  publish_candidate(f, w1, w2),
  ets_table(w1, _, _),
  ets_table(w2, _, _),
  insert_at(f, a1, w1),
  value_in(f, a1, w1, _, vs, v),
  key_in(f, a1, w1, ks, k),
  key_in(f, _, w2, vs, v),
  (vs != ks ; v != k).

// A read that raises when the key has no row (ets.dl's
// raises_if_table_missing asks of a missing table). lookup_element/4 and
// update_counter/4 take a default and do not; update_element answers
// false.
.decl raises_if_row_missing(r: symbol, func: symbol)

raises_if_row_missing(r, g) :-
  ets_op(r, g, _, op, _),
  remote_call(r, _, m, op, a),
  ets_raises_without_row(m, op, a).

// A read of A that hands out what it found: the way V reaches a reader.
.decl hands_out(r: symbol)

hands_out(r) :- ets_op(r, _, _, "lookup", _), returns_depends(_, "site", r).
hands_out(r) :- ets_op(r, _, _, "lookup", _), site_reads(_, _, "site", r).
hands_out(r) :- ets_op(r, _, _, "lookup", _), call_arg_reads(_, _, _, "site", r).
hands_out(r) :- ets_op(r, _, _, op, "read"), op != "lookup", op != "member", op != "info".

// A table another process can read. A "field" table is the one its
// operations were created with a name of (ets_op), not private.
.decl readable_elsewhere(id: symbol, kind: symbol, ident: symbol)

readable_elsewhere(id, k, t) :- ets_table(id, k, t), k != "field", table_readable_elsewhere(k, t).

readable_elsewhere(id, "field", t) :-
  ets_table(id, "field", t),
  ets_op(id, _, name, _, _),
  name != "dynamic",
  ets_new(n, _, name),
  !ets_option(n, "access", "private").

// A reader that crashes on a missing row of a table an early publish
// completes, with the table that publish writes: the readers and tables
// whose keys are asked about below. A literal key is no value read from
// anywhere.
.decl gap_reader(reader: symbol, reader_func: symbol, published_kind: symbol, published: symbol)

gap_reader(r, g, ak, a) :-
  publishes_early(_, w1, w2),
  ets_table(w1, ak, a),
  handed_out_from(ak, a),
  fails_if_row_missing(r, g),
  looks_up_row_of(r, w2),
  ets_key(r, ks, _),
  ks != "literal".

// ── Where the reader's key comes from ──
//
// The reader must be able to hold V: its key made from a read of A, or
// from something the program cannot see the origin of — a parameter of a
// function outside callers can reach (exported, or taken as a fun), a
// call nothing summarises. A key the program shows is made from other
// things does not read A's values.
.decl key_needed(func: symbol, kind: symbol, src: symbol)

key_needed(g, "param", p) :- gap_reader(r, g, _, _), ets_key(r, "param", p).

key_needed(g, k, s) :-
  gap_reader(r, g, _, _),
  ets_key(r, ks, _),
  ks != "param",
  site_reads(r, g, k, s).

key_needed(c, k, s) :-
  key_needed(g, "param", p),
  call_arg_reads(c, g, n, k, s),
  p = to_string(n).

key_needed(h, k, s) :- key_needed(_, "call", h), returns_depends(h, k, s).

.decl from_table(func: symbol, kind: symbol, src: symbol, tk: symbol, t: symbol)

from_table(g, "site", ra, tk, t) :-
  key_needed(g, "site", ra),
  ets_op(ra, g, _, _, "read"),
  ets_table(ra, tk, t).

from_table(g, "call", h, tk, t) :-
  key_needed(g, "call", h),
  returns_depends(h, k, s),
  from_table(h, k, s, tk, t).

from_table(g, "param", p, tk, t) :-
  key_needed(g, "param", p),
  call_arg_reads(c, g, n, k, s),
  p = to_string(n),
  from_table(c, k, s, tk, t).

// Sources whose origin the program does not show.
.decl open_source(func: symbol, kind: symbol, src: symbol)

open_source(g, "param", p) :- key_needed(g, "param", p), api_export(g).
open_source(g, "param", p) :- key_needed(g, "param", p), fun_ref(_, g).
open_source(g, "call", h) :- key_needed(g, "call", h), !returns_depends(h, _, _).
open_source(g, k, s) :- key_needed(g, "param", p), call_arg_reads(c, g, n, k, s), p = to_string(n), open_source(c, k, s).
open_source(g, "call", h) :- key_needed(g, "call", h), returns_depends(h, k, s), open_source(h, k, s).

// A key whose origin the program does not show can hold V when the
// reader reads another table than the one V is published in: every key
// of that table is a value like V. In a table that holds both rows (a
// map that goes both ways), such a key may as well be the published
// row's own, whose row is written first: there the reader must take V
// from the table.
.decl key_may_come_from(r: symbol, tk: symbol, t: symbol)

key_may_come_from(r, tk, t) :-
  gap_reader(r, g, tk, t),
  ets_key(r, "param", p),
  from_table(g, "param", p, tk, t).

key_may_come_from(r, tk, t) :-
  gap_reader(r, g, tk, t),
  ets_key(r, "param", p),
  open_source(g, "param", p),
  !ets_table(r, tk, t).

key_may_come_from(r, tk, t) :-
  gap_reader(r, g, tk, t),
  ets_key(r, ks, _),
  ks != "param",
  site_reads(r, g, k, s),
  from_table(g, k, s, tk, t).

key_may_come_from(r, tk, t) :-
  gap_reader(r, g, tk, t),
  ets_key(r, ks, _),
  ks != "param",
  site_reads(r, g, k, s),
  open_source(g, k, s),
  !ets_table(r, tk, t).

// The writers and readers whose processes are asked about: the race
// but for the processes.
.decl gap_read(writer: symbol, reader_func: symbol)

gap_read(writer, reader_func) :-
  publishes_early(writer, publish, complete),
  fails_if_row_missing(reader, reader_func),
  looks_up_row_of(reader, complete),
  finds_published_value(reader, publish).

runs.seed(f) :- gap_read(f, _).
runs.seed(g) :- gap_read(_, g).

// The reader can run while the writer is between the two writes: in
// more than one process, or in a process other than the writer's.
.decl can_read_in_the_gap(writer: symbol, reader_func: symbol)

can_read_in_the_gap(f, g) :- gap_read(f, g), !runs.single_process(f).
can_read_in_the_gap(f, g) :- gap_read(f, g), !runs.single_process(g).

can_read_in_the_gap(f, g) :-
  gap_read(f, g),
  runs.beside_single_process(f, g).

// A table is spelled by its identity's kind and the identity: "named" and
// the name, "new" and the :ets.new/2 site, or "field" and the module and
// the path it is kept under.
.decl ets_publish_order(mod: symbol, func: symbol, published_kind: symbol, published_in: symbol, completed_kind: symbol, completed_in: symbol, publish: symbol, complete: symbol, reader: symbol)
.output ets_publish_order

ets_publish_order(mod, writer, pub_kind, pub_table, row_kind, row_table, publish, complete, reader) :-
  publish_order_race(writer, publish, complete, reader, _),
  in_module(writer, mod),
  table_of(publish, pub_kind, pub_table),
  table_of(complete, row_kind, row_table),
  table_of(reader, row_kind, row_table).

.decl table_of(op: symbol, table_kind: symbol, table: symbol) inline

table_of(op, tk, t) :- ets_table(op, tk, t).

// ── Read, then a row that may be gone ────────────────────────────
//
// `case :ets.lookup(t, k) do [_] -> :ets.update_counter(t, k, {2, 1})`
// decides that the row is there and acts on it with an operation that
// raises when it is not (update_counter/3, lookup_element/3). No write of
// the key is lost — the act's own failure is the bug: another process
// that takes or deletes the row between the two leaves the act a missing
// key, and the process that only meant to count crashes with badarg.
// sequin's DebouncedLogger counts repeats of a log line this way while a
// timer's flush, in a process of its own, takes the row.
//
// The pair is CheckThenAct's (clientlib/check_then_act.dl): a deciding
// read and a raising act on one table and key, in one function or across
// the functions the read's result reaches. The row's remover is any
// operation that deletes rows of that table — take, delete, a
// delete_object, select_delete or match_delete, or deleting the table —
// in a function that can run while the pair's function is between the
// two. The key is asked of the remover only to rule it out: a flush keyed
// by the arguments a timer was handed is not a key the facts can equate
// to the check's, so a remover counts unless its key can never be the
// pair's. A process's own row (keyed by self()) is removed by the
// process that owns it, and one removing self()'s row in another process
// removes that process's; a literal key names a row of its own, other
// than a different literal's and than the rows kept beside it under keys
// callers pass (a `:__total__` next to the keyed counts).

.init missing = CheckThenAct

missing.check(read, func, lifted_kind, table, key_kind, key) :-
  deciding_read(read, func),
  table_and_key(read, table_kind, table, key_kind, key),
  table_kind_as(table_kind, lifted_kind).

missing.act(act, func, lifted_kind, table, key_kind, key) :-
  raises_if_row_missing(act, func),
  table_and_key(act, table_kind, table, key_kind, key),
  table_kind_as(table_kind, lifted_kind).

// A table's kind as CheckThenAct lifts it across calls: a named table and
// an :ets.new/2 site are the same table in every function; a table a
// module keeps under a field of its own is, within the module
// (check_then_act.dl's global_identity and module_identity).
.decl table_kind_as(table_kind: symbol, lifted_kind: symbol)

table_kind_as("named", "named").
table_kind_as("new", "new").
table_kind_as("field", "module field").

// The rule is written in the words below, one per line, each over a
// whole table: a table is its kind and identity together (ets_table's
// two columns: EtsTable, clientlib/tables.dl), so no line has to spell
// the kind.

// A read that decides whether a row is there.
.decl checks_row_exists(check: symbol) inline

checks_row_exists(check) :- deciding_read(check, _).

// An operation that raises when the row is missing, and the raise
// escapes (clientlib/escape.dl): no handler that takes the ArgumentError
// covers the act, nor any call on some path from `func` down to the act,
// nor every call to `func`. `func` is where the check's result meets the
// act, or, for a publish-order reader, the reader's own function.
.decl fails_if_row_missing(act: symbol, func: symbol)

fails_if_row_missing(act, func) :-
  missing.meets(func, _, act, _, _, _, _),
  row_miss.escapes(act, func, "badarg").

fails_if_row_missing(reader, reader_func) :-
  reads_completed_row(reader, reader_func),
  row_miss.escapes(reader, reader_func, "badarg").

// Asked of the act's site and of the calls that lead to it, not of whole
// functions: a `rescue` around unrelated code after the act does not
// take the act's ArgumentError, and a handler around the call to a
// helper does.
.init row_miss = Escape

row_miss.asked(act, g, f, "badarg") :-
  missing.meets(f, _, act, _, _, _, _),
  raises_if_row_missing(act, g).

row_miss.asked(reader, g, g, "badarg") :- reads_completed_row(reader, g).

// A read that raises on a missing row of a table an early publish
// completes: the reader of a publish-order race, whose raise is asked
// from its own function.
.decl reads_completed_row(reader: symbol, reader_func: symbol)

reads_completed_row(r, g) :-
  publishes_early(_, _, complete),
  raises_if_row_missing(r, g),
  looks_up_row_of(r, complete).

// The act's table is one another process can read. A named table the
// program does not show being made — by a dependency, or under a name
// that arrives at runtime (`:ets.new(name, ...)` in a function nothing
// calls with a literal) — is taken to be shared: nothing says it is
// private, and an update from a process that is not its owner needs it
// public.
.decl shared_table(act: symbol, table: EtsTable) inline

shared_table(act, [tk, t]) :- readable_elsewhere(act, tk, t).
shared_table(act, ["named", t]) :- ets_table(act, "named", t), !made_in_view("named", t).

.decl made_in_view(kind: symbol, ident: symbol)

made_in_view(k, t) :- site_table(_, k, t).

// An operation that deletes rows of the table: take, delete,
// delete_object, select_delete, match_delete, or deleting them all.
.decl removes_rows(remover: symbol, table: EtsTable)

removes_rows(d, [tk, t]) :-
  ets_op(d, _, _, op, _),
  ets_removal_op(op),
  ets_table(d, tk, t).

// The pairs the rule asks about, for the questions it asks of processes.
.decl found_row_act(func: symbol, table: EtsTable)

found_row_act(func, table) :-
  decides(func, _, act, [table, _, _]),
  fails_if_row_missing(act, func),
  shared_table(act, table).

// The keys of those pairs, the only keys a removal's key is compared with.
.decl found_key(key_kind: symbol, key: symbol)

found_key(ks, k) :-
  decides(func, _, act, [table, ks, k]),
  fails_if_row_missing(act, func),
  shared_table(act, table).

.decl remover_in(remover: symbol, func: symbol)

remover_in(d, h) :- found_row_act(_, table), removes_rows(d, table), ets_op(d, h, _, _, _).

runs.seed(f) :- found_row_act(f, _).
runs.seed(h) :- remover_in(_, h).

// The remover's key can never be the pair's key (ks, k).
.decl keyed_apart(remover: symbol, key_kind: symbol, key: symbol)

keyed_apart(d, "self", "") :- remover_in(d, _), ets_key(d, "self", "").
keyed_apart(d, "self", "") :- remover_in(d, _), ets_key(d, "literal", _).
keyed_apart(d, "literal", k) :- remover_in(d, _), ets_key(d, "self", ""), found_key("literal", k).

keyed_apart(d, "literal", k) :-
  remover_in(d, _),
  ets_key(d, "literal", k2),
  found_key("literal", k),
  k != k2.

keyed_apart(d, ks, k) :-
  remover_in(d, _),
  ets_key(d, "literal", _),
  found_key(ks, k),
  ks != "literal",
  ks != "self",
  ks != "any".

// A row: a table and one key of it, as CheckThenAct lifts the key
// (key_kind names what the key is: a literal, the caller's argument, ...).
.type EtsRow = [table: EtsTable, key_kind: symbol, key: symbol]

// In `func`, the check's result decides whether the use runs, on one row
// (CheckThenAct's meets, followed across calls).
.decl decides(func: symbol, check: symbol, use: symbol, row: EtsRow)

decides(func, check, use, [[tk, t], ks, k]) :-
  missing.meets(func, check, use, lifted_kind, t, ks, k),
  table_kind_as(tk, lifted_kind).

// The use's table is one other processes can reach.
.decl on_shared_table(use: symbol) inline

on_shared_table(use) :- ets_table(use, tk, t), shared_table(use, [tk, t]).

// A removal on the row's table whose key can be the row's key.
.decl removes_row(remove: symbol, row: EtsRow) inline

removes_row(remove, [table, ks, k]) :-
  removes_rows(remove, table),
  !keyed_apart(remove, ks, k).

// The removal runs in a process other than the one running `func`: `func`
// runs in more than one process, or the removal runs beside it
// (beside_single_process, clientlib/concurrency.dl). Nothing orders two
// processes, so another process can always run between the check and the
// use.
.decl runs_in_another_process(remove: symbol, func: symbol)

runs_in_another_process(d, f) :-
  found_row_act(f, table),
  removes_rows(d, table),
  !runs.single_process(f).

runs_in_another_process(d, f) :-
  found_row_act(f, table),
  removes_rows(d, table),
  remover_in(d, h),
  runs.beside_single_process(f, h).

// A check decides a row is there, a use that fails when the row is missing
// relies on it, and another process can remove the row in between.
.decl missing_row_race(func: symbol, check: symbol, use: symbol, remove: symbol, row: EtsRow)

missing_row_race(func, check, use, remove, row) :-
  checks_row_exists(check),
  decides(func, check, use, row),
  fails_if_row_missing(use, func),
  on_shared_table(use),
  removes_row(remove, row),
  runs_in_another_process(remove, func).

.decl ets_missing_row(mod: symbol, func: symbol, table_kind: symbol, table: symbol, check: symbol, act: symbol, remover: symbol)
.output ets_missing_row

ets_missing_row(mod, func, table_kind, table, check, use, remove) :-
  missing_row_race(func, check, use, remove, [[table_kind, table], _, _]),
  in_module(func, mod).

// ── Dirty read, then dirty write ─────────────────────────────────
//
// Mnesia serializes what runs inside a transaction; its dirty operations
// bypass that, and a dirty_read whose result decides or feeds a
// dirty_write of the same record is the read-modify-write another process
// can interleave. The paper's instance is the snmp agent's time-stamp
// counter: read, add one, write back. A Mnesia table is shared by every
// process on every node, so no access mode excuses it; one process that
// is the table's only writer does. :mnesia.transaction/1 and
// dirty_update_counter are the fixes.
//
// Known limit: "one process" is one per node. A server registered under
// a local name runs once on each node, and a table replicated to several
// nodes (ram_copies or disc_copies on more than one) is written by each
// node's owner, so the excuse is unsound there. It is kept: whether a
// table is replicated is create_table's copies lists, which are almost
// always computed at runtime (`[node() | Node.list()]`, config) and which
// the facts do not show, and honouring the excuse only for a :global or
// :via owner would report every locally registered owner on a
// single-node deployment, the common case.

// A dirty read decides or feeds a dirty write of the same record,
// another process can write the table between the two, no cluster lock
// every writer takes serializes them, and what the interleaving costs
// has a witness. `func` is where the read's result reaches the write.
.decl dirty_read_then_write_race(func: symbol, read: symbol, write: symbol, record: MnesiaRecord, harm: symbol)

dirty_read_then_write_race(func, read, write, [table, key], harm) :-
  decides_dirty_write(func, read, write, [table, key]),
  written_by_another_process(table, func),
  !serialized_by_lock(func, table),
  harms_record(func, read, write, harm).

// A record: a Mnesia table, by name, and a key of it. A Mnesia table is
// not an EtsTable: it has a name and nothing else (no reference to
// follow, no unnamed kind), one name the whole cluster shares, and an
// ETS table of the same name is another table.
.type MnesiaRecord = [table: symbol, key: symbol]

// In `func`, the dirty read's result decides whether the dirty write
// runs, or feeds what it stores, on one record (reads_then_writes_record,
// below).
.decl decides_dirty_write(func: symbol, read: symbol, write: symbol, record: MnesiaRecord) inline

decides_dirty_write(f, r, w, [t, k]) :- reads_then_writes_record(f, r, w, t, k).

// What the interleaving costs, by a witness (record_race_kind, below):
// asked only of the pairs another process can interleave.
.decl harms_record(func: symbol, read: symbol, write: symbol, harm: symbol) inline

harms_record(f, r, w, k) :- record_race_kind(f, r, w, k).

.init records = CheckThenAct

records.check(read, func, table_kind, table, key_kind, key) :-
  mnesia_op(read, func, _, "read", table_kind, table, key_kind, key).

records.act(write, func, table_kind, table, key_kind, key) :-
  mnesia_op(write, func, op, "write", table_kind, table, key_kind, key),
  dirty_write_op(op).

// The dirty writes, the acts. A transaction's writes and
// dirty_update_counter write the table too (the other writer, and what
// writes a table back), but are not the race's act.
.decl dirty_write_op(op: symbol)

dirty_write_op("dirty_write").
dirty_write_op("dirty_delete").
dirty_write_op("dirty_delete_object").

.decl reads_then_writes_record(func: symbol, read: symbol, write: symbol, table: symbol, key: symbol)

reads_then_writes_record(f, r, w, t, k) :- records.meets(f, r, w, "literal", t, _, k).
reads_then_writes_record(f, r, w, t, k) :- records.meets(f, r, w, "param", p, _, k), record_table_at_param(f, p, t).
reads_then_writes_record(f, r, w, t, k) :- records.meets(f, r, w, "element 0", p, _, k), table_at_record(f, p, t).

// The Mnesia table a parameter holds where a pair meets on it or a
// write writes it: a name a caller passes there, through any
// forwarding.
.decl record_table_needed(func: symbol, pos: symbol)

record_table_needed(f, p) :- records.meets(f, _, _, "param", p, _, _).

record_table_needed(c, to_string(m)) :-
  record_table_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n).

.decl record_table_at_param(func: symbol, pos: symbol, name: symbol)

record_table_at_param(f, p, name) :-
  record_table_needed(f, p),
  call_arg(_, f, n, name),
  name != "dynamic",
  p = to_string(n).

record_table_at_param(f, p, name) :-
  record_table_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n),
  record_table_at_param(c, to_string(m), name).

// A record handed in whole names its table in its first element: the
// callers' tuples say which (elvengard_ecs's insert_new(record), called
// with `entity(id: id, ...)`), through any parameter that forwards it.
.decl record_param_needed(func: symbol, pos: symbol)

record_param_needed(f, p) :- records.meets(f, _, _, "element 0", p, _, _).
record_param_needed(c, to_string(m)) :-
  record_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n).

.decl table_at_record(func: symbol, pos: symbol, name: symbol)

table_at_record(f, p, t) :-
  record_param_needed(f, p),
  call_arg_tuple(_, f, n, 0, "literal", t),
  p = to_string(n).

table_at_record(f, p, t) :-
  record_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n),
  table_at_record(c, to_string(m), t).

runs.seed(f) :- reads_then_writes_record(f, _, _, _, _).
runs.seed(f) :- mnesia_op(_, f, _, "write", _, _, _, _).

// Another process can write the table while `func` is between the read
// and the write: `func` runs in more than one process, or it runs in one
// and a writer of the table runs beside it.
.decl written_by_another_process(table: symbol, func: symbol)

written_by_another_process(t, f) :-
  reads_then_writes_record(f, _, _, t, _),
  !runs.single_process(f).

written_by_another_process(t, f) :-
  reads_then_writes_record(f, _, _, t, _),
  mnesia_write_table(_, g, t),
  runs.beside_single_process(f, g).

// ── A cluster lock every writer takes ──
//
// Dirty operations skip Mnesia's locks, not an external mutex: a pair in
// a closure `:global.trans/2` runs, on a table every writer writes under
// such a closure too, is serialized. A closure is taken to run under the
// lock when the function that builds it calls :global.trans (the facts
// do not say which closure a call is handed), and so is a private
// function only such closures call. The lock's identity is not compared:
// writers under different locks are taken as serialized, so the rule
// stays quiet where it cannot tell.
.decl locked_closure(func: symbol)

locked_closure(c) :- global_op(_, f, "trans", _, _), closure_def(f, c).

.decl called_unlocked(func: symbol)

called_unlocked(g) :- mnesia_write_table(_, g, _), call_edge(h, g), !locked_closure(h).

.decl under_lock(func: symbol)

under_lock(g) :- locked_closure(g).

under_lock(g) :-
  mnesia_write_table(_, g, _),
  function_def(g, _, _, _, 0),
  call_edge(_, g),
  !called_unlocked(g).

.decl unlocked_writer(table: symbol)

unlocked_writer(t) :- mnesia_write_table(_, g, t), !under_lock(g).

.decl serialized_by_lock(func: symbol, table: symbol)

serialized_by_lock(f, t) :-
  reads_then_writes_record(f, _, _, t, _),
  under_lock(f),
  !unlocked_writer(t).

// The table a Mnesia write touches, by name: spelled there, named by
// what callers pass the parameter it arrives in, or the first element of
// the record callers build and hand it (`defp save(rec), do:
// :mnesia.dirty_write(rec)`). A transaction's write and the atomic
// counter are writes too: a dirty read-modify-write takes no lock, and
// either can land between its read and its write.
.decl mnesia_write_table(write: symbol, func: symbol, table: symbol)

mnesia_write_table(w, f, t) :- mnesia_op(w, f, _, "write", "literal", t, _, _).

mnesia_write_table(w, f, t) :-
  mnesia_op(w, f, _, "write", "param", p, _, _),
  record_table_at_param(f, p, t).

mnesia_write_table(w, f, t) :-
  mnesia_op(w, f, _, "write", "element 0", p, _, _),
  table_at_record(f, p, t).

record_param_needed(f, p) :- mnesia_op(_, f, _, "write", "element 0", p, _, _).

// A dirty write that stores what a read of Mnesia returned, or a value
// made of it, by any caller's path (MadeOfRead, clientlib/check_then_act.dl):
// a writer that writes the table back, the Mnesia twin of counting in it.
.init record_made = MadeOfRead

record_made.read(r) :- mnesia_op(r, _, _, "read", _, _, _, _).
record_made.write(w, h) :- mnesia_write_table(w, h, _), mnesia_op(w, _, op, _, _, _, _, _), (op = "dirty_write" ; op = "write").

record_table_needed(f, p) :- mnesia_op(_, f, _, "write", "param", p, _, _).

// A pair another process can interleave: the race but for its harm,
// what the harms below are asked of.
.decl racing_record_pair(func: symbol, read: symbol, write: symbol)

racing_record_pair(f, r, w) :-
  reads_then_writes_record(f, r, w, t, _),
  written_by_another_process(t, f),
  !serialized_by_lock(f, t).

// Which dirty operation a Mnesia call is.
.decl dirty_op(site: symbol, op: symbol) inline

dirty_op(site, op) :- mnesia_op(site, _, op, _, _, _, _, _).

// ── What another writer does to the record ──
//
// The ETS rule's rivals (above), for records: a write of the table, in a
// transaction or dirty, that can land on the pair's record between the
// read and the write, in a process other than the pair's (or any, when
// the pair runs in more than one), after its own process has started.
// Two writes name different records when both keys are literals that
// differ, or when one is minted where it is written (a random token, a
// fresh reference or unique integer): a record no one could have read
// before. A key a parameter carries is any record.
.decl record_rival(func: symbol, read: symbol, write: symbol, rival_write: symbol, rival_func: symbol)

record_rival(f, r, w, w2, g) :-
  racing_record_pair(f, r, w),
  reads_then_writes_record(f, r, w, t, _),
  !runs.single_process(f),
  mnesia_write_table(w2, g, t),
  w2 != w,
  writes_after_start(g),
  !records_apart(w, w2).

record_rival(f, r, w, w2, g) :-
  racing_record_pair(f, r, w),
  reads_then_writes_record(f, r, w, t, _),
  runs.single_process(f),
  runs.entry_reaches(m, f),
  mnesia_write_table(w2, g, t),
  runs.runs_beside_up(m, f, g, g),
  !records_apart(w, w2).

writer_walk.seed(g, g) :- mnesia_write_table(_, g, _).

.decl records_apart(write: symbol, rival_write: symbol)

records_apart(w, w2) :-
  racing_record_pair(_, _, w),
  mnesia_op(w, _, _, _, _, _, "literal", k),
  mnesia_write_table(w2, _, _),
  mnesia_op(w2, _, _, _, _, _, "literal", k2),
  k != k2.

records_apart(w, w2) :-
  racing_record_pair(_, _, w),
  mnesia_write_table(w2, _, _),
  mnesia_op(w2, _, _, _, _, _, "local", made),
  minted_value(made).

// A value no other equals: made by a call that mints it (a reference, a
// monitor, a unique integer, a random value), or by a project function
// that returns one.
.decl minted_value(site: symbol)

minted_value(made) :- remote_call(made, _, m, n, a), minting_call(m, n, a).
minted_value(made) :- remote_call(made, _, m, n, a), mints(cat(m, ":", n, "/", to_string(a))).
minted_value(made) :- local_call(made, _, g, _), mints(g).

// A writer that writes the record back from a read, or counts in it.
.decl record_counts_in(write: symbol)

record_counts_in(w) :- record_made.stores(w).
record_counts_in(w) :- mnesia_op(w, _, "dirty_update_counter", _, _, _, _, _).

// A writer that removes the record.
.decl record_removes(write: symbol)

record_removes(w) :-
  mnesia_op(w, _, op, "write", _, _, _, _),
  (op = "dirty_delete" ; op = "delete" ; op = "dirty_delete_object" ; op = "delete_object").

// A writer that stores a record of its own: not a cached copy, which is
// some pair's fill of a value a call or another store made on a read that
// found the record missing (PairCarries' fills, as the ETS rule's
// refill_row).
.decl record_makes_own(write: symbol)

record_makes_own(w) :-
  mnesia_op(w, _, op, "write", _, _, _, _),
  (op = "dirty_write" ; op = "write"),
  !record_carried.fills(_, _, w).

// ── Which race a pair is ──
//
// Every pair above is a read deciding or feeding a dirty write another
// process can interleave. It is a race when what the interleaving costs
// has a witness, and the finding says which (`kind`):
//
// - unique: a search — a secondary index, a match spec, a pattern whose
//   key is `:_` (`searches`) — finds nothing, and a new record is
//   written: blockster's referral earnings, deduplicated by an index read
//   of the commitment hash and stored under a fresh UUID. Two racers both
//   find nothing and both insert, under keys of their own: the duplicate
//   the search was there to prevent, which no retry of either write
//   undoes;
// - lost_update: the write stores a value made of what this pair's read
//   returned (PairCarries): each racer adds to the count it read, and one
//   addition vanishes;
// - guarded: the decision compares a field of the record with the value
//   the write stores (ztlp's serial check): both pass, and the older can
//   land last;
// - claim: the write's decision leaves the function as a verdict, not as
//   the record (what the function returns depends on the read by control
//   alone): both racers are told they won (elvengard_ecs's insert_new).
//   A get-or-create that answers with the record, an upsert that returns
//   what it wrote, and a cache-aside that returns its value answer with
//   data, and are no claims;
// - delete: the read decides a dirty delete, and something makes the
//   interleaving cost more than deleting twice: the decision looks at
//   what the record holds and a rival writes the record back, counts in
//   it, or makes it again with a record of its own (a lease another
//   process took over: the delete takes the new owner's record), or the
//   decision also sends, or hands out the record it removes (both racers
//   take it). A dirty_delete_object deletes only the record it read, and
//   loses only to the last two;
// - decides_more: the read's decision runs more than the write — a send,
//   an outside effect, another write on the same path (`record_decides_
//   more`): an idempotency marker whose decision also records a charge,
//   and both racers mark and charge;
// - fill: the write stores a record computed afresh, not made of the
//   read, and a rival removes the record, writes it with a record of its
//   own or counts in it between the two: the fill computed before the
//   rival lands after it (a stale cache fill), weaker than a lost update.
//
// No witness, no race: a dirty delete of an expired nonce nothing
// recreates, an ensure-default both racers write alike.
//
// A finding is one per write: the pairs a write is in, reported at the
// one whose kind is the strongest, then the one whose read sits in the
// write's own function — the read that decides the write where it is,
// not a read further up that a fresh read nearer the write shadows —
// then the least read. The other reads, the other writes of the same
// race and, for a pair that runs in one process, the writer outside it
// are related frames (mnesia_race_frame). A fill whose read also decides
// a stronger race on another write is that race's other branch, and a
// write in the same function, decided by the same read in the same way,
// is the same race's other branch too: one finding, at the earliest.

// A read that finds records by something other than their key.
.decl searches(read: symbol)

searches(r) :- mnesia_op(r, _, _, "read", _, _, "any", _).

// Made of this pair's read (PairCarries, clientlib/check_then_act.dl).
.init record_carried = PairCarries

record_carried.pair(f, r, w) :- racing_record_pair(f, r, w).
record_carried.read_in(r, g) :- mnesia_op(r, g, _, "read", _, _, _, _).
record_carried.write_in(w, h) :- records.act(w, h, _, _, _, _).
record_carried.fresh(kind, src) :- fill_source(kind, src).

// The decision a pair makes leaves the function, as decision_escapes
// asks of ETS.
.decl record_decision_returned(meet: symbol, func: symbol, check: symbol)

record_decision_returned(f, f, c) :-
  reads_then_writes_record(f, c, _, _, _),
  records.carries(f, kind, src, c, _, _, _, _),
  returns_depends(f, kind, src).

record_decision_returned(f, g, c) :-
  record_decision_returned(f, h, c),
  records.carries(g, "call", h, c, _, _, _, _),
  returns_depends(g, "call", h).

.decl record_decision_escapes(meet: symbol, check: symbol)

record_decision_escapes(f, c) :-
  record_decision_returned(f, g, c),
  call_decided(_, _, "call", g).

record_decision_escapes(f, c) :-
  record_decision_returned(f, g, c),
  api_export(g),
  !callee_returns(g, "constant").

// The pair's own path, as pair_path is for ETS.
.decl record_path(meet: symbol, check: symbol, func: symbol)

record_path(f, c, f) :- reads_then_writes_record(f, c, _, _, _).
record_path(f, c, g) :- reads_then_writes_record(f, c, _, _, _), records.carried_through(f, c, g).

// The ETS rule's decision_sends, for records (DecisionSends).
.init record_sends = DecisionSends

record_sends.carried(f, g, kind, src, r) :-
  record_path(f, r, g),
  records.carries(g, kind, src, r, _, _, _, _).

.decl record_decision_sends(meet: symbol, read: symbol)

record_decision_sends(f, r) :- record_sends.sends(f, r).

// A guard on what the record holds: a field past the table and the key
// (element 2 on) compared with a value the write stores.
.decl guards_record(meet: symbol, read: symbol, write: symbol)

guards_record(f, r, w) :-
  reads_then_writes_record(f, r, w, _, _),
  record_path(f, r, g),
  records.carries(g, kind, src, r, _, _, _, _),
  field_compared(g, kind, src, pos, ok, os),
  pos >= 2,
  records.act(w, g, _, _, _, _),
  site_reads(w, g, ok, os).

guards_record(f, r, w) :-
  reads_then_writes_record(f, r, w, _, _),
  record_path(f, r, g),
  records.carries(g, kind, src, r, _, _, _, _),
  field_compared(g, kind, src, pos, ok, os),
  pos >= 2,
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "param", q),
  call_arg_reads(g, h, n, ok, os),
  q = to_string(n).

// Another dirty write in the write's own function on a path that
// excludes this one: the upsert's other branch (`[] -> insert; [r] ->
// update r`), which the read chooses between. That the decision makes
// one of two writes is not a decision that does more than write. A
// second write the same path also makes — a marker, then the charge it
// guards — is.
.decl other_branch(site: symbol, write: symbol)

other_branch(s, w) :-
  reads_then_writes_record(_, _, w, _, _),
  exclusive_writes(s, w).

// Two dirty writes of one function that no trip through the function
// makes both of (mnesia_write_order orders neither).
.decl exclusive_writes(first: symbol, second: symbol)

exclusive_writes(w1, w2) :-
  mnesia_op(w1, h, "dirty_write", _, _, _, _, _),
  mnesia_op(w2, h, "dirty_write", _, _, _, _, _),
  w1 != w2,
  !mnesia_write_order(h, w1, w2),
  !mnesia_write_order(h, w2, w1).

// The decision the read makes where it meets the write runs more than
// the write: a send, an outside effect, another write on the same path —
// a marker whose decision also records a charge. Both racers find no
// marker, both mark, and both charge. Asked where the pair meets.
.decl decides_more_here(func: symbol, read: symbol, write: symbol)

decides_more_here(f, r, w) :-
  racing_record_pair(f, r, w),
  records.carries(f, kind, src, r, _, _, _, _),
  effect_decided(f, kind, src).

decides_more_here(f, r, w) :-
  racing_record_pair(f, r, w),
  records.carries(f, kind, src, r, _, _, _, _),
  site_depends(s, f, kind, src),
  s != w,
  shared_write(s),
  !other_branch(s, w).

.decl record_race_kind(func: symbol, read: symbol, write: symbol, kind: symbol)

// A search whose write carries what it read is a lost update, not a
// unique claim.
record_race_kind(f, r, w, "unique") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  searches(r),
  !record_carried.carries(f, r, w).

record_race_kind(f, r, w, "lost_update") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  record_carried.carries(f, r, w).

record_race_kind(f, r, w, "guarded") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  guards_record(f, r, w).

record_race_kind(f, r, w, "claim") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  record_decision_escapes(f, r),
  !record_carried.answers(f, r).

record_race_kind(f, r, w, "decides_more") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  decides_more_here(f, r, w).

record_race_kind(f, r, w, "fill") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  record_rival(f, r, w, w2, _),
  (record_counts_in(w2) ; record_removes(w2) ; record_makes_own(w2)).

// A delete of the record by its key, made on what the record holds,
// loses to a rival that writes the record back, counts in it, or makes it
// again with a record of its own: the delete takes a record its decision
// never saw. Made on the record's presence alone, it ends as the rival's
// write then the delete would.
record_race_kind(f, r, w, "delete") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_delete", _, _, _, _, _),
  tests_record_fields(f, r),
  record_rival(f, r, w, w2, _),
  (record_counts_in(w2) ; record_makes_own(w2)).

// Any delete whose decision also sends, or that hands out the record it
// removes: both racers send, or both take the record.
record_race_kind(f, r, w, "delete") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, op, _, _, _, _, _),
  (op = "dirty_delete" ; op = "dirty_delete_object"),
  record_decision_sends(f, r).

record_race_kind(f, r, w, "delete") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, op, _, _, _, _, _),
  (op = "dirty_delete" ; op = "dirty_delete_object"),
  record_decision_escapes(f, r),
  record_carried.answers(f, r).

// The decision looks at what the record holds, past the table and the
// key (element 2 on).
.decl tests_record_fields(meet: symbol, read: symbol)

tests_record_fields(f, r) :-
  racing_record_pair(f, r, _),
  record_path(f, r, g),
  records.carries(g, kind, src, r, _, _, _, _),
  field_decides(g, kind, src, pos),
  pos >= 2.

tests_record_fields(f, r) :-
  racing_record_pair(f, r, _),
  record_path(f, r, g),
  records.carries(g, kind, src, r, _, _, _, _),
  call_arg_depends(g, h, n, kind, src),
  field_decides(h, "param", q, pos),
  q = to_string(n),
  pos >= 2.

.decl kind_rank(kind: symbol, rank: number)

kind_rank("unique", 0).
kind_rank("lost_update", 1).
kind_rank("guarded", 2).
kind_rank("claim", 3).
kind_rank("delete", 3).
kind_rank("decides_more", 4).
kind_rank("fill", 5).

// A read's weaker pairs where it meets its writes are branches of its
// strongest race there: the `[] -> insert` beside the `[r] -> write back
// r + 1` of one counter is one race, reported where it loses the most.
// Per meeting function: a get/1 helper two functions share decides a
// write-back in one and a delete in the other, two races.
.decl read_rank(func: symbol, read: symbol, rank: number)

read_rank(f, r, n) :-
  dirty_read_then_write_race(f, r, _, _, _),
  n = min m : { dirty_read_then_write_race(f, r, _, _, k), kind_rank(k, m) }.

// A write its own function reads before, and decides on, is judged by
// that read: a read further up is not the one the write acts on, unless
// it is also the value the local pair writes back (a frame, then).
.decl read_in_own_function(write: symbol)

read_in_own_function(w) :- reads_then_writes_record(h, _, w, _, _), records.act(w, h, _, _, _, _).

.decl ranked_race(func: symbol, read: symbol, write: symbol, kind: symbol, rank: number)

ranked_race(f, r, w, k, n) :-
  dirty_read_then_write_race(f, r, w, _, k),
  kind_rank(k, n),
  read_rank(f, r, n),
  records.act(w, f, _, _, _, _).

ranked_race(f, r, w, k, n) :-
  dirty_read_then_write_race(f, r, w, _, k),
  kind_rank(k, n),
  read_rank(f, r, n),
  records.act(w, h, _, _, _, _),
  h != f,
  !read_in_own_function(w).

// One finding per write (OnePerWrite): at its strongest kind, then the
// least read, then the least function.
.init record_writes = OnePerWrite

record_writes.race(f, r, w, k, n) :- ranked_race(f, r, w, k, n).
record_writes.write_in(w, h) :- ranked_race(_, _, w, _, _), records.act(w, h, _, _, _, _).

.decl mnesia_check_act(mod: symbol, func: symbol, table: symbol, key: symbol, read: symbol, write: symbol, op: symbol, kind: symbol)
.output mnesia_check_act

mnesia_check_act(mod, func, table, key, read, write, op, harm) :-
  record_writes.reported(func, read, write, harm),
  dirty_read_then_write_race(func, read, write, [table, key], harm),
  dirty_op(write, op),
  in_module(func, mod).

// ── What else the finding points at ──
//
// `role`: "also_writes", a later write of the same race; "other_writer",
// for a pair that runs in one process, a write of the table outside that
// process; "read", another read that decides or feeds the write.
.decl mnesia_race_frame(write: symbol, role: symbol, site: symbol, func: symbol)
.output mnesia_race_frame

mnesia_race_frame(w1, "also_writes", w2, f) :- record_writes.also_writes(w1, w2, f).

mnesia_race_frame(w, "other_writer", o, g) :-
  mnesia_check_act(_, f, t, _, _, w, _, _),
  mnesia_write_table(o, g, t),
  runs.beside_single_process(f, g).

mnesia_race_frame(w, "read", r2, f2) :-
  mnesia_check_act(_, _, _, _, r, w, _, _),
  racing_record_pair(f2, r2, w),
  r2 != r.
