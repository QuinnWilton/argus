// Check, then act: a read of shared state decides a write of the same
// thing, and another process can write it between the two (Christakis
// and Sagonas, PADL 2010). Three stores, one shape:
//
// - registry_race: a lookup of a process name decides a start,
//   registration or unregistration of the name;
// - ets_check_act: an ETS read decides or feeds a plain write of the
//   same key on a public table;
// - ets_missing_row: an ETS read decides a row is there and an act that
//   raises without it follows, while another process can remove the row;
// - mnesia_check_act: a dirty read decides or feeds a dirty write of
//   the same record.
//
// And one that is not check-then-act but shares the stores: a value
// published in one ETS table before the row another table keys by it
// exists (ets_publish_order).
//
// Which table an ETS operation touches is clientlib/tables.dl's
// ets_table, for the rules that ask across functions and modules.
//
// The check-then-act rules are CheckThenAct instances
// (clientlib/check_then_act.dl), which says where a check's result meets
// an act that depends on it, across functions. Whether a second process
// can run the function where they meet is one RunsConcurrently instance
// for all of them, seeded with every
// meeting and every write the rules ask about: what a function's
// callers are does not depend on which store it touches.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/request_entry.dl"
.include "../clientlib/concurrency.dl"
.include "../clientlib/check_then_act.dl"
.include "../clientlib/specs.dl"
.include "../clientlib/tables.dl"
.include "../clientlib/vocabulary.dl"

.init runs = RunsConcurrently

// ── Lookup, then start ───────────────────────────────────────────
//
// `case whereis(name) do nil -> start(name)` asks whether a name is
// taken and claims it when the answer is no, and nothing holds the name
// between the two: a second caller that asks in the same window gets
// the same answer, and one of the two starts loses. Christakis and
// Sagonas found this shape on the process registry in 2010 and Dialyzer
// reported it until OTP 25; the Elixir spellings are Registry.lookup
// before start_child, and whereis before register or a named start.
// Deciding on Process.registered/0 is the same race on every name at
// once, and Dialyzer's second registry warning was the release: whereis,
// then unregister, which raises when the process exited or another
// caller unregistered first.
//
// The lookup and the act may sit in different functions and meet where
// the lookup's result is born or returned to (clientlib/check_then_act.dl).
// They name the same thing when they agree on registry, source and key; a
// start_child hides its name in the child spec, so any lookup that is
// tested against nil and decides it counts. The race is not a bug when
// the loser's outcome is taken — {:error, {:already_started, pid}}
// compared where the pair meets, where the act is, or in a caller; an
// ArgumentError from register/2 or unregister/1 rescued — or when only
// one process ever runs the function where they meet.

.init names = CheckThenAct

// The resource is the registry: the local one (empty) or a Registry.
names.check(c, f, "literal", scope, ks, k) :-
  name_lookup(c, f, _, scope, ks, k, _),
  scope != "dynamic".

names.check(c, f, "dynamic", "", ks, k) :- name_lookup(c, f, _, "dynamic", ks, k, _).

names.act(a, f, "any", "", "any", "") :- creating_op(a, f, "start_child", _, _, _).

names.act(a, f, "literal", scope, ks, k) :-
  creating_op(a, f, api, scope, ks, k),
  api != "start_child",
  scope != "dynamic".

names.act(a, f, "dynamic", "", ks, k) :-
  creating_op(a, f, api, "dynamic", ks, k),
  api != "start_child".

names.act(a, f, "literal", "", ks, k) :- name_release(a, f, _, ks, k).

.decl name_act(act: symbol, func: symbol, api: symbol)

name_act(a, f, api) :- creating_op(a, f, api, _, _, _).
name_act(a, f, api) :- name_release(a, f, api, _, _).

// A loser is handled where its start's error is compared, or its :badarg
// rescued (rescues_argument_error, in exceptions.dl: `case catch
// register(N, self()) of true -> ...; _ -> exit({already_started, ...})`
// in inet_gethost_native), here or in a function its result returns to.
.decl start_error_handled(func: symbol)

start_error_handled(f) :- start_error_compared(f, _).
start_error_handled(f) :- call_edge(g, f), start_error_compared(g, _).
start_error_handled(f) :- rescues_argument_error(f).
start_error_handled(f) :- returns_call(g, f), start_error_handled(g).

// The loser's outcome is taken where the pair meets or where the act is.
.decl loser_taken(meet: symbol, act: symbol)

loser_taken(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, g, api),
  api != "unregister",
  (start_error_handled(f) ; start_error_handled(g)).

loser_taken(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, g, "unregister"),
  (rescues_argument_error(f) ; rescues_argument_error(g)).

// The loser's answer is a value — the start's spec can fail:
// {:error, {:already_started, pid}} — and nothing reads it on its way
// back to where the lookup decided: the start's result is not used
// where it is made, and every function that returns it on is one whose
// result nothing in the program uses, the meeting function not among
// them. Whichever start won, the name is registered, and what follows
// goes by the name (ssh_dbg:switch/2 → start/1, which drops
// start_server/0's gen_server:start). Only a named start: a start_child
// hides its name in the child spec, and an unnamed child's "loser" is a
// second process; a Registry.register loser is a process left
// unregistered. A start that raises for the loser (register/2,
// start_supervised!) is not this shape either.
.decl act_callee(act: symbol, callee: symbol)

act_callee(a, cat(m, ":", n, "/", to_string(ar))) :-
  name_act(a, _, _),
  remote_call(a, _, m, n, ar).

.decl act_result_read(act: symbol)

act_result_read(a) :- name_act(a, _, _), site_depends(_, _, "site", a).
act_result_read(a) :- name_act(a, _, _), call_decided(_, _, "site", a).
act_result_read(a) :- name_act(a, _, _), call_arg_depends(_, _, _, "site", a).

.decl act_returned_by(act: symbol, func: symbol)

act_returned_by(a, g) :- name_act(a, _, _), returns_depends(g, "site", a).
act_returned_by(a, h) :- act_returned_by(a, g), returns_depends(h, "call", g).

.decl result_used(func: symbol)

result_used(g) :- act_returned_by(_, g), site_depends(_, _, "call", g).
result_used(g) :- act_returned_by(_, g), call_decided(_, _, "call", g).
result_used(g) :- act_returned_by(_, g), call_arg_depends(_, _, _, "call", g).

.decl loser_dropped(meet: symbol, act: symbol)

loser_dropped(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, _, api),
  (api = "start" ; api = "start_link" ; api = "start_via"),
  act_callee(a, callee),
  callee_returns(callee, "can_fail"),
  !act_result_read(a),
  !act_returned_by(a, f),
  !returned_and_used(a).

.decl returned_and_used(act: symbol)

returned_and_used(a) :- act_returned_by(a, g), result_used(g).

runs.seed(f) :- names.meets(f, _, _, _, _, _, _).

.decl registry_race(mod: symbol, func: symbol, lookup_api: symbol, create_api: symbol, key_source: symbol, key: symbol, check: symbol, act: symbol)
.output registry_race

registry_race(mod, f, lookup_api, create_api, key_source, key, check, act) :-
  names.meets(f, check, act, _, _, key_source, key),
  name_lookup(check, _, lookup_api, _, _, _, checked),
  name_act(act, _, create_api),
  (create_api != "start_child" ; checked = "checked"),
  function_def(f, mod, _, _, _),
  !loser_taken(f, act),
  !loser_dropped(f, act),
  !runs.single_process(f).

// ── Read, then write ─────────────────────────────────────────────
//
// `case :ets.lookup(t, k) do [] -> :ets.insert(t, {k, v})` decides on a
// row that another process can write between the read and the write
// (Christakis and Sagonas, 2010, on ETS). The pair is a race when both
// touch the same key, the table is public — a protected table has one
// writer — and a second process can write it: the function where the
// pair meets runs in more than one process, or a function some other
// process runs writes the table — another entry's, or one a caller
// outside the program can call (runs_apart_from, clientlib/concurrency.dl).
// A cache that serializes its read-then-write in its own process is not
// raced by an exported clear/0 no caller in the program calls, when the
// program calls the cache's other functions. insert_new, update_counter
// and select_replace are the atomic forms and the fix.
//
// The read and the write may sit in different functions
// (clientlib/check_then_act.dl), and the table may arrive as a
// parameter: by name, or as the reference :ets.new returned in some
// caller — the paper's own example builds an unnamed public table and
// hands it to a closure that spawned processes run.

.init rows = CheckThenAct

.decl deciding_read_op(op: symbol)

deciding_read_op("lookup").
deciding_read_op("lookup_element").
deciding_read_op("member").

// A match on the key decides as a lookup does. A select's match spec
// nests its head in a list, and is left out: its key is not extracted,
// as a dynamic key is not.
deciding_read_op("match").
deciding_read_op("match_object").

.decl plain_write_op(op: symbol)

plain_write_op("insert").
plain_write_op("delete").
plain_write_op("delete_object").
plain_write_op("update_element").

// The table in the operation's own function's terms.
.decl ets_table_ident(id: symbol, ts: symbol, t: symbol)

ets_table_ident(id, "literal", name) :- ets_op(id, _, name, _, _), name != "dynamic".
ets_table_ident(id, "param", to_string(p)) :- ets_op(id, _, "dynamic", _, _), ets_op_param(id, p).

rows.check(read, func, table_kind, table, key_kind, key) :-
  deciding_read(read, func),
  local_table_and_key(read, table_kind, table, key_kind, key).

rows.act(write, func, table_kind, table, key_kind, key) :-
  plain_write(write, func),
  local_table_and_key(write, table_kind, table, key_kind, key).

// A read whose answer a caller can decide on, and a write that is not
// one of the atomic forms.
.decl deciding_read(read: symbol, func: symbol) inline
.decl plain_write(write: symbol, func: symbol) inline

deciding_read(r, f) :- ets_op(r, f, _, op, "read"), deciding_read_op(op).
plain_write(w, f) :- ets_op(w, f, _, op, "write"), plain_write_op(op).

// An operation's table and key, the table in its own function's terms
// (ets_table_ident) or as clientlib/tables.dl knows it (ets_table).
.decl local_table_and_key(op: symbol, table_kind: symbol, table: symbol, key_kind: symbol, key: symbol) inline
.decl table_and_key(op: symbol, table_kind: symbol, table: symbol, key_kind: symbol, key: symbol) inline

local_table_and_key(op, ts, t, ks, k) :- ets_table_ident(op, ts, t), op_key(op, ks, k).
table_and_key(op, tk, t, ks, k) :- ets_table(op, tk, t), op_key(op, ks, k).

// An operation's key. The extractor takes an inserted object's key from
// its first element (ets_key); on a table made with `keypos: N`, N > 1 —
// an Erlang or Elixir record's, keyed past the record's tag — it is
// element N - 1 (ets_value).
.decl op_key(op: symbol, key_kind: symbol, key: symbol)

op_key(op, ks, k) :- ets_key(op, ks, k), !keyed_past_zero(op, _).

op_key(op, ks, k) :-
  keyed_past_zero(op, v),
  ets_value(op, pos, ks, k),
  to_string(pos + 1) = v.

.decl keyed_past_zero(op: symbol, keypos: symbol)

keyed_past_zero(op, v) :-
  ets_op(op, _, _, o, "write"),
  (o = "insert" ; o = "insert_new"),
  ets_table(op, tk, t),
  site_table(n, tk, t),
  ets_option(n, "keypos", v),
  v != "1".

// The table a parameter holds where a pair meets on it: a name a caller
// passes there, or the reference :ets.new returned in a caller, through
// any forwarding. Asked only for the parameters a pair meets on.
.decl table_param_needed(func: symbol, pos: symbol)

table_param_needed(f, p) :- rows.meets(f, _, _, "param", p, _, _).
table_param_needed(f, p) :- records.meets(f, _, _, "param", p, _, _).

table_param_needed(c, to_string(m)) :-
  table_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n).

.decl table_at_param(func: symbol, pos: symbol, name: symbol)

table_at_param(f, p, name) :-
  table_param_needed(f, p),
  call_arg(_, f, n, name),
  name != "dynamic",
  p = to_string(n).

table_at_param(f, p, name) :-
  table_param_needed(f, p),
  ets_tid_arg(_, f, n, name),
  p = to_string(n).

table_at_param(f, p, name) :-
  table_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n),
  table_at_param(c, to_string(m), name).

.decl reads_then_writes(func: symbol, read: symbol, write: symbol, name: symbol, key: symbol)

reads_then_writes(f, r, w, name, k) :- rows.meets(f, r, w, "literal", name, _, k).
reads_then_writes(f, r, w, name, k) :- rows.meets(f, r, w, "param", p, _, k), table_at_param(f, p, name).

runs.seed(f) :- reads_then_writes(f, _, _, _, _).
runs.seed(f) :- ets_op(_, f, _, _, "write").

.decl another_process_writes(name: symbol, func: symbol)

another_process_writes(name, f) :-
  reads_then_writes(f, _, _, name, _),
  !runs.single_process(f).

another_process_writes(name, f) :-
  reads_then_writes(f, _, _, name, _),
  runs.single_process(f),
  runs.entry_reaches(m, f),
  other_writer(f, name, g),
  runs.runs_apart_from(m, g).

// ── The other writer ──
//
// Asked when the pair runs in one process: a write of the table in `g`
// that can land on the pair's row after that process has started. Not a
// write whose key can never be the pair's (a different literal, or a
// literal row kept beside rows keyed by what the caller passes: a seeded
// `{:schema_version, 1}` beside the counts), and not one that runs only
// while its own process starts — reached from other processes only
// through an init/1 or an Application's start/2, which an ordered
// supervisor start runs before it starts the serialized process's
// siblings.
.decl pair_key(func: symbol, name: symbol, key_kind: symbol, key: symbol)

pair_key(f, name, ks, k) :- rows.meets(f, _, _, "literal", name, ks, k).
pair_key(f, name, ks, k) :- rows.meets(f, _, _, "param", p, ks, k), table_at_param(f, p, name).

.decl other_writer(func: symbol, name: symbol, writer_func: symbol)

other_writer(f, name, g) :-
  reads_then_writes(f, _, _, name, _),
  runs.single_process(f),
  ets_op(w, g, name, _, "write"),
  pair_key(f, name, ks, k),
  !written_apart(w, ks, k),
  !removal_loses_nothing(f, name, w),
  writes_after_start(g).

// A removal is undone only by a pair whose act can make the row again:
// an insert after it puts the removed row back (a revoked session
// restored). An update_element or a delete after it changes nothing, and
// the table ends as it would had the pair run first.
.decl removal(write: symbol)

removal(w) :- ets_op(w, _, _, "delete", "write").
removal(w) :- ets_op(w, _, _, "delete_object", "write").
removal(w) :- ets_op(w, _, _, "delete_all_objects", "write").
removal(w) :- ets_op(w, _, _, "select_delete", "write").
removal(w) :- ets_op(w, _, _, "take", "write").

// A write that can make a row: an insert, or a counter bump with a
// default object.
.decl makes_row(write: symbol)

makes_row(w) :- ets_op(w, _, _, "insert", "write").
makes_row(w) :- ets_op(w, _, _, "insert_new", "write").
makes_row(w) :-
  ets_op(w, _, _, "update_counter", "write"),
  remote_call(w, _, ":ets", "update_counter", 4).

// A pair of the function on the table whose act can make a row.
.decl pair_makes_rows(func: symbol, name: symbol)

pair_makes_rows(f, name) :- reads_then_writes(f, _, w, name, _), makes_row(w).

.decl removal_loses_nothing(func: symbol, name: symbol, write: symbol)

removal_loses_nothing(f, name, w) :-
  reads_then_writes(f, _, _, name, _),
  removal(w),
  !pair_makes_rows(f, name).

// The write's key can never be the pair's key (ks, k).
.decl written_apart(write: symbol, key_kind: symbol, key: symbol)

written_apart(w, "literal", k) :-
  pair_key(_, name, "literal", k),
  ets_op(w, _, name, _, "write"),
  op_key(w, "literal", k2),
  k != k2.

written_apart(w, ks, k) :-
  pair_key(_, name, ks, k),
  ks != "literal",
  ks != "any",
  ets_op(w, _, name, _, "write"),
  op_key(w, "literal", _).

.init writer_walk = SameProcessReach

writer_walk.seed(g, g) :-
  reads_then_writes(f, _, _, name, _),
  runs.single_process(f),
  ets_op(_, g, name, _, "write").

.decl startup_callback(func: symbol)

startup_callback(c) :- process_entry(_, c), function_def(c, _, "init", 1, _).
startup_callback(c) :- behaves_as(m, "Application"), function_def(c, m, "start", 2, _).

.decl writes_after_start(func: symbol)

writes_after_start(g) :- process_entry(_, c), writer_walk.reaches(c, g), !startup_callback(c).
writes_after_start(g) :- open_entry(c), writer_walk.reaches(c, g), !startup_callback(c).
writes_after_start(g) :- request_entry(e, _), writer_walk.reaches(e, g).
writes_after_start(g) :- runs.spawned(_, _, r), writer_walk.reaches(r, g).

// ── Races both racers win ────────────────────────────────────────
//
// A check-then-act pair is a lost update when the write carries what the
// read said — two racers each add one to the count they read, and one
// increment vanishes — or when a blind write lands on a row another
// writer accumulates into (Hammer's insert over a key update_counter
// bumps). Three shapes are neither, and are not reported, as long as
// nothing in the program writes the table back from a read or counts in
// it (`writes_back`):
//
// - a delete decided only by whether the row is there: deleting twice
//   is deleting once (an invalidation). A delete decided by what the row
//   holds — its owner, its expiry — can delete the row another process
//   put there in between (a lock's next owner), and is reported, unless
//   every row the table is written is a refill (below): then the row it
//   deletes is a cached copy, and losing one is a miss. A delete_object
//   deletes only the object it names, and is not reported;
// - a refill: a write whose value a call, or a read of another store
//   (Mnesia behind an ETS cache), makes — the cache-aside `[] -> v =
//   load(k); :ets.insert(t, {k, v})` — where both racers compute the
//   same thing and either write is right. Not when the call mints the
//   value — a random token, a unique integer, a ref — and the function
//   hands it out: each racer returns its own, and only one is stored;
// - a trip: a write of a value made of neither the read nor a call
//   (`{key, :blocked_until, t}`), not guarded by what the row holds,
//   with no send or other write under the decision, and a decision that
//   stays in the program: no caller branches on what the function
//   returns, and no exported function hands it out. Both racers write
//   the same thing. A claim — `[] -> insert({k, :in_flight}); :ok` —
//   hands its decision to a caller that acts on it alone, and is
//   reported: both racers are told they won. So is a guard on what the
//   row holds, compared with the value the write stores (`[{^k, cur}]
//   when cur >= serial`, then `insert({k, serial})`), whichever value
//   the racers return: the older serial can land last. And a marker
//   whose decision also sends, or makes another write: both racers do.
//   A check of the row against a clock (`blocked > now`) is an expiry,
//   not a guard; and a send made in a helper the decision calls is not
//   seen, since which helpers only log or re-send what every racer
//   agrees on (a circuit breaker telling the other nodes it opened) the
//   facts do not say.
//
// "Made of" is data dependence alone (site_reads, call_arg_reads): a
// value computed under a test on the read, but not from it, does not
// carry it.

// The ETS data a write carries: a read at its own site, what a helper
// that returns a read hands it, or either through a parameter.
// Only a write of a value counts; a delete writes nothing back, and the
// key it names may well be the one the read's row held.
.decl value_write(w: symbol)

value_write(w) :- ets_op(w, _, _, op, "write"), (op = "insert" ; op = "update_element").

.decl carries_read(w: symbol)

carries_read(w) :-
  value_write(w),
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "site", r),
  ets_op(r, _, _, _, "read").

carries_read(w) :-
  value_write(w),
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  returns_depends(g, "site", _).

// A local helper's result is made of the arguments it returns from:
// `insert({k, next(n)})` writes the read's `n` back through `next/1`.
carries_read(w) :-
  value_write(w),
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  returns_depends(g, "param", q),
  call_arg_reads(h, g, n, "site", r),
  ets_op(r, _, _, _, "read"),
  q = to_string(n).

carries_read(w) :-
  value_write(w),
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, "site", r),
  ets_op(r, _, _, _, "read"),
  p = to_string(n).

carries_read(w) :-
  value_write(w),
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, "call", g),
  returns_depends(g, "site", _),
  p = to_string(n).

// The table a write or a counter bump touches, by name.
.decl ets_op_table(id: symbol, name: symbol)

ets_op_table(id, name) :- ets_op(id, _, name, _, _), name != "dynamic".

ets_op_table(id, name) :-
  ets_op(id, f, "dynamic", _, _),
  ets_op_param(id, p),
  table_at_param(f, to_string(p), name).

table_param_needed(f, to_string(p)) :-
  ets_op(id, f, "dynamic", op, "write"),
  ets_op_param(id, p),
  (op = "update_counter" ; plain_write_op(op)).

// A write that writes the table back from a read, or counts in it,
// where it can land on the row of the pair keyed (ks, k): not at a
// literal key other than the pair's, nor at a literal row beside keys
// callers pass (a `:__hits__` counter beside the cached rows).
.decl write_back(write: symbol, name: symbol)

write_back(id, name) :- ets_op(id, _, _, "update_counter", _), ets_op_table(id, name).
write_back(w, name) :- carries_read(w), ets_op_table(w, name).

.decl writes_back(name: symbol, key_kind: symbol, key: symbol)

writes_back(name, ks, k) :- pair_key(_, name, ks, k), write_back(w, name), !written_apart(w, ks, k).

// The key a pair meets on, in the meeting function's terms.
.decl pair_key_of(func: symbol, read: symbol, write: symbol, key_kind: symbol, key: symbol)

pair_key_of(f, r, w, ks, k) :- reads_then_writes(f, r, w, _, _), rows.meets(f, r, w, _, _, ks, k).

// A write made by a call, or by a read of some other store (Mnesia, the
// registry): the refill.
.decl refill_source(kind: symbol, src: symbol)

refill_source("call", g) :- site_reads(_, _, "call", g).
refill_source("call", g) :- call_arg_reads(_, _, _, "call", g).
refill_source("site", r) :- site_reads(_, _, "site", r), !ets_op(r, _, _, _, _).
refill_source("site", r) :- call_arg_reads(_, _, _, "site", r), !ets_op(r, _, _, _, _).

// A call that mints its value: a random API, a unique integer or a ref,
// or a project function that makes one or returns what one made.
.decl unique_api(api: symbol)

unique_api("System.unique_integer/0").
unique_api("System.unique_integer/1").
unique_api(":erlang.unique_integer/0").
unique_api(":erlang.unique_integer/1").
unique_api(":erlang.make_ref/0").
unique_api("Kernel.make_ref/0").

.decl mints(callee: symbol)

mints(g) :-
  impure_call(id, _, _, "random", _),
  remote_call(id, _, m, n, a),
  g = cat(m, ":", n, "/", to_string(a)).

mints(g) :- function_def(g, _, _, _, _), impure_call(_, g, _, "random", _).
mints(g) :- function_def(g, _, _, _, _), impure_call(_, g, api, _, _), unique_api(api).
mints(g) :- function_def(g, _, _, _, _), returns_depends(g, "call", g2), mints(g2).

// The write's value is minted by a call the writing function also
// returns, to a caller that uses it or one outside the program.
.decl mint_handed_out(w: symbol)

mint_handed_out(w) :-
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  mints(g),
  returns_depends(h, "call", g),
  result_leaves(h).

.decl result_leaves(func: symbol)

result_leaves(h) :- rows.act(_, h, _, _, _, _), function_def(h, _, _, _, 1).
result_leaves(h) :- rows.act(_, h, _, _, _, _), site_depends(_, _, "call", h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), call_decided(_, _, "call", h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), call_arg_depends(_, _, _, "call", h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), returns_depends(_, "call", h).

// A table some insert writes a value into that is not a refill: state
// of its own, not cached copies (a lock's owner, a claim, a count).
.decl stores_state(name: symbol)

stores_state(name) :-
  ets_op(w, _, _, op, "write"),
  (op = "insert" ; op = "insert_new"),
  ets_op_table(w, name),
  !refilled(w).

.decl refilled(w: symbol)

refilled(w) :- ets_op(w, h, _, _, "write"), site_reads(w, h, kind, src), refill_source(kind, src).

refilled(w) :-
  ets_op(w, h, _, _, "write"),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, kind, src),
  refill_source(kind, src),
  p = to_string(n).

.decl recomputed(w: symbol)

recomputed(w) :-
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, kind, src),
  refill_source(kind, src).

recomputed(w) :-
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, kind, src),
  refill_source(kind, src),
  p = to_string(n).

// The decision a pair makes leaves the function: returned — by the
// function the pair meets in, or by a caller that returns that result on
// — to a caller that branches on it, or to callers the program does not
// show (an exported function). A spec that says the function returns a
// single value (`@spec record_failure(term, atom) :: :ok`) says the
// result carries no decision.
.decl decision_returned(func: symbol, check: symbol)

decision_returned(f, c) :-
  reads_then_writes(f, c, _, _, _),
  rows.carries(f, kind, src, c, _, _, _, _),
  returns_depends(f, kind, src).

decision_returned(g, c) :-
  decision_returned(f, c),
  rows.carries(g, "call", f, c, _, _, _, _),
  returns_depends(g, "call", f).

.decl decision_escapes(check: symbol)

decision_escapes(c) :-
  decision_returned(g, c),
  call_decided(_, _, "call", g).

decision_escapes(c) :-
  decision_returned(g, c),
  function_def(g, _, _, _, 1),
  !callee_returns(g, "constant").

// The read's decision looks at what the row holds, past its key: a test
// of element 1 on, where the read's value is carried, or in a helper it
// is handed to (field_decides). Whether a row is there, and whether its
// key is the one asked for, say nothing of what it holds.
.decl tests_row_fields(read: symbol)

tests_row_fields(r) :-
  rows.carries(f, kind, src, r, _, _, _, _),
  field_decides(f, kind, src, pos),
  pos >= 1.

tests_row_fields(r) :-
  rows.carries(f, kind, src, r, _, _, _, _),
  call_arg_depends(f, h, n, kind, src),
  field_decides(h, "param", q, pos),
  q = to_string(n),
  pos >= 1.

// A guard on what the row holds: the decision compares a field past the
// key with a value the write then stores (field_compared), where the
// read's value is carried or in a helper it is handed to.
.decl guards_row(read: symbol, write: symbol)

guards_row(r, w) :-
  reads_then_writes(_, r, w, _, _),
  rows.carries(f, kind, src, r, _, _, _, _),
  field_compared(f, kind, src, pos, ok, os),
  pos >= 1,
  rows.act(w, f, _, _, _, _),
  site_reads(w, f, ok, os).

guards_row(r, w) :-
  reads_then_writes(_, r, w, _, _),
  rows.carries(f, kind, src, r, _, _, _, _),
  field_compared(f, kind, src, pos, ok, os),
  pos >= 1,
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "param", q),
  call_arg_reads(f, h, n, ok, os),
  q = to_string(n).

guards_row(r, w) :-
  reads_then_writes(_, r, w, _, _),
  rows.carries(f, kind, src, r, _, _, _, _),
  call_arg_depends(f, h, n, kind, src),
  field_compared(h, "param", q, pos, ok, os),
  q = to_string(n),
  pos >= 1,
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, ok, os).

// The read's decision runs more than the write, in the function where
// the read's value decides: a send or an outside effect
// (effect_decided), or a write of some other shared state.
.decl decides_more(read: symbol, write: symbol)

decides_more(r, w) :-
  reads_then_writes(_, r, w, _, _),
  rows.carries(f, kind, src, r, _, _, _, _),
  effect_decided(f, kind, src).

decides_more(r, w) :-
  reads_then_writes(_, r, w, _, _),
  rows.carries(f, kind, src, r, _, _, _, _),
  site_depends(s, f, kind, src),
  s != w,
  shared_write(s).

.decl shared_write(site: symbol)

shared_write(s) :- ets_op(s, _, _, _, "write").
shared_write(s) :- mnesia_op(s, _, _, "write", _, _, _, _).
shared_write(s) :- creating_op(s, _, _, _, _, _).
shared_write(s) :- name_release(s, _, _, _, _).

.decl harmless_race(func: symbol, read: symbol, write: symbol)

harmless_race(f, r, w) :-
  reads_then_writes(f, r, w, name, _),
  pair_key_of(f, r, w, ks, k),
  ets_op(w, _, _, "delete", _),
  !tests_row_fields(r),
  !writes_back(name, ks, k).

harmless_race(f, r, w) :-
  reads_then_writes(f, r, w, name, _),
  pair_key_of(f, r, w, ks, k),
  ets_op(w, _, _, "delete", _),
  !stores_state(name),
  !writes_back(name, ks, k).

harmless_race(f, r, w) :-
  reads_then_writes(f, r, w, name, _),
  pair_key_of(f, r, w, ks, k),
  ets_op(w, _, _, "delete_object", _),
  !writes_back(name, ks, k).

harmless_race(f, r, w) :-
  reads_then_writes(f, r, w, name, _),
  pair_key_of(f, r, w, ks, k),
  !carries_read(w),
  recomputed(w),
  !mint_handed_out(w),
  !writes_back(name, ks, k).

harmless_race(f, r, w) :-
  reads_then_writes(f, r, w, name, _),
  pair_key_of(f, r, w, ks, k),
  !carries_read(w),
  !writes_back(name, ks, k),
  !guards_row(r, w),
  !decides_more(r, w),
  !decision_escapes(r).

// ── Rows only their holder writes ────────────────────────────────
//
// A row whose key is minted where the row is made — a reference
// (make_ref, a monitor) or a unique integer — can be found only by whoever
// the key is handed to. When every write that can make a row of the
// table mints its key so, and the pair's act makes no row (an
// update_element, a delete), the row the pair reads was made for a holder
// of its key, and the pair running in many processes is many holders at
// their own rows: two racers on one row would share a key minted to be
// handed to one. The other writes that reach the row remove it, and an
// act that loses to a removal changes nothing — the row ends removed, as
// it would had the act come first. Postgrex.Parameters is the shape: the
// owner inserts `{Process.monitor(pid), params}` with insert_new and
// replies the reference to the connection that asked, the connection
// updates its row with update_element, and the owner deletes the row when
// the connection goes down. Where a key goes once it is minted the facts
// do not say, so a program that hands one minted key to several processes
// is not seen.
.decl minting_call(mod: symbol, func: symbol, arity: number)

minting_call(":erlang", "make_ref", 0).
minting_call(":erlang", "monitor", 2).
minting_call(":erlang", "monitor", 3).
minting_call(":erlang", "unique_integer", 0).
minting_call(":erlang", "unique_integer", 1).
minting_call("System", "unique_integer", 0).
minting_call("System", "unique_integer", 1).

.decl minted_key(write: symbol)

minted_key(w) :-
  makes_row(w),
  op_key(w, "local", made),
  remote_call(made, _, m, n, a),
  minting_call(m, n, a).

// A table whose rows are made at minted keys and at no other: some write
// mints, and none that makes a row keys it by what it is given or
// computes.
.decl mints_rows(kind: symbol, table: symbol)
.decl names_rows(kind: symbol, table: symbol)

mints_rows(k, t) :- ets_table(w, k, t), minted_key(w).
names_rows(k, t) :- ets_table(w, k, t), makes_row(w), !minted_key(w).

.decl held_table(kind: symbol, table: symbol)

held_table(k, t) :- mints_rows(k, t), !names_rows(k, t).

// The pair's act makes no row, and every table it may touch is held.
.decl on_unheld_table(write: symbol)

on_unheld_table(w) :- reads_then_writes(_, _, w, _, _), ets_table(w, k, t), !held_table(k, t).

.decl held_row(write: symbol)

held_row(w) :-
  reads_then_writes(_, _, w, _, _),
  !makes_row(w),
  ets_table(w, _, _),
  !on_unheld_table(w).

.decl ets_check_act(mod: symbol, func: symbol, name: symbol, key: symbol, read: symbol, write: symbol)
.output ets_check_act

ets_check_act(mod, func, table, key, read, write) :-
  reads_then_writes(func, read, write, table, key),
  public_table(table),
  another_process_writes(table, func),
  !harmless_race(func, read, write),
  !held_row(write),
  in_module(func, mod).

// ── Published before it is complete ──────────────────────────────
//
// Two tables that map each way — names to ids, ids back to names — and a
// function that writes both: first a row of A holding a value V
// (`{name, id}`), then B's row keyed by V (`{id, name}`). Once the first
// write lands, V can be found: another process that takes V out of A and
// reads B at it before the second write lands finds no row. That is a
// lost update in no sense — both writes happen — but the reader that
// raises on a missing row (lookup_element/3, update_counter/3) crashes
// with badarg in the window. The fix is the order: write B first, then
// publish V in A, and when publishing can lose (insert_new), delete the B
// row it wrote.
//
// The two writes may be the function's own or its callees': a function
// runs an insert where it makes it or at the call whose callee, on the
// same stack, makes it (insert_at), and each is read in the function's
// terms — a callee's key in its parameter is the argument the call
// passes (ets_call_arg). They are in order when the second is reached
// from the first within one trip through the function (ets_effect_order:
// a loop's back edge does not order a pair both ways). Nothing here needs
// V's name: the writes join on V's identity (ets_value against ets_key),
// the tables on what clientlib/tables.dl says each operation may touch.

// A call that runs its callee on the caller's stack.
.decl same_stack_site(site: symbol, caller: symbol, callee: symbol)

same_stack_site(c, f, g) :- local_call(c, f, g, _), !runs_elsewhere(f, g).

same_stack_site(c, f, g) :-
  remote_call(c, f, m, n, a),
  g = cat(m, ":", n, "/", to_string(a)),
  function_def(g, _, _, _, _),
  !runs_elsewhere(f, g).

.decl object_insert(w: symbol, func: symbol)

object_insert(w, f) :- ets_op(w, f, _, "insert", "write").
object_insert(w, f) :- ets_op(w, f, _, "insert_new", "write").

.decl reaches_insert(func: symbol)

reaches_insert(f) :- object_insert(_, f).
reaches_insert(f) :- same_stack_site(_, f, g), reaches_insert(g).

.decl lift_needed(func: symbol)

lift_needed(f) :- ets_effect_order(f, _, _).
lift_needed(g) :- lift_needed(f), same_stack_site(_, f, g), reaches_insert(g).

// `func` runs the insert `w` at `at`: w itself, or a call leading to it.
.decl insert_at(func: symbol, at: symbol, w: symbol)

insert_at(f, w, w) :- lift_needed(f), object_insert(w, f).

insert_at(f, c, w) :-
  lift_needed(f),
  same_stack_site(c, f, g),
  reaches_insert(g),
  insert_at(g, _, w).

// The insert's key and the values past it, in `func`'s terms. A literal
// means the same everywhere; a parameter is what the call passes.
.decl key_in(func: symbol, at: symbol, w: symbol, source: symbol, key: symbol)

key_in(f, w, w, s, k) :- insert_at(f, w, w), ets_key(w, s, k).

key_in(f, c, w, "literal", k) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  key_in(g, _, w, "literal", k).

key_in(f, c, w, s, k) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  key_in(g, _, w, "param", p),
  ets_call_arg(c, g, p, s, k).

.decl value_in(func: symbol, at: symbol, w: symbol, pos: number, source: symbol, value: symbol)

value_in(f, w, w, pos, s, v) :- insert_at(f, w, w), ets_value(w, pos, s, v).

value_in(f, c, w, pos, "literal", v) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  value_in(g, _, w, pos, "literal", v).

value_in(f, c, w, pos, s, v) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  value_in(g, _, w, pos, "param", p),
  ets_call_arg(c, g, p, s, v).

// W1 writes V into A's row, W2 then writes B's row keyed by V. A value
// that is a literal is known without reading A.
.decl publish_candidate(func: symbol, publish: symbol, complete: symbol)

publish_candidate(f, w1, w2) :-
  ets_effect_order(f, a1, a2),
  insert_at(f, a1, w1),
  insert_at(f, a2, w2),
  w1 != w2,
  value_in(f, a1, w1, _, vs, v),
  vs != "literal",
  key_in(f, a2, w2, vs, v).

// The two writes may touch one table: then it is one row replacing
// another, not a value published ahead of its row.
.decl may_share_table(a: symbol, b: symbol)

may_share_table(w1, w2) :-
  publish_candidate(_, w1, w2),
  ets_table(w1, k, t),
  ets_table(w2, k, t).

.decl publishes_early(func: symbol, publish: symbol, complete: symbol)

publishes_early(f, w1, w2) :-
  publish_candidate(f, w1, w2),
  ets_table(w1, _, _),
  ets_table(w2, _, _),
  !may_share_table(w1, w2).

// A read that raises when the key has no row. lookup_element/4 and
// update_counter/4 take a default and do not; update_element answers
// false.
.decl raises_if_missing(r: symbol, func: symbol)

raises_if_missing(r, g) :-
  ets_op(r, g, _, "lookup_element", _),
  remote_call(r, _, ":ets", "lookup_element", 3).

raises_if_missing(r, g) :-
  ets_op(r, g, _, "update_counter", _),
  remote_call(r, _, ":ets", "update_counter", 3).

// A read of A that hands out what it found: the way V reaches a reader.
.decl hands_out(r: symbol)

hands_out(r) :- ets_op(r, _, _, "lookup", _), returns_depends(_, "site", r).
hands_out(r) :- ets_op(r, _, _, "lookup", _), site_reads(_, _, "site", r).
hands_out(r) :- ets_op(r, _, _, "lookup", _), call_arg_reads(_, _, _, "site", r).
hands_out(r) :- ets_op(r, _, _, op, "read"), op != "lookup", op != "member", op != "info".

// A table another process can read. A "field" table is the one its
// operations were created with a name of (ets_op), not private.
.decl readable_elsewhere(id: symbol, kind: symbol, ident: symbol)

readable_elsewhere(id, k, t) :- ets_table(id, k, t), k != "field", table_readable_elsewhere(k, t).

readable_elsewhere(id, "field", t) :-
  ets_table(id, "field", t),
  ets_op(id, _, name, _, _),
  name != "dynamic",
  ets_new(n, _, name),
  !ets_option(n, "access", "private").

// The reader of B and the tables it shares with the writes.
.decl publish_reader_candidate(func: symbol, publish: symbol, complete: symbol, reader: symbol, g: symbol, ak: symbol, a: symbol)

publish_reader_candidate(f, w1, w2, r, g, ak, a) :-
  publishes_early(f, w1, w2),
  ets_table(w1, ak, a),
  ets_op(ra, _, _, _, "read"),
  ets_table(ra, ak, a),
  hands_out(ra),
  ets_table(w2, bk, b),
  raises_if_missing(r, g),
  ets_table(r, bk, b),
  ets_key(r, ks, _),
  ks != "literal",
  readable_elsewhere(w2, bk, b),
  !rescues_argument_error(g).

// ── Where the reader's key comes from ──
//
// The reader must be able to hold V: its key made from a read of A, or
// from something the program cannot see the origin of — a parameter of a
// function outside callers can reach (exported, or taken as a fun), a
// call nothing summarises. A key the program shows is made from other
// things does not read A's values.
.decl key_needed(func: symbol, kind: symbol, src: symbol)

key_needed(g, "param", p) :- publish_reader_candidate(_, _, _, r, g, _, _), ets_key(r, "param", p).

key_needed(g, k, s) :-
  publish_reader_candidate(_, _, _, r, g, _, _),
  ets_key(r, ks, _),
  ks != "param",
  site_reads(r, g, k, s).

key_needed(c, k, s) :-
  key_needed(g, "param", p),
  call_arg_reads(c, g, n, k, s),
  p = to_string(n).

key_needed(h, k, s) :- key_needed(_, "call", h), returns_depends(h, k, s).

.decl from_table(func: symbol, kind: symbol, src: symbol, tk: symbol, t: symbol)

from_table(g, "site", ra, tk, t) :-
  key_needed(g, "site", ra),
  ets_op(ra, g, _, _, "read"),
  ets_table(ra, tk, t).

from_table(g, "call", h, tk, t) :-
  key_needed(g, "call", h),
  returns_depends(h, k, s),
  from_table(h, k, s, tk, t).

from_table(g, "param", p, tk, t) :-
  key_needed(g, "param", p),
  call_arg_reads(c, g, n, k, s),
  p = to_string(n),
  from_table(c, k, s, tk, t).

// Sources whose origin the program does not show.
.decl open_source(func: symbol, kind: symbol, src: symbol)

open_source(g, "param", p) :- key_needed(g, "param", p), function_def(g, _, _, _, 1).
open_source(g, "param", p) :- key_needed(g, "param", p), fun_ref(_, g).
open_source(g, "call", h) :- key_needed(g, "call", h), !returns_depends(h, _, _).
open_source(g, k, s) :- key_needed(g, "param", p), call_arg_reads(c, g, n, k, s), p = to_string(n), open_source(c, k, s).
open_source(g, "call", h) :- key_needed(g, "call", h), returns_depends(h, k, s), open_source(h, k, s).

.decl key_may_come_from(r: symbol, tk: symbol, t: symbol)

key_may_come_from(r, tk, t) :-
  publish_reader_candidate(_, _, _, r, g, tk, t),
  ets_key(r, "param", p),
  (from_table(g, "param", p, tk, t) ; open_source(g, "param", p)).

key_may_come_from(r, tk, t) :-
  publish_reader_candidate(_, _, _, r, g, tk, t),
  ets_key(r, ks, _),
  ks != "param",
  site_reads(r, g, k, s),
  (from_table(g, k, s, tk, t) ; open_source(g, k, s)).

.decl reads_in_the_gap(func: symbol, publish: symbol, complete: symbol, reader: symbol, g: symbol)

reads_in_the_gap(f, w1, w2, r, g) :-
  publish_reader_candidate(f, w1, w2, r, g, ak, a),
  key_may_come_from(r, ak, a).

runs.seed(f) :- reads_in_the_gap(f, _, _, _, _).
runs.seed(g) :- reads_in_the_gap(_, _, _, _, g).

// The reader can run while the writer is between the two writes: in
// more than one process, or one the writer's process does not reach.
.decl can_read_in_the_gap(func: symbol, reader: symbol)

can_read_in_the_gap(f, g) :- reads_in_the_gap(f, _, _, _, g), !runs.single_process(f).
can_read_in_the_gap(f, g) :- reads_in_the_gap(f, _, _, _, g), !runs.single_process(g).

can_read_in_the_gap(f, g) :-
  reads_in_the_gap(f, _, _, _, g),
  runs.entry_reaches(m, g),
  !runs.entry_reaches(m, f).

// A table is spelled by its identity's kind and the identity: "named" and
// the name, "new" and the :ets.new/2 site, or "field" and the module and
// the path it is kept under.
.decl ets_publish_order(mod: symbol, func: symbol, published_kind: symbol, published_in: symbol, completed_kind: symbol, completed_in: symbol, publish: symbol, complete: symbol, reader: symbol)
.output ets_publish_order

ets_publish_order(mod, writer, pub_kind, pub_table, row_kind, row_table, publish, complete, reader) :-
  reads_in_the_gap(writer, publish, complete, reader, reader_func),
  can_read_in_the_gap(writer, reader_func),
  in_module(writer, mod),
  table_of(publish, pub_kind, pub_table),
  table_of(complete, row_kind, row_table),
  table_of(reader, row_kind, row_table).

.decl table_of(op: symbol, table_kind: symbol, table: symbol) inline

table_of(op, tk, t) :- ets_table(op, tk, t).

// ── Read, then a row that may be gone ────────────────────────────
//
// `case :ets.lookup(t, k) do [_] -> :ets.update_counter(t, k, {2, 1})`
// decides that the row is there and acts on it with an operation that
// raises when it is not (update_counter/3, lookup_element/3). No write of
// the key is lost — the act's own failure is the bug: another process
// that takes or deletes the row between the two leaves the act a missing
// key, and the process that only meant to count crashes with badarg.
// sequin's DebouncedLogger counts repeats of a log line this way while a
// timer's flush, in a process of its own, takes the row.
//
// The pair is CheckThenAct's (clientlib/check_then_act.dl): a deciding
// read and a raising act on one table and key, in one function or across
// the functions the read's result reaches. The row's remover is any
// operation that deletes rows of that table — take, delete, a
// delete_object, select_delete or match_delete, or deleting the table —
// in a function that can run while the pair's function is between the
// two. The key is asked of the remover only to rule it out: a flush keyed
// by the arguments a timer was handed is not a key the facts can equate
// to the check's, so a remover counts unless its key can never be the
// pair's. A process's own row (keyed by self()) is removed by the
// process that owns it, and one removing self()'s row in another process
// removes that process's; a literal key names a row of its own, other
// than a different literal's and than the rows kept beside it under keys
// callers pass (a `:__total__` next to the keyed counts).

.init missing = CheckThenAct

missing.check(read, func, lifted_kind, table, key_kind, key) :-
  deciding_read(read, func),
  table_and_key(read, table_kind, table, key_kind, key),
  table_kind_as(table_kind, lifted_kind).

missing.act(act, func, lifted_kind, table, key_kind, key) :-
  raises_if_missing(act, func),
  table_and_key(act, table_kind, table, key_kind, key),
  table_kind_as(table_kind, lifted_kind).

// A table's kind as CheckThenAct lifts it across calls: a named table and
// an :ets.new/2 site are the same table in every function; a table a
// module keeps under a field of its own is, within the module
// (check_then_act.dl's global_identity and module_identity).
.decl table_kind_as(table_kind: symbol, lifted_kind: symbol)

table_kind_as("named", "named").
table_kind_as("new", "new").
table_kind_as("field", "module field").

// The rule is written in the words below, one per line, each over a
// whole table: a table is its kind and identity together (ets_table's
// two columns), so no line has to spell the kind.
.type EtsTable = [kind: symbol, ident: symbol]

// A read that decides whether a row is there.
.decl checks_row_exists(check: symbol) inline

checks_row_exists(check) :- deciding_read(check, _).

// An operation that raises when the row is missing, and nothing rescues
// the raise: not a handler around the act, nor one around any call on
// some path from `func`, where the check's result meets it, down to the
// act, nor one around every call to `func`.
.decl fails_if_row_missing(act: symbol, func: symbol)

fails_if_row_missing(act, func) :-
  missing.meets(func, _, act, _, _, _, _),
  raises_unguarded(func, act),
  !callers_rescue(func).

// ── Whether the raise is rescued ──
//
// Asked of the act's site and of the calls that lead to it, not of whole
// functions: a `rescue` around unrelated code after the act does not
// take the act's ArgumentError, and a handler around the call to a
// helper does. The act is unguarded from `func` when some path of calls
// from `func` that passes no such handler (clientlib/reach.dl's
// ForwardGuardedCallReach) reaches the act's function, and nothing
// around the act itself takes the error either. A closure or a fun
// handed to a call is asked of the call it is handed to (fun_handed,
// resolved_apply), and one handed to a process start runs elsewhere; an
// edge that names no such call is followed unless its function has a
// handler that takes the error somewhere, the function-wide answer.
.init unguarded_path = ForwardGuardedCallReach

unguarded_path.root(f) :- missing.meets(f, _, _, _, _, _, _).
unguarded_path.limit(16).
unguarded_path.guarded(c) :- site_rescues_argument_error(c, _).
unguarded_path.handed(f, g, id) :- fun_handed(id, f, g).
unguarded_path.handed(f, g, id) :- resolved_apply(id, f, g).
unguarded_path.sealed(f) :- rescues_argument_error(f).
unguarded_path.elsewhere(c) :- process_start(c, _, _, kind, _), kind != "server".

.decl raises_unguarded(func: symbol, act: symbol)

raises_unguarded(f, a) :-
  missing.meets(f, _, a, _, _, _, _),
  raises_if_missing(a, f),
  !site_rescues_argument_error(a, f).

raises_unguarded(f, a) :-
  missing.meets(f, _, a, _, _, _, _),
  raises_if_missing(a, g),
  unguarded_path.reaches(f, g, _, _),
  !site_rescues_argument_error(a, g).

// Every call to `func` is inside a handler that takes the error, and no
// caller the program does not show can call it: not exported, not handed
// out as a fun, and reached only through call sites. One unguarded caller
// keeps the finding.
.decl rescue_asked(func: symbol)

rescue_asked(f) :- missing.meets(f, _, _, _, _, _, _).

.decl called_unguarded(func: symbol)

called_unguarded(f) :- rescue_asked(f), call_instr(h, f, c), !site_rescues_argument_error(c, h).
called_unguarded(f) :- rescue_asked(f), function_def(f, _, _, _, 1).
called_unguarded(f) :- rescue_asked(f), fun_ref(_, f).
called_unguarded(f) :- rescue_asked(f), call_edge(h, f), !call_instr(h, f, _).

.decl callers_rescue(func: symbol)

callers_rescue(f) :- rescue_asked(f), call_instr(_, f, _), !called_unguarded(f).

// In `func`, the check's result decides the act, on one key of `table`
// (CheckThenAct's meets, followed across calls).
.decl act_depends_on_check(func: symbol, check: symbol, act: symbol, table: EtsTable)

act_depends_on_check(func, check, act, [tk, t]) :-
  missing.meets(func, check, act, lifted_kind, t, _, _),
  table_kind_as(tk, lifted_kind).

// The act's table is one another process can read. A named table the
// program does not show being made — by a dependency, or under a name
// that arrives at runtime (`:ets.new(name, ...)` in a function nothing
// calls with a literal) — is taken to be shared: nothing says it is
// private, and an update from a process that is not its owner needs it
// public.
.decl shared_table(act: symbol, table: EtsTable) inline

shared_table(act, [tk, t]) :- readable_elsewhere(act, tk, t).
shared_table(act, ["named", t]) :- ets_table(act, "named", t), !made_in_view("named", t).

.decl made_in_view(kind: symbol, ident: symbol)

made_in_view(k, t) :- site_table(_, k, t).

// An operation that deletes rows of the table: take, delete,
// delete_object, select_delete, match_delete, or deleting them all.
.decl removes_rows(remover: symbol, table: EtsTable)

removes_rows(d, [tk, t]) :-
  ets_op(d, _, _, op, _),
  (op = "take" ; op = "delete" ; op = "delete_object" ; op = "select_delete" ; op = "match_delete" ; op = "delete_all_objects"),
  ets_table(d, tk, t).

// The pairs the rule asks about, for the questions it asks of processes.
.decl found_row_act(func: symbol, table: EtsTable)

found_row_act(func, table) :-
  act_depends_on_check(func, _, act, table),
  fails_if_row_missing(act, func),
  shared_table(act, table).

.decl remover_in(remover: symbol, func: symbol)

remover_in(d, h) :- found_row_act(_, table), removes_rows(d, table), ets_op(d, h, _, _, _).

runs.seed(f) :- found_row_act(f, _).
runs.seed(h) :- remover_in(_, h).

// The remover can run while `func` is between the check and the act,
// and take the row a pair in `func` acts on: `func` runs in more than one
// process, or the remover runs in a process that does not run it.
.decl can_run_in_between(remover: symbol, func: symbol)

can_run_in_between(d, f) :-
  found_row_act(f, table),
  removes_rows(d, table),
  may_remove_pair_row(d, f),
  !runs.single_process(f).

can_run_in_between(d, f) :-
  found_row_act(f, table),
  removes_rows(d, table),
  may_remove_pair_row(d, f),
  remover_in(d, h),
  runs.entry_reaches(m, h),
  !runs.entry_reaches(m, f).

// The key of a pair `func` reports, and whether a remover's key can be it.
.decl found_pair_key(func: symbol, table: EtsTable, key_kind: symbol, key: symbol)

found_pair_key(f, [tk, t], ks, k) :-
  missing.meets(f, _, a, lifted_kind, t, ks, k),
  table_kind_as(tk, lifted_kind),
  fails_if_row_missing(a, f),
  shared_table(a, [tk, t]).

.decl may_remove_pair_row(remover: symbol, func: symbol)

may_remove_pair_row(d, f) :-
  found_pair_key(f, table, ks, k),
  removes_rows(d, table),
  !keyed_apart(d, ks, k).

// The remover's key can never be the pair's key (ks, k).
.decl keyed_apart(remover: symbol, key_kind: symbol, key: symbol)

keyed_apart(d, "self", "") :- remover_in(d, _), ets_key(d, "self", "").
keyed_apart(d, "self", "") :- remover_in(d, _), ets_key(d, "literal", _).
keyed_apart(d, "literal", k) :- remover_in(d, _), ets_key(d, "self", ""), found_pair_key(_, _, "literal", k).

keyed_apart(d, "literal", k) :-
  remover_in(d, _),
  ets_key(d, "literal", k2),
  found_pair_key(_, _, "literal", k),
  k != k2.

keyed_apart(d, ks, k) :-
  remover_in(d, _),
  ets_key(d, "literal", _),
  found_pair_key(_, _, ks, k),
  ks != "literal",
  ks != "self",
  ks != "any".

.decl missing_row_race(func: symbol, table: EtsTable, check: symbol, act: symbol, remover: symbol)

missing_row_race(func, table, check, act, remover) :-
  checks_row_exists(check),
  fails_if_row_missing(act, func),
  act_depends_on_check(func, check, act, table),
  shared_table(act, table),
  removes_rows(remover, table),
  can_run_in_between(remover, func).

.decl ets_missing_row(mod: symbol, func: symbol, table_kind: symbol, table: symbol, check: symbol, act: symbol, remover: symbol)
.output ets_missing_row

ets_missing_row(mod, func, table_kind, table, check, act, remover) :-
  missing_row_race(func, [table_kind, table], check, act, remover),
  in_module(func, mod).

// ── Dirty read, then dirty write ─────────────────────────────────
//
// Mnesia serializes what runs inside a transaction; its dirty operations
// bypass that, and a dirty_read whose result decides or feeds a
// dirty_write of the same record is the read-modify-write another process
// can interleave. The paper's instance is the snmp agent's time-stamp
// counter: read, add one, write back. A Mnesia table is shared by every
// process on every node, so no access mode excuses it; one process that
// is the table's only writer does. :mnesia.transaction/1 and
// dirty_update_counter are the fixes.
//
// Known limit: "one process" is one per node. A server registered under
// a local name runs once on each node, and a table replicated to several
// nodes (ram_copies or disc_copies on more than one) is written by each
// node's owner, so the excuse is unsound there. It is kept: whether a
// table is replicated is create_table's copies lists, which are almost
// always computed at runtime (`[node() | Node.list()]`, config) and which
// the facts do not show, and honouring the excuse only for a :global or
// :via owner would report every locally registered owner on a
// single-node deployment, the common case.

.init records = CheckThenAct

records.check(read, func, table_kind, table, key_kind, key) :-
  mnesia_op(read, func, _, "read", table_kind, table, key_kind, key).

records.act(write, func, table_kind, table, key_kind, key) :-
  mnesia_op(write, func, op, "write", table_kind, table, key_kind, key),
  dirty_write_op(op).

// The dirty writes, the acts. A transaction's writes and
// dirty_update_counter write the table too (the other writer, and what
// writes a table back), but are not the race's act.
.decl dirty_write_op(op: symbol)

dirty_write_op("dirty_write").
dirty_write_op("dirty_delete").
dirty_write_op("dirty_delete_object").

.decl reads_then_writes_record(func: symbol, read: symbol, write: symbol, table: symbol, key: symbol)

reads_then_writes_record(f, r, w, t, k) :- records.meets(f, r, w, "literal", t, _, k).
reads_then_writes_record(f, r, w, t, k) :- records.meets(f, r, w, "param", p, _, k), table_at_param(f, p, t).
reads_then_writes_record(f, r, w, t, k) :- records.meets(f, r, w, "element 0", p, _, k), table_at_record(f, p, t).

// A record handed in whole names its table in its first element: the
// callers' tuples say which (elvengard_ecs's insert_new(record), called
// with `entity(id: id, ...)`), through any parameter that forwards it.
.decl record_param_needed(func: symbol, pos: symbol)

record_param_needed(f, p) :- records.meets(f, _, _, "element 0", p, _, _).
record_param_needed(c, to_string(m)) :-
  record_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n).

.decl table_at_record(func: symbol, pos: symbol, name: symbol)

table_at_record(f, p, t) :-
  record_param_needed(f, p),
  call_arg_tuple(_, f, n, 0, "literal", t),
  p = to_string(n).

table_at_record(f, p, t) :-
  record_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n),
  table_at_record(c, to_string(m), t).

runs.seed(f) :- reads_then_writes_record(f, _, _, _, _).
runs.seed(f) :- mnesia_op(_, f, _, "write", _, _, _, _).

.decl another_process_writes_record(table: symbol, func: symbol)

another_process_writes_record(t, f) :-
  reads_then_writes_record(f, _, _, t, _),
  !runs.single_process(f),
  !serialized_by_lock(f, t).

another_process_writes_record(t, f) :-
  reads_then_writes_record(f, _, _, t, _),
  runs.single_process(f),
  runs.entry_reaches(m, f),
  mnesia_write_table(_, g, t),
  runs.runs_apart_from(m, g),
  !serialized_by_lock(f, t).

// ── A cluster lock every writer takes ──
//
// Dirty operations skip Mnesia's locks, not an external mutex: a pair in
// a closure `:global.trans/2` runs, on a table every writer writes under
// such a closure too, is serialized. A closure is taken to run under the
// lock when the function that builds it calls :global.trans (the facts
// do not say which closure a call is handed), and so is a private
// function only such closures call. The lock's identity is not compared:
// writers under different locks are taken as serialized, so the rule
// stays quiet where it cannot tell.
.decl locked_closure(func: symbol)

locked_closure(c) :- global_op(_, f, "trans", _, _), closure_def(f, c).

.decl called_unlocked(func: symbol)

called_unlocked(g) :- mnesia_write_table(_, g, _), call_edge(h, g), !locked_closure(h).

.decl under_lock(func: symbol)

under_lock(g) :- locked_closure(g).

under_lock(g) :-
  mnesia_write_table(_, g, _),
  function_def(g, _, _, _, 0),
  call_edge(_, g),
  !called_unlocked(g).

.decl unlocked_writer(table: symbol)

unlocked_writer(t) :- mnesia_write_table(_, g, t), !under_lock(g).

.decl serialized_by_lock(func: symbol, table: symbol)

serialized_by_lock(f, t) :-
  reads_then_writes_record(f, _, _, t, _),
  under_lock(f),
  !unlocked_writer(t).

// The table a Mnesia write touches, by name: spelled there, named by
// what callers pass the parameter it arrives in, or the first element of
// the record callers build and hand it (`defp save(rec), do:
// :mnesia.dirty_write(rec)`). A transaction's write and the atomic
// counter are writes too: a dirty read-modify-write takes no lock, and
// either can land between its read and its write.
.decl mnesia_write_table(write: symbol, func: symbol, table: symbol)

mnesia_write_table(w, f, t) :- mnesia_op(w, f, _, "write", "literal", t, _, _).

mnesia_write_table(w, f, t) :-
  mnesia_op(w, f, _, "write", "param", p, _, _),
  table_at_param(f, p, t).

mnesia_write_table(w, f, t) :-
  mnesia_op(w, f, _, "write", "element 0", p, _, _),
  table_at_record(f, p, t).

record_param_needed(f, p) :- mnesia_op(_, f, _, "write", "element 0", p, _, _).

.decl mnesia_check_act(mod: symbol, func: symbol, table: symbol, key: symbol, read: symbol, write: symbol, op: symbol)
.output mnesia_check_act

// A dirty_delete of the record the read found (the cleanup of an
// expired nonce) is not a lost update unless the program also writes the
// table back from a read, or counts in it with dirty_update_counter:
// deleting twice is deleting once.
.decl record_carries_read(w: symbol)

record_carries_read(w) :-
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "site", _).

record_carries_read(w) :-
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  returns_depends(g, "site", _).

record_carries_read(w) :-
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  returns_depends(g, "param", q),
  call_arg_reads(h, g, n, "site", _),
  q = to_string(n).

record_carries_read(w) :-
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, "site", _),
  p = to_string(n).

record_carries_read(w) :-
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "param", p),
  call_arg_reads(_, h, n, "call", g),
  returns_depends(g, "site", _),
  p = to_string(n).

.decl record_writes_back(table: symbol)

record_writes_back(t) :- record_carries_read(w), mnesia_write_table(w, _, t).

record_writes_back(t) :-
  mnesia_op(w, _, "dirty_update_counter", _, _, _, _, _),
  mnesia_write_table(w, _, t).

table_param_needed(f, p) :- mnesia_op(_, f, _, "write", "param", p, _, _).

mnesia_check_act(mod, func, table, key, read, write, op) :-
  reads_then_writes_record(func, read, write, table, key),
  another_process_writes_record(table, func),
  !harmless_record_race(func, read, write),
  dirty_op(write, op),
  in_module(func, mod).

// Which dirty operation a Mnesia call is.
.decl dirty_op(site: symbol, op: symbol) inline

dirty_op(site, op) :- mnesia_op(site, _, op, _, _, _, _, _).

// ── Mnesia races both racers win ──
//
// The ETS rule's (above), for records: a delete, and a trip — a write of
// a value made of neither the read nor a call, not guarded by what the
// record holds, with no send or other write under the decision, whose
// decision stays in the program (`[] -> dirty_write({:prefs, user,
// defaults})`, then `:ok`). Both racers write the same record. Neither
// is harmless on a table the program writes back from a read or counts
// in. A claim, which hands its decision to the caller, and a guard on
// the record's contents (ztlp's serial check) stay reported.
.decl harmless_record_race(func: symbol, read: symbol, write: symbol)

harmless_record_race(f, r, w) :-
  reads_then_writes_record(f, r, w, t, _),
  mnesia_op(w, _, op, _, _, _, _, _),
  (op = "dirty_delete" ; op = "dirty_delete_object"),
  !record_writes_back(t).

harmless_record_race(f, r, w) :-
  reads_then_writes_record(f, r, w, t, _),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  !record_carries_read(w),
  !record_writes_back(t),
  !guards_record(r, w),
  !record_decides_more(r, w),
  !record_decision_escapes(r).

// A guard on what the record holds: a field past the table and the key
// (element 2 on) compared with a value the write stores.
.decl guards_record(read: symbol, write: symbol)

guards_record(r, w) :-
  reads_then_writes_record(_, r, w, _, _),
  records.carries(f, kind, src, r, _, _, _, _),
  field_compared(f, kind, src, pos, ok, os),
  pos >= 2,
  records.act(w, f, _, _, _, _),
  site_reads(w, f, ok, os).

guards_record(r, w) :-
  reads_then_writes_record(_, r, w, _, _),
  records.carries(f, kind, src, r, _, _, _, _),
  field_compared(f, kind, src, pos, ok, os),
  pos >= 2,
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "param", q),
  call_arg_reads(f, h, n, ok, os),
  q = to_string(n).

.decl record_decides_more(read: symbol, write: symbol)

record_decides_more(r, w) :-
  reads_then_writes_record(_, r, w, _, _),
  records.carries(f, kind, src, r, _, _, _, _),
  effect_decided(f, kind, src).

record_decides_more(r, w) :-
  reads_then_writes_record(_, r, w, _, _),
  records.carries(f, kind, src, r, _, _, _, _),
  site_depends(s, f, kind, src),
  s != w,
  shared_write(s).

// The decision leaves the function, as decision_escapes asks of ETS.
.decl record_decision_returned(func: symbol, check: symbol)

record_decision_returned(f, c) :-
  reads_then_writes_record(f, c, _, _, _),
  records.carries(f, kind, src, c, _, _, _, _),
  returns_depends(f, kind, src).

record_decision_returned(g, c) :-
  record_decision_returned(f, c),
  records.carries(g, "call", f, c, _, _, _, _),
  returns_depends(g, "call", f).

.decl record_decision_escapes(check: symbol)

record_decision_escapes(c) :-
  record_decision_returned(g, c),
  call_decided(_, _, "call", g).

record_decision_escapes(c) :-
  record_decision_returned(g, c),
  function_def(g, _, _, _, 1),
  !callee_returns(g, "constant").
