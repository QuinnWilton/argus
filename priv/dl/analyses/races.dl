// Check-then-act races on process names, ETS rows, and Mnesia records, plus ETS
// publication-order races. A finding requires a conflicting concurrent operation and a
// harmful result that no serial ordering produces.
// `CheckThenAct` follows dependent checks and acts across functions. `EtsTable`
// provides shared table identity. One `RunsConcurrently` instance classifies the
// processes running all candidate pairs and writes. See
// docs/analyses/races.md#interference-model and
// Christakis and Sagonas, PADL 2010.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/request_entry.dl"
.include "../clientlib/concurrency.dl"
.include "../clientlib/check_then_act.dl"
.include "../clientlib/specs.dl"
.include "../clientlib/tables.dl"
.include "../clientlib/order.dl"
.include "../clientlib/dictionary.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/tooling.dl"
.include "../clientlib/escape.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

.init runs = RunsConcurrently

// Lookup followed by a name claim or release
//
// Two callers can both observe an unused name before either starts or registers it. An
// unregister can also race with process exit or another unregister. Follow check/act
// dependence across functions and match registry, source, and key. For start_child's
// hidden name, accept a deciding nil check.
// Suppress when the losing result or exception is handled, or when no competing process
// can run the pair.

.init names = CheckThenAct

// A lookup observes a free name and controls a claim, but another process can claim it
// first. The losing outcome is unhandled. `func` is their meeting point.
.decl lookup_then_claim_race(func: symbol, lookup: symbol, claim: symbol, name: ProcessName)

lookup_then_claim_race(func, lookup, claim, name) :-
  decides_claim(func, lookup, claim, name),
  claimed_by_another_process(claim, func),
  !loser_taken(func, claim),
  !loser_dropped(func, claim).

// A process name's key and source, such as a literal or caller parameter, shared by the
// lookup and claim.
.type ProcessName = [key_source: symbol, key: symbol]

// The lookup's absence result controls the claim, possibly across helpers. For
// start_child's hidden name, require an explicit nil check.
.decl decides_claim(func: symbol, lookup: symbol, claim: symbol, name: ProcessName)

decides_claim(f, c, a, [ks, k]) :-
  names.meets(f, c, a, _, _, ks, k),
  name_act(a, _, api),
  api != "start_child".

decides_claim(f, c, a, [ks, k]) :-
  names.meets(f, c, a, _, _, ks, k),
  name_lookup(c, _, _, _, _, _, "checked").

// The resource is the registry: the local one (empty) or a Registry.
names.check(c, f, "literal", scope, ks, k) :-
  name_lookup(c, f, _, scope, ks, k, _),
  scope != "dynamic".

names.check(c, f, "dynamic", "", ks, k) :- name_lookup(c, f, _, "dynamic", ks, k, _).

names.act(a, f, "any", "", "any", "") :- creating_op(a, f, "start_child", _, _, _).

names.act(a, f, "literal", scope, ks, k) :-
  creating_op(a, f, api, scope, ks, k),
  api != "start_child",
  scope != "dynamic".

names.act(a, f, "dynamic", "", ks, k) :-
  creating_op(a, f, api, "dynamic", ks, k),
  api != "start_child".

names.act(a, f, "literal", "", ks, k) :- name_release(a, f, _, ks, k).

.decl name_act(act: symbol, func: symbol, api: symbol)

name_act(a, f, api) :- creating_op(a, f, api, _, _, _).
name_act(a, f, api) :- name_release(a, f, api, _, _).

// The losing start result is compared, or its badarg is caught, at the meeting function
// or a caller receiving the result.
.decl start_error_handled(func: symbol)

start_error_handled(f) :- start_error_compared(f, _).
start_error_handled(f) :- call_edge(g, f), start_error_compared(g, _).
start_error_handled(f) :- rescues_argument_error(f).
start_error_handled(f) :- returns_call(g, f), start_error_handled(g).

// The loser's outcome is taken where the pair meets or where the act is.
.decl loser_taken(meet: symbol, act: symbol)

loser_taken(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, _, api),
  api != "unregister",
  start_error_handled(f).

loser_taken(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, g, api),
  api != "unregister",
  start_error_handled(g).

loser_taken(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, _, "unregister"),
  rescues_argument_error(f).

loser_taken(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, g, "unregister"),
  rescues_argument_error(g).

// A named start whose failure is a returned value may be safe when that result is
// ignored all the way back to the check: either winner leaves the name registered.
// Require unused results along every forwarding step. Exclude start_child,
// Registry.register, and raising APIs, whose losing outcomes have different effects.
.decl act_callee(act: symbol, callee: symbol)

act_callee(a, cat(m, ":", n, "/", to_string(ar))) :-
  name_act(a, _, _),
  remote_call(a, _, m, n, ar).

.decl act_result_read(act: symbol)

act_result_read(a) :- name_act(a, _, _), site_depends(_, _, "site", a).
act_result_read(a) :- name_act(a, _, _), call_decided(_, _, "site", a).
act_result_read(a) :- name_act(a, _, _), call_arg_depends(_, _, _, "site", a).

.decl act_returned_by(act: symbol, func: symbol)

act_returned_by(a, g) :- name_act(a, _, _), returns_depends(g, "site", a).
act_returned_by(a, h) :- act_returned_by(a, g), returns_depends(h, "call", g).

.decl result_used(func: symbol)

result_used(g) :- act_returned_by(_, g), site_depends(_, _, "call", g).
result_used(g) :- act_returned_by(_, g), call_decided(_, _, "call", g).
result_used(g) :- act_returned_by(_, g), call_arg_depends(_, _, _, "call", g).

// A named start's loser answer is dropped on its way back to the
// meeting function, and the program goes on by the name (above).
.decl loser_dropped(meet: symbol, act: symbol)

loser_dropped(f, a) :-
  names.meets(f, _, a, _, _, _, _),
  name_act(a, _, api),
  (api = "start" ; api = "start_link" ; api = "start_via"),
  act_callee(a, callee),
  callee_returns(callee, "can_fail"),
  !act_result_read(a),
  !act_returned_by(a, f),
  !returned_and_used(a).

.decl returned_and_used(act: symbol)

returned_and_used(a) :- act_returned_by(a, g), result_used(g).

runs.seed(f) :- names.meets(f, _, _, _, _, _, _).

// Competing name operations
//
// A rival may be another execution of the pair or a separate process claiming the same
// literal name in the same registry. Resolve names at the operation or at callers
// passing literals into helpers.
.decl claims_name(act: symbol, func: symbol, scope: symbol, key: symbol)

claims_name(a, g, scope, k) :- creating_op(a, g, api, scope, "literal", k), api != "start_child".
claims_name(a, g, "", k) :- name_release(a, g, _, "literal", k).

claims_name(a, g, scope, k) :-
  creating_op(a, h, api, scope, "param", q),
  api != "start_child",
  call_arg(g, h, n, k),
  k != "dynamic",
  q = to_string(n).

runs.seed(g) :- claims_name(_, g, _, _).

.decl pair_scope(func: symbol, act: symbol, scope: symbol)

pair_scope(f, a, scope) :- names.meets(f, _, a, "literal", scope, _, _).

// Another process claims the pair's name while the pair's own process is
// between its lookup and its act.
.decl other_claimant(func: symbol, act: symbol)

other_claimant(f, a) :-
  names.meets(f, _, a, _, _, "literal", k),
  pair_scope(f, a, scope),
  claims_name(a2, g, scope, k),
  a2 != a,
  runs.beside_single_process(f, g).

// A rival can claim the name: another execution of this multi-process function, or a
// separate process claiming the same literal name.
.decl claimed_by_another_process(claim: symbol, func: symbol)

claimed_by_another_process(a, f) :- names.meets(f, _, a, _, _, _, _), !runs.single_process(f).
claimed_by_another_process(a, f) :- other_claimant(f, a).

.decl registry_race(mod: symbol, func: symbol, lookup_api: symbol, create_api: symbol, key_source: symbol, key: symbol, check: symbol, act: symbol)
.output registry_race

registry_race(mod, func, lookup_api, create_api, key_source, key, lookup, claim) :-
  lookup_then_claim_race(func, lookup, claim, [key_source, key]),
  name_lookup(lookup, _, lookup_api, _, _, _, _),
  name_act(claim, _, create_api),
  function_def(func, mod, _, _, _).

// ETS read followed by a write
//
// Require one public-table key, a concurrent rival write, and a harm witness. Protected
// tables have one writer. Follow checks, writes, and table parameters across functions,
// including unnamed allocations and externally supplied tables. Atomic alternatives
// include insert_new, update_counter, and select_replace.

.init rows = CheckThenAct

.decl deciding_read_op(op: symbol)

deciding_read_op("lookup").
deciding_read_op("lookup_element").
deciding_read_op("member").

// Key matches act as lookups. Exclude select match specifications and dynamic keys
// because their keys are not extracted.
deciding_read_op("match").
deciding_read_op("match_object").

.decl plain_write_op(op: symbol)

plain_write_op("insert").
plain_write_op("delete").
plain_write_op("delete_object").
plain_write_op("update_element").

// Represent the operation's table as its local parameter or possible EtsTable
// identities. Translate parameters at each call to preserve caller-specific tables.
.decl ets_table_ident(id: symbol, ts: symbol, t: symbol)

ets_table_ident(id, "param", to_string(p)) :- ets_op(id, _, "dynamic", _, _), ets_op_param(id, p).

ets_table_ident(id, ts, t) :-
  ets_op(id, _, _, _, _),
  !handed_table(id),
  ets_table(id, k, t),
  table_source(k, ts).

.decl handed_table(id: symbol)

handed_table(id) :- ets_op(id, _, "dynamic", _, _), ets_op_param(id, _).

rows.check(read, func, table_kind, table, key_kind, key) :-
  deciding_read(read, func),
  local_table_and_key(read, table_kind, table, key_kind, key).

rows.act(write, func, table_kind, table, key_kind, key) :-
  plain_write(write, func),
  local_table_and_key(write, table_kind, table, key_kind, key).

// A read whose answer a caller can decide on, and a write that is not
// one of the atomic forms.
.decl deciding_read(read: symbol, func: symbol) inline
.decl plain_write(write: symbol, func: symbol) inline

deciding_read(r, f) :- ets_op(r, f, _, op, "read"), deciding_read_op(op).
plain_write(w, f) :- ets_op(w, f, _, op, "write"), plain_write_op(op).

// An operation's table and key, the table in its own function's terms
// (ets_table_ident) or as clientlib/tables.dl knows it (ets_table).
.decl local_table_and_key(op: symbol, table_kind: symbol, table: symbol, key_kind: symbol, key: symbol) inline
.decl table_and_key(op: symbol, table_kind: symbol, table: symbol, key_kind: symbol, key: symbol) inline

local_table_and_key(op, ts, t, ks, k) :- ets_table_ident(op, ts, t), op_key(op, ks, k).
table_and_key(op, tk, t, ks, k) :- ets_table(op, tk, t), op_key(op, ks, k).

// Use the inserted object's first element as key unless a known custom keypos selects
// element N - 1, supplied by ets_value.
.decl op_key(op: symbol, key_kind: symbol, key: symbol)

op_key(op, ks, k) :- ets_key(op, ks, k), !keyed_past_zero(op, _).

op_key(op, ks, k) :-
  keyed_past_zero(op, v),
  ets_value(op, pos, ks, k),
  to_string(pos + 1) = v.

.decl keyed_past_zero(op: symbol, keypos: symbol)

keyed_past_zero(op, v) :-
  ets_op(op, _, _, o, "write"),
  (o = "insert" ; o = "insert_new"),
  ets_table(op, tk, t),
  site_table(n, tk, t),
  ets_option(n, "keypos", v),
  v != "1".

// ETS accessors
//
// A function containing one ETS operation on a named table and no other shared-state
// operation acts as an accessor. Anchor at the meeting function's direct accessor call,
// otherwise at the operation. Accessors retain normal key and harm checks; writing a
// constant without a conflicting rival is not a race.
.decl ets_accessor(func: symbol, op: symbol, key_kind: symbol)

ets_accessor(g, w, "param") :- lone_ets_op(g, w), op_key(w, ks, _), ks != "literal", ks != "dynamic".
ets_accessor(g, w, "fixed") :- lone_ets_op(g, w), op_key(w, "literal", _).

.decl lone_ets_op(func: symbol, op: symbol)

lone_ets_op(g, w) :-
  ets_op(w, g, name, _, _),
  name != "dynamic",
  count : { ets_op(_, g, _, _, _) } = 1,
  !other_shared_op(g).

.decl other_shared_op(func: symbol)

other_shared_op(g) :- mnesia_op(_, g, _, _, _, _, _, _).
other_shared_op(g) :- name_lookup(_, g, _, _, _, _, _).
other_shared_op(g) :- creating_op(_, g, _, _, _, _).
other_shared_op(g) :- name_release(_, g, _, _, _).

// Where `func` calls the accessor holding `op`: the site a lifted
// operation is reported at.
.decl accessor_call(func: symbol, op: symbol, site: symbol)

accessor_call(f, w, c) :-
  rows.meets(f, _, w, _, _, _, _),
  ets_accessor(g, w, _),
  g != f,
  function_def(g, m, n, a, _),
  call_site(c, f, m, n, a).

accessor_call(f, r, c) :-
  rows.meets(f, r, _, _, _, _, _),
  ets_accessor(g, r, _),
  g != f,
  function_def(g, m, n, a, _),
  call_site(c, f, m, n, a).

// The site a pair's operation is reported at in the function where it
// meets: the operation, or the call to the accessor holding it.
.decl reported_at(func: symbol, op: symbol, site: symbol)

reported_at(f, op, c) :- accessor_call(f, op, c).
reported_at(f, op, op) :- rows.meets(f, op, _, _, _, _, _), !accessor_call(f, op, _).
reported_at(f, op, op) :- rows.meets(f, _, op, _, _, _, _), !accessor_call(f, op, _).

// The read controls or supplies the write on one row in `func`. Use shared `EtsTable`
// identity or the table supplied through func's parameter. Exclude dictionary fallback
// tables when func has already set the dictionary key (`skips_default`).
.decl decides_write(func: symbol, read: symbol, write: symbol, row: EtsRow)

decides_write(f, r, w, [table, ks, k]) :-
  rows.meets(f, r, w, ts, t, ks, k),
  table_in(f, ts, t, table),
  !skips_default(f, r, table),
  !skips_default(f, w, table).

// The table a pair meets on in `func`, from how func's terms name it.
.decl table_in(func: symbol, source: symbol, ident: symbol, table: EtsTable)

table_in(f, ts, t, [k, t]) :- rows.meets(f, _, _, ts, t, _, _), table_source(k, ts).
table_in(f, "param", p, [k, t]) :- rows.meets(f, _, _, "param", p, _, _), param_table(f, p, k, t).

// The same pairs, by the table and the key alone: what the rivals and
// the harms below are asked of.
.decl reads_then_writes(func: symbol, read: symbol, write: symbol, table: EtsTable, key: symbol)

reads_then_writes(f, r, w, table, k) :- decides_write(f, r, w, [table, _, k]).

// Externally supplied tables
//
// A table parameter forwarded from an external library entry has unknown allocation
// options. Treat it like a public table when multiple processes run the writer:
// protected/private tables would reject non-owner writes. A single-process pair has no
// assumed external rival; only visible forwarded uses can name this table.

runs.seed(f) :- reads_then_writes(f, _, _, _, _).

// Rival writes
//
// A rival is another execution of the pair or a same-row write in a different running
// process. Resolve parameter keys at callers; only external entries retain
// arbitrary-key writes. Newly minted keys cannot collide with previously read rows and
// are excluded. A rival alone is insufficient; the next section requires a harm
// witness.
.decl rival_table(table: EtsTable)

rival_table(table) :- reads_then_writes(_, _, _, table, _).

// The tables a write or a counter bump may touch (clientlib/tables.dl).
.decl ets_op_table(id: symbol, table: EtsTable)

ets_op_table(id, [k, t]) :- ets_table(id, k, t), ets_op(id, _, _, _, _).

// A write of a table some pair touches, in the function holding it.
.decl table_write(write: symbol, func: symbol, table: EtsTable)

table_write(w, g, table) :- ets_op(w, g, _, _, "write"), ets_op_table(w, table), rival_table(table).

// The write's locally constructed key. A "minted" key is freshly generated and cannot
// equal another independently generated key.
.decl write_key(write: symbol, key_kind: symbol, key: symbol)

write_key(w, "minted", w) :- table_write(w, _, _), minted_key(w).
write_key(w, ks, k) :- table_write(w, _, _), op_key(w, ks, k), !minted_key(w).

// A write with no key the extractor names (select_delete, delete_all_
// objects, deleting the table) touches any row.
write_key(w, "any", "") :- table_write(w, _, _), !op_key(w, _, _).

// rival_write(w, h, table, ks, k): calling `h` may make write `w` of
// `table`, at the row h names (ks, k).
.decl rival_write(write: symbol, func: symbol, table: EtsTable, key_kind: symbol, key: symbol)

rival_write(w, g, table, ks, k) :- table_write(w, g, table), write_key(w, ks, k), ks != "param".

// A parameter key, carried up to every caller that fills it.
.decl param_write(write: symbol, func: symbol, table: EtsTable, pos: symbol)

param_write(w, g, table, q) :- table_write(w, g, table), write_key(w, "param", q).

param_write(w, h, table, to_string(p)) :-
  param_write(w, g, table, q),
  call_arg_forward(h, g, n, p),
  q = to_string(n).

rival_write(w, h, table, "literal", v) :-
  param_write(w, g, table, q),
  call_arg(h, g, n, v),
  v != "dynamic",
  q = to_string(n).

// A tuple the caller builds: `add({tab, :where_to_write}, v)`.
rival_write(w, h, table, "tuple", "") :-
  param_write(w, g, table, q),
  call_arg_tuple(h, g, n, _, _, _),
  q = to_string(n).

// Anything else a caller computes is a key the facts cannot name.
rival_write(w, h, table, "dynamic", "") :-
  param_write(w, g, table, q),
  call_arg(h, g, n, "dynamic"),
  q = to_string(n).

rival_write(w, h, table, "element", "") :-
  param_write(w, g, table, q),
  call_arg_element(h, g, n, _, _),
  q = to_string(n).

// External callers may supply any key. The same applies to parameters with no visible
// caller, including passed closures and dynamically applied functions.
rival_write(w, g, table, "param", q) :- param_write(w, g, table, q), outside_entry(g).
rival_write(w, g, table, "param", q) :- param_write(w, g, table, q), !param_filled(g, q).

.decl param_filled(func: symbol, pos: symbol)

param_filled(g, to_string(n)) :- param_write(_, g, _, _), call_arg(_, g, n, _).
param_filled(g, to_string(n)) :- param_write(_, g, _, _), call_arg_forward(_, g, n, _).

// An externally callable library export, excluding runtime callbacks. See
// outside_caller in concurrency.dl.
.decl outside_entry(func: symbol)

outside_entry(g) :- runs.outside_caller(g).

// Keys treated as disjoint: distinct literals, incompatible tuple shapes, process-owned
// self() rows, and minted keys. Literal keys are also assumed distinct from computed
// keys; collisions where computation reproduces a literal are a known blind spot.
.decl keys_apart(ks: symbol, k: symbol, ks2: symbol, k2: symbol)

keys_apart(ks, k, "literal", k2) :- pair_key(_, _, ks, k), ks = "literal", rival_write(_, _, _, "literal", k2), k != k2.

keys_apart("literal", k, "tuple", k2) :-
  pair_key(_, _, "literal", k),
  !match("[{].*", k),
  rival_write(_, _, _, "tuple", k2).

keys_apart("tuple", k, "literal", k2) :-
  pair_key(_, _, "tuple", k),
  rival_write(_, _, _, "literal", k2),
  !match("[{].*", k2).

keys_apart("literal", k, "self", k2) :- pair_key(_, _, "literal", k), rival_write(_, _, _, "self", k2).
keys_apart("self", k, ks2, k2) :- pair_key(_, _, "self", k), rival_write(_, _, _, ks2, k2), (ks2 = "literal" ; ks2 = "self").
keys_apart(ks, k, "minted", k2) :- pair_key(_, _, ks, k), rival_write(_, _, _, "minted", k2).

keys_apart(ks, k, "literal", k2) :-
  pair_key(_, _, ks, k),
  ks != "literal",
  ks != "any",
  ks != "tuple",
  rival_write(_, _, _, "literal", k2).

keys_apart("literal", k, ks2, k2) :-
  pair_key(_, _, "literal", k),
  rival_write(_, _, _, ks2, k2),
  computed_in_view(ks2).

// Computed keys include local/dynamic values, map fields, and parameter elements.
// External or unfilled parameters may name any key.
.decl computed_in_view(key_kind: symbol)

computed_in_view("dynamic").
computed_in_view("local").
computed_in_view("field").
computed_in_view("element").
computed_in_view(ks) :- rival_write(_, _, _, ks, _), match("element [0-9]+", ks).

// The key a pair meets on, in the meeting function's terms, and the
// table it is on.
.decl pair_key(func: symbol, table: EtsTable, key_kind: symbol, key: symbol)

pair_key(f, table, ks, k) :- decides_write(f, _, _, [table, ks, k]).

.decl pair_key_of(func: symbol, read: symbol, write: symbol, key_kind: symbol, key: symbol)

pair_key_of(f, r, w, ks, k) :- reads_then_writes(f, r, w, _, _), rows.meets(f, r, w, _, _, ks, k).

runs.seed(h) :- rival_write(_, h, _, _, _).

// A function reached after process startup from callbacks, spawned bodies, requests, or
// external callers. Init-only writes are assumed ordered before the pair's process
// starts. Known limit: later-sibling initialization and isolated restarts can overlap
// the pair but are not modeled here.
.init writer_walk = SameProcessReach

writer_walk.seed(h, h) :- rival_write(_, h, _, _, _).

.decl writes_after_start(func: symbol)

writes_after_start(g) :- process_entry(_, c), writer_walk.reaches(c, g), !startup_callback(c).
writes_after_start(g) :- outside_entry(c), writer_walk.reaches(c, g).
writes_after_start(g) :- request_entry(e, _), writer_walk.reaches(e, g).
writes_after_start(g) :- runs.spawned(_, _, r), writer_walk.reaches(r, g).

// A rival write can overlap the pair when its function runs concurrently after startup
// and no handoff orders it. Attribute execution to the writing function, even when the
// key is named by a caller.
.decl concurrent(func: symbol, rival_func: symbol, rival_write: symbol)

concurrent(f, h, w2) :-
  reads_then_writes(f, _, _, table, _),
  !runs.single_process(f),
  rival_write(w2, h, table, _, _),
  writes_after_start(h).

concurrent(f, h, w2) :-
  reads_then_writes(f, _, _, table, _),
  runs.single_process(f),
  runs.entry_reaches(m, f),
  rival_write(w2, h, table, _, _),
  table_write(w2, g, _),
  runs.runs_beside_up(m, f, h, g).

runs.seed(g) :- table_write(_, g, _).

// A write `w2` through `h` may occur between pair `(r, w)` in `f` on the same row. The
// pair can rival itself when multiple processes run it, except for self()-keyed or
// exclusively held rows.
.decl rival(func: symbol, read: symbol, write: symbol, rival_write: symbol, rival_func: symbol)

rival(f, r, w, w, f) :-
  reads_then_writes(f, r, w, _, _),
  !runs.single_process(f),
  pair_key_of(f, r, w, ks, _),
  ks != "self",
  !held_row(w).

rival(f, r, w, w2, h) :-
  reads_then_writes(f, r, w, table, _),
  pair_key_of(f, r, w, ks, k),
  rival_write(w2, h, table, ks2, k2),
  w2 != w,
  !keys_apart(ks, k, ks2, k2),
  concurrent(f, h, w2).

// The pair's write may also be called independently, such as an accessor used by both
// an incrementer and a resetter. Calls merely executing the pair are not separate
// rivals. A helper used by a single-process pair counts if another process also runs
// it.
rival(f, r, w, w, h) :-
  reads_then_writes(f, r, w, table, _),
  runs.single_process(f),
  pair_key_of(f, r, w, ks, k),
  rival_write(w, h, table, ks2, k2),
  h != f,
  !keys_apart(ks, k, ks2, k2),
  concurrent(f, h, w).

rival(f, r, w, w, h) :-
  reads_then_writes(f, r, w, table, _),
  !runs.single_process(f),
  pair_key_of(f, r, w, ks, k),
  rival_write(w, h, table, ks2, k2),
  !writer_walk.reaches(f, h),
  !writer_walk.reaches(h, f),
  !keys_apart(ks, k, ks2, k2),
  concurrent(f, h, w).

writer_walk.seed(f, f) :- reads_then_writes(f, _, _, _, _).

// Harm witnesses
// - lost_update: writing back read-derived data overwrites a rival's change. A deletion
// conflicts only if the act can recreate the row.
// - clobber: an independent value overwrites a row a rival has counted in.
// - stale_fill: a computed refill lands after a rival invalidates or replaces its
// source value.
// - state_delete: a decision based on row contents deletes a rival's replacement.
// Presence-only deletes and discarded cache copies do not qualify.
// - claim: both callers receive a successful claim verdict.
// - take: both callers receive the removed row's value.
// - decides_more: the check also triggers another shared write or external effect.
// - guarded: a row-value comparison permits writes that can land in the wrong order.
// - minted: callers receive distinct new values but only one remains stored.
// The first four require a row-changing rival. The remaining cases require a rival
// making the same decision, except `guarded`, which accepts any rival. Without a harm
// witness, duplicate default writes, refills, deletes, and markers are not reported.
.init ets_carried = PairCarries

ets_carried.pair(f, r, w) :- reads_then_writes(f, r, w, _, _).
ets_carried.read_in(r, g) :- ets_op(r, g, _, _, "read").
ets_carried.write_in(w, h) :- ets_op(w, h, _, _, "write").
ets_carried.fresh(kind, src) :- fill_source(kind, src).

// A write of a value, and the writes that make a row.
.decl value_write(w: symbol)

value_write(w) :- ets_op(w, _, _, op, "write"), (op = "insert" ; op = "update_element").

.decl makes_row(write: symbol)

makes_row(w) :- ets_op(w, _, _, "insert", "write").
makes_row(w) :- ets_op(w, _, _, "insert_new", "write").
makes_row(w) :-
  ets_op(w, _, _, "update_counter", "write"),
  remote_call(w, _, ":ets", "update_counter", 4).

.decl removal(write: symbol)

removal(w) :- ets_op(w, _, _, op, "write"), ets_removal_op(op).

// A write that changes what the row holds: stores a value, counts in it,
// or removes it.
.decl changes_row(write: symbol)

changes_row(w) :- ets_op(w, _, _, op, "write"), op != "insert_new".

// Counting writes include update_counter, read-derived write-backs, and replacement of
// rows holding atomics/counters arrays whose accumulated counts would be lost.
.init ets_made = MadeOfRead

ets_made.read(r) :- ets_op(r, _, _, _, "read").
ets_made.write(w, h) :- table_write(w, h, _), value_write(w).

.decl counts_in(write: symbol, func: symbol)

counts_in(w, h) :- rival_write(w, h, _, _, _), ets_op(w, _, _, "update_counter", _).
counts_in(w, h) :- rival_write(w, h, _, _, _), stores_counters(w).
counts_in(w, h) :- rival_write(w, h, _, _, _), rival_value(w, h, k, s), rival_made.made(h, k, s).

// Translate a rival's stored value into the function naming its key, through the same
// lifted caller chain used for the key.
.decl rival_value(write: symbol, func: symbol, kind: symbol, src: symbol)

rival_value(w, g, k, s) :- table_write(w, g, _), value_write(w), site_reads(w, g, k, s).

rival_value(w, h, k, s) :-
  rival_value(w, g, "param", p),
  param_write(w, g, _, _),
  call_arg_reads(h, g, n, k, s),
  p = to_string(n).

// Made of a read of the table, in the rival's terms (MadeOfRead, asked
// of the rivals' values).
.init rival_made = MadeOfRead

rival_made.read(r) :- ets_op(r, _, _, _, "read").
rival_made.write(w, g) :- table_write(w, g, _), value_write(w).
rival_made.asked(h, k, s) :- rival_value(w, h, k, s), rival_write(w, h, _, _, _).

.decl stores_counters(write: symbol)

stores_counters(w) :-
  ets_op(w, _, _, op, "write"),
  (op = "insert" ; op = "insert_new"),
  ets_value(w, _, "local", made),
  remote_call(made, _, m, "new", 2),
  (m = ":atomics" ; m = ":counters").

// A refill obtains its value from a call or another store, such as Mnesia or a
// registry. Other values are local to the writer.
.decl fill_source(kind: symbol, src: symbol)

fill_source("call", g) :- site_reads(_, _, "call", g).
fill_source("call", g) :- call_arg_reads(_, _, _, "call", g).
fill_source("site", r) :- site_reads(_, _, "site", r), !ets_op(r, _, _, _, _).
fill_source("site", r) :- call_arg_reads(_, _, _, "site", r), !ets_op(r, _, _, _, _).

// A refill row is a cached value computed on a miss or stale read. Other writes
// establish independent state, such as a pid, caller value, or count.
.decl refill_row(write: symbol)

refill_row(w) :- ets_carried.fills(_, _, w).

// A rival that makes the row with a value of its own, not a refill.
.decl makes_own_row(write: symbol)

makes_own_row(w) :- makes_row(w), !refill_row(w).

// A rival that rewrites the row with a value of its own, or removes it:
// what makes a refill stale.
.decl invalidates(write: symbol, func: symbol)

invalidates(w, h) :- rival_write(w, h, _, _, _), removal(w).
invalidates(w, h) :- rival_write(w, h, _, _, _), value_write(w), !refill_row(w).
invalidates(w, h) :- counts_in(w, h).

// A rival that makes the pair's decision too: the pair itself, or
// another pair's write.
.decl decides_too(func: symbol, read: symbol, write: symbol, rival_write: symbol, rival_func: symbol)

decides_too(f, r, w, w, f) :- rival(f, r, w, w, f).
decides_too(f, r, w, w2, h) :- rival(f, r, w, w2, h), rows.meets(_, _, w2, _, _, _, _).

// Fresh values come from random APIs, unique integers, references, or project wrappers
// returning them.
.decl unique_api(api: symbol)

unique_api("System.unique_integer/0").
unique_api("System.unique_integer/1").
unique_api(":erlang.unique_integer/0").
unique_api(":erlang.unique_integer/1").
unique_api(":erlang.make_ref/0").
unique_api("Kernel.make_ref/0").

.decl mints(callee: symbol)

mints(g) :-
  impure_call(id, _, _, "random", _),
  remote_call(id, _, m, n, a),
  g = cat(m, ":", n, "/", to_string(a)).

mints(g) :- function_def(g, _, _, _, _), impure_call(_, g, _, "random", _).
mints(g) :- function_def(g, _, _, _, _), impure_call(_, g, api, _, _), unique_api(api).
mints(g) :- function_def(g, _, _, _, _), returns_depends(g, "call", g2), mints(g2).

// The write's value is minted by a call the writing function also
// returns, to a caller that uses it or one outside the program.
.decl mint_handed_out(w: symbol)

mint_handed_out(w) :-
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "call", g),
  mints(g),
  returns_depends(h, "call", g),
  result_leaves(h).

.decl result_leaves(func: symbol)

result_leaves(h) :- rows.act(_, h, _, _, _, _), api_export(h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), site_depends(_, _, "call", h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), call_decided(_, _, "call", h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), call_arg_depends(_, _, _, "call", h).
result_leaves(h) :- rows.act(_, h, _, _, _, _), returns_depends(_, "call", h).

// The pair's decision escapes through a returned result to a branching caller or an
// external export. A constant-return spec rules out a returned decision.
.decl decision_returned(meet: symbol, func: symbol, check: symbol)

decision_returned(f, f, c) :-
  reads_then_writes(f, c, _, _, _),
  rows.carries(f, kind, src, c, _, _, _, _),
  returns_depends(f, kind, src).

decision_returned(f, g, c) :-
  decision_returned(f, h, c),
  rows.carries(g, "call", h, c, _, _, _, _),
  returns_depends(g, "call", h).

.decl decision_escapes(meet: symbol, check: symbol)

decision_escapes(f, c) :-
  decision_returned(f, g, c),
  call_decided(_, _, "call", g).

decision_escapes(f, c) :-
  decision_returned(f, g, c),
  api_export(g),
  !callee_returns(g, "constant").

// A verdict escapes when the function returns a control-selected result without
// read-derived data. Returning a row or cached value alone is not a claim.
.decl verdict_escapes(func: symbol, check: symbol)

verdict_escapes(f, c) :-
  decision_escapes(f, c),
  !ets_carried.answers(f, c).

// Inspect additional decisions and effects only along this pair's returned-read path to
// its meeting function. Shared accessors can belong to separate pairs with different
// decisions.
.decl pair_path(meet: symbol, check: symbol, func: symbol)

pair_path(f, c, f) :- reads_then_writes(f, c, _, _, _).
pair_path(f, c, g) :- reads_then_writes(f, c, _, _, _), rows.carried_through(f, c, g).

// The decision tests row contents beyond the key, directly or through a helper.
// Presence checks and key comparisons alone do not establish a content-dependent
// decision.
.decl tests_row_fields(meet: symbol, read: symbol)

tests_row_fields(f, r) :-
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  field_decides(g, kind, src, pos),
  pos >= 1.

tests_row_fields(f, r) :-
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  call_arg_depends(g, h, n, kind, src),
  field_decides(h, "param", q, pos),
  q = to_string(n),
  pos >= 1.

// A guard compares a non-key row field with the value later stored, along this pair's
// data path or in a receiving helper.
.decl guards_row(meet: symbol, read: symbol, write: symbol)

guards_row(f, r, w) :-
  reads_then_writes(f, r, w, _, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  field_compared(g, kind, src, pos, ok, os),
  pos >= 1,
  rows.act(w, g, _, _, _, _),
  site_reads(w, g, ok, os).

guards_row(f, r, w) :-
  reads_then_writes(f, r, w, _, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  field_compared(g, kind, src, pos, ok, os),
  pos >= 1,
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, "param", q),
  call_arg_reads(g, h, n, ok, os),
  q = to_string(n).

guards_row(f, r, w) :-
  reads_then_writes(f, r, w, _, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  call_arg_depends(g, h, n, kind, src),
  field_compared(h, "param", q, pos, ok, os),
  q = to_string(n),
  pos >= 1,
  rows.act(w, h, _, _, _, _),
  site_reads(w, h, ok, os).

// The read controls additional effects beyond the paired write: sends, external
// effects, other shared-state writes, or messages passed through one helper.
.decl decides_more(meet: symbol, read: symbol, write: symbol)

decides_more(f, r, w) :-
  reads_then_writes(f, r, w, _, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  effect_decided(g, kind, src).

decides_more(f, r, w) :-
  reads_then_writes(f, r, w, table, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  site_depends(s, g, kind, src),
  s != w,
  other_state_write(s, table).

decides_more(f, r, w) :- reads_then_writes(f, r, w, _, _), row_sends.sends(f, r).

// Also count a helper receiving read-derived or read-controlled data and changing other
// state on its same-process stack. A helper merely called after a miss, without
// receiving that data, may only compute the refill and does not qualify.
decides_more(f, r, w) :-
  decision_hands(f, r, w, h),
  reads_then_writes(f, r, w, table, _),
  decision_reach.reaches(h, k),
  changes_table(k, table2),
  table2 != table.

decides_more(f, r, w) :-
  decision_hands(f, r, w, h),
  decision_reach.reaches(h, k),
  changes_other_state(k).

// The helpers a pair's decision hands a value that carries the read, on
// the pair's path, by data (call_arg_reads).
.decl decision_hands(meet: symbol, read: symbol, write: symbol, helper: symbol)

decision_hands(f, r, w, h) :-
  reads_then_writes(f, r, w, _, _),
  pair_path(f, r, g),
  rows.carries(g, kind, src, r, _, _, _, _),
  call_arg_reads(g, h, _, kind, src).

// What the helper runs in its caller's process.
.init decision_reach = ForwardSameProcessReachCut

decision_reach.root(h, h) :- decision_hands(_, _, _, h).
decision_reach.cut(f, g) :- side_call(f, g).

// changes_table(func, table): func writes the ETS table `table`.
.decl changes_table(func: symbol, table: EtsTable)

changes_table(k, table) :- ets_op(s, k, _, _, "write"), ets_op_table(s, table).

// Other state changes include shared stores, registration, sends, peer calls/casts, and
// external runtime writes to processes, ports, files, networks, or nodes.
.decl changes_other_state(func: symbol)

changes_other_state(k) :- shared_write(s), !ets_op(s, _, _, _, _), (mnesia_op(s, k, _, _, _, _, _, _) ; creating_op(s, k, _, _, _, _) ; name_release(s, k, _, _, _)).
changes_other_state(k) :- delivers_message(k).

changes_other_state(k) :-
  impure_call(_, k, _, category, "write"),
  (category = "io" ; category = "process" ; category = "port" ; category = "node" ; category = "network" ; category = "code_loading").

// A decision-controlled write to another shared store. Further writes to the pair's own
// table belong to the same race.
.decl other_state_write(site: symbol, table: EtsTable)

other_state_write(s, table) :- rival_table(table), ets_op(s, _, _, _, "write"), ets_op_table(s, table2), table2 != table.
other_state_write(s, table) :- rival_table(table), shared_write(s), !ets_op(s, _, _, _, _).

.decl shared_write(site: symbol)

shared_write(s) :- ets_op(s, _, _, _, "write").
shared_write(s) :- mnesia_op(s, _, _, "write", _, _, _, _).
shared_write(s) :- creating_op(s, _, _, _, _, _).
shared_write(s) :- name_release(s, _, _, _, _).

// A send, a call or a cast, where the read's value decides on the pair's
// path or one call down (DecisionSends, clientlib/check_then_act.dl).
.init row_sends = DecisionSends

row_sends.carried(f, g, kind, src, r) :- pair_path(f, r, g), rows.carries(g, kind, src, r, _, _, _, _).

// A rival is a different write or a separate invocation of the paired write, possibly
// with a caller-supplied key.
.decl other_site(func: symbol, write: symbol, rival_write: symbol, rival_func: symbol)

other_site(f, w, w2, h) :- rival(f, _, w, w2, h), w2 != w.
other_site(f, w, w, h) :- rival(f, _, w, w, h), h != f.

// A refill from a mutable store or a call not known to depend only on its arguments.
// Pure key-derived values cannot become stale between computation and insertion;
// unknown effects remain potentially changing sources.
.decl fills_from_source(func: symbol, read: symbol, write: symbol)

fills_from_source(f, r, w) :- ets_carried.fresh_used(f, r, w, kind, src), changing_source(kind, src).

.decl changing_source(kind: symbol, src: symbol)

changing_source("site", s) :- fill_source("site", s).
changing_source("call", g) :- fill_source("call", g), reads_state(g).

// A function, or a call site's callee outside the program, whose answer
// may depend on state that changes.
.decl reads_state(func: symbol)

reads_state(g) :- fill_source("call", g), unknown_call(_, _, _, g).
reads_state(g) :- fill_source("call", g), protocol_dispatch(id, _, _), remote_call(id, _, m, n, a), g = cat(m, ":", n, "/", to_string(a)).

reads_state(g) :-
  fill_source("call", g),
  impure_call(id, _, _, category, "read"),
  category != "time",
  category != "random",
  remote_call(id, _, m, n, a),
  g = cat(m, ":", n, "/", to_string(a)).

reads_state(g) :- state_reader(g).

// A program function that reads changing state on its own stack.
.decl state_reader(func: symbol)

state_reader(g) :- function_def(g, _, _, _, _), unknown_call(_, g, _, _).
state_reader(g) :- function_def(g, _, _, _, _), protocol_dispatch(_, g, _).
state_reader(g) :- impure_call(_, g, _, category, "read"), category != "time", category != "random".
state_reader(g) :- ets_op(_, g, _, _, "read").
state_reader(g) :- mnesia_op(_, g, _, "read", _, _, _, _).
state_reader(g) :- local_call(_, g, h, _), state_reader(h).
state_reader(g) :- remote_call(_, g, m, n, a), h = cat(m, ":", n, "/", to_string(a)), function_def(h, _, _, _, _), state_reader(h).

// ets_harm_by(f, r, w, kind, w2, h): rival write w2 through h witnesses harm kind for
// read/write pair (r, w), meeting in f.
.decl ets_harm_by(func: symbol, read: symbol, write: symbol, kind: symbol, rival_write: symbol, rival_func: symbol)

ets_harm_by(f, r, w, "lost_update", w2, h) :-
  ets_carried.carries(f, r, w),
  value_write(w),
  rival(f, r, w, w2, h),
  changes_row(w2),
  !removal(w2).

ets_harm_by(f, r, w, "lost_update", w2, h) :-
  ets_carried.carries(f, r, w),
  makes_row(w),
  rival(f, r, w, w2, h),
  removal(w2).

ets_harm_by(f, r, w, "clobber", w2, h) :-
  value_write(w),
  rival(f, r, w, w2, h),
  other_site(f, w, w2, h),
  counts_in(w2, h).

// Competing inserts create separate counter arrays. Replacing one array with another
// loses counts accumulated in the replaced array.
ets_harm_by(f, r, w, "clobber", w, f) :- stores_counters(w), rival(f, r, w, w, f).

ets_harm_by(f, r, w, "stale_fill", w2, h) :-
  fills_from_source(f, r, w),
  rival(f, r, w, w2, h),
  other_site(f, w, w2, h),
  invalidates(w2, h),
  !removal(w2).

ets_harm_by(f, r, w, "stale_fill", w2, h) :-
  fills_from_source(f, r, w),
  makes_row(w),
  rival(f, r, w, w2, h),
  other_site(f, w, w2, h),
  removal(w2).

ets_harm_by(f, r, w, "state_delete", w2, h) :-
  ets_op(w, _, _, "delete", _),
  tests_row_fields(f, r),
  rival(f, r, w, w2, h),
  other_site(f, w, w2, h),
  makes_own_row(w2).

ets_harm_by(f, r, w, "state_delete", w2, h) :-
  ets_op(w, _, _, "delete", _),
  tests_row_fields(f, r),
  rival(f, r, w, w2, h),
  other_site(f, w, w2, h),
  counts_in(w2, h).

ets_harm_by(f, r, w, "claim", w2, h) :-
  makes_row(w),
  verdict_escapes(f, r),
  decides_too(f, r, w, w2, h).

ets_harm_by(f, r, w, "take", w2, h) :-
  ets_op(w, _, _, "delete", _),
  !tests_row_fields(f, r),
  decision_escapes(f, r),
  ets_carried.answers(f, r),
  decides_too(f, r, w, w2, h).

ets_harm_by(f, r, w, "decides_more", w2, h) :-
  decides_more(f, r, w),
  decides_too(f, r, w, w2, h).

// Competing refills copy the same source. Their order matters only when that source
// changes, providing evidence of a stale fill.
ets_harm_by(f, r, w, "guarded", w2, h) :-
  guards_row(f, r, w),
  !ets_carried.fills(f, r, w),
  rival(f, r, w, w2, h).

ets_harm_by(f, r, w, "minted", w, f) :- mint_handed_out(w), rival(f, r, w, w, f).

// Rows addressed by minted keys
//
// If every row-creating write mints a reference or unique integer key, and the pair
// only updates or deletes existing rows, assume each holder operates on its own row.
// The pair is then not its own rival. Known limit: facts do not track sharing one
// minted key among several processes.
.decl minting_call(mod: symbol, func: symbol, arity: number)

minting_call(":erlang", "make_ref", 0).
minting_call(":erlang", "monitor", 2).
minting_call(":erlang", "monitor", 3).
minting_call(":erlang", "unique_integer", 0).
minting_call(":erlang", "unique_integer", 1).
minting_call("System", "unique_integer", 0).
minting_call("System", "unique_integer", 1).

.decl minted_key(write: symbol)

minted_key(w) :-
  makes_row(w),
  op_key(w, "local", made),
  remote_call(made, _, m, n, a),
  minting_call(m, n, a).

// The table's row-creating writes all use freshly minted keys. Require at least one
// such write and no other key source.
.decl mints_rows(kind: symbol, table: symbol)
.decl names_rows(kind: symbol, table: symbol)

mints_rows(k, t) :- ets_table(w, k, t), minted_key(w).
names_rows(k, t) :- ets_table(w, k, t), makes_row(w), !minted_key(w).

// Every row uses a minted key, so only its creator can name it. Holding the table alone
// does not establish access to a specific row.
.decl mints_every_row(kind: symbol, table: symbol)

mints_every_row(k, t) :- mints_rows(k, t), !names_rows(k, t).

// The table may contain rows keyed by supplied or computed values. held_row tests the
// opposite case.
.decl on_table_not_all_minted(write: symbol)

on_table_not_all_minted(w) :- reads_then_writes(_, _, w, _, _), ets_table(w, k, t), !mints_every_row(k, t).

.decl held_row(write: symbol)

held_row(w) :-
  reads_then_writes(_, _, w, _, _),
  ets_table(w, _, _),
  !makes_row(w),
  !on_table_not_all_minted(w).

// A write another process makes, as made by calling `func`: the
// function that names its key (rival, above).
.type RivalWrite = [write: symbol, func: symbol]

// The table is public or supplied by external callers, allowing writes from multiple
// caller processes.
.decl on_public_table(row: EtsRow)

on_public_table([[tk, t], ks, k]) :- decides_write(_, _, _, [[tk, t], ks, k]), table_public(tk, t).
on_public_table([["handed_in", t], ks, k]) :- decides_write(_, _, _, [["handed_in", t], ks, k]).

// A competing process can write the same row between the paired read and write, either
// by running the pair again or executing another write.
.decl lands_between(rival: RivalWrite, read: symbol, write: symbol, func: symbol) inline

lands_between([w2, h], r, w, f) :- rival(f, r, w, w2, h).

// The rival's interleaving causes harm that neither serial ordering produces.
// ets_harm_by supplies the witness.
.decl harms(rival: RivalWrite, read: symbol, write: symbol, func: symbol, harm: symbol) inline

harms([w2, h], r, w, f, k) :- ets_harm_by(f, r, w, k, w2, h).

// A read controls or feeds a same-row write on shared writable storage, and an
// intervening rival causes harm. `func` is where read and write meet.
.decl read_then_write_race(func: symbol, read: symbol, write: symbol, row: EtsRow, harm: symbol)

read_then_write_race(func, read, write, row, harm) :-
  decides_write(func, read, write, row),
  on_public_table(row),
  lands_between(rival, read, write, func),
  harms(rival, read, write, func, harm).

// Every race, at the sites it is reported at: the operations, or the
// calls to the accessors holding them.
.decl ets_race(mod: symbol, func: symbol, name: symbol, key: symbol, read: symbol, write: symbol, kind: symbol)

ets_race(mod, func, name, key, read_at, write_at, harm) :-
  read_then_write_race(func, read, write, [table, _, key], harm),
  table_shown_as(func, table, name),
  reported_at(func, read, read_at),
  reported_at(func, write, write_at),
  in_module(func, mod).

// Display tables by registered name, allocation name, field-site names, or the
// receiving zero-based parameter for externally supplied tables.
.decl table_shown_as(func: symbol, table: EtsTable, name: symbol)

table_shown_as(f, ["named", t], t) :- decides_write(f, _, _, [["named", t], _, _]).

table_shown_as(f, [tk, t], name) :-
  decides_write(f, _, _, [[tk, t], _, _]),
  tk != "named",
  tk != "handed_in",
  table_made_at(tk, t, n),
  ets_new(n, _, name).

table_shown_as(f, ["handed_in", t], cat("param ", p)) :-
  decides_write(f, _, _, [["handed_in", t], _, _]),
  param_table(f, p, "handed_in", t).

// How much an interleaving costs, strongest first: the finding is
// reported at its strongest harm.
.decl ets_harm_rank(kind: symbol, rank: number)

ets_harm_rank("lost_update", 0).
ets_harm_rank("claim", 1).
ets_harm_rank("take", 2).
ets_harm_rank("guarded", 3).
ets_harm_rank("clobber", 4).
ets_harm_rank("state_delete", 5).
ets_harm_rank("minted", 6).
ets_harm_rank("decides_more", 7).
ets_harm_rank("stale_fill", 8).

// Report one finding per write, choosing strongest harm, then least read and meeting
// function (`OnePerWrite`). Group writes decided by the same read in one function as
// branches of one race; keep the strongest finding and attach other sites as evidence.
.decl ets_best_rank(func: symbol, read: symbol, write: symbol, rank: number)

ets_best_rank(f, r, w, n) :-
  ets_race(_, f, _, _, r, w, _),
  n = min m : { ets_race(_, f, _, _, r, w, k), ets_harm_rank(k, m) }.

.init ets_writes = OnePerWrite

ets_writes.race(f, r, w, "", n) :- ets_best_rank(f, r, w, n).
ets_writes.write_in(s, f) :- ets_race(_, _, _, _, _, s, _), ets_op(s, f, _, _, _).
ets_writes.write_in(s, f) :- ets_race(_, _, _, _, _, s, _), call_site(s, f, _, _, _).

.decl ets_check_act(mod: symbol, func: symbol, name: symbol, key: symbol, read: symbol, write: symbol, kind: symbol)
.output ets_check_act

ets_check_act(mod, f, t, key, r, w, k) :-
  ets_writes.reported(f, r, w, _),
  race_rank(f, r, w, n),
  ets_harm_rank(k, n),
  ets_race(mod, f, t, key, r, w2, k),
  same_race(f, w, w2).

// Group later writes with the reported write. Anchor at the first write and report the
// strongest harm across the group.
.decl same_race(func: symbol, write: symbol, other: symbol)

same_race(f, w, w) :- ets_writes.reported(f, _, w, _).
same_race(f, w, w2) :- ets_writes.also_writes(w, w2, f).

.decl race_rank(func: symbol, read: symbol, write: symbol, rank: number)

race_rank(f, r, w, n) :-
  ets_writes.reported(f, r, w, _),
  n = min m : { same_race(f, w, w2), ets_best_rank(f, r, w2, m) }.

// Related race sites: additional writes, other deciding/feeding reads, and conflicting
// rival writes, each with its reporting function.
.decl ets_race_frame(write: symbol, role: symbol, site: symbol, func: symbol)
.output ets_race_frame

ets_race_frame(w1, "also_writes", w2, f) :- ets_writes.also_writes(w1, w2, f).

ets_race_frame(w, "read", r2, f2) :-
  ets_check_act(_, _, _, _, r, w, _),
  ets_race(_, f2, _, _, r2, w, _),
  r2 != r.

ets_race_frame(w_at, "rival", w2, h) :-
  ets_check_act(_, f, _, _, r_at, w_at, k),
  reported_at(f, r, r_at),
  reported_at(f, w, w_at),
  ets_harm_by(f, r, w, k, w2, h),
  other_site(f, w, w2, h).

// Premature publication
//
// A writer publishes value V in table A before creating the row keyed by V in B. A
// concurrent reader can obtain V from A and fail on B's missing row. Write B before
// publishing V; a losing insert_new publication may require cleanup.
// Resolve writes through same-process helpers and translate parameter keys into caller
// terms. `ets_effect_order` orders them within one iteration. Join value/key identities
// and `EtsTable` identities without requiring a literal V.

// A writer publishes a value before its keyed row exists, and a concurrent reader can
// fail in that gap. reader_func supplies the reader's process context.
.decl publish_order_race(writer: symbol, publish: symbol, complete: symbol, reader: symbol, reader_func: symbol)

publish_order_race(writer, publish, complete, reader, reader_func) :-
  publishes_early(writer, publish, complete),
  fails_if_row_missing(reader, reader_func),
  looks_up_row_of(reader, complete),
  finds_published_value(reader, publish),
  can_read_in_the_gap(writer, reader_func).

// The reader targets the completing write's shared table and can leak a missing-row
// exception. A matching local or all-caller rescue suppresses the crash.
.decl looks_up_row_of(reader: symbol, complete: symbol) inline

looks_up_row_of(r, w2) :- readable_elsewhere(w2, bk, b), ets_table(r, bk, b).

// A read of the published table hands its values out, and the reader's
// key may be one of them (key_may_come_from, below).
.decl finds_published_value(reader: symbol, publish: symbol) inline

finds_published_value(r, w1) :-
  ets_table(w1, ak, a),
  handed_out_from(ak, a),
  key_may_come_from(r, ak, a).

// A table some read hands a value out of (hands_out, below).
.decl handed_out_from(kind: symbol, table: symbol)

handed_out_from(ak, a) :- ets_op(ra, _, _, _, "read"), ets_table(ra, ak, a), hands_out(ra).

// An explicit call instruction runs the callee on its caller's stack. runs_elsewhere
// applies only to execution edges lacking that direct call.
.decl same_stack_site(site: symbol, caller: symbol, callee: symbol)

same_stack_site(c, f, g) :- local_call(c, f, g, _).

same_stack_site(c, f, g) :-
  remote_call(c, f, m, n, a),
  g = cat(m, ":", n, "/", to_string(a)),
  function_def(g, _, _, _, _).

.decl object_insert(w: symbol, func: symbol)

object_insert(w, f) :- ets_op(w, f, _, "insert", "write").
object_insert(w, f) :- ets_op(w, f, _, "insert_new", "write").

.decl reaches_insert(func: symbol)

reaches_insert(f) :- object_insert(_, f).
reaches_insert(f) :- same_stack_site(_, f, g), reaches_insert(g).

.decl lift_needed(func: symbol)

lift_needed(f) :- ets_effect_order(f, _, _).
lift_needed(g) :- lift_needed(f), same_stack_site(_, f, g), reaches_insert(g).

// `func` runs the insert `w` at `at`: w itself, or a call leading to it.
.decl insert_at(func: symbol, at: symbol, w: symbol)

insert_at(f, w, w) :- lift_needed(f), object_insert(w, f).

insert_at(f, c, w) :-
  lift_needed(f),
  same_stack_site(c, f, g),
  reaches_insert(g),
  insert_at(g, _, w).

// The insert's key and the values past it, in `func`'s terms. A literal
// means the same everywhere; a parameter is what the call passes.
.decl key_in(func: symbol, at: symbol, w: symbol, source: symbol, key: symbol)

key_in(f, w, w, s, k) :- insert_at(f, w, w), ets_key(w, s, k).

key_in(f, c, w, "literal", k) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  key_in(g, _, w, "literal", k).

key_in(f, c, w, s, k) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  key_in(g, _, w, "param", p),
  ets_call_arg(c, g, p, s, k).

.decl value_in(func: symbol, at: symbol, w: symbol, pos: number, source: symbol, value: symbol)

value_in(f, w, w, pos, s, v) :- insert_at(f, w, w), ets_value(w, pos, s, v).

value_in(f, c, w, pos, "literal", v) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  value_in(g, _, w, pos, "literal", v).

value_in(f, c, w, pos, s, v) :-
  insert_at(f, c, w),
  c != w,
  same_stack_site(c, f, g),
  value_in(g, _, w, pos, "param", p),
  ets_call_arg(c, g, p, s, v).

// W1 stores V in table A; W2 stores a row keyed by V in table B. Literal V needs no
// read from A.
.decl publish_candidate(func: symbol, publish: symbol, complete: symbol)

publish_candidate(f, w1, w2) :-
  ets_effect_order(f, a1, a2),
  insert_at(f, a1, w1),
  insert_at(f, a2, w2),
  w1 != w2,
  value_in(f, a1, w1, _, vs, v),
  vs != "literal",
  key_in(f, a2, w2, vs, v).

// Require two distinct rows: V is a non-key value in the published row and the
// completing row's key. The tables may be the same. Rewriting one key twice is not
// publication.
.decl publishes_early(func: symbol, publish: symbol, complete: symbol)

publishes_early(f, w1, w2) :-
  publish_candidate(f, w1, w2),
  ets_table(w1, _, _),
  ets_table(w2, _, _),
  insert_at(f, a1, w1),
  value_in(f, a1, w1, _, vs, v),
  key_in(f, a1, w1, ks, _),
  key_in(f, _, w2, vs, v),
  vs != ks.

publishes_early(f, w1, w2) :-
  publish_candidate(f, w1, w2),
  ets_table(w1, _, _),
  ets_table(w2, _, _),
  insert_at(f, a1, w1),
  value_in(f, a1, w1, _, vs, v),
  key_in(f, a1, w1, _, k),
  key_in(f, _, w2, vs, v),
  v != k.

// Reads that raise on a missing row. Exclude default-taking lookup_element/4 and
// update_counter/4, and update_element, which returns false.
.decl raises_if_row_missing(r: symbol, func: symbol)

raises_if_row_missing(r, g) :-
  ets_op(r, g, _, op, _),
  remote_call(r, _, m, op, a),
  ets_raises_without_row(m, op, a).

// A read of A that hands out what it found: the way V reaches a reader.
.decl hands_out(r: symbol)

hands_out(r) :- ets_op(r, _, _, "lookup", _), returns_depends(_, "site", r).
hands_out(r) :- ets_op(r, _, _, "lookup", _), site_reads(_, _, "site", r).
hands_out(r) :- ets_op(r, _, _, "lookup", _), call_arg_reads(_, _, _, "site", r).
hands_out(r) :- ets_op(r, _, _, op, "read"), op != "lookup", op != "member", op != "info".

// The operation may access a table readable by another process.
// table_readable_elsewhere resolves field tables through their extracted names.
.decl readable_elsewhere(id: symbol, kind: symbol, ident: symbol) inline

readable_elsewhere(id, k, t) :- ets_table(id, k, t), table_readable_elsewhere(k, t).

// Candidate readers raise on missing rows in a completing table. Exclude literal keys,
// which cannot have been obtained from the published value.
.decl gap_reader(reader: symbol, reader_func: symbol, published_kind: symbol, published: symbol)

gap_reader(r, g, ak, a) :-
  publishes_early(_, w1, w2),
  ets_table(w1, ak, a),
  handed_out_from(ak, a),
  fails_if_row_missing(r, g),
  looks_up_row_of(r, w2),
  ets_key(r, ks, _),
  ks != "literal".

// Reader key provenance
//
// The key must derive from the published table or an unknown external parameter/call
// result. Keys known to come from unrelated sources cannot hold its published values.
.decl key_needed(func: symbol, kind: symbol, src: symbol)

key_needed(g, "param", p) :- gap_reader(r, g, _, _), ets_key(r, "param", p).

key_needed(g, k, s) :-
  gap_reader(r, g, _, _),
  ets_key(r, ks, _),
  ks != "param",
  site_reads(r, g, k, s).

key_needed(c, k, s) :-
  key_needed(g, "param", p),
  call_arg_reads(c, g, n, k, s),
  p = to_string(n).

key_needed(h, k, s) :- key_needed(_, "call", h), returns_depends(h, k, s).

.decl from_table(func: symbol, kind: symbol, src: symbol, tk: symbol, t: symbol)

from_table(g, "site", ra, tk, t) :-
  key_needed(g, "site", ra),
  ets_op(ra, g, _, _, "read"),
  ets_table(ra, tk, t).

from_table(g, "call", h, tk, t) :-
  key_needed(g, "call", h),
  returns_depends(h, k, s),
  from_table(h, k, s, tk, t).

from_table(g, "param", p, tk, t) :-
  key_needed(g, "param", p),
  call_arg_reads(c, g, n, k, s),
  p = to_string(n),
  from_table(c, k, s, tk, t).

// Sources whose origin the program does not show.
.decl open_source(func: symbol, kind: symbol, src: symbol)

open_source(g, "param", p) :- key_needed(g, "param", p), api_export(g).
open_source(g, "param", p) :- key_needed(g, "param", p), fun_ref(_, g).
open_source(g, "call", h) :- key_needed(g, "call", h), !returns_depends(h, _, _).
open_source(g, k, s) :- key_needed(g, "param", p), call_arg_reads(c, g, n, k, s), p = to_string(n), open_source(c, k, s).
open_source(g, "call", h) :- key_needed(g, "call", h), returns_depends(h, k, s), open_source(h, k, s).

// An unknown-origin key may be the published value when it reads a different table. If
// both mappings share one table, require evidence that the reader extracted V there;
// otherwise it might be reading the already-published row itself.
.decl key_may_come_from(r: symbol, tk: symbol, t: symbol)

key_may_come_from(r, tk, t) :-
  gap_reader(r, g, tk, t),
  ets_key(r, "param", p),
  from_table(g, "param", p, tk, t).

key_may_come_from(r, tk, t) :-
  gap_reader(r, g, tk, t),
  ets_key(r, "param", p),
  open_source(g, "param", p),
  !ets_table(r, tk, t).

key_may_come_from(r, tk, t) :-
  gap_reader(r, g, tk, t),
  ets_key(r, ks, _),
  ks != "param",
  site_reads(r, g, k, s),
  from_table(g, k, s, tk, t).

key_may_come_from(r, tk, t) :-
  gap_reader(r, g, tk, t),
  ets_key(r, ks, _),
  ks != "param",
  site_reads(r, g, k, s),
  open_source(g, k, s),
  !ets_table(r, tk, t).

// The writers and readers whose processes are asked about: the race
// but for the processes.
.decl gap_read(writer: symbol, reader_func: symbol)

gap_read(writer, reader_func) :-
  publishes_early(writer, publish, complete),
  fails_if_row_missing(reader, reader_func),
  looks_up_row_of(reader, complete),
  finds_published_value(reader, publish).

runs.seed(f) :- gap_read(f, _).
runs.seed(g) :- gap_read(_, g).

// The reader can run between the writes, either through concurrent instances or in a
// process distinct from the writer.
.decl can_read_in_the_gap(writer: symbol, reader_func: symbol)

can_read_in_the_gap(f, g) :- gap_read(f, g), !runs.single_process(f).
can_read_in_the_gap(f, g) :- gap_read(f, g), !runs.single_process(g).

can_read_in_the_gap(f, g) :-
  gap_read(f, g),
  runs.beside_single_process(f, g).

// Table identity is its kind plus name, allocation site, or module and field path for
// "named", "new", or "field", respectively.
.decl ets_publish_order(mod: symbol, func: symbol, published_kind: symbol, published_in: symbol, completed_kind: symbol, completed_in: symbol, publish: symbol, complete: symbol, reader: symbol)
.output ets_publish_order

ets_publish_order(mod, writer, pub_kind, pub_table, row_kind, row_table, publish, complete, reader) :-
  publish_order_race(writer, publish, complete, reader, _),
  in_module(writer, mod),
  table_of(publish, pub_kind, pub_table),
  table_of(complete, row_kind, row_table),
  table_of(reader, row_kind, row_table).

.decl table_of(op: symbol, table_kind: symbol, table: symbol) inline

table_of(op, tk, t) :- ets_table(op, tk, t).

// Rows removed between check and use
//
// A read establishes row presence, then an operation such as update_counter/3 or
// lookup_element/3 raises if the row disappears. Follow the pair across functions with
// `CheckThenAct`. A concurrent take, row deletion, bulk deletion, or table deletion can
// be the remover.
// Unknown remover keys may match; exclude only keys considered disjoint, including
// another process's self() row and distinct literal/computed-key classes.

.init missing = CheckThenAct

// Use table_source identities on both sides. Names, allocation sites and handed-in
// tables retain identity across functions; fields retain it within their module.
missing.check(read, func, source, table, key_kind, key) :-
  deciding_read(read, func),
  table_and_key(read, table_kind, table, key_kind, key),
  table_source(table_kind, source).

missing.act(act, func, source, table, key_kind, key) :-
  raises_if_row_missing(act, func),
  table_and_key(act, table_kind, table, key_kind, key),
  table_source(table_kind, source).

// Express the rule through whole-table helper relations. Each table carries both
// EtsTable identity columns, keeping kind handling inside the helpers.

// A read that decides whether a row is there.
.decl checks_row_exists(check: symbol) inline

checks_row_exists(check) :- deciding_read(check, _).

// A missing-row exception can escape through the act and its call path (`Escape`).
// Check from the pair's meeting function, or the publication reader itself.
.decl fails_if_row_missing(act: symbol, func: symbol)

fails_if_row_missing(act, func) :-
  missing.meets(func, _, act, _, _, _, _),
  row_miss.escapes(act, func, "badarg").

fails_if_row_missing(reader, reader_func) :-
  reads_completed_row(reader, reader_func),
  row_miss.escapes(reader, reader_func, "badarg").

// Check handlers at the act and intervening call sites. An unrelated rescue elsewhere
// in a function does not cover the act.
.init row_miss = Escape

row_miss.asked(act, g, f, "badarg") :-
  missing.meets(f, _, act, _, _, _, _),
  raises_if_row_missing(act, g).

row_miss.asked(reader, g, g, "badarg") :- reads_completed_row(reader, g).

// A publication-order race reader: a read that raises on a missing row in a table
// completed after early publication.
.decl reads_completed_row(reader: symbol, reader_func: symbol)

reads_completed_row(r, g) :-
  publishes_early(_, _, complete),
  raises_if_row_missing(r, g),
  looks_up_row_of(r, complete).

// A table accessible from another process. Tables created outside the facts, under
// unresolved names, or supplied externally are assumed shared; no visible allocation
// proves them private.
.decl shared_table(act: symbol, table: EtsTable) inline

shared_table(act, [tk, t]) :- readable_elsewhere(act, tk, t).
shared_table(act, [tk, t]) :- ets_table(act, tk, t), table_made_out_of_view(tk, t).

// An operation that deletes rows of the table: take, delete,
// delete_object, select_delete, match_delete, or deleting them all.
.decl removes_rows(remover: symbol, table: EtsTable)

removes_rows(d, [tk, t]) :-
  ets_op(d, _, _, op, _),
  ets_removal_op(op),
  ets_table(d, tk, t).

// The pairs the rule asks about, for the questions it asks of processes.
.decl found_row_act(func: symbol, table: EtsTable)

found_row_act(func, table) :-
  decides(func, _, act, [table, _, _]),
  fails_if_row_missing(act, func),
  shared_table(act, table).

// The keys of those pairs, the only keys a removal's key is compared with.
.decl found_key(key_kind: symbol, key: symbol)

found_key(ks, k) :-
  decides(func, _, act, [table, ks, k]),
  fails_if_row_missing(act, func),
  shared_table(act, table).

.decl remover_in(remover: symbol, func: symbol)

remover_in(d, h) :- found_row_act(_, table), removes_rows(d, table), ets_op(d, h, _, _, _).

runs.seed(f) :- found_row_act(f, _).
runs.seed(h) :- remover_in(_, h).

// The remover's key can never be the pair's key (ks, k).
.decl keyed_apart(remover: symbol, key_kind: symbol, key: symbol)

keyed_apart(d, "self", "") :- remover_in(d, _), ets_key(d, "self", "").
keyed_apart(d, "self", "") :- remover_in(d, _), ets_key(d, "literal", _).
keyed_apart(d, "literal", k) :- remover_in(d, _), ets_key(d, "self", ""), found_key("literal", k).

keyed_apart(d, "literal", k) :-
  remover_in(d, _),
  ets_key(d, "literal", k2),
  found_key("literal", k),
  k != k2.

keyed_apart(d, ks, k) :-
  remover_in(d, _),
  ets_key(d, "literal", _),
  found_key(ks, k),
  ks != "literal",
  ks != "self",
  ks != "any".

// A row is a table plus a key, represented using CheckThenAct's key kind and value.
.type EtsRow = [table: EtsTable, key_kind: symbol, key: symbol]

// In `func`, the check's result decides whether the use runs, on one row
// (CheckThenAct's meets, followed across calls).
.decl decides(func: symbol, check: symbol, use: symbol, row: EtsRow)

decides(func, check, use, [[tk, t], ks, k]) :-
  missing.meets(func, check, use, source, t, ks, k),
  table_source(tk, source).

// The use's table is one other processes can reach.
.decl on_shared_table(use: symbol) inline

on_shared_table(use) :- ets_table(use, tk, t), shared_table(use, [tk, t]).

// A removal on the row's table whose key can be the row's key.
.decl removes_row(remove: symbol, row: EtsRow) inline

removes_row(remove, [table, ks, k]) :-
  removes_rows(remove, table),
  !keyed_apart(remove, ks, k).

// The removal may run in another process: the pair is multi-process, or a separate
// process reaches the remover. Without ordering, it can occur between check and use.
.decl runs_in_another_process(remove: symbol, func: symbol)

runs_in_another_process(d, f) :-
  found_row_act(f, table),
  removes_rows(d, table),
  !runs.single_process(f).

runs_in_another_process(d, f) :-
  found_row_act(f, table),
  removes_rows(d, table),
  remover_in(d, h),
  runs.beside_single_process(f, h).

// A presence check guards an operation requiring the row, but another process can
// remove it between check and use.
.decl missing_row_race(func: symbol, check: symbol, use: symbol, remove: symbol, row: EtsRow)

missing_row_race(func, check, use, remove, row) :-
  checks_row_exists(check),
  decides(func, check, use, row),
  fails_if_row_missing(use, func),
  on_shared_table(use),
  removes_row(remove, row),
  runs_in_another_process(remove, func).

.decl ets_missing_row(mod: symbol, func: symbol, table_kind: symbol, table: symbol, check: symbol, act: symbol, remover: symbol)
.output ets_missing_row

ets_missing_row(mod, func, table_kind, table, check, use, remove) :-
  missing_row_race(func, check, use, remove, [[table_kind, table], _, _]),
  in_module(func, mod).

// Mnesia dirty check-then-act
//
// Dirty operations bypass transaction serialization. Require a dependent read/write
// pair and a competing writer; transactions or dirty_update_counter can provide
// atomicity. A sole writer is exempt.
// Known limit: sole-process classification is per node. Replicated tables may have one
// such writer on each node, but runtime replica lists are unavailable, so this
// exemption can miss distributed races.

// A dirty same-record pair with a concurrent writer, no shared cluster-lock proof, and
// a harm witness. func is the pair's meeting function.
.decl dirty_read_then_write_race(func: symbol, read: symbol, write: symbol, record: MnesiaRecord, harm: symbol)

dirty_read_then_write_race(func, read, write, [table, key], harm) :-
  decides_dirty_write(func, read, write, [table, key]),
  written_by_another_process(table, func),
  !serialized_by_lock(func, table),
  harms_record(func, read, write, harm).

// A Mnesia record uses a cluster-wide table name and key. Mnesia and ETS identities
// remain separate even when their table names match.
.type MnesiaRecord = [table: symbol, key: symbol]

// In `func`, the dirty read's result decides whether the dirty write
// runs, or feeds what it stores, on one record (reads_then_writes_record,
// below).
.decl decides_dirty_write(func: symbol, read: symbol, write: symbol, record: MnesiaRecord) inline

decides_dirty_write(f, r, w, [t, k]) :- reads_then_writes_record(f, r, w, t, k).

// What the interleaving costs, by a witness (record_race_kind, below):
// asked only of the pairs another process can interleave.
.decl harms_record(func: symbol, read: symbol, write: symbol, harm: symbol) inline

harms_record(f, r, w, k) :- record_race_kind(f, r, w, k).

.init records = CheckThenAct

records.check(read, func, table_kind, table, key_kind, key) :-
  mnesia_op(read, func, _, "read", table_kind, table, key_kind, key).

records.act(write, func, table_kind, table, key_kind, key) :-
  mnesia_op(write, func, op, "write", table_kind, table, key_kind, key),
  dirty_write_op(op).

// Dirty writes are candidate acts. Transactional writes and dirty_update_counter may
// compete or restore table contents, but are not candidate acts.
.decl dirty_write_op(op: symbol)

dirty_write_op("dirty_write").
dirty_write_op("dirty_delete").
dirty_write_op("dirty_delete_object").

.decl reads_then_writes_record(func: symbol, read: symbol, write: symbol, table: symbol, key: symbol)

reads_then_writes_record(f, r, w, t, k) :- records.meets(f, r, w, "literal", t, _, k).
reads_then_writes_record(f, r, w, t, k) :- records.meets(f, r, w, "param", p, _, k), record_table_at_param(f, p, t).
reads_then_writes_record(f, r, w, t, k) :- records.meets(f, r, w, "element 0", p, _, k), table_at_record(f, p, t).

// Resolve a table parameter at a check/act meeting point or write, following names
// through forwarding callers.
.decl record_table_needed(func: symbol, pos: symbol)

record_table_needed(f, p) :- records.meets(f, _, _, "param", p, _, _).

record_table_needed(c, to_string(m)) :-
  record_table_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n).

.decl record_table_at_param(func: symbol, pos: symbol, name: symbol)

record_table_at_param(f, p, name) :-
  record_table_needed(f, p),
  call_arg(_, f, n, name),
  name != "dynamic",
  p = to_string(n).

record_table_at_param(f, p, name) :-
  record_table_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n),
  record_table_at_param(c, to_string(m), name).

// A whole record's first tuple element names its Mnesia table. Resolve that element
// through forwarding callers.
.decl record_param_needed(func: symbol, pos: symbol)

record_param_needed(f, p) :- records.meets(f, _, _, "element 0", p, _, _).
record_param_needed(c, to_string(m)) :-
  record_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n).

.decl table_at_record(func: symbol, pos: symbol, name: symbol)

table_at_record(f, p, t) :-
  record_param_needed(f, p),
  call_arg_tuple(_, f, n, 0, "literal", t),
  p = to_string(n).

table_at_record(f, p, t) :-
  record_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n),
  table_at_record(c, to_string(m), t).

runs.seed(f) :- reads_then_writes_record(f, _, _, _, _).
runs.seed(f) :- mnesia_op(_, f, _, "write", _, _, _, _).

// Another process can write between the pair's read and write, either by running func
// concurrently or through a separate table writer.
.decl written_by_another_process(table: symbol, func: symbol)

written_by_another_process(t, f) :-
  reads_then_writes_record(f, _, _, t, _),
  !runs.single_process(f).

written_by_another_process(t, f) :-
  reads_then_writes_record(f, _, _, t, _),
  mnesia_write_table(_, g, t),
  runs.beside_single_process(f, g).

// External cluster locks
//
// Treat dirty writes as serialized when every writer runs under a global.trans closure
// or an exclusively called private helper. Assumptions: any closure built by a function
// calling global.trans may be its body, and different lock identities are not
// distinguished. Both can suppress real races.
.decl locked_closure(func: symbol)

locked_closure(c) :- global_op(_, f, "trans", _, _), closure_def(f, c).

.decl called_unlocked(func: symbol)

called_unlocked(g) :- mnesia_write_table(_, g, _), call_edge(h, g), !locked_closure(h).

.decl under_lock(func: symbol)

under_lock(g) :- locked_closure(g).

under_lock(g) :-
  mnesia_write_table(_, g, _),
  function_def(g, _, _, _, 0),
  call_edge(_, g),
  !called_unlocked(g).

.decl unlocked_writer(table: symbol)

unlocked_writer(t) :- mnesia_write_table(_, g, t), !under_lock(g).

.decl serialized_by_lock(func: symbol, table: symbol)

serialized_by_lock(f, t) :-
  reads_then_writes_record(f, _, _, t, _),
  under_lock(f),
  !unlocked_writer(t).

// Resolve Mnesia write tables from literals, caller parameters, or record element 0.
// Transactional writes and atomic counters are also rivals to unlocked dirty pairs.
.decl mnesia_write_table(write: symbol, func: symbol, table: symbol)

mnesia_write_table(w, f, t) :- mnesia_op(w, f, _, "write", "literal", t, _, _).

mnesia_write_table(w, f, t) :-
  mnesia_op(w, f, _, "write", "param", p, _, _),
  record_table_at_param(f, p, t).

mnesia_write_table(w, f, t) :-
  mnesia_op(w, f, _, "write", "element 0", p, _, _),
  table_at_record(f, p, t).

record_param_needed(f, p) :- mnesia_op(_, f, _, "write", "element 0", p, _, _).

// A dirty write stores a value derived from a Mnesia read along some caller path. See
// MadeOfRead.
.init record_made = MadeOfRead

record_made.read(r) :- mnesia_op(r, _, _, "read", _, _, _, _).
record_made.write(w, h) :- mnesia_write_table(w, h, _), mnesia_op(w, _, op, _, _, _, _, _), (op = "dirty_write" ; op = "write").

record_table_needed(f, p) :- mnesia_op(_, f, _, "write", "param", p, _, _).

// A pair another process can interleave: the race but for its harm,
// what the harms below are asked of.
.decl racing_record_pair(func: symbol, read: symbol, write: symbol)

racing_record_pair(f, r, w) :-
  reads_then_writes_record(f, r, w, t, _),
  written_by_another_process(t, f),
  !serialized_by_lock(f, t).

// Which dirty operation a Mnesia call is.
.decl dirty_op(site: symbol, op: symbol) inline

dirty_op(site, op) :- mnesia_op(site, _, op, _, _, _, _, _).

// Mnesia rivals
//
// A dirty or transactional write can rival the pair after its process starts, if it
// runs in another process or the pair itself runs concurrently. Distinct literal keys
// and newly minted keys are disjoint; parameter keys may identify any record.
.decl record_rival(func: symbol, read: symbol, write: symbol, rival_write: symbol, rival_func: symbol)

record_rival(f, r, w, w2, g) :-
  racing_record_pair(f, r, w),
  reads_then_writes_record(f, r, w, t, _),
  !runs.single_process(f),
  mnesia_write_table(w2, g, t),
  w2 != w,
  writes_after_start(g),
  !records_apart(w, w2).

record_rival(f, r, w, w2, g) :-
  racing_record_pair(f, r, w),
  reads_then_writes_record(f, r, w, t, _),
  runs.single_process(f),
  runs.entry_reaches(m, f),
  mnesia_write_table(w2, g, t),
  runs.runs_beside_up(m, f, g, g),
  !records_apart(w, w2).

writer_walk.seed(g, g) :- mnesia_write_table(_, g, _).

.decl records_apart(write: symbol, rival_write: symbol)

records_apart(w, w2) :-
  racing_record_pair(_, _, w),
  mnesia_op(w, _, _, _, _, _, "literal", k),
  mnesia_write_table(w2, _, _),
  mnesia_op(w2, _, _, _, _, _, "literal", k2),
  k != k2.

records_apart(w, w2) :-
  racing_record_pair(_, _, w),
  mnesia_write_table(w2, _, _),
  mnesia_op(w2, _, _, _, _, _, "local", made),
  minted_value(made).

// A freshly generated reference, monitor, unique integer or random value, including one
// returned through a project wrapper.
.decl minted_value(site: symbol)

minted_value(made) :- remote_call(made, _, m, n, a), minting_call(m, n, a).
minted_value(made) :- remote_call(made, _, m, n, a), mints(cat(m, ":", n, "/", to_string(a))).
minted_value(made) :- local_call(made, _, g, _), mints(g).

// A writer that writes the record back from a read, or counts in it.
.decl record_counts_in(write: symbol)

record_counts_in(w) :- record_made.stores(w).
record_counts_in(w) :- mnesia_op(w, _, "dirty_update_counter", _, _, _, _, _).

// A writer that removes the record.
.decl record_removes(write: symbol)

record_removes(w) :-
  mnesia_op(w, _, op, "write", _, _, _, _),
  (op = "dirty_delete" ; op = "delete" ; op = "dirty_delete_object" ; op = "delete_object").

// A writer creates independent record state rather than a cached refill computed from a
// call or another store after a miss.
.decl record_makes_own(write: symbol)

record_makes_own(w) :-
  mnesia_op(w, _, op, "write", _, _, _, _),
  (op = "dirty_write" ; op = "write"),
  !record_carried.fills(_, _, w).

// Mnesia harm and finding selection
// - unique: concurrent non-key searches find nothing and insert duplicate logical
// records under separate keys.
// - lost_update: read-derived writes overwrite a rival's change.
// - guarded: a value comparison permits writes that can land out of order.
// - claim: both callers receive a success verdict; returning record data alone is not a
// claim.
// - delete: deletion removes a rival's replacement, returns the same removed value
// twice, or repeats an external effect. delete_object only has the latter two hazards.
// - decides_more: the read also controls another write, send, or external effect.
// - fill: a fresh refill overwrites an intervening removal or change.
// Require a harm witness. Choose one finding per write by strongest kind, then prefer a
// read local to the write, then the least read. Combine branches decided by the same
// read and attach other reads, writes, and external rivals as `mnesia_race_frame`
// evidence.

// A read that finds records by something other than their key.
.decl searches(read: symbol)

searches(r) :- mnesia_op(r, _, _, "read", _, _, "any", _).

// Made of this pair's read (PairCarries, clientlib/check_then_act.dl).
.init record_carried = PairCarries

record_carried.pair(f, r, w) :- racing_record_pair(f, r, w).
record_carried.read_in(r, g) :- mnesia_op(r, g, _, "read", _, _, _, _).
record_carried.write_in(w, h) :- records.act(w, h, _, _, _, _).
record_carried.fresh(kind, src) :- fill_source(kind, src).

// The decision a pair makes leaves the function, as decision_escapes
// asks of ETS.
.decl record_decision_returned(meet: symbol, func: symbol, check: symbol)

record_decision_returned(f, f, c) :-
  reads_then_writes_record(f, c, _, _, _),
  records.carries(f, kind, src, c, _, _, _, _),
  returns_depends(f, kind, src).

record_decision_returned(f, g, c) :-
  record_decision_returned(f, h, c),
  records.carries(g, "call", h, c, _, _, _, _),
  returns_depends(g, "call", h).

.decl record_decision_escapes(meet: symbol, check: symbol)

record_decision_escapes(f, c) :-
  record_decision_returned(f, g, c),
  call_decided(_, _, "call", g).

record_decision_escapes(f, c) :-
  record_decision_returned(f, g, c),
  api_export(g),
  !callee_returns(g, "constant").

// The pair's own path, as pair_path is for ETS.
.decl record_path(meet: symbol, check: symbol, func: symbol)

record_path(f, c, f) :- reads_then_writes_record(f, c, _, _, _).
record_path(f, c, g) :- reads_then_writes_record(f, c, _, _, _), records.carried_through(f, c, g).

// The ETS rule's decision_sends, for records (DecisionSends).
.init record_sends = DecisionSends

record_sends.carried(f, g, kind, src, r) :-
  record_path(f, r, g),
  records.carries(g, kind, src, r, _, _, _, _).

.decl record_decision_sends(meet: symbol, read: symbol)

record_decision_sends(f, r) :- record_sends.sends(f, r).

// A guard compares record data, starting at element 2 after the table and key, against
// a value stored by the write.
.decl guards_record(meet: symbol, read: symbol, write: symbol)

guards_record(f, r, w) :-
  reads_then_writes_record(f, r, w, _, _),
  record_path(f, r, g),
  records.carries(g, kind, src, r, _, _, _, _),
  field_compared(g, kind, src, pos, ok, os),
  pos >= 2,
  records.act(w, g, _, _, _, _),
  site_reads(w, g, ok, os).

guards_record(f, r, w) :-
  reads_then_writes_record(f, r, w, _, _),
  record_path(f, r, g),
  records.carries(g, kind, src, r, _, _, _, _),
  field_compared(g, kind, src, pos, ok, os),
  pos >= 2,
  records.act(w, h, _, _, _, _),
  site_reads(w, h, "param", q),
  call_arg_reads(g, h, n, ok, os),
  q = to_string(n).

// Mutually exclusive dirty writes are alternative branches, not additional effects.
// Another write on the same path, such as a charge after a marker, does count.
.decl other_branch(site: symbol, write: symbol)

other_branch(s, w) :-
  reads_then_writes_record(_, _, w, _, _),
  exclusive_writes(s, w).

// Two dirty writes of one function that no trip through the function
// makes both of (mnesia_write_order orders neither).
.decl exclusive_writes(first: symbol, second: symbol)

exclusive_writes(w1, w2) :-
  mnesia_op(w1, h, "dirty_write", _, _, _, _, _),
  mnesia_op(w2, h, "dirty_write", _, _, _, _, _),
  w1 != w2,
  !mnesia_write_order(h, w1, w2),
  !mnesia_write_order(h, w2, w1).

// The pair's decision also sends, performs an external effect, or makes another
// same-path write. Evaluate at the meeting function to identify duplicated work.
.decl decides_more_here(func: symbol, read: symbol, write: symbol)

decides_more_here(f, r, w) :-
  racing_record_pair(f, r, w),
  records.carries(f, kind, src, r, _, _, _, _),
  effect_decided(f, kind, src).

decides_more_here(f, r, w) :-
  racing_record_pair(f, r, w),
  records.carries(f, kind, src, r, _, _, _, _),
  site_depends(s, f, kind, src),
  s != w,
  shared_write(s),
  !other_branch(s, w).

.decl record_race_kind(func: symbol, read: symbol, write: symbol, kind: symbol)

// A search whose write carries what it read is a lost update, not a
// unique claim.
record_race_kind(f, r, w, "unique") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  searches(r),
  !record_carried.carries(f, r, w).

record_race_kind(f, r, w, "lost_update") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  record_carried.carries(f, r, w).

record_race_kind(f, r, w, "guarded") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  guards_record(f, r, w).

record_race_kind(f, r, w, "claim") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  record_decision_escapes(f, r),
  !record_carried.answers(f, r).

record_race_kind(f, r, w, "decides_more") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  decides_more_here(f, r, w).

record_race_kind(f, r, w, "fill") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_write", _, _, _, _, _),
  record_rival(f, r, w, w2, _),
  (record_counts_in(w2) ; record_removes(w2) ; record_makes_own(w2)).

// A content-dependent keyed delete can remove a rival's replacement or updated record.
// A presence-only delete has the same result as a serial write followed by deletion.
record_race_kind(f, r, w, "delete") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, "dirty_delete", _, _, _, _, _),
  tests_record_fields(f, r),
  record_rival(f, r, w, w2, _),
  (record_counts_in(w2) ; record_makes_own(w2)).

// Any delete whose decision also sends, or that hands out the record it
// removes: both racers send, or both take the record.
record_race_kind(f, r, w, "delete") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, op, _, _, _, _, _),
  (op = "dirty_delete" ; op = "dirty_delete_object"),
  record_decision_sends(f, r).

record_race_kind(f, r, w, "delete") :-
  racing_record_pair(f, r, w),
  mnesia_op(w, _, op, _, _, _, _, _),
  (op = "dirty_delete" ; op = "dirty_delete_object"),
  record_decision_escapes(f, r),
  record_carried.answers(f, r).

// The decision looks at what the record holds, past the table and the
// key (element 2 on).
.decl tests_record_fields(meet: symbol, read: symbol)

tests_record_fields(f, r) :-
  racing_record_pair(f, r, _),
  record_path(f, r, g),
  records.carries(g, kind, src, r, _, _, _, _),
  field_decides(g, kind, src, pos),
  pos >= 2.

tests_record_fields(f, r) :-
  racing_record_pair(f, r, _),
  record_path(f, r, g),
  records.carries(g, kind, src, r, _, _, _, _),
  call_arg_depends(g, h, n, kind, src),
  field_decides(h, "param", q, pos),
  q = to_string(n),
  pos >= 2.

.decl kind_rank(kind: symbol, rank: number)

kind_rank("unique", 0).
kind_rank("lost_update", 1).
kind_rank("guarded", 2).
kind_rank("claim", 3).
kind_rank("delete", 3).
kind_rank("decides_more", 4).
kind_rank("fill", 5).

// Group weaker branches under the strongest race for each read and meeting function.
// Shared reads used by different meeting functions remain separate races.
.decl read_rank(func: symbol, read: symbol, rank: number)

read_rank(f, r, n) :-
  dirty_read_then_write_race(f, r, _, _, _),
  n = min m : { dirty_read_then_write_race(f, r, _, _, k), kind_rank(k, m) }.

// Prefer the read local to the write over a farther caller's read. Retain the outer
// read as evidence if its data is also written back.
.decl read_in_own_function(write: symbol)

read_in_own_function(w) :- reads_then_writes_record(h, _, w, _, _), records.act(w, h, _, _, _, _).

.decl ranked_race(func: symbol, read: symbol, write: symbol, kind: symbol, rank: number)

ranked_race(f, r, w, k, n) :-
  dirty_read_then_write_race(f, r, w, _, k),
  kind_rank(k, n),
  read_rank(f, r, n),
  records.act(w, f, _, _, _, _).

ranked_race(f, r, w, k, n) :-
  dirty_read_then_write_race(f, r, w, _, k),
  kind_rank(k, n),
  read_rank(f, r, n),
  records.act(w, h, _, _, _, _),
  h != f,
  !read_in_own_function(w).

// One finding per write (OnePerWrite): at its strongest kind, then the
// least read, then the least function.
.init record_writes = OnePerWrite

record_writes.race(f, r, w, k, n) :- ranked_race(f, r, w, k, n).
record_writes.write_in(w, h) :- ranked_race(_, _, w, _, _), records.act(w, h, _, _, _, _).

.decl mnesia_check_act(mod: symbol, func: symbol, table: symbol, key: symbol, read: symbol, write: symbol, op: symbol, kind: symbol)
.output mnesia_check_act

mnesia_check_act(mod, func, table, key, read, write, op, harm) :-
  record_writes.reported(func, read, write, harm),
  dirty_read_then_write_race(func, read, write, [table, key], harm),
  dirty_op(write, op),
  in_module(func, mod).

// Related Mnesia evidence: later writes (`also_writes`), external rivals to
// single-process pairs (`other_writer`), and other deciding or feeding reads (`read`).
.decl mnesia_race_frame(write: symbol, role: symbol, site: symbol, func: symbol)
.output mnesia_race_frame

mnesia_race_frame(w1, "also_writes", w2, f) :- record_writes.also_writes(w1, w2, f).

mnesia_race_frame(w, "other_writer", o, g) :-
  mnesia_check_act(_, f, t, _, _, w, _, _),
  mnesia_write_table(o, g, t),
  runs.beside_single_process(f, g).

mnesia_race_frame(w, "read", r2, f2) :-
  mnesia_check_act(_, _, _, _, r, w, _, _),
  racing_record_pair(f2, r2, w),
  r2 != r.

// One-use verdicts built from shared-cache reads and separate marks.
.include "../clientlib/shared_store_claim.dl"
