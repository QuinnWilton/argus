// One-for-one coupling analysis.
//
// Combines callgraph with supervision structure to find modules under
// one_for_one that are coupled through GenServer message passing across
// different child branches. Uses child_subtree to map every descendant
// to the direct child branch it belongs to, catching coupling that spans
// nested supervisors (not just direct siblings).

.include "../clientlib/imports.dl"

// ── Supervision facts ────────────────────────────────────────────────

.decl supervisor(mod: symbol, strategy: symbol)
.input supervisor

.decl supervisor_child(sup: symbol, position: number, child_mod: symbol, restart: symbol, type: symbol)
.input supervisor_child

.decl dynamic_child(sup: symbol, child_mod: symbol, caller_func: symbol)
.input dynamic_child

.decl implements_behaviour(mod: symbol, behaviour: symbol)
.input implements_behaviour

.decl sync_call(caller_func: symbol, callee_mod: symbol)
.input sync_call

.decl async_cast(caller_func: symbol, callee_mod: symbol)
.input async_cast

// ── OTP helpers ──────────────────────────────────────────────────────

.include "../clientlib/otp.dl"

// ── Supervision helpers ──────────────────────────────────────────────

.include "../clientlib/supervision.dl"

// ── One-for-one coupling ───────────────────────────────────────────

// Two modules under a one_for_one supervisor where one depends on the
// other through GenServer message passing, and they belong to different
// child branches. Under one_for_one, if the callee's branch crashes,
// the caller's branch keeps running in a degraded state.
.decl one_for_one_coupling(sup: symbol, caller_mod: symbol, callee_mod: symbol)
.output one_for_one_coupling

one_for_one_coupling(sup, caller_mod, callee_mod) :-
  supervisor(sup, "one_for_one"),
  child_subtree(sup, caller_branch, caller_mod),
  child_subtree(sup, callee_branch, callee_mod),
  stateful_module_dep(caller_mod, callee_mod),
  caller_branch != callee_branch.

// ── Wrong start order ────────────────────────────────────────────────

// Module in an earlier branch reaches a module in a later branch during
// init. The later branch may not be started yet when the earlier
// branch's init runs, causing init-time failures.
//
// Scoped to init_reaches (not module_reaches) to avoid false positives
// from runtime-only call paths.
.decl wrong_start_order(sup: symbol, early_mod: symbol, late_mod: symbol, early_pos: number, late_pos: number)
.output wrong_start_order

wrong_start_order(sup, early_mod, late_mod, early_pos, late_pos) :-
  supervisor(sup, _),
  child_subtree(sup, early_branch, early_mod),
  child_subtree(sup, late_branch, late_mod),
  supervisor_child(sup, early_pos, early_branch, _, _),
  supervisor_child(sup, late_pos, late_branch, _, _),
  init_reaches(early_mod, late_mod),
  early_pos < late_pos,
  early_branch != late_branch.
