// One-for-one coupling analysis.
//
// Combines callgraph with supervision structure to find modules under
// one_for_one that are coupled through GenServer message passing across
// different child branches. Uses child_subtree to map every descendant
// to the direct child branch it belongs to, catching coupling that spans
// nested supervisors (not just direct siblings).

.include "../clientlib/imports.dl"

// ── Supervision facts ────────────────────────────────────────────────

// ── OTP helpers ──────────────────────────────────────────────────────

.include "../clientlib/otp.dl"

// ── Supervision helpers ──────────────────────────────────────────────

.include "../clientlib/supervision.dl"

// ── One-for-one coupling ───────────────────────────────────────────

// Supervisors are implicitly linked to their children.
.decl derived_process_link(from_mod: symbol, to_mod: symbol)

derived_process_link(a, b) :- process_link(a, b).
derived_process_link(sup, child) :- supervisor_child(sup, _, child, _, _).

// Two modules under a one_for_one supervisor where one depends on the
// other through GenServer message passing, and they belong to different
// child branches. Under one_for_one, if the callee's branch crashes,
// the caller's branch keeps running in a degraded state.
//
// Linked pairs are excluded: an exit propagates through the link, both
// processes restart together, and no stale state survives — the hazard
// this analysis reports is already mitigated.
//
// sup_site anchors the finding at the instruction that defines the tree
// (the strategy line); witness is a function in caller_mod through which
// the coupling flows. One row per witness — finding builders dedupe on
// (sup, caller_mod, callee_mod).
.decl one_for_one_coupling(sup: symbol, caller_mod: symbol, callee_mod: symbol, sup_site: symbol, witness: symbol)
.output one_for_one_coupling

one_for_one_coupling(sup, caller_mod, callee_mod, sup_site, witness) :-
  supervisor(sup, "one_for_one"),
  supervisor_site(sup, sup_site),
  child_subtree(sup, caller_branch, caller_mod),
  child_subtree(sup, callee_branch, callee_mod),
  stateful_module_dep(caller_mod, callee_mod, witness),
  !derived_process_link(caller_mod, callee_mod),
  !derived_process_link(callee_mod, caller_mod),
  caller_branch != callee_branch.
