// A message a module sends itself and cannot handle.
//
// A GenServer is one contract written in two places. The client half is an
// ordinary function —
//
//     def get(pid, k), do: GenServer.call(pid, {:get, k})
//
// — and the server half is a handle_call/3 clause. Nothing checks they
// agree. Rename the tag on one side and it compiles clean; `call` then
// raises FunctionClauseError in the server and the caller exits with it,
// and `cast` is worse, because the caller is told nothing at all.
//
// This analysis was written once before and reverted. The client tag came
// from an extractor that scanned backwards for the last write to {x,1},
// which is not the same as the write that REACHES the call: it reported
// :amqp_channel as casting :ok when the write it found was really
// gen_server:reply(From, ok).
//
// It is now a join instead of a scan. `def_use` is reaching definitions, so
// it names the write that actually feeds this call; `tuple_literal` and
// `literal_value` carry the constant and — critically — the register it
// landed in, because def_use says which write feeds which read but not
// which OPERAND, and a call reading {x,0} and {x,1} gets two edges.

.include "../clientlib/imports.dl"
.include "../clientlib/behaviours.dl"

// ── What the client sends ────────────────────────────────────────

.decl client_kind(func: symbol, kind: symbol)

client_kind(func, "call") :- remote_call(_, func, "GenServer", "call", _).
client_kind(func, "cast") :- remote_call(_, func, "GenServer", "cast", 2).

.decl sends_tag(func: symbol, kind: symbol, tag: symbol)

// The message is argument 1, so it arrives in x1.
sends_tag(func, "call", tag) :-
  remote_call(call_id, func, "GenServer", "call", _),
  def_use(write_id, call_id),
  tuple_literal(write_id, "x1", tag, _).

sends_tag(func, "call", tag) :-
  remote_call(call_id, func, "GenServer", "call", _),
  def_use(write_id, call_id),
  literal_value(write_id, "x1", tag),
  match(":.*", tag).

sends_tag(func, "cast", tag) :-
  remote_call(call_id, func, "GenServer", "cast", 2),
  def_use(write_id, call_id),
  tuple_literal(write_id, "x1", tag, _).

sends_tag(func, "cast", tag) :-
  remote_call(call_id, func, "GenServer", "cast", 2),
  def_use(write_id, call_id),
  literal_value(write_id, "x1", tag),
  match(":.*", tag).

// ── What the server accepts ──────────────────────────────────────

.decl kind_callback(kind: symbol, callback: symbol)

kind_callback("call", "handle_call").
kind_callback("cast", "handle_cast").

.decl handler(mod: symbol, callback: symbol, func: symbol)

handler(mod, "handle_call", func) :-
  function_def(func, mod, "handle_call", 3, _),
  behaves_as(mod, "GenServer").

handler(mod, "handle_cast", func) :-
  function_def(func, mod, "handle_cast", 2, _),
  behaves_as(mod, "GenServer").

// A function that calls or casts to a DIFFERENT module is a proxy, and its
// tags are that module's business. Excluded wholesale: wrapping someone
// else's server is a legitimate shape, and getting it wrong means reporting
// correct code.
.decl proxies(func: symbol)

proxies(func) :-
  sync_call(func, callee),
  function_def(func, mod, _, _, _),
  callee != mod,
  callee != "dynamic".

proxies(func) :-
  async_cast(func, callee),
  function_def(func, mod, _, _, _),
  callee != mod,
  callee != "dynamic".

.decl unhandled_self_message(mod: symbol, sender: symbol, kind: symbol, tag: symbol)
.output unhandled_self_message

unhandled_self_message(mod, sender, kind, tag) :-
  sends_tag(sender, kind, tag),
  function_def(sender, mod, _, _, _),
  kind_callback(kind, callback),
  handler(mod, callback, h),
  !proxies(sender),
  !callback_tag(h, callback, tag),
  !callback_total(h, callback).
