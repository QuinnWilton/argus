// gen_statem state machine correctness analysis.
//
// Detects state machine bugs: unreachable states, terminal states
// without stop, and related structural issues.

.include "../clientlib/imports.dl"

// Layer 2 input declarations.
.decl statem_module(mod: symbol, callback_mode: symbol)
.input statem_module

.decl statem_state(mod: symbol, state: symbol, site: symbol)
.input statem_state

.decl statem_transition(mod: symbol, from_state: symbol, event: symbol, to_state: symbol)
.input statem_transition

// ── Extraction confidence ────────────────────────────────────────
//
// Both structural rules reason over the extracted transition graph, so
// they are only sound where extraction produced one. A module whose
// return tuples the extractor could not read yields states but no
// transitions — under-extraction, not a machine with no edges — and
// without this gate every such state would be flagged both unreachable
// and terminal. The coverage analysis (coverage_statem_no_transitions)
// reports those modules as extraction gaps instead.

// At least one transition with a concrete target was extracted.
.decl module_has_resolved_transition(mod: symbol)

module_has_resolved_transition(mod) :-
  statem_transition(mod, _, _, to),
  to != "dynamic".

// Some transition's target is runtime-computed — it could land on any
// state, so no unreachability claim about this module is sound.
.decl module_has_dynamic_transition(mod: symbol)

module_has_dynamic_transition(mod) :-
  statem_transition(mod, _, _, "dynamic").

// ── State reachability ───────────────────────────────────────────

// A state is the target of at least one transition.
.decl state_has_incoming(mod: symbol, state: symbol)

state_has_incoming(mod, state) :-
  statem_transition(mod, _, _, state),
  state != "stop",
  state != "dynamic".

// Initial state — the first state in init/1 (heuristic: the first
// state declared, or the source of the first transition).
.decl initial_state(mod: symbol, state: symbol)

initial_state(mod, state) :-
  statem_transition(mod, state, _, _),
  !state_has_incoming(mod, state),
  statem_state(mod, state, _).

// Unreachable state — defined but no transition leads to it and
// it's not the initial state. One row per discovery site — finding
// builders dedupe on (mod, state).
//
// NOTE the initial_state heuristic above suppresses any no-incoming
// state that has outgoing transitions (it looks like a start state), so
// in practice this fires for states with no extracted transitions in
// either direction — dead state code. Reading the true initial state
// from init/1's return would sharpen this; until then the heuristic
// trades missed findings for zero false initial-state accusations.
.decl unreachable_state(mod: symbol, state: symbol, site: symbol)
.output unreachable_state

unreachable_state(mod, state, site) :-
  statem_state(mod, state, site),
  module_has_resolved_transition(mod),
  !module_has_dynamic_transition(mod),
  !state_has_incoming(mod, state),
  !initial_state(mod, state),
  state != "stop",
  state != "dynamic".

// ── Terminal states ──────────────────────────────────────────────

// A state has at least one outgoing transition.
.decl state_has_outgoing(mod: symbol, state: symbol)

state_has_outgoing(mod, state) :-
  statem_transition(mod, state, _, _).

// Terminal state without stop — a state with no outgoing transitions
// that doesn't transition to "stop". One row per discovery site —
// finding builders dedupe on (mod, state).
.decl terminal_without_stop(mod: symbol, state: symbol, site: symbol)
.output terminal_without_stop

terminal_without_stop(mod, state, site) :-
  statem_state(mod, state, site),
  module_has_resolved_transition(mod),
  !state_has_outgoing(mod, state),
  state != "stop",
  state != "dynamic".
