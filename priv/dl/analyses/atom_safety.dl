// Atom safety analysis.
//
// Detects atom table exhaustion risks, unsafe deserialization, and
// dynamic code execution reachable from exported functions.

.include "../clientlib/imports.dl"

// ── Export reachability ──────────────────────────────────────────

// A function is attack-surface-adjacent when it is exported, or when
// some exported function reaches it through the call graph.
.init export_reach = ForwardCallReachSet

export_reach.root(func) :-
  function_def(func, _, _, _, 1).

// ── Atom exhaustion risk ─────────────────────────────────────────

// Unsafe atom creation reachable from an exported function. One row
// per call SITE (`id` is the instruction), anchored at the function
// that contains the call — that's the place to fix. Previously rows
// were keyed (entry_func, api): the anchor pointed at the exported
// entry instead of the unsafe call, and one site fanned out into a
// row per reaching export.
.decl atom_exhaustion_risk(id: symbol, func: symbol, api: symbol)
.output atom_exhaustion_risk

atom_exhaustion_risk(id, func, api) :-
  unsafe_atom_creation(id, func, api),
  export_reach.reaches(func).

// ── Unsafe deserialization ───────────────────────────────────────

// binary_to_term without :safe option, anchored at the call site.
.decl unsafe_deserialization_finding(id: symbol, func: symbol, api: symbol)
.output unsafe_deserialization_finding

unsafe_deserialization_finding(id, func, api) :-
  unsafe_deserialization(id, func, api, safety),
  deserialization_is_unsafe(safety).

// `[:safe]` downgrades; it does not clear.
//
// OTP's docs for binary_to_term/2 say `safe` prevents new atoms and new
// EXTERNAL function references, then warn that it "does not guarantee that
// the data is safe for your application" — a fun referencing an
// already-loaded module passes. Paginator CVE-2020-15150 is RCE through
// `[:safe]`: a client-supplied cursor decoded to a fun that Enumerable then
// invoked. The fix routed through a validating decoder; the option was
// already present.
//
// Only Plug.Crypto's term-walking decoders clear the finding, and those are
// recorded as "validated".
.decl deserialization_is_unsafe(safety: symbol)

deserialization_is_unsafe("unsafe").
deserialization_is_unsafe("atoms_only").
deserialization_is_unsafe("dynamic").

// ── Code injection ───────────────────────────────────────────────

// Dynamic code execution reachable from exported functions, anchored
// at the call site (same shape rationale as atom_exhaustion_risk).
.decl code_injection_risk(id: symbol, func: symbol, api: symbol)
.output code_injection_risk

code_injection_risk(id, func, api) :-
  code_execution(id, func, api),
  export_reach.reaches(func).
