// Check effects inside database transactions. External writes can survive rollback
// and repeat when a transaction is retried. External waits also hold the checked-out
// database connection for their duration, tying pool capacity to another service's
// latency.

.include "../clientlib/imports.dl"
.include "../clientlib/behaviours.dl"
.include "../clientlib/runs_elsewhere.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ── Transaction call sites ───────────────────────────────────────

// Calls to transaction/1,2 on any Ecto.Repo implementation. Match the behaviour so
// application-specific repo names are covered.
.decl transaction_site(id: symbol, caller: symbol, repo: symbol)

transaction_site(id, caller, repo) :-
  remote_call(id, caller, repo, "transaction", _),
  behaves_as(repo, "Ecto.Repo").

// Repo.transact/2 and application wrappers run their function argument inside
// Repo.transaction. Model that boundary because ordinary call traversal misses the
// passed closure.
transaction_site(id, caller, repo) :-
  remote_call(id, caller, repo, "transact", _),
  behaves_as(repo, "Ecto.Repo").

// Postgrex and Ecto.Multi reach the same place by another route.
transaction_site(id, caller, "Postgrex") :-
  remote_call(id, caller, "Postgrex", "transaction", _).

// Transaction body
//
// Use the closure passed at the transaction site (`handed_closure`). Fall back to a
// function's sole closure only when it is unambiguous. Multiple closures or
// transactions on multiple repos prevent that fallback.

.decl transaction_body(site: symbol, caller: symbol, repo: symbol, body: symbol)

transaction_body(site, caller, repo, body) :-
  transaction_site(site, caller, repo),
  fun_handed(site, caller, body, _),
  closure_def(caller, body).

transaction_body(site, caller, repo, body) :-
  transaction_site(site, caller, repo),
  !fun_handed(site, caller, _, _),
  sole_closure(caller, body),
  !transaction_on_another_repo(caller, repo).

.decl transaction_on_another_repo(caller: symbol, repo: symbol)

transaction_on_another_repo(caller, repo) :-
  transaction_site(_, caller, repo),
  transaction_site(_, caller, other),
  other != repo.

// ── Writes the database cannot undo ─────────────────────────────

// A transaction body or reachable function performs a write the database cannot undo.
// Include writes in detached processes, but count their process-table effects only at
// the start site (`runs_from_transaction`).
.decl irreversible_write_in_transaction(opened: symbol, caller: symbol, repo: symbol, category: symbol, api: symbol, via: symbol, site: symbol)

irreversible_write_in_transaction(opened, caller, repo, category, api, via, site) :-
  transaction_body(opened, caller, repo, body),
  runs_in_transaction(body, via),
  irreversible_write(site, via, api, category).

irreversible_write_in_transaction(opened, caller, repo, category, api, via, site) :-
  transaction_body(opened, caller, repo, body),
  runs_from_transaction(body, via),
  irreversible_write(site, via, api, category),
  !on_process_table(category).

// A write outside the database's control, using the durable effect categories in
// `clientlib/effect_model.dl`. Excludes logging and read-only effects such as
// configuration, dictionary, clock, or random reads.
.decl irreversible_write(site: symbol, func: symbol, api: symbol, category: symbol)

irreversible_write(site, func, api, category) :-
  impure_call(site, func, api, category, "write"),
  durable_effect(category).

// An effect of this category is on the process table: a message, a
// start, a name.
.decl on_process_table(category: symbol)

on_process_table("process").

// Transaction work includes the body, same-process callees, and tasks it awaits.
// Awaited external requests hold the transaction and connection until completion.
.decl runs_in_transaction(body: symbol, via: symbol)

runs_in_transaction(body, via) :- body_reach.reaches(body, via).

// `func` starts a task running `runs` at `start` and waits on a task (runs_elsewhere.dl):
// any task, since this analysis reads no points-to to tell which one.
.decl awaits_task(func: symbol, start: symbol, runs: symbol)

awaits_task(f, id, g) :-
  process_start(id, f, _, "spawn", g),
  call_site(id, f, m, a, _),
  task_start_api(m, a, _),
  call_site(_, f, "Task", w, _),
  task_wait(w).

// Forward from the transaction bodies only, and not past a start the
// body does not wait for (runs_elsewhere, clientlib).
.init body_reach = ForwardCallReachCut

body_reach.root(body, body) :- transaction_body(_, _, _, body).
body_reach.cut(caller, fun) :- starts_on(caller, fun), !awaits_task(caller, _, fun).

// `caller` starts `fun` in a spawn, task, agent or forwarding helper. Functions merely
// registered or retained are traversed normally.
.decl starts_on(caller: symbol, fun: symbol)

starts_on(caller, fun) :-
  runs_elsewhere(caller, fun),
  process_start(_, caller, _, kind, fun),
  kind != "server".

starts_on(caller, fun) :-
  runs_elsewhere(caller, fun),
  fun_handed_to(caller, fun, sink),
  fun_sink(sink, "start").

// Functions run by the transaction body, including detached processes and registered
// funs. External writes still count after detachment. Process-table effects in detached
// work are covered by the start finding and are not reported again. Call-graph reach
// alone does not establish when a stored fun runs.
.decl runs_from_transaction(body: symbol, via: symbol)

runs_from_transaction(body, via) :- started_reach.reaches(body, via).

.init started_reach = ForwardCallReach

started_reach.root(body, body) :- transaction_body(_, _, _, body).

// ── Findings ─────────────────────────────────────────────────────

// An effect a transaction body performs that a rollback cannot undo. `context` is
// always `transaction` and `scope` names the repo; the columns keep the relation's
// earlier shape. `via` performs the effect, `site` anchors it, and `opened` identifies
// the transaction call.
.decl effect_in_context(func: symbol, context: symbol, scope: symbol, category: symbol, api: symbol, via: symbol, site: symbol, opened: symbol)
.output effect_in_context

// Match each transaction body to the repo at its own call site, avoiding unrelated
// repos used by the same caller.
effect_in_context(caller, "transaction", repo, category, api, via, site, opened) :-
  irreversible_write_in_transaction(opened, caller, repo, category, api, via, site).
