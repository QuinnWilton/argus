// An effect where its context forbids it.
//
// Two contracts, one written down and one imposed by context. `@pure
// true` is a claim the author made; the analysis checks it against the
// call graph and the effect model, and says verified, violated or
// unprovable. `Repo.transaction/1` says nothing, but the closure it runs
// must be something the database can undo, because the database is
// going to decide whether it happened.

.include "../clientlib/imports.dl"
.include "../clientlib/behaviours.dl"

// ══ Purity contracts ════════════════════════════════════════════════
// Purity contract verification.
//
// Every other analysis here looks for a bug nobody claimed was absent. This
// one checks a claim the author made with `@pure true`, which changes what
// a finding means: not "this looks suspicious" but "you said this function
// has no side effects, and here is the call that gives it one".
//
// It is also the only analysis that has to be SOUND rather than merely
// useful. A missed supervision smell costs a warning; a purity check that
// says "verified" when the function writes to ETS has actively misled
// someone into depending on it. So every call is accounted for, and calls
// the analysis cannot see through produce "unprovable" rather than silence.
//
// Three outcomes, and the third is the honest one:
//
//   violated    reaches a call with a known observable effect
//   unprovable  reaches a call that cannot be followed or classified
//   verified    everything reachable is known to be effect-free


// ── What the author claimed ──────────────────────────────────────

.decl declared_pure(func: symbol)

declared_pure(func) :- pure_contract(func, _, _, _).

// ── Effects the function performs itself ─────────────────────────
//
// Two sources. `impure_call` comes from the effect model in
// Argus.Purity.Effects — a curated table of standard-library and BIF
// behaviour, kept in Elixir where it can be unit-tested. The rest come from
// Layer 1, where the instruction itself IS the effect and no table is
// needed: a send is a send.

.decl performs_effect(func: symbol, category: symbol, api: symbol)

// Purity rejects both modes: reading a clock or the process dictionary
// already makes the result depend on something other than the arguments.
performs_effect(func, category, api) :-
  impure_call(_, func, api, category, _mode).

performs_effect(func, "process", "send") :-
  send_msg(_, func).

performs_effect(func, "process", "receive") :-
  receives(func).

performs_effect(func, "process", "spawn") :-
  spawn_call(_, func, _, _, _, _).

performs_effect(func, "ets", "ets") :-
  ets_op(_, func, _, _, _).

performs_effect(func, "ets", "ets_new") :-
  ets_new(_, func, _).

performs_effect(func, "port", "port") :-
  port_open(_, func, _, _).

performs_effect(func, "process", "register") :-
  process_register(_, func, _, _).

// ── Calls that cannot be accounted for ───────────────────────────
//
// A fun value or an `apply` has no statically known target, so nothing
// downstream of it can be inspected. An unclassified remote call is a
// different gap with the same consequence: the effect model has no entry
// for it, so its behaviour is unknown.
//
// Both are reported rather than assumed harmless. This is the difference
// between a verification and an opinion.

.decl opaque(func: symbol, reason: symbol, detail: symbol)

opaque(func, "dynamic_call", kind) :-
  dynamic_call(id, func, kind),
  !resolved_apply(id, _, _).

// A call to a function that declares its OWN purity is not opaque. The
// declaration is trusted at the call site and verified independently at the
// definition — modular verification, the same bargain every contract system
// makes. Without this, purity does not compose: no function could ever be
// verified if it called another of your own pure functions, which is most
// of what pure code does.
opaque(func, "unclassified_call", api) :-
  unknown_call(_, func, api, callee),
  !pure_contract(callee, _, _, _).

// Protocol dispatch is opaque for a different reason: not a missing table
// entry, but an open set of implementations that no table could enumerate.
opaque(func, "protocol_dispatch", api) :-
  protocol_dispatch(_, func, api).

// ── Propagation ──────────────────────────────────────────────────
//
// Purity is a property of everything a function can reach, so both effects
// and opacity travel up the call graph. `call_edge` already treats closure
// construction as a call, which is exactly right here: a lambda built
// inside a function and handed to Enum.each still runs its body, so an
// effect in that lambda is an effect of the function that built it.

// The functions whose transitive effects the findings ask about: every
// declared-pure function, and every closure defined in a caller of one
// (`impure_closure_to_pure`). Reachability is explored forward from
// those roots only.
.decl purity_root(func: symbol)

purity_root(func) :- declared_pure(func).

purity_root(closure) :-
  declared_pure(callee),
  call_edge(caller, callee),
  closure_def(caller, closure).

.init root_reach = ForwardCallReach

root_reach.root(func, func) :- purity_root(func).

.decl reaches_effect(func: symbol, category: symbol, api: symbol, via: symbol)

reaches_effect(func, category, api, func) :-
  performs_effect(func, category, api).

reaches_effect(func, category, api, via) :-
  root_reach.reaches(func, via),
  performs_effect(via, category, api).

.decl reaches_opaque(func: symbol, reason: symbol, detail: symbol, via: symbol)

reaches_opaque(func, reason, detail, func) :-
  opaque(func, reason, detail).

reaches_opaque(func, reason, detail, via) :-
  root_reach.reaches(func, via),
  opaque(via, reason, detail).

// ── Findings ─────────────────────────────────────────────────────

// The one output of both contracts: an effect where its context forbids
// it. `context` is "pure_contract" (func carries @pure true; scope is
// empty) or "transaction" (func opens a Repo transaction; scope is the
// repo). `via` is the function that actually performs the effect, which
// is where the fix goes when it is not func itself.
.decl effect_in_context(func: symbol, context: symbol, scope: symbol, category: symbol, api: symbol, via: symbol)
.output effect_in_context

// The claim is false: a declared-pure function reaches a known effect.
effect_in_context(func, "pure_contract", "", category, api, via) :-
  declared_pure(func),
  reaches_effect(func, category, api, via).

// The claim cannot be checked. Not a violation — the function may well be
// pure — but nobody should rely on it having been verified.
.decl purity_unprovable(func: symbol, reason: symbol, detail: symbol, via: symbol)
.output purity_unprovable

purity_unprovable(func, reason, detail, via) :-
  declared_pure(func),
  reaches_opaque(func, reason, detail, via),
  !reaches_effect(func, _, _, _).

// The claim holds: nothing reachable performs an effect, and nothing
// reachable is unaccounted for. Emitted deliberately — the value of a
// contract is knowing it was actually checked, and an analysis that only
// ever reports failures cannot distinguish "verified" from "not looked at".
.decl purity_verified(func: symbol)
.output purity_verified

purity_verified(func) :-
  declared_pure(func),
  !reaches_effect(func, _, _, _),
  !reaches_opaque(func, _, _, _).

// ── Higher-order contracts, checked at the call site ─────────────
//
// A declared-pure function that takes a fun and calls it is unprovable in
// general: its purity depends on what it was handed. But it is decidable
// PER CALL SITE, and that is where the obligation actually lives — the
// caller is the one choosing the closure.
//
// So when a caller hands an effectful closure to a function declared pure,
// the caller has broken the contract, and it is the caller's line that has
// to change.

.decl higher_order_pure(func: symbol)

// Transitive, not direct. `Enum.map(list, fn x -> f.(x) end)` puts the
// call_fun inside the LIFTED closure, so the declared function never
// contains one itself — checking only its own body would find nothing and
// this whole rule would sit dead.
higher_order_pure(func) :-
  declared_pure(func),
  reaches_opaque(func, "dynamic_call", "call_fun", _).

// Which closures a caller builds, and whether they perform effects.
.decl impure_closure(caller: symbol, closure: symbol, category: symbol, api: symbol)

impure_closure(caller, closure, category, api) :-
  closure_def(caller, closure),
  reaches_effect(closure, category, api, _).

.decl impure_closure_to_pure(caller: symbol, callee: symbol, closure: symbol, category: symbol, api: symbol)
.output impure_closure_to_pure

impure_closure_to_pure(caller, callee, closure, category, api) :-
  higher_order_pure(callee),
  call_edge(caller, callee),
  sole_closure(caller, closure),
  impure_closure(caller, closure, category, api).

// ══ Effects inside a transaction ════════════════════════════════════
// Unrollbackable side effects inside a database transaction.
//
// `@pure` is a contract someone writes down. This one nobody writes down —
// it is imposed by CONTEXT. Passing a closure to `Repo.transaction/1`
// silently accepts an obligation: whatever that closure does must be
// something the database can undo, because the database is going to decide
// whether it happened.
//
// Three ways that goes wrong, all common and none of them visible in
// review because the offending call looks perfectly ordinary:
//
//   1. ROLLBACK LEAVES THE EFFECT BEHIND. The transaction aborts, the rows
//      vanish, and the webhook has already fired. The system is now in a
//      state its own database says never existed.
//
//   2. RETRY REPEATS IT. Serialization failures and deadlocks are retried
//      by design — that is what `:serializable` costs. Every retry re-runs
//      the closure, so one logical operation sends two emails.
//
//   3. THE CONNECTION IS HELD THROUGHOUT. A checked-out pooled connection
//      is held for the whole closure, so an HTTP call inside a transaction
//      couples database capacity to a third party's latency. A slow
//      external dependency stops being a slow feature and becomes pool
//      exhaustion, which is an outage.
//
// The third is the one that takes systems down, and it is the least
// obvious: the code is correct, it just holds a scarce resource while
// waiting on something it does not control.


// ── Transaction call sites ───────────────────────────────────────

// Any module implementing Ecto.Repo, called as `.transaction/1,2`. Reading
// the behaviour rather than matching on a name means an app's own
// `MyApp.Repo` is found without knowing what it is called.
.decl transaction_site(caller: symbol, repo: symbol)

transaction_site(caller, repo) :-
  remote_call(_, caller, repo, "transaction", _),
  behaves_as(repo, "Ecto.Repo").

// Postgrex and Ecto.Multi reach the same place by another route.
transaction_site(caller, "Postgrex") :-
  remote_call(_, caller, "Postgrex", "transaction", _).

// ── The closure the transaction runs ─────────────────────────────
//
// Associating a closure with the transaction that runs it needs dataflow
// argus does not have, so the association is by containment: this function
// opened a transaction and built this closure.
//
// Gated on the function building exactly ONE closure, for the same reason
// as the higher-order purity check — with two there is no way to say which
// was passed to the transaction, and naming the wrong lambda sends someone
// to the wrong line, which is worse than saying nothing.

.decl transaction_body(caller: symbol, repo: symbol, body: symbol)

transaction_body(caller, repo, body) :-
  transaction_site(caller, repo),
  sole_closure(caller, body).

// ── Effects the database cannot undo ─────────────────────────────
//
// Deliberately NOT every effect. Logging is fine inside a transaction and
// is the most common effect there by a wide margin; reading a clock or
// drawing a random number needs no undoing. What matters is effects that
// escape the database's control, and the shared effect model already
// classifies those.

// Only WRITES. `Application.get_env/2` and `Process.get/1` are impure —
// they break purity — but there is nothing for a rollback to undo, and
// reporting them here would bury the calls that matter under every config
// read in the codebase. The categories are the effect model's durable
// ones (effects.dl): what has left the process cannot be rolled back.

.decl escapes_transaction(caller: symbol, repo: symbol, category: symbol, api: symbol, via: symbol)

// Forward from the transaction bodies only.
.init body_reach = ForwardCallReach

body_reach.root(body, body) :- transaction_body(_, _, body).

escapes_transaction(caller, repo, category, api, via) :-
  transaction_body(caller, _repo_unused, body),
  transaction_site(caller, repo),
  body_reach.reaches(body, via),
  impure_call(_, via, api, category, "write"),
  durable_effect(category).

// The effect is in the closure itself, not something it calls.
escapes_transaction(caller, repo, category, api, body) :-
  transaction_body(caller, _repo_unused, body),
  transaction_site(caller, repo),
  impure_call(_, body, api, category, "write"),
  durable_effect(category).

// ── Findings ─────────────────────────────────────────────────────

effect_in_context(caller, "transaction", repo, category, api, via) :-
  escapes_transaction(caller, repo, category, api, via).
