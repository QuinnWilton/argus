// Processes an outside party can create without limit.
//
// `DynamicSupervisor` defaults to `max_children: :infinity`, and the default
// is what everyone uses — 8 DynamicSupervisors across the projects swept
// here, ZERO of which set a cap. On its own that is fine: most dynamic
// supervisors are driven by trusted callers, and a cap would be a nuisance.
//
// The finding is the pairing, and it is a question about the call graph
// rather than about any one line:
//
//   can `start_child` be reached from a request handler?
//
// If it can, then an unauthenticated request creates a process and nothing
// bounds how many. Each one costs a PID, a mailbox and a heap, and the node
// dies of memory exhaustion rather than of anything that looks like an
// attack. No single line in the program is wrong, which is why reading the
// supervisor or the handler in isolation shows nothing.

.include "../clientlib/imports.dl"
.include "../clientlib/behaviours.dl"
.include "../clientlib/request_entry.dl"

// ── Uncapped dynamic supervisors ─────────────────────────────────
//
// `supervisor_max_children` is emitted only when a finite cap is set, so
// absence is the question. A supervisor whose init/1 could not be read
// emits no cap either, which counts as uncapped — the conservative
// direction for a resource bound, and the one that matches the default.

.decl uncapped_supervisor(sup: symbol)

uncapped_supervisor(sup) :-
  dynamic_child(sup, _, _),
  sup != "dynamic",
  !supervisor_max_children(sup, _).

// ── Reachable from outside ───────────────────────────────────────

.decl externally_reachable(func: symbol, entry: symbol, kind: symbol)

// Backwards from the functions that start dynamic children, so only
// their callers are explored.
.decl reaches_dynamic_child_via(func: symbol, via: symbol)

reaches_dynamic_child_via(via, via) :- dynamic_child(_, _, via).

reaches_dynamic_child_via(f, via) :-
  call_edge(f, g),
  reaches_dynamic_child_via(g, via).

externally_reachable(via, entry, kind) :-
  request_entry(entry, kind),
  reaches_dynamic_child_via(entry, via).

.decl unbounded_children_from_request(sup: symbol, child: symbol, via: symbol, kind: symbol)
.output unbounded_children_from_request

unbounded_children_from_request(sup, child, via, kind) :-
  uncapped_supervisor(sup),
  dynamic_child(sup, child, via),
  externally_reachable(via, _, kind),
  !disabled_transport(sup).

// ── Transports the project does not switch on ────────────────────
//
// A dangerous path in a dependency is not a finding when nothing turns it
// on. Phoenix's long-poll transport starts a process per unauthenticated
// request with no ceiling, and it was reported in three projects while
// being enabled in exactly one.
//
// Configuration is usually assumed invisible here, and for a runtime
// `Application.get_env/2` it is. But `Phoenix.Endpoint`'s `socket/3` is a
// MACRO, so its options compile into `__sockets__/0` as a literal — the
// same shape as the TLS option lists, readable in the same way. That is the
// difference between a finding a human checks against endpoint.ex and one
// the analysis settles itself.
//
// Phoenix-specific, deliberately and consistently with request_entry, which
// already names LiveView and Channel. The general rule underneath is worth
// stating: config is visible when a macro bakes it into the module and
// invisible when it is read at runtime, and which one applies takes a
// single disassembly to settle.

.decl transport_supervisor(sup: symbol, transport: symbol)

transport_supervisor("Phoenix.Transports.LongPoll.Supervisor", "longpoll").

.decl disabled_transport(sup: symbol)

disabled_transport(sup) :-
  transport_supervisor(sup, transport),
  !socket_transport(_, _, transport).
