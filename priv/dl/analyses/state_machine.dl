// gen_statem graph defects.
//
// The state machine as a graph: a state no transition reaches, and a
// state with no way out that never stops the machine. Scoped to
// state_functions mode, where states are function names the extractor
// can read.

.include "../clientlib/imports.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ── Mode scoping ─────────────────────────────────────────────────
//
// The structural rules below reason over a graph of state-function
// callbacks. That graph only exists in state_functions mode; in
// handle_event_function mode there is a single handle_event/4 callback
// and states are ordinary data values, so "unreachable state function"
// and "terminal state function" are not well-defined and the extractor
// cannot build a per-state transition graph. Scope both rules to
// state_functions modules.
.decl state_functions_mode(mod: symbol)

state_functions_mode(mod) :- statem_module(mod, "state_functions").

// ── Extraction confidence ────────────────────────────────────────
//
// Both structural rules reason over the extracted transition graph, so
// they are only sound where extraction produced one. A module whose
// return tuples the extractor could not read yields no resolved
// transitions; without this gate its states would be flagged both
// unreachable and terminal from an empty graph.

// At least one transition with a concrete target was extracted.
.decl module_has_resolved_transition(mod: symbol)

module_has_resolved_transition(mod) :-
  statem_transition(mod, _, _, to),
  to != "dynamic".

// Some transition's target is runtime-computed — it could land on any
// state, so no unreachability claim about this module is sound. A
// helper's computed target counts too.
.decl module_has_dynamic_transition(mod: symbol)

module_has_dynamic_transition(mod) :-
  statem_transition(mod, _, _, "dynamic").

module_has_dynamic_transition(mod) :-
  statem_helper_transition(mod, _, "dynamic").

// ── The graph without self-loops ─────────────────────────────────
//
// A state's own `keep_state`/`repeat_state` return (and a `next_state`
// naming itself) is extracted as a transition from the state to itself.
// It is neither a way in nor a way out: counted as either, every state
// function with a keep-state clause was both reachable and non-terminal,
// and terminal_without_stop could never report one.

// A state function: the exported arity-3 function gen_statem calls for
// a state — one the extractor recognised, or one a transition names
// that returns only what it delegates to (Rondo.Broken's `abyss/3`,
// every clause handed to a private keep-state helper), which returns no
// action of its own. What it may return is read through its returned
// calls, like any state's. A state named only by a transition, with no
// such function in the module, has no function to judge.
.decl state_function(mod: symbol, state: symbol, func: symbol)

state_function(mod, state, func) :-
  statem_state(mod, state, _),
  function_def(func, mod, state, 3, 1).

// ── State reachability ───────────────────────────────────────────

// A state is entered from another state, or by a helper's transition
// (a `disconnect/2` returning `{:next_state, :disconnected, …}` on its
// caller's behalf, which names no source state).
.decl state_has_incoming(mod: symbol, state: symbol)

state_has_incoming(mod, state) :-
  statem_transition(mod, from, _, state),
  from != state,
  state != "stop",
  state != "dynamic".

// A helper's transition is a way in unless the state's own function is
// the helper's only caller: a catch-all that re-enters its state through
// a helper (to restart a state timeout) is a self-loop spelled as a
// call (review 2, item 27: 6aff4d81 read it as a way in).
state_has_incoming(mod, state) :-
  statem_helper_transition(mod, h, state),
  state != "stop",
  state != "dynamic",
  call_edge(c, h),
  !state_function(mod, state, c).

state_has_incoming(mod, state) :-
  statem_helper_transition(mod, h, state),
  state != "stop",
  state != "dynamic",
  !call_edge(_, h).

// Initial state. Authoritative when init/1's return was resolvable
// (statem_initial); otherwise a topological fallback — a state that is a
// transition source with no incoming edge. The fallback is used only for
// modules with no resolved init state, so a machine whose real entry
// point was read from init/1 never has a second state misclassified as
// initial by the heuristic.
.decl module_has_initial(mod: symbol)

module_has_initial(mod) :- statem_initial(mod, _).

.decl initial_state(mod: symbol, state: symbol)

initial_state(mod, state) :-
  statem_initial(mod, state).

initial_state(mod, state) :-
  statem_transition(mod, state, _, _),
  !state_has_incoming(mod, state),
  statem_state(mod, state, _),
  !module_has_initial(mod).

// Unreachable state — defined but no transition from another state or
// a helper leads to it, and it's not the initial state. One row per
// discovery site — finding builders dedupe on (mod, state).
//
// NOTE the initial_state fallback above takes any no-incoming state that
// has transitions of its own for the entry point when init/1's return is
// computed, so in such a module this reports nothing.
.decl unreachable_state(mod: symbol, state: symbol, site: symbol)
.output unreachable_state

unreachable_state(mod, state, site) :-
  statem_state(mod, state, site),
  state_functions_mode(mod),
  module_has_resolved_transition(mod),
  !module_has_dynamic_transition(mod),
  !state_has_incoming(mod, state),
  !initial_state(mod, state),
  state != "stop",
  state != "dynamic".

// ── Terminal states ──────────────────────────────────────────────

// What a function may return on some state's behalf: a transition a
// helper builds, or whatever the function it returns the result of may
// return (`dynamic` when that is a remote call, an apply or a throw).
.decl may_return_transition(mod: symbol, func: symbol, to: symbol)

may_return_transition(mod, func, to) :-
  statem_helper_transition(mod, func, to).

// A remote call the state returns may transition anywhere, unless its
// callee is a function of the program in a module that is no machine
// (a shared handler of another module, whose returns name no state of
// this one): what it returns is read as keeping the state (review 2,
// item 27). A callee outside the program stays "dynamic".
may_return_transition(mod, func, "dynamic") :-
  statem_returns_call(mod, func, "dynamic"),
  !returns_program_handler(mod, func).

.decl returns_program_handler(mod: symbol, func: symbol)

returns_program_handler(mod, func) :-
  statem_returns_call(mod, func, "dynamic"),
  call_instr(func, g, id),
  tail_call(id),
  function_def(g, m2, _, _, _),
  m2 != mod,
  !statem_module(m2, _).

may_return_transition(mod, func, to) :-
  statem_returns_call(mod, func, callee),
  callee != "dynamic",
  may_return_transition(mod, callee, to).

// A state has a way out: a transition to another state or to stop, its
// own or one a function it returns the result of builds.
.decl state_leaves(mod: symbol, state: symbol)

state_leaves(mod, state) :-
  statem_transition(mod, state, _, to),
  to != state.

state_leaves(mod, state) :-
  state_function(mod, state, func),
  may_return_transition(mod, func, to),
  to != state.

// Terminal state without stop — a state function entered from another
// state, with no way out and no stop. A machine that never leaves its
// initial state is a server with one state, not a machine stuck in a
// terminal one. One row per state function.
.decl terminal_without_stop(mod: symbol, state: symbol, site: symbol)
.output terminal_without_stop

terminal_without_stop(mod, state, site) :-
  state_function(mod, state, site),
  state_functions_mode(mod),
  module_has_resolved_transition(mod),
  state_has_incoming(mod, state),
  !initial_state(mod, state),
  !state_leaves(mod, state).
