// gen_statem graph defects: unreachable states and states with no exit or stop
// transition. Applies to state_functions mode, where states have extractable function
// names.

.include "../clientlib/imports.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ── Unreachable states ───────────────────────────────────────────

// Unreachable state — defined but never entered. One row per discovery
// site — finding builders dedupe on (mod, state).
.decl unreachable_state(mod: symbol, state: symbol, site: symbol)
.output unreachable_state

// All transition targets are known, but this non-initial state has no incoming
// transition from another state or helper.
.decl state_never_entered(mod: symbol, state: symbol)

state_never_entered(mod, state) :-
  declared_state(mod, state),
  targets_all_known(mod),
  !has_way_in(mod, state),
  !initial_state(mod, state).

unreachable_state(mod, state, site) :-
  state_never_entered(mod, state),
  statem_state(mod, state, site).

// ── Terminal states ──────────────────────────────────────────────

// Terminal state without stop. One row per state function.
.decl terminal_without_stop(mod: symbol, state: symbol, site: symbol)
.output terminal_without_stop

// A state reached from another state has no outgoing transition or stop. Exclude a
// machine that simply remains in its initial state.
terminal_without_stop(mod, state, func) :-
  state_function(mod, state, func),
  has_transition_graph(mod),
  has_way_in(mod, state),
  !initial_state(mod, state),
  !has_way_out(mod, state).

// ── The machine ──────────────────────────────────────────────────

// A state the extractor read in the module (statem_state), other than
// the "stop" and "dynamic" placeholders.
.decl declared_state(mod: symbol, state: symbol)

declared_state(mod, state) :-
  statem_state(mod, state, _),
  state != "stop",
  state != "dynamic".

// State-graph checks require state_functions mode and at least one resolved transition
// target. handle_event_function represents states as data, and an empty extracted graph
// cannot establish unreachable or terminal states.
.decl has_transition_graph(mod: symbol)

has_transition_graph(mod) :-
  statem_module(mod, "state_functions"),
  has_resolved_transition(mod).

// At least one transition with a concrete target was extracted.
.decl has_resolved_transition(mod: symbol)

has_resolved_transition(mod) :-
  statem_transition(mod, _, _, to),
  to != "dynamic".

has_resolved_transition(mod) :- handed_target(mod, _, _, _).

// Require a transition graph with no computed targets. A dynamic target could reach any
// state, preventing sound unreachability claims.
.decl targets_all_known(mod: symbol)

targets_all_known(mod) :-
  has_transition_graph(mod),
  !has_dynamic_transition(mod).

// Some transition's target is runtime-computed, a helper's included.
.decl has_dynamic_transition(mod: symbol)

has_dynamic_transition(mod) :-
  statem_transition(mod, _, _, "dynamic").

has_dynamic_transition(mod) :-
  statem_helper_transition(mod, _, "dynamic").

has_dynamic_transition(mod) :- unknown_handed_target(mod, _, _).

// A helper taking its target from a parameter whose callers are not all seen (an
// export, a fun, an apply), or not all literal, may be handed any state (the values
// stage's param_complete).
has_dynamic_transition(mod) :-
  statem_target_param(mod, h, k),
  !param_complete(h, k).

// ── Targets a helper's callers hand it ───────────────────────────

// A helper whose next_state target is its parameter (ra's `next_state(follower, State,
// Actions)`) enters the state each local call hands it there: the calling function may
// return that transition. The literal is the one the caller spells, through any chain
// of helpers handing it on (the values stage's param_origin).
.decl handed_target(mod: symbol, caller: symbol, callee: symbol, to: symbol)

handed_target(mod, c, h, to) :- handed_literal(mod, c, h, lit), state_literal(mod, lit, to).

// The literal `caller`'s call hands `callee`'s target parameter.
.decl handed_literal(mod: symbol, caller: symbol, callee: symbol, literal: symbol)

handed_literal(mod, c, h, lit) :-
  statem_target_param(mod, h, k),
  param_origin(h, k, c, site, lit),
  call_instr(c, h, site).

// A literal naming a state of the module: the atom its function is named by
// (`:follower` names `follower`). Any other names no state the graph knows.
.decl state_literal(mod: symbol, literal: symbol, state: symbol)

state_literal(mod, lit, to) :-
  handed_literal(mod, _, _, lit),
  statem_state(mod, to, _),
  lit = cat(":", to).

// A call whose target argument no state names: a computed one, a literal naming no
// state of the module, or a parameter of a function whose own callers do not choose
// it (a state function's event content).
.decl unknown_handed_target(mod: symbol, caller: symbol, callee: symbol)

unknown_handed_target(mod, c, h) :- handed_literal(mod, c, h, lit), !state_literal(mod, lit, _).

unknown_handed_target(mod, c, h) :-
  statem_target_param(mod, h, k),
  call_instr(c, h, site),
  !call_arg_var(site, c, h, k, "call", _, _).

unknown_handed_target(mod, c, h) :-
  statem_target_param(mod, h, k),
  call_arg_var(_, c, h, k, "call", sk, _),
  sk != "literal",
  sk != "param".

unknown_handed_target(mod, c, h) :-
  statem_target_param(mod, h, k),
  call_arg_var(_, c, h, k, "call", "param", j),
  !statem_target_param(mod, c, j).

// Ignore graph self-loops
//
// keep_state, repeat_state, and next_state-to-self establish neither incoming reach
// from another state nor an exit from this state.

// An exported arity-3 state callback recognized by extraction or named by a transition.
// Include callbacks delegating all returns to helpers and follow those return paths. A
// named state without such a function has no callback to inspect.
.decl state_function(mod: symbol, state: symbol, func: symbol)

state_function(mod, state, func) :-
  statem_state(mod, state, _),
  function_def(func, mod, state, 3, 1).

// ── A way in ─────────────────────────────────────────────────────

// A state has an incoming transition from another state or a helper returning
// next_state on its caller's behalf.
.decl has_way_in(mod: symbol, state: symbol)

has_way_in(mod, state) :-
  statem_transition(mod, from, _, state),
  from != state,
  state != "stop",
  state != "dynamic".

// A helper transition provides an incoming edge unless this state callback is its sole
// caller, in which case it represents a self-loop.
has_way_in(mod, state) :-
  statem_helper_transition(mod, h, state),
  state != "stop",
  state != "dynamic",
  call_edge(c, h),
  !state_function(mod, state, c).

// A state a call hands a helper's target parameter, unless the call is that state's own.
has_way_in(mod, state) :-
  handed_target(mod, c, _, state),
  state != "stop",
  !state_function(mod, state, c).

// A helper with no visible caller may be called externally, so its transition remains a
// possible entry path.
has_way_in(mod, state) :-
  statem_helper_transition(mod, h, state),
  state != "stop",
  state != "dynamic",
  !call_edge(_, h).

// Use resolved init states when available. Otherwise, treat every transition-source
// state without incoming edges as a possible initial state. This fallback can suppress
// unreachable-state findings when init's result is computed.
.decl initial_state(mod: symbol, state: symbol)

initial_state(mod, state) :-
  statem_initial(mod, state).

initial_state(mod, state) :-
  statem_transition(mod, state, _, _),
  !has_way_in(mod, state),
  statem_state(mod, state, _),
  !initial_state_read(mod).

// init/1's return names the initial state (statem_initial).
.decl initial_state_read(mod: symbol)

initial_state_read(mod) :- statem_initial(mod, _).

// ── A way out ────────────────────────────────────────────────────

// A state can leave through a transition to another state or stop, directly or through
// a returned helper result.
.decl has_way_out(mod: symbol, state: symbol)

has_way_out(mod, state) :-
  statem_transition(mod, state, _, to),
  to != state.

has_way_out(mod, state) :-
  state_function(mod, state, func),
  may_return_transition(mod, func, to),
  to != state.

// Possible transitions returned on a state's behalf, following helper results. Remote
// calls, apply and throw yield unknown (dynamic) transitions.
.decl may_return_transition(mod: symbol, func: symbol, to: symbol)

may_return_transition(mod, func, to) :-
  statem_helper_transition(mod, func, to).

may_return_transition(mod, c, to) :-
  handed_target(mod, c, h, to),
  statem_returns_call(mod, c, h).

may_return_transition(mod, c, "dynamic") :-
  unknown_handed_target(mod, c, h),
  statem_returns_call(mod, c, h).

// An external returned call may transition anywhere. A visible non-machine module's
// returned result is treated as keeping the state; unseen callees remain dynamic.
may_return_transition(mod, func, "dynamic") :-
  statem_returns_call(mod, func, "dynamic"),
  !returns_program_handler(mod, func).

may_return_transition(mod, func, to) :-
  statem_returns_call(mod, func, callee),
  callee != "dynamic",
  may_return_transition(mod, callee, to).

// `func` returns, as a tail call, the result of a function of the
// program in another module that is no machine.
.decl returns_program_handler(mod: symbol, func: symbol)

returns_program_handler(mod, func) :-
  statem_returns_call(mod, func, "dynamic"),
  call_instr(func, g, id),
  tail_call(id),
  function_def(g, m2, _, _, _),
  m2 != mod,
  !statem_module(m2, _).
