// Work in a phase whose invariants do not hold yet.
//
// init/1 runs inside the supervisor's start sequence: a synchronous
// call from it to a sibling that starts later is a deadlock by
// construction, a call to any peer stalls the tree, a connect with no
// way to retry crash-loops the child until the tree gives up, a
// cluster-wide lock hangs the boot on a partition. handle_continue runs
// after init returns but before any message, so its own races and
// cycles are startup's too. And state written after
// Supervisor.start_link returned is written after the children are
// already serving.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/resolved_calls.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/global_reach.dl"
.include "../clientlib/timer_flush.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ══ The outputs ═════════════════════════════════════════════════════
//
// `blocks_on_peer(mod, phase, dep, kind, ordering, sup, site, detail)` —
//   a phase waits on a peer. `phase` is "init" or "continue"; `kind`
//   says how: "call" (a synchronous call; `detail` is "conditional" or
//   "unconditional" when the ordering is unknown), "cast" (a one-way
//   dependency on a later sibling), "sup" (a supervisor management call;
//   `detail` is api.op, `dep` the target), "blocking_server" (the callee
//   runs but its handler `detail` blocks at `site`), "parent" (a
//   handle_continue calls its own supervisor), "global" (a :global lock
//   that retries until it is granted; `detail` is the op, `dep` the nodes
//   it waits on: "cluster", "local" or "unknown"), "global_assumed" (the
//   same, with a retry count the bytecode does not show, assumed
//   :infinity), "global_bounded" (a lock over other nodes that gives up
//   after a positive retry count) or "remote" (an rpc, a node
//   operation, a distributed store; `detail` is the op). `ordering` is where the peer
//   starts relative to this child under `sup`: "later" (a deadlock by
//   construction, or a race from handle_continue), "earlier",
//   "parent", "unknown" (no tree places both), or empty. `site` anchors
//   the tree definition for a later sibling, the call otherwise.
// `unbounded_effect_in_init(mod, kind, api)` — init/1, in its own
//   process, reaches a socket receive with :infinity ("recv"; `api` is
//   the function), a `receive` with no `after` ("receive"), one only the
//   exit of the process it waits on ends ("down"), a server loop entered
//   before the start is acknowledged ("enter_loop"; `api` holds the
//   call), or a connect with no way to retry ("connect").
// `deferral_defect(mod, kind, site, detail)` — deferred work that will
//   not happen as written: an init timeout of `detail` ms that any
//   earlier message cancels ("init_timeout"), or a defensive catch in
//   handle_continue that turns a deadlock into a restart loop under the
//   supervisor `detail` ("continue_catch").
.decl blocks_on_peer(mod: symbol, phase: symbol, dep: symbol, kind: symbol, ordering: symbol, sup: symbol, site: symbol, detail: symbol)
.output blocks_on_peer

// With priors on, a "receive" or "down" wait carries `peer` ("local")
// and `permille` when the model is sure what it waits on answers from
// inside the node (below); else "" and 0.
.decl unbounded_effect_in_init(mod: symbol, kind: symbol, api: symbol, site: symbol, peer: symbol, permille: number)
.output unbounded_effect_in_init

// What the rules below find, before a prior says whether the peer answers.
.decl init_effect(mod: symbol, kind: symbol, api: symbol, site: symbol)

.decl deferral_defect(mod: symbol, kind: symbol, site: symbol, detail: symbol)
.output deferral_defect

// ══ Synchronous calls from init/1 ═══════════════════════════════════
.decl raw_sync_call_in_init(mod: symbol, callee: symbol)

raw_sync_call_in_init(mod, callee) :- init_dep(mod, callee, "call", _).

// ── Supervision-aware filtering ────────────────────────────────────────

// True when both modules appear under a common supervisor's subtree.
.decl shares_supervisor(child: symbol, dep: symbol)

shares_supervisor(child, dep) :-
  child_subtree(sup, _, child),
  child_subtree(sup, _, dep),
  child != dep.

// A module with a behaviour and start_link/1 is very likely supervised,
// even when we can't statically determine which supervisor owns it.
.decl likely_supervised(mod: symbol)

likely_supervised(mod) :- child_subtree(_, _, mod).

likely_supervised(mod) :-
  behaves_as(mod, _),
  function_def(_, mod, "start_link", 1, _).

// The callee starts earlier under the same supervisor, so it is running
// when this init runs.
.decl init_safe_sibling(child: symbol, dep: symbol)

init_safe_sibling(child, dep) :-
  raw_sync_call_in_init(child, dep),
  starts_before(_, dep, child, _, _).

// Both likely supervised but under disjoint supervisor trees — callee
// is already running because it was started by a different supervisor.
// At least one must be provably supervised (in a child_subtree) to
// prevent false negatives when no supervision facts exist at all.
.decl init_safe_cross_supervisor(child: symbol, dep: symbol)

init_safe_cross_supervisor(child, dep) :-
  raw_sync_call_in_init(child, dep),
  child_subtree(_, _, child),
  likely_supervised(dep),
  !shares_supervisor(child, dep).

init_safe_cross_supervisor(child, dep) :-
  raw_sync_call_in_init(child, dep),
  likely_supervised(child),
  child_subtree(_, _, dep),
  !shares_supervisor(child, dep).

// ── Conditional paths ──────────────────────────────────────────────────

// The dependency holds on every path through init: the first hop out of
// init is not control-dependent on a branch.
.decl unconditional_sync_call_in_init(mod: symbol, callee: symbol)

// The call making the dependency is itself unconditional — not some
// other GenServer.call in init. A call made after init/1's own ack
// (start_acked), or an edge taken only after it (acked_edge), no longer
// holds the start: it cannot make the start's wait unconditional.
unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  sync_site(func, callee, id),
  !conditional_call(id),
  !start_acked(id, func).

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  tag_resolved_site(id, func, "call", callee),
  sync_call_site(id, func, t, _),
  unresolved_target(t),
  !conditional_call(id),
  !start_acked(id, func).

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  unconditional_call_edge(func, g),
  !acked_edge(func, g),
  reaches_sync_dep(g, callee).

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  unconditional_call_edge(func, g),
  !acked_edge(func, g),
  genserver_sync_api(g, callee),
  mod != callee.

// ── Where init/1 waits ─────────────────────────────────────────────────
//
// The call in init/1, before it acknowledges its start, on the way to
// the wait on `callee`: the GenServer.call itself (or the tag-attributed
// call on a pid it holds), or the call into the helper or client API
// that makes it. A finding anchored at init/1 lands on its head, often
// tens of lines above the call. An unconditional site is preferred where
// init has one: the call that makes the finding "unconditional". Empty
// when init/1 makes no call of its own on the way (a closure it hands
// on), and the finding falls back to the function.
.decl init_wait_site(mod: symbol, callee: symbol, site: symbol)

init_wait_site(mod, callee, id) :-
  raw_sync_call_in_init(mod, callee),
  init_function(mod, f),
  sync_site(f, callee, id),
  !start_acked(id, f).

init_wait_site(mod, callee, id) :-
  raw_sync_call_in_init(mod, callee),
  init_function(mod, f),
  tag_resolved_site(id, f, "call", callee),
  !start_acked(id, f).

init_wait_site(mod, callee, id) :-
  raw_sync_call_in_init(mod, callee),
  init_function(mod, f),
  call_instr(f, g, id),
  !start_acked(id, f),
  !side_call(f, g),
  reaches_sync_dep(g, callee).

// A task init/1 awaits (awaits_task): the wait is at its start.
init_wait_site(mod, callee, id) :-
  raw_sync_call_in_init(mod, callee),
  init_function(mod, f),
  awaits_task(f, id, g),
  !start_acked(id, f),
  reaches_sync_dep(g, callee).

.decl init_waits_unconditionally_at(mod: symbol, callee: symbol)

init_waits_unconditionally_at(mod, callee) :-
  init_wait_site(mod, callee, id),
  !conditional_call(id).

.decl init_wait(mod: symbol, callee: symbol, site: symbol)

init_wait(mod, callee, id) :- init_wait_site(mod, callee, id), !conditional_call(id).

init_wait(mod, callee, id) :-
  init_wait_site(mod, callee, id),
  !init_waits_unconditionally_at(mod, callee).

init_wait(mod, callee, "") :-
  raw_sync_call_in_init(mod, callee),
  !init_wait_site(mod, callee, _).

// ── Filtered output ────────────────────────────────────────────────────

// `kind` is "unconditional" when some path from init to the call runs on
// every init, "conditional" when every path goes through a call site in
// init that a branch guards (postgrex's `sync_connect: true`, goth's
// `prefetch: :sync`).
blocks_on_peer(mod, "init", callee, "call", "unknown", "", site, "unconditional") :-
  raw_sync_call_in_init(mod, callee),
  !init_safe_sibling(mod, callee),
  !init_safe_cross_supervisor(mod, callee),
  !later_sibling_call(mod, callee),
  unconditional_sync_call_in_init(mod, callee),
  init_wait(mod, callee, site).

blocks_on_peer(mod, "init", callee, "call", "unknown", "", site, "conditional") :-
  raw_sync_call_in_init(mod, callee),
  !init_safe_sibling(mod, callee),
  !init_safe_cross_supervisor(mod, callee),
  !later_sibling_call(mod, callee),
  !unconditional_sync_call_in_init(mod, callee),
  init_wait(mod, callee, site).

// A call to a sibling that starts later is reported once, with the
// tree ordering, under "Start order" below (later_sibling_dep): the
// deadlock, not also a call of unknown place beside it. So is a call to
// a process the start function starts only after the tree
// (after_tree_dep).
.decl later_sibling_call(child: symbol, dep: symbol)

later_sibling_call(child, dep) :- later_sibling_dep(child, dep, "call", _, _, _).
later_sibling_call(child, dep) :- after_tree_dep(child, dep, _, _, _).

// ── Supervisor management calls from init/1 ──────────────────────────
//
// Supervisor.start_child/2 and its relatives are GenServer.calls into
// the supervisor, and start_child does not return until the new child's
// init/1 has: an init that starts children has put those children's
// inits on the tree's startup path, and a child that calls back into
// the starter (or into anything the starter's tree has not reached yet)
// deadlocks the whole boot. Broadway's server fanned out four of these
// from init; Oban's Midwife started every queue from init. Reported for
// every management op, since terminate_child waits for a whole
// shutdown and which_children on the parent is the classic deadlock.
// One made after init/1's own ack (start_acked) no longer holds the
// start: the server is up, and nothing waits on its init/1.
blocks_on_peer(mod, "init", target, "sup", "", "", site, cat(api, ".", op)) :-
  init_function(mod, func),
  sup_management_call(site, func, api, op, target),
  !start_acked(site, func).

// Backwards from the supervisor calls, which are few, over what init's
// own process runs: a task init starts may wait on the supervisor. The
// logging and telemetry APIs are side paths (side_call, calls.dl): their
// machinery waits on its own servers, which call no process of the
// program's.
.init sup_reach = SameProcessReachCut

sup_reach.cut(f, g) :- side_call(f, g).
sup_reach.cut(f, g) :- acked_edge(f, g).

// A seed is a management call before its function's ack, as above.
sup_reach.seed(g, site) :- sup_management_call(site, g, _, _, _), !start_acked(site, g).

blocks_on_peer(mod, "init", target, "sup", "", "", site, cat(api, ".", op)) :-
  init_function(mod, func),
  sup_reach.reaches(func, site),
  sup_management_call(site, _, api, op, target).

// A handler of the server init/1 waits on that waits without a bound:
// evidence for a report, so only operations with no bound of their own
// count (unbounded_sup_op), and a synchronous call with :infinity
// (sync_call_site, whichever API spells it: GenServer, gen_statem,
// GenStage, Agent), which waits for as long as the callee takes.
// db_connection's fixed Watcher still start_childs from its handler —
// that is the design, not the bug. Every handler counts: a handle_info
// that blocks holds up the call init/1 makes as surely as a
// handle_call does.
//
// blocking's `answers_straight_away` is the dual, and differs on
// purpose: it suppresses an :infinity hop, so it must hold only of a
// handle_call/3 that provably answers at once, and every call it cannot
// vouch for (answers_in_time) counts as a wait. This word reports, so it
// holds only of a wait that provably has no bound.
.decl handler_blocks(mod: symbol, handler: symbol, op_site: symbol)

handler_blocks(mod, h, site) :-
  handler_function(mod, h),
  sup_management_call(site, h, _, op, _),
  unbounded_sup_op(op).

handler_blocks(mod, h, site) :-
  handler_function(mod, h),
  sup_reach.reaches(h, site),
  sup_management_call(site, _, _, op, _),
  unbounded_sup_op(op).

handler_blocks(mod, h, site) :-
  handler_function(mod, h),
  sync_call_site(site, h, _, -1).

.init infinite_call_reach = SameProcessReachCut

infinite_call_reach.cut(f, g) :- side_call(f, g).

infinite_call_reach.seed(g, site) :- sync_call_site(site, g, _, -1).

handler_blocks(mod, h, site) :-
  handler_function(mod, h),
  infinite_call_reach.reaches(h, site).

blocks_on_peer(mod, "init", dep, "blocking_server", "earlier", "", site, h) :-
  raw_sync_call_in_init(mod, dep),
  (init_safe_sibling(mod, dep) ; init_safe_cross_supervisor(mod, dep)),
  handler_blocks(dep, h, site).

// ── An unbounded socket receive on init's path ───────────────────────
//
// A connect-in-init (`sync_connect: true`) that reads its greeting with
// `:gen_tcp.recv(sock, n, :infinity)` blocks the supervisor's start —
// and whoever called start_child — for as long as the server is silent:
// hours, for a replication slot waiting on a checkpoint
// (elixir-ecto/postgrex#746). The timeout usually arrives through a
// wrapper's parameter (`msg_recv(s, :infinity, buffer)`), which
// call_arg_forward follows.
.decl infinite_recv_param(func: symbol, pos: number)

infinite_recv_param(g, p) :- call_arg_forward(g, ":gen_tcp:recv/3", 2, p).
infinite_recv_param(g, p) :- call_arg_forward(g, ":ssl:recv/3", 2, p).
infinite_recv_param(g, p) :- call_arg_forward(g, h, q, p), infinite_recv_param(h, q).

.decl infinite_recv(func: symbol)

infinite_recv(f) :- call_arg(f, ":gen_tcp:recv/3", 2, ":infinity").
infinite_recv(f) :- call_arg(f, ":ssl:recv/3", 2, ":infinity").
infinite_recv(f) :- remote_call(_, f, ":gen_tcp", "recv", 2).
infinite_recv(f) :- remote_call(_, f, ":ssl", "recv", 2).
infinite_recv(f) :- call_arg(f, g, pos, ":infinity"), infinite_recv_param(g, pos).

// Only what init's own process runs: a loop init spawns waits in its own
// process, and init returns without it; and not through a side path.
.init recv_reach = SameProcessReachCut

recv_reach.cut(f, g) :- side_call(f, g).
recv_reach.cut(f, g) :- acked_edge(f, g).

recv_reach.seed(f, f) :- infinite_recv(f).

init_effect(mod, "recv", r, site) :-
  init_function(mod, f),
  recv_reach.reaches(f, r),
  recv_site_or_empty(r, site).

// A `receive` with no `after` waits the same way, on the mailbox. How
// long depends on what its clauses take:
//
// - nothing that ends with a peer: it waits until the message comes,
//   forever if the sender is gone or never sends ("receive");
// - the exit signal of the process it waits on, pinned (`peer_bounded`):
//   the `:DOWN` of a monitor (recv_down, recv_signal "down"; gen's call,
//   code_server's, a hand-written request, a spawn_monitor's pair), or,
//   in a process that traps exits, the `:EXIT` of a process or port its
//   function links to (recv_signal "exit"; peer's init/1 closes the port
//   it opened and waits for that port's exit). If the peer is gone the
//   signal comes, but a peer that is alive and never answers holds the
//   start as long as it lives ("down"). An `:EXIT` clause in a process
//   that does not trap exits, or for a process nothing linked, never
//   fires, and bounds nothing;
// - a timer message cancel_timer/1 said was delivered (flush_receive,
//   clientlib/timer_flush.dl): no wait at all.
// The pinned signals are clientlib/receive.dl's down_bounded and
// exit_pinned.
.decl peer_bounded(id: symbol)

peer_bounded(id) :- down_bounded(id).

// init/1 traps exits, itself or in what it runs in its own process before
// its start is acknowledged: a flag set after the ack is not in effect
// for a wait before it.
.init trap_reach = SameProcessReachSetCut

trap_reach.cut(f, g) :- acked_edge(f, g).
trap_reach.seed(t) :- trap_exit(t, _).

.decl init_traps_exits(mod: symbol)

init_traps_exits(m) :- init_function(m, f), trap_reach.reaches(f).

.decl exit_bounded(mod: symbol, id: symbol)

exit_bounded(m, id) :-
  exit_pinned(id, _),
  init_function(m, _),
  init_traps_exits(m).

// Only what runs before the start is acknowledged holds the starter
// (acked_edge, clientlib/init_phase.dl): an init/1 that calls
// `:proc_lib.init_ack/1` and then enters its own loop waits there as the
// server it has become. An enter_loop reached before any ack is a
// finding of its own ("enter_loop", below).
.decl unbounded_wait_at(func: symbol, id: symbol)

unbounded_wait_at(f, id) :-
  recv_start(id, f, 1, _),
  !start_acked(id, f),
  !flush_receive(id).

.init receive_reach = SameProcessReachCut

receive_reach.cut(f, g) :- acked_edge(f, g).
receive_reach.cut(f, g) :- side_call(f, g).
receive_reach.seed(f, f) :- unbounded_wait_at(f, _).

// A wait that ends when its peer does is "down": a monitored peer's
// :DOWN (peer_bounded), or a linked peer's exit init/1 traps
// (exit_bounded). The rest wait on whatever the peer chooses to send.
init_effect(mod, "receive", r, id) :-
  init_function(mod, f),
  receive_reach.reaches(f, r),
  unbounded_wait_at(r, id),
  !peer_bounded(id),
  !exit_bounded(mod, id).

init_effect(mod, "down", r, id) :-
  init_function(mod, f),
  receive_reach.reaches(f, r),
  unbounded_wait_at(r, id),
  peer_bounded(id).

init_effect(mod, "down", r, id) :-
  init_function(mod, f),
  receive_reach.reaches(f, r),
  unbounded_wait_at(r, id),
  exit_bounded(mod, id).

// ── An init/1 that becomes the server before its start returns ──
//
// `:gen_server.enter_loop/3` (and gen_statem's) does not return: the
// process runs the server loop from there. A start waits on init/1 —
// GenServer's until it returns, proc_lib's until it calls init_ack — so
// an init/1 that reaches enter_loop before acknowledging its start holds
// its starter, and the supervisor's start, for good. A process started
// by a bare spawn of init/1 (`:proc_lib.spawn_link(M, :init, [args])`)
// has no starter waiting, and is left alone.
.decl enters_loop_at(func: symbol, id: symbol)

enters_loop_at(f, id) :-
  remote_call(id, f, m, "enter_loop", _),
  (m = ":gen_server" ; m = ":gen_statem"),
  !start_acked(id, f).

.init enter_reach = SameProcessReachCut

enter_reach.cut(f, g) :- acked_edge(f, g).
enter_reach.cut(f, g) :- side_call(f, g).
enter_reach.seed(f, f) :- enters_loop_at(f, _).

.decl spawned_bare(mod: symbol)

spawned_bare(m) :-
  spawn_call(_, _, m, "init", 1, v, _, _, _, _),
  (v = "spawn" ; v = "spawn_link" ; v = "spawn_monitor").

init_effect(mod, "enter_loop", r, id) :-
  init_function(mod, f),
  enter_reach.reaches(f, r),
  enters_loop_at(r, id),
  !spawned_bare(mod).

// The receive that waits: the recv call, the `receive`, or the call
// that forwards :infinity into a helper's recv.
.decl recv_site(func: symbol, id: symbol)

recv_site(f, id) :- call_site(id, f, ":gen_tcp", "recv", _).
recv_site(f, id) :- call_site(id, f, ":ssl", "recv", _).
recv_site(f, id) :- call_arg(f, g, pos, ":infinity"), infinite_recv_param(g, pos), call_instr(f, g, id).

// A receiving function with no such site of its own is anchored at the
// function, its site empty.
.decl recv_site_or_empty(func: symbol, site: symbol)

recv_site_or_empty(f, id) :- recv_site(f, id).
recv_site_or_empty(f, "") :- infinite_recv(f), !recv_site(f, _).

// One finding per receiving function; the inits that reach it are its
// evidence frames.
// `call` is the call in init/1 that starts its path to the receiving
// function (the earliest, when several do), or empty when init/1 is the
// receiving function or leaves through no call instruction.
.decl init_reaches_recv(mod: symbol, api: symbol, call: symbol)
.output init_reaches_recv

// The first step out of init/1 takes the walks' own cut: an edge taken
// only after init/1's ack (acked_edge) starts no path that holds the
// start.
.decl init_recv_step(mod: symbol, api: symbol, call: symbol)

init_recv_step(mod, r, call) :-
  init_effect(mod, "recv", r, _),
  init_function(mod, f),
  call_instr(f, g, call),
  !acked_edge(f, g),
  recv_reach.reaches(g, r).

init_recv_step(mod, r, call) :-
  init_effect(mod, kind, r, _),
  (kind = "receive" ; kind = "down"),
  init_function(mod, f),
  call_instr(f, g, call),
  !acked_edge(f, g),
  receive_reach.reaches(g, r).

.decl init_recv_stepped(mod: symbol, api: symbol)

init_recv_stepped(mod, r) :- init_recv_step(mod, r, _).

init_reaches_recv(mod, r, call) :- init_recv_step(mod, r, call).

init_reaches_recv(mod, r, "") :-
  init_effect(mod, kind, r, _),
  (kind = "recv" ; kind = "receive" ; kind = "down"),
  !init_recv_stepped(mod, r).

// ── A connection made in init/1 with no way to try again ─────────────
//
// A child that connects to an external dependency in init/1 and stops
// or raises when it cannot is restarted by its supervisor, immediately,
// until the intensity is spent — and then the tree, usually the whole
// application, goes down at boot because a dependency was slow to come
// up (tortoise#46, grpc-elixir#557, newrelic/elixir_agent#181,
// brod#666). The fixes all defer the connect to a timer or a
// handle_continue with backoff, which is what the rule looks for.
.decl connect_api(api: symbol)

connect_api(api) :- impure_call(_, _, api, "network", _), match(":gen_tcp.connect/.*", api).
connect_api(api) :- impure_call(_, _, api, "network", _), match(":ssl.connect/.*", api).
connect_api(api) :- impure_call(_, _, api, "network", _), match(":gen_udp.open/.*", api).
connect_api(api) :- impure_call(_, _, api, "network", _), match(":httpc.request/.*", api).

.init connect_reach = SameProcessReachCut

connect_reach.cut(f, g) :- side_call(f, g).

// Not cut at the ack: a connect after it still crashes the child a
// moment after its start returned when the peer is not up yet, and the
// supervisor restarts it at once, into the same crash, until the tree
// gives up. The ack moves the crash out of the start, not out of the
// restart loop.
connect_reach.seed(f, api) :- impure_call(_, f, api, "network", _), connect_api(api).

// A retry needs a way back in: a timer, a self-message, a
// handle_continue, or a gen_statem's own timeout (postgrex's connections
// arm {{:timeout, :backoff}, ms, nil}) — deferral_path, in startup.dl.
init_effect(mod, "connect", api, "") :-
  init_function(mod, f),
  connect_reach.reaches(f, api),
  !deferral_path(mod, _).

// ══ Start order ═════════════════════════════════════════════════════

// ── Anti-patterns ────────────────────────────────────────────────

// A child's init/1 depends on another process, and that process starts
// later under the same supervisor. A synchronous dependency that holds
// the start (init_dep "call": before the ack, on init/1's own stack) is a
// deadlock by construction: the supervisor cannot reach the dependency
// until this init returns. One in the startup window that does not hold
// it (init_window_dep, entries.dl: a cast, or a call after the ack or in
// what init/1 starts) runs against a process that is not alive yet: the
// cast is dropped, the call exits :noproc, as a handle_continue's does.
// One row per witness; the finding builders keep one per (child, dep)
// and the synchronous one wins.
.decl later_sibling_dep(child: symbol, dep: symbol, kind: symbol, sup: symbol, sup_site: symbol, witness: symbol)

later_sibling_dep(child, dep, kind, sup, sup_site, witness) :-
  supervisor_site(sup, sup_site),
  boots_before(sup, child, dep, _, _),
  init_dep(child, dep, kind, witness),
  child != dep.

later_sibling_dep(child, dep, kind, sup, sup_site, witness) :-
  supervisor_site(sup, sup_site),
  boots_before(sup, child, dep, _, _),
  init_window_dep(child, dep, kind, witness),
  child != dep.

blocks_on_peer(child, "init", dep, kind, "later", sup, sup_site, witness) :-
  later_sibling_dep(child, dep, kind, sup, sup_site, witness).

// ── A process the start function starts after the tree ───────────────
//
// The same deadlock one level up: a function starts a tree
// (`Supervisor.start_link(children, opts)`, an Application's start/2)
// and then, once it returns, starts D itself (post_start_call). A child
// C of the tree whose init/1 holds its start on D (init_dep "call") runs
// inside that start_link, before D's start: the call exits :noproc, C
// fails, the tree fails, and the application with it. Two supervision
// trees are not "already running" for each other by being two: the
// start function's own order places them. `start` is the start
// function, `site` its call that starts D.
.decl after_tree_dep(child: symbol, dep: symbol, start: symbol, site: symbol, witness: symbol)

after_tree_dep(child, dep, s, site, witness) :-
  supervisor_site(sup, t),
  call_site(t, s, "Supervisor", "start_link", _),
  boot_subtree(sup, _, child),
  post_start_call(s, site, callee),
  function_def(callee, dep, "start_link", _, _),
  init_dep(child, dep, "call", witness),
  child != dep.

blocks_on_peer(child, "init", dep, "call", "after_tree", s, site, witness) :-
  after_tree_dep(child, dep, s, site, witness).

// ══ Deferred startup: handle_continue ═══════════════════════════════
//
// A.handle_continue sync-calls B AND B.handle_continue sync-calls A is
// a call cycle in the continue phase, reported by blocking's call_cycle.

// ── Pattern 2: handle_continue calls later-started sibling ───────────

blocks_on_peer(caller, "continue", callee, "call", "later", sup, site, "") :-
  boots_before(sup, caller, callee, _, _),
  continue_wait(caller, callee, site).

// ── Pattern 3: handle_continue calls back into parent supervisor ─────

// The worker's handle_continue calls its parent supervisor (a
// Supervisor query or management function) while the parent is still
// mid-start_link, starting the children after the worker, and not
// reading its mailbox. The worker blocks until the rest of the child
// list is up, and a later child that waits on it deadlocks the boot.
// The worker's last-child case is quiet: its init returning is the
// supervisor's last wait. Supervisor.which_children and the other
// management calls are sup_calls, not sync calls: they are read on the
// continue's own stack (sup_reach), the call their site.
.decl continues_on_stack(worker: symbol, site: symbol, sup: symbol, detail: symbol)

continues_on_stack(worker, site, sup, cat(api, ".", op)) :-
  init_continues_to(worker, _),
  handle_continue_clause(worker, _, f),
  sup_management_call(site, f, api, op, sup).

continues_on_stack(worker, site, sup, cat(api, ".", op)) :-
  init_continues_to(worker, _),
  handle_continue_clause(worker, _, f),
  sup_reach.reaches(f, site),
  sup_management_call(site, _, api, op, sup).

// A child starts after the worker: one the list shows at a later
// position, or one it may not show. A list the extractor cannot read to
// its end (supervisor_children_open: an element from
// Supervisor.child_spec/2 of a spec it does not read, a list appended
// from config) may hold a later child anywhere; only a closed list's
// last child is known to be last.
.decl has_later_sibling(sup: symbol, worker: symbol)

has_later_sibling(sup, worker) :- boots_before(sup, worker, _, _, _).

has_later_sibling(sup, worker) :-
  supervisor_children_open(sup),
  supervisor_child(sup, _, worker, _, _).

blocks_on_peer(worker, "continue", sup, "parent", "parent", sup, site, detail) :-
  continues_on_stack(worker, site, sup, detail),
  supervisor(sup, _),
  supervisor_child(sup, _, worker, _, _),
  has_later_sibling(sup, worker).

// The same call made by init/1 after it acknowledges its start
// (acked_on_stack): the supervisor has moved on to the later children
// and reads no mailbox until they are up, as it does while a
// handle_continue runs. Not the start's hold, which ended at the ack.
.decl acked_on_stack(worker: symbol, site: symbol, sup: symbol, detail: symbol)

.init after_ack = ForwardSameProcessReachCut

after_ack.cut(f, g) :- side_call(f, g).
after_ack.root(i, g) :- before_ack.reaches(i, f), acked_edge(f, g).

acked_on_stack(worker, site, sup, cat(api, ".", op)) :-
  init_function(worker, i),
  before_ack.reaches(i, f),
  sup_management_call(site, f, api, op, sup),
  start_acked(site, f).

acked_on_stack(worker, site, sup, cat(api, ".", op)) :-
  init_function(worker, i),
  after_ack.reaches(i, g),
  sup_management_call(site, g, api, op, sup).

blocks_on_peer(worker, "acked", sup, "parent", "parent", sup, site, detail) :-
  acked_on_stack(worker, site, sup, detail),
  supervisor(sup, _),
  supervisor_child(sup, _, worker, _, _),
  has_later_sibling(sup, worker).

// A plain synchronous call on the supervisor's name (a GenServer.call
// the call resolution sees) reaches the same mailbox.
blocks_on_peer(worker, "continue", sup, "parent", "parent", sup, site, "") :-
  continue_wait(worker, sup, site),
  supervisor(sup, _),
  supervisor_child(sup, _, worker, _, _),
  has_later_sibling(sup, worker).

// ── Defensive variant: try/catch wraps the call ──────────────────────

// Any try in the handle_continue of a pattern 2 caller is reported as a
// crash-loop risk on top of it: the catch suppresses the literal
// deadlock, but the supervisor's restart loop is still a bug.
.decl try_in_handle_continue(mod: symbol)

// try_start carries its containing function and its kind ("try" or the
// older "catch"), so both syntaxes are one rule and neither needs to join
// `instruction` — 343k rows on a real project, rewritten on every body
// edit — purely to recover the function an instruction sits in.
try_in_handle_continue(mod) :-
  handle_continue_clause(mod, _, func),
  try_start(_, func, _, _).

deferral_defect(worker, "continue_catch", "", sup) :-
  blocks_on_peer(worker, "continue", _, "call", "later", sup, _, _),
  try_in_handle_continue(worker).

// ── Init timeout used as a deferral ───────────────────────────────────
//
// {:ok, state, 0} from init/1 is the pre-handle_continue idiom for "do
// the rest after the supervisor moves on": the :timeout message arrives
// as soon as the mailbox is otherwise empty. The catch is in that
// clause. A timeout is cancelled by any message arriving first, and an
// init that opened an active socket, subscribed to a PubSub, or was
// handed a message by its starter has already arranged for one.
// libcluster's Gossip strategy lost its deferred connect this way to
// the first UDP datagram. Any integer works the same; 0 is the one that
// is unmistakably a deferral.
deferral_defect(mod, "init_timeout", site, to_string(ms)) :-
  init_function(mod, func),
  callback_timeout(site, func, "init", ms).

// ══ Distributed operations in init/1 ════════════════════════════════

// ── A :global lock in init/1 ─────────────────────────────────────

// The worst case: a :global lock that retries until it is granted
// (lock_until_granted, clientlib/vocabulary.dl), held from supervisor
// startup — in init/1, or in anything init/1 runs on its own stack or
// waits for (global_path, clientlib/global_reach.dl). The supervisor
// waits on the lock, and the lock waits on the nodes in its list: every
// connected node when `dep` is "cluster", only this node's global server
// when it is "local" (it still waits forever on a local holder), and
// "unknown" when the list is not in the bytecode. A retry count the
// bytecode does not show is assumed :infinity, the default the wrappers
// forward, and the row says so by its kind ("global_assumed"). `lock` is
// the :global call itself, in whichever function holds it (init/1
// included). One row per site — finding builders dedupe on (func,
// nodes, op).
blocks_on_peer(init, "init", nodes, "global", "", "", lock, op) :-
  lock_during_init(init, lock),
  global_op(lock, _, op, "infinity", nodes).

blocks_on_peer(init, "init", nodes, "global_assumed", "", "", lock, op) :-
  lock_during_init(init, lock),
  global_op(lock, _, op, "dynamic", nodes).

.decl lock_during_init(init: symbol, lock: symbol)

lock_during_init(init, lock) :-
  is_init(init),
  reaches_in_same_process(init, lock),
  retries_until_locked(lock).

// A lock with a positive retry count gives up and returns false, after
// backoff that OTP caps at 8 s a try. Over [node()] that is the fix the
// "local" finding recommends, and is quiet. Over other nodes each try
// still asks every one of them, and a partitioned node holds a try until
// the node is declared down, so the start waits for a bounded but
// possibly long time: reported one severity below the other kinds, as
// "global_bounded".
blocks_on_peer(init, "init", nodes, "global_bounded", "", "", lock, op) :-
  bounded_lock_during_init(init, lock),
  bounded_lock(lock, _, op, _, nodes).

.decl bounded_lock_during_init(init: symbol, lock: symbol)

bounded_lock_during_init(init, lock) :-
  is_init(init),
  reaches_in_same_process(init, lock),
  gives_up_after_retries(lock),
  waits_on_other_nodes(lock).

// `func` is on the stack when the :global call at `site` runs: the calls
// that stay in the calling process, entering only the clauses a literal
// first argument matches, and the tasks it awaits (global_path).
.decl reaches_in_same_process(func: symbol, site: symbol) inline

reaches_in_same_process(f, site) :- global_path(f, _, site).

// A :global call that retries until it is granted (lock_until_granted).
.decl retries_until_locked(site: symbol) inline

retries_until_locked(site) :- lock_until_granted(site, _, _, _, _).

// A :global call that retries a bounded number of times (bounded_lock).
.decl gives_up_after_retries(site: symbol) inline

gives_up_after_retries(site) :- bounded_lock(site, _, _, _, _).

// Its node list holds other nodes, or may (not "local").
.decl waits_on_other_nodes(site: symbol) inline

waits_on_other_nodes(site) :- global_op(site, _, _, _, nodes), nodes != "local".

// A lock during init, of any kind reported above.
.decl init_lock(init: symbol, lock: symbol)

init_lock(init, lock) :- lock_during_init(init, lock).
init_lock(init, lock) :- bounded_lock_during_init(init, lock).

// Where init/1's path to a lock in a helper starts: the call in init/1
// whose callee, on init's own stack, reaches the lock (or the Task.async
// whose task init/1 awaits). The finding's "init/1 reaches it from here"
// frame points at that call; a path that leaves init/1 through something
// with no call instruction (a closure it runs, a fun it applies) points
// at init/1 itself, `call` empty — unless the lock is in an anonymous
// function written inside init/1, whose line the finding's anchor
// already is. The earliest such call is kept (the relation's
// `earliest`).
.decl init_lock_path(init: symbol, lock: symbol, call: symbol)
.output init_lock_path

.decl init_lock_step(init: symbol, lock: symbol, call: symbol)

init_lock_step(init, lock, call) :-
  init_lock(init, lock),
  global_path(init, call, lock),
  call != "",
  call != lock.

.decl init_lock_stepped(init: symbol, lock: symbol)

init_lock_stepped(init, lock) :- init_lock_step(init, lock, _).

init_lock_path(init, lock, call) :- init_lock_step(init, lock, call).

init_lock_path(init, lock, "") :-
  init_lock(init, lock),
  global_op(lock, holder, _, _, _),
  holder != init,
  !lock_in_init_closure(init, lock),
  !init_lock_stepped(init, lock).

// The lock is in an anonymous function written inside init/1
// (`M:-init/1-fun-0-/1`): its line is inside init/1's own source.
.decl lock_in_init_closure(init: symbol, lock: symbol)

lock_in_init_closure(init, lock) :-
  init_lock(init, lock),
  global_op(lock, holder, _, _, _),
  function_def(init, m, n, a, _),
  contains(cat(m, ":-", n, "/", to_string(a), "-fun-"), holder).

// ── Distributed operations in init ───────────────────────────────

// RPC or global ops in init/1 block supervisor startup.
//
// init_function comes from the clientlib: init/1 in a behaviour module.
// Only those init/1 functions run under a supervisor at start time — a
// plain module's init/1 is an ordinary function and must not be flagged.

// site is the distributed-op instruction inside init. One row per
// site — finding builders dedupe on (func, op).
//
// An rpc is followed as a :global lock is: in init/1, or in anything
// init/1 calls on its own stack, `func` being init/1 (rpc_during_init,
// clientlib/init_phase.dl). blocking leaves out the same sites (its
// during_init reads the same walk), so a helper's rpc holding the start
// is reported here, once.
blocks_on_peer(init, "init", "", "remote", "", "", id, op) :-
  rpc_during_init(init, id),
  rpc_call(id, _, op, _).

// Each operation below holds the start only before init/1's own ack
// (start_acked): after it, the starter has its answer.
blocks_on_peer(func, "init", "", "remote", "", "", id, op) :-
  global_register(id, func, _, _),
  init_function(_, func),
  !start_acked(id, func),
  op = "global_register".

// Node operations in init — exclude the non-blocking ops that return
// immediately: Node.list ("list"), Node.monitor ("monitor"), and
// :net_kernel.monitor_nodes ("monitor_nodes" — a subscription flag, not
// a connection attempt).
blocks_on_peer(func, "init", "", "remote", "", "", id, op) :-
  node_operation(id, func, op),
  init_function(_, func),
  !start_acked(id, func),
  op != "list",
  op != "monitor",
  op != "monitor_nodes".

blocks_on_peer(func, "init", "", "remote", "", "", id, op) :-
  distributed_store_op(id, func, _, op),
  init_function(_, func),
  !start_acked(id, func).

// ══ After the tree is up ════════════════════════════════════════════

// ── Initialization after the tree is up ──────────────────────────────
//
// Children start serving the moment Supervisor.start_link returns. State
// they read — a persistent_term, an ETS row, an application env — that
// the caller writes only afterwards is a window in which they run against
// nothing (phoenixframework/phoenix#5981: the endpoint's warmup after the
// listener was accepting). Writes reached from a call after start_link.
.init config_reach = CallReachSet

config_reach.seed(f) :- config_writer(f).

.decl post_start_initialization(func: symbol, site: symbol, callee: symbol, start: symbol)
.output post_start_initialization

post_start_initialization(func, site, callee, start) :-
  post_start_call(func, site, callee),
  config_write_api(callee),
  start_link_site_or_empty(func, start).

post_start_initialization(func, site, callee, start) :-
  post_start_call(func, site, callee),
  config_reach.reaches(callee),
  start_link_site_or_empty(func, start).

// The Supervisor.start_link the write comes after; a start spelled
// another way leaves the frame out (its site empty).
.decl start_link_site_or_empty(func: symbol, site: symbol)

start_link_site_or_empty(f, id) :- call_site(id, f, "Supervisor", "start_link", _).
start_link_site_or_empty(f, "") :- post_start_call(f, _, _), !call_site(_, f, "Supervisor", "start_link", _).

// ── Ignored start results ────────────────────────────────────────

// GenServer/Supervisor start result not checked.
//
// callee is rendered as "Mod.func/arity", so the function name is
// always preceded by "." and followed by "/" — matching the delimited
// name keeps a callee like "Mod.restart_link/1" from substring-matching
// "start_link".
//
// NOTE Souffle's contains(needle, haystack) takes the needle FIRST. The
// rule originally wrote contains(callee, "start_link") — "is the callee
// a substring of 'start_link'" — which is false for every real callee,
// so this relation had never produced a single row.
.decl ignored_start_result(func: symbol, callee: symbol)
.output ignored_start_result

ignored_start_result(func, callee) :-
  ignored_error_result(_, func, callee),
  (contains(".start_link/", callee) ; contains(".start/", callee)).

// ══ A wait whose peer answers, when priors are on ═══════════════════
//
// A receive the model is sure waits on something inside the node that
// always answers (Argus.Priors.Questions.PeerAnswers; off by default):
// a reply from code_server or a file or io server, a runtime driver, the
// exit of a child it has just stopped. The start still waits, but on an
// answer that comes; the finding steps down and says so. One that waits
// on another node, an external program or a message that may never be
// sent keeps its severity. 0.8, as in blocking.
.decl answering_wait(func: symbol, permille: number)

answering_wait(r, p) :- prior_answers("wait", r, _, _, p), p >= 800.

.decl answered_effect(kind: symbol, api: symbol)

answered_effect(k, r) :-
  init_effect(_, k, r, _),
  (k = "receive" ; k = "down"),
  answering_wait(r, _).

unbounded_effect_in_init(m, k, r, s, "local", p) :-
  init_effect(m, k, r, s),
  (k = "receive" ; k = "down"),
  answering_wait(r, p).

unbounded_effect_in_init(m, k, r, s, "", 0) :-
  init_effect(m, k, r, s),
  !answered_effect(k, r).
