// Work in a phase whose invariants do not hold yet.
//
// init/1 runs inside the supervisor's start sequence: a synchronous
// call from it to a sibling that starts later is a deadlock by
// construction, a call to any peer stalls the tree, a connect with no
// way to retry crash-loops the child until the tree gives up, a
// cluster-wide lock hangs the boot on a partition. handle_continue runs
// after init returns but before any message, so its own races and
// cycles are startup's too. And state written after
// Supervisor.start_link returned is written after the children are
// already serving.

.include "../clientlib/imports.dl"
.include "../clientlib/otp.dl"
.include "../clientlib/process_statem.dl"
.include "../clientlib/resolved_calls.dl"
.include "../clientlib/vocabulary.dl"
.include "../clientlib/global_reach.dl"
.include "../clientlib/order.dl"
.include "../clientlib/trapping.dl"
.include "../clientlib/timer_flush.dl"
.include "../clientlib/tooling.dl"

// A finding in code only developers' tools or tests run steps down a
// level (clientlib/tooling.dl, Argus.Findings.Tooling).
.output tooling

// ══ The outputs ═════════════════════════════════════════════════════
//
// `blocks_on_peer(mod, phase, dep, kind, ordering, sup, site, detail)` —
//   a phase waits on a peer. `phase` is "init" or "continue"; `kind`
//   says how: "call" (a synchronous call; `detail` is "conditional" or
//   "unconditional" when the ordering is unknown), "cast" (a one-way
//   dependency on a later sibling), "sup" (a supervisor management call;
//   `detail` is api.op, `dep` the target), "blocking_server" (the callee
//   runs but its handler `detail` blocks at `site`), "parent" (a
//   handle_continue calls its own supervisor), "global" (a :global lock
//   that retries until it is granted; `detail` is the op, `dep` the nodes
//   it waits on: "cluster", "local" or "unknown"), "global_assumed" (the
//   same, with a retry count the bytecode does not show, assumed
//   :infinity), "global_bounded" (a lock over other nodes that gives up
//   after a positive retry count) or "remote" (an rpc, a node
//   operation, a distributed store; `detail` is the op). `ordering` is where the peer
//   starts relative to this child under `sup`: "later" (a deadlock by
//   construction, or a race from handle_continue), "earlier",
//   "parent", "unknown" (no tree places both), or empty. `site` anchors
//   the tree definition for a later sibling, the call otherwise.
// `unbounded_effect_in_init(mod, kind, api)` — init/1, in its own
//   process, reaches a socket receive with :infinity ("recv"; `api` is
//   the function), a `receive` with no `after` ("receive"), one only the
//   exit of the process it waits on ends ("down"), a server loop entered
//   before the start is acknowledged ("enter_loop"; `api` holds the
//   call), or a connect with no way to retry ("connect").
// `deferral_defect(mod, kind, site, detail)` — deferred work that will
//   not happen as written: an init timeout of `detail` ms that any
//   earlier message cancels ("init_timeout"), or a defensive catch in
//   handle_continue that turns a deadlock into a restart loop under the
//   supervisor `detail` ("continue_catch").
.decl blocks_on_peer(mod: symbol, phase: symbol, dep: symbol, kind: symbol, ordering: symbol, sup: symbol, site: symbol, detail: symbol)
.output blocks_on_peer

// With priors on, a "receive" or "down" wait carries `peer` ("local")
// and `permille` when the model is sure what it waits on answers from
// inside the node (below); else "" and 0.
.decl unbounded_effect_in_init(mod: symbol, kind: symbol, api: symbol, site: symbol, peer: symbol, permille: number)
.output unbounded_effect_in_init

// What the rules below find, before a prior says whether the peer answers.
.decl init_effect(mod: symbol, kind: symbol, api: symbol, site: symbol)

.decl deferral_defect(mod: symbol, kind: symbol, site: symbol, detail: symbol)
.output deferral_defect

// ══ What holds the start ════════════════════════════════════════════
//
// init/1 runs inside its starter's start (a supervisor's, or whoever
// called start_child), and the start returns when init/1 acknowledges it:
// by returning, or by `:proc_lib.init_ack/1,2`, after which what init/1
// runs is the server's (acked_edge, clientlib/init_phase.dl). What init/1
// runs on its own stack before that, the start waits on.

// `init` is init/1 of a process module, and `what` runs on its own stack
// before it acknowledges its start, so its supervisor's start waits while
// `what` runs: a supervisor call, an rpc or another distributed operation
// (sites), or a function that reads a socket, waits in a receive or enters
// a server loop.
.decl holds_start(init: symbol, what: symbol)

holds_start(init, what) :- is_init(init), own_stack.reaches(init, what).

// An rpc in init/1 or in anything it calls on its own stack
// (rpc_during_init, clientlib/init_phase.dl: blocking reads the same walk
// and leaves these sites out, so a helper's rpc holding the start is
// reported here, once).
holds_start(init, rpc) :- rpc_during_init(init, rpc).

// A distributed operation init/1 makes itself. Only an rpc (above) is
// followed into the helpers init/1 calls; a :global registration, a node
// operation or a store operation in a helper is not seen.
holds_start(init, op) :-
  is_init(init),
  distributed_operation(op, init, _),
  !start_acked(op, init).

// What a function runs on its own stack: calls that stay in its process
// (not what a spawn, task or agent runs), not through the logging and
// telemetry APIs (side_call, calls.dl: their machinery waits on its own
// servers, which call no process of the program's), and not after it
// acknowledged its start (acked_edge): OwnStackBeforeAck,
// clientlib/init_phase.dl, the walk rpc_during_init takes. Walked
// backwards from the few things a start can wait on: a supervisor call
// made before its own function's ack, and the functions that read a
// socket without a timeout, wait in a receive with no `after`, or enter a
// server loop.
.init own_stack = OwnStackBeforeAck

own_stack.seed(g, site) :- sup_management_call(site, g, _, _, _), !start_acked(site, g).
own_stack.seed(f, f) :- reads_socket_without_timeout(f).
own_stack.seed(f, f) :- receives_without_timeout(f, _).
own_stack.seed(f, f) :- enters_loop_at(f, _).

// ══ Synchronous calls from init/1 ═══════════════════════════════════

// An init/1 waits on a synchronous call to a process that no supervision
// tree is known to have started first, so its supervisor's start waits on
// a process that may not be there.
.decl call_to_unplaced_peer_during_init(mod: symbol, peer: symbol)

call_to_unplaced_peer_during_init(mod, peer) :-
  calls_during_init(mod, peer),
  !already_running(mod, peer),
  !later_sibling_call(mod, peer).

// mod's init/1 holds its start on a synchronous call to `peer`: on its own
// stack, before it acknowledges its start (init_dep "call",
// clientlib/entries.dl).
.decl calls_during_init(mod: symbol, peer: symbol)

calls_during_init(mod, peer) :- init_dep(mod, peer, "call", _).

// The peer is running when mod's init/1 calls it: it starts earlier under
// the same supervisor, or under another supervision tree.
.decl already_running(mod: symbol, peer: symbol)

already_running(mod, peer) :- init_safe_sibling(mod, peer).
already_running(mod, peer) :- init_safe_cross_supervisor(mod, peer).

// The call is to a sibling that starts later (later_sibling_dep) or to a
// process the start function starts only after the tree (after_tree_dep):
// "Start order" below reports it once, with the tree ordering, as the
// deadlock it is, not also as a call of unknown place beside it.
.decl later_sibling_call(child: symbol, dep: symbol)

later_sibling_call(child, dep) :- later_sibling_dep(child, dep, "call", _, _, _).
later_sibling_call(child, dep) :- after_tree_dep(child, dep, _, _, _).

// ── Supervision-aware filtering ────────────────────────────────────────

// True when both modules appear under a common supervisor's subtree.
.decl shares_supervisor(child: symbol, dep: symbol)

shares_supervisor(child, dep) :-
  child_subtree(sup, _, child),
  child_subtree(sup, _, dep),
  child != dep.

// A module with a behaviour and start_link/1 is very likely supervised,
// even when we can't statically determine which supervisor owns it.
.decl likely_supervised(mod: symbol)

likely_supervised(mod) :- child_subtree(_, _, mod).

likely_supervised(mod) :-
  behaves_as(mod, _),
  function_def(_, mod, "start_link", 1, _).

// The callee starts earlier under the same supervisor, so it is running
// when this init runs.
.decl init_safe_sibling(child: symbol, dep: symbol)

init_safe_sibling(child, dep) :-
  calls_during_init(child, dep),
  starts_before(_, dep, child, _, _).

// Both likely supervised but under disjoint supervisor trees — callee
// is already running because it was started by a different supervisor.
// At least one must be provably supervised (in a child_subtree) to
// prevent false negatives when no supervision facts exist at all.
.decl init_safe_cross_supervisor(child: symbol, dep: symbol)

init_safe_cross_supervisor(child, dep) :-
  calls_during_init(child, dep),
  child_subtree(_, _, child),
  likely_supervised(dep),
  !shares_supervisor(child, dep).

init_safe_cross_supervisor(child, dep) :-
  calls_during_init(child, dep),
  likely_supervised(child),
  child_subtree(_, _, dep),
  !shares_supervisor(child, dep).

// ── Conditional paths ──────────────────────────────────────────────────

// The dependency holds on every path through init: the first hop out of
// init is not control-dependent on a branch.
.decl unconditional_sync_call_in_init(mod: symbol, callee: symbol)

// The call making the dependency is itself unconditional — not some
// other GenServer.call in init. A call made after init/1's own ack
// (start_acked), or an edge taken only after it (acked_edge), no longer
// holds the start: it cannot make the start's wait unconditional.
unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  sync_site(func, callee, id),
  !conditional_call(id),
  !start_acked(id, func).

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  tag_resolved_site(id, func, "call", callee),
  sync_call_site(id, func, t, _),
  unresolved_target(t),
  !conditional_call(id),
  !start_acked(id, func).

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  unconditional_call_edge(func, g),
  !acked_edge(func, g),
  reaches_sync_dep(g, callee).

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  unconditional_call_edge(func, g),
  !acked_edge(func, g),
  genserver_sync_api(g, callee),
  mod != callee.

// ── Where init/1 waits ─────────────────────────────────────────────────
//
// The call in init/1, before it acknowledges its start, on the way to
// the wait on `callee`: the GenServer.call itself (or the tag-attributed
// call on a pid it holds), or the call into the helper or client API
// that makes it. A finding anchored at init/1 lands on its head, often
// tens of lines above the call. An unconditional site is preferred where
// init has one: the call that makes the finding "unconditional". Empty
// when init/1 makes no call of its own on the way (a closure it hands
// on), and the finding falls back to the function.
.decl init_wait_site(mod: symbol, callee: symbol, site: symbol)

init_wait_site(mod, callee, id) :-
  calls_during_init(mod, callee),
  init_function(mod, f),
  sync_site(f, callee, id),
  !start_acked(id, f).

init_wait_site(mod, callee, id) :-
  calls_during_init(mod, callee),
  init_function(mod, f),
  tag_resolved_site(id, f, "call", callee),
  !start_acked(id, f).

init_wait_site(mod, callee, id) :-
  calls_during_init(mod, callee),
  init_function(mod, f),
  call_instr(f, g, id),
  !start_acked(id, f),
  !side_call(f, g),
  reaches_sync_dep(g, callee).

// A task init/1 awaits (awaits_task): the wait is at its start.
init_wait_site(mod, callee, id) :-
  calls_during_init(mod, callee),
  init_function(mod, f),
  awaits_task(f, id, g),
  !start_acked(id, f),
  reaches_sync_dep(g, callee).

.decl init_waits_unconditionally_at(mod: symbol, callee: symbol)

init_waits_unconditionally_at(mod, callee) :-
  init_wait_site(mod, callee, id),
  !conditional_call(id).

.decl init_wait(mod: symbol, callee: symbol, site: symbol)

init_wait(mod, callee, id) :- init_wait_site(mod, callee, id), !conditional_call(id).

init_wait(mod, callee, id) :-
  init_wait_site(mod, callee, id),
  !init_waits_unconditionally_at(mod, callee).

init_wait(mod, callee, "") :-
  calls_during_init(mod, callee),
  !init_wait_site(mod, callee, _).

// ── The report ─────────────────────────────────────────────────────────

// `detail` is "unconditional" when some path from init to the call runs
// on every init, "conditional" when every path goes through a call site
// in init that a branch guards (postgrex's `sync_connect: true`, goth's
// `prefetch: :sync`).
blocks_on_peer(mod, "init", peer, "call", "unknown", "", site, "unconditional") :-
  call_to_unplaced_peer_during_init(mod, peer),
  unconditional_sync_call_in_init(mod, peer),
  init_wait(mod, peer, site).

blocks_on_peer(mod, "init", peer, "call", "unknown", "", site, "conditional") :-
  call_to_unplaced_peer_during_init(mod, peer),
  !unconditional_sync_call_in_init(mod, peer),
  init_wait(mod, peer, site).

// ── Supervisor management calls from init/1 ──────────────────────────
//
// Supervisor.start_child/2 and its relatives are GenServer.calls into
// the supervisor, and start_child does not return until the new child's
// init/1 has: an init that starts children has put those children's
// inits on the tree's startup path, and a child that calls back into
// the starter (or into anything the starter's tree has not reached yet)
// deadlocks the whole boot. Broadway's server fanned out four of these
// from init; Oban's Midwife started every queue from init. Reported for
// every management op, since terminate_child waits for a whole
// shutdown and which_children on the parent is the classic deadlock.

// An init/1 calls into a supervisor before it acknowledges its start, so
// its own start waits on that supervisor and on the init/1 of every child
// the call starts.
.decl supervisor_call_during_init(mod: symbol, call: symbol)

supervisor_call_during_init(mod, call) :-
  init_function(mod, init),
  holds_start(init, call),
  manages_supervisor(call).

// The call is Supervisor.start_child/2 or one of its relatives, a
// GenServer.call into a supervisor (sup_management_call,
// clientlib/supervision.dl).
.decl manages_supervisor(call: symbol) inline

manages_supervisor(call) :- sup_management_call(call, _, _, _, _).

blocks_on_peer(mod, "init", target, "sup", "", "", call, cat(api, ".", op)) :-
  supervisor_call_during_init(mod, call),
  sup_management_call(call, _, api, op, target).

// ── A server that blocks in its handler ────────────────────────────────

// An init/1 calls a server that is already running, and a handler of
// that server can wait without a bound, so the call, and the start, wait
// as long as the handler does.
.decl call_to_blocking_server_during_init(mod: symbol, server: symbol, handler: symbol, wait: symbol)

call_to_blocking_server_during_init(mod, server, handler, wait) :-
  calls_during_init(mod, server),
  already_running(mod, server),
  handler_blocks(server, handler, wait).

blocks_on_peer(mod, "init", server, "blocking_server", "earlier", "", wait, handler) :-
  call_to_blocking_server_during_init(mod, server, handler, wait).

// A handler of the server init/1 waits on that waits without a bound:
// evidence for a report, so only operations with no bound of their own
// count (unbounded_sup_op), and a synchronous call with :infinity
// (sync_call_site, whichever API spells it: GenServer, gen_statem,
// GenStage, Agent), which waits for as long as the callee takes.
// db_connection's fixed Watcher still start_childs from its handler —
// that is the design, not the bug. Every handler counts: a handle_info
// that blocks holds up the call init/1 makes as surely as a
// handle_call does.
//
// blocking's `answers_straight_away` is the dual, and differs on
// purpose: it suppresses an :infinity hop, so it must hold only of a
// handle_call/3 that provably answers at once, and every call it cannot
// vouch for (answers_in_time) counts as a wait. This word reports, so it
// holds only of a wait that provably has no bound.
.decl handler_blocks(mod: symbol, handler: symbol, op_site: symbol)

handler_blocks(mod, h, site) :-
  handler_function(mod, h),
  sup_management_call(site, h, _, op, _),
  unbounded_sup_op(op).

handler_blocks(mod, h, site) :-
  handler_function(mod, h),
  own_stack.reaches(h, site),
  sup_management_call(site, _, _, op, _),
  unbounded_sup_op(op).

handler_blocks(mod, h, site) :-
  handler_function(mod, h),
  sync_call_site(site, h, _, -1).

.init infinite_call_reach = SameProcessReachCut

infinite_call_reach.cut(f, g) :- side_call(f, g).

infinite_call_reach.seed(g, site) :- sync_call_site(site, g, _, -1).

handler_blocks(mod, h, site) :-
  handler_function(mod, h),
  infinite_call_reach.reaches(h, site).

// ── An unbounded socket receive on init's path ───────────────────────
//
// A connect-in-init (`sync_connect: true`) that reads its greeting with
// `:gen_tcp.recv(sock, n, :infinity)` blocks the supervisor's start —
// and whoever called start_child — for as long as the server is silent:
// hours, for a replication slot waiting on a checkpoint
// (elixir-ecto/postgrex#746).

// An init/1 reads a socket with no timeout before it acknowledges its
// start, so its supervisor's start waits for as long as the peer stays
// silent.
.decl socket_read_during_init(mod: symbol, reader: symbol)

socket_read_during_init(mod, reader) :-
  init_function(mod, init),
  holds_start(init, reader),
  reads_socket_without_timeout(reader).

// The function reads a socket with :infinity: given literally, by the
// two-argument form, or handed down as :infinity through a wrapper's
// parameter (`msg_recv(s, :infinity, buffer)`, infinite_recv_param).
.decl reads_socket_without_timeout(func: symbol)

reads_socket_without_timeout(f) :- call_arg(f, ":gen_tcp:recv/3", 2, ":infinity").
reads_socket_without_timeout(f) :- call_arg(f, ":ssl:recv/3", 2, ":infinity").
reads_socket_without_timeout(f) :- remote_call(_, f, ":gen_tcp", "recv", 2).
reads_socket_without_timeout(f) :- remote_call(_, f, ":ssl", "recv", 2).

reads_socket_without_timeout(f) :-
  call_arg(f, g, pos, ":infinity"),
  infinite_recv_param(g, pos).

// The wrapper's parameter at `pos` is the timeout of a socket recv it
// makes, or hands on to a wrapper that does (call_arg_forward).
.decl infinite_recv_param(func: symbol, pos: number)

infinite_recv_param(g, p) :- call_arg_forward(g, ":gen_tcp:recv/3", 2, p).
infinite_recv_param(g, p) :- call_arg_forward(g, ":ssl:recv/3", 2, p).
infinite_recv_param(g, p) :- call_arg_forward(g, h, q, p), infinite_recv_param(h, q).

init_effect(mod, "recv", reader, site) :-
  socket_read_during_init(mod, reader),
  recv_site_or_empty(reader, site).

// ── A receive with no `after` on init's path ─────────────────────────
//
// A `receive` with no `after` waits the same way, on the mailbox. How
// long depends on what its clauses take:
//
// - nothing that ends with a peer: it waits until the message comes,
//   forever if the sender is gone or never sends ("receive");
// - the exit signal of the process it waits on, pinned (ends_with_peer):
//   the `:DOWN` of a monitor (recv_down, recv_signal "down"; gen's call,
//   code_server's, a hand-written request, a spawn_monitor's pair), or,
//   in a process that traps exits, the `:EXIT` of a process or port its
//   function links to (recv_signal "exit"; peer's init/1 closes the port
//   it opened and waits for that port's exit). If the peer is gone the
//   signal comes, but a peer that is alive and never answers holds the
//   start as long as it lives ("down"). An `:EXIT` clause in a process
//   that does not trap exits, or for a process nothing linked, never
//   fires, and bounds nothing;
// - a timer message cancel_timer/1 said was delivered (flush_receive,
//   clientlib/timer_flush.dl): no wait at all.

// An init/1 waits in a receive with no `after` before it acknowledges its
// start, and nothing the receive takes ends with its peer, so the start
// waits for a message that may never be sent.
.decl endless_receive_during_init(mod: symbol, waiter: symbol, recv: symbol)

endless_receive_during_init(mod, waiter, recv) :-
  init_function(mod, init),
  holds_start(init, waiter),
  receives_without_timeout(waiter, recv),
  !ends_with_peer(mod, recv).

// An init/1 waits in a receive with no `after` before it acknowledges its
// start, and only its peer's exit ends it, so a peer that is alive and
// never answers holds the start as long as it lives.
.decl receive_until_peer_exits_during_init(mod: symbol, waiter: symbol, recv: symbol)

receive_until_peer_exits_during_init(mod, waiter, recv) :-
  init_function(mod, init),
  holds_start(init, waiter),
  receives_without_timeout(waiter, recv),
  ends_with_peer(mod, recv).

// The function waits in `recv`, a receive with no `after`, before its own
// ack, and the receive is not the cancel_timer flush (flush_receive). Only
// what runs before the start is acknowledged holds the starter: an init/1
// that calls `:proc_lib.init_ack/1` and then enters its own loop waits
// there as the server it has become. An enter_loop reached before any ack
// is a finding of its own ("enter_loop", below).
.decl receives_without_timeout(func: symbol, recv: symbol)

receives_without_timeout(f, id) :-
  recv_start(id, f, 1, _),
  !start_acked(id, f),
  !flush_receive(id).

// The receive ends when its peer exits: it takes the pinned `:DOWN` of a
// monitor (down_bounded, clientlib/receive.dl), or the `:EXIT` of a
// linked process in a module whose init/1 traps exits
// (ends_with_linked_exit).
.decl ends_with_peer(mod: symbol, recv: symbol) inline

ends_with_peer(mod, recv) :- down_bounded(recv).
ends_with_peer(mod, recv) :- ends_with_linked_exit(mod, recv).

// The receive takes the pinned `:EXIT` of a process or port its function
// links to (exit_pinned, clientlib/receive.dl), and mod's init/1 traps
// exits, so the signal arrives as that message.
.decl ends_with_linked_exit(mod: symbol, recv: symbol)

ends_with_linked_exit(mod, recv) :-
  exit_pinned(recv, _),
  init_traps_exits(mod).

// init/1 traps exits, itself or in what it runs in its own process before
// its start is acknowledged: a flag set after the ack is not in effect
// for a wait before it.
.decl init_traps_exits(mod: symbol)

init_traps_exits(m) :- init_function(m, f), trap_reach.reaches(f).

.init trap_reach = SameProcessReachSetCut

trap_reach.cut(f, g) :- acked_edge(f, g).
trap_reach.seed(t) :- trap_exit(_, t, _).

init_effect(mod, "receive", waiter, recv) :-
  endless_receive_during_init(mod, waiter, recv).

init_effect(mod, "down", waiter, recv) :-
  receive_until_peer_exits_during_init(mod, waiter, recv).

// ── An init/1 that becomes the server before its start returns ──
//
// `:gen_server.enter_loop/3` (and gen_statem's) does not return: the
// process runs the server loop from there. A start waits on init/1 —
// GenServer's until it returns, proc_lib's until it calls init_ack — so
// an init/1 that reaches enter_loop before acknowledging its start holds
// its starter, and the supervisor's start, for good.

// An init/1 enters a server loop before it acknowledges its start, and a
// starter waits on it, so the start never returns.
.decl loop_entered_during_init(mod: symbol, func: symbol, entry: symbol)

loop_entered_during_init(mod, func, entry) :-
  init_function(mod, init),
  holds_start(init, func),
  enters_loop_at(func, entry),
  !started_by_bare_spawn(mod).

// The function calls :gen_server's or :gen_statem's enter_loop at `entry`,
// before its own ack.
.decl enters_loop_at(func: symbol, entry: symbol)

enters_loop_at(f, id) :-
  remote_call(id, f, m, "enter_loop", _),
  (m = ":gen_server" ; m = ":gen_statem"),
  !start_acked(id, f).

// The process runs a bare spawn of init/1
// (`:proc_lib.spawn_link(M, :init, [args])`): no starter waits on it.
.decl started_by_bare_spawn(mod: symbol)

started_by_bare_spawn(m) :-
  spawn_call(_, _, m, "init", 1, v, _, _, _, _),
  (v = "spawn" ; v = "spawn_link" ; v = "spawn_monitor").

init_effect(mod, "enter_loop", func, entry) :-
  loop_entered_during_init(mod, func, entry).

// ── Where the waits are ──────────────────────────────────────────────

// The receive that waits: the recv call, the `receive`, or the call
// that forwards :infinity into a helper's recv.
.decl recv_site(func: symbol, id: symbol)

recv_site(f, id) :- call_site(id, f, ":gen_tcp", "recv", _).
recv_site(f, id) :- call_site(id, f, ":ssl", "recv", _).
recv_site(f, id) :- call_arg(f, g, pos, ":infinity"), infinite_recv_param(g, pos), call_instr(f, g, id).

// A receiving function with no such site of its own is anchored at the
// function, its site empty.
.decl recv_site_or_empty(func: symbol, site: symbol)

recv_site_or_empty(f, id) :- recv_site(f, id).
recv_site_or_empty(f, "") :- reads_socket_without_timeout(f), !recv_site(f, _).

// One finding per receiving function; the inits that reach it are its
// evidence frames.
// `call` is the call in init/1 that starts its path to the receiving
// function (the earliest, when several do), or empty when init/1 is the
// receiving function or leaves through no call instruction.
.decl init_reaches_recv(mod: symbol, api: symbol, call: symbol)
.output init_reaches_recv

// A socket read or a receive an init/1 of mod waits in ("recv", "receive"
// or "down").
.decl reported_wait(mod: symbol, api: symbol)

reported_wait(mod, r) :- init_effect(mod, "recv", r, _).
reported_wait(mod, r) :- init_effect(mod, "receive", r, _).
reported_wait(mod, r) :- init_effect(mod, "down", r, _).

// The first step out of init/1 takes the walk's own cut: an edge taken
// only after init/1's ack (acked_edge) starts no path that holds the
// start.
.decl init_recv_step(mod: symbol, api: symbol, call: symbol)

init_recv_step(mod, r, call) :-
  reported_wait(mod, r),
  init_function(mod, f),
  call_instr(f, g, call),
  !acked_edge(f, g),
  own_stack.reaches(g, r).

.decl init_recv_stepped(mod: symbol, api: symbol)

init_recv_stepped(mod, r) :- init_recv_step(mod, r, _).

init_reaches_recv(mod, r, call) :- init_recv_step(mod, r, call).

init_reaches_recv(mod, r, "") :-
  reported_wait(mod, r),
  !init_recv_stepped(mod, r).

// ── A connection made in init/1 with no way to try again ─────────────
//
// A child that connects to an external dependency in init/1 and stops
// or raises when it cannot is restarted by its supervisor, immediately,
// until the intensity is spent — and then the tree, usually the whole
// application, goes down at boot because a dependency was slow to come
// up (tortoise#46, grpc-elixir#557, newrelic/elixir_agent#181,
// brod#666). The fixes all defer the connect to a timer or a
// handle_continue with backoff, which is what the rule looks for.

// An init/1 connects to a service, and its module has no way to try
// again later, so a service that is down crash-loops the child until its
// supervisor gives up.
.decl connect_without_retry(mod: symbol, api: symbol)

connect_without_retry(mod, api) :-
  init_function(mod, init),
  connects_in_process(init, api),
  !retries_later(mod).

// The function, or what it runs in its own process, calls the connect
// `api`. Not cut at the ack: a connect after it still crashes the child a
// moment after its start returned when the peer is not up yet, and the
// supervisor restarts it at once, into the same crash, until the tree
// gives up. The ack moves the crash out of the start, not out of the
// restart loop.
.decl connects_in_process(func: symbol, api: symbol) inline

connects_in_process(f, api) :- connect_reach.reaches(f, api).

.init connect_reach = SameProcessReachCut

connect_reach.cut(f, g) :- side_call(f, g).
connect_reach.seed(f, api) :- impure_call(_, f, api, "network", _), connect_api(api).

// A network call that opens a connection.
.decl connect_api(api: symbol)

connect_api(api) :- impure_call(_, _, api, "network", _), match(":gen_tcp.connect/.*", api).
connect_api(api) :- impure_call(_, _, api, "network", _), match(":ssl.connect/.*", api).
connect_api(api) :- impure_call(_, _, api, "network", _), match(":gen_udp.open/.*", api).
connect_api(api) :- impure_call(_, _, api, "network", _), match(":httpc.request/.*", api).

// The module has a way back in to retry: a timer, a self-message, a
// handle_continue, or a gen_statem's own timeout (postgrex's connections
// arm {{:timeout, :backoff}, ms, nil}): deferral_path,
// clientlib/deferral.dl.
.decl retries_later(mod: symbol)

retries_later(mod) :- deferral_path(mod, _).

init_effect(mod, "connect", api, "") :- connect_without_retry(mod, api).

// ══ Start order ═════════════════════════════════════════════════════

// ── A dependency on a later sibling ──────────────────────────────────
//
// A synchronous dependency that holds the start (init_dep "call": before
// the ack, on init/1's own stack) is a deadlock by construction: the
// supervisor cannot reach the dependency until this init returns. One in
// the startup window that does not hold it (init_window_dep, entries.dl:
// a cast, or a call after the ack or in what init/1 starts) runs against
// a process that is not alive yet: the cast is dropped, the call exits
// :noproc, as a handle_continue's does. One row per witness; the finding
// builders keep one per (child, dep) and the synchronous one wins.

// A child's init/1 depends on a process that its supervisor starts after
// it, so the process is not there yet when init/1 needs it.
.decl later_sibling_dep(child: symbol, dep: symbol, kind: symbol, sup: symbol, sup_site: symbol, witness: symbol)

later_sibling_dep(child, dep, kind, sup, sup_site, witness) :-
  depends_during_startup(child, dep, kind, witness),
  starts_after(dep, child, sup),
  child != dep,
  tree_defined_at(sup, sup_site).

// mod's init/1 depends on `dep`, as `kind` says ("call" or "cast"):
// holding its start (init_dep) or in the startup window after it
// (init_window_dep), clientlib/entries.dl. `witness` is the function
// that makes the dependency.
.decl depends_during_startup(mod: symbol, dep: symbol, kind: symbol, witness: symbol)

depends_during_startup(mod, dep, kind, witness) :- init_dep(mod, dep, kind, witness).
depends_during_startup(mod, dep, kind, witness) :- init_window_dep(mod, dep, kind, witness).

// `later` starts after `earlier` under `sup`, in another branch of its
// child list (boots_before, clientlib/supervision.dl).
.decl starts_after(later: symbol, earlier: symbol, sup: symbol) inline

starts_after(later, earlier, sup) :- boots_before(sup, earlier, later, _, _).

// The tree `sup` starts is defined at `site` (supervisor_site): the
// finding anchors there, and a supervisor with no known site is not
// reported.
.decl tree_defined_at(sup: symbol, site: symbol) inline

tree_defined_at(sup, site) :- supervisor_site(sup, site).

blocks_on_peer(child, "init", dep, kind, "later", sup, sup_site, witness) :-
  later_sibling_dep(child, dep, kind, sup, sup_site, witness).

// ── A process the start function starts after the tree ───────────────
//
// The same deadlock one level up: a function starts a tree
// (`Supervisor.start_link(children, opts)`, an Application's start/2)
// and then, once it returns, starts D itself (post_start_call). A child
// C of the tree whose init/1 holds its start on D (init_dep "call") runs
// inside that start_link, before D's start: the call exits :noproc, C
// fails, the tree fails, and the application with it. Two supervision
// trees are not "already running" for each other by being two: the
// start function's own order places them.

// A child's init/1 waits on a process that the function starting its tree
// starts only after the tree is up, so the process is not there yet.
// `start` is the start function, `site` its call that starts `dep`.
.decl after_tree_dep(child: symbol, dep: symbol, start: symbol, site: symbol, witness: symbol)

after_tree_dep(child, dep, start, site, witness) :-
  starts_tree(start, sup),
  in_tree(child, sup),
  starts_after_tree(start, site, dep),
  calls_during_init_by(child, dep, witness),
  child != dep.

// The function starts sup's tree itself: the tree is defined at its
// `Supervisor.start_link` call.
.decl starts_tree(start: symbol, sup: symbol)

starts_tree(start, sup) :-
  supervisor_site(sup, site),
  call_site(site, start, "Supervisor", "start_link", _).

// The module is in the tree sup starts (boot_subtree).
.decl in_tree(mod: symbol, sup: symbol) inline

in_tree(mod, sup) :- boot_subtree(sup, _, mod).

// After Supervisor.start_link returns, the function calls, at `site`,
// the start_link of `dep` (post_start_call).
.decl starts_after_tree(start: symbol, site: symbol, dep: symbol)

starts_after_tree(start, site, dep) :-
  post_start_call(start, site, callee),
  function_def(callee, dep, "start_link", _, _).

// mod's init/1 holds its start on a synchronous call to `dep`, made in
// `witness` (init_dep "call"; calls_during_init without the witness).
.decl calls_during_init_by(mod: symbol, dep: symbol, witness: symbol) inline

calls_during_init_by(mod, dep, witness) :- init_dep(mod, dep, "call", witness).

blocks_on_peer(child, "init", dep, "call", "after_tree", start, site, witness) :-
  after_tree_dep(child, dep, start, site, witness).

// ══ Deferred startup: handle_continue ═══════════════════════════════
//
// A.handle_continue sync-calls B AND B.handle_continue sync-calls A is
// a call cycle in the continue phase, reported by blocking's call_cycle.

// ── handle_continue calls a later-started sibling ────────────────────

// A handle_continue/2 calls a process its supervisor starts after the
// worker, which is not there yet: the continue runs before the
// supervisor has gone on to start it.
.decl later_sibling_call_during_continue(worker: symbol, sibling: symbol, sup: symbol, call: symbol)

later_sibling_call_during_continue(worker, sibling, sup, call) :-
  continue_calls(worker, sibling, call),
  starts_after(sibling, worker, sup).

// The worker's handle_continue/2 makes a synchronous call to `target` at
// `call` (continue_wait, clientlib/entries.dl; `call` empty when the
// site is not known).
.decl continue_calls(worker: symbol, target: symbol, call: symbol) inline

continue_calls(worker, target, call) :- continue_wait(worker, target, call).

blocks_on_peer(worker, "continue", sibling, "call", "later", sup, call, "") :-
  later_sibling_call_during_continue(worker, sibling, sup, call).

// ── handle_continue calls back into its parent supervisor ────────────
//
// The supervisor is still mid-start_link, starting the children after
// the worker, and not reading its mailbox: the worker blocks until the
// rest of the child list is up, and a later child that waits on it
// deadlocks the boot. The worker's last-child case is quiet: its init
// returning is the supervisor's last wait.

// A handle_continue/2 calls its own supervisor while the supervisor is
// still starting the children after it.
.decl parent_call_during_continue(worker: symbol, sup: symbol, call: symbol)

parent_call_during_continue(worker, sup, call) :-
  calls_supervisor_during_continue(worker, sup, call),
  supervises(sup, worker),
  has_later_sibling(sup, worker).

// The worker's handle_continue/2 calls into the supervisor `sup`: a
// management call (manages_supervisor_during_continue), or a plain
// synchronous call on the supervisor's name (a GenServer.call the call
// resolution sees), which reaches the same mailbox.
.decl calls_supervisor_during_continue(worker: symbol, sup: symbol, call: symbol)

calls_supervisor_during_continue(worker, sup, call) :-
  manages_supervisor_during_continue(worker, sup, call, _).

calls_supervisor_during_continue(worker, sup, call) :-
  continue_calls(worker, sup, call),
  supervisor(sup, _).

// A handle_continue/2 of a worker whose init/1 continues makes a
// Supervisor query or management call on `sup` at `call`, described by
// `detail` (api.op). Supervisor.which_children and the other management
// calls are sup_calls, not sync calls: they are read on the continue's
// own stack (own_stack), the call their site.
.decl manages_supervisor_during_continue(worker: symbol, sup: symbol, call: symbol, detail: symbol)

manages_supervisor_during_continue(worker, sup, call, cat(api, ".", op)) :-
  init_continues_to(worker, _),
  handle_continue_clause(worker, _, f),
  sup_management_call(call, f, api, op, sup).

manages_supervisor_during_continue(worker, sup, call, cat(api, ".", op)) :-
  init_continues_to(worker, _),
  handle_continue_clause(worker, _, f),
  own_stack.reaches(f, call),
  sup_management_call(call, _, api, op, sup).

// The worker is one of sup's own children.
.decl supervises(sup: symbol, worker: symbol) inline

supervises(sup, worker) :- supervisor(sup, _), supervisor_child(sup, _, worker, _, _).

// A child starts after the worker: one the list shows at a later
// position, or one it may not show. A list the extractor cannot read to
// its end (supervisor_children_open: an element from
// Supervisor.child_spec/2 of a spec it does not read, a list appended
// from config) may hold a later child anywhere; only a closed list's
// last child is known to be last.
.decl has_later_sibling(sup: symbol, worker: symbol)

has_later_sibling(sup, worker) :- boots_before(sup, worker, _, _, _).

has_later_sibling(sup, worker) :-
  supervisor_children_open(sup),
  supervisor_child(sup, _, worker, _, _).

// A management call carries its api.op; a plain call, none.
blocks_on_peer(worker, "continue", sup, "parent", "parent", sup, call, detail) :-
  parent_call_during_continue(worker, sup, call),
  manages_supervisor_during_continue(worker, sup, call, detail).

blocks_on_peer(worker, "continue", sup, "parent", "parent", sup, call, "") :-
  parent_call_during_continue(worker, sup, call),
  continue_calls(worker, sup, call).

// ── init/1 calls its parent supervisor after its ack ─────────────────

// An init/1 calls its own supervisor after it acknowledges its start,
// while the supervisor is still starting the children after it: the
// supervisor has moved on to the later children and reads no mailbox
// until they are up, as it does while a handle_continue runs. Not the
// start's hold, which ended at the ack.
.decl parent_call_after_ack(worker: symbol, sup: symbol, call: symbol)

parent_call_after_ack(worker, sup, call) :-
  manages_supervisor_after_ack(worker, sup, call, _),
  supervises(sup, worker),
  has_later_sibling(sup, worker).

// The worker's init/1 makes a Supervisor query or management call on
// `sup` at `call` after it acknowledged its start (`detail` is api.op):
// in a function it runs before the ack, at a call made after that
// function's own ack, or anywhere on its own stack past an edge taken
// only after the ack (after_ack).
.decl manages_supervisor_after_ack(worker: symbol, sup: symbol, call: symbol, detail: symbol)

manages_supervisor_after_ack(worker, sup, call, cat(api, ".", op)) :-
  init_function(worker, i),
  before_ack.reaches(i, f),
  sup_management_call(call, f, api, op, sup),
  start_acked(call, f).

manages_supervisor_after_ack(worker, sup, call, cat(api, ".", op)) :-
  init_function(worker, i),
  after_ack.reaches(i, g),
  sup_management_call(call, g, api, op, sup).

.init after_ack = ForwardSameProcessReachCut

after_ack.cut(f, g) :- side_call(f, g).
after_ack.root(i, g) :- before_ack.reaches(i, f), acked_edge(f, g).

blocks_on_peer(worker, "acked", sup, "parent", "parent", sup, call, detail) :-
  parent_call_after_ack(worker, sup, call),
  manages_supervisor_after_ack(worker, sup, call, detail).

// ── Defensive variant: try/catch wraps the call ──────────────────────

// A handle_continue/2 that calls a later sibling also catches: the catch
// turns the deadlock into a crash the supervisor restarts, into the same
// call, until its restart intensity is spent.
.decl caught_later_sibling_call(worker: symbol, sup: symbol)

caught_later_sibling_call(worker, sup) :-
  later_sibling_call_during_continue(worker, _, sup, _),
  catches_in_continue(worker).

// A handle_continue/2 of the module has a try (or an older catch).
// try_start carries its containing function and its kind ("try" or
// "catch"), so both syntaxes are one rule and neither needs to join
// `instruction` — 343k rows on a real project, rewritten on every body
// edit — purely to recover the function an instruction sits in.
.decl catches_in_continue(mod: symbol)

catches_in_continue(mod) :-
  handle_continue_clause(mod, _, func),
  try_start(_, func, _, _).

deferral_defect(worker, "continue_catch", "", sup) :- caught_later_sibling_call(worker, sup).

// ── Init timeout used as a deferral ───────────────────────────────────
//
// {:ok, state, 0} from init/1 is the pre-handle_continue idiom for "do
// the rest after the supervisor moves on": the :timeout message arrives
// as soon as the mailbox is otherwise empty. The catch is in that
// clause. A timeout is cancelled by any message arriving first, and an
// init that opened an active socket, subscribed to a PubSub, or was
// handed a message by its starter has already arranged for one.
// libcluster's Gossip strategy lost its deferred connect this way to
// the first UDP datagram. Any integer works the same; 0 is the one that
// is unmistakably a deferral.

// An init/1 returns a timeout to defer the rest of its work, and any
// message that arrives first cancels the timeout, and the work with it.
.decl init_timeout_deferral(mod: symbol, site: symbol)

init_timeout_deferral(mod, site) :-
  init_function(mod, init),
  returns_timeout(init, site).

// The callback returns a timeout at `site` (callback_timeout "init").
.decl returns_timeout(init: symbol, site: symbol) inline

returns_timeout(init, site) :- callback_timeout(site, init, "init", _).

deferral_defect(mod, "init_timeout", site, to_string(ms)) :-
  init_timeout_deferral(mod, site),
  callback_timeout(site, _, "init", ms).

// ══ Distributed operations in init/1 ════════════════════════════════

// ── A :global lock in init/1 ─────────────────────────────────────

// The worst case: a :global lock that retries until it is granted
// (lock_until_granted, clientlib/vocabulary.dl), held from supervisor
// startup — in init/1, or in anything init/1 runs on its own stack or
// waits for (global_path, clientlib/global_reach.dl). The supervisor
// waits on the lock, and the lock waits on the nodes in its list: every
// connected node when `dep` is "cluster", only this node's global server
// when it is "local" (it still waits forever on a local holder), and
// "unknown" when the list is not in the bytecode. `lock` is the :global
// call itself, in whichever function holds it (init/1 included).

// An init/1 waits for a :global lock that retries until it is granted,
// so its supervisor's start waits as long as anyone else holds the lock.
.decl lock_during_init(init: symbol, lock: symbol)

lock_during_init(init, lock) :-
  global_call_during_init(init, lock),
  retries_until_locked(lock).

// Each lock is reported with its node list as `dep`. A retry count the
// bytecode does not show is assumed :infinity, the default the wrappers
// forward, and the row says so by its kind ("global_assumed"). One row
// per site — finding builders dedupe on (func, nodes, op).
blocks_on_peer(init, "init", nodes, "global", "", "", lock, op) :-
  lock_during_init(init, lock),
  global_op(lock, _, op, "infinity", nodes).

blocks_on_peer(init, "init", nodes, "global_assumed", "", "", lock, op) :-
  lock_during_init(init, lock),
  global_op(lock, _, op, "dynamic", nodes).

// A lock with a positive retry count gives up and returns false, after
// backoff that OTP caps at 8 s a try. Over [node()] that is the fix the
// "local" finding recommends, and is quiet. Over other nodes each try
// still asks every one of them, and a partitioned node holds a try until
// the node is declared down, so the start waits for a bounded but
// possibly long time: reported one severity below the other kinds, as
// "global_bounded".

// An init/1 waits for a :global lock that gives up only after its
// retries, and each retry waits on other nodes.
.decl bounded_lock_during_init(init: symbol, lock: symbol)

bounded_lock_during_init(init, lock) :-
  global_call_during_init(init, lock),
  gives_up_after_retries(lock),
  waits_on_other_nodes(lock).

blocks_on_peer(init, "init", nodes, "global_bounded", "", "", lock, op) :-
  bounded_lock_during_init(init, lock),
  bounded_lock(lock, _, op, _, nodes).

// A lock during init, of any kind reported above.
.decl init_lock(init: symbol, lock: symbol)

init_lock(init, lock) :- lock_during_init(init, lock).
init_lock(init, lock) :- bounded_lock_during_init(init, lock).

// Where init/1's path to a lock in a helper starts: the call in init/1
// whose callee, on init's own stack, reaches the lock (or the Task.async
// whose task init/1 awaits). The finding's "init/1 reaches it from here"
// frame points at that call; a path that leaves init/1 through something
// with no call instruction (a closure it runs, a fun it applies) points
// at init/1 itself, `call` empty — unless the lock is in an anonymous
// function written inside init/1, whose line the finding's anchor
// already is. The earliest such call is kept (the relation's
// `earliest`).
.decl init_lock_path(init: symbol, lock: symbol, call: symbol)
.output init_lock_path

.decl init_lock_step(init: symbol, lock: symbol, call: symbol)

init_lock_step(init, lock, call) :-
  init_lock(init, lock),
  global_path(init, call, lock),
  call != "",
  call != lock.

.decl init_lock_stepped(init: symbol, lock: symbol)

init_lock_stepped(init, lock) :- init_lock_step(init, lock, _).

init_lock_path(init, lock, call) :- init_lock_step(init, lock, call).

init_lock_path(init, lock, "") :-
  init_lock(init, lock),
  global_op(lock, holder, _, _, _),
  holder != init,
  !lock_in_init_closure(init, lock),
  !init_lock_stepped(init, lock).

// The lock is in an anonymous function written inside init/1
// (`M:-init/1-fun-0-/1`): its line is inside init/1's own source.
.decl lock_in_init_closure(init: symbol, lock: symbol)

lock_in_init_closure(init, lock) :-
  init_lock(init, lock),
  global_op(lock, holder, _, _, _),
  function_def(init, m, n, a, _),
  contains(cat(m, ":-", n, "/", to_string(a), "-fun-"), holder).

// ── Distributed operations in init ───────────────────────────────

// An init/1 makes a distributed operation before it acknowledges its
// start, so its supervisor's start waits as long as the other node, or
// the store, takes to answer.
.decl distributed_operation_during_init(init: symbol, op: symbol)

distributed_operation_during_init(init, op) :-
  is_init(init),
  holds_start(init, op),
  distributed_operation(op, _, _).

// The call at `op`, in `func`, is an operation that waits on another
// node or on a distributed store, named `name`: an rpc (by its variant),
// a :global name registration ("global_register"), a node operation, or
// a Mnesia or DETS operation. Node.list ("list"), Node.monitor
// ("monitor") and :net_kernel.monitor_nodes ("monitor_nodes", a
// subscription flag, not a connection attempt) return at once, and are
// not ones.
.decl distributed_operation(op: symbol, func: symbol, name: symbol)

distributed_operation(id, f, name) :- rpc_call(id, f, name, _).
distributed_operation(id, f, "global_register") :- global_register(id, f, _, _).

distributed_operation(id, f, name) :-
  node_operation(id, f, name),
  name != "list",
  name != "monitor",
  name != "monitor_nodes".

distributed_operation(id, f, name) :- distributed_store_op(id, f, _, name).

// One row per site: finding builders dedupe on (func, op).
blocks_on_peer(init, "init", "", "remote", "", "", op, name) :-
  distributed_operation_during_init(init, op),
  distributed_operation(op, _, name).

// ══ After the tree is up ════════════════════════════════════════════

// ── Initialization after the tree is up ──────────────────────────────
//
// Children start serving the moment Supervisor.start_link returns. State
// they read — a persistent_term, an ETS row, an application env — that
// the caller writes only afterwards is a window in which they run against
// nothing (phoenixframework/phoenix#5981: the endpoint's warmup after the
// listener was accepting).

// A function starts a supervision tree and only afterwards writes state
// other processes read, so the children are already serving when the
// write lands.
.decl write_after_tree_starts(func: symbol, call: symbol, callee: symbol)

write_after_tree_starts(func, call, callee) :-
  calls_after_tree_starts(func, call, callee),
  writes_shared_state(callee).

// After Supervisor.start_link returns, `func` calls `callee` at `call`
// (post_start_call).
.decl calls_after_tree_starts(func: symbol, call: symbol, callee: symbol) inline

calls_after_tree_starts(func, call, callee) :- post_start_call(func, call, callee).

// The callee writes state other processes read (persistent_term, ETS,
// application env): it is such a write (config_write_api), or a function
// that reaches one (config_writer, clientlib/effect_model.dl).
.decl writes_shared_state(callee: symbol)

writes_shared_state(callee) :- config_write_api(callee).
writes_shared_state(callee) :- config_reach.reaches(callee).

.init config_reach = CallReachSet

config_reach.seed(f) :- config_writer(f).

.decl post_start_initialization(func: symbol, site: symbol, callee: symbol, start: symbol)
.output post_start_initialization

post_start_initialization(func, call, callee, start) :-
  write_after_tree_starts(func, call, callee),
  start_link_site_or_empty(func, start).

// The Supervisor.start_link the write comes after; a start spelled
// another way leaves the frame out (its site empty).
.decl start_link_site_or_empty(func: symbol, site: symbol)

start_link_site_or_empty(f, id) :- call_site(id, f, "Supervisor", "start_link", _).
start_link_site_or_empty(f, "") :- post_start_call(f, _, _), !call_site(_, f, "Supervisor", "start_link", _).

// ── Ignored start results ────────────────────────────────────────

// A function starts a process and never looks at whether the start
// succeeded.
.decl ignored_start(func: symbol, callee: symbol)

ignored_start(func, callee) :-
  ignores_result(func, callee),
  starts_process(callee).

// The function calls `callee`, which returns a tagged tuple, and does not
// match the result (ignored_error_result).
.decl ignores_result(func: symbol, callee: symbol) inline

ignores_result(func, callee) :- ignored_error_result(_, func, callee).

// The callee is a start_link or a start. It is rendered as
// "Mod.func/arity", so the function name is always preceded by "." and
// followed by "/": matching the delimited name keeps a callee like
// "Mod.restart_link/1" from substring-matching "start_link".
//
// NOTE Souffle's contains(needle, haystack) takes the needle FIRST. The
// rule originally wrote contains(callee, "start_link") — "is the callee
// a substring of 'start_link'" — which is false for every real callee,
// so this relation had never produced a single row.
.decl starts_process(callee: symbol) inline

starts_process(callee) :- contains(".start_link/", callee).
starts_process(callee) :- contains(".start/", callee).

.decl ignored_start_result(func: symbol, callee: symbol)
.output ignored_start_result

ignored_start_result(func, callee) :- ignored_start(func, callee).

// ══ A wait whose peer answers, when priors are on ═══════════════════
//
// A receive the model is sure waits on something inside the node that
// always answers (Argus.Priors.Questions.PeerAnswers; off by default):
// a reply from code_server or a file or io server, a runtime driver, the
// exit of a child it has just stopped. The start still waits, but on an
// answer that comes; the finding steps down and says so. One that waits
// on another node, an external program or a message that may never be
// sent keeps its severity. 0.8, as in blocking.
.decl answering_wait(func: symbol, permille: number)

answering_wait(r, p) :- prior_answers("wait", r, _, _, p), p >= 800.

.decl answered_effect(kind: symbol, api: symbol)

answered_effect(k, r) :-
  init_effect(_, k, r, _),
  (k = "receive" ; k = "down"),
  answering_wait(r, _).

unbounded_effect_in_init(m, k, r, s, "local", p) :-
  init_effect(m, k, r, s),
  (k = "receive" ; k = "down"),
  answering_wait(r, p).

unbounded_effect_in_init(m, k, r, s, "", 0) :-
  init_effect(m, k, r, s),
  !answered_effect(k, r).
