// Bare `receive` inside an OTP callback.
//
// An OTP process is already sitting in a receive loop that its behaviour
// module owns. A `receive` written inside a callback runs INSIDE that loop
// and selectively consumes from the same mailbox, which breaks three things
// at once:
//
//   1. It steals messages the behaviour needs. `{:system, _, _}` is how
//      :sys.get_state, :sys.suspend, :sys.replace_state and the whole
//      debug/trace surface work; `{:EXIT, _, _}` is how a trapping process
//      learns a link died; `{:DOWN, ...}` is every monitor in flight. A
//      receive with a catch-all clause eats them.
//   2. It reorders delivery. Messages the callback does not match stay in
//      the queue and are re-scanned on every subsequent receive — the
//      classic selective-receive performance cliff, quadratic in queue
//      length.
//   3. If it has no `after`, it can block forever. The process stops
//      responding to its supervisor, so shutdown waits out the child's
//      timeout and then brutal-kills it — turning a graceful stop into a
//      lost buffer.
//
// This is a well-known OTP anti-pattern with no compiler or dialyzer
// diagnostic, and it is invisible in review because the `receive` usually
// looks locally reasonable.

.include "../clientlib/imports.dl"
.include "../clientlib/behaviours.dl"

// ── OTP behaviours whose callbacks run inside the process loop ───

.decl loop_behaviour(behaviour: symbol)

// Canonical names — clientlib/behaviours.dl folds in the Erlang
// spellings. The bare "gen_server" and "supervisor" listed here before
// matched nothing at all: an Erlang declaration inspects to ":gen_server",
// colon included.
loop_behaviour("GenServer").
loop_behaviour("GenStage").
loop_behaviour("Supervisor").
loop_behaviour("GenStateMachine").
loop_behaviour("GenEvent").
loop_behaviour("Phoenix.LiveView").
loop_behaviour("Phoenix.LiveComponent").
loop_behaviour("Phoenix.Channel").
loop_behaviour("Broadway").

.decl callback_name(name: symbol)

callback_name("init").
callback_name("handle_call").
callback_name("handle_cast").
callback_name("handle_info").
callback_name("handle_continue").
callback_name("handle_event").
callback_name("handle_events").
callback_name("handle_demand").
callback_name("handle_params").
callback_name("handle_in").
callback_name("handle_message").
callback_name("handle_batch").
callback_name("terminate").
callback_name("mount").

.decl otp_callback(func: symbol, mod: symbol, behaviour: symbol)

otp_callback(func, mod, behaviour) :-
  behaves_as(mod, behaviour),
  loop_behaviour(behaviour),
  function_def(func, mod, name, _, _),
  callback_name(name).

// ── Reachability that stays in the same process ──────────────────
//
// `call_edge` deliberately treats closure construction as a call, so that
// call_reachable follows execution into lambdas handed to Enum.map,
// Task.async and friends. That is right for reachability and wrong here: a
// `receive` inside `spawn(fn -> ... end)` runs in the SPAWNED process, not
// the callback's, and reporting it would be a false positive of exactly the
// kind that makes people stop reading a tool's output.
//
// Closure edges are therefore subtracted. What remains is control that
// stays on this process's stack.

.decl same_process_edge(caller: symbol, callee: symbol)

same_process_edge(caller, callee) :-
  call_edge(caller, callee),
  !closure_def(caller, callee).

.decl same_process_reaches(entry: symbol, func: symbol, proximity: symbol)

same_process_reaches(entry, entry, "direct") :-
  otp_callback(entry, _, _).

same_process_reaches(entry, callee, "helper") :-
  otp_callback(entry, _, _),
  same_process_edge(entry, callee).

// ── Findings ─────────────────────────────────────────────────────

// ── The cancel_timer flush idiom ─────────────────────────────────
//
// A blocking receive is NOT a bug when it is flushing an already-delivered
// timer message:
//
//     if Process.cancel_timer(ref) == false do
//       receive do :tick -> :ok end
//     end
//
// `cancel_timer/1` returning false means the timer had already expired, so
// the message has already been sent and is sitting in the mailbox — the
// receive is guaranteed to match, and OTP's own code is written this way.
// This is the documented way to keep a stale timer message from being
// mistaken for a fresh one later.
//
// Found by verification, not by anticipation: both blocking receives in the
// first corpus sweep were this idiom, and reporting them as hangs would
// have been the analysis's entire output on that project.
//
// The suppression is function-granular, so a function that both flushes a
// timer AND has an unrelated blocking receive is missed. That is the right
// direction to be wrong: a false negative costs a finding, a false positive
// costs the reader's trust in every other finding.
.decl flushes_timer(func: symbol)

flushes_timer(func) :-
  remote_call(_, func, ":erlang", "cancel_timer", _).

// A receive with no `after`, running on an OTP process's own stack. This
// is the one that hangs: no timeout means no way out if the expected
// message never arrives, and the supervisor can only brutal-kill.
.decl blocking_receive_in_callback(id: symbol, func: symbol, callback: symbol, behaviour: symbol, proximity: symbol)
.output blocking_receive_in_callback

blocking_receive_in_callback(id, func, callback, behaviour, proximity) :-
  recv_start(id, func, 1, _),
  same_process_reaches(callback, func, proximity),
  otp_callback(callback, _, behaviour),
  !flushes_timer(func).

// A receive WITH a timeout. It cannot hang, but it still consumes from the
// behaviour's mailbox and still re-scans the queue.
.decl receive_in_callback(id: symbol, func: symbol, callback: symbol, behaviour: symbol, proximity: symbol)
.output receive_in_callback

receive_in_callback(id, func, callback, behaviour, proximity) :-
  recv_start(id, func, 0, _),
  same_process_reaches(callback, func, proximity),
  otp_callback(callback, _, behaviour).
