// Process registry and naming analysis.
//
// Detects naming issues: duplicate process name registration across
// modules and TOCTOU races on Process.whereis.

.include "../clientlib/imports.dl"


// ── Whereis race (TOCTOU) ────────────────────────────────────────

// Process.whereis whose result is used without a nil check — the
// extractor reads the straight-line code after the call for a
// comparison against nil/:undefined or a type test, and marks the call
// "checked" when it finds one. `id` anchors the finding at the call.
.decl whereis_race(id: symbol, func: symbol, name: symbol)
.output whereis_race

whereis_race(id, func, name) :-
  whereis_call(id, func, name, "unchecked"),
  name != "dynamic",
  name != ":dynamic".
