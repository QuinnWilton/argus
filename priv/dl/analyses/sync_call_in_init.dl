// Synchronous calls in init/1 detection.
//
// Identifies GenServer/Supervisor modules whose init/1 callback makes
// synchronous calls (directly or transitively). When combined with
// supervision ordering, detects guaranteed deadlocks: a child's init
// blocks on a sibling that hasn't started yet.
//
// Supervision-aware filtering removes proven-safe findings:
// - Safe sibling: callee starts EARLIER under the same supervisor.
// - Safe cross-supervisor: caller and callee are under disjoint supervisors.

.include "../clientlib/imports.dl"
.include "../clientlib/resolved_calls.dl"
.include "../clientlib/behaviours.dl"

// ── Layer 2 facts ──────────────────────────────────────────────────────

// ── OTP helpers ─────────────────────────────────────────────────────────

.include "../clientlib/otp.dl"

// ── Child subtree + init reaches ────────────────────────────────────────

.include "../clientlib/supervision.dl"

// ── Raw sync calls reachable from init ─────────────────────────────────

.decl raw_sync_call_in_init(mod: symbol, callee: symbol)

// Direct: init/1 itself makes the sync_call.
raw_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  sync_call_target(func, callee),
  callee != "dynamic".

// Transitive: init/1 reaches a function that makes the sync_call.
raw_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  call_reachable(func, g),
  sync_call_target(g, callee),
  callee != "dynamic".

// Indirect via GenServer API: init/1 calls a sync API function.
raw_sync_call_in_init(mod, target_mod) :-
  init_function(mod, func),
  call_edge(func, g),
  genserver_sync_api(g, target_mod),
  mod != target_mod.

// Transitive via GenServer API: init/1 reaches a sync API function.
raw_sync_call_in_init(mod, target_mod) :-
  init_function(mod, func),
  call_reachable(func, g),
  genserver_sync_api(g, target_mod),
  mod != target_mod.

// ── Supervision-aware filtering ────────────────────────────────────────

// True when both modules appear under a common supervisor's subtree.
.decl shares_supervisor(child: symbol, dep: symbol)

shares_supervisor(child, dep) :-
  child_subtree(sup, _, child),
  child_subtree(sup, _, dep),
  child != dep.

// A module with a behaviour and start_link/1 is very likely supervised,
// even when we can't statically determine which supervisor owns it.
.decl likely_supervised(mod: symbol)

likely_supervised(mod) :- child_subtree(_, _, mod).

likely_supervised(mod) :-
  implements_behaviour(mod, _),
  function_def(_, mod, "start_link", 1, _).

// Callee starts earlier under the same supervisor — already running.
.decl init_safe_sibling(child: symbol, dep: symbol)
.output init_safe_sibling

init_safe_sibling(child, dep) :-
  raw_sync_call_in_init(child, dep),
  supervisor(sup, _),
  child_subtree(sup, child_branch, child),
  child_subtree(sup, dep_branch, dep),
  supervisor_child(sup, cpos, child_branch, _, _),
  supervisor_child(sup, dpos, dep_branch, _, _),
  dpos < cpos,
  child_branch != dep_branch.

// Both likely supervised but under disjoint supervisor trees — callee
// is already running because it was started by a different supervisor.
// At least one must be provably supervised (in a child_subtree) to
// prevent false negatives when no supervision facts exist at all.
.decl init_safe_cross_supervisor(child: symbol, dep: symbol)
.output init_safe_cross_supervisor

init_safe_cross_supervisor(child, dep) :-
  raw_sync_call_in_init(child, dep),
  child_subtree(_, _, child),
  likely_supervised(dep),
  !shares_supervisor(child, dep).

init_safe_cross_supervisor(child, dep) :-
  raw_sync_call_in_init(child, dep),
  likely_supervised(child),
  child_subtree(_, _, dep),
  !shares_supervisor(child, dep).

// ── Conditional paths ──────────────────────────────────────────────────

// The sync call is reachable from init through an edge that runs on every
// path (stage 0's `unconditional_call_edge`). A direct GenServer.call in
// init counts through its own edge to GenServer:call/N. If no such route
// exists, every route from init passes through a branch-guarded site —
// an option such as postgrex's `sync_connect: true`, a case on the
// argument — and the call only happens on some inits.
.decl unconditional_sync_call_in_init(mod: symbol, callee: symbol)

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  unconditional_call_edge(func, gc),
  (gc = "GenServer:call/2"; gc = "GenServer:call/3"),
  sync_call_target(func, callee),
  callee != "dynamic".

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  unconditional_call_edge(func, g),
  sync_call_target(g, callee),
  callee != "dynamic".

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  unconditional_call_edge(func, g),
  call_reachable(g, h),
  sync_call_target(h, callee),
  callee != "dynamic".

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  unconditional_call_edge(func, g),
  genserver_sync_api(g, callee),
  mod != callee.

unconditional_sync_call_in_init(mod, callee) :-
  init_function(mod, func),
  unconditional_call_edge(func, g),
  call_reachable(g, h),
  genserver_sync_api(h, callee),
  mod != callee.

// ── Filtered output ────────────────────────────────────────────────────

// `kind` is "unconditional" when some path from init to the call runs on
// every init, "conditional" when every path goes through a call site in
// init that a branch guards (postgrex's `sync_connect: true`, goth's
// `prefetch: :sync`).
.decl sync_call_in_init(mod: symbol, callee: symbol, kind: symbol)
.output sync_call_in_init

sync_call_in_init(mod, callee, "unconditional") :-
  raw_sync_call_in_init(mod, callee),
  !init_safe_sibling(mod, callee),
  !init_safe_cross_supervisor(mod, callee),
  unconditional_sync_call_in_init(mod, callee).

sync_call_in_init(mod, callee, "conditional") :-
  raw_sync_call_in_init(mod, callee),
  !init_safe_sibling(mod, callee),
  !init_safe_cross_supervisor(mod, callee),
  !unconditional_sync_call_in_init(mod, callee).

// ── Init deadlock risk ─────────────────────────────────────────────────

// A child's init sync-calls a dependency that starts later under the
// same supervisor. The dependency's process doesn't exist yet, so the
// call will block (or crash) during startup.
.decl init_deadlock_risk(sup: symbol, child: symbol, dep: symbol, child_pos: number, dep_pos: number)
.output init_deadlock_risk

init_deadlock_risk(sup, child, dep, cpos, dpos) :-
  supervisor(sup, _),
  child_subtree(sup, child_branch, child),
  child_subtree(sup, dep_branch, dep),
  supervisor_child(sup, cpos, child_branch, _, _),
  supervisor_child(sup, dpos, dep_branch, _, _),
  raw_sync_call_in_init(child, dep),
  cpos < dpos,
  child_branch != dep_branch.
