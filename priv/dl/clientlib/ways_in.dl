// External entry points.
// `api_export` includes exports except macros and compiler/library reflection
// functions. Internal use does not remove API status. Consumers decide whether runtime
// callbacks count as outside input.
// `library_face` restricts APIs to modules with no clients elsewhere in the analyzed
// program; `open_entry` further requires no visible caller. Unused exports of
// internally used modules are treated as inactive.
// Known limit: a library may both use a module internally and expose otherwise unused
// functions to its users. Requires imports.dl.

.decl api_export(func: symbol)

api_export(f) :-
  function_def(f, _, n, a, 1),
  !match("MACRO-.*", n),
  !reflection(n, a),
  n != "module_info".

// Exclude zero-argument __name__ reflection functions and compiler/Ecto lookups using
// internal keys. Other __name__ exports with arguments remain entry points, such as
// Phoenix's __match_route__/3.
.decl reflection(name: symbol, arity: number)

reflection(n, 0) :- function_def(_, _, n, 0, 1), match("__.*__", n).
reflection("__info__", 1).
reflection("__struct__", 1).
reflection("__impl__", 1).
reflection("__protocol__", 1).
reflection("__schema__", 1).
reflection("__schema__", 2).
reflection("__deriving__", 3).

// A module some other module of the program calls into.
.decl called_by_other_module(mod: symbol)

called_by_other_module(m) :-
  call_edge(c, g),
  function_def(g, m, _, _, _),
  function_def(c, cm, _, _, _),
  cm != m.

.decl library_face(func: symbol)

library_face(f) :-
  api_export(f),
  function_def(f, m, _, _, _),
  !called_by_other_module(m).

.decl open_entry(func: symbol)

open_entry(f) :- library_face(f), !call_edge(_, f).
