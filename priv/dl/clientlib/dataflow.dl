// Composable dataflow analysis component.
//
// A Soufflé component (.comp) that abstracts the common gen/kill/transfer
// pattern for forward and backward dataflow analyses. Client analyses
// instantiate it with .init and override the gen/kill inputs.
//
// Adapted from Gigahorse's clientlib/flows.dl pattern.
//
// Usage (forward reaching definitions):
//
//   .include "clientlib/dataflow.dl"
//
//   .init my_reaching = ForwardDataflow
//
//   // Seed: gen facts (what each instruction generates).
//   my_reaching.gen("inst1", "x0").
//   my_reaching.kill("inst1", "x0").
//   my_reaching.cfg_edge_in("inst1", "inst2").
//
//   // Read results.
//   .decl my_result(fact: symbol, point: symbol)
//   .output my_result
//   my_result(fact, point) :- my_reaching.reaches(fact, point).
//
// Usage (backward liveness):
//
//   .init my_live = BackwardDataflow
//   // ... similar pattern with backward semantics.

// ── Forward dataflow component ───────────────────────────────────────

// Forward dataflow: propagates facts forward along CFG edges.
// A fact generated at a point reaches all successors unless killed.
.comp ForwardDataflow {

  // Input: control flow edges.
  .decl cfg_edge_in(from: symbol, to: symbol)

  // Input: facts generated at a point (e.g., definitions).
  .decl gen(point: symbol, fact: symbol)

  // Input: facts killed at a point (e.g., redefinitions).
  .decl kill(point: symbol, fact: symbol)

  // Output: a generated fact reaches a program point.
  .decl reaches(fact: symbol, point: symbol)

  // A generated fact reaches the immediately next point.
  reaches(fact, to) :-
    gen(from, fact),
    cfg_edge_in(from, to).

  // A fact propagates through points that don't kill it.
  reaches(fact, to) :-
    reaches(fact, through),
    cfg_edge_in(through, to),
    !kill(through, fact).
}

// ── Backward dataflow component ──────────────────────────────────────

// Backward dataflow: propagates facts backward along CFG edges.
// A fact used at a point is live at all predecessors unless killed.
.comp BackwardDataflow {

  // Input: control flow edges (forward direction).
  .decl cfg_edge_in(from: symbol, to: symbol)

  // Input: facts used at a point (e.g., register reads).
  .decl used(point: symbol, fact: symbol)

  // Input: facts defined at a point (kills backward flow).
  .decl defined(point: symbol, fact: symbol)

  // Output: fact is live-in at a point (used before redefined).
  .decl live_in(point: symbol, fact: symbol)

  // Output: fact is live-out at a point (live-in at some successor).
  .decl live_out(point: symbol, fact: symbol)

  // A used fact is live-in at its point.
  live_in(point, fact) :- used(point, fact).

  // A fact is live-in if it's live-out and not defined here.
  live_in(point, fact) :-
    live_out(point, fact),
    !defined(point, fact).

  // A fact is live-out if it's live-in at a successor.
  live_out(point, fact) :-
    cfg_edge_in(point, succ),
    live_in(succ, fact).
}
