// Process points-to facts computed once by points_to.dl and consumed by analyses. See
// processes.dl for relation definitions. sends.dl and signals.dl extend these staged
// rows without recomputing the fixpoint. Requires imports.dl; otp.dl includes this
// file.

// Process identities: callback modules, individual start sites, supervised children,
// privately retained instances and named processes.
.decl server_process(proc: symbol, mod: symbol)
.input server_process

.decl instance(proc: symbol, base: symbol)
.input instance

.decl supervised_process(proc: symbol, sup: symbol, pos: number)
.input supervised_process

.decl private_process(proc: symbol, func: symbol, site: symbol)
.input private_process

.decl process(proc: symbol)
.input process

// A registered name may hold a pid of `proc`.
.decl named_pid(name: symbol, proc: symbol)
.input named_pid

// `func` calls, casts or sends info to proc at site, directly or through a
// PID-receiving helper at anchor. Signals are staged separately.
.decl process_call(func: symbol, anchor: symbol, site: symbol, api_kind: symbol, proc: symbol)
.input process_call

// The call, cast or send at `id` in `func` may target `proc`, whoever
// supplies it.
.decl call_site_target(id: symbol, func: symbol, api_kind: symbol, proc: symbol)
.input call_site_target

// A synchronous call that is provably to the calling process itself.
.decl self_call(func: symbol, site: symbol)
.input self_call

// Possible process/table leaves for demanded sources: handler call targets and ETS
// operands. Do not export intermediate terms or arbitrary source points-to rows. New
// source demands must be added to points_to.dl.
.decl source_process(func: symbol, src_kind: symbol, src: symbol, proc: symbol)
.input source_process

.decl source_table(func: symbol, src_kind: symbol, src: symbol, table: symbol)
.input source_table

// The tables a bounded stage resolved coarsely: their source_table rows
// are a superset (points_to.dl).
.decl coarse_table(table: symbol)
.input coarse_table

// An unnamed table its process keeps in its dictionary and never hands
// to another (points_to.dl).
.decl kept_in_dictionary(table: symbol)
.input kept_in_dictionary

// The Task operation at `site` in `func` does `op` to the task `proc`,
// and the tasks whose handle goes where value flow does not follow it
// (clientlib/task_handles.dl).
.decl task_handled(func: symbol, site: symbol, op: symbol, proc: symbol)
.input task_handled

.decl task_escapes(proc: symbol)
.input task_escapes

// `func` waits on the task started at `start`, which runs `runs`: an await, yield or
// await_many it makes is handed that task (see runs_elsewhere.dl).
.decl awaits_task(func: symbol, start: symbol, runs: symbol)

awaits_task(f, start, g) :-
  task_handled(f, _, op, p),
  task_wait(op),
  process_start(start, _, p, "spawn", g).

// ── Derived here, over the staged rows ─────────────────────────────

// Everything that goes to a process: a call, cast or send; signals.dl
// adds the signals.
.decl pid_use(id: symbol, func: symbol, kind: symbol, src_kind: symbol, src: symbol)

pid_use(id, f, kind, sk, s) :- process_call_source(id, f, kind, sk, s).

// `func` calls or casts to `proc`, itself or through a helper.
.decl call_target(func: symbol, api_kind: symbol, proc: symbol)

call_target(f, kind, p) :- process_call(f, _, _, kind, p).

// The module whose code starts a process.
.decl started_by_module(proc: symbol, mod: symbol)

started_by_module(p, m) :- process_start(_, f, p, _, _), function_def(f, m, _, _, _).
started_by_module(p, m) :- private_process(p, f, _), function_def(f, m, _, _, _).
