// RPC targets by site. Resolve literal module, function, and argument-list length
// through rpc_callee. For wrappers, propagate consecutive MFA parameters and join
// caller mfa_arg values, including captured closure arguments. Invalid names or arities
// fail remotely with undef. Requires imports.dl.

// Parameters pos, pos + 1 and pos + 2 supply the RPC's module, function and argument
// list. The wrapper either calls the RPC directly or forwards them at the same
// positions to another wrapper.
.decl forwards_to_rpc(wrapper: symbol, pos: number, rpc: symbol)

forwards_to_rpc(wrapper, pos, rpc) :- rpc_mfa_param(rpc, wrapper, pos).

forwards_to_rpc(wrapper, pos, rpc) :-
  forwards_to_rpc(inner, inner_pos, rpc),
  call_arg_forward(wrapper, inner, inner_pos, pos),
  call_arg_forward(wrapper, inner, inner_pos + 1, pos + 1),
  call_arg_forward(wrapper, inner, inner_pos + 2, pos + 2).

// Resolve literal RPC module/function targets at the RPC or a forwarding wrapper call.
// `anchor` identifies that local call.
.decl rpc_runs(rpc: symbol, callee: symbol, module: symbol, func: symbol, anchor: symbol)

rpc_runs(rpc, callee, module, func, rpc) :- rpc_callee(rpc, func, module, callee).

rpc_runs(rpc, callee, module, func, anchor) :-
  mfa_arg(anchor, func, wrapper, pos, module, callee),
  forwards_to_rpc(wrapper, pos, rpc).
