// Interprocedural process points-to, composing `Argus.Extractors.TermFlow` summaries.
// Processes use allocation-site identities; factory results and supervised children
// receive caller-specific instances mapped to their base by `instance`. Terms use
// construction sites and field selectors.
// Sources include proc, param, result, name, self, obj, load, reply, and dict.
// Parameters merge possible callers, except unchanged returned parameters are resolved
// from each call's own argument. Only terms containing a process/table leaf are
// followed.
// Run once in points_to.dl and expose results through staged_processes.dl. Sends and
// signals have separate consumer views. In bounded mode, pervasive.dl resolves
// widespread leaves coarsely; exact mode excludes none.
// Requires imports, behaviours, callbacks, process_statem, and runs_elsewhere, with
// pervasive.dl included alongside it.

// ── Processes ───────────────────────────────────────────────────────

// A process running a module's callbacks, identified by an explicit start or a
// supervisor child spec. The spec can identify the callback module even when its own
// start call is not visible.
.decl server_process(proc: symbol, mod: symbol)

server_process(p, m) :- process_start(_, _, p, "server", m).

server_process(cat("child ", cat(s, cat("#", to_string(pos)))), m) :-
  supervisor_child(s, pos, m, _, _),
  behaves_as(m, "GenServer").

// Factory instances
//
// A process factory's returned pid is renamed at each call that retains it,
// distinguishing private instances from supervised siblings. Wrapped results use
// `result <site>` and `start <site>` identities; child specs receive their own
// instance. `instance` retains the original allocation as base, which also represents
// unseen callers.
.decl start_object(obj: symbol, proc: symbol)

start_object(t, b) :-
  process_start(t, _, b, _, _),
  value_object(_, t, "tuple", ":ok", "2"),
  value_field(_, t, "{1}", "proc", b).

// `func` returns `x`, allocated while it ran: its own start's result, or
// its callee's returned as it is.
.decl fresh_return(func: symbol, x: symbol)

fresh_return(g, t) :- value_return(g, "obj", t), start_object(t, _).
fresh_return(g, b) :- value_return(g, "proc", b), process_start(_, g, b, _, _).
fresh_return(g, x) :- value_return(g, "result", c), value_result(c, g, h), fresh_return(h, x).

.decl fresh_base(x: symbol, base: symbol)

fresh_base(t, b) :- start_object(t, b).
fresh_base(b, b) :- process_start(_, _, b, _, _).

// A call that keeps a factory's fresh value: the instance it names.
.decl kept_fresh(site: symbol, func: symbol, x: symbol)

kept_fresh(c, f, x) :-
  value_result(c, f, g),
  fresh_return(g, x),
  !value_return(f, "result", c).

// A process and the start site it comes from.
.decl instance(proc: symbol, base: symbol)

instance(b, b) :- process_start(_, _, b, _, _).
instance(cat("start ", c), b) :- kept_fresh(c, _, x), fresh_base(x, b).

instance(cat("child ", cat(s, cat("#", to_string(pos)))), b) :-
  supervisor_child(s, pos, m, _, _),
  fresh_return(cat(m, ":start_link/1"), x),
  fresh_base(x, b).

server_process(i, m) :- instance(i, b), process_start(_, _, b, "server", m).

// A supervisor's child, and a process a function keeps for itself: the
// two a rule about siblings must tell apart.
.decl supervised_process(proc: symbol, sup: symbol, pos: number)

supervised_process(cat("child ", cat(s, cat("#", to_string(pos)))), s, pos) :-
  supervisor_child(s, pos, _, _, _).

.decl private_process(proc: symbol, func: symbol, site: symbol)

private_process(cat("start ", c), f, c) :- kept_fresh(c, f, _).

private_process(b, f, id) :-
  process_start(id, f, b, _, _),
  !fresh_return(f, b),
  !fresh_return(f, id).

// Every process the program names.
.decl process(proc: symbol)

process(p) :- instance(p, _).
process(p) :- server_process(p, _).

// Recursive join plans start from newly derived tuples rather than rescanning static
// arguments, loads, and returns. `load_base` and `update_base` factor joins so new
// fields meet only the relevant operations.

// A parameter, a callee's result, a term's field: each may point to a
// process or to a term.
.decl param_pts(func: symbol, pos: symbol, x: symbol)
.decl returns_pts(func: symbol, x: symbol)
.decl field_pts(obj: symbol, sel: symbol, x: symbol)

// A registered name may hold a pid of `proc`.
.decl named_pid(name: symbol, proc: symbol)

// A source, as seen from inside `func`, may point to `x`.
.decl source_pts(func: symbol, src_kind: symbol, src: symbol, x: symbol)

// The name and self sources each function reads, so the rules resolving
// them are bound by the function that uses them.
.decl reads_name(func: symbol, name: symbol)

reads_name(f, n) :- value_arg(_, f, _, _, _, "name", n).
reads_name(f, n) :- value_return(f, "name", n).
reads_name(f, n) :- process_call_source(_, f, _, "name", n).
reads_name(f, n) :- process_message_source(_, f, _, "name", n).
reads_name(f, n) :- process_register_source(_, f, _, "name", n).
reads_name(f, n) :- value_field(f, _, _, "name", n).
reads_name(f, n) :- value_base(f, _, "name", n).
reads_name(f, n) :- process_signal_source(_, f, _, "name", n).
reads_name(f, n) :- task_op_source(_, f, _, "name", n).
reads_name(f, n) :- value_escape(_, f, "name", n).

source_pts(f, "proc", p, p) :- process_start(_, f, p, _, _), !pervasive(p).

// Follow only terms containing a process or table leaf, directly or through another
// term. Every field_pts row points to a leaf or such a term, so it also proves that its
// containing term is relevant.
source_pts(f, "obj", o, o) :- value_object(f, o, _, _, _), holds_leaf(o).
.plan 0:(2,1)

.decl holds_leaf(obj: symbol)

holds_leaf(o) :- field_pts(o, _, _).

source_pts(f, "param", k, x) :- param_pts(f, k, x).
// A callee's result; a factory's fresh value is renamed where it is kept.
source_pts(f, "result", c, x) :- value_result(c, f, g), returns_pts(g, x), !fresh_return(g, x).
.plan 0:(2,1)

// A callee that hands its parameter back returns, at this call, what
// this call passed it (see "Returns" below).
source_pts(f, "result", c, x) :-
  value_result(c, f, g),
  passes(g, j),
  value_arg(c, f, g, j, "call", sk, s),
  source_pts(f, sk, s, x),
  !fresh_return(g, x).
.plan 0:(4,3,1,2)

source_pts(f, "result", c, x) :-
  value_result(c, f, g),
  fresh_return(g, x),
  value_return(f, "result", c),
  !pervasive(x).

// A library call running the program's fun on elements (element_fun) answers what the
// fun answers, its parameters included: they are the elements and accumulator this call
// hands it, and captures, both entries of the fun (returns_all), not a caller's
// arguments to resolve per call.
source_pts(f, "result", c, x) :-
  element_fun(c, f, g, _),
  value_result(c, f, g),
  returns_all(g, x),
  !fresh_return(g, x).

source_pts(f, "result", c, cat("start ", c)) :-
  kept_fresh(c, f, x),
  process_start(_, _, x, _, _),
  !pervasive(cat("start ", c)).

source_pts(f, "result", c, cat("result ", c)) :- kept_fresh(c, f, x), start_object(x, _).
source_pts(f, "name", n, p) :- reads_name(f, n), named_pid(n, p), !pervasive(p).
source_pts(f, "dict", k, x) :- dict_read(f, k, g, sk, s), source_pts(g, sk, s, x).
.plan 0:(2,1)

// A helper returning a dictionary entry returns the value held by the caller's process
// at that call.
source_pts(f, "result", c, x) :- value_result(c, f, g), returns_key(g, k), source_pts(f, "dict", k, x).
.plan 0:(3,1,2)
source_pts(f, "self", "self", p) :- self_pid(f, p), !pervasive(p).

// ETS tables are allocation leaves named "table <site>". They are neither processes nor
// field-bearing terms. tables.dl uses these identities to track tables allocated by
// :ets.new/2.
source_pts(f, "table", t, t) :- table_alloc(_, f, t), !pervasive(t).

// GenServer.call may return the reply field of any {:reply, reply, state} from the
// server's handle_call/3, without filtering by request clause.
source_pts(f, "reply", id, x) :-
  message_target(id, f, "call", p),
  server_process(p, m),
  function_def(h, m, "handle_call", 3, _),
  returns_all(h, t),
  value_object(_, t, "tuple", ":reply", _),
  field_pts(t, "{1}", x).

// A load reads a field of whatever its base points to.
source_pts(f, "load", l, x) :- load_base(f, l, sel, o), reads_field(o, sel, x).
.plan 1:(2,1)

// Index field loads by their source term, so new field facts join only that term's
// loads.
.decl load_base(func: symbol, load: symbol, sel: symbol, obj: symbol)

load_base(f, l, sel, o) :- value_load(f, l, sel, bk, bs), source_pts(f, bk, bs, o).
.plan 0:(2,1)

// A field read sees the named field and unknown-key writes. Unknown-key reads see only
// unknown-key writes, avoiding merges of every struct field. Derive results only for
// selectors the program reads.
.decl reads_field(obj: symbol, sel: symbol, x: symbol)
.decl field_read(obj: symbol, sel: symbol)

field_read(o, sel) :- load_base(_, _, sel, o).

field_read(o, sel) :-
  targets_field(g, _, sel, _, _),
  value_arg(_, f, g, _, "call", sk, s),
  source_pts(f, sk, s, o).

reads_field(o, sel, x) :- field_read(o, sel), field_pts(o, sel, x).

reads_field(o, sel, x) :-
  field_read(o, sel),
  value_object(_, o, "map", _, _),
  field_pts(o, "*", x).
.plan 1:(3,2,1)

// Enumerating a map yields its {key, value} pairs: an element read (`[]`) of a map
// is a pair the map stands for, `pair <map>`, its key what the map holds under `@key`
// (keys that are not literals) and its value any other field. `**` reads any field
// (Tuple.to_list/1).
reads_field(o, "[]", cat("pair ", o)) :-
  field_read(o, "[]"),
  value_object(_, o, "map", _, _),
  holds_leaf(o).

field_pts(cat("pair ", o), "{0}", x) :-
  field_read(o, "[]"),
  value_object(_, o, "map", _, _),
  field_pts(o, "@key", x).

field_pts(cat("pair ", o), "{1}", x) :-
  field_read(o, "[]"),
  value_object(_, o, "map", _, _),
  field_pts(o, sel, x),
  sel != "@key".

reads_field(o, "**", x) :- field_read(o, "**"), field_pts(o, _, x).

field_pts(o, sel, x) :- value_field(f, o, sel, sk, s), source_pts(f, sk, s, x).
.plan 0:(2,1)

// A kept `{:ok, pid}` holds its own instance.
field_pts(cat("result ", c), "{1}", cat("start ", c)) :-
  kept_fresh(c, _, x),
  start_object(x, _),
  !pervasive(cat("start ", c)).

// An update keeps the fields it does not set; a cons cell's tail holds
// the rest of the elements.
field_pts(o, sel, x) :- update_base(o, b), field_pts(b, sel, x), !value_sets(o, sel).
.plan 1:(2,1)

// The term an update copies the fields it does not set from.
.decl update_base(obj: symbol, base: symbol)

update_base(o, b) :- value_base(f, o, bk, bs), source_pts(f, bk, bs, b).
.plan 0:(2,1)

// Fresh returns
//
// Keep unchanged returned parameters in `passes`, resolving them against each caller's
// argument. `returns_pts` contains other values. Split forwarded callee results the
// same way to avoid mixing one caller's argument into every other's result.
returns_pts(g, x) :-
  value_return(g, k, s),
  k != "param",
  k != "result",
  k != "dict",
  source_pts(g, k, s, x).
.plan 0:(2,1)

returns_pts(g, x) :- value_return(g, "result", c), value_result(c, g, h), returns_pts(h, x).
.plan 0:(3,2,1)

// Returning what a library call running a fun answers returns what that call resolves
// to here, the fun's parameters included (source_pts above).
returns_pts(g, x) :-
  value_return(g, "result", c),
  element_fun(c, g, _, _),
  source_pts(g, "result", c, x).

// What the callee allocated while it ran (fresh_return) is the caller's
// result by whichever of these rules it also arrives.
returns_pts(g, x) :- value_return(g, "result", c), value_result(c, g, h), fresh_return(h, x).

returns_pts(g, x) :-
  value_return(g, "result", c),
  value_result(c, g, h),
  passes(h, i),
  value_arg(c, g, h, i, "call", sk, s),
  sk != "param",
  source_pts(g, sk, s, x).
.plan 0:(5,4,2,1,3)

// `func` may return its parameter `pos` as it was passed: directly, or
// as a callee's result that hands back what `func` passed it there.
.decl passes(func: symbol, pos: symbol)

passes(g, j) :- value_return(g, "param", j).

passes(g, j) :-
  value_return(g, "result", c),
  value_result(c, g, h),
  passes(h, i),
  value_arg(c, g, h, i, "call", "param", j).

// All returned values, including forwarded parameters. This also models callback
// results whose arguments are supplied by the runtime.
.decl returns_all(func: symbol, x: symbol)

returns_all(g, x) :- returns_pts(g, x).
returns_all(g, x) :- passes(g, j), param_pts(g, j, x).
.plan 0:(2,1)
returns_all(g, x) :- returns_key(g, k), source_pts(g, "dict", k, x).

// `entry_pts` contains runtime-supplied arguments: init, spawn, child-spec, closure
// captures, callback state, and messages. `param_pts` also includes ordinary callers.
// Resolve callback and spawned-body uses against entry arguments rather than lifting
// them to runtime machinery.
.decl entry_pts(func: symbol, pos: symbol, x: symbol)

entry_pts(g, k, x) :- entry_arg(f, g, k, sk, s), source_pts(f, sk, s, x).
.plan 0:(2,1)

// Process-start arguments passed to entry functions. Keep these non-call value_arg rows
// separate from ordinary call arguments.
.decl entry_arg(caller: symbol, func: symbol, pos: symbol, src_kind: symbol, src: symbol)

entry_arg(f, g, k, sk, s) :- value_arg(_, f, g, k, via, sk, s), via != "call".

param_pts(g, k, x) :- entry_pts(g, k, x).
param_pts(g, k, x) :- value_arg(_, f, g, k, "call", sk, s), source_pts(f, sk, s, x).
.plan 0:(2,1)

// A registration (register/2, :global.register_name/2, Registry.register/3,
// or a start with a literal name) stores the pid it resolves to.
named_pid(n, p) :- process_register_source(_, f, n, k, s), source_pts(f, k, s, p), process(p).

// A name registered by a start names every instance of it.
named_pid(n, i) :- named_pid(n, b), instance(i, b), i != b.

// A child spec's `name:` names the child it starts.
named_pid(n, cat("child ", cat(s, cat("#", to_string(pos))))) :-
  supervisor_child_name(s, pos, n),
  supervisor_child(s, pos, m, _, _),
  behaves_as(m, "GenServer").

// Fallback to named_process for unresolved names. Its module-level assumption can
// misattribute Process.register calls that register another process's PID.
.decl resolved_name(name: symbol)

resolved_name(n) :- process_register_source(_, _, n, _, _).
resolved_name(n) :- supervisor_child_name(_, _, n).

named_pid(n, p) :-
  named_process(mod, n),
  !resolved_name(n),
  server_process(p, mod).

// Process-dictionary points-to
//
// A literal-key read may see puts from functions sharing a same-process caller or
// callbacks of one module. Order and erases are ignored here; dictionary.dl handles
// ordering. Shared code can merge different processes' values.
// External puts, computed keys, applies, and separate APIs used sequentially by an
// unseen caller are not connected.

// A helper returning a dictionary key is resolved at each call in the caller's process,
// like a forwarded parameter. Keep it out of shared `returns_pts` so server and
// external callers do not inherit each other's dictionary values.
.decl returns_key(func: symbol, key: symbol)

returns_key(g, k) :- value_return(g, "dict", k).
returns_key(g, k) :- value_return(g, "result", c), value_result(c, g, h), returns_key(h, k).

// A dictionary read of `key` in `func`, and each put of it the same
// process may make, in `putter`, of the source (sk, s).
.decl dict_read(func: symbol, key: symbol, putter: symbol, src_kind: symbol, src: symbol)

dict_read(f, k, g, sk, s) :-
  reads_dict(f, k),
  dict_put(_, g, k, sk, s),
  shares_dictionary(f, g).

// The dict sources each function reads, so the rules resolving them are
// bound by the function that uses them.
.decl reads_dict(func: symbol, key: symbol)

reads_dict(f, k) :- value_arg(_, f, _, _, _, "dict", k).
reads_dict(f, k) :- value_return(f, "dict", k).
reads_dict(f, k) :- process_call_source(_, f, _, "dict", k).
reads_dict(f, k) :- process_message_source(_, f, _, "dict", k).
reads_dict(f, k) :- process_register_source(_, f, _, "dict", k).
reads_dict(f, k) :- value_field(f, _, _, "dict", k).
reads_dict(f, k) :- value_base(f, _, "dict", k).
reads_dict(f, k) :- process_signal_source(_, f, _, "dict", k).
reads_dict(f, k) :- value_load(f, _, _, "dict", k).
reads_dict(f, k) :- table_use(_, f, "dict", k).
reads_dict(f, k) :- dict_put(_, f, _, "dict", k).
reads_dict(f, k) :- task_op_source(_, f, _, "dict", k).
reads_dict(f, k) :- value_escape(_, f, "dict", k).
reads_dict(f, k) :- value_result(_, f, g), returns_key(g, k).

// Seed same-process dictionary reachability from reads and writes whose keys have a
// corresponding write or read elsewhere.
.init dict_stack = SameProcessReach

dict_stack.seed(f, f) :- reads_dict(f, k), dict_put(_, _, k, _, _).
dict_stack.seed(g, g) :- dict_put(_, g, k, _, _), reads_dict(_, k).

// `func` and other may share a process dictionary if one stack reaches both or they are
// callbacks of the same module.
.decl shares_dictionary(func: symbol, other: symbol)

shares_dictionary(f, g) :-
  reads_dict(f, k),
  dict_put(_, g, k, _, _),
  dict_stack.reaches(a, f),
  dict_stack.reaches(a, g).

shares_dictionary(f, g) :-
  reads_dict(f, k),
  dict_put(_, g, k, _, _),
  dict_stack.reaches(a, f),
  process_entry(m, a),
  process_entry(m, b),
  dict_stack.reaches(b, g).

// ── Who runs a function ─────────────────────────────────────────────

// self() resolves to the server or spawned process running the function and propagates
// along its own stack. Exclude spawned, stored, or deferred fun execution. Traverse
// only paths leading to a self() use.
.decl self_pid(func: symbol, proc: symbol)

self_pid(f, p) :- process_entry(m, f), server_process(p, m).
self_pid(f, p) :- instance(p, b), process_start(_, _, b, "spawn", f).

self_pid(g, p) :-
  self_pid(f, p),
  same_process_call(f, g),
  self_relevant(g).

// Call edges that execute on the caller's stack. Exclude closure creation and function
// arguments started elsewhere.
.decl same_process_call(caller: symbol, callee: symbol)

same_process_call(f, g) :- call_edge(f, g), !runs_elsewhere(f, g).

.decl reads_self(func: symbol)

reads_self(f) :- value_arg(_, f, _, _, _, "self", _).
reads_self(f) :- value_return(f, "self", _).
reads_self(f) :- process_call_source(_, f, _, "self", _).
reads_self(f) :- process_message_source(_, f, _, "self", _).
reads_self(f) :- process_register_source(_, f, _, "self", _).
reads_self(f) :- value_field(f, _, _, "self", _).
reads_self(f) :- value_base(f, _, "self", _).
reads_self(f) :- process_signal_source(_, f, _, "self", _).

.decl self_relevant(func: symbol)

self_relevant(f) :- reads_self(f).
self_relevant(f) :- same_process_call(f, g), self_relevant(g).

// ── A GenServer's state ─────────────────────────────────────────────

// Callback return tuples supply the state for the next handler or terminate/2. Select
// the state field from ok, reply, noreply and stop tuples, including forms with
// trailing timeout or continue values.
.decl state_out(mod: symbol, func: symbol)
.decl state_in(mod: symbol, func: symbol, pos: symbol)
.decl state_slot(tag: symbol, arity: symbol, sel: symbol)

state_slot(":ok", "2", "{1}").
state_slot(":ok", "3", "{1}").
state_slot(":reply", "3", "{2}").
state_slot(":reply", "4", "{2}").
state_slot(":noreply", "2", "{1}").
state_slot(":noreply", "3", "{1}").
state_slot(":stop", "3", "{2}").
state_slot(":stop", "4", "{3}").

state_out(m, f) :- behaves_as(m, "GenServer"), function_def(f, m, "init", 1, _).
// terminate/2's return goes nowhere: no callback is called with it.
state_out(m, f) :- state_in(m, f, _), !function_def(f, m, "terminate", 2, _).

state_in(m, f, "2") :- behaves_as(m, "GenServer"), function_def(f, m, "handle_call", 3, _).
state_in(m, f, "1") :-
  behaves_as(m, "GenServer"),
  function_def(f, m, name, 2, _),
  (name = "handle_cast" ; name = "handle_info" ; name = "handle_continue" ; name = "terminate").

// A term the server may hold as its state.
.decl state_pts(mod: symbol, x: symbol)

state_pts(m, x) :-
  state_out(m, g),
  returns_all(g, t),
  value_object(_, t, "tuple", tag, n),
  state_slot(tag, n, sel),
  field_pts(t, sel, x).

entry_pts(f, k, x) :- state_in(m, f, k), state_pts(m, x).

// ── What the pids reach ─────────────────────────────────────────────

// Parameter-based process targets
//
// Summarize target parameters or their immediate fields and resolve them at each
// caller, preserving caller-specific dependencies and anchors. Summaries support
// arbitrary helper depth; nested fields fall back to context-insensitive resolution.
// Runtime entry arguments use `entry_pts` locally because process machinery is not a
// waiting caller.
.decl targets_param(func: symbol, pos: symbol, api_kind: symbol, site: symbol)
.decl targets_field(func: symbol, pos: symbol, sel: symbol, api_kind: symbol, site: symbol)

// Everything that goes to a process: a call, cast or send (process_call_source),
// an exit signal, a monitor or a link (process_signal_source).
.decl pid_use(id: symbol, func: symbol, kind: symbol, src_kind: symbol, src: symbol)

pid_use(id, f, kind, sk, s) :- process_call_source(id, f, kind, sk, s).
pid_use(id, f, kind, sk, s) :- process_signal_source(id, f, kind, sk, s).

targets_param(g, k, kind, id) :- pid_use(id, g, kind, "param", k).
targets_param(f, j, kind, id) :-
  value_arg(_, f, g, k, "call", "param", j),
  targets_param(g, k, kind, id).

targets_field(g, k, sel, kind, id) :-
  pid_use(id, g, kind, "load", l),
  value_load(g, l, sel, "param", k).

targets_field(f, j, sel, kind, id) :-
  value_arg(_, f, g, k, "call", "param", j),
  targets_field(g, k, sel, kind, id).

// A load whose base is a parameter: resolved through its summary, not in
// place (unless the parameter is an entry's).
.decl param_load(func: symbol, load: symbol)

param_load(f, l) :- value_load(f, l, _, "param", _).

// A field of what a source points to, a map's unknown-key field included.
.decl source_field_pts(func: symbol, src_kind: symbol, src: symbol, sel: symbol, x: symbol)

source_field_pts(f, sk, s, sel, x) :-
  targets_field(g, _, sel, _, _),
  value_arg(_, f, g, _, "call", sk, s),
  source_pts(f, sk, s, o),
  reads_field(o, sel, x).

// A call, cast, send, exit, monitor, link, or unlink targeting proc. `site` is the
// actual use; `anchor` is func's call into a helper, or the site itself. The stage
// exports calls/casts/sends as process_call and signals as process_signal; signals.dl
// combines them.
.decl process_call(func: symbol, anchor: symbol, site: symbol, api_kind: symbol, proc: symbol)

// A target `func` resolves itself.
process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, sk, s),
  sk != "param",
  sk != "load",
  source_pts(f, sk, s, p),
  process(p).

process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  !param_load(f, l),
  source_pts(f, "load", l, p),
  process(p).

// A field read from a source other than a parameter.
process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  value_load(f, l, sel, bk, bs),
  bk != "param",
  source_pts(f, bk, bs, o),
  reads_field(o, sel, p),
  process(p).

// An entry's own parameter, or a field of it.
process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "param", k),
  entry_pts(f, k, p),
  process(p).

process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  value_load(f, l, sel, "param", k),
  entry_pts(f, k, o),
  reads_field(o, sel, p),
  process(p).

// A helper's parameter, resolved at the caller that knows the pid.
process_call(f, a, id, kind, p) :-
  value_arg(a, f, g, k, "call", sk, s),
  sk != "param",
  targets_param(g, k, kind, id),
  source_pts(f, sk, s, p),
  process(p).
.plan 0:(2,1,3,4)

process_call(f, a, id, kind, p) :-
  value_arg(a, f, g, k, "call", "param", j),
  targets_param(g, k, kind, id),
  entry_pts(f, j, p),
  process(p).
.plan 0:(2,1,3,4)

// A helper reading a field of its parameter: the caller's term's field.
process_call(f, a, id, kind, p) :-
  value_arg(a, f, g, k, "call", sk, s),
  sk != "param",
  targets_field(g, k, sel, kind, id),
  source_field_pts(f, sk, s, sel, p),
  process(p).
.plan 0:(2,1,3,4)

process_call(f, a, id, kind, p) :-
  value_arg(a, f, g, k, "call", "param", j),
  targets_field(g, k, sel, kind, id),
  entry_pts(f, j, o),
  reads_field(o, sel, p),
  process(p).
.plan 0:(2,1,3,4,5), 1:(2,1,3,4,5)

// The call, cast or send at `id` in `func` may target `proc`, whoever
// supplies it.
.decl call_site_target(id: symbol, func: symbol, api_kind: symbol, proc: symbol)

call_site_target(id, g, kind, p) :-
  process_call(_, _, id, kind, p),
  process_call_source(id, g, kind, _, _).

// Resolve destinations of call/cast/send messages and call replies. Bounded staging may
// use coarse targets for pervasive sources; see pervasive.dl.
.decl message_target(id: symbol, func: symbol, api_kind: symbol, proc: symbol)

message_target(id, g, kind, p) :- call_site_target(id, g, kind, p).

// A synchronous call provably targets its own process, by self() or a name held
// exclusively by that module's servers. gen exits with calling_self.
.decl self_call(func: symbol, site: symbol)

self_call(f, id) :- process_call_source(id, f, "call", "self", "self").

// self() handed to a helper that calls its parameter: the call into the
// helper, in the function that owns the self().
self_call(f, a) :-
  value_arg(a, f, g, k, "call", "self", _),
  targets_param(g, k, "call", _).

.decl named_module(name: symbol, mod: symbol)

named_module(n, m) :- named_pid(n, p), server_process(p, m).

.decl named_otherwise(name: symbol, mod: symbol)

named_otherwise(n, m) :- named_module(n, m), named_pid(n, p), !server_process(p, m).

self_call(f, id) :-
  process_call_source(id, f, "call", "name", n),
  process_entry(m, f),
  named_module(n, m),
  !named_otherwise(n, m).

// ── Messages ────────────────────────────────────────────────────────

// A call, cast or send passes its message to the resolved server handler's first
// parameter. Match the message and target from the same call site.
.decl message_handler(api_kind: symbol, name: symbol, arity: number)

message_handler("call", "handle_call", 3).
message_handler("cast", "handle_cast", 2).
message_handler("info", "handle_info", 2).

entry_pts(h, "0", x) :-
  process_message_source(id, f, kind, sk, s),
  source_pts(f, sk, s, x),
  message_target(id, f, kind, p),
  server_process(p, m),
  message_handler(kind, name, arity),
  function_def(h, m, name, arity, _).

// gen_statem data flow. Return tuples supply data for the next state function or
// terminate/3. Handle ok, next_state, keep_state, repeat_state, stop and stop_and_reply
// forms, including optional actions.
.decl statem_data_slot(tag: symbol, arity: symbol, sel: symbol)

statem_data_slot(":ok", "3", "{2}").
statem_data_slot(":ok", "4", "{2}").
statem_data_slot(":next_state", "3", "{2}").
statem_data_slot(":next_state", "4", "{2}").
statem_data_slot(":keep_state", "2", "{1}").
statem_data_slot(":keep_state", "3", "{1}").
statem_data_slot(":repeat_state", "2", "{1}").
statem_data_slot(":repeat_state", "3", "{1}").
statem_data_slot(":stop", "3", "{2}").
statem_data_slot(":stop_and_reply", "4", "{3}").

.decl statem_data_out(mod: symbol, func: symbol)

statem_data_out(m, f) :- statem_process(m), function_def(f, m, "init", 1, _).
statem_data_out(m, f) :- statem_event_clause(m, f, _).

// State functions take (event_type, content, data); handle_event/4 takes
// (event_type, content, state, data); terminate/3 (reason, state, data).
.decl statem_data_in(mod: symbol, func: symbol, pos: symbol)

statem_data_in(m, f, "2") :- statem_event_clause(m, f, _), function_def(f, m, _, 3, _).
statem_data_in(m, f, "3") :- statem_event_clause(m, f, _), function_def(f, m, "handle_event", 4, _).
statem_data_in(m, f, "2") :- statem_process(m), function_def(f, m, "terminate", 3, _).

.decl statem_data_pts(mod: symbol, x: symbol)

statem_data_pts(m, x) :-
  statem_data_out(m, g),
  returns_all(g, t),
  value_object(_, t, "tuple", tag, n),
  statem_data_slot(tag, n, sel),
  field_pts(t, sel, x).

entry_pts(f, k, x) :- statem_data_in(m, f, k), statem_data_pts(m, x).

// A call, cast or send to a gen_statem is an event: its message is the
// state function's content, the second parameter.
entry_pts(h, "1", x) :-
  process_message_source(id, f, kind, sk, s),
  source_pts(f, sk, s, x),
  message_target(id, f, kind, p),
  server_process(p, m),
  statem_event_clause(m, h, _).
