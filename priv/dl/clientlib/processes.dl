// Which process a pid can be: the interprocedural half of process
// points-to. Argus.Extractors.PidFlow summarises each function (where the
// values it passes on, returns, calls, registers and sends to come from,
// and the terms it builds); this file chains the summaries.
//
// The objects are processes and the terms that hold them. A process is
// named by the site that started it (process_start: "spawn <id>",
// "server <id>"); a start inside a function that returns it is a
// factory, and each call that keeps what the factory returns is its own
// process ("start <call site>"), as is the child a supervisor's child
// spec starts through it ("child <sup>#<pos>"). instance(proc, base)
// maps each to its start site; server_process is the module-level view.
// A term is named by the instruction that built it
// (pid_object), with a field per map key, tuple position or list element,
// so two pids in one state map stay two pids. A source is one of
//   proc   — the process started at a site in the same function;
//   param  — the function's parameter at a position;
//   result — what a project call at a site returned;
//   name   — a pid registered under a literal name;
//   self   — self(), which is whichever process runs the function;
//   obj    — a term the function built;
//   load   — a field read from a term the function did not build;
//   reply  — what a GenServer.call at a site returned;
//   dict   — what the running process keeps in its dictionary under a
//            literal key (see "The process dictionary" below).
// Parameters are context-insensitive, like Andersen's analysis: a
// parameter points to everything any caller passes it. That is "may
// point to", and a rule that concludes something from it asks what a
// process does NOT do. Two things keep that from costing more than the
// answer is worth:
//
// - Only a term that holds a leaf (a process or a table, directly or in
//   a term it holds) is followed as an object. The others cannot lead a
//   use to a leaf, and the rules below only ever ask where the leaves go:
//   every row of every staged relation is the same with them or without
//   them, and on a large program they are most of the terms.
// - A callee that hands its parameter back (`def put(x), do: x`, or a
//   helper returning what such a callee returned of it) returns, at each
//   call, what that call passed it, not everything any caller passed it.
//   Merged at the parameter, one such helper made every caller's value
//   every other caller's; chained, the helpers of a large library made
//   one value of almost every term in it (see "Returns" below).
//
// The rules run once per program, in the points-to stage
// (priv/dl/points_to.dl), not in every analysis that asks: the fixpoint
// is most of what a solve over a large program costs, and it was
// recomputed by each of them. The stage stages what the analyses read
// (clientlib/staged_processes.dl declares it), and a gen_statem's data
// (process_statem.dl's process_entry rule), exit signals, monitors and
// links (pid_signal) and ETS tables (table_alloc) are followed here for
// every analysis alike. None of those changes what the others see: a
// signal's target is a use of its own kind, and a table is a leaf no
// process is read out of.
//
// Where sends go (sends.dl) and which signal goes where (signals.dl) are
// asked apart, over the staged targets, so an analysis that asks only
// about calls does not read every send or signal in the program.
//
// A leaf the stage finds pervasive (clientlib/pervasive.dl: only when the
// stage runs bounded, points_to_bounded.dl) is left out of these rules
// and resolved by the coarse pass there instead; in the stage as it
// runs by default no leaf is.
//
// Prerequisites: include clientlib/imports.dl, behaviours.dl,
// callbacks.dl, process_statem.dl and runs_elsewhere.dl before this file,
// and clientlib/pervasive.dl with it (points_to.dl does).

// ── Processes ───────────────────────────────────────────────────────

// A process running a module's callbacks: started by a start call in the
// program (a GenServer start, or a supervisor's start_child), or a
// GenServer a supervisor's child spec names, whose own start the program
// may not spell out (`start: {GenServer, :start_link, [Mod, arg]}`).
.decl server_process(proc: symbol, mod: symbol)

server_process(p, m) :- process_start(_, _, p, "server", m).

server_process(cat("child ", cat(s, cat("#", to_string(pos)))), m) :-
  supervisor_child(s, pos, m, _, _),
  behaves_as(m, "GenServer").

// ── Instances ───────────────────────────────────────────────────────
//
// `def start_link(arg), do: GenServer.start_link(__MODULE__, arg)` starts
// a new process each time it is called: its supervisor's call is one, a
// module's private `{:ok, conn} = Conn.start_link()` another. Named by
// the start site alone, the two were one process, and a private
// connection looked like the supervised sibling. So the value a factory
// returns — its own start's `{:ok, pid}` or bare pid, or its callee's,
// passed straight up — is renamed at each call that keeps it rather than
// returning it again: the object "result <site>" whose field {1} is the
// process "start <site>". A child spec's child is the process its
// module's start_link/1 returns. Every process keeps its start site as
// its base; the base itself stands for a start the program does not see
// the caller of.
.decl start_object(obj: symbol, proc: symbol)

start_object(t, b) :-
  process_start(t, _, b, _, _),
  pid_object(_, t, "tuple", ":ok", "2"),
  pid_field(_, t, "{1}", "proc", b).

// `func` returns `x`, allocated while it ran: its own start's result, or
// its callee's returned as it is.
.decl fresh_return(func: symbol, x: symbol)

fresh_return(g, t) :- pid_return(g, "obj", t), start_object(t, _).
fresh_return(g, b) :- pid_return(g, "proc", b), process_start(_, g, b, _, _).
fresh_return(g, x) :- pid_return(g, "result", c), pid_result(c, g, h), fresh_return(h, x).

.decl fresh_base(x: symbol, base: symbol)

fresh_base(t, b) :- start_object(t, b).
fresh_base(b, b) :- process_start(_, _, b, _, _).

// A call that keeps a factory's fresh value: the instance it names.
.decl kept_fresh(site: symbol, func: symbol, x: symbol)

kept_fresh(c, f, x) :-
  pid_result(c, f, g),
  fresh_return(g, x),
  !pid_return(f, "result", c).

// A process and the start site it comes from.
.decl instance(proc: symbol, base: symbol)

instance(b, b) :- process_start(_, _, b, _, _).
instance(cat("start ", c), b) :- kept_fresh(c, _, x), fresh_base(x, b).

instance(cat("child ", cat(s, cat("#", to_string(pos)))), b) :-
  supervisor_child(s, pos, m, _, _),
  fresh_return(cat(m, ":start_link/1"), x),
  fresh_base(x, b).

server_process(i, m) :- instance(i, b), process_start(_, _, b, "server", m).

// A supervisor's child, and a process a function keeps for itself: the
// two a rule about siblings must tell apart.
.decl supervised_process(proc: symbol, sup: symbol, pos: number)

supervised_process(cat("child ", cat(s, cat("#", to_string(pos)))), s, pos) :-
  supervisor_child(s, pos, _, _, _).

.decl private_process(proc: symbol, func: symbol, site: symbol)

private_process(cat("start ", c), f, c) :- kept_fresh(c, f, _).

private_process(b, f, id) :-
  process_start(id, f, b, _, _),
  !fresh_return(f, b),
  !fresh_return(f, id).

// Every process the program names.
.decl process(proc: symbol)

process(p) :- instance(p, _).
process(p) :- server_process(p, _).

// ── What a source points to ─────────────────────────────────────────
//
// The recursive rules carry `.plan`s that start each semi-naive version
// from its new tuples. In source order Souffle scanned all of pid_arg,
// pid_load or pid_return on every iteration to probe a few new
// source_pts rows: over a 751-module deps tree, most of each OTP
// analysis's solve. A join of a static relation with source_pts that a
// second recursive atom then extends (a load's base, an update's base)
// is named once (load_base, update_base) so a new field of a term meets
// the loads of that term, not every load.

// A parameter, a callee's result, a term's field: each may point to a
// process or to a term.
.decl param_pts(func: symbol, pos: symbol, x: symbol)
.decl returns_pts(func: symbol, x: symbol)
.decl field_pts(obj: symbol, sel: symbol, x: symbol)

// A registered name may hold a pid of `proc`.
.decl named_pid(name: symbol, proc: symbol)

// A source, as seen from inside `func`, may point to `x`.
.decl source_pts(func: symbol, src_kind: symbol, src: symbol, x: symbol)

// The name and self sources each function reads, so the rules resolving
// them are bound by the function that uses them.
.decl reads_name(func: symbol, name: symbol)

reads_name(f, n) :- pid_arg(_, f, _, _, _, "name", n).
reads_name(f, n) :- pid_return(f, "name", n).
reads_name(f, n) :- pid_call(_, f, _, "name", n).
reads_name(f, n) :- pid_message(_, f, _, "name", n).
reads_name(f, n) :- pid_register(_, f, _, "name", n).
reads_name(f, n) :- pid_field(f, _, _, "name", n).
reads_name(f, n) :- pid_base(f, _, "name", n).
reads_name(f, n) :- pid_signal(_, f, _, "name", n).

source_pts(f, "proc", p, p) :- process_start(_, f, p, _, _), !pervasive(p).

// A term is an object once it holds a leaf: a field of it points to one,
// or to a term that does. Only then can a use reach a leaf through it,
// so only then is it followed; field_pts only ever holds leaves and such
// terms, so any row of it says the term holds a leaf.
source_pts(f, "obj", o, o) :- pid_object(f, o, _, _, _), holds_leaf(o).
.plan 0:(2,1)

.decl holds_leaf(obj: symbol)

holds_leaf(o) :- field_pts(o, _, _).

source_pts(f, "param", k, x) :- param_pts(f, k, x).
// A callee's result; a factory's fresh value is renamed where it is kept.
source_pts(f, "result", c, x) :- pid_result(c, f, g), returns_pts(g, x), !fresh_return(g, x).
.plan 0:(2,1)

// A callee that hands its parameter back returns, at this call, what
// this call passed it (see "Returns" below).
source_pts(f, "result", c, x) :-
  pid_result(c, f, g),
  passes(g, j),
  pid_arg(c, f, g, j, "call", sk, s),
  source_pts(f, sk, s, x),
  !fresh_return(g, x).
.plan 0:(4,3,1,2)

source_pts(f, "result", c, x) :-
  pid_result(c, f, g),
  fresh_return(g, x),
  pid_return(f, "result", c),
  !pervasive(x).

source_pts(f, "result", c, cat("start ", c)) :-
  kept_fresh(c, f, x),
  process_start(_, _, x, _, _),
  !pervasive(cat("start ", c)).

source_pts(f, "result", c, cat("result ", c)) :- kept_fresh(c, f, x), start_object(x, _).
source_pts(f, "name", n, p) :- reads_name(f, n), named_pid(n, p), !pervasive(p).
source_pts(f, "dict", k, x) :- dict_read(f, k, g, sk, s), source_pts(g, sk, s, x).
.plan 0:(2,1)

// A callee that hands back what the dictionary holds under a key returns,
// at each call, what the caller's process holds there (see "The process
// dictionary" below).
source_pts(f, "result", c, x) :- pid_result(c, f, g), returns_key(g, k), source_pts(f, "dict", k, x).
.plan 0:(3,1,2)
source_pts(f, "self", "self", p) :- self_pid(f, p), !pervasive(p).

// An ETS table is an object too, allocated by the :ets.new/2 that made
// it (clientlib/tables.dl asks where it goes). Named "table <site>", so
// it is never a process nor a term a field is read out of: a leaf of
// every relation below.
source_pts(f, "table", t, t) :- table_alloc(_, f, t), !pervasive(t).

// A GenServer.call returns the server's reply: the second field of a
// `{:reply, reply, state}` its handle_call/3 returns. Every reply of the
// server, whichever clause the message reaches.
source_pts(f, "reply", id, x) :-
  message_target(id, f, "call", p),
  server_process(p, m),
  function_def(h, m, "handle_call", 3, _),
  returns_all(h, t),
  pid_object(_, t, "tuple", ":reply", _),
  field_pts(t, "{1}", x).

// A load reads a field of whatever its base points to.
source_pts(f, "load", l, x) :- load_base(f, l, sel, o), reads_field(o, sel, x).
.plan 1:(2,1)

// The term a load reads its field from. Named once, so that a new field
// of a term joins the loads of that term, not every load in the program.
.decl load_base(func: symbol, load: symbol, sel: symbol, obj: symbol)

load_base(f, l, sel, o) :- pid_load(f, l, sel, bk, bs), source_pts(f, bk, bs, o).
.plan 0:(2,1)

// What a read of field `sel` of `obj` may see: the field, and in a map a
// field written under a key not known, which may be any key. A read by a
// key not known sees only the latter: taking every field would make
// `Map.get(struct, key)` every pid the struct holds. Derived only for the
// reads the program makes (field_read), never for every term and selector.
.decl reads_field(obj: symbol, sel: symbol, x: symbol)
.decl field_read(obj: symbol, sel: symbol)

field_read(o, sel) :- load_base(_, _, sel, o).

field_read(o, sel) :-
  targets_field(g, _, sel, _, _),
  pid_arg(_, f, g, _, "call", sk, s),
  source_pts(f, sk, s, o).

reads_field(o, sel, x) :- field_read(o, sel), field_pts(o, sel, x).

reads_field(o, sel, x) :-
  field_read(o, sel),
  pid_object(_, o, "map", _, _),
  field_pts(o, "*", x).
.plan 1:(3,2,1)

field_pts(o, sel, x) :- pid_field(f, o, sel, sk, s), source_pts(f, sk, s, x).
.plan 0:(2,1)

// A kept `{:ok, pid}` holds its own instance.
field_pts(cat("result ", c), "{1}", cat("start ", c)) :-
  kept_fresh(c, _, x),
  start_object(x, _),
  !pervasive(cat("start ", c)).

// An update keeps the fields it does not set; a cons cell's tail holds
// the rest of the elements.
field_pts(o, sel, x) :- update_base(o, b), field_pts(b, sel, x), !pid_sets(o, sel).
.plan 1:(2,1)

// The term an update copies the fields it does not set from.
.decl update_base(obj: symbol, base: symbol)

update_base(o, b) :- pid_base(f, o, bk, bs), source_pts(f, bk, bs, b).
.plan 0:(2,1)

// ── Returns ─────────────────────────────────────────────────────────
//
// What a function returns, apart from the parameters it hands back as
// they came (`passes`): the values its callers get whoever called it.
// A parameter handed back is the caller's own argument (the result rule
// above), so it is kept out of here — merged here, a helper such as
// `def set(x), do: x` gave every caller's argument to every caller. A
// callee's result the function returns in turn is split the same way:
// the callee's own returns, and of what it hands back, the argument this
// function passed it unless that is one of its parameters, which it then
// hands back itself.
returns_pts(g, x) :-
  pid_return(g, k, s),
  k != "param",
  k != "result",
  k != "dict",
  source_pts(g, k, s, x).
.plan 0:(2,1)

returns_pts(g, x) :- pid_return(g, "result", c), pid_result(c, g, h), returns_pts(h, x).
.plan 0:(3,2,1)

// What the callee allocated while it ran (fresh_return) is the caller's
// result by whichever of these rules it also arrives.
returns_pts(g, x) :- pid_return(g, "result", c), pid_result(c, g, h), fresh_return(h, x).

returns_pts(g, x) :-
  pid_return(g, "result", c),
  pid_result(c, g, h),
  passes(h, i),
  pid_arg(c, g, h, i, "call", sk, s),
  sk != "param",
  source_pts(g, sk, s, x).
.plan 0:(5,4,2,1,3)

// `func` may return its parameter `pos` as it was passed: directly, or
// as a callee's result that hands back what `func` passed it there.
.decl passes(func: symbol, pos: symbol)

passes(g, j) :- pid_return(g, "param", j).

passes(g, j) :-
  pid_return(g, "result", c),
  pid_result(c, g, h),
  passes(h, i),
  pid_arg(c, g, h, i, "call", "param", j).

// Everything a function returns, the parameters it hands back included:
// what the process machinery gets back from a callback, which no call in
// the program passed its arguments.
.decl returns_all(func: symbol, x: symbol)

returns_all(g, x) :- returns_pts(g, x).
returns_all(g, x) :- passes(g, j), param_pts(g, j, x).
.plan 0:(2,1)
returns_all(g, x) :- returns_key(g, k), source_pts(g, "dict", k, x).

// A parameter is filled by the process that runs the function as an
// entry — a server start's init argument, a spawned function's arguments,
// a child spec's argument, a closure's environment, and (below) a
// callback's state and message — or by a caller. Both are in param_pts;
// entry_pts holds the first kind alone, which is all a callback's or a
// spawned function's own calls can be resolved against.
.decl entry_pts(func: symbol, pos: symbol, x: symbol)

entry_pts(g, k, x) :- entry_arg(f, g, k, sk, s), source_pts(f, sk, s, x).
.plan 0:(2,1)

// The arguments a process's start hands its entry: the few pid_arg rows
// that are not calls, apart, so the rule above does not probe them all.
.decl entry_arg(caller: symbol, func: symbol, pos: symbol, src_kind: symbol, src: symbol)

entry_arg(f, g, k, sk, s) :- pid_arg(_, f, g, k, via, sk, s), via != "call".

param_pts(g, k, x) :- entry_pts(g, k, x).
param_pts(g, k, x) :- pid_arg(_, f, g, k, "call", sk, s), source_pts(f, sk, s, x).
.plan 0:(2,1)

// A registration (register/2, :global.register_name/2, Registry.register/3,
// or a start with a literal name) stores the pid it resolves to.
named_pid(n, p) :- pid_register(_, f, n, k, s), source_pts(f, k, s, p), process(p).

// A name registered by a start names every instance of it.
named_pid(n, i) :- named_pid(n, b), instance(i, b), i != b.

// A child spec's `name:` names the child it starts.
named_pid(n, cat("child ", cat(s, cat("#", to_string(pos))))) :-
  supervisor_child_name(s, pos, n),
  supervisor_child(s, pos, m, _, _),
  behaves_as(m, "GenServer").

// The module-level guess, for a name nothing above resolves:
// named_process says a module's process is registered under the name
// (ProcessRegistry assumes `Process.register(pid, n)` registers the
// caller's own module, which a registration of another pid is not).
.decl resolved_name(name: symbol)

resolved_name(n) :- pid_register(_, _, n, _, _).
resolved_name(n) :- supervisor_child_name(_, _, n).

named_pid(n, p) :-
  named_process(mod, n),
  !resolved_name(n),
  server_process(p, mod).

// ── The process dictionary ──────────────────────────────────────────
//
// Each process has a dictionary of its own: `put(key, value)` keeps a
// value there and a later `get(key)` in the same process reads it back
// (dict_op, dict_put; `erase/1` hands it back too). So a value is a heap
// field keyed by the literal key, like a registered name, except that
// only the process that put it can read it. A `dict` source of `key` in
// `func` points to what every put of `key` in a function the same
// process may run points to.
//
// Which functions one process runs is approximated from the call graph,
// on each process's own stack (runs_elsewhere cut, as SameProcessReach):
// a put and a read share a dictionary when some function reaches both
// (validate/1 calls create_tmp_config/0, which puts, and set_option/2,
// which reads), or when both are reached from callbacks of one module
// (a server's init/1 puts, its handle_call/3 reads). What that leaves
// out and adds:
//
// - Order is not asked: a put the process makes only after the read
//   counts, and so does a put an erase undoes (a MAY word: the value may
//   be there). The dictionary words over order are dictionary.dl's.
// - Two processes running the same code share its puts: a helper both
//   of two servers' callbacks call reads what either's callbacks put,
//   as a context-insensitive parameter holds every caller's value.
// - A function outside the program that puts (a dependency's
//   `Logger.metadata/1`), a key computed at run time, and a put through
//   `apply` are not followed: the read points to nothing, and the rules
//   on it stay quiet.
// - A put in a function no function of the program reaches along with
//   the read (each an API an outside caller calls in turn, in its own
//   process) is not connected: the program does not show one caller.

// A function returning what the dictionary holds under a key returns
// it at each call, in the caller's process: a helper such as
// `defp table, do: Process.get(:table)`, which both a server's callbacks
// and its API functions call, reads the server's put in the callbacks
// and nothing in the API's callers. So the value is not one of the
// helper's returns (returns_pts), and `returns_key` lifts it, like a
// parameter it hands back (passes), to each call.
.decl returns_key(func: symbol, key: symbol)

returns_key(g, k) :- pid_return(g, "dict", k).
returns_key(g, k) :- pid_return(g, "result", c), pid_result(c, g, h), returns_key(h, k).

// A dictionary read of `key` in `func`, and each put of it the same
// process may make, in `putter`, of the source (sk, s).
.decl dict_read(func: symbol, key: symbol, putter: symbol, src_kind: symbol, src: symbol)

dict_read(f, k, g, sk, s) :-
  reads_dict(f, k),
  dict_put(_, g, k, sk, s),
  shares_dictionary(f, g).

// The dict sources each function reads, so the rules resolving them are
// bound by the function that uses them.
.decl reads_dict(func: symbol, key: symbol)

reads_dict(f, k) :- pid_arg(_, f, _, _, _, "dict", k).
reads_dict(f, k) :- pid_return(f, "dict", k).
reads_dict(f, k) :- pid_call(_, f, _, "dict", k).
reads_dict(f, k) :- pid_message(_, f, _, "dict", k).
reads_dict(f, k) :- pid_register(_, f, _, "dict", k).
reads_dict(f, k) :- pid_field(f, _, _, "dict", k).
reads_dict(f, k) :- pid_base(f, _, "dict", k).
reads_dict(f, k) :- pid_signal(_, f, _, "dict", k).
reads_dict(f, k) :- pid_load(f, _, _, "dict", k).
reads_dict(f, k) :- table_use(_, f, "dict", k).
reads_dict(f, k) :- dict_put(_, f, _, "dict", k).
reads_dict(f, k) :- pid_result(_, f, g), returns_key(g, k).

// The functions a process's own stack reaches a dictionary read or put
// from: seeded at the functions holding a read of a key some function
// puts, and a put of a key some function reads.
.init dict_stack = SameProcessReach

dict_stack.seed(f, f) :- reads_dict(f, k), dict_put(_, _, k, _, _).
dict_stack.seed(g, g) :- dict_put(_, g, k, _, _), reads_dict(_, k).

// `func` and `other` may run in one process, as far as their dictionaries
// go: some function reaches both on its own stack, or callbacks of one
// module do.
.decl shares_dictionary(func: symbol, other: symbol)

shares_dictionary(f, g) :-
  reads_dict(f, k),
  dict_put(_, g, k, _, _),
  dict_stack.reaches(a, f),
  dict_stack.reaches(a, g).

shares_dictionary(f, g) :-
  reads_dict(f, k),
  dict_put(_, g, k, _, _),
  dict_stack.reaches(a, f),
  process_entry(m, a),
  process_entry(m, b),
  dict_stack.reaches(b, g).

// ── Who runs a function ─────────────────────────────────────────────

// self() in a server's callbacks (process_entry: its callbacks, init/1,
// terminate/2) is that server; in a spawned function, that spawn; and in
// a function either calls, the same process: a callback's helper, a
// client API a callback calls, or a closure handed to Enum.map runs on
// the caller's stack. What a start runs is not followed (runs_elsewhere:
// a task's closure is the task's), nor a fun registered or kept to run
// later (a :telemetry handler runs in the emitter), and only functions on
// the way to a self() are, so the relation stays the size of its use.
.decl self_pid(func: symbol, proc: symbol)

self_pid(f, p) :- process_entry(m, f), server_process(p, m).
self_pid(f, p) :- instance(p, b), process_start(_, _, b, "spawn", f).

self_pid(g, p) :-
  self_pid(f, p),
  same_process_call(f, g),
  self_relevant(g).

// A call that runs the callee on the caller's stack: not the creation of
// a closure, nor a fun handed to a call (fun_ref), that a start runs
// elsewhere, which call_edge also counts.
.decl same_process_call(caller: symbol, callee: symbol)

same_process_call(f, g) :- call_edge(f, g), !runs_elsewhere(f, g).

.decl reads_self(func: symbol)

reads_self(f) :- pid_arg(_, f, _, _, _, "self", _).
reads_self(f) :- pid_return(f, "self", _).
reads_self(f) :- pid_call(_, f, _, "self", _).
reads_self(f) :- pid_message(_, f, _, "self", _).
reads_self(f) :- pid_register(_, f, _, "self", _).
reads_self(f) :- pid_field(f, _, _, "self", _).
reads_self(f) :- pid_base(f, _, "self", _).
reads_self(f) :- pid_signal(_, f, _, "self", _).

.decl self_relevant(func: symbol)

self_relevant(f) :- reads_self(f).
self_relevant(f) :- same_process_call(f, g), self_relevant(g).

// ── A GenServer's state ─────────────────────────────────────────────

// What init/1 and the handlers return becomes the state the next handler
// (or terminate/2) is called with: the field of the returned tuple its
// tag puts the state in — {:ok, state}, {:reply, reply, state},
// {:noreply, state}, {:stop, reason, state}, {:stop, reason, reply,
// state}, each with its optional trailing timeout or continue.
.decl state_out(mod: symbol, func: symbol)
.decl state_in(mod: symbol, func: symbol, pos: symbol)
.decl state_slot(tag: symbol, arity: symbol, sel: symbol)

state_slot(":ok", "2", "{1}").
state_slot(":ok", "3", "{1}").
state_slot(":reply", "3", "{2}").
state_slot(":reply", "4", "{2}").
state_slot(":noreply", "2", "{1}").
state_slot(":noreply", "3", "{1}").
state_slot(":stop", "3", "{2}").
state_slot(":stop", "4", "{3}").

state_out(m, f) :- behaves_as(m, "GenServer"), function_def(f, m, "init", 1, _).
// terminate/2's return goes nowhere: no callback is called with it.
state_out(m, f) :- state_in(m, f, _), !function_def(f, m, "terminate", 2, _).

state_in(m, f, "2") :- behaves_as(m, "GenServer"), function_def(f, m, "handle_call", 3, _).
state_in(m, f, "1") :-
  behaves_as(m, "GenServer"),
  function_def(f, m, name, 2, _),
  (name = "handle_cast" ; name = "handle_info" ; name = "handle_continue" ; name = "terminate").

// A term the server may hold as its state.
.decl state_pts(mod: symbol, x: symbol)

state_pts(m, x) :-
  state_out(m, g),
  returns_all(g, t),
  pid_object(_, t, "tuple", tag, n),
  state_slot(tag, n, sel),
  field_pts(t, sel, x).

entry_pts(f, k, x) :- state_in(m, f, k), state_pts(m, x).

// ── What the pids reach ─────────────────────────────────────────────

// Context-insensitive parameters make a shared helper the meeting point
// of every caller's pid: `def safe_call(pid, msg), do: GenServer.call(pid,
// msg)` would call every server any caller hands it, and every caller of
// it would reach all of them. So a call whose target is a parameter is not
// resolved in the helper; it is a summary — "this function's parameter k
// (or its field sel) becomes the target of the call at `site`" — lifted
// to each caller, where the pid is known, and the dependency is the
// caller's, anchored at its call into the helper. The summaries are
// finite (functions × parameters × sites), so the lifting follows any
// depth of helpers without a bound; a field of a field of a parameter
// falls back to the context-insensitive parameter.
//
// Only a caller's own parameter lifts further; a callback's state and
// message, a spawned function's and init/1's arguments and a closure's
// environment are resolved where they are (entry_pts), since their
// "caller" is the process machinery, which waits on nothing.
.decl targets_param(func: symbol, pos: symbol, api_kind: symbol, site: symbol)
.decl targets_field(func: symbol, pos: symbol, sel: symbol, api_kind: symbol, site: symbol)

// Everything that goes to a process: a call, cast or send (pid_call),
// an exit signal, a monitor or a link (pid_signal).
.decl pid_use(id: symbol, func: symbol, kind: symbol, src_kind: symbol, src: symbol)

pid_use(id, f, kind, sk, s) :- pid_call(id, f, kind, sk, s).
pid_use(id, f, kind, sk, s) :- pid_signal(id, f, kind, sk, s).

targets_param(g, k, kind, id) :- pid_use(id, g, kind, "param", k).
targets_param(f, j, kind, id) :-
  pid_arg(_, f, g, k, "call", "param", j),
  targets_param(g, k, kind, id).

targets_field(g, k, sel, kind, id) :-
  pid_use(id, g, kind, "load", l),
  pid_load(g, l, sel, "param", k).

targets_field(f, j, sel, kind, id) :-
  pid_arg(_, f, g, k, "call", "param", j),
  targets_field(g, k, sel, kind, id).

// A load whose base is a parameter: resolved through its summary, not in
// place (unless the parameter is an entry's).
.decl param_load(func: symbol, load: symbol)

param_load(f, l) :- pid_load(f, l, _, "param", _).

// A field of what a source points to, a map's unknown-key field included.
.decl source_field_pts(func: symbol, src_kind: symbol, src: symbol, sel: symbol, x: symbol)

source_field_pts(f, sk, s, sel, x) :-
  targets_field(g, _, sel, _, _),
  pid_arg(_, f, g, _, "call", sk, s),
  source_pts(f, sk, s, o),
  reads_field(o, sel, x).

// `func` waits on (call), casts to (cast), sends to (info), signals an
// exit to (exit), monitors (monitor), links to (link) or unlinks from
// (unlink) `proc`: through the use at `site`, which is in `func` itself
// or in a helper `func` hands the pid to at `anchor` (the site a finding
// about `func` points at). `anchor` = `site` when the use is `func`'s own.
// The stage hands the calls, casts and sends on as process_call and the
// signals as process_signal; signals.dl puts them back together.
.decl process_call(func: symbol, anchor: symbol, site: symbol, api_kind: symbol, proc: symbol)

// A target `func` resolves itself.
process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, sk, s),
  sk != "param",
  sk != "load",
  source_pts(f, sk, s, p),
  process(p).

process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  !param_load(f, l),
  source_pts(f, "load", l, p),
  process(p).

// A field read from a source other than a parameter.
process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  pid_load(f, l, sel, bk, bs),
  bk != "param",
  source_pts(f, bk, bs, o),
  reads_field(o, sel, p),
  process(p).

// An entry's own parameter, or a field of it.
process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "param", k),
  entry_pts(f, k, p),
  process(p).

process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  pid_load(f, l, sel, "param", k),
  entry_pts(f, k, o),
  reads_field(o, sel, p),
  process(p).

// A helper's parameter, resolved at the caller that knows the pid.
process_call(f, a, id, kind, p) :-
  pid_arg(a, f, g, k, "call", sk, s),
  sk != "param",
  targets_param(g, k, kind, id),
  source_pts(f, sk, s, p),
  process(p).
.plan 0:(2,1,3,4)

process_call(f, a, id, kind, p) :-
  pid_arg(a, f, g, k, "call", "param", j),
  targets_param(g, k, kind, id),
  entry_pts(f, j, p),
  process(p).
.plan 0:(2,1,3,4)

// A helper reading a field of its parameter: the caller's term's field.
process_call(f, a, id, kind, p) :-
  pid_arg(a, f, g, k, "call", sk, s),
  sk != "param",
  targets_field(g, k, sel, kind, id),
  source_field_pts(f, sk, s, sel, p),
  process(p).
.plan 0:(2,1,3,4)

process_call(f, a, id, kind, p) :-
  pid_arg(a, f, g, k, "call", "param", j),
  targets_field(g, k, sel, kind, id),
  entry_pts(f, j, o),
  reads_field(o, sel, p),
  process(p).
.plan 0:(2,1,3,4,5), 1:(2,1,3,4,5)

// The call, cast or send at `id` in `func` may target `proc`, whoever
// supplies it.
.decl call_site_target(id: symbol, func: symbol, api_kind: symbol, proc: symbol)

call_site_target(id, g, kind, p) :-
  process_call(_, _, id, kind, p),
  pid_call(id, g, kind, _, _).

// Where the message of a call, cast or send, and a call's reply, go: its
// targets (and when the stage runs bounded, a pervasive one's as the
// coarse pass resolves it, clientlib/pervasive.dl).
.decl message_target(id: symbol, func: symbol, api_kind: symbol, proc: symbol)

message_target(id, g, kind, p) :- call_site_target(id, g, kind, p).

// A synchronous call that is provably to the calling process itself — to
// self(), or to a name only the caller's module's processes hold, from
// that module's own process — which gen exits with `calling_self`.
.decl self_call(func: symbol, site: symbol)

self_call(f, id) :- pid_call(id, f, "call", "self", "self").

// self() handed to a helper that calls its parameter: the call into the
// helper, in the function that owns the self().
self_call(f, a) :-
  pid_arg(a, f, g, k, "call", "self", _),
  targets_param(g, k, "call", _).

.decl named_module(name: symbol, mod: symbol)

named_module(n, m) :- named_pid(n, p), server_process(p, m).

.decl named_otherwise(name: symbol, mod: symbol)

named_otherwise(n, m) :- named_module(n, m), named_pid(n, p), !server_process(p, m).

self_call(f, id) :-
  pid_call(id, f, "call", "name", n),
  process_entry(m, f),
  named_module(n, m),
  !named_otherwise(n, m).

// ── Messages ────────────────────────────────────────────────────────

// A call, cast or send delivers its message to the handler of the server
// its target resolves to, as that handler's first parameter: how
// `Hub.subscribe(self())` puts a subscriber's pid into the hub's state.
// The message and the target are the same site's.
.decl message_handler(api_kind: symbol, name: symbol, arity: number)

message_handler("call", "handle_call", 3).
message_handler("cast", "handle_cast", 2).
message_handler("info", "handle_info", 2).

entry_pts(h, "0", x) :-
  pid_message(id, f, kind, sk, s),
  source_pts(f, sk, s, x),
  message_target(id, f, kind, p),
  server_process(p, m),
  message_handler(kind, name, arity),
  function_def(h, m, name, arity, _).

// ── A gen_statem's data ─────────────────────────────────────────────
//
// What init/1 and the state functions return becomes the data the next
// state function (or terminate/3) is called with: the field of the
// returned tuple its tag puts the data in — {:ok, state, data},
// {:next_state, state, data}, {:keep_state, data}, {:repeat_state,
// data}, {:stop, reason, data}, {:stop_and_reply, reason, replies,
// data}, each with its optional actions.
.decl statem_data_slot(tag: symbol, arity: symbol, sel: symbol)

statem_data_slot(":ok", "3", "{2}").
statem_data_slot(":ok", "4", "{2}").
statem_data_slot(":next_state", "3", "{2}").
statem_data_slot(":next_state", "4", "{2}").
statem_data_slot(":keep_state", "2", "{1}").
statem_data_slot(":keep_state", "3", "{1}").
statem_data_slot(":repeat_state", "2", "{1}").
statem_data_slot(":repeat_state", "3", "{1}").
statem_data_slot(":stop", "3", "{2}").
statem_data_slot(":stop_and_reply", "4", "{3}").

.decl statem_data_out(mod: symbol, func: symbol)

statem_data_out(m, f) :- statem_process(m), function_def(f, m, "init", 1, _).
statem_data_out(m, f) :- statem_event_clause(m, f, _).

// State functions take (event_type, content, data); handle_event/4 takes
// (event_type, content, state, data); terminate/3 (reason, state, data).
.decl statem_data_in(mod: symbol, func: symbol, pos: symbol)

statem_data_in(m, f, "2") :- statem_event_clause(m, f, _), function_def(f, m, _, 3, _).
statem_data_in(m, f, "3") :- statem_event_clause(m, f, _), function_def(f, m, "handle_event", 4, _).
statem_data_in(m, f, "2") :- statem_process(m), function_def(f, m, "terminate", 3, _).

.decl statem_data_pts(mod: symbol, x: symbol)

statem_data_pts(m, x) :-
  statem_data_out(m, g),
  returns_all(g, t),
  pid_object(_, t, "tuple", tag, n),
  statem_data_slot(tag, n, sel),
  field_pts(t, sel, x).

entry_pts(f, k, x) :- statem_data_in(m, f, k), statem_data_pts(m, x).

// A call, cast or send to a gen_statem is an event: its message is the
// state function's content, the second parameter.
entry_pts(h, "1", x) :-
  pid_message(id, f, kind, sk, s),
  source_pts(f, sk, s, x),
  message_target(id, f, kind, p),
  server_process(p, m),
  statem_event_clause(m, h, _).
