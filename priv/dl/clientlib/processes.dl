// Interprocedural process points-to, composing `Argus.Extractors.TermFlow` summaries.
// Processes use allocation-site identities; factory results and supervised children
// receive caller-specific instances mapped to their base by `instance`. Terms use
// construction sites and field selectors.
// Sources include proc, param, result, name, self, obj, load, reply, and dict.
// Parameters merge possible callers, except unchanged returned parameters are resolved
// from each call's own argument. Only terms containing a process/table leaf are
// followed.
// Run once in points_to.dl and expose results through staged_processes.dl. Sends and
// signals have separate consumer views. In bounded mode, pervasive.dl resolves
// widespread leaves coarsely; exact mode excludes none.
// Requires imports, behaviours, callbacks, process_statem, and runs_elsewhere, with
// pervasive.dl included alongside it.

// ── Processes ───────────────────────────────────────────────────────

// A process running a module's callbacks, identified by an explicit start or a
// supervisor child spec. The spec can identify the callback module even when its own
// start call is not visible.
.decl server_process(proc: symbol, mod: symbol)

server_process(p, m) :- process_start(_, _, p, "server", m).

server_process(cat("child ", cat(s, cat("#", to_string(pos)))), m) :-
  supervisor_child(s, pos, m, _, _),
  behaves_as(m, "GenServer").

// Factory instances
//
// A process factory's returned pid is renamed at each call that retains it,
// distinguishing private instances from supervised siblings. Wrapped results use
// `result <site>` and `start <site>` identities; child specs receive their own
// instance. `instance` retains the original allocation as base, which also represents
// unseen callers.
.decl start_term(term: symbol, proc: symbol)

start_term(t, b) :-
  process_start(t, _, b, _, _),
  term_allocation(_, t, "tuple", ":ok", "2"),
  field_store(_, t, "{1}", "process", b).

// A start_link of code outside the program (a dependency not analyzed): by OTP's
// convention it answers `{:ok, pid}` of a process it starts, linked to its caller.
// It stands as a factory whose start is out of sight, `outside <callee>` both its
// result and its allocation, so each call that keeps the result names its own
// instance as a factory's does. A program that holds the callee resolves it in its
// code instead.
.decl outside_start(callee: symbol)

outside_start(g) :-
  call_result_var(_, _, g),
  !function_def(g, _, _, _, _),
  match(".*:start_link/[0-9]+", g).

start_term(cat("outside ", g), cat("outside ", g)) :- outside_start(g).

// `func` returns `x`, allocated while it ran: its own start's result, or
// its callee's returned as it is.
.decl fresh_return(func: symbol, x: symbol)

fresh_return(g, cat("outside ", g)) :- outside_start(g).
fresh_return(g, t) :- return_var(g, "term", t), start_term(t, _).
fresh_return(g, b) :- return_var(g, "process", b), process_start(_, g, b, _, _).
fresh_return(g, x) :- return_var(g, "result", c), call_result_var(c, g, h), fresh_return(h, x).

.decl fresh_base(x: symbol, base: symbol)

fresh_base(t, b) :- start_term(t, b).
fresh_base(b, b) :- process_start(_, _, b, _, _).

// A call that keeps a factory's fresh value: the instance it names.
.decl kept_fresh(site: symbol, func: symbol, x: symbol)

kept_fresh(c, f, x) :-
  call_result_var(c, f, g),
  fresh_return(g, x),
  !return_var(f, "result", c).

// A process and the start site it comes from.
.decl instance(proc: symbol, base: symbol)

instance(b, b) :- process_start(_, _, b, _, _).
instance(cat("start ", c), b) :- kept_fresh(c, _, x), fresh_base(x, b).

instance(cat("child ", cat(s, cat("#", to_string(pos)))), b) :-
  supervisor_child(s, pos, m, _, _),
  fresh_return(start_mfa, x), start_mfa = cat(m, ":start_link/1"),
  fresh_base(x, b).

server_process(i, m) :- instance(i, b), process_start(_, _, b, "server", m).

// A supervisor's child, and a process a function keeps for itself: the
// two a rule about siblings must tell apart.
.decl supervised_process(proc: symbol, sup: symbol, pos: number)

supervised_process(cat("child ", cat(s, cat("#", to_string(pos)))), s, pos) :-
  supervisor_child(s, pos, _, _, _).

.decl private_process(proc: symbol, func: symbol, site: symbol)

private_process(cat("start ", c), f, c) :- kept_fresh(c, f, _).

private_process(b, f, id) :-
  process_start(id, f, b, _, _),
  !fresh_return(f, b),
  !fresh_return(f, id).

// Every process the program names.
.decl process(proc: symbol)

process(p) :- instance(p, _).
process(p) :- server_process(p, _).

// Recursive join plans start from newly derived tuples rather than rescanning static
// arguments, loads, and returns. `load_base` and `update_base` factor joins so new
// fields meet only the relevant operations.

// A parameter, a callee's result, a term's field: each may point to a
// process or to a term.
.decl param_points_to(func: symbol, pos: symbol, x: symbol)
.decl return_points_to(func: symbol, x: symbol)
.decl field_points_to(term: symbol, field: symbol, x: symbol)

// A registered name may hold a pid of `proc`.
.decl named_pid(name: symbol, proc: symbol)

// A source, as seen from inside `func`, may point to `x`.
.decl var_points_to(func: symbol, var_kind: symbol, var: symbol, x: symbol)

// The name and self sources each function reads, so the rules resolving
// them are bound by the function that uses them.
.decl reads_name(func: symbol, name: symbol)

reads_name(f, n) :- call_arg_var(_, f, _, _, _, "name", n).
reads_name(f, n) :- return_var(f, "name", n).
reads_name(f, n) :- process_call_var(_, f, _, "name", n).
reads_name(f, n) :- process_message_var(_, f, _, "name", n).
reads_name(f, n) :- process_register_var(_, f, _, "name", n).
reads_name(f, n) :- field_store(f, _, _, "name", n).
reads_name(f, n) :- term_update_base(f, _, "name", n).
reads_name(f, n) :- process_signal_var(_, f, _, "name", n).
reads_name(f, n) :- task_operation_var(_, f, _, "name", n).
reads_name(f, n) :- unmodeled_use(_, f, "name", n).

var_points_to(f, "process", p, p) :- process_start(_, f, p, _, _), !pervasive(p).

// Follow only terms containing a process or table leaf, directly or through another
// term. Every field_points_to row points to a leaf or such a term, so it also proves that its
// containing term is relevant.
var_points_to(f, "term", o, o) :- term_allocation(f, o, _, _, _), holds_object(o).

.decl holds_object(term: symbol)

holds_object(o) :- field_points_to(o, _, _).

var_points_to(f, "param", k, x) :- param_points_to(f, k, x).
// A callee's result; a factory's fresh value, and a term the callee builds, are
// renamed where they are kept.
var_points_to(f, "result", c, x) :-
  call_result_var(c, f, g),
  return_points_to(g, x),
  !fresh_return(g, x),
  !built_kept(c, x).

// A callee that hands its parameter back returns, at this call, what
// this call passed it (see "Returns" below).
var_points_to(f, "result", c, x) :-
  call_result_var(c, f, g),
  passes(g, j),
  call_arg_var(c, f, g, j, "call", sk, s),
  var_points_to(f, sk, s, x),
  !fresh_return(g, x).

var_points_to(f, "result", c, x) :-
  call_result_var(c, f, g),
  fresh_return(g, x),
  return_var(f, "result", c),
  !pervasive(x).

// A library call running the program's fun on elements (element_fun) answers what the
// fun answers, its parameters included: they are the elements and accumulator this call
// hands it, and captures, both entries of the fun (returns_all), not a caller's
// arguments to resolve per call.
var_points_to(f, "result", c, x) :-
  element_fun(c, f, g, _),
  call_result_var(c, f, g),
  returns_all(g, x),
  !fresh_return(g, x).

var_points_to(f, "result", c, i) :-
  kept_fresh(c, f, x),
  process_start(_, _, x, _, _),
  kept_instance(c, i),
  !pervasive(i).

// A kept `{:ok, pid}` is a term only while it holds its instance: one the
// bounded stage resolves coarsely (pervasive.dl) is left to that pass, as
// the field below is.
var_points_to(f, "result", c, cat("result ", c)) :-
  kept_fresh(c, f, x),
  start_term(x, _),
  kept_instance(c, i),
  !pervasive(i).
var_points_to(f, "result", c, i) :- built_call(c, f, _, _, i), holds_object(i).
var_points_to(f, "name", n, p) :- reads_name(f, n), named_pid(n, p), !pervasive(p).
var_points_to(f, "dictionary", k, x) :- dict_read(f, k, g, sk, s), var_points_to(g, sk, s, x).

// A helper returning a dictionary entry returns the value held by the caller's process
// at that call.
var_points_to(f, "result", c, x) :- call_result_var(c, f, g), returns_key(g, k), var_points_to(f, "dictionary", k, x).
var_points_to(f, "self", "self", p) :- self_pid(f, p), !pervasive(p).

// ETS tables are allocation leaves named "table <site>". They are neither processes nor
// field-bearing terms. tables.dl uses these identities to track tables allocated by
// :ets.new/2.
var_points_to(f, "table", t, t) :- table_alloc(_, f, t), !pervasive(t).

// GenServer.call may return the reply field of any {:reply, reply, state} from the
// server's handle_call/3, without filtering by request clause.
var_points_to(f, "reply", id, x) :-
  message_target(id, f, "call", p),
  server_process(p, m),
  function_def(h, m, "handle_call", 3, _),
  returns_all(h, t),
  term_shape(t, "tuple", ":reply", _),
  field_points_to(t, "{1}", x).

// A load reads a field of whatever its base points to.
var_points_to(f, "load", l, x) :- load_base(f, l, sel, o), reads_field(o, sel, x).

// Index field loads by their source term, so new field facts join only that term's
// loads.
.decl load_base(func: symbol, load: symbol, field: symbol, term: symbol)

load_base(f, l, sel, o) :- field_load(f, l, sel, bk, bs), var_points_to(f, bk, bs, o), !shaped_load(l).

// A tuple element read past a match (field_load_match) reads the tuples
// the match fits alone: `{:ok, x}` is no `{:error, e}`, a reply triple no
// `{:noreply, state}`. Read from every tuple its source points to, one
// call's `{:cont, socket}` holds what another's `{:halt, reply, socket}`
// holds there, and a cycle through them can join every term's fields
// (Phoenix LiveView's exact stage held 566,000 field rows; 125,000 so).
load_base(f, l, sel, o) :-
  field_load(f, l, sel, bk, bs),
  field_load_match(l, tag, n),
  var_points_to(f, bk, bs, o),
  fits_match(o, tag, n).

.decl shaped_load(load: symbol)

shaped_load(l) :- field_load_match(l, _, _).

// A tuple a match of `tag` and `arity` may have matched: one of that
// arity, or of an arity not known (0), whose tag is that one or not
// known ("").
.decl fits_match(term: symbol, tag: symbol, arity: symbol)

fits_match(o, tag, n) :-
  field_load_match(_, tag, n),
  term_shape(o, "tuple", t, a),
  (a = n ; a = "0"),
  (t = tag ; t = "" ; tag = "").

// A field read sees the named field and unknown-key writes. Unknown-key reads see only
// unknown-key writes, avoiding merges of every struct field. Derive results only for
// selectors the program reads.
.decl reads_field(term: symbol, field: symbol, x: symbol)
.decl field_read(term: symbol, field: symbol)

field_read(o, sel) :- load_base(_, _, sel, o).

field_read(o, sel) :-
  targets_field(g, _, sel, _, _),
  call_arg_var(_, f, g, _, "call", sk, s),
  var_points_to(f, sk, s, o).

reads_field(o, sel, x) :- field_read(o, sel), field_points_to(o, sel, x).

reads_field(o, sel, x) :-
  field_read(o, sel),
  term_shape(o, "map", _, _),
  field_points_to(o, "*", x).

// Enumerating a map yields its {key, value} pairs: an element read (`[]`) of a map
// is a pair the map stands for, `pair <map>`, its key what the map holds under `@key`
// (keys that are not literals) and its value any other field. `**` reads any field
// (Tuple.to_list/1).
reads_field(o, "[]", cat("pair ", o)) :-
  field_read(o, "[]"),
  term_shape(o, "map", _, _),
  holds_object(o).

field_points_to(cat("pair ", o), "{0}", x) :-
  field_read(o, "[]"),
  term_shape(o, "map", _, _),
  field_points_to(o, "@key", x).

field_points_to(cat("pair ", o), "{1}", x) :-
  field_read(o, "[]"),
  term_shape(o, "map", _, _),
  field_points_to(o, sel, x),
  sel != "@key".

reads_field(o, "**", x) :- field_read(o, "**"), field_points_to(o, _, x).

// A pair's key is the field of the map it is made of: a read of its value
// under a key (`opts[:key]`, a match of `{:key, v}`) reads the map's field
// under that key, or under one not known, not the pair's every value.
// Read whole, every lookup in a map read every field of it, and of every
// map its source points to.
.decl keyed_pair_load(func: symbol, load: symbol, map: symbol, field: symbol)

keyed_pair_load(f, l, o, tag) :-
  field_load(f, l, "{1}", bk, bs),
  field_load_match(l, tag, "2"),
  tag != "",
  var_points_to(f, bk, bs, p),
  pair_map(p, o).

.decl pair_map(pair: symbol, map: symbol)

pair_map(cat("pair ", o), o) :- field_read(o, "[]"), term_shape(o, "map", _, _).

var_points_to(f, "load", l, x) :- keyed_pair_load(f, l, o, sel), field_points_to(o, sel, x).
var_points_to(f, "load", l, x) :- keyed_pair_load(f, l, o, _), field_points_to(o, "*", x).

field_points_to(o, sel, x) :- field_store(f, o, sel, sk, s), var_points_to(f, sk, s, x).

// A kept `{:ok, pid}` holds its own instance.
field_points_to(cat("result ", c), "{1}", i) :-
  kept_fresh(c, _, x),
  start_term(x, _),
  kept_instance(c, i),
  !pervasive(i).

// The instance a kept start holds, named by the start's call site. A relation of
// its own so the negation above reads a column, not a computed value.
.decl kept_instance(call: symbol, instance: symbol)

kept_instance(c, cat("start ", c)) :- kept_fresh(c, _, _).

// An update keeps the fields it does not set; a cons cell's tail holds
// the rest of the elements.
field_points_to(o, sel, x) :- update_keeps(o, b, sel), field_points_to(b, sel, x).

// The fields an update keeps of its base, by selector: negated per
// selector, before the base's values join, rather than per value held
// there. Negated after the join, the engine held every value the base's
// fields held to check it: on Ash's deps 4.8 million rows, a fifth of
// the exact stage's.
.decl update_keeps(term: symbol, base: symbol, field: symbol)

update_keeps(o, b, sel) :- update_base(o, b), field_sel(b, sel), !term_update_overwrites(o, sel).

.decl field_sel(term: symbol, field: symbol)

field_sel(o, sel) :- field_points_to(o, sel, _).

// The term an update copies the fields it does not set from: one of its
// own kind, a map's base a map and a cons cell's tail a list, as it is
// when the update runs (`%{m | k: v}` and `Map.put/3` raise on anything
// else). What its source points to may be of every kind, where a
// parameter or a field merges the terms of unrelated callers; copied,
// every field of each of them would hold what all the others hold,
// tuple elements in a map, a struct's fields in a list.
.decl update_base(term: symbol, base: symbol)

update_base(o, b) :-
  term_update_base(f, o, bk, bs),
  var_points_to(f, bk, bs, b),
  term_allocation(f, o, kind, _, _),
  term_kind(b, kind).

// A term's kind: a map, a tuple or a list.
.decl term_kind(term: symbol, kind: symbol)

term_kind(o, kind) :- term_shape(o, kind, _, _).

// ── Built terms ─────────────────────────────────────────────────────
//
// A helper that builds a term from its parameters and hands it back (a
// `maybe_put/3` around `Map.put/3`, a protocol message's constructor) is
// one term to the rules above, holding what every caller handed it: a
// caller reading a field of what it got back reads every other caller's
// values, and each term it builds of those holds them all, so the terms
// grow with the square of the calls (ex_mcp's map helpers took field_points_to
// past the budget, even bounded). A call that keeps such a term, as
// kept_fresh keeps a factory's pid, gets an instance of its own, `built
// <call> <term>`: a field the helper fills from its parameter holds what
// that call passed there, through any helper that hands the term on as
// its own result; one filled from anything else holds what that source
// points to where it is, as the term itself does. The term the helper
// builds stays, holding every call's values, for what reads it without a
// call: the helper itself, a fun's answer to a library call (element_fun),
// a callback's return.

// A term `func` builds, or a callee hands it, and `func` returns. A
// factory's start (fresh_return) and a task's handle keep their identity.
.decl built_return(func: symbol, term: symbol)

built_return(g, o) :-
  return_var(g, "term", o),
  !start_term(o, _),
  !process_start(o, _, _, _, _).

built_return(g, o) :- return_var(g, "result", c), call_result_var(c, g, h), built_return(h, o).

// Field `sel` of `obj`, as `func` returns it, holds `func`'s parameter `pos`;
// built_local, what a source holds in `home`.
.decl built_param(func: symbol, term: symbol, field: symbol, pos: symbol)
.decl built_local(func: symbol, term: symbol, field: symbol, home: symbol, var_kind: symbol, var: symbol)

built_param(g, o, sel, j) :- built_return(g, o), field_store(g, o, sel, "param", j).

built_param(g, o, sel, j) :-
  return_var(g, "result", c),
  call_result_var(c, g, h),
  built_param(h, o, sel, i),
  call_arg_var(c, g, h, i, "call", "param", j).

built_local(g, o, sel, g, sk, s) :- built_return(g, o), field_store(g, o, sel, sk, s), sk != "param".

built_local(g, o, sel, g, sk, s) :-
  return_var(g, "result", c),
  call_result_var(c, g, h),
  built_param(h, o, sel, i),
  call_arg_var(c, g, h, i, "call", sk, s),
  sk != "param".

built_local(g, o, sel, home, sk, s) :-
  return_var(g, "result", c),
  call_result_var(c, g, h),
  built_local(h, o, sel, home, sk, s).

// The base an update `func` returns copies the fields it does not set
// from: `func`'s parameter `pos`, or a source in `home`.
.decl built_base_param(func: symbol, term: symbol, pos: symbol)
.decl built_base_local(func: symbol, term: symbol, home: symbol, var_kind: symbol, var: symbol)

built_base_param(g, o, j) :- built_return(g, o), term_update_base(g, o, "param", j).

built_base_param(g, o, j) :-
  return_var(g, "result", c),
  call_result_var(c, g, h),
  built_base_param(h, o, i),
  call_arg_var(c, g, h, i, "call", "param", j).

built_base_local(g, o, g, sk, s) :- built_return(g, o), term_update_base(g, o, sk, s), sk != "param".

built_base_local(g, o, g, sk, s) :-
  return_var(g, "result", c),
  call_result_var(c, g, h),
  built_base_param(h, o, i),
  call_arg_var(c, g, h, i, "call", sk, s),
  sk != "param".

built_base_local(g, o, home, sk, s) :-
  return_var(g, "result", c),
  call_result_var(c, g, h),
  built_base_local(h, o, home, sk, s).

// The call `call` in `func` keeps `obj` that `callee` returns, as the
// instance `inst`. A call `func` returns hands the term on instead, to
// be kept further up; a library call running a fun hands the fun no
// arguments of its own, its answer the term itself (returns_all).
.decl built_call(call: symbol, func: symbol, callee: symbol, term: symbol, inst: symbol)

built_call(c, f, g, o, cat("built ", cat(c, cat(" ", o)))) :-
  call_result_var(c, f, g),
  built_return(g, o),
  !return_var(f, "result", c),
  !element_fun(c, f, g, _).

.decl built_kept(call: symbol, term: symbol)

built_kept(c, o) :- built_call(c, _, _, o, _).

field_points_to(i, sel, x) :-
  built_call(c, f, g, o, i),
  built_param(g, o, sel, j),
  call_arg_var(c, f, g, j, "call", sk, s),
  var_points_to(f, sk, s, x).

field_points_to(i, sel, x) :- built_call(_, _, g, o, i), built_local(g, o, sel, h, sk, s), var_points_to(h, sk, s, x).

// An instance's base, and the fields it keeps of it: those its term does
// not set.
.decl built_base(inst: symbol, term: symbol, base: symbol)

built_base(i, o, b) :-
  built_call(c, f, g, o, i),
  built_base_param(g, o, j),
  call_arg_var(c, f, g, j, "call", sk, s),
  var_points_to(f, sk, s, b),
  term_allocation(g, o, kind, _, _),
  term_kind(b, kind).

built_base(i, o, b) :-
  built_call(_, _, g, o, i),
  built_base_local(g, o, h, sk, s),
  var_points_to(h, sk, s, b),
  term_allocation(g, o, kind, _, _),
  term_kind(b, kind).

update_keeps(i, b, sel) :- built_base(i, o, b), field_sel(b, sel), !term_update_overwrites(o, sel).

// A term's shape: its construction's, an instance's its term's, or the
// shape a rule gives a term it names (a map's pair, whose tag `@pair` fits
// no tagged match, which reads it by its key; a kept start's `{:ok, pid}`).
.decl term_shape(term: symbol, kind: symbol, tag: symbol, arity: symbol)

term_shape(o, kind, tag, n) :- term_allocation(_, o, kind, tag, n).
term_shape(i, kind, tag, n) :- built_call(_, _, _, o, i), term_allocation(_, o, kind, tag, n).
term_shape(p, "tuple", "@pair", "2") :- pair_map(p, _).
term_shape(cat("result ", c), "tuple", ":ok", "2") :- kept_fresh(c, _, x), start_term(x, _).

// Fresh returns
//
// Keep unchanged returned parameters in `passes`, resolving them against each caller's
// argument. `return_points_to` contains other values. Split forwarded callee results the
// same way to avoid mixing one caller's argument into every other's result.
return_points_to(g, x) :-
  return_var(g, k, s),
  k != "param",
  k != "result",
  k != "dictionary",
  var_points_to(g, k, s, x).

return_points_to(g, x) :- return_var(g, "result", c), call_result_var(c, g, h), return_points_to(h, x).

// Returning what a library call running a fun answers returns what that call resolves
// to here, the fun's parameters included (var_points_to above).
return_points_to(g, x) :-
  return_var(g, "result", c),
  element_fun(c, g, _, _),
  var_points_to(g, "result", c, x).

// What the callee allocated while it ran (fresh_return) is the caller's
// result by whichever of these rules it also arrives.
return_points_to(g, x) :- return_var(g, "result", c), call_result_var(c, g, h), fresh_return(h, x).

return_points_to(g, x) :-
  return_var(g, "result", c),
  call_result_var(c, g, h),
  passes(h, i),
  call_arg_var(c, g, h, i, "call", sk, s),
  sk != "param",
  var_points_to(g, sk, s, x).

// `func` may return its parameter `pos` as it was passed: directly, or
// as a callee's result that hands back what `func` passed it there.
.decl passes(func: symbol, pos: symbol)

passes(g, j) :- return_var(g, "param", j).

passes(g, j) :-
  return_var(g, "result", c),
  call_result_var(c, g, h),
  passes(h, i),
  call_arg_var(c, g, h, i, "call", "param", j).

// All returned values, including forwarded parameters. This also models callback
// results whose arguments are supplied by the runtime.
.decl returns_all(func: symbol, x: symbol)

returns_all(g, x) :- return_points_to(g, x).
returns_all(g, x) :- passes(g, j), param_points_to(g, j, x).
returns_all(g, x) :- returns_key(g, k), var_points_to(g, "dictionary", k, x).

// `entry_points_to` contains runtime-supplied arguments: init, spawn, child-spec, closure
// captures, callback state, and messages. `param_points_to` also includes ordinary callers.
// Resolve callback and spawned-body uses against entry arguments rather than lifting
// them to runtime machinery.
.decl entry_points_to(func: symbol, pos: symbol, x: symbol)

entry_points_to(g, k, x) :- entry_arg(f, g, k, sk, s), var_points_to(f, sk, s, x).

// Process-start arguments passed to entry functions. Keep these non-call call_arg_var rows
// separate from ordinary call arguments.
.decl entry_arg(caller: symbol, func: symbol, pos: symbol, var_kind: symbol, var: symbol)

entry_arg(f, g, k, sk, s) :- call_arg_var(_, f, g, k, via, sk, s), via != "call".

param_points_to(g, k, x) :- entry_points_to(g, k, x).
param_points_to(g, k, x) :- call_arg_var(_, f, g, k, "call", sk, s), var_points_to(f, sk, s, x).

// A registration (register/2, :global.register_name/2, Registry.register/3,
// or a start with a literal name) stores the pid it resolves to.
named_pid(n, p) :- process_register_var(_, f, n, k, s), var_points_to(f, k, s, p), process(p).

// A name registered by a start names every instance of it.
named_pid(n, i) :- named_pid(n, b), instance(i, b), i != b.

// A child spec's `name:` names the child it starts.
named_pid(n, cat("child ", cat(s, cat("#", to_string(pos))))) :-
  supervisor_child_name(s, pos, n),
  supervisor_child(s, pos, m, _, _),
  behaves_as(m, "GenServer").

// Fallback to named_process for unresolved names. Its module-level assumption can
// misattribute Process.register calls that register another process's PID.
.decl resolved_name(name: symbol)

resolved_name(n) :- process_register_var(_, _, n, _, _).
resolved_name(n) :- supervisor_child_name(_, _, n).

named_pid(n, p) :-
  named_process(mod, n),
  !resolved_name(n),
  server_process(p, mod).

// Process-dictionary points-to
//
// A literal-key read may see puts from functions sharing a same-process caller or
// callbacks of one module. Order and erases are ignored here; dictionary.dl handles
// ordering. Shared code can merge different processes' values.
// External puts, computed keys, applies, and separate APIs used sequentially by an
// unseen caller are not connected.

// A helper returning a dictionary key is resolved at each call in the caller's process,
// like a forwarded parameter. Keep it out of shared `return_points_to` so server and
// external callers do not inherit each other's dictionary values.
.decl returns_key(func: symbol, key: symbol)

returns_key(g, k) :- return_var(g, "dictionary", k).
returns_key(g, k) :- return_var(g, "result", c), call_result_var(c, g, h), returns_key(h, k).

// A dictionary read of `key` in `func`, and each put of it the same
// process may make, in `putter`, of the source (sk, s).
.decl dict_read(func: symbol, key: symbol, putter: symbol, var_kind: symbol, var: symbol)

dict_read(f, k, g, sk, s) :-
  reads_dict(f, k),
  dict_put(_, g, k, sk, s),
  shares_dictionary(f, g).

// The dict sources each function reads, so the rules resolving them are
// bound by the function that uses them.
.decl reads_dict(func: symbol, key: symbol)

reads_dict(f, k) :- call_arg_var(_, f, _, _, _, "dictionary", k).
reads_dict(f, k) :- return_var(f, "dictionary", k).
reads_dict(f, k) :- process_call_var(_, f, _, "dictionary", k).
reads_dict(f, k) :- process_message_var(_, f, _, "dictionary", k).
reads_dict(f, k) :- process_register_var(_, f, _, "dictionary", k).
reads_dict(f, k) :- field_store(f, _, _, "dictionary", k).
reads_dict(f, k) :- term_update_base(f, _, "dictionary", k).
reads_dict(f, k) :- process_signal_var(_, f, _, "dictionary", k).
reads_dict(f, k) :- field_load(f, _, _, "dictionary", k).
reads_dict(f, k) :- table_use(_, f, "dictionary", k).
reads_dict(f, k) :- dict_put(_, f, _, "dictionary", k).
reads_dict(f, k) :- task_operation_var(_, f, _, "dictionary", k).
reads_dict(f, k) :- unmodeled_use(_, f, "dictionary", k).
reads_dict(f, k) :- call_result_var(_, f, g), returns_key(g, k).

// Seed same-process dictionary reachability from reads and writes whose keys have a
// corresponding write or read elsewhere.
.init dict_stack = SameProcessReach

dict_stack.seed(f, f) :- reads_dict(f, k), dict_put(_, _, k, _, _).
dict_stack.seed(g, g) :- dict_put(_, g, k, _, _), reads_dict(_, k).

// `func` and other may share a process dictionary if one stack reaches both or they are
// callbacks of the same module.
.decl shares_dictionary(func: symbol, other: symbol)

shares_dictionary(f, g) :-
  reads_dict(f, k),
  dict_put(_, g, k, _, _),
  dict_stack.reaches(a, f),
  dict_stack.reaches(a, g).

shares_dictionary(f, g) :-
  reads_dict(f, k),
  dict_put(_, g, k, _, _),
  dict_stack.reaches(a, f),
  process_entry(m, a),
  process_entry(m, b),
  dict_stack.reaches(b, g).

// ── Who runs a function ─────────────────────────────────────────────

// self() resolves to the server or spawned process running the function and propagates
// along its own stack. Exclude spawned, stored, or deferred fun execution. Traverse
// only paths leading to a self() use.
.decl self_pid(func: symbol, proc: symbol)

self_pid(f, p) :- process_entry(m, f), server_process(p, m).
self_pid(f, p) :- instance(p, b), process_start(_, _, b, "spawn", f).

self_pid(g, p) :-
  self_pid(f, p),
  same_process_call(f, g),
  self_relevant(g).

// Call edges that execute on the caller's stack. Exclude closure creation and function
// arguments started elsewhere.
.decl same_process_call(caller: symbol, callee: symbol)

same_process_call(f, g) :- call_edge(f, g), !runs_elsewhere(f, g).

.decl reads_self(func: symbol)

reads_self(f) :- call_arg_var(_, f, _, _, _, "self", _).
reads_self(f) :- return_var(f, "self", _).
reads_self(f) :- process_call_var(_, f, _, "self", _).
reads_self(f) :- process_message_var(_, f, _, "self", _).
reads_self(f) :- process_register_var(_, f, _, "self", _).
reads_self(f) :- field_store(f, _, _, "self", _).
reads_self(f) :- term_update_base(f, _, "self", _).
reads_self(f) :- process_signal_var(_, f, _, "self", _).

.decl self_relevant(func: symbol)

self_relevant(f) :- reads_self(f).
self_relevant(f) :- same_process_call(f, g), self_relevant(g).

// ── A GenServer's state ─────────────────────────────────────────────

// Callback return tuples supply the state for the next handler or terminate/2. Select
// the state field from ok, reply, noreply and stop tuples, including forms with
// trailing timeout or continue values.
.decl state_out(mod: symbol, func: symbol)
.decl state_in(mod: symbol, func: symbol, pos: symbol)
.decl state_slot(tag: symbol, arity: symbol, field: symbol)

state_slot(":ok", "2", "{1}").
state_slot(":ok", "3", "{1}").
state_slot(":reply", "3", "{2}").
state_slot(":reply", "4", "{2}").
state_slot(":noreply", "2", "{1}").
state_slot(":noreply", "3", "{1}").
state_slot(":stop", "3", "{2}").
state_slot(":stop", "4", "{3}").

state_out(m, f) :- behaves_as(m, "GenServer"), function_def(f, m, "init", 1, _).
// terminate/2's return goes nowhere: no callback is called with it.
state_out(m, f) :- state_in(m, f, _), !function_def(f, m, "terminate", 2, _).

state_in(m, f, "2") :- behaves_as(m, "GenServer"), function_def(f, m, "handle_call", 3, _).
state_in(m, f, "1") :-
  behaves_as(m, "GenServer"),
  function_def(f, m, name, 2, _),
  (name = "handle_cast" ; name = "handle_info" ; name = "handle_continue" ; name = "terminate").

// A term the server may hold as its state.
.decl state_points_to(mod: symbol, x: symbol)

state_points_to(m, x) :-
  state_out(m, g),
  returns_all(g, t),
  term_shape(t, "tuple", tag, n),
  state_slot(tag, n, sel),
  field_points_to(t, sel, x).

entry_points_to(f, k, x) :- state_in(m, f, k), state_points_to(m, x).

// ── What the pids reach ─────────────────────────────────────────────

// Parameter-based process targets
//
// Summarize target parameters or their immediate fields and resolve them at each
// caller, preserving caller-specific dependencies and anchors. Summaries support
// arbitrary helper depth; nested fields fall back to context-insensitive resolution.
// Runtime entry arguments use `entry_points_to` locally because process machinery is not a
// waiting caller.
.decl targets_param(func: symbol, pos: symbol, api_kind: symbol, site: symbol)
.decl targets_field(func: symbol, pos: symbol, field: symbol, api_kind: symbol, site: symbol)

// Everything that goes to a process: a call, cast or send (process_call_var),
// an exit signal, a monitor or a link (process_signal_var).
.decl pid_use(id: symbol, func: symbol, kind: symbol, var_kind: symbol, var: symbol)

pid_use(id, f, kind, sk, s) :- process_call_var(id, f, kind, sk, s).
pid_use(id, f, kind, sk, s) :- process_signal_var(id, f, kind, sk, s).

targets_param(g, k, kind, id) :- pid_use(id, g, kind, "param", k).
targets_param(f, j, kind, id) :-
  call_arg_var(_, f, g, k, "call", "param", j),
  targets_param(g, k, kind, id).

targets_field(g, k, sel, kind, id) :-
  pid_use(id, g, kind, "load", l),
  field_load(g, l, sel, "param", k).

targets_field(f, j, sel, kind, id) :-
  call_arg_var(_, f, g, k, "call", "param", j),
  targets_field(g, k, sel, kind, id).

// A load whose base is a parameter: resolved through its summary, not in
// place (unless the parameter is an entry's).
.decl param_load(func: symbol, load: symbol)

param_load(f, l) :- field_load(f, l, _, "param", _).

// A field of what a source points to, a map's unknown-key field included.
.decl var_field_points_to(func: symbol, var_kind: symbol, var: symbol, field: symbol, x: symbol)

var_field_points_to(f, sk, s, sel, x) :-
  targets_field(g, _, sel, _, _),
  call_arg_var(_, f, g, _, "call", sk, s),
  var_points_to(f, sk, s, o),
  reads_field(o, sel, x).

// A call, cast, send, exit, monitor, link, or unlink targeting proc. `site` is the
// actual use; `anchor` is func's call into a helper, or the site itself. The stage
// exports calls/casts/sends as process_call and signals as process_signal; signals.dl
// combines them.
.decl process_call(func: symbol, anchor: symbol, site: symbol, api_kind: symbol, proc: symbol)

// A target `func` resolves itself.
process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, sk, s),
  sk != "param",
  sk != "load",
  var_points_to(f, sk, s, p),
  process(p).

process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  !param_load(f, l),
  var_points_to(f, "load", l, p),
  process(p).

// A field read from a source other than a parameter.
process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  field_load(f, l, _, bk, _),
  bk != "param",
  load_base(f, l, sel, o),
  reads_field(o, sel, p),
  process(p).

// An entry's own parameter, or a field of it.
process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "param", k),
  entry_points_to(f, k, p),
  process(p).

process_call(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  field_load(f, l, sel, "param", k),
  entry_points_to(f, k, o),
  load_base(f, l, sel, o),
  reads_field(o, sel, p),
  process(p).

// A helper's parameter, resolved at the caller that knows the pid.
process_call(f, a, id, kind, p) :-
  call_arg_var(a, f, g, k, "call", sk, s),
  sk != "param",
  targets_param(g, k, kind, id),
  var_points_to(f, sk, s, p),
  process(p).

process_call(f, a, id, kind, p) :-
  call_arg_var(a, f, g, k, "call", "param", j),
  targets_param(g, k, kind, id),
  entry_points_to(f, j, p),
  process(p).

// A helper reading a field of its parameter: the caller's term's field.
process_call(f, a, id, kind, p) :-
  call_arg_var(a, f, g, k, "call", sk, s),
  sk != "param",
  targets_field(g, k, sel, kind, id),
  var_field_points_to(f, sk, s, sel, p),
  process(p).

process_call(f, a, id, kind, p) :-
  call_arg_var(a, f, g, k, "call", "param", j),
  targets_field(g, k, sel, kind, id),
  entry_points_to(f, j, o),
  reads_field(o, sel, p),
  process(p).

// The call, cast or send at `id` in `func` may target `proc`, whoever
// supplies it.
.decl call_site_target(id: symbol, func: symbol, api_kind: symbol, proc: symbol)

call_site_target(id, g, kind, p) :-
  process_call(_, _, id, kind, p),
  process_call_var(id, g, kind, _, _).

// Resolve destinations of call/cast/send messages and call replies. Bounded staging may
// use coarse targets for pervasive sources; see pervasive.dl.
.decl message_target(id: symbol, func: symbol, api_kind: symbol, proc: symbol)

message_target(id, g, kind, p) :- call_site_target(id, g, kind, p).

// A synchronous call provably targets its own process, by self() or a name held
// exclusively by that module's servers. gen exits with calling_self.
.decl self_call(func: symbol, site: symbol)

self_call(f, id) :- process_call_var(id, f, "call", "self", "self").

// self() handed to a helper that calls its parameter: the call into the
// helper, in the function that owns the self().
self_call(f, a) :-
  call_arg_var(a, f, g, k, "call", "self", _),
  targets_param(g, k, "call", _).

.decl named_module(name: symbol, mod: symbol)

named_module(n, m) :- named_pid(n, p), server_process(p, m).

.decl named_otherwise(name: symbol, mod: symbol)

named_otherwise(n, m) :- named_module(n, m), named_pid(n, p), !server_process(p, m).

self_call(f, id) :-
  process_call_var(id, f, "call", "name", n),
  process_entry(m, f),
  named_module(n, m),
  !named_otherwise(n, m).

// ── Messages ────────────────────────────────────────────────────────

// A call, cast or send passes its message to the resolved server handler's first
// parameter. Match the message and target from the same call site.
.decl message_handler(api_kind: symbol, name: symbol, arity: number)

message_handler("call", "handle_call", 3).
message_handler("cast", "handle_cast", 2).
message_handler("info", "handle_info", 2).

entry_points_to(h, "0", x) :-
  process_message_var(id, f, kind, sk, s),
  var_points_to(f, sk, s, x),
  message_target(id, f, kind, p),
  server_process(p, m),
  message_handler(kind, name, arity),
  function_def(h, m, name, arity, _).

// gen_statem data flow. Return tuples supply data for the next state function or
// terminate/3. Handle ok, next_state, keep_state, repeat_state, stop and stop_and_reply
// forms, including optional actions.
.decl statem_data_slot(tag: symbol, arity: symbol, field: symbol)

statem_data_slot(":ok", "3", "{2}").
statem_data_slot(":ok", "4", "{2}").
statem_data_slot(":next_state", "3", "{2}").
statem_data_slot(":next_state", "4", "{2}").
statem_data_slot(":keep_state", "2", "{1}").
statem_data_slot(":keep_state", "3", "{1}").
statem_data_slot(":repeat_state", "2", "{1}").
statem_data_slot(":repeat_state", "3", "{1}").
statem_data_slot(":stop", "3", "{2}").
statem_data_slot(":stop_and_reply", "4", "{3}").

.decl statem_data_out(mod: symbol, func: symbol)

statem_data_out(m, f) :- statem_process(m), function_def(f, m, "init", 1, _).
statem_data_out(m, f) :- statem_event_clause(m, f, _).

// State functions take (event_type, content, data); handle_event/4 takes
// (event_type, content, state, data); terminate/3 (reason, state, data).
.decl statem_data_in(mod: symbol, func: symbol, pos: symbol)

statem_data_in(m, f, "2") :- statem_event_clause(m, f, _), function_def(f, m, _, 3, _).
statem_data_in(m, f, "3") :- statem_event_clause(m, f, _), function_def(f, m, "handle_event", 4, _).
statem_data_in(m, f, "2") :- statem_process(m), function_def(f, m, "terminate", 3, _).

.decl statem_data_points_to(mod: symbol, x: symbol)

statem_data_points_to(m, x) :-
  statem_data_out(m, g),
  returns_all(g, t),
  term_shape(t, "tuple", tag, n),
  statem_data_slot(tag, n, sel),
  field_points_to(t, sel, x).

entry_points_to(f, k, x) :- statem_data_in(m, f, k), statem_data_points_to(m, x).

// A call, cast or send to a gen_statem is an event: its message is the
// state function's content, the second parameter.
entry_points_to(h, "1", x) :-
  process_message_var(id, f, kind, sk, s),
  var_points_to(f, sk, s, x),
  message_target(id, f, kind, p),
  server_process(p, m),
  statem_event_clause(m, h, _).
