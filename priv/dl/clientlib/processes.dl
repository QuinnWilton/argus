// Which process a pid can be: the interprocedural half of process
// points-to. Argus.Extractors.PidFlow summarises each function (where the
// values it passes on, returns, calls, registers and sends to come from,
// and the terms it builds); this file chains the summaries.
//
// The objects are processes and the terms that hold them. A process is
// named by the site that started it (process_start: "spawn <id>",
// "server <id>"), or by the supervisor child spec that names it ("child
// <sup>#<pos>"). A term is named by the instruction that built it
// (pid_object), with a field per map key, tuple position or list element,
// so two pids in one state map stay two pids. A source is one of
//   proc   — the process started at a site in the same function;
//   param  — the function's parameter at a position;
//   result — what a project call at a site returned;
//   name   — a pid registered under a literal name;
//   self   — self(), which is whichever process runs the function;
//   obj    — a term the function built;
//   load   — a field read from a term the function did not build.
// Parameters are context-insensitive, like Andersen's analysis: a
// parameter points to everything any caller passes it. That is "may
// point to", and a rule that concludes something from it asks what a
// process does NOT do.
//
// Where sends go is in sends.dl, apart, so an analysis that asks only
// about calls does not read every send in the program.
//
// Prerequisites: include clientlib/imports.dl, behaviours.dl and
// callbacks.dl before this file (otp.dl does).

// ── Processes ───────────────────────────────────────────────────────

// A process running a module's callbacks: started by a start call in the
// program (a GenServer start, or a supervisor's start_child), or a
// GenServer a supervisor's child spec names, whose own start the program
// may not spell out (`start: {GenServer, :start_link, [Mod, arg]}`).
.decl server_process(proc: symbol, mod: symbol)

server_process(p, m) :- process_start(_, _, p, "server", m).

server_process(cat("child ", cat(s, cat("#", to_string(pos)))), m) :-
  supervisor_child(s, pos, m, _, _),
  behaves_as(m, "GenServer").

// Every process the program names.
.decl process(proc: symbol)

process(p) :- process_start(_, _, p, _, _).
process(p) :- server_process(p, _).

// ── What a source points to ─────────────────────────────────────────

// A parameter, a callee's result, a term's field: each may point to a
// process or to a term.
.decl param_pts(func: symbol, pos: symbol, x: symbol)
.decl returns_pts(func: symbol, x: symbol)
.decl field_pts(obj: symbol, sel: symbol, x: symbol)

// A registered name may hold a pid of `proc`.
.decl named_pid(name: symbol, proc: symbol)

// A source, as seen from inside `func`, may point to `x`.
.decl source_pts(func: symbol, src_kind: symbol, src: symbol, x: symbol)

// The name and self sources each function reads, so the rules resolving
// them are bound by the function that uses them.
.decl reads_name(func: symbol, name: symbol)

reads_name(f, n) :- pid_arg(_, f, _, _, _, "name", n).
reads_name(f, n) :- pid_return(f, "name", n).
reads_name(f, n) :- pid_call(_, f, _, "name", n).
reads_name(f, n) :- pid_message(_, f, _, "name", n).
reads_name(f, n) :- pid_register(_, f, _, "name", n).
reads_name(f, n) :- pid_field(f, _, _, "name", n).
reads_name(f, n) :- pid_base(f, _, "name", n).

source_pts(f, "proc", p, p) :- process_start(_, f, p, _, _).
source_pts(f, "obj", o, o) :- pid_object(f, o, _, _, _).
source_pts(f, "param", k, x) :- param_pts(f, k, x).
source_pts(f, "result", c, x) :- pid_result(c, f, g), returns_pts(g, x).
source_pts(f, "name", n, p) :- reads_name(f, n), named_pid(n, p).
source_pts(f, "self", "self", p) :- self_pid(f, p).

// A load reads a field of whatever its base points to; a map's field
// written under a key not known may be any key.
source_pts(f, "load", l, x) :-
  pid_load(f, l, sel, bk, bs),
  source_pts(f, bk, bs, o),
  field_pts(o, sel, x).

source_pts(f, "load", l, x) :-
  pid_load(f, l, _, bk, bs),
  source_pts(f, bk, bs, o),
  pid_object(_, o, "map", _, _),
  field_pts(o, "*", x).

field_pts(o, sel, x) :- pid_field(f, o, sel, sk, s), source_pts(f, sk, s, x).

// An update keeps the fields it does not set; a cons cell's tail holds
// the rest of the elements.
field_pts(o, sel, x) :-
  pid_base(f, o, bk, bs),
  source_pts(f, bk, bs, b),
  field_pts(b, sel, x),
  !pid_sets(o, sel).

returns_pts(f, x) :- pid_return(f, k, s), source_pts(f, k, s, x).

param_pts(g, k, x) :- pid_arg(_, f, g, k, _, sk, s), source_pts(f, sk, s, x).

named_pid(n, p) :- pid_register(_, f, n, k, s), source_pts(f, k, s, p), process(p).

// A server started with a literal name: the start registers it.
named_pid(n, p) :-
  named_process(mod, n),
  server_process(p, mod).

// ── Who runs a function ─────────────────────────────────────────────

// self() in a server's callbacks (process_entry: its callbacks, init/1,
// terminate/2) is that server; in a spawned function, that spawn. A
// function reached from them, or a client API, runs in someone else's
// process, and is left unresolved.
.decl self_pid(func: symbol, proc: symbol)

self_pid(f, p) :- process_entry(m, f), server_process(p, m).
self_pid(f, p) :- process_start(_, _, p, "spawn", f).

// ── A GenServer's state ─────────────────────────────────────────────

// What init/1 and the handlers return becomes the state the next handler
// (or terminate/2) is called with: the field of the returned tuple its
// tag puts the state in — {:ok, state}, {:reply, reply, state},
// {:noreply, state}, {:stop, reason, state}, {:stop, reason, reply,
// state}, each with its optional trailing timeout or continue.
.decl state_out(mod: symbol, func: symbol)
.decl state_in(mod: symbol, func: symbol, pos: symbol)
.decl state_slot(tag: symbol, arity: symbol, sel: symbol)

state_slot(":ok", "2", "{1}").
state_slot(":ok", "3", "{1}").
state_slot(":reply", "3", "{2}").
state_slot(":reply", "4", "{2}").
state_slot(":noreply", "2", "{1}").
state_slot(":noreply", "3", "{1}").
state_slot(":stop", "3", "{2}").
state_slot(":stop", "4", "{3}").

state_out(m, f) :- behaves_as(m, "GenServer"), function_def(f, m, "init", 1, _).
state_out(m, f) :- state_in(m, f, _), !function_def(f, m, "terminate", 2, _).

state_in(m, f, "2") :- behaves_as(m, "GenServer"), function_def(f, m, "handle_call", 3, _).
state_in(m, f, "1") :-
  behaves_as(m, "GenServer"),
  function_def(f, m, name, 2, _),
  (name = "handle_cast" ; name = "handle_info" ; name = "handle_continue" ; name = "terminate").

// A term the server may hold as its state.
.decl state_pts(mod: symbol, x: symbol)

state_pts(m, x) :-
  state_out(m, g),
  returns_pts(g, t),
  pid_object(_, t, "tuple", tag, n),
  state_slot(tag, n, sel),
  field_pts(t, sel, x).

param_pts(f, k, x) :- state_in(m, f, k), state_pts(m, x).

// ── What the pids reach ─────────────────────────────────────────────

// The GenServer-style call, cast or send at `id` in `func` may target
// `proc`.
.decl call_site_target(id: symbol, func: symbol, api_kind: symbol, proc: symbol)

call_site_target(id, f, kind, p) :-
  pid_call(id, f, kind, sk, s),
  source_pts(f, sk, s, p),
  process(p).

// A call or cast in `func` may target `proc`.
.decl call_target(func: symbol, api_kind: symbol, proc: symbol)

call_target(f, kind, p) :- call_site_target(_, f, kind, p).

// ── Messages ────────────────────────────────────────────────────────

// A call, cast or send delivers its message to the handler of the server
// its target resolves to, as that handler's first parameter: how
// `Hub.subscribe(self())` puts a subscriber's pid into the hub's state.
// The message and the target are the same site's.
.decl message_handler(api_kind: symbol, name: symbol, arity: number)

message_handler("call", "handle_call", 3).
message_handler("cast", "handle_cast", 2).
message_handler("info", "handle_info", 2).

param_pts(h, "0", x) :-
  pid_message(id, f, kind, sk, s),
  source_pts(f, sk, s, x),
  call_site_target(id, f, kind, p),
  server_process(p, m),
  message_handler(kind, name, arity),
  function_def(h, m, name, arity, _).
