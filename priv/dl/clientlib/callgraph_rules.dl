// Shared call_edge rules. Declare call_edge(caller: symbol, callee: symbol) first.
// Requires remote_call, bif_call, local_call, function_def, closure_def, fun_ref and
// resolved_apply from base.dl.

// Remote call: caller function -> "mod:func/arity" string.
call_edge(caller_func, callee) :-
  remote_call(_, caller_func, mod, func, arity),
  callee = cat(mod, cat(":", cat(func, cat("/", to_string(arity))))).

// BIF call: caller function -> "mod:func/arity".
call_edge(caller_func, callee) :-
  bif_call(_, caller_func, mod, func, arity, _),
  callee = cat(mod, cat(":", cat(func, cat("/", to_string(arity))))).

// Local call: target is an MFA string matching a function_def's func field.
call_edge(caller_func, target) :-
  local_call(_, caller_func, target, _),
  function_def(target, _, _, _, _).

// Call relations carry their caller directly. Avoid joining positional `instruction`
// rows so call-graph inputs remain stable across unrelated body edits.

// Closure construction adds a possible execution edge to the lifted closure function.
// This lets call reachability include bodies passed to higher-order APIs.
call_edge(parent, child) :- closure_def(parent, child).

// A fun reference passed to another call adds a possible execution edge. Same-process
// walks can exclude it when execution is deferred or detached. Direct calls retain
// their own edges and need no fun_ref row.
call_edge(f, g) :- fun_ref(f, g).

// Treat a resolved apply target as a call edge, even when the compiler could not
// identify the target statically.
call_edge(f, g) :- resolved_apply(_, f, g).
