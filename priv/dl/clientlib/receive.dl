// Receive-shape helpers. recv_start.blocking distinguishes receives without an after
// clause, which may wait forever for a message. Keep that encoding here so callers can
// query the relevant shape. Requires imports.dl.

.decl receives(func: symbol)

receives(func) :- recv_start(_, func, _, _).

// No `after`: waits until the message arrives.
.decl blocking_receive(func: symbol)

blocking_receive(func) :- recv_start(_, func, 1, _).

// With an `after`: can end without the message.
.decl timed_receive(func: symbol)

timed_receive(func) :- recv_start(_, func, 0, _).

// Execution whose receives are not visible: function-value calls, apply, gen behaviour
// enter_loop calls, and MFA-based hibernation.
.decl hides_receives(func: symbol) inline

hides_receives(g) :- dynamic_call(_, g, _).

hides_receives(g) :-
  remote_call(_, g, m, "enter_loop", _),
  (m = ":gen_server" ; m = ":gen_statem" ; m = ":gen_event").

hides_receives(g) :-
  remote_call(_, g, m, "hibernate", _),
  (m = ":erlang" ; m = ":proc_lib").

// A receive in the module has a clause for this literal message, or
// one that matches anything ("any").
.decl receives_message(mod: symbol, message: symbol)

receives_message(mod, message) :-
  recv_pattern(_, f, message),
  function_def(f, mod, _, _, _).

// Receives bounded by a peer's lifetime
//
// `down_bounded` accepts every reason from a locally created monitor or pinned monitor
// reference. Exclude possible preceding demonitor operations; incoming references are
// assumed to have active monitors.
// `exit_pinned` accepts every reason from a pinned linked process or port. Consumers
// must establish that the waiting process traps exits.
// These waits have no time bound: a live silent peer can hold them indefinitely.
// `monitor_released` separately checks collection on every return path.
.decl down_bounded(recv: symbol)

down_bounded(id) :- recv_down(id, _, _).
down_bounded(id) :- recv_signal(id, _, "down").

.decl exit_pinned(recv: symbol, func: symbol)

exit_pinned(id, f) :- recv_signal(id, f, "exit"), links_in(f).

// A call linking the current process to another process or port: link, spawn_link,
// start_link or port creation.
.decl link_site(site: symbol, func: symbol)

link_site(id, f) :- spawn_call(id, f, _, _, _, "spawn_link", _, _, _, _).
link_site(id, f) :- remote_call(id, f, ":erlang", "link", 1).
link_site(id, f) :- remote_call(id, f, "Process", "link", 1).
link_site(id, f) :- remote_call(id, f, ":erlang", "open_port", 2).
link_site(id, f) :- remote_call(id, f, "Port", "open", 2).
link_site(id, f) :- call_site(id, f, _, "start_link", _).

// The function makes a link its receive can be told of (link_site).
.decl links_in(func: symbol)

links_in(f) :- link_site(_, f).

// A monitor released on every returning path by a matching :DOWN clause, demonitor, or
// recognized same-module collection helper. Other receive clauses and timeout arms do
// not qualify. Flush is not required to release the monitor. Unlike `down_bounded`,
// this proves release on every exit, not eventual completion of one wait.
.decl monitor_released(monitor: symbol)

monitor_released(m) :- monitor_call(m, f, _), monitor_released_after(f, m).
