// Generated-code classification.
// `macro_written` requires every clause to come from a macro, generation marker, OTP
// header, or parser generator. `macro_generated` identifies the origin from
// first-clause metadata and alone cannot prove the whole function generated.
// `library_written` requires all clauses to come from outside the analyzed program.
// Project macros and analyzed libraries remain program code, where fixes are possible.
// Included by imports.dl; consumers trigger the Generated extractor.
.decl library_written(func: symbol)

library_written(f) :-
  macro_written(f),
  macro_generated(f, by),
  !program_module(by).

// A module the analyzed beams define.
.decl program_module(mod: symbol)

program_module(m) :- function_def(_, m, _, _, _).
