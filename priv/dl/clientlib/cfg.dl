// Control flow graph derivation.
//
// Derives cfg_edge from base facts: sequential next, jumps, branches,
// and select_branch arms. Maps label numbers to instruction IDs via label_at.

.include "../base.dl"

// Derived: control flow graph edge.
//
// Deliberately NOT `.output`: cfg_edge is an intermediate, and forcing it
// out makes Souffle materialize and write it even when no rule reads it.
// It is quadratic-ish in module size — over a 555-beam corpus it reaches
// ~10.3M rows / ~1GB per solve, which every consumer then parses and
// discards. Without the directive Souffle prunes the whole CFG subgraph
// unless an analysis actually uses it. Analyses (and tests) that want the
// relation declare `.output cfg_edge` themselves.
.decl cfg_edge(from: symbol, to: symbol)

// Sequential fallthrough.
cfg_edge(from, to) :- next(from, to).

// Unconditional jump.
cfg_edge(id, target_id) :-
  jump(id, target),
  label_at(target, target_id).

// Conditional branch — the fail edge. Tests fall through on success (that
// edge comes from `next`); the emitted label is taken when the test fails.
cfg_edge(id, target_id) :-
  branch(id, fail, _),
  fail != 0,
  label_at(fail, target_id).

// Select branch arms.
cfg_edge(id, target_id) :-
  select_branch(id, _, target),
  label_at(target, target_id).
