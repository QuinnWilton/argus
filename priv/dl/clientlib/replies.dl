// GenServer reply contracts. `answers_calls` identifies handle_call/3; `defers_reply`
// identifies noreply returns requiring a later GenServer.reply/2. Used by mailbox and
// blocking checks. Requires imports.dl, otp.dl, and Reply extraction for
// callback_return.
.decl answers_calls(mod: symbol, func: symbol)

answers_calls(mod, func) :- handle_call_function(mod, func).

.decl defers_reply(mod: symbol, func: symbol, id: symbol)

defers_reply(mod, func, id) :-
  answers_calls(mod, func),
  callback_return(id, func, "handle_call", ":noreply").
