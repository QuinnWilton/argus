// What kind of process a module is, and what it can take from its
// mailbox.
//
// Requires imports.dl, behaviours.dl, callbacks.dl (otp.dl includes all
// of them). A gen_statem's state functions are process entries too, but
// saying so reads `statem_event_clause`, which most analyses do not:
// process_statem.dl adds that rule for the ones that do.

// A module that runs as a process (callbacks.dl).
.decl process_module(mod: symbol)

process_module(mod) :- process_behaviour_module(mod).

// Any behaviour module: a process's, or a plug's, a type's, a worker's
// — code with a contract its caller relies on, not a library function.
.decl behaviour_module(mod: symbol)

behaviour_module(mod) :- implements_behaviour(mod, _).

.decl statem_process(mod: symbol)

statem_process(mod) :- behaves_as(mod, "GenStateMachine").

// Defines handle_info at any arity.
.decl has_handle_info(mod: symbol)

has_handle_info(mod) :- function_def(_, mod, "handle_info", _, _).

// A callback that takes arbitrary messages from the mailbox: a
// handle_info/2, whatever behaviour hosts it (GenServer, LiveView,
// Phoenix.Tracker, a hand-rolled loop delegating to it), or a
// gen_statem's handle_event/4.
.decl mailbox_handler(mod: symbol)

mailbox_handler(mod) :- function_def(_, mod, "handle_info", 2, _).

mailbox_handler(mod) :-
  statem_process(mod),
  function_def(_, mod, "handle_event", 4, _).

// A handle_info/2 with no catch-all: a message no clause matches is a
// FunctionClauseError, not the default log-and-continue.
.decl partial_handle_info(mod: symbol, func: symbol)

partial_handle_info(mod, func) :-
  function_def(func, mod, "handle_info", 2, _),
  !callback_total(func, "handle_info").


// A module that traps exits and has a handle_info/2 whose clauses never
// take an {:EXIT, ...}: the trapped exit arrives as a message nothing
// matches. `witness` is the function that sets trap_exit. A gen_statem
// hands {:EXIT, ...} to its state functions, not to handle_info/2.
.decl trap_exit_without_exit_clause(mod: symbol, witness: symbol)

trap_exit_without_exit_clause(mod, func) :-
  trap_exit(func, mod),
  partial_handle_info(mod, h),
  !callback_tag(h, "handle_info", ":EXIT"),
  !statem_process(mod).

// Runs on the server's own stack: a callback, a statem state function,
// or what those reach without leaving the module. A client function of
// the same module runs in its caller.
.init server_reach = ForwardIntraModuleReach

server_reach.root(mod, func) :-
  otp_callback(func, mod, _, _).

server_reach.root(mod, func) :-
  statem_process(mod),
  statem_state(mod, _, func),
  function_def(func, mod, _, _, _).

.decl server_side(mod: symbol, func: symbol)

server_side(mod, func) :- server_reach.reaches(mod, func).

// Some function of the module demonitors.
.decl module_demonitors(mod: symbol)

module_demonitors(mod) :-
  demonitor_call(_, f, _),
  function_def(f, mod, _, _, _).
