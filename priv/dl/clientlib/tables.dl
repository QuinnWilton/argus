// Shared ETS table identities.
// `named`: registered atom name.
// `new`: unnamed allocation site, followed by points-to.
// `field`: unresolved parameter-map path within one module.
// `handed_in`: an external entry's forwarded table parameter.
// Equality requires the same kind and identity. Different kinds may alias at runtime
// but are not unified without evidence. Relations expose kind/ident columns; EtsTable
// packages them as a value.
// An operation may touch several tables, including fallback-expression arms. Literal
// names propagate through arguments; stored atom names resolve only when tied to a
// known allocation. Points-to follows references through terms, state, closures, and
// spawned arguments. Field and external-parameter identities provide fallbacks;
// unresolved operations use may_touch_any_table.
// Requires imports.dl, otp.dl, and vocabulary.dl.

.type EtsTable = [kind: symbol, ident: symbol]

// ── Tables as objects ───────────────────────────────────────────────

// ETS allocations are points-to objects seeded by processes.dl. source_table exposes
// their destinations after staging.

// ── Creation sites ──────────────────────────────────────────────────

// The names a site gives its table: spelled there, or arriving in the
// parameter the name operand is read from.
.decl site_name(site: symbol, name: symbol)

site_name(n, name) :- ets_new(n, _, name), name != "dynamic".
site_name(n, name) :- ets_new(n, _, "dynamic"), ets_table_path(n, "literal", name, "").

site_name(n, name) :-
  ets_new(n, f, "dynamic"),
  ets_table_path(n, "param", p, ""),
  name_at_param(f, p, name).

// An allocation may create a named table or a site-specific unnamed table. Unknown
// runtime options permit both possibilities.
.decl site_table(site: symbol, kind: symbol, ident: symbol)

site_table(n, "named", name) :- named_site(n), site_name(n, name).
site_table(n, "new", n) :- ets_new(n, _, _), !named_site(n).
site_table(n, "named", name) :- site_name(n, name), !named_site(n), !ets_options_known(n).

// ── Tables through parameters ───────────────────────────────────────

// Track table parameters used by operations or creation sites and parameters forwarding
// into them. Analyses can add further seeds.
.decl table_param_needed(func: symbol, pos: symbol)

table_param_needed(f, p) :- ets_table_path(id, "param", p, ""), ets_op(id, f, _, _, _).
table_param_needed(f, p) :- ets_table_path(id, "param", p, ""), ets_new(id, f, _).
table_param_needed(f, to_string(p)) :- ets_op_param(id, p), ets_op(id, f, _, _, _).

table_param_needed(c, to_string(m)) :-
  table_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n).

// A literal a caller passes the parameter, directly or through a chain of
// callers forwarding their own.
.decl name_at_param(func: symbol, pos: symbol, name: symbol)

name_at_param(f, p, name) :-
  table_param_needed(f, p),
  call_arg(_, f, n, name),
  name != "dynamic",
  p = to_string(n).

name_at_param(f, p, name) :-
  table_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n),
  name_at_param(c, to_string(m), name).

// Resolve the allocation whose reference reaches a parameter, directly from a caller's
// matching ets_tid_arg or through forwarding.
.decl tid_at_param(func: symbol, pos: symbol, site: symbol)

tid_at_param(f, p, n) :-
  table_param_needed(f, p),
  ets_tid_arg(c, f, k, name),
  p = to_string(k),
  ets_new(n, c, name).

tid_at_param(f, p, n) :-
  table_param_needed(f, p),
  call_arg_forward(c, f, k, m),
  p = to_string(k),
  tid_at_param(c, to_string(m), n).

// A visible caller supplies its own value to this parameter, directly or through a
// forwarding chain.
.decl table_filled_in_view(func: symbol, pos: symbol)

table_filled_in_view(f, p) :- table_param_needed(f, p), call_arg(_, f, n, _), p = to_string(n).
table_filled_in_view(f, p) :- table_param_needed(f, p), ets_tid_arg(_, f, n, _), p = to_string(n).

table_filled_in_view(f, p) :-
  table_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n),
  table_filled_in_view(c, to_string(m)).

// An external caller supplies this parameter through library_face entry `way_in`, at
// `way_in_pos`, then wrappers forward it to `func`. Runtime callback state is excluded;
// see ways_in.dl.
.decl param_from_outside(func: symbol, pos: symbol, way_in: symbol, way_in_pos: symbol)

param_from_outside(f, p, f, p) :-
  table_param_needed(f, p),
  library_face(f),
  !process_entry(_, f).

param_from_outside(f, p, w, q) :-
  table_param_needed(f, p),
  call_arg_forward(c, f, n, m),
  p = to_string(n),
  param_from_outside(c, to_string(m), w, q).

// Tables supplied through a parameter: propagated literal names, known allocation
// references, or an external handed-in table with no visible caller supplying it.
// Handed-in allocation options are unknown.
.decl param_table(func: symbol, pos: symbol, kind: symbol, ident: symbol)

param_table(f, p, "named", name) :- name_at_param(f, p, name).
param_table(f, p, k, t) :- tid_at_param(f, p, n), site_table(n, k, t).

param_table(f, p, "handed_in", cat("param ", q, " of ", w)) :-
  param_from_outside(f, p, w, q),
  !table_filled_in_view(f, p).

// ── Operations ──────────────────────────────────────────────────────

.decl known_table(id: symbol, kind: symbol, ident: symbol)

// A name spelled at the operation, alone or as one arm.
known_table(id, "named", name) :-
  ets_op(id, _, _, _, _),
  ets_table_path(id, "literal", name, "").

// What the parameter holds.
known_table(id, k, t) :-
  ets_op(id, f, _, _, _),
  ets_table_path(id, "param", p, ""),
  param_table(f, p, k, t).

known_table(id, k, t) :-
  ets_op(id, f, _, _, _),
  ets_op_param(id, p),
  param_table(f, to_string(p), k, t).

// Points-to table identities for an operand. Coarse bounded-stage results are
// supersets, so they cannot establish a specific table identity.
known_table(id, k, t) :-
  table_use(id, f, sk, s),
  source_table(f, sk, s, x),
  !coarse_table(x),
  table_alloc(n, _, x),
  site_table(n, k, t).

// A creation site is the table it makes.
known_table(n, k, t) :- site_table(n, k, t).

// The tables operation (or creation site) `id` may touch.
.decl ets_table(id: symbol, kind: symbol, ident: symbol)

ets_table(id, k, t) :- known_table(id, k, t).

.decl has_known_table(id: symbol)

has_known_table(id) :- known_table(id, _, _).

// Nothing better: the map field of a parameter it was read under.
ets_table(id, "field", cat(mod, " ", path)) :-
  ets_table_path(id, "param", _, path),
  path != "",
  ets_op(id, f, _, _, _),
  !has_known_table(id),
  function_def(f, mod, _, _, _).


// ── Where a table is made ───────────────────────────────────────────

// Possible :ets.new/2 allocation sites. Named and allocation-site tables use their own
// sites. Field tables use ets_op's extracted table name as a fallback. Handed-in tables
// have no visible allocation.
.decl table_made_at(kind: symbol, ident: symbol, site: symbol)

table_made_at(k, t, n) :- site_table(n, k, t).

table_made_at("field", t, n) :-
  ets_table(id, "field", t),
  ets_op(id, _, name, _, _),
  name != "dynamic",
  ets_new(n, _, name).

// Tables without a visible allocation, including externally created named tables and
// handed-in references. Their privacy is unknown.
.decl table_made_out_of_view(kind: symbol, ident: symbol)

table_made_out_of_view("named", t) :- ets_table(_, "named", t), !table_made_at("named", t, _).
table_made_out_of_view("handed_in", t) :- ets_table(_, "handed_in", t).

// An unresolved operation, or one known only through a field/handed-in identity, may
// alias any table. Consumers choose the conservative direction: include all candidates
// when proving absence of interference, or none when requiring a definite shared
// identity.
.decl may_touch_any_table(id: symbol)

may_touch_any_table(id) :- ets_op(id, _, _, _, _), !names_a_table(id).

// The operation names a table: a named one, which is its name whoever
// makes it, or one a site in view makes.
.decl names_a_table(id: symbol)

names_a_table(id) :- ets_table(id, "named", _).
names_a_table(id) :- ets_table(id, k, t), table_made_at(k, t, _).

// ── Access ──────────────────────────────────────────────────────────

// A table some site makes :private, readable by its owner alone, or one
// only the process that made it can reach (kept_by_its_process).
.decl table_private(kind: symbol, ident: symbol)

table_private(k, t) :- table_made_at(k, t, n), ets_option(n, "access", "private").
table_private(k, t) :- kept_by_its_process(k, t).

// A table another process can read: made somewhere the program shows,
// and not private.
.decl table_readable_elsewhere(kind: symbol, ident: symbol)

table_readable_elsewhere(k, t) :- table_made_at(k, t, _), !table_private(k, t).

// A table some site makes :public, which any process that reaches it can
// write: every process, unless only its maker reaches it.
.decl table_public(kind: symbol, ident: symbol)

table_public(k, t) :-
  table_made_at(k, t, n),
  ets_option(n, "access", "public"),
  !kept_by_its_process(k, t).

// An unnamed table kept only in its creator's process dictionary, never passed or given
// away, has a separate instance per process. No other process holds its reference,
// regardless of table access options.
.decl kept_by_its_process(kind: symbol, ident: symbol)

kept_by_its_process("new", n) :-
  site_table(n, "new", n),
  table_alloc(n, _, x),
  kept_in_dictionary(x),
  !handed_to_another("new", n).

// A table some :ets.give_away/3 hands to another process.
.decl handed_to_another(kind: symbol, ident: symbol)

handed_to_another(k, t) :- ets_op(id, _, _, "give_away", _), ets_table(id, k, t).

// ── Tables across calls ─────────────────────────────────────────────

// CheckThenAct table identities: names, allocation sites and handed-in tables survive
// all calls (global_identity); module fields survive calls within that module
// (module_identity). Ordinary CheckThenAct "field" keys do not cross calls.
.decl table_source(kind: symbol, source: symbol)

table_source("named", "literal").
table_source("new", "new").
table_source("field", "module field").
table_source("handed_in", "handed_in").
