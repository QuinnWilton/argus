// Interprocedural constant propagation.
//
// Resolves function parameter values by tracing literal arguments
// from call sites through forwarding chains. A "forwarding" is when
// a function passes its own parameter N as argument M to a callee —
// encoded as value = "arg:N" in the call_arg fact.
//
// The key output: additional sync_call and async_cast rows derived
// from the propagation. These are unioned with the extractor-emitted
// .input rows by Souffle, so every analysis that reads sync_call /
// async_cast gets the enriched call graph automatically.
//
// Prerequisites:
//   - call_arg facts emitted by Argus.Extractors.CallArgs
//   - sync_call and async_cast declared by the consumer analysis
//     (with .decl and .input — Souffle unions input + derived rows)

.decl call_arg( caller: symbol, callee: symbol, arg_pos: number, value: symbol)
.input call_arg

// ── Resolved argument propagation ─────────────────────────────────

// resolved_arg(func, arg_pos, value): function `func`'s parameter at
// position `arg_pos` has the resolved literal `value`, as determined
// by tracing literal values from call sites through forwarding chains.

.decl resolved_arg(func: symbol, arg_pos: number, value: symbol)

// Base case: a call site passes a literal value (not "dynamic", not
// a forwarding marker "arg:N").
resolved_arg(callee, pos, val) :-
  call_arg( _, callee, pos, val),
  val != "dynamic",
  !match("arg:.*", val).

// Inductive case: a call site forwards its own parameter N as
// argument M to a callee. If the forwarder's parameter N has a
// resolved value from one of ITS callers, propagate that value.
resolved_arg(callee, callee_pos, val) :-
  call_arg( forwarder, callee, callee_pos, fwd_marker),
  match("arg:.*", fwd_marker),
  fwd_param = to_number(substr(fwd_marker, 4, strlen(fwd_marker) - 4)),
  resolved_arg(forwarder, fwd_param, val).

// ── Enriched sync_call / async_cast ───────────────────────────────
//
// Derive additional sync_call and async_cast rows from the
// propagation. When a function forwards its parameter to
// GenServer.call/cast and a caller passes a literal module atom,
// the forwarding function effectively makes a sync_call to that
// literal target.
//
// These rules require sync_call/async_cast to be declared by the
// consumer (they always are — the consumer's .input directive
// reads the extractor-emitted rows, and these rules add more).

sync_call(func, target) :-
  call_arg( func, callee, 0, fwd),
  match("arg:.*", fwd),
  (callee = "GenServer:call/2" ; callee = "GenServer:call/3" ;
   callee = ":gen_server:call/2" ; callee = ":gen_server:call/3"),
  fwd_pos = to_number(substr(fwd, 4, strlen(fwd) - 4)),
  resolved_arg(func, fwd_pos, target).

async_cast(func, target) :-
  call_arg( func, callee, 0, fwd),
  match("arg:.*", fwd),
  (callee = "GenServer:cast/2" ; callee = ":gen_server:cast/2"),
  fwd_pos = to_number(substr(fwd, 4, strlen(fwd) - 4)),
  resolved_arg(func, fwd_pos, target).
