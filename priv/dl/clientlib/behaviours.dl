// Canonical behaviour names across Erlang and Elixir. `implements_behaviour` uses
// inspect/1 strings, so GenServer and :gen_server differ. Rules should use
// `behaves_as(mod, canonical)` with the Elixir spelling.
// A module may declare a behaviour or be named as its callback module by a start
// (`started_as`). Both establish behaviour membership, including modules with no
// explicit declaration.

.decl behaviour_alias(declared: symbol, canonical: symbol)

behaviour_alias("GenServer", "GenServer").
behaviour_alias(":gen_server", "GenServer").
behaviour_alias("gen_server", "GenServer").

behaviour_alias("Supervisor", "Supervisor").
behaviour_alias(":supervisor", "Supervisor").
behaviour_alias("supervisor", "Supervisor").

behaviour_alias("GenStateMachine", "GenStateMachine").
behaviour_alias(":gen_statem", "GenStateMachine").
behaviour_alias("gen_statem", "GenStateMachine").

behaviour_alias("GenEvent", "GenEvent").
behaviour_alias(":gen_event", "GenEvent").
behaviour_alias("gen_event", "GenEvent").

behaviour_alias("Application", "Application").
behaviour_alias(":application", "Application").
behaviour_alias("application", "Application").

// Erlang supervisor_bridge runs init/1 and terminate/2 in its own supervised process,
// wrapping a subsystem with a separate lifecycle.
behaviour_alias(":supervisor_bridge", ":supervisor_bridge").
behaviour_alias("supervisor_bridge", ":supervisor_bridge").

// Elixir-only behaviours are listed directly so behaves_as works without requiring an
// Erlang equivalent.
behaviour_alias("GenStage", "GenStage").
behaviour_alias("Broadway", "Broadway").
behaviour_alias("Phoenix.LiveView", "Phoenix.LiveView").
behaviour_alias("Phoenix.Channel", "Phoenix.Channel").
behaviour_alias("Task", "Task").
behaviour_alias("Agent", "Agent").

// Wrappers exposing GenServer-style init, call, cast, and info callbacks. The same
// blocking and reply-contract rules apply even if the wrapper internally uses another
// loop.
behaviour_alias("Connection", "GenServer").
behaviour_alias("Postgrex.SimpleConnection", "GenServer").
behaviour_alias("Postgrex.ReplicationConnection", "GenServer").

.decl behaves_as(mod: symbol, canonical: symbol)

behaves_as(mod, canonical) :-
  implements_behaviour(mod, declared),
  behaviour_alias(declared, canonical).

// Preserve behaviour names absent from the alias table so custom behaviours remain
// queryable through behaves_as.
behaves_as(mod, declared) :-
  implements_behaviour(mod, declared),
  !behaviour_alias(declared, _).

behaves_as(mod, canonical) :-
  started_as(mod, named),
  behaviour_alias(named, canonical).

behaves_as(mod, named) :-
  started_as(mod, named),
  !behaviour_alias(named, _).

// Behaviour properties: `loop` owns a mailbox callback loop; `gen_server_like` uses
// GenServer's reply contract; `terminating` runs terminate/2,3. Any listed kind
// identifies a process behaviour, including supervisor_bridge, whose only kind is
// terminating.
.decl process_behaviour(canonical: symbol, kind: symbol)

process_behaviour("GenServer", "loop").
process_behaviour("GenStateMachine", "loop").
process_behaviour("GenEvent", "loop").
process_behaviour("GenStage", "loop").
process_behaviour("Broadway", "loop").
process_behaviour("Supervisor", "loop").
process_behaviour("Phoenix.LiveView", "loop").
process_behaviour("Phoenix.LiveComponent", "loop").
process_behaviour("Phoenix.Channel", "loop").

process_behaviour("GenServer", "gen_server_like").
process_behaviour("GenStage", "gen_server_like").

process_behaviour(":supervisor_bridge", "terminating").

process_behaviour("GenServer", "terminating").
process_behaviour("GenStage", "terminating").
process_behaviour("GenStateMachine", "terminating").
process_behaviour("GenEvent", "terminating").
process_behaviour("Broadway", "terminating").
process_behaviour("Phoenix.LiveView", "terminating").

// Behaviours such as supervisor_bridge set trap_exit before init/1, allowing supervisor
// shutdown to invoke terminate/2.
.decl behaviour_traps_exits(canonical: symbol)

behaviour_traps_exits(":supervisor_bridge").

// A gen_statem: its state functions and its data are the process
// points-to's and the mailbox rules' (process_statem.dl, process_kind.dl).
.decl statem_process(mod: symbol)

statem_process(mod) :- behaves_as(mod, "GenStateMachine").
