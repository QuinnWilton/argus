// Deserialization classes still considered unsafe. [:safe] prevents some new runtime
// objects but does not guarantee safe use of the decoded term; loaded-module funs may
// still be invoked. It lowers severity without clearing the finding. Only validated
// term-walking decoders clear it. Requires imports.dl.

.decl unsafe_safety_class(safety: symbol)

unsafe_safety_class("unsafe").
unsafe_safety_class("atoms_only").
unsafe_safety_class("dynamic").
