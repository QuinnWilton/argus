// Signal targets resolved by the points-to stage, including caller-specific helper
// parameters. Rejoin staged process_signal with call/use views here so call-only
// consumers need not read signals. Requires imports.dl and otp.dl.

pid_use(id, f, kind, sk, s) :- process_signal_source(id, f, kind, sk, s).

// Signal kinds (exit, monitor, link, unlink) are not call kinds, so a
// call's rows are the same with or without these.
.decl process_signal(func: symbol, anchor: symbol, site: symbol, signal: symbol, proc: symbol) mutable
.input process_signal

process_call(f, a, id, signal, p) :- process_signal(f, a, id, signal, p).

// The exit signal, monitor, link or unlink at `id` in `func` may go to
// `proc`.
.decl signal_target(id: symbol, func: symbol, signal: symbol, proc: symbol)

signal_target(id, g, signal, p) :-
  process_signal(_, _, id, signal, p),
  process_signal_source(id, g, signal, _, _).

// A process something monitors or links to: its crash is observed.
.decl watched_process(proc: symbol, how: symbol)

watched_process(p, how) :-
  signal_target(_, _, how, p),
  (how = "monitor" ; how = "link").

// An exit signal whose every resolved target the sending module started
// itself (and at least one resolved): a server stopping its own worker.
.decl exit_to_own_process(id: symbol, func: symbol)

.decl exit_to_other(id: symbol)

exit_to_other(id) :-
  signal_target(id, f, "exit", p),
  function_def(f, m, _, _, _),
  !started_by_module(p, m).

exit_to_own_process(id, f) :-
  signal_target(id, f, "exit", p),
  function_def(f, m, _, _, _),
  started_by_module(p, m),
  !exit_to_other(id).
