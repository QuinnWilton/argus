// How a process defers work past init/1.
//
// An init/1 that cannot do something yet (connect, subscribe, find a
// peer) has four ways to try again later: arm a timer, send itself a
// message, return {:continue, _} to a handle_continue, or (a
// gen_statem) arm a timeout. A rule that asks "can this module retry"
// asks for any of them; one that asks "which" reads the kind.
//
// Requires otp.dl.

.decl deferral_path(mod: symbol, kind: symbol)

deferral_path(mod, "timer") :- mailbox_writer(_, f, "timer"), function_def(f, mod, _, _, _).
deferral_path(mod, "timer") :- mailbox_writer(_, f, "timer_bare"), function_def(f, mod, _, _, _).
deferral_path(mod, "self") :- mailbox_writer(_, f, "self"), function_def(f, mod, _, _, _).
deferral_path(mod, "continue") :- init_continues_to(mod, _).
deferral_path(mod, "continue") :- handle_continue_clause(mod, _, _).
deferral_path(mod, "statem_timeout") :- statem_timeout(mod, _, _, _).
