// Reachability over the call graph, as components.
//
// Every analysis asks the same two questions of the call graph: which
// functions can reach one of these sites (backward), and what can this
// entry reach (forward). Each used to write its own two-clause closure;
// this file writes each shape once. An analysis instantiates the variant
// it needs, seeds it with the sites it cares about, and reads `reaches`:
//
//   .init connect_reach = CallReach
//   connect_reach.seed(f, api) :- impure_call(_, f, api, "network", _), connect_api(api).
//   ... connect_reach.reaches(init, api) ...
//
// A seed is in its own reach. A rule that wants callers only (the
// function holding the site excluded) seeds the first hop instead:
// `seed(f, sink) :- call_edge(f, g), sink_in(g, sink)`.
//
// The step is the difference between the variants. `call_edge` treats
// closure construction as a call (stage 0 derives an edge from every
// `closure_def`), and a fun handed to a call as one (`fun_ref`), so a
// plain step follows execution into lambdas and fun references;
// SameProcess subtracts the edges into what a start runs (a receive
// inside `spawn(fn -> ... end)` or `spawn(&M.loop/0)` runs elsewhere,
// one inside a closure handed to Enum.map in the caller's process:
// runs_elsewhere, in runs_elsewhere.dl, which a SameProcess instance needs);
// IntraModule stays inside one module. Each variant states its step in its own
// recursive clause rather than copying `call_edge` into a per-instance
// relation, so an analysis with four instances pays for four closures,
// not four call graphs.
//
// The declarations inside a component are indented on purpose:
// dl_declarations_test scans for `^.decl`, and these are not schema
// relations. Instances add no `.input`, so the analysis input pins do not
// move.

// ── Backward: which functions reach a seeded (func, target) ──────────

.comp Backward {
  .decl seed(func: symbol, target: symbol)
  .decl reaches(func: symbol, target: symbol)
  reaches(f, t) :- seed(f, t).
}

.comp CallReach : Backward {
  reaches(f, t) :- call_edge(f, g), reaches(g, t).
}

// The calling process's own work: every edge but the one into a
// function a start hands to a new process. `spawn_link(fn -> loop() end)`
// in init/1 waits in the loop's process; a closure handed to Enum.each
// runs in init's.
.comp SameProcessReach : Backward {
  reaches(f, t) :- call_edge(f, g), !runs_elsewhere(f, g), reaches(g, t).
}

.comp IntraModuleReach : Backward {
  reaches(f, t) :-
    call_edge(f, g),
    function_def(f, m, _, _, _),
    function_def(g, m, _, _, _),
    reaches(g, t).
}

// ── Backward over data flow: which (function, parameter) feeds a seed ─
//
// The step is call_arg_derived rather than call_edge: f's parameter p
// reaches the target when some call in f hands a value derived from p to
// g's parameter k, and g's k reaches it. A closure's captured environment
// is recorded as its trailing parameters, so closure_def needs no clause
// of its own. Seeded at the few sites that matter (a sink's argument),
// never closed forward from every entry.

.comp ParamReach {
  .decl seed(func: symbol, pos: number, target: symbol)
  .decl reaches(func: symbol, pos: number, target: symbol)
  reaches(f, p, t) :- seed(f, p, t).
  reaches(f, p, t) :- call_arg_derived(f, g, k, p), reaches(g, k, t).
}

// ── Backward, as a set: which functions reach any seed ───────────────

.comp BackwardSet {
  .decl seed(func: symbol)
  .decl reaches(func: symbol)
  reaches(f) :- seed(f).
}

.comp CallReachSet : BackwardSet {
  reaches(f) :- call_edge(f, g), reaches(g).
}

.comp SameProcessReachSet : BackwardSet {
  reaches(f) :- call_edge(f, g), !runs_elsewhere(f, g), reaches(g).
}

// ── Forward: what each root reaches ──────────────────────────────────

.comp Forward {
  .decl root(root: symbol, func: symbol)
  .decl reaches(root: symbol, func: symbol)
  reaches(r, f) :- root(r, f).
}

.comp ForwardCallReach : Forward {
  reaches(r, h) :- reaches(r, g), call_edge(g, h).
}

// Forward over what the root's own process runs (runs_elsewhere, as
// SameProcessReach): a spawned function and the loop it calls.
.comp ForwardSameProcessReach : Forward {
  reaches(r, h) :- reaches(r, g), call_edge(g, h), !runs_elsewhere(g, h).
}

// Forward, staying inside the root's module: a server's own stack.
.comp ForwardIntraModuleReach : Forward {
  reaches(r, h) :-
    reaches(r, g),
    call_edge(g, h),
    function_def(g, m, _, _, _),
    function_def(h, m, _, _, _).
}

.comp ForwardSet {
  .decl root(func: symbol)
  .decl reaches(func: symbol)
  reaches(f) :- root(f).
}

.comp ForwardCallReachSet : ForwardSet {
  reaches(h) :- reaches(g), call_edge(g, h).
}

// Depth-bounded, for the rules that want "close to" rather than
// "anywhere below": `limit(3)` covers terminate -> cleanup helper -> the
// API it calls, and stops before a client library's connection pool.
.comp ForwardBoundedCallReach {
  .decl root(root: symbol, func: symbol)
  .decl limit(n: number)
  .decl reaches(root: symbol, func: symbol, depth: number)
  reaches(r, f, 0) :- root(r, f).
  reaches(r, h, d + 1) :- reaches(r, g, d), limit(n), d < n, call_edge(g, h).
}

// Depth-bounded forward, along the calls no guard covers: a path stops
// at a call the instance marks `guarded` (a site inside a handler that
// takes what the rule is about), and at an edge with no call instruction
// (a closure handed to a call, a function reference: call_instr, in
// calls.dl, has no site for it) out of a function the instance marks
// `sealed`. `first` is the path's call in the root, empty when the path
// leaves the root through such an edge. The root is not seeded into its
// own reach (depth starts at 1).
.comp ForwardGuardedCallReach {
  .decl root(root: symbol)
  .decl limit(n: number)
  .decl guarded(call: symbol)
  .decl sealed(func: symbol)
  .decl reaches(root: symbol, func: symbol, depth: number, first: symbol)

  reaches(r, g, 1, call) :- root(r), call_instr(r, g, call), !guarded(call).
  reaches(r, g, 1, "") :- root(r), call_edge(r, g), !call_instr(r, g, _), !sealed(r).

  reaches(r, h, d + 1, first) :-
    reaches(r, g, d, first),
    limit(n),
    d < n,
    call_instr(g, h, call),
    !guarded(call).

  reaches(r, h, d + 1, first) :-
    reaches(r, g, d, first),
    limit(n),
    d < n,
    call_edge(g, h),
    !call_instr(g, h, _),
    !sealed(g).
}

// The same, walked against the edges: from a few interesting functions
// to the callers that reach them within `limit` calls.
.comp BackwardBoundedCallReach {
  .decl root(root: symbol, func: symbol)
  .decl limit(n: number)
  .decl reaches(root: symbol, func: symbol, depth: number)
  reaches(r, f, 0) :- root(r, f).
  reaches(r, g, d + 1) :- reaches(r, h, d), limit(n), d < n, call_edge(g, h).
}
