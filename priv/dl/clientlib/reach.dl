// Seeded call-graph reachability components. Backward variants find callers of relevant
// sites; forward variants find work reached from selected entries. Seeds reach
// themselves; seed the first caller hop to exclude the source function.
// Plain reach follows call, closure, and fun-reference edges. SameProcess excludes
// detached/deferred execution and requires runs_elsewhere.dl. IntraModule restricts
// traversal to one module. Each variant traverses call_edge directly rather than
// copying the graph per instance.
// Instantiate the needed component, populate seed/root, and read reaches. Indented
// component declarations are not schema relations and add no inputs.

// ── Backward: which functions reach a seeded (func, target) ──────────

.comp Backward {
  .decl seed(func: symbol, target: symbol)
  .decl reaches(func: symbol, target: symbol)
  reaches(f, t) :- seed(f, t).
}

.comp CallReach : Backward {
  reaches(f, t) :- call_edge(f, g), reaches(g, t).
}

// Follow the caller's own work. Exclude functions started in another process; retain
// inline closures, such as those passed to Enum.each.
.comp SameProcessReach : Backward {
  reaches(f, t) :- call_edge(f, g), !runs_elsewhere(f, g), reaches(g, t).
}

// SameProcessReach with instance-defined cut edges excluded. Use cuts to bound a phase,
// such as init before acknowledgement, or to exclude side paths.
.comp SameProcessReachCut : Backward {
  .decl cut(func: symbol, callee: symbol)
  reaches(f, t) :- call_edge(f, g), !runs_elsewhere(f, g), !cut(f, g), reaches(g, t).
}

// Work the caller waits for: its own stack plus tasks it awaits. See awaits_task in
// runs_elsewhere.dl.
.comp HoldingReach : Backward {
  reaches(f, t) :- call_edge(f, g), !runs_elsewhere(f, g), reaches(g, t).
  reaches(f, t) :- awaits_task(f, _, g), reaches(g, t).
}

.comp IntraModuleReach : Backward {
  reaches(f, t) :-
    call_edge(f, g),
    function_def(f, m, _, _, _),
    function_def(g, m, _, _, _),
    reaches(g, t).
}

// Backward parameter flow through `call_arg_derived`. A caller parameter reaches a
// target when data derived from it enters a callee parameter that reaches the target.
// Closure captures are trailing parameters, so no separate closure edge is needed. Seed
// only relevant sink arguments.

.comp ParamReach {
  .decl seed(func: symbol, pos: number, target: symbol)
  .decl reaches(func: symbol, pos: number, target: symbol)
  reaches(f, p, t) :- seed(f, p, t).
  reaches(f, p, t) :- call_arg_derived(f, g, k, p), reaches(g, k, t).
}

// Broader backward data flow using `call_arg_reads` plus `call_arg_derived` for closure
// elements. Runtime call results are treated as derived from their arguments even
// without a known propagator. Suitable for conservative caller-input checks, not exact
// taint claims. Positions use symbols.
.comp ParamReadsReach {
  .decl seed(func: symbol, pos: symbol, target: symbol)
  .decl reaches(func: symbol, pos: symbol, target: symbol)
  reaches(f, p, t) :- seed(f, p, t).
  reaches(f, p, t) :- call_arg_reads(f, g, k, "param", p), reaches(g, to_string(k), t).
  reaches(f, to_string(p), t) :- call_arg_derived(f, g, k, p), reaches(g, to_string(k), t).
}

// ── Backward, as a set: which functions reach any seed ───────────────

.comp BackwardSet {
  .decl seed(func: symbol)
  .decl reaches(func: symbol)
  reaches(f) :- seed(f).
}

.comp CallReachSet : BackwardSet {
  reaches(f) :- call_edge(f, g), reaches(g).
}

.comp SameProcessReachSet : BackwardSet {
  reaches(f) :- call_edge(f, g), !runs_elsewhere(f, g), reaches(g).
}

// The same, less the edges the instance names `cut` (another phase's,
// or a side path's, as SameProcessReachCut).
.comp SameProcessReachSetCut : BackwardSet {
  .decl cut(func: symbol, callee: symbol)
  reaches(f) :- call_edge(f, g), !runs_elsewhere(f, g), !cut(f, g), reaches(g).
}

// ── Forward: what each root reaches ──────────────────────────────────

.comp Forward {
  .decl root(root: symbol, func: symbol)
  .decl reaches(root: symbol, func: symbol)
  reaches(r, f) :- root(r, f).
}

.comp ForwardCallReach : Forward {
  reaches(r, h) :- reaches(r, g), call_edge(g, h).
}

// ForwardCallReach, less the edges the instance names `cut` (effects:
// the edge into what a start runs in a new process).
.comp ForwardCallReachCut : Forward {
  .decl cut(func: symbol, callee: symbol)
  reaches(r, h) :- reaches(r, g), call_edge(g, h), !cut(g, h).
}

// Forward same-process reachability, excluding instance-defined cut edges such as side
// paths.
.comp ForwardSameProcessReachCut : Forward {
  .decl cut(func: symbol, callee: symbol)
  reaches(r, h) :- reaches(r, g), call_edge(g, h), !runs_elsewhere(g, h), !cut(g, h).
}

// Forward, staying inside the root's module: a server's own stack.
.comp ForwardIntraModuleReach : Forward {
  reaches(r, h) :-
    reaches(r, g),
    call_edge(g, h),
    function_def(g, m, _, _, _),
    function_def(h, m, _, _, _).
}

// Forward reach within the root's module and process. Exclude closures handed to tasks,
// spawns or registrars (runs_elsewhere); their receives and monitors belong to other
// execution contexts.
.comp ForwardIntraModuleSameProcessReach : Forward {
  reaches(r, h) :-
    reaches(r, g),
    call_edge(g, h),
    !runs_elsewhere(g, h),
    function_def(g, m, _, _, _),
    function_def(h, m, _, _, _).
}

// ForwardIntraModuleSameProcessReach, less the edges the instance names
// `cut` (mailbox: a call back into the server's handle_info/2).
.comp ForwardIntraModuleSameProcessReachCut : Forward {
  .decl cut(func: symbol, callee: symbol)
  reaches(r, h) :-
    reaches(r, g),
    call_edge(g, h),
    !runs_elsewhere(g, h),
    !cut(g, h),
    function_def(g, m, _, _, _),
    function_def(h, m, _, _, _).
}

// The same, and a task the process waits for (awaits_task,
// runs_elsewhere.dl): what holds the root up until it returns.
.comp ForwardIntraModuleHoldingReach : ForwardIntraModuleSameProcessReach {
  reaches(r, h) :-
    reaches(r, g),
    awaits_task(g, _, h),
    function_def(g, m, _, _, _),
    function_def(h, m, _, _, _).
}

.comp ForwardSet {
  .decl root(func: symbol)
  .decl reaches(func: symbol)
  reaches(f) :- root(f).
}

.comp ForwardCallReachSet : ForwardSet {
  reaches(h) :- reaches(g), call_edge(g, h).
}

// Functions reached on any root's own stack, excluding detached work and
// instance-defined cut edges.
.comp ForwardSameProcessReachSetCut : ForwardSet {
  .decl cut(func: symbol, callee: symbol)
  reaches(h) :- reaches(g), call_edge(g, h), !runs_elsewhere(g, h), !cut(g, h).
}

// Depth-bounded reachability for nearby dependencies. For example, limit(3) covers
// terminate, its cleanup helper and that helper's API call.
.comp ForwardBoundedCallReach {
  .decl root(root: symbol, func: symbol)
  .decl limit(n: number)
  .decl reaches(root: symbol, func: symbol, depth: number)
  reaches(r, f, 0) :- root(r, f).
  reaches(r, h, d + 1) :- reaches(r, g, d), limit(n), d < n, call_edge(g, h).
}

// Forward reach along paths without a guard of the requested kind. `guarded` cuts call
// sites; `guarded_edge` cuts closure edges; fun references are followed. The complement
// identifies functions guarded on every entry path.
.comp ForwardUnguardedSet {
  .decl root(func: symbol, kind: symbol)
  .decl guarded(call: symbol, kind: symbol)
  .decl guarded_edge(func: symbol, callee: symbol, kind: symbol)
  .decl reaches(func: symbol, kind: symbol)

  reaches(f, k) :- root(f, k).
  reaches(g, k) :- reaches(f, k), call_instr(f, g, call), !guarded(call, k).
  reaches(g, k) :- reaches(f, k), closure_def(f, g), !guarded_edge(f, g, k).
  reaches(g, k) :- reaches(f, k), fun_ref(f, g).
}

// Walk backward through edges the instance does not mark guarded. For fun_handed, test
// the receiving call's guard; other edges without call instructions remain open. If all
// incoming paths are guarded, a seed reaches only itself.
.comp BackwardUnguarded {
  .decl seed(func: symbol, target: symbol)
  .decl guarded(call: symbol)
  .decl reaches(func: symbol, target: symbol)

  reaches(f, t) :- seed(f, t).
  reaches(f, t) :- reaches(h, t), call_instr(f, h, id), !guarded(id).
  reaches(f, t) :- reaches(h, t), fun_handed(id, f, h, _), !guarded(id).

  reaches(f, t) :-
    reaches(h, t),
    call_edge(f, h),
    !call_instr(f, h, _),
    !fun_handed(_, f, h, _).
}

// BackwardUnguarded restricted to one process's stack. Exclude detached or deferred
// work, such as task closures, spawned functions and registered callbacks
// (runs_elsewhere).
.comp BackwardUnguardedSameProcess {
  .decl seed(func: symbol, target: symbol)
  .decl guarded(call: symbol)
  .decl reaches(func: symbol, target: symbol)

  reaches(f, t) :- seed(f, t).
  reaches(f, t) :- reaches(h, t), call_instr(f, h, id), !guarded(id).
  reaches(f, t) :- reaches(h, t), fun_handed(id, f, h, _), !guarded(id), !runs_elsewhere(f, h).

  reaches(f, t) :-
    reaches(h, t),
    call_edge(f, h),
    !runs_elsewhere(f, h),
    !call_instr(f, h, _),
    !fun_handed(_, f, h, _).
}

// The same, walked against the edges: from a few interesting functions
// to the callers that reach them within `limit` calls.
.comp BackwardBoundedCallReach {
  .decl root(root: symbol, func: symbol)
  .decl limit(n: number)
  .decl reaches(root: symbol, func: symbol, depth: number)
  reaches(r, f, 0) :- root(r, f).
  reaches(r, g, d + 1) :- reaches(r, h, d), limit(n), d < n, call_edge(g, h).
}
