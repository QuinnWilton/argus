// State lost when a peer restarts. A once-phase request may create a relationship the
// caller does not re-establish after the keeper restarts. Per-use calls and repeated
// name resolution do not retain that relationship.
// `holds_in(a, b, site_func, tag, how, store)` links a's startup request to storage in
// b: ETS table, monitor/link, changed callback state, process dictionary, or unknown
// external code (`handed`). `store` identifies the keeping operation.
// Follow the entered call/cast clause and same-module, same-process helpers. Unknown
// tags admit every clause; unknown external code may retain the request.
// Not tracked: info sends, gen_statem requests, detached startup work, direct writes
// into the peer's tables, keeper reconstruction from durable storage, or independent
// re-registration schedules. A re-registration on news of the keeper's restart is
// coupling.dl's (recovers_registrations).
// Requires otp.dl and effect_model.dl; includes runs.dl for once-phase classification.
.include "runs.dl"

// A call or cast from a's once code to b, with the site's request tag or `any`. Pair
// target and tag through calls.dl. Exclude requests to a's own process.
.decl once_request(a: symbol, b: symbol, kind: symbol, tag: symbol, func: symbol)

once_request(a, b, "call", tag, g) :-
  once_code(a, g),
  sync_request_at(g, _, b, tag),
  a != b.

once_request(a, b, "cast", tag, g) :-
  once_code(a, g),
  async_request_at(g, _, b, tag),
  a != b.

// For an unresolved client-wrapper target, attribute the request to b when b's own
// handler accepts that site's tag. Proxies using only another server's tag remain
// unresolved. This handles call and cast sites without including resolved_calls.dl.
once_request(a, b, "call", tag, g) :-
  once_code(a, g),
  sync_call_site(id, g, t, _),
  unresolved_target(t),
  call_tag(id, g, "call", tag),
  function_def(g, b, _, _, _),
  handle_call_function(b, h),
  callback_tag(h, "handle_call", tag),
  a != b.

once_request(a, b, "cast", tag, g) :-
  once_code(a, g),
  async_cast_site(id, g, t),
  unresolved_target(t),
  call_tag(id, g, "cast", tag),
  function_def(g, b, _, _, _),
  handle_cast_function(b, h),
  callback_tag(h, "handle_cast", tag),
  a != b.

// A call or cast made at a once-phase handler site, including startup continuations,
// startup-message clauses, and closed state gates. The whole handler may repeat, so
// classify the site rather than the function.
once_request(a, b, "call", tag, h) :-
  once_phase_site(a, h, id),
  child_subtree(_, _, a),
  sync_request_at(h, id, b, tag),
  a != b.

once_request(a, b, "cast", tag, h) :-
  once_phase_site(a, h, id),
  child_subtree(_, _, a),
  async_request_at(h, id, b, tag),
  a != b.

// ── What b's handler keeps ───────────────────────────────────────────

// A handler a request of `kind` enters.
.decl request_handler(mod: symbol, kind: symbol, handler: symbol)

request_handler(m, "call", h) :- handle_call_function(m, h), once_request(_, m, "call", _, _).
request_handler(m, "cast", h) :- handle_cast_function(m, h), once_request(_, m, "cast", _, _).

// An instruction of f that keeps something in f's process.
.decl keeps_site(site: symbol, func: symbol, how: symbol)

keeps_site(x, f, "table") :- ets_op(x, f, _, _, "write").
keeps_site(x, f, "monitor") :- process_signal_source(x, f, "monitor", _, _).
keeps_site(x, f, "monitor") :- process_signal_source(x, f, "link", _, _).
keeps_site(x, f, "monitor") :- monitor_call(x, f, _).
keeps_site(x, f, "dict") :- impure_call(x, f, _, "process_dict", "write").

keeps_site(x, f, "handed") :-
  unknown_call(x, f, api, c),
  !function_def(c, _, _, _, _),
  !structural_call(api).

// What a handler's call enters: the helpers of the handler's module, on
// its stack.
.init handler_reach = ForwardIntraModuleSameProcessReach

handler_reach.root(c, g) :- request_handler(_, _, h), call_instr(h, g, c).

// `kept(b, h, tag, how, store)`: the clause of b's handler h for `tag`
// ("*" for what every clause shares) keeps something.
.decl kept(mod: symbol, handler: symbol, tag: symbol, how: symbol, store: symbol)

kept(b, h, tag, how, x) :- request_handler(b, _, h), keeps_site(x, h, how), clause_call(x, h, tag).
kept(b, h, "*", how, x) :- request_handler(b, _, h), keeps_site(x, h, how), !clause_call(x, h, _).

kept(b, h, tag, how, x) :-
  request_handler(b, _, h),
  call_instr(h, _, c),
  clause_call(c, h, tag),
  handler_reach.reaches(c, g),
  keeps_site(x, g, how).

kept(b, h, "*", how, x) :-
  request_handler(b, _, h),
  call_instr(h, _, c),
  !clause_call(c, h, _),
  handler_reach.reaches(c, g),
  keeps_site(x, g, how).

// Returned handler state by clause, including state returned through helpers. A
// helper's return facts apply to all its clauses.
kept(b, h, tag, "state", h) :-
  request_handler(b, _, h),
  returned_update(h, k, v, tag),
  !initial_field(b, k, v).

kept(b, h, tag, "state", g) :-
  request_handler(b, _, h),
  call_instr(h, g, c),
  returns_call(h, g),
  clause_call(c, h, tag),
  function_def(g, b, _, _, _),
  returned_update(g, k, v, _),
  !initial_field(b, k, v).

kept(b, h, "*", "state", g) :-
  request_handler(b, _, h),
  call_instr(h, g, c),
  returns_call(h, g),
  !clause_call(c, h, _),
  function_def(g, b, _, _, _),
  returned_update(g, k, v, _),
  !initial_field(b, k, v).

// Initial values of fields in b's state. Resetting a field to its init/1 value loses no
// additional state on restart. `*` represents a whole state without fields, such as a
// counter initialized to 0.
.decl initial_field(mod: symbol, key: symbol, value: symbol)

initial_field(b, k, v) :-
  init_function(b, i),
  returned_update(i, k, v, _),
  v != "dynamic".

// ── A holds something in b ──────────────────────────────────────────
.decl holds_in(a: symbol, b: symbol, func: symbol, tag: symbol, how: symbol, store: symbol)

holds_in(a, b, g, tag, how, x) :-
  once_request(a, b, kind, tag, g),
  request_handler(b, kind, h),
  kept(b, h, ctag, how, x),
  (ctag = tag ; ctag = "*").

holds_in(a, b, g, "any", how, x) :-
  once_request(a, b, kind, "any", g),
  request_handler(b, kind, h),
  kept(b, h, _, how, x).
