// Exit-trapping state. `trapping_at(func, site)` follows a preceding flag set through
// local calls or callers. `server_traps` identifies a server whose entry leaves
// trapping enabled; `module_traps` supplies the witness.
// These are may-properties: one trapping branch or caller is sufficient. Only literal
// false clears the flag; computed restores and clears in other functions may be missed.
// Callback ordering is unknown except for init, so a flag left by one callback counts
// for others. Traps with no known process entry remain attributed to their defining
// module.
// Requires imports.dl, otp.dl, and order.dl.

// ── Where the flag is set, and cleared ──────────────────────────────

// Functions whose own stack sets the flag somewhere (SameProcessReach):
// the calls into them are where a caller sets it.
.init trap_below = SameProcessReachSet

trap_below.seed(f) :- trap_exit(_, f, _).

// The order of every set and clear of the flag in its function, and of
// every call into a function that may set it.
.init trap_order = RunsAfter

trap_order.asked(id) :- trap_exit(id, _, _).
trap_order.asked(id) :- untrap_exit(id, _, _).
trap_order.asked(id) :- call_instr(f, g, id), !runs_elsewhere(f, g), trap_below.reaches(g).

// `func` sets trap_exit at site, directly or through a helper that returns trapping.
// `witness` identifies the actual flag-setting call.
.decl sets_trap_at(func: symbol, site: symbol, witness: symbol)

sets_trap_at(f, id, f) :- trap_exit(id, f, _).

sets_trap_at(f, id, w) :-
  call_instr(f, g, id),
  !runs_elsewhere(f, g),
  leaves_trapping(g, w).

// `func` returns trapping if it sets the flag without a later clear, or runs a
// same-process function that leaves it set.
.decl leaves_trapping(func: symbol, witness: symbol)

leaves_trapping(f, w) :- sets_trap_at(f, id, w), !cleared_after(id).

leaves_trapping(f, w) :-
  call_edge(f, g),
  !call_instr(f, g, _),
  !runs_elsewhere(f, g),
  leaves_trapping(g, w).

// A clear of the flag runs after `site` in its function.
.decl cleared_after(site: symbol)

cleared_after(s) :- untrap_exit(u, _, _), trap_order.runs_after(s, u).

// A clear of the flag runs before `site` in its function.
.decl cleared_before(site: symbol)

cleared_before(s) :- untrap_exit(u, _, _), trap_order.runs_after(u, s).

// A clear runs between the set at `set` and `site`.
.decl cleared_between(set: symbol, site: symbol)

cleared_between(t, s) :-
  untrap_exit(u, _, _),
  trap_order.runs_after(t, u),
  trap_order.runs_after(u, s).

// ── Is the process trapping at this point ───────────────────────────

// At site, trap_exit was set earlier locally or inherited on entry, with no intervening
// clear.
.decl trapping_at(func: symbol, site: symbol) inline

trapping_at(f, s) :- flag_set_before(f, s).
trapping_at(f, s) :- entered_trapping(f), !cleared_before(s).

// `func` sets the flag before `site`, and nothing clears it between.
.decl flag_set_before(func: symbol, site: symbol)

flag_set_before(f, s) :-
  sets_trap_at(f, t, _),
  trap_order.runs_after(t, s),
  !cleared_between(t, s).

// The function enters with trap_exit set: a trapping server's non-init callback, init/1
// under a behaviour that pre-traps exits, or a call or passed fun reached after its
// caller sets the flag.
.decl entered_trapping(func: symbol)

entered_trapping(e) :-
  process_entry(mod, e),
  !init_function(mod, e),
  server_traps(mod).

entered_trapping(i) :-
  init_function(mod, i),
  behaves_as(mod, b),
  behaviour_traps_exits(b).

entered_trapping(h) :-
  call_instr(g, h, c),
  !runs_elsewhere(g, h),
  trapping_at(g, c).

entered_trapping(h) :-
  fun_handed(c, g, h, _),
  !runs_elsewhere(g, h),
  trapping_at(g, c).

// A closure or fun handed nowhere the facts say runs where its maker is.
entered_trapping(h) :-
  entered_trapping(g),
  call_edge(g, h),
  !call_instr(g, h, _),
  !fun_handed(_, g, h, _),
  !runs_elsewhere(g, h).

// ── Does the server trap while its callbacks run ────────────────────

// mod's server traps exits while its callbacks run (module_traps).
.decl server_traps(mod: symbol)

server_traps(mod) :- module_traps(_, mod).

// Attribute a flag left enabled to the process entry whose same-process stack sets it,
// even in another module's helper. Detached closures trap only their own process's
// exits. If no process entry reaches the set, fall back to its defining module.
.decl module_traps(func: symbol, mod: symbol)

module_traps(func, mod) :-
  process_entry(mod, entry),
  leaves_trapping(entry, func),
  !traps_elsewhere(func).

module_traps(func, mod) :-
  trap_exit(id, func, mod),
  !cleared_after(id),
  !traps_elsewhere(func),
  !trap_on_process_stack(func).

// A behaviour whose own machinery traps exits before it calls the
// module's init/1 (behaviour_traps_exits, behaviours.dl: a
// supervisor_bridge): the module's process traps, init/1 the witness.
module_traps(func, mod) :-
  behaves_as(mod, b),
  behaviour_traps_exits(b),
  function_def(func, mod, "init", 1, _).

// Use `may_trap` when reporting absent trapping: a known set or unresolved flag value
// can enable it. Detached funs do not affect the starter. Use `server_traps` when a
// finding requires positive evidence of trapping.
.decl may_trap(mod: symbol)

may_trap(mod) :- server_traps(mod).

may_trap(mod) :-
  process_entry(mod, entry),
  unread_trap_reach.reaches(entry).

.init unread_trap_reach = SameProcessReachSet

unread_trap_reach.seed(func) :- trap_flag_unread(_, func, _).

// A server entry reaches this trap_exit call on its own stack. The flag need not remain
// set afterward.
.decl trap_on_process_stack(func: symbol)

trap_on_process_stack(func) :-
  process_entry(_, entry),
  process_trap_reach.reaches(entry, func).

.init process_trap_reach = SameProcessReach

process_trap_reach.seed(func, func) :- trap_exit(_, func, _), !traps_elsewhere(func).

// The trap_exit call is in a closure or fun handed to a process start
// that the module never calls itself (runs_elsewhere), and that process
// does not become the module's own server.
.decl traps_elsewhere(func: symbol)

traps_elsewhere(func) :-
  trap_exit(_, func, _),
  runs_elsewhere(_, func),
  !call_instr(_, func, _),
  !enters_own_loop(func).

// `func`'s own stack enters the gen_server or gen_statem loop of
// `func`'s module (`proc_lib:spawn_link(?MODULE, init, [...])` whose
// init/1 calls `gen_server:enter_loop(?MODULE, ...)`, as ranch protocols
// do): the process proc_lib starts becomes that module's server, and a
// trap it sets is the server's. A loop of another module, or one whose
// module is not a literal, leaves the trap elsewhere.
.decl enters_own_loop(func: symbol)

enters_own_loop(f) :-
  function_def(f, mod, _, _, _),
  enters_loop_of.reaches(f, mod).

.init enters_loop_of = SameProcessReach

enters_loop_of.seed(g, mod) :-
  call_arg(g, callee, 0, mod),
  match(":gen_(server|statem):enter_loop/[0-9]+", callee).

// A trapping module's handle_info/2 has no clause accepting EXIT messages. `witness`
// identifies the function setting trap_exit. Exclude gen_statem, which delivers these
// messages to state functions.
.decl trap_exit_without_exit_clause(mod: symbol, witness: symbol)

trap_exit_without_exit_clause(mod, func) :-
  module_traps(func, mod),
  partial_handle_info(mod, h),
  !takes_some_exits(h),
  !statem_process(mod).
