// The OTP vocabulary, in one include.
//
//   .include "../clientlib/imports.dl"
//   .include "../clientlib/otp.dl"
//
// Provides behaviours.dl (behaves_as, process_behaviour), callbacks.dl
// (otp_callback, init_function, handler_function, ...), calls.dl
// (sync_dep, reaches_sync_dep, stateful_module_dep, ...) and
// supervision.dl (child_subtree, starts_before). An analysis that needs
// only the behaviour table may include behaviours.dl alone; one that
// includes this file must not include it again.
.include "behaviours.dl"
.include "callbacks.dl"
.include "calls.dl"
.include "supervision.dl"
