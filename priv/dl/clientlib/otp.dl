// The OTP vocabulary, in one include.
//
//   .include "../clientlib/imports.dl"
//   .include "../clientlib/otp.dl"
//
// Provides behaviours.dl (behaves_as, process_behaviour), callbacks.dl
// (otp_callback, init_function, handler_function, ...),
// staged_processes.dl (process_call, call_site_target, instance,
// named_pid: which process a pid can be, as the points-to stage derived
// it; sends.dl and signals.dl add send_target and signal_target),
// runs_elsewhere.dl, calls.dl (sync_dep, reaches_sync_dep,
// stateful_module_dep, ...) and supervision.dl (child_subtree,
// starts_before). An analysis that needs only the behaviour table may
// include behaviours.dl alone; one that includes this file must not
// include it again.
.include "behaviours.dl"
.include "callbacks.dl"
.include "staged_processes.dl"
.include "runs_elsewhere.dl"
.include "calls.dl"
.include "supervision.dl"
.include "process.dl"
.include "entries.dl"
.include "startup.dl"
