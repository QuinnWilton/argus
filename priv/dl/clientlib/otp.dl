// OTP pattern helpers for client analyses.
//
// Provides GenServer API detection, init function identification, and
// stateful module dependency analysis. Requires layer 2 facts from the
// OTP and supervision extractors.
//
// Prerequisites: include clientlib/imports.dl before this file, and
// declare/input the layer 2 facts needed below.
//
// Usage:
//   .include "../clientlib/imports.dl"
//
//   .decl implements_behaviour(mod: symbol, behaviour: symbol)
//   .input implements_behaviour
//   .decl sync_call(caller_func: symbol, callee_mod: symbol)
//   .input sync_call
//   .decl async_cast(caller_func: symbol, callee_mod: symbol)
//   .input async_cast
//
//   .include "../clientlib/otp.dl"
//
// Provides:
//   init_function(mod, func)
//   genserver_sync_api(func, mod)
//   genserver_async_api(func, mod)
//   stateful_module_dep(from_mod, to_mod)
//   module_reaches(from_mod, to_mod)

.include "init_function_rules.dl"
.include "genserver_api_rules.dl"
.include "stateful_module_dep_rules.dl"
