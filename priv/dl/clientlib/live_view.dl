// LiveView lifecycle and subscriptions. `static_render_callback` identifies callbacks
// that also run before connection in the HTTP process. `connected_guarded` identifies
// calls restricted to the connected phase.
// Subscriptions include PubSub, pg, endpoint APIs, and dynamic endpoint calls;
// `subscription_call` records matching removals. `in_endpoint` attributes endpoint
// internals to the caller's subscription. Requires imports.dl and behaviours.dl.

.decl static_render_callback(mod: symbol, func: symbol)

static_render_callback(m, f) :- behaves_as(m, "Phoenix.LiveView"), function_def(f, m, "mount", 3, _).
static_render_callback(m, f) :- behaves_as(m, "Phoenix.LiveView"), function_def(f, m, "handle_params", 3, _).
static_render_callback(m, f) :- behaves_as(m, "Phoenix.LiveComponent"), function_def(f, m, "mount", 1, _).
static_render_callback(m, f) :- behaves_as(m, "Phoenix.LiveComponent"), function_def(f, m, "update", 2, _).
static_render_callback(m, f) :- function_def(f, m, "on_mount", 4, 1).

.decl endpoint_module(mod: symbol)

endpoint_module(m) :- function_def(_, m, "__sockets__", 0, _).

.decl in_endpoint(func: symbol)

in_endpoint(f) :- endpoint_module(m), function_def(f, m, _, _, _).

// The call at `site` in `func` subscribes (`op` "subscribe") or undoes a
// subscription ("unsubscribe").
.decl subscription_call(site: symbol, func: symbol, op: symbol)

subscription_call(id, f, op) :- pubsub_call(id, f, op, "pubsub").
subscription_call(id, f, op) :- pubsub_call(id, f, op, "apply").
subscription_call(id, f, op) :- pubsub_call(id, f, op, m), endpoint_module(m).
