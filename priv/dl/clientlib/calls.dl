// Process call and cast dependencies.
// Requires imports, behaviours, callbacks, staged_processes, and runs_elsewhere
// (included by otp.dl).
// Provides argument resolution; client API classification; direct and transitive
// sync/async dependencies; request tags and call sites; timeout-qualified dependencies;
// and module-level dependencies with witnesses. Seed `site_demand` for clause-sensitive
// `site_request` results.
// resolved_calls.dl adds self-directed dependencies for consumers accepting value-flow
// inputs.

// Constant propagation
//
// Propagate literal arguments through forwarded numeric parameter positions. Avoid
// partial to_number/substr functors: an engine may evaluate them before their guards.
// dl_declarations_test enforces this.
.decl resolved_arg(func: symbol, arg_pos: number, value: symbol)

resolved_arg(callee, pos, val) :-
  call_arg(_, callee, pos, val),
  val != "dynamic".

resolved_arg(callee, callee_pos, val) :-
  call_arg_forward(forwarder, callee, callee_pos, fwd_param),
  resolved_arg(forwarder, fwd_param, val).

// Wrapper target parameters
//
// Summarize which parameter becomes a call or cast target, then resolve literals at
// each caller. Resolving all callers' values inside the wrapper would incorrectly mix
// their targets. The wrapper's own unresolved target remains dynamic. Includes
// GenServer and gen_statem APIs.
.decl target_param(func: symbol, pos: number, kind: symbol)

target_param(f, p, "call") :- call_arg_forward(f, callee, 0, p), peer_call(callee).
target_param(f, p, "cast") :- call_arg_forward(f, callee, 0, p), peer_cast(callee).
target_param(f, p, kind) :- call_arg_forward(f, g, k, p), target_param(g, k, kind).

// `func` passes the literal `target` into a wrapper's target parameter:
// a call ("call") or cast ("cast") of func's own.
.decl named_target(func: symbol, kind: symbol, target: symbol)

named_target(f, kind, t) :-
  call_arg(f, g, k, t),
  t != "dynamic",
  target_param(g, k, kind).

sync_call(f, t) :- named_target(f, "call", t).
async_cast(f, t) :- named_target(f, "cast", t).

// The calls into the wrapper that make it: the site a dependency on the
// target points at.
.decl named_target_site(func: symbol, site: symbol, kind: symbol, target: symbol)

named_target_site(f, id, kind, t) :-
  call_arg(f, g, k, t),
  t != "dynamic",
  target_param(g, k, kind),
  call_instr(f, g, id).

// Client APIs
//
// An exported GenServer-module function making a direct or same-module reachable sync
// call may be a client API even with an unresolved target. The following table names
// synchronous peer-call APIs.
.decl peer_call(callee: symbol)

peer_call("GenServer:call/2").
peer_call("GenServer:call/3").
peer_call(":gen_server:call/2").
peer_call(":gen_server:call/3").
peer_call(":gen_statem:call/2").
peer_call(":gen_statem:call/3").
peer_call("GenStateMachine:call/2").
peer_call("GenStateMachine:call/3").

// The one-way counterpart.
.decl peer_cast(callee: symbol)

peer_cast("GenServer:cast/2").
peer_cast(":gen_server:cast/2").
peer_cast(":gen_statem:cast/2").
peer_cast("GenStateMachine:cast/2").

.decl genserver_sync_api(func: symbol, mod: symbol)

genserver_sync_api(func, mod) :-
  function_def(func, mod, _, _, 1),
  gen_server_like(mod),
  sync_call(func, _),
  !calls_other_server(func, mod).

genserver_sync_api(func, mod) :-
  function_def(func, mod, _, _, 1),
  gen_server_like(mod),
  reaches_sync_caller_in(func, mod).

.decl genserver_async_api(func: symbol, mod: symbol)

genserver_async_api(func, mod) :-
  function_def(func, mod, _, _, 1),
  gen_server_like(mod),
  async_cast(func, _),
  !casts_other_server(func, mod).

// A function calling another module's server is a proxy. Its callers depend on that
// server, not on the module containing the proxy.
.decl calls_other_server(func: symbol, mod: symbol)

calls_other_server(func, mod) :-
  call_target(func, "call", p),
  server_process(p, other),
  function_def(func, mod, _, _, _),
  other != mod.

.decl casts_other_server(func: symbol, mod: symbol)

casts_other_server(func, mod) :-
  call_target(func, "cast", p),
  server_process(p, other),
  function_def(func, mod, _, _, _),
  other != mod.

// Logging and telemetry boundaries
//
// Do not propagate application peer waits through logging/telemetry API entries. The
// visible machinery waits on its own servers; configured handlers are dispatched by
// runtime values and absent from this call graph. Propagating those internal waits
// would create spurious application chains and cycles.
.decl side_api(mod: symbol)

side_api(":logger").
side_api(":error_logger").
side_api("Logger").
side_api(":telemetry").

.decl side_call(func: symbol, callee: symbol)

side_call(f, g) :-
  call_edge(f, g),
  function_def(g, gm, _, _, _),
  side_api(gm),
  function_def(f, fm, _, _, _),
  !side_api(fm).

// Dependencies
//
// `sync_dep(f, m)` is a direct wait on m or its client API; `reaches_sync_dep` adds
// reachable waits. Dynamic and via-name strings do not identify server modules. Resolve
// them through points-to or message tags instead.
.decl sync_dep(func: symbol, mod: symbol)

sync_dep(f, m) :-
  sync_call(f, m),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m).

sync_dep(f, m) :-
  call_edge(f, g),
  !side_call(f, g),
  genserver_sync_api(g, m),
  function_def(f, fm, _, _, _),
  fm != m.

// Points-to resolves a pid-targeted call to m's server. Parameter-based helper calls
// belong to the caller supplying the pid, not the shared helper.
sync_dep(f, m) :-
  process_call(f, _, _, "call", p),
  server_process(p, m).

// The instruction creating a synchronous dependency on mod: GenServer.call or a call to
// mod's client API. Literal-target matching excludes dynamic and via targets.
.decl sync_site(func: symbol, mod: symbol, id: symbol)

sync_site(f, m, id) :-
  sync_call_site(id, f, m, _),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m).

sync_site(f, m, id) :-
  genserver_sync_api(g, m),
  call_instr(f, g, id),
  !side_call(f, g),
  function_def(f, fm, _, _, _),
  fm != m.

sync_site(f, m, id) :-
  process_call(f, id, _, "call", p),
  server_process(p, m).

sync_site(f, m, id) :-
  named_target_site(f, id, "call", m),
  m != ":dynamic",
  !match("via:.*", m).

// f casts to m's process, as sync_dep calls it (the same spelled
// targets, side paths and client APIs).
.decl async_dep(func: symbol, mod: symbol)

async_dep(f, m) :-
  async_cast(f, m),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m).

async_dep(f, m) :-
  call_edge(f, g),
  !side_call(f, g),
  genserver_async_api(g, m),
  function_def(f, fm, _, _, _),
  fm != m.

async_dep(f, m) :-
  process_call(f, _, _, "cast", p),
  server_process(p, m).

// Target inference from message tags
//
// Attribute an unresolved call when exactly one eligible server handles its tag.
// `callback_tag` over-approximates handlers, so extra matches create ambiguity and
// suppress attribution. Same-module cases are handled by resolved_calls.dl.
.decl unresolved_target(target: symbol)

unresolved_target("dynamic").
unresolved_target(":dynamic").
unresolved_target(t) :- sync_call(_, t), match("via:.*", t).
unresolved_target(t) :- async_cast(_, t), match("via:.*", t).

.decl tag_handler(mod: symbol, kind: symbol, tag: symbol)

tag_handler(mod, "call", tag) :-
  callback_tag(h, "handle_call", tag),
  handle_call_function(mod, h).

tag_handler(mod, "cast", tag) :-
  callback_tag(h, "handle_cast", tag),
  handle_cast_function(mod, h).

.decl tag_handler_count(kind: symbol, tag: symbol, n: number)

tag_handler_count(kind, tag, count(h)) :- tag_handler(h, kind, tag).

// Generic tags such as :get and :stop cannot identify a server, even if only one
// matching handler is visible.
.decl generic_tag(tag: symbol)

generic_tag(":get").
generic_tag(":put").
generic_tag(":set").
generic_tag(":stop").
generic_tag(":start").
generic_tag(":ping").
generic_tag(":state").
generic_tag(":status").
generic_tag(":info").
generic_tag(":sync").
generic_tag(":flush").
generic_tag(":reset").
generic_tag(":refresh").
generic_tag(":reload").
generic_tag(":ok").

// A tag some handle_info/2 also matches is a message shape shared by
// more than servers, so a handle_call matching it is weak evidence.
.decl info_tag(tag: symbol)

info_tag(tag) :- callback_tag(_, "handle_info", tag).

// A static reference from the caller's module helps choose among servers handling the
// same tag. Read the staged call graph; analyses do not depend directly on remote_call.
.decl module_refers(mod: symbol, other: symbol)

module_refers(mod, other) :-
  call_edge(f, g),
  function_def(f, mod, _, _, _),
  function_def(g, other, _, _, _),
  mod != other.

.decl referred_handler(from_mod: symbol, kind: symbol, tag: symbol, mod: symbol)

referred_handler(fm, kind, tag, mod) :-
  tag_handler(mod, kind, tag),
  module_refers(fm, mod).

.decl referred_handler_count(from_mod: symbol, kind: symbol, tag: symbol, n: number)

referred_handler_count(fm, kind, tag, count(h)) :- referred_handler(fm, kind, tag, h).

// Use tag inference only if points-to did not resolve this site. A concrete target
// overrides a conflicting tag guess and is not marked inferred.
.decl tag_resolved_site(id: symbol, func: symbol, kind: symbol, mod: symbol)

.decl pointsto_resolved(id: symbol, func: symbol, kind: symbol)

pointsto_resolved(id, f, kind) :- call_site_target(id, f, kind, _).

.decl tag_resolved_call(func: symbol, kind: symbol, mod: symbol)

tag_resolved_call(func, kind, mod) :- tag_resolved_site(_, func, kind, mod).

// By evidence: the caller's module refers to exactly one handler of the tag.
tag_resolved_site(id, func, kind, mod) :-
  call_tag(id, func, kind, tag),
  function_def(func, fm, _, _, _),
  referred_handler(fm, kind, tag, mod),
  referred_handler_count(fm, kind, tag, 1),
  fm != mod,
  !pointsto_resolved(id, func, kind).

// Infer the target from a sufficiently specific tag with exactly one handler in the
// program.
tag_resolved_site(id, func, kind, mod) :-
  call_tag(id, func, kind, tag),
  tag_handler(mod, kind, tag),
  tag_handler_count(kind, tag, 1),
  !generic_tag(tag),
  !info_tag(tag),
  function_def(func, fm, _, _, _),
  fm != mod,
  !pointsto_resolved(id, func, kind).

// The sync dependencies that exist only by tag attribution, propagated
// backwards like reaches_sync_dep, so a consumer can mark an inferred
// edge for the reader.
.decl tag_dep(func: symbol, mod: symbol)

tag_dep(f, m) :-
  tag_resolved_site(id, f, "call", m),
  sync_call_site(id, f, t, _),
  unresolved_target(t).

.decl reaches_tag_dep(func: symbol, mod: symbol)

reaches_tag_dep(f, m) :- tag_dep(f, m).

reaches_tag_dep(f, m) :-
  call_edge(f, g),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_tag_dep(g, m).

reaches_tag_dep(f, m) :- awaits_task(f, _, g), reaches_tag_dep(g, m).

sync_dep(f, m) :-
  tag_resolved_site(id, f, "call", m),
  sync_call_site(id, f, t, _),
  unresolved_target(t).

async_dep(f, m) :-
  tag_resolved_call(f, "cast", m),
  async_cast(f, t),
  unresolved_target(t).

.decl reaches_sync_dep(func: symbol, mod: symbol)

// Propagate waits only across same-process calls, plus tasks the caller awaits.
// Detached work retains its own dependency but does not block its starter. Traverse
// backward from dependency holders, bounding results by functions × target modules
// rather than full call-graph closure.
reaches_sync_dep(f, m) :- sync_dep(f, m).

reaches_sync_dep(f, m) :-
  call_edge(f, g),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_sync_dep(g, m).

reaches_sync_dep(f, m) :- awaits_task(f, _, g), reaches_sync_dep(g, m).

// Request tags
//
// Attach each wait's atom or tuple-head tag, using `any` when unknown. This supports
// clause-specific call chains. `reaches_sync_request` covers the same dependencies as
// `reaches_sync_dep`.

// The tag of the sync call at `id`, "any" when its message has none.
.decl sent_tag(id: symbol, func: symbol, tag: symbol)

sent_tag(id, f, tag) :- sync_call_site(id, f, _, _), call_tag(id, f, "call", tag).
sent_tag(id, f, "any") :- sync_call_site(id, f, _, _), !call_tag(id, f, "call", _).

// A direct wait with its request tag and site. Use an empty site for site-less wrapper
// edges. Dynamic/via targets require resolution; resolved_calls.dl adds self-directed
// cases.
.decl sync_request_at(func: symbol, site: symbol, mod: symbol, tag: symbol)

sync_request_at(f, id, m, tag) :-
  sync_call_site(id, f, m, _),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m),
  sent_tag(id, f, tag).

// Use an empty site when facts identify the call but no local instruction or
// literal-target wrapper anchors it.
sync_request_at(f, "", m, "any") :-
  sync_call(f, m),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m),
  !sync_call_site(_, f, m, _),
  !named_target_site(f, _, "call", m).

// A literal target handed to a wrapper: at the call into it.
sync_request_at(f, id, m, "any") :-
  named_target_site(f, id, "call", m),
  m != ":dynamic",
  !match("via:.*", m).

// A points-to-resolved call carries its message tag, or "any" when no sync_call_site
// tag is available.
sync_request_at(f, anchor, m, tag) :-
  process_call(f, anchor, site, "call", p),
  server_process(p, m),
  sent_tag(site, _, tag).

sync_request_at(f, anchor, m, "any") :-
  process_call(f, anchor, site, "call", p),
  server_process(p, m),
  !sync_call_site(site, _, _, _).

sync_request_at(f, id, m, tag) :-
  tag_resolved_site(id, f, "call", m),
  sync_call_site(id, f, t, _),
  unresolved_target(t),
  call_tag(id, f, "call", tag).

// The tag of the cast at `id`, "any" when its message has none.
.decl cast_sent_tag(id: symbol, func: symbol, tag: symbol)

cast_sent_tag(id, f, tag) :- async_cast_site(id, f, _), call_tag(id, f, "cast", tag).
cast_sent_tag(id, f, "any") :- async_cast_site(id, f, _), !call_tag(id, f, "cast", _).

// A cast's target and message tag at its own site. Use an empty site when func has no
// corresponding instruction. Client-API casts belong to the API function; dynamic and
// via-name targets need resolution.
.decl async_request_at(func: symbol, site: symbol, mod: symbol, tag: symbol)

async_request_at(f, id, m, tag) :-
  async_cast_site(id, f, m),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m),
  cast_sent_tag(id, f, tag).

// Use an empty site for casts with no local instruction or literal-target wrapper, such
// as gen_event notifications.
async_request_at(f, "", m, "any") :-
  async_cast(f, m),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m),
  !async_cast_site(_, f, m),
  !named_target_site(f, _, "cast", m).

// A literal target handed to a wrapper: at the call into it.
async_request_at(f, id, m, "any") :-
  named_target_site(f, id, "cast", m),
  m != ":dynamic",
  !match("via:.*", m).

// A cast points-to resolves: tagged as its site's message is, or "any"
// when the site is not one async_cast_site describes.
async_request_at(f, anchor, m, tag) :-
  process_call(f, anchor, site, "cast", p),
  server_process(p, m),
  cast_sent_tag(site, _, tag).

async_request_at(f, anchor, m, "any") :-
  process_call(f, anchor, site, "cast", p),
  server_process(p, m),
  !async_cast_site(site, _, _).

async_request_at(f, id, m, tag) :-
  tag_resolved_site(id, f, "cast", m),
  async_cast_site(id, f, t),
  unresolved_target(t),
  call_tag(id, f, "cast", tag).

// Request tags sent by a server's client API. Use "any" when a call has no known tag or
// occurs in a callee.
.decl api_request_tag(func: symbol, tag: symbol)

api_request_tag(g, tag) :- genserver_sync_api(g, _), call_tag(_, g, "call", tag).

api_request_tag(g, "any") :-
  genserver_sync_api(g, _),
  sync_call_site(id, g, _, _),
  !call_tag(id, g, "call", _).

api_request_tag(g, "any") :- genserver_sync_api(g, _), !call_tag(_, g, "call", _).

.decl sync_request_known(func: symbol, mod: symbol, tag: symbol)

sync_request_known(f, m, tag) :- sync_request_at(f, _, m, tag).

sync_request_known(f, m, tag) :-
  call_edge(f, g),
  !side_call(f, g),
  genserver_sync_api(g, m),
  function_def(f, fm, _, _, _),
  fm != m,
  api_request_tag(g, tag).

.decl sync_request_seen(func: symbol, mod: symbol)

sync_request_seen(f, m) :- sync_request_known(f, m, _).

// Give every sync_dep a request classification. Unclassified dependencies default to
// "any".
.decl sync_request(func: symbol, mod: symbol, tag: symbol)

sync_request(f, m, tag) :- sync_request_known(f, m, tag).
sync_request(f, m, "any") :- sync_dep(f, m), !sync_request_seen(f, m).

.decl reaches_sync_request(func: symbol, mod: symbol, tag: symbol)

reaches_sync_request(f, m, tag) :- sync_request(f, m, tag).

reaches_sync_request(f, m, tag) :-
  call_edge(f, g),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_sync_request(g, m, tag).

reaches_sync_request(f, m, tag) :- awaits_task(f, _, g), reaches_sync_request(g, m, tag).

// Clause-sensitive request sites
//
// Seed `site_demand(f)` to obtain calls in f leading to tagged waits. Literal first
// arguments restrict callees to matching or unrestricted clauses; other entries use
// full function reach. Empty sites represent edges without a call instruction,
// including some fun or wrapper-target edges.
.decl site_demand(func: symbol)

// Every call from f to g passes a known literal atom first; emit each possible atom.
// Forwarded, computed, or tuple arguments normally prevent narrowing. Shared by request
// and global-lock walks. Compute independently of demand because those walks negate it.
.decl literal_first(func: symbol, callee: symbol, value: symbol)

literal_first(f, g, a) :-
  call_arg(f, g, 0, a),
  match(":.*", a),
  !call_arg(f, g, 0, "dynamic"),
  !call_arg_forward(f, g, 0, _).

// Also narrow when every f-to-g call forwards f's first argument from a clause with a
// known tag. The tag may identify an atom or tuple head. Any unrestricted clause or
// different forwarding source prevents narrowing.
literal_first(f, g, a) :-
  call_arg_forward(f, g, 0, 0),
  !call_arg_forward_other(f, g),
  !call_arg(f, g, 0, "dynamic"),
  !forwards_untagged(f, g),
  call_instr(f, g, id),
  clause_call(id, f, a),
  !clause_event(f, a, _, _).

// A gen_statem event function's clause is told by its event's type and
// content (clause_event); its first argument, the one forwarded, is the
// type.
literal_first(f, g, a) :-
  call_arg_forward(f, g, 0, 0),
  !call_arg_forward_other(f, g),
  !call_arg(f, g, 0, "dynamic"),
  !forwards_untagged(f, g),
  call_instr(f, g, id),
  clause_call(id, f, t),
  clause_event(f, t, a, _).

literal_first(f, g, a) :-
  call_arg_forward(f, g, 0, 0),
  !call_arg_forward_other(f, g),
  !call_arg(f, g, 0, "dynamic"),
  !forwards_untagged(f, g),
  call_arg(f, g, 0, a),
  match(":.*", a).

// f's first argument at position 0 of a call to g is not f's first
// parameter.
.decl call_arg_forward_other(func: symbol, callee: symbol)

call_arg_forward_other(f, g) :- call_arg_forward(f, g, 0, k), k != 0.

// A call from f to g without a containing clause tagged by a literal atom first
// argument.
.decl forwards_untagged(func: symbol, callee: symbol)

forwards_untagged(f, g) :-
  call_arg_forward(f, g, 0, 0),
  call_instr(f, g, id),
  !clause_call(id, f, _).

forwards_untagged(f, g) :-
  call_arg_forward(f, g, 0, 0),
  call_instr(f, g, id),
  clause_call(id, f, t),
  !match(":.*", t).

// literal_first, for the functions site_request is asked of.
.decl literal_entry(func: symbol, callee: symbol, value: symbol)

literal_entry(f, g, a) :- site_demand(f), literal_first(f, g, a).

site_demand(g) :- site_demand(f), call_instr(f, g, _), literal_entry(f, g, _).

.decl site_request(func: symbol, site: symbol, mod: symbol, tag: symbol)

site_request(f, id, m, tag) :- site_demand(f), sync_request_at(f, id, m, tag).

// A call f makes itself is on f's stack (runs_elsewhere holds only for
// an edge f does not call).
site_request(f, id, m, tag) :-
  site_demand(f),
  call_instr(f, g, id),
  !side_call(f, g),
  !literal_entry(f, g, _),
  reaches_sync_request(g, m, tag).

site_request(f, id, m, tag) :-
  site_demand(f),
  call_instr(f, g, id),
  !side_call(f, g),
  literal_entry(f, g, a),
  site_request(g, s, m, tag),
  site_clause(g, s, c),
  // A known first argument selects its literal clause, a catch-all, or a gen_statem
  // clause with that event type. Event content does not narrow the first argument.
  (c = a ; c = "any" ; clause_event(g, c, a, _)).

site_request(f, id, m, tag) :-
  site_demand(f),
  call_instr(f, g, id),
  !side_call(f, g),
  genserver_sync_api(g, m),
  function_def(f, fm, _, _, _),
  fm != m,
  api_request_tag(g, tag).

// A passed closure or fun reference uses its receiving call as the site (`fun_handed`).
// A stored fun with no receiving call has no site. Only same-process execution
// contributes to f's wait.
site_request(f, id, m, tag) :-
  site_demand(f),
  call_edge(f, g),
  !call_instr(f, g, _),
  fun_handed(id, f, g, _),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_sync_request(g, m, tag).

site_request(f, "", m, tag) :-
  site_demand(f),
  call_edge(f, g),
  !call_instr(f, g, _),
  !fun_handed(_, f, g, _),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_sync_request(g, m, tag).

// A task f awaits waits for f (awaits_task): its site is the start.
site_request(f, id, m, tag) :-
  site_demand(f),
  awaits_task(f, id, g),
  reaches_sync_request(g, m, tag).

site_request(f, "", m, tag) :-
  site_demand(f),
  call_edge(f, g),
  !call_instr(f, g, _),
  !side_call(f, g),
  genserver_sync_api(g, m),
  function_def(f, fm, _, _, _),
  fm != m,
  api_request_tag(g, tag).

// The first-argument tag the clause holding `site` serves: clause_call's,
// or "any" for a call every clause shares, or a hop with no site.
.decl site_clause(func: symbol, site: symbol, tag: symbol)

site_clause(f, id, tag) :- site_request(f, id, _, _), clause_call(id, f, tag).
site_clause(f, id, "any") :- site_request(f, id, _, _), !clause_call(id, f, _).

// Propagate async dependencies over the same process boundaries as sync dependencies,
// excluding detached work and side APIs. A detached task's cast is its own, not init's.
.decl reaches_async_dep(func: symbol, mod: symbol)

reaches_async_dep(f, m) :- async_dep(f, m).

reaches_async_dep(f, m) :-
  call_edge(f, g),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_async_dep(g, m).

// Dependency timeout: -1 means infinity and 0 unknown. Preserve the waiting wrapper's
// timeout and pair points-to targets with that same call site.
.decl sync_dep_timeout(func: symbol, mod: symbol, timeout_ms: number)

// A spelled target, as sync_dep's (a via or dynamic one names no module).
sync_dep_timeout(f, m, ms) :-
  sync_call_timeout(f, m, ms),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m).

// The timeout of the very call the tag attributes, not of any unresolved
// call in the same function.
sync_dep_timeout(f, m, ms) :-
  tag_resolved_site(id, f, "call", m),
  sync_call_site(id, f, t, ms),
  unresolved_target(t).

// A call process points-to resolves, with its own timeout: the helper's
// call when f hands the pid to one.
sync_dep_timeout(f, m, ms) :-
  process_call(f, _, site, "call", p),
  server_process(p, m),
  sync_call_site(site, _, _, ms).

sync_dep_timeout(f, m, ms) :-
  call_edge(f, g),
  !side_call(f, g),
  genserver_sync_api(g, m),
  sync_call_timeout(g, callee, ms),
  (callee = m ; callee = "dynamic"),
  function_def(f, fm, _, _, _),
  fm != m.

.decl reaches_sync_dep_timeout(func: symbol, mod: symbol, timeout_ms: number)

reaches_sync_dep_timeout(f, m, ms) :- sync_dep_timeout(f, m, ms).

// Attribute waits only to the executing process. Timeouts reached solely in detached
// tasks, spawns or agents do not belong to f.
reaches_sync_dep_timeout(f, m, ms) :-
  call_edge(f, g),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_sync_dep_timeout(g, m, ms).

// Private process dependencies
//
// Every resolved call/cast to mod uses a private instance, none uses a supervised or
// registered shared instance, and no literal target names mod. Sibling restart rules
// exclude these dependencies because restarting a shared child does not replace the
// caller's private process.
.decl private_dep(func: symbol, mod: symbol)

private_dep(f, m) :-
  call_target(f, kind, p),
  (kind = "call" ; kind = "cast"),
  server_process(p, m),
  private_process(p, _, _),
  !shared_dep(f, m).

.decl shared_dep(func: symbol, mod: symbol)

shared_dep(f, m) :-
  call_target(f, kind, p),
  (kind = "call" ; kind = "cast"),
  server_process(p, m),
  !private_process(p, _, _).

shared_dep(f, m) :- sync_call(f, m).
shared_dep(f, m) :- async_cast(f, m).

// A module that depends on `mod` through private instances alone: some
// function of it does, and none does otherwise.
.decl private_module_dep(from_mod: symbol, to_mod: symbol)

private_module_dep(a, b) :-
  private_dep(f, b),
  function_def(f, a, _, _, _),
  !shared_module_dep(a, b).

.decl shared_module_dep(from_mod: symbol, to_mod: symbol)

shared_module_dep(a, b) :- shared_dep(f, b), function_def(f, a, _, _, _).

// ── Module-level dependency ────────────────────────────────────────────
//
// A function defined in `from_mod` transitively reaches a function
// defined in `to_mod`; `witness` is the reaching function.
.decl module_reaches(from_mod: symbol, to_mod: symbol, witness: symbol)

// `func` reaches (through at least one call) some function of `mod`.
.decl reaches_module(func: symbol, mod: symbol)

// Asked only of a module some supervisor starts (coupling's siblings,
// the one consumer of stateful_module_dep), so only those are targets.
.decl module_dep_target(mod: symbol)

module_dep_target(m) :- child_subtree(_, _, m).

reaches_module(f, m) :-
  call_edge(f, g),
  function_def(g, m, _, _, _),
  module_dep_target(m).

reaches_module(f, m) :-
  call_edge(f, g),
  reaches_module(g, m).

module_reaches(from_mod, to_mod, caller) :-
  function_def(caller, from_mod, _, _, _),
  reaches_module(caller, to_mod),
  from_mod != to_mod.

// A transitive call reaches mod's synchronous client API. Exclude proxies whose calls
// resolve to another module's server (calls_other_server).
.decl reaches_sync_caller_in(func: symbol, mod: symbol)

reaches_sync_caller_in(f, m) :-
  call_edge(f, g),
  function_def(g, m, _, _, _),
  sync_call(g, _),
  !calls_other_server(g, m).

reaches_sync_caller_in(f, m) :-
  call_edge(f, g),
  reaches_sync_caller_in(g, m).

// A function of from_mod waits on to_mod's process, somewhere below it.
.decl module_sync_dep(from_mod: symbol, to_mod: symbol, witness: symbol)

module_sync_dep(from_mod, to_mod, f) :-
  function_def(f, from_mod, _, _, _),
  reaches_sync_dep(f, to_mod),
  from_mod != to_mod.

// A module's sync or async process dependency, resolved or inferred from the target
// module's unresolved client API. `witness` identifies the caller function. Used for
// restart-policy coupling; stored relationships lost on restart are tracked separately
// in restart_state.dl.
.decl stateful_module_dep(from_mod: symbol, to_mod: symbol, witness: symbol)

stateful_module_dep(from_mod, to_mod, f) :- module_sync_dep(from_mod, to_mod, f).

stateful_module_dep(from_mod, to_mod, f) :-
  function_def(f, from_mod, _, _, _),
  reaches_async_dep(f, to_mod),
  from_mod != to_mod.

stateful_module_dep(from_mod, to_mod, w) :-
  module_reaches(from_mod, to_mod, w),
  module_client_call(to_mod).

// Some function of `mod` makes a call or cast.
.decl module_client_call(mod: symbol)

module_client_call(m) :- function_def(h, m, _, _, _), sync_call(h, _).
module_client_call(m) :- function_def(h, m, _, _, _), async_cast(h, _).
