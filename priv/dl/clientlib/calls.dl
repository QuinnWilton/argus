// Who waits on whom.
//
// Requires imports.dl, behaviours.dl, callbacks.dl, staged_processes.dl
// and runs_elsewhere.dl (otp.dl includes all of them).
// Reads the extracted sync_call / sync_call_site / async_cast /
// sync_call_timeout / call_arg / call_arg_forward facts and answers one question in a few shapes: does this function, or
// this module, synchronously depend on that module's process.
//
// Provides:
//   resolved_arg(func, arg_pos, value)          + sync_call/async_cast rows
//   genserver_sync_api(func, mod) / genserver_async_api(func, mod)
//   sync_dep(func, mod) / async_dep(func, mod)               — direct
//   reaches_sync_dep(func, mod) / reaches_async_dep(func, mod) — transitive
//   sync_request_at(func, site, mod, tag) / reaches_sync_request(func, mod, tag)
//     — the same waits, with the request's tag
//   site_request(func, site, mod, tag) — per call site of a function a
//     consumer names in site_demand, entering callees by their literal
//     first argument
//   sync_dep_timeout(func, mod, timeout_ms) / reaches_sync_dep_timeout
//   module_reaches(from_mod, to_mod, witness)  — to_mod a supervised module
//   stateful_module_dep(from_mod, to_mod, witness)
//   stateful_module_dep_kind(from_mod, to_mod, kind)
//
// resolved_calls.dl adds the self-directed rows to sync_dep for analyses
// that accept the value-flow relations in their input set.

// ── Interprocedural constant propagation ──────────────────────────────
//
// A literal argument to a callee is known at the callee; a callee that
// forwards a parameter onward has that parameter's value known too. The
// forwarded position is a number column: `to_number`/`substr` are partial
// functors that abort the whole program when Souffle's magic-set
// transform reorders a guard past them, which
// test/argus/dl_declarations_test.exs forbids statically.
.decl resolved_arg(func: symbol, arg_pos: number, value: symbol)

resolved_arg(callee, pos, val) :-
  call_arg(_, callee, pos, val),
  val != "dynamic".

resolved_arg(callee, callee_pos, val) :-
  call_arg_forward(forwarder, callee, callee_pos, fwd_param),
  resolved_arg(forwarder, fwd_param, val).

// ── A literal target handed to a wrapper ──────────────────────────────
//
// `def flush(server), do: GenServer.call(server, :flush)` called as
// `flush(Cache)`: the caller waits on Cache, at its call into the
// wrapper. The literal is not resolved in the wrapper, whose parameter
// is every target any caller hands it: resolved there, each caller of
// the wrapper reached every caller's target, and two thin modules over
// one server's API (`def flush, do: Buffer.flush(__MODULE__)`, in each)
// called each other. So the wrapper is a summary, "parameter `pos`
// becomes a peer call's target", lifted to the caller that passes the
// literal — as processes.dl lifts a pid handed to a helper
// (targets_param). The wrapper's own call keeps the target the extractor
// gave it, "dynamic". A gen_statem's call or cast is as much a peer call
// (peer_call, peer_cast below).
.decl target_param(func: symbol, pos: number, kind: symbol)

target_param(f, p, "call") :- call_arg_forward(f, callee, 0, p), peer_call(callee).
target_param(f, p, "cast") :- call_arg_forward(f, callee, 0, p), peer_cast(callee).
target_param(f, p, kind) :- call_arg_forward(f, g, k, p), target_param(g, k, kind).

// `func` passes the literal `target` into a wrapper's target parameter:
// a call ("call") or cast ("cast") of func's own.
.decl named_target(func: symbol, kind: symbol, target: symbol)

named_target(f, kind, t) :-
  call_arg(f, g, k, t),
  t != "dynamic",
  target_param(g, k, kind).

sync_call(f, t) :- named_target(f, "call", t).
async_cast(f, t) :- named_target(f, "cast", t).

// The calls into the wrapper that make it: the site a dependency on the
// target points at.
.decl named_target_site(func: symbol, site: symbol, kind: symbol, target: symbol)

named_target_site(f, id, kind, t) :-
  call_arg(f, g, k, t),
  t != "dynamic",
  target_param(g, k, kind),
  call_instr(f, g, id).

// ── Client API ─────────────────────────────────────────────────────────
//
// An exported function of a GenServer module that makes (or reaches, in
// the same module) a sync call is that server's client API: calling it
// is waiting on the server, whether or not the target resolved.
// The callee strings of a synchronous call to a peer process.
.decl peer_call(callee: symbol)

peer_call("GenServer:call/2").
peer_call("GenServer:call/3").
peer_call(":gen_server:call/2").
peer_call(":gen_server:call/3").
peer_call(":gen_statem:call/2").
peer_call(":gen_statem:call/3").
peer_call("GenStateMachine:call/2").
peer_call("GenStateMachine:call/3").

// The one-way counterpart.
.decl peer_cast(callee: symbol)

peer_cast("GenServer:cast/2").
peer_cast(":gen_server:cast/2").
peer_cast(":gen_statem:cast/2").
peer_cast("GenStateMachine:cast/2").

.decl genserver_sync_api(func: symbol, mod: symbol)

genserver_sync_api(func, mod) :-
  function_def(func, mod, _, _, 1),
  behaves_as(mod, "GenServer"),
  sync_call(func, _),
  !calls_other_server(func, mod).

genserver_sync_api(func, mod) :-
  function_def(func, mod, _, _, 1),
  behaves_as(mod, "GenServer"),
  reaches_sync_caller_in(func, mod).

.decl genserver_async_api(func: symbol, mod: symbol)

genserver_async_api(func, mod) :-
  function_def(func, mod, _, _, 1),
  behaves_as(mod, "GenServer"),
  async_cast(func, _),
  !casts_other_server(func, mod).

// A function of `mod` whose call (cast) process points-to resolves to
// another module's server is a proxy: its callers wait on that server,
// not on `mod`'s, whatever module the function sits in.
.decl calls_other_server(func: symbol, mod: symbol)

calls_other_server(func, mod) :-
  call_target(func, "call", p),
  server_process(p, other),
  function_def(func, mod, _, _, _),
  other != mod.

.decl casts_other_server(func: symbol, mod: symbol)

casts_other_server(func, mod) :-
  call_target(func, "cast", p),
  server_process(p, other),
  function_def(func, mod, _, _, _),
  other != mod.

// ── Logging and telemetry are side paths ──────────────────────────────
//
// A call into the logging or telemetry API hands an event to handlers
// the runtime dispatches by value — a handler module named in the
// logger's config, a fun kept in telemetry's table — so the call graph
// reaches none of them: what it reaches is the API's own machinery. That
// machinery waits only on its own servers (logger_server when a handler
// crashes and is removed, a handler's logger_olp in sync mode, the
// handler table on :telemetry.attach), which answer from their own state
// and call no process of the program's. A server that logs from a
// callback is not waiting on a peer that can wait on it, so no wait is
// propagated over the edge from a function outside these modules into
// one: OTP's global, supervisor and mnesia servers log from handle_call,
// and each was a chain, an :infinity hop and a cycle through
// :logger_server and :logger_olp.
.decl side_api(mod: symbol)

side_api(":logger").
side_api(":error_logger").
side_api("Logger").
side_api(":telemetry").

.decl side_call(func: symbol, callee: symbol)

side_call(f, g) :-
  call_edge(f, g),
  function_def(g, gm, _, _, _),
  side_api(gm),
  function_def(f, fm, _, _, _),
  !side_api(fm).

// ── Dependencies ───────────────────────────────────────────────────────
//
// sync_dep(f, m): f itself waits on m's process — a resolved sync call,
// or a call into m's client API. reaches_sync_dep adds every function f
// can reach. Eleven analyses used to derive one of these two by hand,
// with four or five clauses each and no two alike.
.decl sync_dep(func: symbol, mod: symbol)

sync_dep(f, m) :-
  sync_call(f, m),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m).

sync_dep(f, m) :-
  call_edge(f, g),
  !side_call(f, g),
  genserver_sync_api(g, m),
  function_def(f, fm, _, _, _),
  fm != m.

// A call whose target is a pid (sync_call says "dynamic") that the
// points-to analysis follows back to a server started with m's
// callbacks (processes.dl): f's own call, or a helper's that f hands
// the pid to, which is f's dependency rather than the helper's.
sync_dep(f, m) :-
  process_call(f, _, _, "call", p),
  server_process(p, m).

// The instruction in `func` that makes it depend synchronously on
// `mod`: the GenServer.call itself, or the call into mod's own
// synchronous API.
.decl sync_site(func: symbol, mod: symbol, id: symbol)

sync_site(f, m, id) :-
  sync_call_site(id, f, m, _),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m).

sync_site(f, m, id) :-
  genserver_sync_api(g, m),
  call_instr(f, g, id),
  !side_call(f, g),
  function_def(f, fm, _, _, _),
  fm != m.

sync_site(f, m, id) :-
  process_call(f, id, _, "call", p),
  server_process(p, m).

sync_site(f, m, id) :-
  named_target_site(f, id, "call", m),
  m != ":dynamic",
  !match("via:.*", m).

.decl async_dep(func: symbol, mod: symbol)

async_dep(f, m) :-
  async_cast(f, m),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m).

async_dep(f, m) :-
  call_edge(f, g),
  !side_call(f, g),
  genserver_async_api(g, m),
  function_def(f, fm, _, _, _),
  fm != m.

async_dep(f, m) :-
  process_call(f, _, _, "cast", p),
  server_process(p, m).

// ── Resolution by message tag ──────────────────────────────────────────
//
// Most calls target a pid or a name held in state, which the extractor
// reports as "dynamic": on horde that hid a deadlock cycle whose every
// edge was such a call. The message tag is the other half of the
// contract — a `{:update_child_pid, ...}` can only be answered by a
// handle_call that discriminates on `:update_child_pid`. When exactly
// one GenServer module in the program does, the call is attributed to
// it. callback_tag over-approximates (every atom compared in the body),
// which only ever adds handlers, so ambiguity suppresses attribution
// rather than inventing it. The own module's tags are the self-directed
// case in resolved_calls.dl and are excluded here.
.decl unresolved_target(target: symbol)

unresolved_target("dynamic").
unresolved_target(":dynamic").
unresolved_target(t) :- sync_call(_, t), match("via:.*", t).
unresolved_target(t) :- async_cast(_, t), match("via:.*", t).

.decl tag_handler(mod: symbol, kind: symbol, tag: symbol)

tag_handler(mod, "call", tag) :-
  callback_tag(h, "handle_call", tag),
  function_def(h, mod, "handle_call", 3, _),
  behaves_as(mod, "GenServer").

tag_handler(mod, "cast", tag) :-
  callback_tag(h, "handle_cast", tag),
  function_def(h, mod, "handle_cast", 2, _),
  behaves_as(mod, "GenServer").

.decl tag_handler_count(kind: symbol, tag: symbol, n: number)

tag_handler_count(kind, tag, n) :-
  tag_handler(_, kind, tag),
  n = count : { tag_handler(_, kind, tag) }.

// Tags too generic to name a server: every second GenServer answers
// `:get` or `:stop`, and a program that happens to have one such
// handler in the analyzed set says nothing about who a pid is.
.decl generic_tag(tag: symbol)

generic_tag(":get").
generic_tag(":put").
generic_tag(":set").
generic_tag(":stop").
generic_tag(":start").
generic_tag(":ping").
generic_tag(":state").
generic_tag(":status").
generic_tag(":info").
generic_tag(":sync").
generic_tag(":flush").
generic_tag(":reset").
generic_tag(":refresh").
generic_tag(":reload").
generic_tag(":ok").

// A tag some handle_info/2 also matches is a message shape shared by
// more than servers, so a handle_call matching it is weak evidence.
.decl info_tag(tag: symbol)

info_tag(tag) :- callback_tag(_, "handle_info", tag).

// Evidence from the caller's own module: it calls into the handler's
// module statically somewhere (its start_link, its API), which is what a
// module that holds that server's pid in its state looks like. Among
// several handlers of a tag, the one the caller's module refers to wins.
// Read from the staged call graph, not remote_call: the latter is a
// stage-0 ingredient no analysis reads directly.
.decl module_refers(mod: symbol, other: symbol)

module_refers(mod, other) :-
  call_edge(f, g),
  function_def(f, mod, _, _, _),
  function_def(g, other, _, _, _),
  mod != other.

.decl referred_handler(from_mod: symbol, kind: symbol, tag: symbol, mod: symbol)

referred_handler(fm, kind, tag, mod) :-
  tag_handler(mod, kind, tag),
  module_refers(fm, mod).

.decl referred_handler_count(from_mod: symbol, kind: symbol, tag: symbol, n: number)

referred_handler_count(fm, kind, tag, n) :-
  referred_handler(fm, kind, tag, _),
  n = count : { referred_handler(fm, kind, tag, _) }.

// The call at `id` in `func` is attributed to `mod` by its tag — unless
// process points-to resolved that very call: its target is the answer,
// not the tag's guess (the two can disagree), and a hop it proves is not
// an inferred one.
.decl tag_resolved_site(id: symbol, func: symbol, kind: symbol, mod: symbol)

.decl pointsto_resolved(id: symbol, func: symbol, kind: symbol)

pointsto_resolved(id, f, kind) :- call_site_target(id, f, kind, _).

.decl tag_resolved_call(func: symbol, kind: symbol, mod: symbol)

tag_resolved_call(func, kind, mod) :- tag_resolved_site(_, func, kind, mod).

// By evidence: the caller's module refers to exactly one handler of the tag.
tag_resolved_site(id, func, kind, mod) :-
  call_tag(id, func, kind, tag),
  function_def(func, fm, _, _, _),
  referred_handler(fm, kind, tag, mod),
  referred_handler_count(fm, kind, tag, 1),
  fm != mod,
  !pointsto_resolved(id, func, kind).

// By uniqueness: one handler in the whole program, for a tag specific
// enough to name it, and no evidence pointing elsewhere.
tag_resolved_site(id, func, kind, mod) :-
  call_tag(id, func, kind, tag),
  tag_handler(mod, kind, tag),
  tag_handler_count(kind, tag, 1),
  !generic_tag(tag),
  !info_tag(tag),
  function_def(func, fm, _, _, _),
  fm != mod,
  !referred_handler(fm, kind, tag, _),
  !pointsto_resolved(id, func, kind).

// The sync dependencies that exist only by tag attribution, propagated
// backwards like reaches_sync_dep, so a consumer can mark an inferred
// edge for the reader.
.decl tag_dep(func: symbol, mod: symbol)

tag_dep(f, m) :-
  tag_resolved_site(id, f, "call", m),
  sync_call_site(id, f, t, _),
  unresolved_target(t).

.decl reaches_tag_dep(func: symbol, mod: symbol)

reaches_tag_dep(f, m) :- tag_dep(f, m).

reaches_tag_dep(f, m) :-
  call_edge(f, g),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_tag_dep(g, m).

sync_dep(f, m) :-
  tag_resolved_site(id, f, "call", m),
  sync_call_site(id, f, t, _),
  unresolved_target(t).

async_dep(f, m) :-
  tag_resolved_call(f, "cast", m),
  async_cast(f, t),
  unresolved_target(t).

.decl reaches_sync_dep(func: symbol, mod: symbol)

// A wait is the waiting process's: the dependency is not propagated
// over the edge into what a spawn, task or agent runs (runs_elsewhere,
// runs_elsewhere.dl) — init/1 does not wait on what the task it starts
// calls. The closure itself, a function of the same module, still
// holds it, so module-level dependencies are unchanged.
//
// Propagated backwards over call_edge from the functions that hold the
// dependency, never through the full call closure: the result is bounded
// by functions × dependency modules, where call_reachable is quadratic
// in the call graph (17M rows against 100k edges on one corpus project).
// Every transitive relation in this file is derived the same way.
reaches_sync_dep(f, m) :- sync_dep(f, m).

reaches_sync_dep(f, m) :-
  call_edge(f, g),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_sync_dep(g, m).

// ── Which request ──────────────────────────────────────────────────────
//
// The same waits, with the request they make: the tag the message
// carries (call_tag — the atom, or the first element of the tuple), or
// "any" where it carries none the program can see. A chain through a
// server follows the clause the request enters, so a request is what a
// hop is made of; reaches_sync_request(f, m, _) holds exactly where
// reaches_sync_dep(f, m) does.

// The tag of the sync call at `id`, "any" when its message has none.
.decl sent_tag(id: symbol, func: symbol, tag: symbol)

sent_tag(id, f, tag) :- sync_call_site(id, f, _, _), call_tag(id, f, "call", tag).
sent_tag(id, f, "any") :- sync_call_site(id, f, _, _), !call_tag(id, f, "call", _).

// `func` itself waits on `mod` with a request tagged `tag`, at `site`
// ("" when the wait has no site of func's: a literal target handed to a
// wrapper). One clause per sync_dep clause that has a site;
// resolved_calls.dl adds the self-directed one.
.decl sync_request_at(func: symbol, site: symbol, mod: symbol, tag: symbol)

sync_request_at(f, id, m, tag) :-
  sync_call_site(id, f, m, _),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m),
  sent_tag(id, f, tag).

sync_request_at(f, "", m, "any") :-
  sync_call(f, m),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m),
  !sync_call_site(_, f, m, _),
  !named_target_site(f, _, "call", m).

// A literal target handed to a wrapper: at the call into it.
sync_request_at(f, id, m, "any") :-
  named_target_site(f, id, "call", m),
  m != ":dynamic",
  !match("via:.*", m).

sync_request_at(f, anchor, m, tag) :-
  process_call(f, anchor, site, "call", p),
  server_process(p, m),
  sent_tag(site, _, tag).

sync_request_at(f, anchor, m, "any") :-
  process_call(f, anchor, site, "call", p),
  server_process(p, m),
  !sync_call_site(site, _, _, _).

sync_request_at(f, id, m, tag) :-
  tag_resolved_site(id, f, "call", m),
  sync_call_site(id, f, t, _),
  unresolved_target(t),
  call_tag(id, f, "call", tag).

// The requests a server's client API function makes: the tags it sends,
// "any" for a call of its with none or when the call is a callee's.
.decl api_request_tag(func: symbol, tag: symbol)

api_request_tag(g, tag) :- genserver_sync_api(g, _), call_tag(_, g, "call", tag).

api_request_tag(g, "any") :-
  genserver_sync_api(g, _),
  sync_call_site(id, g, _, _),
  !call_tag(id, g, "call", _).

api_request_tag(g, "any") :- genserver_sync_api(g, _), !call_tag(_, g, "call", _).

.decl sync_request_known(func: symbol, mod: symbol, tag: symbol)

sync_request_known(f, m, tag) :- sync_request_at(f, _, m, tag).

sync_request_known(f, m, tag) :-
  call_edge(f, g),
  !side_call(f, g),
  genserver_sync_api(g, m),
  function_def(f, fm, _, _, _),
  fm != m,
  api_request_tag(g, tag).

.decl sync_request_seen(func: symbol, mod: symbol)

sync_request_seen(f, m) :- sync_request_known(f, m, _).

// Every sync_dep has a request: "any" for one no clause above names, so
// a dependency this file learns to make later is never lost here.
.decl sync_request(func: symbol, mod: symbol, tag: symbol)

sync_request(f, m, tag) :- sync_request_known(f, m, tag).
sync_request(f, m, "any") :- sync_dep(f, m), !sync_request_seen(f, m).

.decl reaches_sync_request(func: symbol, mod: symbol, tag: symbol)

reaches_sync_request(f, m, tag) :- sync_request(f, m, tag).

reaches_sync_request(f, m, tag) :-
  call_edge(f, g),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_sync_request(g, m, tag).

// ── Which request, per call site ──────────────────────────────────────
//
// site_request(f, site, m, tag): the call at `site` in `f` leads to a
// wait on m's process with a request tagged `tag` ("" for a hop with no
// call instruction of f's: a closure, a fun handed on, a literal target
// given to a wrapper). Asked of the functions a consumer seeds
// site_demand with, and of every callee they enter with a literal first
// argument: `Router.route(:local, n)` enters only route/2's :local clause
// (clause_call), so what the :remote clause waits on is not the caller's
// wait — the guarded dispatcher a call graph by function merges into
// one. A callee entered any other way is taken whole, as
// reaches_sync_request takes it.
.decl site_demand(func: symbol)

// Every call `f` makes to `g` passes the literal atom `value` first (one
// row per atom when the calls differ): the call enters only g's clauses
// for that atom and the clauses that take any value (clause_call says
// which clause a site belongs to). An argument forwarded from f's own
// parameters, a computed value or a tuple enters every clause. The one
// test the clause-aware walks share: site_request below and
// global_reach.dl's global_path. Not narrowed to a demand: a walk that
// negates it cannot depend on the walk.
.decl literal_first(func: symbol, callee: symbol, value: symbol)

literal_first(f, g, a) :-
  call_arg(f, g, 0, a),
  match(":.*", a),
  !call_arg(f, g, 0, "dynamic"),
  !call_arg_forward(f, g, 0, _).

// literal_first, for the functions site_request is asked of.
.decl literal_entry(func: symbol, callee: symbol, value: symbol)

literal_entry(f, g, a) :- site_demand(f), literal_first(f, g, a).

site_demand(g) :- site_demand(f), call_instr(f, g, _), literal_entry(f, g, _).

.decl site_request(func: symbol, site: symbol, mod: symbol, tag: symbol)

site_request(f, id, m, tag) :- site_demand(f), sync_request_at(f, id, m, tag).

site_request(f, id, m, tag) :-
  site_demand(f),
  call_instr(f, g, id),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  !literal_entry(f, g, _),
  reaches_sync_request(g, m, tag).

site_request(f, id, m, tag) :-
  site_demand(f),
  call_instr(f, g, id),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  literal_entry(f, g, a),
  site_request(g, s, m, tag),
  site_clause(g, s, c),
  (c = a ; c = "any").

site_request(f, id, m, tag) :-
  site_demand(f),
  call_instr(f, g, id),
  !side_call(f, g),
  genserver_sync_api(g, m),
  function_def(f, fm, _, _, _),
  fm != m,
  api_request_tag(g, tag).

// A closure or fun reference f hands to a call runs inside that call
// (fun_handed): the edge into it has no call instruction of its own, and
// the call it is handed to is its site. exq's Manager.Server waits on
// its Stats server inside `Redis.rescue_timeout(fn -> ... end)`, brod's
// group subscriber inside `lists:foreach(fun(T) -> ... end, Ts)`. An edge
// with neither (a fun built into a term and called later) has no site.
site_request(f, id, m, tag) :-
  site_demand(f),
  call_edge(f, g),
  !call_instr(f, g, _),
  fun_handed(id, f, g, _),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_sync_request(g, m, tag).

site_request(f, "", m, tag) :-
  site_demand(f),
  call_edge(f, g),
  !call_instr(f, g, _),
  !fun_handed(_, f, g, _),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_sync_request(g, m, tag).

site_request(f, "", m, tag) :-
  site_demand(f),
  call_edge(f, g),
  !call_instr(f, g, _),
  !side_call(f, g),
  genserver_sync_api(g, m),
  function_def(f, fm, _, _, _),
  fm != m,
  api_request_tag(g, tag).

// The first-argument tag the clause holding `site` serves: clause_call's,
// or "any" for a call every clause shares, or a hop with no site.
.decl site_clause(func: symbol, site: symbol, tag: symbol)

site_clause(f, id, tag) :- site_request(f, id, _, _), clause_call(id, f, tag).
site_clause(f, id, "any") :- site_request(f, id, _, _), !clause_call(id, f, _).

// The one-way counterpart of reaches_sync_dep, over the same edges: a
// cast is the casting process's, so the dependency is not propagated
// over the edge into what a spawn, task or agent runs (runs_elsewhere) —
// a cast a task init/1 starts makes is the task's, made whenever the
// task gets to it, not while init/1 runs — nor over a side path.
.decl reaches_async_dep(func: symbol, mod: symbol)

reaches_async_dep(f, m) :- async_dep(f, m).

reaches_async_dep(f, m) :-
  call_edge(f, g),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_async_dep(g, m).

// With the timeout the waiting call carries: -1 is :infinity, 0 unknown.
// Through a client API function the timeout is the wrapper's, whose own
// target is usually the pid it was handed ("dynamic" below); where
// points-to resolves that pid, the process_call clause gives the same
// call's timeout against the server it reaches.
.decl sync_dep_timeout(func: symbol, mod: symbol, timeout_ms: number)

sync_dep_timeout(f, m, ms) :-
  sync_call_timeout(f, m, ms),
  m != "dynamic",
  m != ":dynamic",
  !match("via:.*", m).

// The timeout of the very call the tag attributes, not of any unresolved
// call in the same function.
sync_dep_timeout(f, m, ms) :-
  tag_resolved_site(id, f, "call", m),
  sync_call_site(id, f, t, ms),
  unresolved_target(t).

// A call process points-to resolves, with its own timeout: the helper's
// call when f hands the pid to one.
sync_dep_timeout(f, m, ms) :-
  process_call(f, _, site, "call", p),
  server_process(p, m),
  sync_call_site(site, _, _, ms).

sync_dep_timeout(f, m, ms) :-
  call_edge(f, g),
  !side_call(f, g),
  genserver_sync_api(g, m),
  sync_call_timeout(g, callee, ms),
  (callee = m ; callee = "dynamic"),
  function_def(f, fm, _, _, _),
  fm != m.

.decl reaches_sync_dep_timeout(func: symbol, mod: symbol, timeout_ms: number)

reaches_sync_dep_timeout(f, m, ms) :- sync_dep_timeout(f, m, ms).

reaches_sync_dep_timeout(f, m, ms) :-
  call_edge(f, g),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  reaches_sync_dep_timeout(g, m, ms).

// ── A process of one's own ─────────────────────────────────────────────
//
// `func` depends on `mod` only through processes it keeps for itself:
// every call or cast of func's that process points-to follows to a
// process of mod's goes to a private instance (private_process — a
// `{:ok, conn} = Conn.start_link()` kept in the state), none to one a
// supervisor starts or a name shares, and func names no process of mod
// literally. The rules about siblings ask this: a supervisor restarting
// its Conn child does not touch the Conn a sibling started for itself.
.decl private_dep(func: symbol, mod: symbol)

private_dep(f, m) :-
  call_target(f, kind, p),
  (kind = "call" ; kind = "cast"),
  server_process(p, m),
  private_process(p, _, _),
  !shared_dep(f, m).

.decl shared_dep(func: symbol, mod: symbol)

shared_dep(f, m) :-
  call_target(f, kind, p),
  (kind = "call" ; kind = "cast"),
  server_process(p, m),
  !private_process(p, _, _).

shared_dep(f, m) :- sync_call(f, m).
shared_dep(f, m) :- async_cast(f, m).

// A module that depends on `mod` through private instances alone: some
// function of it does, and none does otherwise.
.decl private_module_dep(from_mod: symbol, to_mod: symbol)

private_module_dep(a, b) :-
  private_dep(f, b),
  function_def(f, a, _, _, _),
  !shared_module_dep(a, b).

.decl shared_module_dep(from_mod: symbol, to_mod: symbol)

shared_module_dep(a, b) :- shared_dep(f, b), function_def(f, a, _, _, _).

// ── Module-level dependency ────────────────────────────────────────────
//
// A function defined in `from_mod` transitively reaches a function
// defined in `to_mod`; `witness` is the reaching function.
.decl module_reaches(from_mod: symbol, to_mod: symbol, witness: symbol)

// `func` reaches (through at least one call) some function of `mod`.
.decl reaches_module(func: symbol, mod: symbol)

// Asked only of a module some supervisor starts (coupling's siblings,
// the one consumer of stateful_module_dep), so only those are targets.
.decl module_dep_target(mod: symbol)

module_dep_target(m) :- child_subtree(_, _, m).

reaches_module(f, m) :-
  call_edge(f, g),
  function_def(g, m, _, _, _),
  module_dep_target(m).

reaches_module(f, m) :-
  call_edge(f, g),
  reaches_module(g, m).

module_reaches(from_mod, to_mod, caller) :-
  function_def(caller, from_mod, _, _, _),
  reaches_module(caller, to_mod),
  from_mod != to_mod.

// `func` reaches (through at least one call) a function of `mod` that
// makes a sync call.
.decl reaches_sync_caller_in(func: symbol, mod: symbol)

reaches_sync_caller_in(f, m) :-
  call_edge(f, g),
  function_def(g, m, _, _, _),
  sync_call(g, _),
  !calls_other_server(g, m).

reaches_sync_caller_in(f, m) :-
  call_edge(f, g),
  reaches_sync_caller_in(g, m).

// from_mod holds process state that depends on to_mod's process — a
// sync or async dependency, resolved or through the callee module's own
// unresolved client calls (a facade like Oban.Notifier delegating by
// dynamic dispatch has no resolved target, but the module as a whole
// manages process state). `witness` is a function in from_mod the
// dependency flows through; finding builders dedupe on the module pair.
// A function of from_mod waits on to_mod's process, somewhere below it.
.decl module_sync_dep(from_mod: symbol, to_mod: symbol, witness: symbol)

module_sync_dep(from_mod, to_mod, f) :-
  function_def(f, from_mod, _, _, _),
  reaches_sync_dep(f, to_mod),
  from_mod != to_mod.

.decl stateful_module_dep(from_mod: symbol, to_mod: symbol, witness: symbol)

stateful_module_dep(from_mod, to_mod, f) :- module_sync_dep(from_mod, to_mod, f).

stateful_module_dep(from_mod, to_mod, f) :-
  function_def(f, from_mod, _, _, _),
  reaches_async_dep(f, to_mod),
  from_mod != to_mod.

stateful_module_dep(from_mod, to_mod, w) :-
  module_reaches(from_mod, to_mod, w),
  module_client_call(to_mod).

// Some function of `mod` makes a call or cast.
.decl module_client_call(mod: symbol)

module_client_call(m) :- function_def(h, m, _, _, _), sync_call(h, _).
module_client_call(m) :- function_def(h, m, _, _, _), async_cast(h, _).

// The strongest mechanism the dependency is provable through: "call"
// when any path waits on a reply, "cast" when every path is one-way. A
// cast-only coupling cannot hold a stale reply, pid or monitor.
.decl stateful_module_dep_call(from_mod: symbol, to_mod: symbol)

stateful_module_dep_call(from_mod, to_mod) :-
  stateful_module_dep(from_mod, to_mod, f),
  reaches_sync_dep(f, to_mod).

stateful_module_dep_call(from_mod, to_mod) :-
  stateful_module_dep(from_mod, to_mod, f),
  reaches_sync_caller_in(f, to_mod).

.decl stateful_module_dep_kind(from_mod: symbol, to_mod: symbol, kind: symbol)

stateful_module_dep_kind(from_mod, to_mod, "call") :-
  stateful_module_dep_call(from_mod, to_mod).

stateful_module_dep_kind(from_mod, to_mod, "cast") :-
  stateful_module_dep(from_mod, to_mod, _),
  !stateful_module_dep_call(from_mod, to_mod).
