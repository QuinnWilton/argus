// The words the findings' top-level rules are written in.
//
// A finding rule should read aloud as the sentence it checks:
//
//   rpc_without_timeout(func, call, variant) :-
//     makes_rpc(func, call, variant),
//     no_timeout(call),
//     !during_init(call).
//
// The output relation's shape — the kind constants, the columns other
// kinds fill — goes in a one-line rule of its own that reads the
// sentence (`unbounded_wait(func, call, "rpc", variant, "", "") :-
// rpc_without_timeout(func, call, variant).`), so the sentence carries
// only the words it is about.
//
// These are the terms more than one analysis says: a function's module,
// the callbacks a process runs at its edges, a lock that retries, a
// public table. Each is inlined — Souffle substitutes the body where the
// word is used — so naming a concept costs no relation of its own. What
// only one analysis says lives in that analysis's file, next to the rule
// that reads it.
//
// Included after otp.dl, whose callbacks these name.

// A function and the module it is defined in.
.decl in_module(func: symbol, mod: symbol) inline

in_module(f, m) :- function_def(f, m, _, _, _).

// init/1 of a behaviour module: the callback its supervisor waits on.
.decl is_init(func: symbol) inline

is_init(f) :- init_function(_, f).

// terminate/2 of a module whose behaviour runs one.
.decl is_terminate(func: symbol, mod: symbol) inline

is_terminate(f, m) :- terminate_callback(f, m, _).

// A :global lock or transaction that retries when the lock is held:
// `retries` is :infinity or a positive count (retried with backoff, then
// false); "0" tries once and returns, and "dynamic" is a count the
// bytecode does not show. `nodes` says whose agreement it waits on:
// "cluster" (every connected node — the list holds them, or was left
// out), "local" (only this node's global server, `[node()]`) or
// "unknown" (a list the bytecode does not show).
.decl retrying_lock(site: symbol, func: symbol, op: symbol, retries: symbol, nodes: symbol) inline

retrying_lock(site, f, op, retries, nodes) :-
  global_op(site, f, op, retries, nodes),
  retries != "0",
  retries != "dynamic".

// A :global lock that retries until it is granted: `retries` is
// :infinity, or a count the bytecode does not show ("dynamic"), assumed
// :infinity — the default a wrapper forwards (Nebulex's transaction/3
// takes `Keyword.get(opts, :retries, :infinity)`) — as a node list it
// does not show is assumed to be the cluster.
.decl lock_until_granted(site: symbol, func: symbol, op: symbol, retries: symbol, nodes: symbol) inline

lock_until_granted(site, f, op, retries, nodes) :-
  global_op(site, f, op, retries, nodes),
  (retries = "infinity" ; retries = "dynamic").

// A :global lock that gives up: a positive retry count. OTP's set_lock
// sleeps up to 1/4 s before the first retry, doubling to at most 8 s,
// and returns false once the retries are spent.
.decl bounded_lock(site: symbol, func: symbol, op: symbol, retries: symbol, nodes: symbol) inline

bounded_lock(site, f, op, retries, nodes) :-
  retrying_lock(site, f, op, retries, nodes),
  retries != "infinity".

// An ETS table created :public under a name: any process can write it.
.decl public_table(name: symbol) inline

public_table(name) :-
  ets_new(id, _, name),
  ets_option(id, "access", "public").
