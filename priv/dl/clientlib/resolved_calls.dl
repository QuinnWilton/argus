// Infer unresolved same-module server targets from client-wrapper message tags. A
// wrapper sending a tag handled by its own module is attributed there; proxies sending
// only another server's tags are not. This supplements literal sync_call targets.
// Requires imports.dl and staged call_tag facts.

// The wrapper's own module handles the tag it sends, so the target is that
// module.
.decl self_directed_call(caller: symbol, callee_mod: symbol)

self_directed_call(caller, mod) :-
  call_tag(_, caller, "call", tag),
  function_def(caller, mod, _, _, _),
  handle_call_function(mod, handler),
  callback_tag(handler, "handle_call", tag).

// A self-directed call is a sync dependency on the caller's own module.
sync_dep(caller, mod) :- self_directed_call(caller, mod).

// The request it makes is the tag its own handler answers.
sync_request_at(caller, id, mod, tag) :-
  call_tag(id, caller, "call", tag),
  function_def(caller, mod, _, _, _),
  handle_call_function(mod, handler),
  callback_tag(handler, "handle_call", tag).
