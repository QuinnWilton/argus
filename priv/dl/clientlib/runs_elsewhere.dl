// Execution edges leaving the caller's stack: spawned/task/agent bodies and funs stored
// or registered for later. SameProcess walks stop at these edges. Derived from starts
// and the call graph independently of points-to. Requires imports.dl.
// Known limit: a fun embedded in a term may run synchronously, but fun_handed cannot
// follow it through that term and treats it as stored.

// Classify fun execution as detached or deferred unless func also calls the target
// directly. Follow helpers receiving a fun and starting a process with it. A sole
// unassigned closure may stand for an unresolved process-start argument; a closure
// explicitly passed to another call does not.
// Registrar-only or unpassed funs count as deferred. async_stream funs and unknown
// higher-order consumers remain on the caller's wait path. Use compiler closure names
// without requiring closure_def.
// `starts_a_process` identifies non-server starts that run the supplied function.
.decl starts_a_process(call: symbol)

starts_a_process(call) :- process_start(call, _, _, kind, _), kind != "server".

.decl runs_elsewhere(func: symbol, callee: symbol)

runs_elsewhere(f, g) :-
  process_start(_, f, _, kind, g),
  kind != "server",
  !call_instr(f, g, _),
  !calls_fun(f).

// A function may both start a fun elsewhere and invoke it inline. Preserve
// compiler-resolved direct calls to the closure as same-stack edges.
.decl calls_fun(func: symbol)

calls_fun(f) :- dynamic_call(_, f, "call_fun").

// Handed to a helper that starts a process on the fun it is handed, and
// to no call that may run it here.
runs_elsewhere(f, g) :-
  fun_handed_to(f, g, h),
  fun_sink(h, "start"),
  !runs_handed(f, g),
  !call_instr(f, g, _).

// The only closure func builds into a term, beside a start whose fun is
// not known.
runs_elsewhere(f, g) :-
  hands_funs_off(f),
  held_closure(f, g),
  held_closures(f, 1),
  !call_instr(f, g, _).

// A retained function is not run here if no consumer may invoke it inline. Functions
// handed to process starts are already handled above.
runs_elsewhere(f, g) :-
  fun_edge(f, g),
  !runs_handed(f, g),
  !call_instr(f, g, _),
  !calls_fun(f).

// A closure func builds, or a fun it hands on (fun_ref).
.decl fun_edge(func: symbol, fun: symbol)

fun_edge(f, g) :- call_edge(f, g), match(".*:-.*-fun-[0-9]+-/[0-9]+", g).
fun_edge(f, g) :- fun_ref(f, g).

// Known fun consumers either start a process ("start") or register the fun for later
// execution elsewhere ("keep"). Unknown consumers may invoke it on the caller's stack.
.decl fun_sink(callee: symbol, how: symbol)

fun_sink(h, "start") :- process_start(_, h, _, kind, "dynamic"), kind != "server".
fun_sink(":telemetry:attach/4", "keep").
fun_sink(":telemetry:attach_many/4", "keep").
fun_sink(":persistent_term:put/2", "keep").
fun_sink("Process:put/2", "keep").
fun_sink(":erlang:put/2", "keep").
fun_sink("Application:put_env/3", "keep").
fun_sink("Application:put_env/4", "keep").
fun_sink(":application:set_env/3", "keep").
fun_sink(":application:set_env/4", "keep").

// func hands g to a call that may run it on func's stack.
.decl runs_handed(func: symbol, fun: symbol)

runs_handed(f, g) :- fun_handed_to(f, g, h), !fun_sink(h, _).

// A closure func builds and hands to no call: into a term.
.decl held_closure(func: symbol, closure: symbol)

held_closure(f, g) :-
  hands_funs_off(f),
  call_edge(f, g),
  match(".*:-.*-fun-[0-9]+-/[0-9]+", g),
  !fun_handed_to(f, g, _).

.decl held_closures(func: symbol, n: number)

held_closures(f, n) :-
  held_closure(f, _),
  n = count : { held_closure(f, _) }.

.decl hands_funs_off(func: symbol)

hands_funs_off(f) :- process_start(_, f, _, kind, "dynamic"), kind != "server".

// A child spec built around a fun (`start: {Task, :start_link, [fn ->
// ... end]}`) runs it in the child.
hands_funs_off(f) :-
  call_site(_, f, m, "start_child", _),
  (m = "Supervisor" ; m = "DynamicSupervisor").

// Awaited task work still runs in another process, but holds the caller. Wait analyses
// may cross this boundary. `start` is the async site. Collection is function-level: any
// await, yield, or await_many is taken to collect the task.
.decl awaits_task(func: symbol, start: symbol, runs: symbol)

awaits_task(f, id, g) :-
  process_start(id, f, _, "spawn", g),
  call_site(id, f, m, a, _),
  task_start_api(m, a, _),
  call_site(_, f, "Task", w, _),
  task_wait(w).

// Reply-producing task APIs send `{ref, result}` and :DOWN. Linked variants can also
// crash the caller or deliver :EXIT when it traps. Unlinked variants leave replies and
// monitors to the caller. Fire-and-forget start APIs are excluded.
.decl task_start_api(mod: symbol, func: symbol, link: symbol)

task_start_api("Task", "async", "linked").
task_start_api("Task.Supervisor", "async", "linked").
task_start_api("Task.Supervisor", "async_nolink", "unlinked").

// Task.Supervisor operations start one task per call ("one") or a bounded stream
// ("stream"). Each stream enumerator runs at most max_concurrency tasks at once and
// waits for each result.
.decl task_supervisor_op(op: symbol, how: symbol)

task_supervisor_op("start_child", "one").
task_supervisor_op("async", "one").
task_supervisor_op("async_nolink", "one").
task_supervisor_op("async_stream", "stream").
task_supervisor_op("async_stream_nolink", "stream").

// Task waits block until the task returns or the wait expires. Exclude Task.shutdown,
// which stops the task.
.decl task_wait(func: symbol)

task_wait("await").
task_wait("await_many").
task_wait("yield").
task_wait("yield_many").

// Task reply consumers include waits and Task.shutdown. Shutdown also flushes the
// stopped task's reply or DOWN.
.decl task_collect(func: symbol)

task_collect(w) :- task_wait(w).
task_collect("shutdown").
