// Return shapes claimed by specs. Prefer analyzed modules' own specs over installed
// code-path copies; use code-path specs for external functions. These unverified claims
// may suppress or confirm findings, never create them alone. No row means unknown, not
// unable to fail. Requires imports.dl.

.decl callee_returns(func: symbol, shape: symbol)

callee_returns(f, shape) :- spec_return(f, shape, "analyzed").

callee_returns(f, shape) :-
  spec_return(f, shape, "installed"),
  !function_def(f, _, _, _, _).
