// The selective points-to fallback. When the full stage exceeds its budget,
// points_to_selective.dl enables this field-insensitive pass. Context-insensitive
// parameters can otherwise merge large heaps.
// Only in selective mode, classify an object as a hub when more than 1% of the
// program's variables, and more than 1,000 of them, hold it. Resolve hub objects
// field-insensitively and the rest field-sensitively, using field-insensitive targets
// for messages and replies involving hub processes. Field-insensitive rows
// over-approximate the full stage's.
// The full stage's budget, not an object's spread, triggers the fallback. In full mode
// these rules produce no rows; in field-insensitive mode (points_to_field_insensitive.dl),
// which runs when even the selective stage exceeds its budget, every object is a hub.
// Included by points_to.dl after processes.dl.

.decl stage_mode(mode: symbol)

// Where an object sits in a variable's value: Top is the value itself, Under is one
// field, Below is deeper under that field, and Deep has an unknown path. Fields retain
// term shape, but individual terms are merged per variable. Stores move objects down;
// loads move them up or retain Deep. Uses accept Top or Deep.
.type ShapedField = (field: symbol, kind: symbol, tag: symbol, arity: symbol)
.type Reach = (tag: symbol, at: ShapedField)

.decl object(object: symbol)

object(p) :- stage_mode("selective"), process(p).
object(t) :- stage_mode("selective"), table_allocation(_, _, t).

.decl field_insensitive_points_to(func: symbol, var_kind: symbol, var: symbol, reach: Reach, object: symbol)
.decl field_insensitive_entry(func: symbol, pos: symbol, reach: Reach, object: symbol)
.decl field_insensitive_return(func: symbol, reach: Reach, object: symbol)
.decl field_insensitive_return_all(func: symbol, reach: Reach, object: symbol)
.decl field_insensitive_named_pid(name: symbol, process: symbol)
.decl field_insensitive_call_site_target(id: symbol, func: symbol, api_kind: symbol, process: symbol)

.decl field_insensitive_term_shape(term: symbol, kind: symbol, tag: symbol, arity: symbol)

field_insensitive_term_shape(o, kind, tag, ar) :- stage_mode("selective"), term_allocation(_, o, kind, tag, ar).

.decl reach_top(reach: Reach)
.decl reach_top_tag(tag: symbol)

reach_top_tag("top").
reach_top_tag("deep").

reach_top(r) :- reach_top_tag(t), r = (t, ("", "", "", "")).

field_insensitive_points_to(f, "process", p, ("top", ("", "", "", "")), p) :- stage_mode("selective"), process_start(_, f, p, _, _).
field_insensitive_points_to(f, "self", "self", ("top", ("", "", "", "")), p) :- stage_mode("selective"), self_pid(f, p).
field_insensitive_points_to(f, "table", t, ("top", ("", "", "", "")), t) :- stage_mode("selective"), table_allocation(_, f, t).
field_insensitive_points_to(f, "name", n, ("top", ("", "", "", "")), p) :- reads_name(f, n), field_insensitive_named_pid(n, p).
field_insensitive_points_to(f, "dictionary", k, r, x) :- dictionary_read(f, k, g, sk, s), field_insensitive_points_to(g, sk, s, r, x).

// A store: one field further down.
field_insensitive_points_to(f, "term", o, ("under", (sel, kind, tag, ar)), x) :-
  field_store(f, o, sel, sk, s),
  field_insensitive_points_to(f, sk, s, r, x),
  r = ("top", ("", "", "", "")),
  field_insensitive_term_shape(o, kind, tag, ar).

field_insensitive_points_to(f, "term", o, ("below", (sel, kind, tag, ar)), x) :-
  field_store(f, o, sel, sk, s),
  field_insensitive_points_to(f, sk, s, r, x),
  r != ("top", ("", "", "", "")),
  field_insensitive_term_shape(o, kind, tag, ar).

// The field an object sits under or below, with the tag and field as columns of their
// own: a negation reads columns, not a value taken apart from a tuple. Only for the
// variables an update copies (field_insensitive_update_base): over every variable it
// would copy all of field_insensitive_points_to, on Ash's deps 3.3 million rows of
// which the updates read a fraction.
.decl field_insensitive_field(func: symbol, var_kind: symbol, var: symbol, tag: symbol, field: symbol, object: symbol)

field_insensitive_field(f, sk, s, t, sel, x) :- field_insensitive_update_base(f, sk, s), field_insensitive_points_to(f, sk, s, r, x), r = (t, at), at = (sel, _, _, _).

.decl field_insensitive_update_base(func: symbol, var_kind: symbol, var: symbol)

field_insensitive_update_base(f, sk, s) :- stage_mode("selective"), term_update_base(f, _, sk, s).

// An update keeps the fields it does not set, as fields of its own shape.
field_insensitive_points_to(f, "term", o, ("under", (sel, kind, tag, ar)), x) :-
  term_update_base(f, o, bk, bs),
  field_insensitive_field(f, bk, bs, "under", sel, x),
  !term_update_overwrites(o, sel),
  field_insensitive_term_shape(o, kind, tag, ar).

field_insensitive_points_to(f, "term", o, ("below", (sel, kind, tag, ar)), x) :-
  term_update_base(f, o, bk, bs),
  field_insensitive_field(f, bk, bs, "below", sel, x),
  !term_update_overwrites(o, sel),
  field_insensitive_term_shape(o, kind, tag, ar).

field_insensitive_points_to(f, "term", o, ("deep", ("", "", "", "")), x) :- term_update_base(f, o, bk, bs), field_insensitive_points_to(f, bk, bs, reach_1, x),
  reach_1 = ("deep", ("", "", "", "")).

// A load: the field, or a map's field under a key not known.
field_insensitive_points_to(f, "load", l, ("top", ("", "", "", "")), x) :-
  field_load(f, l, sel, bk, bs),
  field_insensitive_points_to(f, bk, bs, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (sel, _, _, _),
  reach_1_tag = "under".

field_insensitive_points_to(f, "load", l, ("top", ("", "", "", "")), x) :-
  field_load(f, l, _, bk, bs),
  field_insensitive_points_to(f, bk, bs, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (reach_1_at_sel, reach_1_at_kind, _, _),
  reach_1_tag = "under",
  reach_1_at_sel = "*",
  reach_1_at_kind = "map".

field_insensitive_points_to(f, "load", l, ("deep", ("", "", "", "")), x) :-
  field_load(f, l, sel, bk, bs),
  field_insensitive_points_to(f, bk, bs, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (sel, _, _, _),
  reach_1_tag = "below".

field_insensitive_points_to(f, "load", l, ("deep", ("", "", "", "")), x) :-
  field_load(f, l, _, bk, bs),
  field_insensitive_points_to(f, bk, bs, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (reach_1_at_sel, reach_1_at_kind, _, _),
  reach_1_tag = "below",
  reach_1_at_sel = "*",
  reach_1_at_kind = "map".

field_insensitive_points_to(f, "load", l, ("deep", ("", "", "", "")), x) :- field_load(f, l, _, bk, bs), field_insensitive_points_to(f, bk, bs, reach_1, x),
  reach_1 = ("deep", ("", "", "", "")).

// An element read of a map is a pair of it (`pair <map>`, processes.dl): an
// object under or below one of the map's fields is under or below the pair's
// value, one under a key not a literal (`@key`) under its key.
field_insensitive_points_to(f, "load", l, (reach_1_tag, (pair_sel, "tuple", "@pair", "2")), x) :-
  field_load(f, l, "[]", bk, bs),
  field_insensitive_points_to(f, bk, bs, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (reach_1_at_sel, reach_1_at_kind, _, _),
  (reach_1_tag = "under" ; reach_1_tag = "below"),
  reach_1_at_kind = "map",
  reach_1_at_sel != "@key",
  pair_sel = "{1}".

field_insensitive_points_to(f, "load", l, (reach_1_tag, (pair_sel, "tuple", "@pair", "2")), x) :-
  field_load(f, l, "[]", bk, bs),
  field_insensitive_points_to(f, bk, bs, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (reach_1_at_sel, reach_1_at_kind, _, _),
  (reach_1_tag = "under" ; reach_1_tag = "below"),
  reach_1_at_kind = "map",
  reach_1_at_sel = "@key",
  pair_sel = "{0}".

// Separate call parameters from entry arguments and fresh returns. Forwarded parameters
// retain each call's argument. Factory values are renamed through direct or forwarded
// factory returns, conservatively covering the full stage's results.
field_insensitive_points_to(g, "param", k, r, x) :- field_insensitive_entry(g, k, r, x).
field_insensitive_points_to(g, "param", k, r, x) :- call_arg_var(_, f, g, k, "call", sk, s), field_insensitive_points_to(f, sk, s, r, x).
field_insensitive_entry(g, k, r, x) :- call_arg_var(_, f, g, k, via, sk, s), via != "call", field_insensitive_points_to(f, sk, s, r, x).

.decl field_insensitive_fresh(func: symbol, reach: Reach, object: symbol)
.decl fresh_route(func: symbol, var_kind: symbol, var: symbol)

fresh_route(g, "term", t) :- stage_mode("selective"), return_var(g, "term", t), start_term(t, _).
fresh_route(g, "process", b) :- stage_mode("selective"), return_var(g, "process", b), process_start(_, g, b, _, _).

field_insensitive_fresh(g, r, x) :- fresh_route(g, k, s), field_insensitive_points_to(g, k, s, r, x).
field_insensitive_fresh(g, r, x) :- return_var(g, "result", c), call_result_var(c, g, h), field_insensitive_fresh(h, r, x).

field_insensitive_return(g, r, x) :-
  return_var(g, k, s),
  k != "param",
  k != "result",
  k != "dictionary",
  !fresh_route(g, k, s),
  field_insensitive_points_to(g, k, s, r, x).

field_insensitive_return(g, r, x) :- return_var(g, "result", c), call_result_var(c, g, h), field_insensitive_return(h, r, x).

field_insensitive_return(g, r, x) :-
  return_var(g, "result", c),
  call_result_var(c, g, h),
  passes(h, i),
  call_arg_var(c, g, h, i, "call", sk, s),
  sk != "param",
  field_insensitive_points_to(g, sk, s, r, x).

field_insensitive_points_to(f, "result", c, r, x) :- call_result_var(c, f, g), field_insensitive_return(g, r, x).
field_insensitive_points_to(f, "result", c, r, x) :- call_result_var(c, f, g), returns_key(g, k), field_insensitive_points_to(f, "dictionary", k, r, x).
field_insensitive_points_to(f, "result", c, r, x) :- call_result_var(c, f, g), return_var(f, "result", c), field_insensitive_fresh(g, r, x).

field_insensitive_points_to(f, "result", c, r, x) :-
  call_result_var(c, f, g),
  passes(g, j),
  call_arg_var(c, f, g, j, "call", sk, s),
  field_insensitive_points_to(f, sk, s, r, x).

field_insensitive_points_to(f, "result", c, ("top", ("", "", "", "")), cat("start ", c)) :-
  stage_mode("selective"),
  kept_fresh(c, f, x),
  process_start(_, _, x, _, _).

field_insensitive_points_to(f, "result", c, ("under", ("{1}", "", "", "")), cat("start ", c)) :-
  stage_mode("selective"),
  kept_fresh(c, f, x),
  start_term(x, _).

field_insensitive_return_all(g, r, x) :- field_insensitive_returns_read(g), field_insensitive_return(g, r, x).
field_insensitive_return_all(g, r, x) :- field_insensitive_returns_read(g), field_insensitive_fresh(g, r, x).
field_insensitive_return_all(g, r, x) :- field_insensitive_returns_read(g), passes(g, j), field_insensitive_points_to(g, "param", j, r, x).
field_insensitive_return_all(g, r, x) :- field_insensitive_returns_read(g), returns_key(g, k), field_insensitive_points_to(g, "dictionary", k, r, x).

// The functions whose every return a rule reads: a server's state (field_insensitive_state_slot) and a
// call's reply. The rest of the program's returns are half a million rows on Ash's
// deps that nothing reads.
.decl field_insensitive_returns_read(func: symbol)

field_insensitive_returns_read(g) :- stage_mode("selective"), state_out(_, g).
field_insensitive_returns_read(g) :- stage_mode("selective"), statem_data_out(_, g).
field_insensitive_returns_read(h) :- stage_mode("selective"), function_def(h, _, "handle_call", 3, _).

// Resolve a state slot to its returned tuple field: Top for an object directly in the
// field, Deep for deeper or unknown contents.
.decl field_insensitive_state_slot(func: symbol, tag: symbol, arity: symbol, field: symbol, reach: Reach, object: symbol)
.decl field_insensitive_state_slot_wanted(tag: symbol, arity: symbol, field: symbol)

field_insensitive_state_slot_wanted(tag, n, sel) :- stage_mode("selective"), state_slot(tag, n, sel).
field_insensitive_state_slot_wanted(tag, n, sel) :- stage_mode("selective"), statem_data_slot(tag, n, sel).

field_insensitive_state_slot(g, tag, n, sel, ("top", ("", "", "", "")), x) :- field_insensitive_return_all(g, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (sel, reach_1_at_kind, tag, n),
  reach_1_tag = "under",
  reach_1_at_kind = "tuple".
field_insensitive_state_slot(g, tag, n, sel, ("deep", ("", "", "", "")), x) :- field_insensitive_return_all(g, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (sel, reach_1_at_kind, tag, n),
  reach_1_tag = "below",
  reach_1_at_kind = "tuple".
field_insensitive_state_slot(g, tag, n, sel, ("deep", ("", "", "", "")), x) :- field_insensitive_state_slot_wanted(tag, n, sel), field_insensitive_return_all(g, reach_1, x),
  reach_1 = ("deep", ("", "", "", "")).

field_insensitive_entry(f, k, r, x) :-
  state_in(m, f, k),
  state_out(m, g),
  state_slot(tag, n, sel),
  field_insensitive_state_slot(g, tag, n, sel, r, x).

field_insensitive_entry(f, k, r, x) :-
  statem_data_in(m, f, k),
  statem_data_out(m, g),
  statem_data_slot(tag, n, sel),
  field_insensitive_state_slot(g, tag, n, sel, r, x).

field_insensitive_entry(h, "0", r, x) :-
  process_message_var(id, f, kind, sk, s),
  field_insensitive_points_to(f, sk, s, r, x),
  field_insensitive_call_site_target(id, f, kind, p),
  server_process(p, m),
  message_handler(kind, name, arity),
  function_def(h, m, name, arity, _).

field_insensitive_entry(h, "1", r, x) :-
  process_message_var(id, f, kind, sk, s),
  field_insensitive_points_to(f, sk, s, r, x),
  field_insensitive_call_site_target(id, f, kind, p),
  server_process(p, m),
  statem_event_clause(m, h, _).

field_insensitive_points_to(f, "reply", id, ("top", ("", "", "", "")), x) :-
  field_insensitive_call_site_target(id, f, "call", p),
  server_process(p, m),
  function_def(h, m, "handle_call", 3, _),
  field_insensitive_return_all(h, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (reach_1_at_sel, reach_1_at_kind, reach_1_at_tag, _),
  reach_1_tag = "under",
  reach_1_at_sel = "{1}",
  reach_1_at_kind = "tuple",
  reach_1_at_tag = ":reply".

field_insensitive_points_to(f, "reply", id, ("deep", ("", "", "", "")), x) :-
  field_insensitive_call_site_target(id, f, "call", p),
  server_process(p, m),
  function_def(h, m, "handle_call", 3, _),
  field_insensitive_return_all(h, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (reach_1_at_sel, reach_1_at_kind, reach_1_at_tag, _),
  reach_1_tag = "below",
  reach_1_at_sel = "{1}",
  reach_1_at_kind = "tuple",
  reach_1_at_tag = ":reply".

field_insensitive_points_to(f, "reply", id, ("deep", ("", "", "", "")), x) :-
  field_insensitive_call_site_target(id, f, "call", p),
  server_process(p, m),
  function_def(h, m, "handle_call", 3, _),
  field_insensitive_return_all(h, reach_1, x),
  reach_1 = ("deep", ("", "", "", "")).

// Names, as the field-insensitive pass resolves them.
field_insensitive_named_pid(n, p) :- process_register_var(_, f, n, k, s), field_insensitive_points_to(f, k, s, r, p), reach_top(r), process(p).
field_insensitive_named_pid(n, i) :- field_insensitive_named_pid(n, b), instance(i, b), i != b.

field_insensitive_named_pid(n, cat("child ", cat(s, cat("#", to_string(pos))))) :-
  stage_mode("selective"),
  supervisor_child_name(s, pos, n),
  supervisor_child(s, pos, m, _, _),
  behaves_as(m, "GenServer").

// The module-level guess only for a name no registration or child spec
// resolves, as processes.dl's named_pid.
field_insensitive_named_pid(n, p) :-
  stage_mode("selective"),
  named_process(mod, n),
  !resolved_name(n),
  server_process(p, mod).

// What field `sel` of a variable holds: the object itself when it is that
// field, one at a path not known otherwise.
.decl field_insensitive_field_asked(func: symbol, var_kind: symbol, var: symbol, field: symbol)

field_insensitive_field_asked(f, sk, s, sel) :-
  stage_mode("selective"),
  pid_use(_, f, _, "load", l),
  field_load(f, l, sel, sk, s),
  sk != "param".

field_insensitive_field_asked(f, sk, s, sel) :-
  stage_mode("selective"),
  targets_field(g, k, sel, _, _),
  call_arg_var(_, f, g, k, "call", sk, s),
  sk != "param".

.decl field_insensitive_field_reads(func: symbol, var_kind: symbol, var: symbol, field: symbol, reach: Reach, object: symbol)

field_insensitive_field_reads(f, sk, s, sel, ("top", ("", "", "", "")), x) :-
  field_insensitive_field_asked(f, sk, s, sel),
  field_insensitive_points_to(f, sk, s, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (sel, _, _, _),
  reach_1_tag = "under".

field_insensitive_field_reads(f, sk, s, sel, ("top", ("", "", "", "")), x) :-
  field_insensitive_field_asked(f, sk, s, sel),
  field_insensitive_points_to(f, sk, s, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (reach_1_at_sel, reach_1_at_kind, _, _),
  reach_1_tag = "under",
  reach_1_at_sel = "*",
  reach_1_at_kind = "map".

field_insensitive_field_reads(f, sk, s, sel, ("deep", ("", "", "", "")), x) :-
  field_insensitive_field_asked(f, sk, s, sel),
  field_insensitive_points_to(f, sk, s, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (sel, _, _, _),
  reach_1_tag = "below".

field_insensitive_field_reads(f, sk, s, sel, ("deep", ("", "", "", "")), x) :-
  field_insensitive_field_asked(f, sk, s, sel),
  field_insensitive_points_to(f, sk, s, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (reach_1_at_sel, reach_1_at_kind, _, _),
  reach_1_tag = "below",
  reach_1_at_sel = "*",
  reach_1_at_kind = "map".

field_insensitive_field_reads(f, sk, s, sel, ("deep", ("", "", "", "")), x) :- field_insensitive_field_asked(f, sk, s, sel), field_insensitive_points_to(f, sk, s, reach_1, x),
  reach_1 = ("deep", ("", "", "", "")).

.decl field_insensitive_entry_field_asked(func: symbol, pos: symbol, field: symbol)

field_insensitive_entry_field_asked(f, k, sel) :-
  stage_mode("selective"),
  pid_use(_, f, _, "load", l),
  field_load(f, l, sel, "param", k).

field_insensitive_entry_field_asked(f, j, sel) :-
  stage_mode("selective"),
  targets_field(g, k, sel, _, _),
  call_arg_var(_, f, g, k, "call", "param", j).

.decl field_insensitive_entry_field_reads(func: symbol, pos: symbol, field: symbol, reach: Reach, object: symbol)

field_insensitive_entry_field_reads(f, k, sel, ("top", ("", "", "", "")), x) :-
  field_insensitive_entry_field_asked(f, k, sel),
  field_insensitive_entry(f, k, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (sel, _, _, _),
  reach_1_tag = "under".

field_insensitive_entry_field_reads(f, k, sel, ("top", ("", "", "", "")), x) :-
  field_insensitive_entry_field_asked(f, k, sel),
  field_insensitive_entry(f, k, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (reach_1_at_sel, reach_1_at_kind, _, _),
  reach_1_tag = "under",
  reach_1_at_sel = "*",
  reach_1_at_kind = "map".

field_insensitive_entry_field_reads(f, k, sel, ("deep", ("", "", "", "")), x) :-
  field_insensitive_entry_field_asked(f, k, sel),
  field_insensitive_entry(f, k, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (sel, _, _, _),
  reach_1_tag = "below".

field_insensitive_entry_field_reads(f, k, sel, ("deep", ("", "", "", "")), x) :-
  field_insensitive_entry_field_asked(f, k, sel),
  field_insensitive_entry(f, k, reach_1, x),
  reach_1 = (reach_1_tag, reach_1_at),
  reach_1_at = (reach_1_at_sel, reach_1_at_kind, _, _),
  reach_1_tag = "below",
  reach_1_at_sel = "*",
  reach_1_at_kind = "map".

field_insensitive_entry_field_reads(f, k, sel, ("deep", ("", "", "", "")), x) :- field_insensitive_entry_field_asked(f, k, sel), field_insensitive_entry(f, k, reach_1, x),
  reach_1 = ("deep", ("", "", "", "")).

// What a use may reach: process_call's rules, read through the
// field-insensitive pass.
.decl field_insensitive_process_use(func: symbol, anchor: symbol, site: symbol, api_kind: symbol, process: symbol)

field_insensitive_process_use(f, id, id, kind, p) :-
  pid_use(id, f, kind, sk, s),
  sk != "param",
  sk != "load",
  field_insensitive_points_to(f, sk, s, r, p),
  reach_top(r),
  process(p).

// A load off a parameter is resolved at each caller, through its
// summary (targets_field), not in place.
field_insensitive_process_use(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  !param_load(f, l),
  field_insensitive_points_to(f, "load", l, r, p),
  reach_top(r),
  process(p).

field_insensitive_process_use(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  field_load(f, l, sel, bk, bs),
  bk != "param",
  field_insensitive_field_reads(f, bk, bs, sel, r, p),
  reach_top(r),
  process(p).

field_insensitive_process_use(f, id, id, kind, p) :-
  pid_use(id, f, kind, "param", k),
  field_insensitive_entry(f, k, r, p),
  reach_top(r),
  process(p).

field_insensitive_process_use(f, id, id, kind, p) :-
  pid_use(id, f, kind, "load", l),
  field_load(f, l, sel, "param", k),
  field_insensitive_entry_field_reads(f, k, sel, r, p),
  reach_top(r),
  process(p).

field_insensitive_process_use(f, a, id, kind, p) :-
  call_arg_var(a, f, g, k, "call", sk, s),
  sk != "param",
  targets_param(g, k, kind, id),
  field_insensitive_points_to(f, sk, s, r, p),
  reach_top(r),
  process(p).

field_insensitive_process_use(f, a, id, kind, p) :-
  call_arg_var(a, f, g, k, "call", "param", j),
  targets_param(g, k, kind, id),
  field_insensitive_entry(f, j, r, p),
  reach_top(r),
  process(p).

field_insensitive_process_use(f, a, id, kind, p) :-
  call_arg_var(a, f, g, k, "call", sk, s),
  sk != "param",
  targets_field(g, k, sel, kind, id),
  field_insensitive_field_reads(f, sk, s, sel, r, p),
  reach_top(r),
  process(p).

field_insensitive_process_use(f, a, id, kind, p) :-
  call_arg_var(a, f, g, k, "call", "param", j),
  targets_field(g, k, sel, kind, id),
  field_insensitive_entry_field_reads(f, j, sel, r, p),
  reach_top(r),
  process(p).

field_insensitive_call_site_target(id, g, kind, p) :- field_insensitive_process_use(_, _, id, kind, p), process_call_var(id, g, kind, _, _).

// ── Hub objects ─────────────────────────────────────────────────────

// The variables the field-insensitive pass finds holding an object, anywhere in them.
.decl field_insensitive_holder(func: symbol, var_kind: symbol, var: symbol, object: symbol)

field_insensitive_holder(f, sk, s, x) :- field_insensitive_points_to(f, sk, s, _, x).

.decl hub_spread(object: symbol, count: number)

.decl hub_holders(object: symbol, count: number)

hub_holders(x, count((f, sk, s))) :- field_insensitive_holder(f, sk, s, x).

hub_spread(x, n) :- object(x), hub_holders(x, n).
hub_spread(x, 0) :- object(x), !hub_holders(x, _).

// Every variable of the program, as TermFlow names them. A literal holds
// itself and no object, so it is no variable a hub could spread to.
.decl program_var(func: symbol, var_kind: symbol, var: symbol)

program_var(g, "param", k) :- stage_mode("selective"), call_arg_var(_, _, g, k, _, _, _).
program_var(f, sk, s) :- stage_mode("selective"), call_arg_var(_, f, _, _, _, sk, s), sk != "literal".
program_var(f, "load", l) :- stage_mode("selective"), field_load(f, l, _, _, _).
program_var(f, "term", o) :- stage_mode("selective"), term_allocation(f, o, _, _, _).
program_var(f, "result", c) :- stage_mode("selective"), call_result_var(c, f, _).

.decl program_var_count(count: number)

.decl program_var_rows(count: number)

program_var_rows(count((f, sk, s))) :- program_var(f, sk, s).

program_var_count(n) :- stage_mode("selective"), program_var_rows(n).
program_var_count(0) :- stage_mode("selective"), !program_var_rows(_).

.decl hub_object(object: symbol)

hub_object(x) :- hub_spread(x, n), program_var_count(t), n > 1000, n * 100 > t.

// The field-insensitive stage (points_to_field_insensitive.dl) resolves every object so.
hub_object(x) :- stage_mode("field_insensitive"), object(x).

// A hub object's targets and names are the field-insensitive pass's.
process_call(f, a, id, kind, p) :- field_insensitive_process_use(f, a, id, kind, p), hub_object(p).
message_target(id, g, kind, p) :- field_insensitive_call_site_target(id, g, kind, p), hub_object(p).
named_pid(n, p) :- field_insensitive_named_pid(n, p), hub_object(p).
