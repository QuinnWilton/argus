// Where externally-controlled data enters the system.
//
// Extracted from analyses/request_surface.dl when a second analysis needed
// it. Both ask the same question of different sinks: request_surface asks
// which unsafe operations attacker data reaches, and
// unbounded_dynamic_children asks whether an outside party can make the
// node start processes without limit.
//
// Prerequisites: include clientlib/imports.dl and clientlib/behaviours.dl
// before this file.

// Callbacks whose arguments are, or are derived from, data an external
// party controls. `kind` is carried through to the finding so the report
// can say which surface reaches the sink.

.decl request_entry(func: symbol, kind: symbol)

// Plug.call/2 receives the conn. Phoenix controllers are Plugs, so this
// covers controller actions' entry as well.
request_entry(func, "plug") :-
  behaves_as(mod, "Plug"),
  function_def(func, mod, "call", 2, _).

// LiveView: mount/3 takes params, handle_params/3 takes the query string,
// handle_event/3 takes whatever the client's JS pushed.
request_entry(func, "live_view") :-
  behaves_as(mod, "Phoenix.LiveView"),
  function_def(func, mod, name, arity, _),
  arity = 3,
  (name = "mount" ; name = "handle_params" ; name = "handle_event").

request_entry(func, "live_component") :-
  behaves_as(mod, "Phoenix.LiveComponent"),
  function_def(func, mod, "handle_event", 3, _).

// Channels are the websocket surface: handle_in/3 is raw client payload.
request_entry(func, "channel") :-
  behaves_as(mod, "Phoenix.Channel"),
  function_def(func, mod, "handle_in", 3, _).

// Background jobs are an untrusted boundary too — job args are usually
// enqueued from user-facing code and round-trip through storage, so they
// are attacker-influenced even though no socket is involved.
request_entry(func, "oban_job") :-
  behaves_as(mod, "Oban.Worker"),
  function_def(func, mod, "perform", 1, _).
