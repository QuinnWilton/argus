// Where externally-controlled data enters the system.
//
// unsafe_input asks which unsafe operations attacker data reaches and
// whether an outside party can make the node start processes without
// limit; concurrency.dl counts a function a request entry reaches as one
// many processes run at once (the races).
//
// Prerequisites: include clientlib/imports.dl and clientlib/behaviours.dl
// before this file.

// Callbacks whose arguments are, or are derived from, data an external
// party controls. `kind` is carried through to the finding so the report
// can say which surface reaches the sink.

.decl request_entry(func: symbol, kind: symbol)

// Plug.call/2 receives the conn. A Phoenix controller is a Plug too, but
// its call/2 reaches its actions only through an apply (below).
request_entry(func, "plug") :-
  behaves_as(mod, "Plug"),
  function_def(func, mod, "call", 2, _).

// Phoenix controller actions. `use Phoenix.Controller` makes the module
// a Plug whose call/2 runs phoenix_controller_pipeline/2, and its
// action/2 applies the action the router named, read off the conn
// (`apply(__MODULE__, action_name, [conn, conn.params])`): no call edge
// reaches an action, so call/2 above reaches none of them. Every
// exported arity-2 function of such a module is an action, or a
// function plug the pipeline calls with the conn: its conn and params
// are the request. The routes are not asked: a controller whose router
// is outside the program still serves them.
.decl phoenix_controller(mod: symbol)

phoenix_controller(mod) :-
  behaves_as(mod, "Plug"),
  function_def(_, mod, "phoenix_controller_pipeline", 2, _).

request_entry(func, "controller") :-
  phoenix_controller(mod),
  function_def(func, mod, name, 2, 1),
  name != "call",
  name != "action",
  name != "phoenix_controller_pipeline".

// LiveView: mount/3 takes params, handle_params/3 takes the query string,
// handle_event/3 takes whatever the client's JS pushed.
request_entry(func, "live_view") :-
  behaves_as(mod, "Phoenix.LiveView"),
  function_def(func, mod, name, arity, _),
  arity = 3,
  (name = "mount" ; name = "handle_params" ; name = "handle_event").

request_entry(func, "live_component") :-
  behaves_as(mod, "Phoenix.LiveComponent"),
  function_def(func, mod, "handle_event", 3, _).

// Channels are the websocket surface: handle_in/3 is raw client payload.
request_entry(func, "channel") :-
  behaves_as(mod, "Phoenix.Channel"),
  function_def(func, mod, "handle_in", 3, _).

// A raw connection's bytes: ThousandIsland hands a handler each read off
// the socket (Bandit's HTTP/1, HTTP/2 and WebSocket handlers are ones,
// and so is any custom TCP protocol on it), and a WebSock handler each
// websocket frame's payload (Bandit's and Cowboy's websocket upgrades
// call it).
request_entry(func, "socket") :-
  behaves_as(mod, "ThousandIsland.Handler"),
  function_def(func, mod, "handle_data", 3, _).

request_entry(func, "websocket") :-
  behaves_as(mod, "WebSock"),
  function_def(func, mod, "handle_in", 2, _).

// Background jobs are an untrusted boundary too — job args are usually
// enqueued from user-facing code and round-trip through storage, so they
// are attacker-influenced even though no socket is involved.
request_entry(func, "oban_job") :-
  behaves_as(mod, "Oban.Worker"),
  function_def(func, mod, "perform", 1, _).

// A Broadway pipeline's messages come from its producer — a queue, a
// topic — that outside parties write to, and its processors handle them
// many at a time.
request_entry(func, "broadway") :-
  behaves_as(mod, "Broadway"),
  function_def(func, mod, name, arity, _),
  ((name = "handle_message", arity = 3) ; (name = "handle_batch", arity = 4)).

// Which parameter positions carry external data. Not every argument of
// an entry is the request: a LiveView's socket and a Plug's opts are the
// application's own, and mount/3's session is signed by the endpoint.

.decl request_param(func: symbol, pos: number)

// The conn: params, headers, body, cookies, path.
request_param(func, 0) :- request_entry(func, "plug").

// A controller action's conn and params.
request_param(func, 0) :- request_entry(func, "controller").
request_param(func, 1) :- request_entry(func, "controller").

// handle_event/3: the event name and the pushed params.
request_param(func, 0) :-
  request_entry(func, "live_view"),
  function_def(func, _, "handle_event", 3, _).

request_param(func, 1) :-
  request_entry(func, "live_view"),
  function_def(func, _, "handle_event", 3, _).

// handle_params/3: the params and the uri.
request_param(func, 0) :-
  request_entry(func, "live_view"),
  function_def(func, _, "handle_params", 3, _).

request_param(func, 1) :-
  request_entry(func, "live_view"),
  function_def(func, _, "handle_params", 3, _).

// mount/3: the params. The session (position 1) is server-written.
request_param(func, 0) :-
  request_entry(func, "live_view"),
  function_def(func, _, "mount", 3, _).

// A component's event name and params; a channel's event and payload.
request_param(func, 0) :- request_entry(func, "live_component").
request_param(func, 1) :- request_entry(func, "live_component").
request_param(func, 0) :- request_entry(func, "channel").
request_param(func, 1) :- request_entry(func, "channel").

// The bytes read off the socket; the frame, `{payload, opcode: op}`.
request_param(func, 0) :- request_entry(func, "socket").
request_param(func, 0) :- request_entry(func, "websocket").

// The job: its args round-tripped through storage from user-facing code.
request_param(func, 0) :- request_entry(func, "oban_job").

// The message, or the batch of messages; the processor name and context
// are the pipeline's own.
request_param(func, 1) :- request_entry(func, "broadway").
