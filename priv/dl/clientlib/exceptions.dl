// Exception handlers at function, try, and covered-call scope. `catch_total` accepts
// every reason of a class (`*` for all classes); `catch_tag` records reason tags.
// Requires imports.dl.

.decl catches_class(func: symbol, class: symbol)

catches_class(func, class) :- site_catches_class(_, func, class).

.decl site_catches_class(id: symbol, func: symbol, class: symbol)

site_catches_class(id, func, class) :- catch_total(id, func, class), class != "*".
site_catches_class(id, func, "error") :- catch_total(id, func, "*").
site_catches_class(id, func, "exit") :- catch_total(id, func, "*").
site_catches_class(id, func, "throw") :- catch_total(id, func, "*").

// A call in this try's protected region whose handler accepts every reason of `class`.
// `try_covers` excludes code after try_end. Erlang catch expressions accept every
// class.
.decl covered_by_catch(call: symbol, func: symbol, try_site: symbol, class: symbol)

covered_by_catch(call, f, t, class) :-
  try_covers(t, f, call, "try"),
  site_catches_class(t, f, class).

covered_by_catch(call, f, t, class) :-
  try_covers(t, f, call, "catch"),
  (class = "error" ; class = "exit" ; class = "throw").

// A try handler has a path accepting class `class` without re-raising; reason
// restrictions are allowed. An untested class accepts all classes, and query `*` asks
// whether anything is handled. After-only and re-raise-only handlers do not qualify.
.decl try_takes(id: symbol, class: symbol)

try_takes(id, class) :- catch_class(id, _, class, _), class != "*".
try_takes(id, class) :- catch_class(id, _, "*", _), (class = "error" ; class = "exit" ; class = "throw").
try_takes(id, "*") :- catch_class(id, _, _, _).

// Handlers accepting badarg/ArgumentError: general error handlers, matching reason
// tags, or Erlang catch expressions. A rescue for another error type does not qualify.
.decl rescues_argument_error(func: symbol)

rescues_argument_error(f) :- catches_class(f, "error").
rescues_argument_error(f) :- catch_tag(_, f, "error", "ArgumentError").
rescues_argument_error(f) :- catch_tag(_, f, "error", ":badarg").
rescues_argument_error(f) :- try_start(_, f, "catch", _).

// Supported raise categories: badarg (ArgumentError), erpc transport errors, or any
// reason of error, exit, or throw. Map each to its exception class for handler checks.
.decl raise_class(raise: symbol, class: symbol)

raise_class("badarg", "error").
raise_class("erpc", "error").
raise_class("error", "error").
raise_class("exit", "exit").
raise_class("throw", "throw").

// A reason tag a handler clause names that takes the raise.
.decl raise_tag(raise: symbol, tag: symbol)

raise_tag("badarg", "ArgumentError").
raise_tag("badarg", ":badarg").
raise_tag("erpc", ":erpc").

// A handler accepts the raise's class or tag and has a non-re-raising path for that
// class. Erlang catch expressions cover every raise. `catch_tag` over-approximates
// tags, so unrelated comparisons may suppress escape findings.
.decl handler_takes(id: symbol, func: symbol, raise: symbol)

handler_takes(t, f, r) :-
  raise_class(r, c),
  try_takes(t, c),
  site_catches_class(t, f, c).

handler_takes(t, f, r) :-
  raise_class(r, c),
  try_takes(t, c),
  raise_tag(r, tag),
  catch_tag(t, f, c, tag).

handler_takes(t, f, r) :- try_start(t, f, "catch", _), raise_class(r, _).

// The call is covered by a try that catches raise. Require try_covers for this site; an
// unrelated try in the same function does not count.
.decl site_takes(call: symbol, func: symbol, raise: symbol)

site_takes(c, f, r) :- try_covers(t, f, c, _), handler_takes(t, f, r).

// Some handler in `func` takes `raise`, whatever it covers: the
// function-wide answer, for an edge that has no call to hold a try
// against.
.decl takes_somewhere(func: symbol, raise: symbol)

takes_somewhere(f, r) :- handler_takes(_, f, r).
