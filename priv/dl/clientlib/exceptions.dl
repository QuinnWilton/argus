// What a function's try handlers take.
//
// `catch_total(id, func, class)` says a clause of the try at `id` takes
// every reason of `class` (`*` for every class); `catch_tag` names one
// reason. The questions rules ask are "does anything here catch an
// exit", "does THIS try catch an exit" and "is THIS call inside a try
// that catches an exit", so all three granularities are named.
//
// Requires imports.dl.

.decl catches_class(func: symbol, class: symbol)

catches_class(func, class) :- catch_total(_, func, class), class != "*".
catches_class(func, "error") :- catch_total(_, func, "*").
catches_class(func, "exit") :- catch_total(_, func, "*").
catches_class(func, "throw") :- catch_total(_, func, "*").

.decl site_catches_class(id: symbol, func: symbol, class: symbol)

site_catches_class(id, func, class) :- catch_total(id, func, class), class != "*".
site_catches_class(id, func, "error") :- catch_total(id, func, "*").
site_catches_class(id, func, "exit") :- catch_total(id, func, "*").
site_catches_class(id, func, "throw") :- catch_total(id, func, "*").

// The call at `call` is inside the protected region of the try at
// `try_site` (try_covers: on a path from the try that has not passed its
// `try_end`, walked on the function's graph), and that try's handler
// takes every reason of `class`. Erlang's `catch Expr` takes every class.
// What a rule asks when the question is whether THIS call is guarded,
// not whether its function has a handler somewhere.
.decl covered_by_catch(call: symbol, func: symbol, try_site: symbol, class: symbol)

covered_by_catch(call, f, t, class) :-
  try_covers(t, f, call, "try"),
  site_catches_class(t, f, class).

covered_by_catch(call, f, t, class) :-
  try_covers(t, f, call, "catch"),
  (class = "error" ; class = "exit" ; class = "throw").

// The try (or `catch`) at `id` takes some reason of `class`: a path
// through its handler establishes the class and returns without raising
// again (catch_class), whatever it asks of the reason — `rescue
// ArgumentError` takes the class error, as `catch :error, _` does. A
// handler with no class test takes every class; `class` "*" asks
// whether it takes anything at all. An `after`, or a rescue that only
// re-raises, takes nothing.
.decl try_takes(id: symbol, class: symbol)

try_takes(id, class) :- catch_class(id, _, class, _), class != "*".
try_takes(id, class) :- catch_class(id, _, "*", _), (class = "error" ; class = "exit" ; class = "throw").
try_takes(id, "*") :- catch_class(id, _, _, _).

// A handler in `func` that takes the ArgumentError (:badarg) a BIF raises
// on a missing table or a taken name: a bare rescue or catch-all of
// class error, one naming ArgumentError or :badarg, or Erlang's `catch
// Expr`, which takes every class. `rescue SomeOtherError` is not one.
.decl rescues_argument_error(func: symbol)

rescues_argument_error(f) :- catches_class(f, "error").
rescues_argument_error(f) :- catch_tag(_, f, "error", "ArgumentError").
rescues_argument_error(f) :- catch_tag(_, f, "error", ":badarg").
rescues_argument_error(f) :- try_start(_, f, "catch", _).

// The same question asked of one call: the call at `call` in `func` is
// inside a try whose handler takes the ArgumentError, or inside Erlang's
// `catch Expr`. What a rule asks when a handler elsewhere in the function
// — around unrelated code after the call — must not count.
.decl site_rescues_argument_error(call: symbol, func: symbol)

site_rescues_argument_error(c, f) :- covered_by_catch(c, f, _, "error").
site_rescues_argument_error(c, f) :- try_covers(t, f, c, "try"), catch_tag(t, f, "error", "ArgumentError").
site_rescues_argument_error(c, f) :- try_covers(t, f, c, "try"), catch_tag(t, f, "error", ":badarg").

// The same question for a call whose failure the rule would report
// unless the try goes on from it: the call at `call` in `func` is inside
// a try that takes the ArgumentError (as site_rescues_argument_error
// asks) and whose handler returns without raising again (try_takes: a
// rescue that only re-raises, or an `after`, takes nothing), or inside
// Erlang's `catch Expr`.
.decl site_takes_argument_error(call: symbol, func: symbol)

site_takes_argument_error(c, f) :-
  try_covers(t, f, c, "try"),
  try_takes(t, "error"),
  catch_total(t, f, class),
  (class = "error" ; class = "*").

site_takes_argument_error(c, f) :-
  try_covers(t, f, c, "try"),
  try_takes(t, "error"),
  catch_tag(t, f, "error", tag),
  (tag = "ArgumentError" ; tag = ":badarg").

site_takes_argument_error(c, f) :- try_covers(_, f, c, "catch").
