// Supervision tree helpers for client analyses.
//
// Provides the child subtree mapping and the start-order join.
//
// Included by otp.dl; requires imports.dl.
//
// Provides:
//   child_subtree(sup, branch, mod)
//   starts_before(sup, earlier, later, earlier_pos, later_pos)
//   boots_before(sup, earlier, later, earlier_pos, later_pos)
//   child_restart(sup, pos, child, restart)
//   dynamic_restart(sup, child, caller, restart)
//   reaches_child_start(func, start)
//   ends_with(dying, other)

// ── Child subtree ─────────────────────────────────────────────────────

// Maps every module in a supervisor's subtree to the direct child
// branch it belongs to. A direct child is its own branch root.

.decl child_subtree(sup: symbol, branch: symbol, mod: symbol)

child_subtree(sup, child, child) :- supervisor_child(sup, _, child, _, _).

child_subtree(sup, branch, descendant) :-
  child_subtree(sup, branch, intermediate),
  supervisor_child(intermediate, _, descendant, _, _).

// Dynamic children added via DynamicSupervisor.start_child are full
// members of their supervisor's subtree even though they don't appear
// in any static init/1 spec. They become their own branch root the
// same way static children do.
child_subtree(sup, child, child) :- dynamic_child(sup, child, _).

child_subtree(sup, branch, descendant) :-
  child_subtree(sup, branch, intermediate),
  dynamic_child(intermediate, descendant, _).

// So are the children a start_child adds to a supervisor with a spec of
// its own (supervisor:start_child(kernel_safe_sup, Spec)).
child_subtree(sup, child, child) :- added_child(sup, child, _, _, _).

child_subtree(sup, branch, descendant) :-
  child_subtree(sup, branch, intermediate),
  added_child(intermediate, descendant, _, _, _).

// ── The restart a child runs under ────────────────────────────────────
//
// supervisor_child's restart is what the spec states. A shorthand
// (`{Mod, args}`, a bare `Mod`, a `Mod.child_spec(args)` call) states
// none, and the extractor writes :permanent, the supervisor's default,
// where the child's own child_spec/1 may say otherwise (`use GenServer,
// restart: :transient`, logflare's ClickHouse Provisioner's hand-written
// map): for a shorthand the restart is child_spec_restart's when the
// module states one.
.decl child_restart(sup: symbol, pos: number, child: symbol, restart: symbol)

child_restart(sup, pos, child, restart) :-
  supervisor_child(sup, pos, child, restart, _),
  supervisor_child_form(sup, pos, "explicit").

child_restart(sup, pos, child, restart) :-
  supervisor_child(sup, pos, child, _, _),
  supervisor_child_form(sup, pos, "shorthand"),
  child_spec_restart(child, restart).

child_restart(sup, pos, child, restart) :-
  supervisor_child(sup, pos, child, restart, _),
  supervisor_child_form(sup, pos, "shorthand"),
  !child_spec_restart(child, _).

// A DynamicSupervisor.start_child gives its child the restart of the spec
// it hands over: a map's (`:permanent` when it states none, whatever the
// module's child_spec/1 says), an override's, or for a shorthand (`Mod`,
// `{Mod, arg}`, which states none: dynamic_child_restart has no row) the
// module's own child_spec/1's, `:permanent` when that states none either.
.decl dynamic_restart(sup: symbol, child: symbol, caller: symbol, restart: symbol)

dynamic_restart(sup, child, f, restart) :- dynamic_child_restart(sup, child, f, restart).

dynamic_restart(sup, child, f, restart) :-
  dynamic_child(sup, child, f),
  !dynamic_child_restart(sup, child, f, _),
  child_spec_restart(child, restart).

dynamic_restart(sup, child, f, "permanent") :-
  dynamic_child(sup, child, f),
  !dynamic_child_restart(sup, child, f, _),
  !child_spec_restart(child, _).

// ── Start order ───────────────────────────────────────────────────────
//
// Two modules under one supervisor, on different branches, with the
// earlier branch's position and the later one's. Supervisors start
// children in order, so this is "earlier is running when later's init
// runs" and, under rest_for_one, "later restarts when earlier crashes".
// Five analyses wrote this join out by hand.
.decl starts_before(sup: symbol, earlier: symbol, later: symbol, earlier_pos: number, later_pos: number)

starts_before(sup, earlier, later, epos, lpos) :-
  supervisor(sup, _),
  supervisor_child(sup, epos, earlier_branch, _, _),
  child_subtree(sup, earlier_branch, earlier),
  supervisor_child(sup, lpos, later_branch, _, _),
  child_subtree(sup, later_branch, later),
  epos < lpos,
  earlier_branch != later_branch.

// ── Start order at boot ──────────────────────────────────────────────
//
// starts_before holds for every member of a branch, a dynamic child
// included: what the branch's supervisor holds, however it got there,
// stops with it, and shutdown's order reads that. The order in which the
// inits run while the tree boots is narrower. A dynamic child
// (DynamicSupervisor.start_child) and the template child of a
// simple_one_for_one supervisor start when something asks for one, after
// the supervisor is up: zotonic's z_sites_manager starts each site's
// z_site_sup under z_sites_sup, an earlier sibling's branch, and the
// site's init runs with z_sites_manager already up, unless an init of the
// boot asks for one (below). boot_subtree follows the static children a
// supervisor starts in its own start, and those an init starts while the
// tree boots; boots_before orders two of them; the startup rules about
// what an init meets during the boot read it.
.decl template_supervisor(sup: symbol)

template_supervisor(sup) :- supervisor(sup, "simple_one_for_one").

.decl boot_subtree(sup: symbol, branch: symbol, mod: symbol)

boot_subtree(sup, child, child) :-
  supervisor_child(sup, _, child, _, _),
  !template_supervisor(sup).

boot_subtree(sup, branch, descendant) :-
  boot_subtree(sup, branch, intermediate),
  supervisor_child(intermediate, _, descendant, _, _),
  !template_supervisor(intermediate).

// A template or dynamic child an init/1 in the boot starts — it calls
// start_child on the child's supervisor, or a function that does, one
// call away — starts in that init's turn, as part of the starter's
// branch: its own init runs before what the starter's position precedes
// has started. A start two calls away is not followed, and its child is
// missed.
boot_subtree(sup, branch, child) :-
  boot_subtree(sup, branch, starter),
  init_function(starter, f),
  boot_start(f, pool),
  on_demand_child(pool, child).

.decl on_demand_child(pool: symbol, child: symbol)

on_demand_child(pool, child) :-
  template_supervisor(pool),
  supervisor_child(pool, _, child, _, _).

on_demand_child(pool, child) :- dynamic_child(pool, child, _).
on_demand_child(pool, child) :- added_child(pool, child, _, _, _).

.decl boot_start(func: symbol, pool: symbol)

boot_start(f, pool) :- sup_management_call(_, f, _, "start_child", pool).

boot_start(f, pool) :-
  call_edge(f, g),
  sup_management_call(_, g, _, "start_child", pool).

// Erlang's own `supervisor:start_child(Pool, Args)`, which sup_call (the
// Elixir APIs) does not name.
boot_start(f, pool) :- erlang_start_child(f, pool).
boot_start(f, pool) :- call_edge(f, g), erlang_start_child(g, pool).

.decl erlang_start_child(func: symbol, pool: symbol)

erlang_start_child(f, pool) :-
  remote_call(_, f, ":supervisor", "start_child", 2),
  call_arg(f, ":supervisor:start_child/2", 0, pool),
  pool != "dynamic".

.decl boots_before(sup: symbol, earlier: symbol, later: symbol, earlier_pos: number, later_pos: number)

boots_before(sup, earlier, later, epos, lpos) :-
  supervisor(sup, _),
  supervisor_child(sup, epos, earlier_branch, _, _),
  boot_subtree(sup, earlier_branch, earlier),
  supervisor_child(sup, lpos, later_branch, _, _),
  boot_subtree(sup, later_branch, later),
  epos < lpos,
  earlier_branch != later_branch.

// ── The application's root ───────────────────────────────────────────
//
// The supervisor an Application's start/2 starts (`partisan_app:start/2
// -> partisan_sup:start_link()`), the Erlang shape of an Elixir
// Application that starts its tree inline: nothing restarts it, and when
// it dies the application stops with it. What dies with it dies with the
// application. Not one another supervisor in view also starts, as a
// child or on demand: restarted there, it outlives what it held.
.decl application_root(sup: symbol)

application_root(sup) :-
  behaves_as(app, "Application"),
  function_def(start, app, "start", 2, _),
  call_edge(start, g),
  function_def(g, sup, "start_link", _, _),
  supervisor(sup, _),
  sup != app,
  !supervisor_child(_, _, sup, _, _),
  !dynamic_child(_, sup, _),
  !added_child(_, sup, _, _, _).

// ── What ends with a process ─────────────────────────────────────────
//
// `ends_with(dying, other)`: when the process of `dying` (a supervised
// module) ends, its supervisors end `other`'s too. `dying` is a
// supervisor and `other` lies in its subtree; or `dying` is a direct
// child of a supervisor whose strategy restarts `other`'s branch with it
// (`:one_for_all`, or `:rest_for_one` with `other`'s branch later). A
// `dying` deeper in a branch is restarted by its own supervisor, and the
// branch around it goes on (a restart intensity the crash exhausts, which
// the facts do not show, is not followed). What the application's end
// takes is `application_root`'s question. docs/design/restart-state.md is
// the model: what one process holds that another's end discards.
.decl ends_with(dying: symbol, other: symbol)

ends_with(d, o) :- supervisor(d, _), child_subtree(d, _, o), o != d.

ends_with(d, o) :-
  supervisor(s, "one_for_all"),
  supervisor_child(s, _, d, _, _),
  child_subtree(s, b, o),
  b != d.

ends_with(d, o) :-
  supervisor(s, "rest_for_one"),
  supervisor_child(s, dp, d, _, _),
  supervisor_child(s, bp, b, _, _),
  bp > dp,
  child_subtree(s, b, o).

// ── Siblings ─────────────────────────────────────────────────────────
//
// Two direct children of one supervisor: the modules whose lifetimes it
// sequences together.
.decl sibling(sup: symbol, a: symbol, b: symbol)

sibling(sup, a, b) :-
  supervisor_child(sup, _, a, _, _),
  supervisor_child(sup, _, b, _, _),
  a != b.

// ── Supervisor management calls ──────────────────────────────────────
//
// sup_call records GenServer.stop too, under api "GenServer"; the rules
// about a supervisor's own API (start_child, terminate_child, ...)
// read this projection.
.decl sup_management_call(id: symbol, func: symbol, api: symbol, op: symbol, target: symbol)

sup_management_call(id, func, api, op, target) :-
  sup_call(id, func, api, op, target),
  api != "GenServer".

// Operations that create a child in the target supervisor.
.decl child_creating_op(op: symbol)

child_creating_op("start_child").
child_creating_op("async").
child_creating_op("async_nolink").

// `func` calls `start`, a function that starts a child under a supervisor
// at run time (dynamic_child's start), itself or through any calls.
// Walked backwards from the starts, so only their callers are explored.
.decl reaches_child_start(func: symbol, start: symbol) inline

reaches_child_start(f, start) :- child_start_reach.reaches(f, start).

.init child_start_reach = CallReach

child_start_reach.seed(start, start) :- dynamic_child(_, _, start).

// Operations with no bound of their own: terminate_child, stop and
// their relatives wait for a whole shutdown. start_child is bounded by
// the child's init, and a call with a timeout gives up.
.decl unbounded_sup_op(op: symbol)

unbounded_sup_op("terminate_child").
unbounded_sup_op("restart_child").
unbounded_sup_op("delete_child").
unbounded_sup_op("stop").

// Operations that stop children.
.decl stopping_sup_op(op: symbol)

stopping_sup_op("terminate_child").
stopping_sup_op("stop").
