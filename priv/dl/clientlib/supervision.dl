// Supervision helpers: child subtrees, start and boot order, restart policies,
// child-start reachability and linked lifetimes. Included by otp.dl; requires
// imports.dl.

// ── Child subtree ─────────────────────────────────────────────────────

// Maps every module in a supervisor's subtree to the direct child
// branch it belongs to. A direct child is its own branch root.

.decl child_subtree(sup: symbol, branch: symbol, mod: symbol)

child_subtree(sup, child, child) :- supervisor_child(sup, _, child, _, _).

child_subtree(sup, branch, descendant) :-
  child_subtree(sup, branch, intermediate),
  supervisor_child(intermediate, _, descendant, _, _).

// Dynamic children belong to the supervisor's subtree and form their own branch roots,
// just like static children.
child_subtree(sup, child, child) :- dynamic_child(sup, child, _).

child_subtree(sup, branch, descendant) :-
  child_subtree(sup, branch, intermediate),
  dynamic_child(intermediate, descendant, _).

// So are the children a start_child adds to a supervisor with a spec of
// its own (supervisor:start_child(kernel_safe_sup, Spec)).
child_subtree(sup, child, child) :- added_child(sup, child, _, _, _).

child_subtree(sup, branch, descendant) :-
  child_subtree(sup, branch, intermediate),
  added_child(intermediate, descendant, _, _, _).

// Resolved restart policy for static, dynamic, and added children. Explicit specs
// supply the policy; known maps without a restart key use permanent. Shorthand specs
// use the module's child_spec and supplied options.
// Unknown specs, missing child_spec code, and unresolved arguments yield no policy.
// Task.Supervisor task restart options are not modeled. Consumers must use this
// relation rather than assuming defaults for unknown values.
.decl restart_policy(sup: symbol, child: symbol, restart: symbol)

restart_policy(sup, child, restart) :- child_restart(sup, _, child, restart), known_restart(restart).
restart_policy(sup, child, restart) :- dynamic_restart(sup, child, _, restart), known_restart(restart).
restart_policy(sup, child, restart) :- added_restart(sup, child, _, restart), known_restart(restart).

.decl known_restart(restart: symbol)

known_restart("permanent").
known_restart("transient").
known_restart("temporary").

// A child's restart policy at position pos, from its explicit spec or shorthand
// child_spec. Map specs default to permanent unless overridden.
.decl child_restart(sup: symbol, pos: number, child: symbol, restart: symbol)

child_restart(sup, pos, child, restart) :-
  supervisor_child(sup, pos, child, restart, _),
  restart != "own".

child_restart(sup, pos, child, restart) :-
  supervisor_child(sup, pos, child, "own", _),
  own_restart(sup, child, to_string(pos), restart).

// A dynamic child's restart comes from its explicit spec or override, otherwise its
// shorthand module's child_spec. A known map lacking restart uses permanent.
// Task.Supervisor task starts use API options instead and have no row here.
.decl dynamic_restart(sup: symbol, child: symbol, caller: symbol, restart: symbol)

dynamic_restart(sup, child, f, restart) :- dynamic_child_restart(sup, child, f, restart).

dynamic_restart(sup, child, f, restart) :-
  dynamic_child(sup, child, f),
  child != "Task",
  !dynamic_child_restart(sup, child, f, _),
  own_restart(sup, child, f, restart).

// A Supervisor.start_child's child runs under the restart its spec
// states; a shorthand's (`own`) is its module's own.
.decl added_restart(sup: symbol, child: symbol, caller: symbol, restart: symbol)

added_restart(sup, child, f, restart) :- added_child(sup, child, restart, _, f), restart != "own".

added_restart(sup, child, f, restart) :-
  added_child(sup, child, "own", _, f),
  own_restart(sup, child, f, restart).

// The restart the shorthand start `at` (a position in sup's child list,
// or the function that calls start_child) gets from child's own
// child_spec/1 (own_field).
.decl own_restart(sup: symbol, child: symbol, at: symbol, restart: symbol)

own_restart(sup, child, at, restart) :- own_field(sup, child, at, "restart", restart).

// Resolve a shorthand child-spec field from the module's declared value or an argument
// option. Use the option default only for a fully known options argument lacking the
// key. Unreadable values or arguments remain unknown.
.decl own_field(sup: symbol, child: symbol, at: symbol, field: symbol, value: symbol)

own_field(sup, child, at, "restart", restart) :-
  shorthand_arg(sup, child, at, _),
  child_spec_restart(child, restart).

own_field(sup, child, at, "type", type) :-
  shorthand_arg(sup, child, at, _),
  child_spec_type(child, type).

own_field(sup, child, at, field, value) :-
  shorthand_arg(sup, child, at, "options"),
  child_spec_option(child, field, key, _),
  shorthand_option(sup, child, at, key, value).

own_field(sup, child, at, field, default) :-
  shorthand_arg(sup, child, at, "options"),
  child_spec_option(child, field, key, default),
  !shorthand_option(sup, child, at, key, _).

// Start order between different branches of one supervisor. The earlier branch is
// running when the later branch initializes; under rest_for_one, its crash also
// restarts the later branch.
.decl starts_before(sup: symbol, earlier: symbol, later: symbol, earlier_pos: number, later_pos: number)

starts_before(sup, earlier, later, epos, lpos) :-
  supervisor(sup, _),
  supervisor_child(sup, epos, earlier_branch, _, _),
  child_subtree(sup, earlier_branch, earlier),
  supervisor_child(sup, lpos, later_branch, _, _),
  child_subtree(sup, later_branch, later),
  epos < lpos,
  earlier_branch != later_branch.

// Boot order versus lifetime order
//
// `starts_before` orders whole branches, including later-added children, for shutdown.
// `boot_subtree` includes only static children and dynamic children started by init
// during boot; `boots_before` orders those startup operations. Ordinary on-demand
// children start after their supervisor is already running.
.decl template_supervisor(sup: symbol)

template_supervisor(sup) :- supervisor(sup, "simple_one_for_one").

.decl boot_subtree(sup: symbol, branch: symbol, mod: symbol)

boot_subtree(sup, child, child) :-
  supervisor_child(sup, _, child, _, _),
  !template_supervisor(sup).

boot_subtree(sup, branch, descendant) :-
  boot_subtree(sup, branch, intermediate),
  supervisor_child(intermediate, _, descendant, _, _),
  !template_supervisor(intermediate).

// A dynamic or template child started during boot belongs to the starter's branch.
// Follow start_child directly from init/1 or through one helper; deeper calls are
// missed.
boot_subtree(sup, branch, child) :-
  boot_subtree(sup, branch, starter),
  init_function(starter, f),
  boot_start(f, pool),
  on_demand_child(pool, child).

.decl on_demand_child(pool: symbol, child: symbol)

on_demand_child(pool, child) :-
  template_supervisor(pool),
  supervisor_child(pool, _, child, _, _).

on_demand_child(pool, child) :- dynamic_child(pool, child, _).
on_demand_child(pool, child) :- added_child(pool, child, _, _, _).

.decl boot_start(func: symbol, pool: symbol)

boot_start(f, pool) :- sup_management_call(_, f, _, "start_child", pool).

boot_start(f, pool) :-
  call_edge(f, g),
  sup_management_call(_, g, _, "start_child", pool).

// Erlang's own `supervisor:start_child(Pool, Args)`, which sup_call (the
// Elixir APIs) does not name.
boot_start(f, pool) :- erlang_start_child(f, pool).
boot_start(f, pool) :- call_edge(f, g), erlang_start_child(g, pool).

.decl erlang_start_child(func: symbol, pool: symbol)

erlang_start_child(f, pool) :-
  remote_call(_, f, ":supervisor", "start_child", 2),
  call_arg(f, ":supervisor:start_child/2", 0, pool),
  pool != "dynamic".

.decl boots_before(sup: symbol, earlier: symbol, later: symbol, earlier_pos: number, later_pos: number)

boots_before(sup, earlier, later, epos, lpos) :-
  supervisor(sup, _),
  supervisor_child(sup, epos, earlier_branch, _, _),
  boot_subtree(sup, earlier_branch, earlier),
  supervisor_child(sup, lpos, later_branch, _, _),
  boot_subtree(sup, later_branch, later),
  epos < lpos,
  earlier_branch != later_branch.

// An application root supervisor is started by Application.start/2 and by no other
// visible supervisor. Its death ends the application; it has no independent restart.
// Exclude supervisors also started elsewhere.
.decl application_root(sup: symbol)

application_root(sup) :-
  behaves_as(app, "Application"),
  function_def(start, app, "start", 2, _),
  call_edge(start, g),
  function_def(g, sup, "start_link", _, _),
  supervisor(sup, _),
  sup != app,
  !supervisor_child(_, _, sup, _, _),
  !dynamic_child(_, sup, _),
  !added_child(_, sup, _, _, _).

// `ends_with(dying, other)` follows supervisor subtree teardown and
// one_for_all/rest_for_one sibling restarts. A failure contained by a nested supervisor
// does not end outer siblings. Restart-intensity escalation is not modeled;
// application-wide lifetime uses application_root. See docs/design/restart-state.md.
.decl ends_with(dying: symbol, other: symbol)

ends_with(d, o) :- supervisor(d, _), child_subtree(d, _, o), o != d.

ends_with(d, o) :-
  supervisor(s, "one_for_all"),
  supervisor_child(s, _, d, _, _),
  child_subtree(s, b, o),
  b != d.

ends_with(d, o) :-
  supervisor(s, "rest_for_one"),
  supervisor_child(s, dp, d, _, _),
  supervisor_child(s, bp, b, _, _),
  bp > dp,
  child_subtree(s, b, o).

// ── Siblings ─────────────────────────────────────────────────────────
//
// Two direct children of one supervisor: the modules whose lifetimes it
// sequences together.
.decl sibling(sup: symbol, a: symbol, b: symbol)

sibling(sup, a, b) :-
  supervisor_child(sup, _, a, _, _),
  supervisor_child(sup, _, b, _, _),
  a != b.

// Supervisor management APIs. Project sup_call to exclude GenServer.stop, which is also
// recorded there under "GenServer".
.decl sup_management_call(id: symbol, func: symbol, api: symbol, op: symbol, target: symbol)

sup_management_call(id, func, api, op, target) :-
  sup_call(id, func, api, op, target),
  api != "GenServer".

// Operations that create a child in the target supervisor.
.decl child_creating_op(op: symbol)

child_creating_op("start_child").
child_creating_op("async").
child_creating_op("async_nolink").

// Walk backward from dynamic child-start functions to all callers, restricting
// traversal to code that can reach those starts.
.decl reaches_child_start(func: symbol, start: symbol) inline

reaches_child_start(f, start) :- child_start_reach.reaches(f, start).

.init child_start_reach = CallReach

child_start_reach.seed(start, start) :- dynamic_child(_, _, start).

// Supervisor stop and termination operations wait for complete shutdown. Child starts
// depend on initialization; explicit call timeouts bound the caller's wait.
.decl unbounded_sup_op(op: symbol)

unbounded_sup_op("terminate_child").
unbounded_sup_op("restart_child").
unbounded_sup_op("delete_child").
unbounded_sup_op("stop").

// Operations that stop children.
.decl stopping_sup_op(op: symbol)

stopping_sup_op("terminate_child").
stopping_sup_op("stop").
