// Potentially remote pids used by local-only BIFs. `process_remote_var` identifies distributed
// lookups, groups, and conflict resolvers; `process_probe_var` identifies local-only operations
// without a node guard.
// Follow local values, returned results, and parameter/field summaries resolved at each
// caller. Anchor helper uses at the supplying call. Unbuilt terms such as server state,
// and pid lists passed to traversal helpers, are not followed. Requires imports.dl and
// behaviours.dl.

// The call at `origin` may return a remote PID or pass one to a program function. `api`
// identifies the call; `kind` is lookup for registry/group results, or resolver for a
// name-conflict callback with holders on two nodes.
.decl remote_origin(origin: symbol, api: symbol, kind: symbol)

remote_origin(s, api, "resolver") :-
  process_remote_var(s, _, api),
  (api = ":global.register_name/3" ; api = ":global.re_register_name/3").

remote_origin(s, api, "lookup") :-
  process_remote_var(s, _, api),
  api != ":global.register_name/3",
  api != ":global.re_register_name/3".

// syn's resolve_registry_conflict/4 receives {pid, meta, time} for holders of one name
// on two nodes. The callback itself is the origin.
.decl syn_resolver(func: symbol)

syn_resolver(f) :-
  behaves_as(m, ":syn_event_handler"),
  function_def(f, m, "resolve_registry_conflict", 4, _).

remote_origin(f, "syn resolve_registry_conflict/4", "resolver") :- syn_resolver(f).

// `func`'s variable (var_kind, var) may be another node's pid, from `origin`.
.decl remote_value(func: symbol, var_kind: symbol, var: symbol, origin: symbol)

remote_value(f, "remote", s, s) :- process_remote_var(s, f, _).

// A parameter the runtime fills with one: a resolver's pids, the
// element a fun is run on (call_arg_var's `resolver` and `element` rows).
remote_value(g, "param", k, o) :- call_arg_var(_, _, g, k, via, "remote", o), via != "call".

remote_value(f, "load", l, f) :- syn_resolver(f), field_load(f, l, "{0}", "param", "2").
remote_value(f, "load", l, f) :- syn_resolver(f), field_load(f, l, "{0}", "param", "3").

// A callee's result: what the callee returns.
remote_value(f, "result", c, o) :- call_result_var(c, f, g), returns_remote(g, o).

.decl returns_remote(func: symbol, origin: symbol)

returns_remote(g, o) :- return_var(g, sk, s), remote_value(g, sk, s, o).

// A probe of a function's parameter, or of a field of it, lifted to
// every caller that forwards its own parameter there.
.decl probes_param(func: symbol, pos: symbol, site: symbol)

probes_param(g, k, id) :- process_probe_var(id, g, _, "param", k).
probes_param(f, j, id) :- call_arg_var(_, f, g, k, "call", "param", j), probes_param(g, k, id).

.decl probes_field(func: symbol, pos: symbol, field: symbol, site: symbol)

probes_field(g, k, sel, id) :- process_probe_var(id, g, _, "load", l), field_load(g, l, sel, "param", k).
probes_field(f, j, sel, id) :- call_arg_var(_, f, g, k, "call", "param", j), probes_field(g, k, sel, id).

// A possibly remote PID from origin reaches the probe at site, directly or through a
// helper. `anchor` identifies the direct probe or helper call.
.decl remote_probe(func: symbol, anchor: symbol, site: symbol, origin: symbol)

remote_probe(f, id, id, o) :- process_probe_var(id, f, _, sk, s), remote_value(f, sk, s, o).

remote_probe(f, a, id, o) :-
  call_arg_var(a, f, g, k, "call", sk, s),
  probes_param(g, k, id),
  remote_value(f, sk, s, o).

remote_probe(f, a, id, o) :-
  call_arg_var(a, f, g, k, "call", "term", t),
  probes_field(g, k, sel, id),
  field_store(f, t, sel, sk, s),
  remote_value(f, sk, s, o).
