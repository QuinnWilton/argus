// Waits that hold startup before init acknowledges its start. Shared by startup and
// blocking so each site is assigned once. This file handles RPC; global_reach.dl
// handles global operations.
// Traversal stops at init_ack or enter_loop; later work belongs to the running server.
// Included by otp.dl after calls.dl and entries.dl.

// An edge whose calls all follow the function's own init_ack, or enter a non-returning
// behaviour loop. A pre-ack enter_loop is reported separately by startup.
// Acknowledgements performed by helpers are not tracked.
.decl acked_edge(func: symbol, callee: symbol)

acked_edge(f, g) :- call_instr(f, g, id), start_acked(id, f), !unacked_call(f, g).
acked_edge(f, g) :- call_edge(f, g), match(":gen_(server|statem):enter_loop/[0-9]+", g).

.decl unacked_call(func: symbol, callee: symbol)

unacked_call(f, g) :- call_instr(f, g, id), !start_acked(id, f).

// init/1 functions that explicitly acknowledge startup before returning. Most GenServer
// init callbacks instead acknowledge through their return.
.init ack_reach = SameProcessReachSet

ack_reach.seed(f) :- acked_edge(f, _).

.decl acks_in_init(init: symbol)

acks_in_init(i) :- init_function(_, i), ack_reach.reaches(i).

// Walk forward from explicitly acknowledging init functions, excluding post-ack edges
// and side paths. Other init functions retain their full reachable phase.
.init before_ack = ForwardSameProcessReachCut

before_ack.root(i, i) :- acks_in_init(i).
before_ack.cut(f, g) :- acked_edge(f, g).
before_ack.cut(f, g) :- side_call(f, g).

// `init` is a process module's init/1. The RPC at `site` runs on its
// pre-acknowledgement stack, excluding detached work, logging and telemetry paths
// (side_call), and calls after the local acknowledgement (acked_edge).
.decl rpc_during_init(init: symbol, site: symbol)

// Walk backward from startup waits through same-process calls before acknowledgement.
// Exclude side_call and acked_edge. Each instance seeds its own sites; startup's
// own_stack uses the same walk.
.comp OwnStackBeforeAck : SameProcessReachCut {
  cut(f, g) :- side_call(f, g).
  cut(f, g) :- acked_edge(f, g).
}

.init init_rpc_reach = OwnStackBeforeAck

init_rpc_reach.seed(g, site) :- rpc_call(site, g, _, _), !start_acked(site, g).

rpc_during_init(init, site) :- init_function(_, init), init_rpc_reach.reaches(init, site).
