// OTP callback classification: initialization, handlers, termination and state setters.
// Requires imports.dl and behaviours.dl.

// Names a callback loop dispatches to. A function of this name in a
// module of a loop behaviour runs on the server's own stack.
.decl callback_name(name: symbol)

callback_name("init").
callback_name("handle_call").
callback_name("handle_cast").
callback_name("handle_info").
callback_name("handle_continue").
callback_name("handle_event").
callback_name("handle_events").
callback_name("handle_demand").
callback_name("handle_subscribe").
callback_name("handle_cancel").
callback_name("handle_params").
callback_name("handle_in").
callback_name("handle_message").
callback_name("handle_batch").
callback_name("terminate").
callback_name("mount").
callback_name("code_change").
callback_name("format_status").

// Callbacks receiving process-owned start arguments, messages, exits, or management
// requests. Excludes callbacks carrying external request data, such as LiveView events,
// channel payloads, and Broadway/GenStage messages. Used by unsafe_input.
.decl message_callback(name: symbol)

message_callback("init").
message_callback("handle_call").
message_callback("handle_cast").
message_callback("handle_info").
message_callback("handle_continue").
message_callback("terminate").
message_callback("code_change").
message_callback("format_status").

// Behaviour-specific callback names and arities avoid mistaking ordinary helpers for
// callbacks. Channel join/out run in the channel; LiveView/LiveComponent async
// callbacks run in the LiveView.
.decl behaviour_callback(behaviour: symbol, name: symbol)

behaviour_callback("Phoenix.Channel", "join").
behaviour_callback("Phoenix.Channel", "handle_out").
behaviour_callback("Phoenix.LiveView", "handle_async").
behaviour_callback("Phoenix.LiveComponent", "handle_async").

// A loop callback and its canonical behaviour. This relation matches names at any
// arity; consumers needing precision must check function_def arity. Same-name helpers
// can otherwise count as server code.
.decl otp_callback(func: symbol, mod: symbol, callback: symbol, behaviour: symbol)

otp_callback(func, mod, name, behaviour) :-
  behaves_as(mod, behaviour),
  process_behaviour(behaviour, "loop"),
  function_def(func, mod, name, _, _),
  callback_name(name).

otp_callback(func, mod, name, behaviour) :-
  behaves_as(mod, behaviour),
  process_behaviour(behaviour, "loop"),
  behaviour_callback(behaviour, name),
  function_def(func, mod, name, _, _).

// An unlisted declared behaviour is treated as a server when its module exposes
// server-shaped call, cast, or info handlers.
otp_callback(func, mod, name, behaviour) :-
  unlisted_server(mod),
  behaves_as(mod, behaviour),
  function_def(func, mod, name, _, _),
  callback_name(name).

.decl unlisted_server(mod: symbol)

unlisted_server(mod) :-
  behaves_as(mod, _),
  function_def(_, mod, h, _, _),
  (h = "handle_call" ; h = "handle_cast" ; h = "handle_info"),
  !loop_module(mod).

.decl loop_module(mod: symbol)

loop_module(mod) :- behaves_as(mod, b), process_behaviour(b, "loop").

// Process modules have a recognized process behaviour or inferred server-shaped
// handlers. Merely defining init/1, as Plug or Ecto types do, does not establish
// process ownership.
.decl process_behaviour_module(mod: symbol)

process_behaviour_module(mod) :- behaves_as(mod, b), process_behaviour(b, _).

process_behaviour_module(mod) :-
  behaves_as(mod, _),
  function_def(_, mod, h, _, _),
  (h = "handle_call" ; h = "handle_cast" ; h = "handle_info").

// init/1 of a process module — a Supervisor's included, since it runs
// inside a start sequence.
.decl init_function(mod: symbol, func: symbol)

init_function(mod, func) :-
  function_def(func, mod, "init", 1, _),
  process_behaviour_module(mod).

// Process callbacks root execution on the server's own stack. Client-only APIs run in
// callers. Consumers of statem_event_clause add gen_statem state entries separately.
.decl process_entry(mod: symbol, func: symbol)

process_entry(mod, func) :- otp_callback(func, mod, _, _).
process_entry(mod, func) :- init_function(mod, func).

process_entry(mod, func) :-
  function_def(func, mod, "terminate", 2, _),
  process_behaviour_module(mod).

// Canonical GenServer-contract call and cast handlers at their expected arities.
// Includes aliases, GenStage, and process behaviours inferred from handle_call/3.
// Shared by dependency, target, and reply rules. gen_statem uses a separate contract; a
// helper module merely defining handle_call is not a server.
.decl handle_call_function(mod: symbol, func: symbol)

handle_call_function(mod, func) :-
  function_def(func, mod, "handle_call", 3, _),
  gen_server_like(mod).

.decl handle_cast_function(mod: symbol, func: symbol)

handle_cast_function(mod, func) :-
  function_def(func, mod, "handle_cast", 2, _),
  gen_server_like(mod).

// Treat handle_call/3 in an unlisted server behaviour as following the usual
// request/reply contract.
.decl gen_server_like(mod: symbol)

gen_server_like(mod) :- behaves_as(mod, b), process_behaviour(b, "gen_server_like").
gen_server_like(mod) :- unlisted_server(mod), function_def(_, mod, "handle_call", 3, _).

// Any message handler of such a server: what runs once the server is up.
.decl handler_function(mod: symbol, func: symbol)

handler_function(mod, func) :-
  gen_server_like(mod),
  otp_callback(func, mod, name, _),
  (name = "handle_call" ; name = "handle_cast" ; name = "handle_info" ; name = "handle_continue").

// terminate/2,3 of a behaviour that calls it.
.decl terminate_callback(func: symbol, mod: symbol, behaviour: symbol)

terminate_callback(func, mod, behaviour) :-
  behaves_as(mod, behaviour),
  process_behaviour(behaviour, "terminating"),
  function_def(func, mod, "terminate", _, _).

// Callback frequency
//
// `runs_again_callback` identifies repeatable request/message callbacks.
// `start_callback` identifies init, Channel join, and LiveView mount. handle_continue
// belongs to neither list: runs.dl classifies each clause by whether startup or
// repeatable handlers schedule it.
.decl runs_again_callback(name: symbol, arity: number)

runs_again_callback("handle_info", 2).
runs_again_callback("handle_cast", 2).
runs_again_callback("handle_call", 3).
runs_again_callback("handle_in", 3).
runs_again_callback("handle_event", 3).
runs_again_callback("handle_params", 3).
runs_again_callback("handle_async", 3).
runs_again_callback("handle_demand", 2).

.decl start_callback(mod: symbol, func: symbol)

start_callback(mod, f) :- init_function(mod, f).
start_callback(mod, f) :- otp_callback(f, mod, "join", _), function_def(f, mod, "join", 3, _).
start_callback(mod, f) :- otp_callback(f, mod, "mount", _), function_def(f, mod, "mount", 3, _).

// Callbacks returning a GenServer's next state: call, cast, info, continue, and
// code_change. Applies to recognized GenServer wrappers. Unrecognized return shapes
// yield dynamic state; unlisted behaviours are excluded. Used for state gates and
// concurrency handoff.
.decl state_setter(mod: symbol, func: symbol)

state_setter(m, f) :-
  behaves_as(m, "GenServer"),
  function_def(f, m, n, a, _),
  ((n = "handle_call", a = 3) ; (n = "handle_cast", a = 2) ; (n = "handle_info", a = 2) ;
   (n = "handle_continue", a = 2) ; (n = "code_change", a = 3)).
