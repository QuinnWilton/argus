// Process kinds and mailbox handlers. Requires imports.dl, behaviours.dl and
// callbacks.dl, all included by otp.dl. Analyses that need gen_statem state-function
// entries also include process_statem.dl, which reads statem_event_clause.

// A module that runs as a process (callbacks.dl).
.decl process_module(mod: symbol)

process_module(mod) :- process_behaviour_module(mod).

// Modules implementing any behaviour contract, including processes, plugs, types and
// workers.
.decl behaviour_module(mod: symbol)

behaviour_module(mod) :- behaves_as(mod, _).

// Defines handle_info at any arity.
.decl has_handle_info(mod: symbol)

has_handle_info(mod) :- function_def(_, mod, "handle_info", _, _).

// A handle_info/2 with no catch-all: a message no clause matches is a
// FunctionClauseError, not the default log-and-continue.
.decl partial_handle_info(mod: symbol, func: symbol)

partial_handle_info(mod, func) :-
  function_def(func, mod, "handle_info", 2, _),
  !callback_total(func, "handle_info").

// Some clause of the handle_info/2 compares :EXIT: it takes some exits.
.decl takes_some_exits(handler: symbol)

takes_some_exits(h) :- callback_tag(h, "handle_info", ":EXIT").

// Server execution scopes
// `server_side`: same-module code on the server's own stack.
// `RunsInServer`: same-process code in any module, seeded by relevant functions.
// `server_caused`: same-module work caused by callbacks, including spawned closures.
// All start from process_entry. Client APIs run in their callers and are not
// automatically server code; detached monitors belong to their new process even when
// detached effects are server-caused.
.init server_reach = ForwardIntraModuleSameProcessReach

server_reach.root(mod, func) :- process_entry(mod, func).

.decl server_side(mod: symbol, func: symbol)

server_side(mod, func) :- server_reach.reaches(mod, func).

.init server_caused_reach = ForwardIntraModuleReach

server_caused_reach.root(mod, func) :- process_entry(mod, func).

.decl server_caused(mod: symbol, func: symbol)

server_caused(mod, func) :- server_caused_reach.reaches(mod, func).

// The seeded function runs on a started server's stack, in any module. Exclude logging
// and telemetry paths (side_call). Requires staged points-to facts via
// staged_processes.dl or otp.dl.
.comp RunsInServer {
  .decl seed(func: symbol)
  .decl runs(mod: symbol, func: symbol)

  .init walk = SameProcessReachCut

  walk.cut(f, g) :- side_call(f, g).
  walk.seed(f, f) :- seed(f).

  runs(m, f) :- process_entry(m, c), walk.reaches(c, f), server_process(_, m).
}

