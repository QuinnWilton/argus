// Resolve call-result origins through wrappers. `answers_call` requires every returning
// path to forward a call result, its immediate payload, or that payload rewrapped.
// Follow wrappers to external APIs; unrelated returns or deeper payloads make the
// result opaque. This proves all origins, unlike points-to's possible origins.
// Seed `answer_demand(site, func)`. Read `call_origin(site, origin, depth)` and
// `call_opaque(site)`; depth is 0 or 1, including any payload extraction by the
// consumer. Nested already_started pids are excluded.
// Requires imports.dl for `call_instr` and the Layer-2 `answers_call` relation.

// Follow only return wrappers needed by a requested call. Keep every return path,
// including paths deeper than the payload bound: they can make an answer opaque.
.decl answer_demand(site: symbol, func: symbol)
.decl wrapper_demand(func: symbol)

wrapper_demand(g) :- answer_demand(c, f), call_instr(f, g, c).
wrapper_demand(h) :- wrapper_demand(g), answers_call(g, d, _), call_instr(g, h, d).

// One of the calls outside the program (a library's, a BIF) whose
// answer `func` may hand back, `depth` payloads down, through the
// program's wrappers.
.decl wrapper_answer(func: symbol, origin: symbol, depth: number)

wrapper_answer(g, d, k) :- wrapper_demand(g), answers_call(g, d, k), !call_instr(g, _, d).

wrapper_answer(g, o, k + j) :-
  wrapper_demand(g),
  answers_call(g, d, k),
  call_instr(g, h, d),
  wrapper_answer(h, o, j),
  k + j <= 1.

// A returned call has no traceable origin because its callee has no known answer or the
// relevant payload exceeds the depth bound.
.decl answer_opaque(func: symbol)

answer_opaque(g) :-
  wrapper_demand(g), answers_call(g, d, _), call_instr(g, h, d), !answers_call(h, _, _).

answer_opaque(g) :-
  wrapper_demand(g), answers_call(g, d, _), call_instr(g, h, d), answer_opaque(h).

answer_opaque(g) :-
  wrapper_demand(g),
  answers_call(g, d, k),
  call_instr(g, h, d),
  wrapper_answer(h, _, j),
  k + j > 1.

// The call at site may return origin's result at payload depth depth. External calls
// are their own origins; project calls inherit callee origins.
.decl call_origin(site: symbol, origin: symbol, depth: number)

call_origin(c, c, 0) :- answer_demand(c, f), !call_instr(f, _, c).
call_origin(c, o, j) :- answer_demand(c, f), call_instr(f, g, c), wrapper_answer(g, o, j).

// A call whose answers are not all known: to a function of the program
// that answers nothing, or an opaque one.
.decl call_opaque(site: symbol)

call_opaque(c) :- answer_demand(c, f), call_instr(f, g, c), !answers_call(g, _, _).
call_opaque(c) :- answer_demand(c, f), call_instr(f, g, c), answer_opaque(g).
