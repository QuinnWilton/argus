// Check-then-act dependencies across functions. A check must control an act or supply
// its data; ordering alone is insufficient. Compose per-function dependence summaries
// through returned results, arguments, and loops.
// Consumers supply checks and acts with resource/key identities in key_identity
// vocabulary. Translate parameters and tuple elements at calls. Literal,
// allocation-site, and handed-in table identities cross unchanged; module-owned table
// fields cross within that module. Unresolved local/field identities do not cross.
// Captured closure arguments and unknown higher-order calls are not followed.
// `meets(f, check, act, rs, r, ks, k)` identifies a dependent pair sharing a known
// identity, or `any`, in f's terms. Pairs may first match in a caller that unifies
// distinct parameter identities.
// Requires imports.dl and the dependence, argument-value, forwarding, field, element,
// and tuple relations used below. See Christakis and Sagonas, PADL 2010.

// Derive parameter-fed arguments once for all component instances, converting parameter
// positions to the symbols used by acts_if.
.decl param_arg(h: symbol, g: symbol, q: symbol, p: symbol)

param_arg(h, g, to_string(n), p) :- call_arg_depends(h, g, n, "param", p).

// An identity a caller's arguments can rename: a parameter, or an element
// of one ("element 0" is the first).
.decl liftable(source: symbol)

liftable("param").
liftable(s) :- call_arg_element(_, _, _, _, i), s = cat("element ", to_string(i)).
liftable(s) :- call_arg_tuple(_, _, _, i, _, _), s = cat("element ", to_string(i)).

// Identities crossing calls unchanged: literals, any, unnamed allocation sites, and
// externally supplied tables. table_source maps EtsTable kinds into this vocabulary.
.decl global_identity(source: symbol)

global_identity("literal").
global_identity("any").
global_identity("new").
global_identity("handed_in").

// Module-field table identities cross same-module calls only. Ordinary map-field key
// identities are function-local and do not cross.
.decl module_identity(source: symbol)

module_identity("module field").

.comp CheckThenAct {
  .decl check(site: symbol, func: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)
  .decl act(site: symbol, func: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  // lift(f, g, s, v, s2, v2) translates callee identity (s, v) into caller identity
  // (s2, v2). Translate only identities used by g's summaries.

  .decl needs(g: symbol, s: symbol, v: symbol)

  needs(g, rs, r), needs(g, ks, k) :- returns_check(g, _, rs, r, ks, k).
  needs(g, rs, r), needs(g, ks, k) :- acts_if(g, _, _, _, rs, r, ks, k).
  needs(g, rs, r), needs(g, ks, k), needs(g, rs2, r2), needs(g, ks2, k2) :-
    deferred(g, _, _, rs, r, ks, k, rs2, r2, ks2, k2).

  .decl lift(f: symbol, g: symbol, s: symbol, v: symbol, s2: symbol, v2: symbol)

  lift(f, g, s, v, s, v) :- needs(g, s, v), global_identity(s), call_edge(f, g).

  lift(f, g, s, v, s, v) :-
    needs(g, s, v),
    module_identity(s),
    call_edge(f, g),
    function_def(f, m, _, _, _),
    function_def(g, m, _, _, _).

  lift(f, g, "param", q, "param", to_string(p)) :-
    needs(g, "param", q),
    call_arg_forward(f, g, n, p),
    q = to_string(n).

  lift(f, g, "param", q, "literal", v) :-
    needs(g, "param", q),
    call_arg(f, g, n, v),
    v != "dynamic",
    q = to_string(n).

  lift(f, g, "param", q, "field", key) :-
    needs(g, "param", q),
    call_arg_field(f, g, n, key),
    q = to_string(n).

  // An element of what the caller passes: `elem(record, 1)` handed on.
  lift(f, g, "param", q, s, to_string(p)) :-
    needs(g, "param", q),
    call_arg_element(f, g, n, p, i),
    q = to_string(n),
    s = cat("element ", to_string(i)).

  // A forwarded parameter element keeps its index; a constructed tuple element resolves
  // to the value the caller placed there.
  lift(f, g, s, q, s, to_string(p)) :-
    needs(g, s, q),
    s != "param",
    liftable(s),
    call_arg_forward(f, g, n, p),
    q = to_string(n).

  lift(f, g, s, q, s2, v2) :-
    needs(g, s, q),
    call_arg_tuple(f, g, n, i, s2, v2),
    q = to_string(n),
    s = cat("element ", to_string(i)).

  // Check carriers
  //
  // `carries` associates a value source with a check and its local resource/key
  // identity. Parameters are not carriers here; their caller determines the check and
  // meeting point.

  .decl carries(f: symbol, kind: symbol, src: symbol, c: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  carries(f, "site", c, c, rs, r, ks, k) :- check(c, f, rs, r, ks, k).

  // A helper returns the check, or something decided by or made from it.
  carries(f, "call", g, c, rs2, r2, ks2, k2) :-
    returns_check(g, c, rs, r, ks, k),
    lift(f, g, rs, r, rs2, r2),
    lift(f, g, ks, k, ks2, k2).

  // A helper is handed the check and returns something made from it.
  carries(f, "call", g, c, rs, r, ks, k) :-
    carries(f, kind, src, c, rs, r, ks, k),
    call_arg_depends(f, g, n, kind, src),
    returns_depends(g, "param", to_string(n)).

  .decl returns_check(g: symbol, c: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  returns_check(g, c, rs, r, ks, k) :-
    returns_depends(g, kind, src),
    carries(g, kind, src, c, rs, r, ks, k).

  // Reachable acts
  //
  // `acts_if` records an act in a callee's terms, optionally dependent on parameter q.
  // Derive it only below calls controlled or fed by a check carrier.

  .decl reach_needed(h: symbol)

  reach_needed(g) :- carries(f, kind, src, _, _, _, _, _), call_decided(f, g, kind, src).
  reach_needed(g) :- carries(f, kind, src, _, _, _, _, _), call_arg_depends(f, g, _, kind, src).
  reach_needed(g) :- reach_needed(h), call_edge(h, g).

  .decl acts_if(h: symbol, a: symbol, cond: symbol, q: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  acts_if(h, a, "any", "", rs, r, ks, k) :- reach_needed(h), act(a, h, rs, r, ks, k).

  acts_if(h, a, "param", q, rs, r, ks, k) :-
    reach_needed(h),
    act(a, h, rs, r, ks, k),
    site_depends(a, h, "param", q).

  // The act depends on what a helper returns from h's parameter.
  acts_if(h, a, "param", p, rs, r, ks, k) :-
    reach_needed(h),
    act(a, h, rs, r, ks, k),
    site_depends(a, h, "call", g),
    returns_depends(g, "param", to_string(n)),
    call_arg_depends(h, g, n, "param", p).

  // Everything a callee reaches, h reaches.
  acts_if(h, a, "any", "", rs2, r2, ks2, k2) :-
    reach_needed(h),
    call_edge(h, g),
    acts_if(g, a, _, _, rs, r, ks, k),
    lift(h, g, rs, r, rs2, r2),
    lift(h, g, ks, k, ks2, k2).
  // Each semi-naive version starts from its new tuples: a new act of g
  // looks up g's callers, a new lift its (h, g) edge.
  .plan 1:(3,2,1,4,5), 2:(4,2,3,1,5), 3:(5,2,3,1,4)

  // h's parameter decides the call.
  acts_if(h, a, "param", p, rs2, r2, ks2, k2) :-
    reach_needed(h),
    call_decided(h, g, "param", p),
    acts_if(g, a, _, _, rs, r, ks, k),
    lift(h, g, rs, r, rs2, r2),
    lift(h, g, ks, k, ks2, k2).
  .plan 1:(3,2,1,4,5), 2:(4,2,3,1,5), 3:(5,2,3,1,4)

  // Propagate parameter dependence from relevant callee acts, joining arguments by
  // callee and position. Self-calls cover loop iterations without scanning every
  // parameter flow.
  acts_if(h, a, "param", p, rs2, r2, ks2, k2) :-
    acts_if(g, a, "param", q, rs, r, ks, k),
    param_arg(h, g, q, p),
    reach_needed(h),
    lift(h, g, rs, r, rs2, r2),
    lift(h, g, ks, k, ks2, k2).
  .plan 1:(3,2,1,4,5), 2:(4,2,1,3,5), 3:(5,2,1,3,4)

  // Identity-source compatibility
  //
  // Compute source compatibility once over sources present in checks, acts, and lifted
  // identities. Separate relations avoid Souffle expanding repeated disjunctions into
  // many copies of the same joins.

  .decl source(s: symbol)

  source(s) :- check(_, _, s, _, _, _).
  source(s) :- check(_, _, _, _, s, _).
  source(s) :- act(_, _, s, _, _, _).
  source(s) :- act(_, _, _, _, s, _).
  source(s) :- lift(_, _, _, _, s, _).

  // Either identity is `any`: they agree whatever the values.
  .decl either_any(s: symbol, s2: symbol)

  either_any("any", s2) :- source(s2).
  either_any(s, "any") :- source(s).

  // Identities agree now or may agree after caller substitution: parameter-derived
  // identities can match each other or literals.
  .decl may_agree(s: symbol, s2: symbol)

  may_agree(s, s2) :- either_any(s, s2).
  may_agree(s, s2) :- liftable(s), liftable(s2).
  may_agree(s, "literal") :- liftable(s).
  may_agree("literal", s2) :- liftable(s2).

  // Pair meetings
  //
  // `joined` identifies a dependent check/act pair whose identities already match or
  // differ only by caller-renamable parameters.

  .decl joined(f: symbol, c: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol, rs2: symbol, r2: symbol, ks2: symbol, k2: symbol)

  joined(f, c, a, rs, r, ks, k, rs2, r2, ks2, k2) :-
    carries(f, kind, src, c, rs, r, ks, k),
    decides(f, kind, src, a, rs2, r2, ks2, k2),
    (rs = rs2, r = r2, rs != "dynamic" ; may_agree(rs, rs2)),
    (ks = ks2, k = k2, ks != "dynamic" ; may_agree(ks, ks2)).

  // Compute which value sources decide each act once, then join to the checks those
  // values carry. This avoids repeating the act traversal per check.
  .decl carrier(f: symbol, kind: symbol, src: symbol)

  carrier(f, kind, src) :- carries(f, kind, src, _, _, _, _, _).

  .decl decides(f: symbol, kind: symbol, src: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  // The act is in f.
  decides(f, kind, src, a, rs, r, ks, k) :-
    carrier(f, kind, src),
    site_depends(a, f, kind, src),
    act(a, f, rs, r, ks, k).

  // The carrier decides a call that reaches the act.
  decides(f, kind, src, a, rs2, r2, ks2, k2) :-
    carrier(f, kind, src),
    call_decided(f, g, kind, src),
    acts_if(g, a, _, _, rs, r, ks, k),
    lift(f, g, rs, r, rs2, r2),
    lift(f, g, ks, k, ks2, k2).
  .plan 1:(3,2,1,4,5), 2:(4,2,1,3,5), 3:(5,2,1,3,4)

  // The carrier is handed to a callee whose act depends on it.
  decides(f, kind, src, a, rs2, r2, ks2, k2) :-
    carrier(f, kind, src),
    call_arg_depends(f, g, n, kind, src),
    acts_if(g, a, "param", to_string(n), rs, r, ks, k),
    lift(f, g, rs, r, rs2, r2),
    lift(f, g, ks, k, ks2, k2).
  .plan 1:(3,2,1,4,5), 2:(4,2,1,3,5), 3:(5,2,1,3,4)

  // Identities agree when both are known and equal, or either is any. Use positive
  // comparisons so recursive rules need no negation.

  .decl met(f: symbol, c: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  met(f, c, a, rs, r, ks, k) :-
    joined(f, c, a, rs, r, ks, k, rs2, r2, ks2, k2),
    (rs = rs2, r = r2, rs != "dynamic" ; either_any(rs, rs2)),
    (ks = ks2, k = k2, ks != "dynamic" ; either_any(ks, ks2)).

  // Lift both identities together through callers until they agree or can no longer be
  // substituted from parameters.
  .decl deferred(f: symbol, c: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol, rs2: symbol, r2: symbol, ks2: symbol, k2: symbol)

  deferred(f, c, a, rs, r, ks, k, rs2, r2, ks2, k2) :-
    joined(f, c, a, rs, r, ks, k, rs2, r2, ks2, k2),
    (rs != rs2, rs != "any", rs2 != "any" ; r != r2, rs != "any", rs2 != "any" ;
     ks != ks2, ks != "any", ks2 != "any" ; k != k2, ks != "any", ks2 != "any").

  .decl lifted(f: symbol, c: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol, rs2: symbol, r2: symbol, ks2: symbol, k2: symbol)

  lifted(h, c, a, xs, x, ys, y, xs2, x2, ys2, y2) :-
    deferred(g, c, a, rs, r, ks, k, rs2, r2, ks2, k2),
    lift(h, g, rs, r, xs, x),
    lift(h, g, ks, k, ys, y),
    lift(h, g, rs2, r2, xs2, x2),
    lift(h, g, ks2, k2, ys2, y2).

  met(h, c, a, xs, x, ys, y) :-
    lifted(h, c, a, xs, x, ys, y, xs2, x2, ys2, y2),
    (xs = xs2, x = x2, xs != "dynamic" ; either_any(xs, xs2)),
    (ys = ys2, y = y2, ys != "dynamic" ; either_any(ys, ys2)).

  deferred(h, c, a, xs, x, ys, y, xs2, x2, ys2, y2) :-
    lifted(h, c, a, xs, x, ys, y, xs2, x2, ys2, y2),
    (xs = xs2, x = x2, xs != "dynamic" ; may_agree(xs, xs2)),
    (ys = ys2, y = y2, ys != "dynamic" ; may_agree(ys, ys2)),
    (xs != xs2, xs != "any", xs2 != "any" ; x != x2, xs != "any", xs2 != "any" ;
     ys != ys2, ys != "any", ys2 != "any" ; y != y2, ys != "any", ys2 != "any").

  // A pair may meet again in callers receiving the check result and deciding the act.
  // Prefer the meeting closest to the check. Walk one returned-call edge at a time from
  // actual meetings; self-recursion remains a local meeting.
  .decl carried_through(f: symbol, c: symbol, g: symbol)

  carried_through(f, c, g) :- met(f, c, _, _, _, _, _), carries(f, "call", g, c, _, _, _, _).
  carried_through(f, c, h) :- carried_through(f, c, g), carries(g, "call", h, c, _, _, _, _).

  .decl met_below(f: symbol, c: symbol, a: symbol)

  met_below(f, c, a) :-
    met(f, c, a, _, _, _, _),
    carried_through(f, c, g),
    g != f,
    met(g, c, a, _, _, _, _).

  .decl meets(f: symbol, c: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  meets(f, c, a, rs, r, ks, k) :- met(f, c, a, rs, r, ks, k), !met_below(f, c, a).
}

// Select one finding per write: lowest rank, then least read and meeting function.
// Later writes decided the same way by the same read in one function become related
// branches. `write_in` supplies functions; within a function, shorter unpadded
// instruction IDs sort earlier. ETS and Mnesia instantiate this component.
.comp OnePerWrite {
  // In `func`, `read` decides or feeds `write`, a race of `kind` ranked
  // `rank` (0 is the strongest).
  .decl race(func: symbol, read: symbol, write: symbol, kind: symbol, rank: number)

  // The function holding the write site.
  .decl write_in(write: symbol, func: symbol)

  .decl best_rank(write: symbol, rank: number)

  best_rank(w, n) :- race(_, _, w, _, _), n = min m : { race(_, _, w, _, m) }.

  .decl best(func: symbol, read: symbol, write: symbol, kind: symbol)

  best(f, r, w, k) :- race(f, r, w, k, n), best_rank(w, n).

  .decl outranked(func: symbol, read: symbol, write: symbol)

  outranked(f, r, w) :- best(f, r, w, _), best(_, r2, w, _), r2 < r.
  outranked(f, r, w) :- best(f, r, w, _), best(f2, r, w, _), f2 < f.

  // The pair a write is reported at.
  .decl chosen(func: symbol, read: symbol, write: symbol, kind: symbol)

  chosen(f, r, w, k) :- best(f, r, w, k), !outranked(f, r, w).

  // `write` is a later branch of the race `first` is reported for.
  .decl later_branch(write: symbol, first: symbol)

  later_branch(w2, w1) :-
    chosen(f, r, w1, k),
    chosen(f, r, w2, k),
    w1 != w2,
    write_in(w1, h),
    write_in(w2, h),
    (strlen(w1) < strlen(w2) ; strlen(w1) = strlen(w2), w1 < w2).

  // The pairs that are findings.
  .decl reported(func: symbol, read: symbol, write: symbol, kind: symbol)

  reported(f, r, w, k) :- chosen(f, r, w, k), !later_branch(w, _).

  // The later writes of a reported race, with the function it is
  // reported from: the finding's "also_writes" frames.
  .decl also_writes(first: symbol, write: symbol, func: symbol)

  also_writes(w1, w2, f) :- later_branch(w2, w1), !later_branch(w1, _), chosen(f, _, w1, _).
}

// A decision also delivering a message
//
// Count sends and peer calls/casts controlled by the read, directly or one call down.
// Both racers can trigger the receiver. Stops and kills are excluded because repeating
// them does not duplicate a request's work. Requires otp.dl; consumers supply their
// pair-specific carried values.
.decl delivers_message(func: symbol)

delivers_message(f) :- sends_message(_, f).

delivers_message(f) :-
  call_site(_, f, m, n, a),
  c = cat(m, ":", n, "/", to_string(a)),
  (peer_call(c) ; peer_cast(c)).

.comp DecisionSends {
  // A value in `func`, on the path of the pair meeting in `meet`, that
  // carries `read`.
  .decl carried(meet: symbol, func: symbol, kind: symbol, src: symbol, read: symbol)

  .decl sends(meet: symbol, read: symbol)

  sends(m, r) :- carried(m, f, kind, src, r), effect_decided(f, kind, src), delivers_message(f).

  sends(m, r) :-
    carried(m, f, kind, src, r),
    call_decided(f, g, kind, src),
    delivers_message(g).
}

// Data derived from a read
//
// `MadeOfRead` follows data through results, helper returns, and parameter forwarding.
// Helpers that map a parameter to a result by branching also count. A value merely
// computed under a test in the write's own function does not. This component accepts
// any read and caller path; consumers use PairCarries for pair-specific provenance.
.comp MadeOfRead {
  .decl read(site: symbol)
  .decl write(site: symbol, func: symbol)

  // The helper returns a value made of a read.
  .decl returns_read(func: symbol)

  returns_read(g) :- read(r), returns_reads(g, "site", r).
  returns_read(g) :- returns_reads(g, "call", g2), returns_read(g2).

  // The values the question reaches, in the function holding them.
  .decl asked(func: symbol, kind: symbol, src: symbol)

  asked(h, k, s) :- write(w, h), site_reads(w, h, k, s).

  asked(c, k, s) :-
    asked(h, "param", p),
    call_arg_reads(c, h, n, k, s),
    p = to_string(n).

  asked(h, k, s) :-
    asked(h, "call", g),
    returns_reads(g, "param", q),
    call_arg_reads(h, g, n, k, s),
    q = to_string(n).

  asked(h, k, s) :-
    asked(h, "call", g),
    maps_param(g, q),
    call_arg_reads(h, g, n, k, s),
    q = to_string(n).

  // A helper's result is derived from or selected by a parameter, directly or through
  // returning helpers. Derive summaries only for demanded helper paths.
  .decl map_needed(func: symbol)

  map_needed(g) :- asked(_, "call", g).
  map_needed(g2) :- map_needed(g), returns_depends(g, "call", g2).

  .decl maps_param(func: symbol, pos: symbol)

  maps_param(g, q) :- map_needed(g), returns_depends(g, "param", q).
  maps_param(g, q) :- map_needed(g), returns_reads(g, "param", q).

  maps_param(g, q) :-
    map_needed(g),
    returns_depends(g, "call", g2),
    call_arg_depends(g, g2, n, "param", q),
    maps_param(g2, to_string(n)).

  .decl made(func: symbol, kind: symbol, src: symbol)

  made(h, "site", r) :- asked(h, "site", r), read(r).
  made(h, "call", g) :- asked(h, "call", g), returns_read(g).

  made(h, "call", g) :-
    asked(h, "call", g),
    returns_reads(g, "param", q),
    call_arg_reads(h, g, n, k, s),
    q = to_string(n),
    made(h, k, s).

  // A helper mapping read-derived input to a selected result still transforms the read,
  // even without copying its bytes. For example, two callers mapping queued to running
  // can lose a state transition. `maps_param` includes control-selected returns;
  // `returns_reads` tracks data alone.
  made(h, "call", g) :-
    asked(h, "call", g),
    maps_param(g, q),
    call_arg_reads(h, g, n, k, s),
    q = to_string(n),
    made(h, k, s).

  made(h, "param", p) :-
    asked(h, "param", p),
    call_arg_reads(c, h, n, k, s),
    p = to_string(n),
    made(c, k, s).

  .decl stores(write: symbol)

  stores(w) :- write(w, h), site_reads(w, h, k, s), made(h, k, s).
}

// Data from this pair's read
//
// `PairCarries` restricts provenance to the pair's read and the path from its meeting
// function to its write. Follow direct results, returning/mapping helpers, and
// forwarded parameters. The same accessor may write read-derived data for one caller
// and a constant for another. Mere control dependence in the writing function is
// insufficient.
.comp PairCarries {
  // In `func`, `read` decides or feeds `write` (a pair meets there).
  .decl pair(func: symbol, read: symbol, write: symbol)
  // The function each read and each write sits in.
  .decl read_in(read: symbol, func: symbol)
  .decl write_in(write: symbol, func: symbol)

  // A helper returns what the read found, or a value made of it.
  .decl returns_read(func: symbol, read: symbol)

  returns_read(g, r) :- pair(_, r, _), read_in(r, g), returns_reads(g, "site", r).
  returns_read(g, r) :- returns_read(k, r), returns_reads(g, "call", k).

  // In the meeting function, the value (kind, src) is made of the read.
  .decl value(func: symbol, kind: symbol, src: symbol, read: symbol)

  value(f, "site", r, r) :- pair(f, r, _), read_in(r, f).
  value(f, "call", g, r) :- pair(f, r, _), call_edge(f, g), returns_read(g, r).

  value(f, "call", g, r) :-
    value(f, kind, src, r),
    call_arg_reads(f, g, n, kind, src),
    returns_reads(g, "param", to_string(n)).

  value(f, "call", g, r) :-
    value(f, kind, src, r),
    call_arg_reads(f, g, n, kind, src),
    maps_param(g, to_string(n)).

  // A helper's result depends on a parameter through value construction or control
  // flow, directly or through further helpers.
  .decl map_needed(func: symbol)

  map_needed(g) :- value(f, kind, src, _), call_arg_reads(f, g, _, kind, src).
  map_needed(g) :- pair(_, _, w), write_in(w, h), site_reads(w, h, "call", g).
  map_needed(g2) :- map_needed(g), returns_depends(g, "call", g2).

  .decl maps_param(func: symbol, pos: symbol)

  maps_param(g, q) :- map_needed(g), returns_depends(g, "param", q).

  maps_param(g, q) :-
    map_needed(g),
    returns_depends(g, "call", g2),
    call_arg_depends(g, g2, n, "param", q),
    maps_param(g2, to_string(n)).

  // Track a read-derived value from the meeting function through forwarded parameters
  // down to the write.
  .decl path_param(meet: symbol, read: symbol, func: symbol, pos: symbol)

  path_param(f, r, g, to_string(n)) :- value(f, kind, src, r), call_arg_reads(f, g, n, kind, src).

  path_param(f, r, h, to_string(n)) :-
    path_param(f, r, g, p),
    call_arg_reads(g, h, n, "param", p).

  // The write stores the paired read's result or a derived value. Preserve the caller
  // context so unrelated accessor invocations do not share reads.
  .decl carries(func: symbol, read: symbol, write: symbol)

  carries(f, r, w) :-
    pair(f, r, w),
    write_in(w, f),
    site_reads(w, f, kind, src),
    value(f, kind, src, r).

  // Read-derived parameters reaching the write, including forwarding helpers and loop
  // parameters passed to the next iteration.
  carries(f, r, w) :-
    pair(f, r, w),
    write_in(w, h),
    site_reads(w, h, "param", p),
    path_param(f, r, h, p).

  carries(f, r, w) :-
    pair(f, r, w),
    write_in(w, h),
    site_reads(w, h, "call", g),
    call_arg_reads(h, g, n, "param", p),
    path_param(f, r, h, p),
    returns_reads(g, "param", to_string(n)).

  carries(f, r, w) :-
    pair(f, r, w),
    write_in(w, h),
    site_reads(w, h, "call", g),
    call_arg_reads(h, g, n, "param", p),
    path_param(f, r, h, p),
    maps_param(g, to_string(n)).

  // Where the pairs meet, a value made of their read.
  .decl answers(func: symbol, read: symbol)

  answers(f, r) :- pair(f, r, _), value(f, kind, src, r), returns_reads(f, kind, src).

  // A pair's write stores a fresh call result or other-store read, computed at the
  // meeting function, in a helper, or forwarded down to the write.
  .decl fresh(kind: symbol, src: symbol)

  .decl fresh_param(meet: symbol, func: symbol, pos: symbol, kind: symbol, src: symbol)

  fresh_param(f, g, to_string(n), kind, src) :-
    pair(f, _, _),
    call_arg_reads(f, g, n, kind, src),
    fresh(kind, src).

  fresh_param(f, h, to_string(n), kind, src) :-
    fresh_param(f, g, p, kind, src),
    call_arg_reads(g, h, n, "param", p).

  // fresh_used(f, r, w, kind, src): the fresh value (kind, src) is what
  // the write stores, on the path of the pair meeting in `func`.
  .decl fresh_used(func: symbol, read: symbol, write: symbol, kind: symbol, src: symbol)

  fresh_used(f, r, w, kind, src) :-
    pair(f, r, w),
    write_in(w, h),
    site_reads(w, h, kind, src),
    fresh(kind, src).

  fresh_used(f, r, w, kind, src) :-
    pair(f, r, w),
    write_in(w, h),
    h != f,
    site_reads(w, h, "param", p),
    fresh_param(f, h, p, kind, src).

  .decl fills(func: symbol, read: symbol, write: symbol)

  fills(f, r, w) :- fresh_used(f, r, w, _, _).
}
