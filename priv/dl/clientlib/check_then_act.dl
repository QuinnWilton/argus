// Check, then act — across functions.
//
// A check-then-act race is a read of shared state (a registered name, an
// ETS row, a Mnesia record) whose result decides, or is written back by, a
// later write of the same thing, with nothing holding it between the two
// (Christakis and Sagonas, PADL 2010). The read and the write need not
// share a function. The read may sit in a helper that returns it
// (`defp lookup(n), do: Process.whereis(n)`), the write in a helper the
// decision calls (`nil -> start(name)`), and the result may travel as an
// argument: into a multi-clause helper that dispatches on it, or into the
// next iteration of a loop, where it decides the write. The paper finds
// these by walking every path from the read; this composes per-function
// summaries (Argus.Extractors.Dependence) instead. Where the check's result
// is born, or is returned to, it MEETS the acts that depend on it.
//
// Unlike the paper, an act only counts if it depends on the check — runs
// because of a test on its result, or is handed a value made from it. A
// write that merely follows a read (a lookup for a log line, then an
// unrelated insert) is not the shape.
//
// A family instantiates the component with its checks and acts, each
// naming what it touches in its own function's terms: a resource (the
// registry, the table) and a key, each a source-value pair in the
// vocabulary of Argus.Extractor.Identity.key_identity/3 (literal,
// param, "element N" of a parameter, field, local, dynamic) plus `any`,
// which agrees with everything: Process.registered/0 reads every name,
// and start_child hides its name in the child spec. Across a call, a parameter becomes
// whatever the caller passes there (call_arg, call_arg_forward,
// call_arg_field, call_arg_element), and an element of one the same
// element of what the caller passes (call_arg_forward, call_arg_tuple).
// A literal, a named ETS table and the :ets.new/2 site of an unnamed one
// cross unchanged (global_identity), and a table a module keeps under a
// field of its own crosses within the module (module_identity). A key
// read from a map field, a local or a dynamic value does not cross, and
// the pair goes quiet rather than guess.
//
// Calls through a closure's captured variables are not followed: CallArgs
// says nothing about a make_fun3 environment. An unknown higher-order call
// (`Fun(M)` on a parameter) is not followed either, which is the paper's
// own evaluated setting — sound for defect detection, no false alarms from
// guessing what Fun is.
//
// Output: meets(f, check, act, rs, r, ks, k) — in f, the check's result
// decides or feeds the act, directly or through the calls f makes, and
// both touch (rs, r, ks, k), the check's resource and key in f's terms.
// Two identities agree when they are equal and known, or either is any.
// A check and an act whose identities differ only in how f's parameters
// name them — dirty_read({type, key}) and dirty_write(record) in a helper
// its caller hands elem(record, 0), elem(record, 1) and record — meet in
// the first caller where both name the same thing.
//
// Requires imports.dl (call_edge) and the relations site_depends,
// call_decided, call_arg_depends, returns_depends, call_arg,
// call_arg_forward, call_arg_field, call_arg_element and call_arg_tuple.

// Every parameter-fed argument, with the callee's parameter as the
// symbol acts_if names it by. It is the same relation for every
// instance, and tens of thousands of rows on a large program, so it is
// derived once here rather than once per instance.
.decl param_arg(h: symbol, g: symbol, q: symbol, p: symbol)

param_arg(h, g, to_string(n), p) :- call_arg_depends(h, g, n, "param", p).

// An identity a caller's arguments can rename: a parameter, or an element
// of one ("element 0" is the first).
.decl liftable(source: symbol)

liftable("param").
liftable(s) :- call_arg_element(_, _, _, _, i), s = cat("element ", to_string(i)).
liftable(s) :- call_arg_tuple(_, _, _, i, _, _), s = cat("element ", to_string(i)).

// An identity that names the same thing wherever it is spelled, and so
// crosses every call unchanged: a literal, `any`, a named ETS table
// ("named" and its name) or the :ets.new/2 site that made an unnamed one
// ("new" and the site).
.decl global_identity(source: symbol)

global_identity("literal").
global_identity("any").
global_identity("named").
global_identity("new").

// One that names the same thing throughout its module and nowhere else:
// a table a module keeps under a map field of its own ("module field"
// and the module and path; clientlib/tables.dl's "field" table). It
// crosses a call within the module. A key read from a map field
// ("field") does not: the map is the function's own.
.decl module_identity(source: symbol)

module_identity("module field").

.comp CheckThenAct {
  .decl check(site: symbol, func: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)
  .decl act(site: symbol, func: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  // ── An identity seen from a caller ────────────────────────────────
  //
  // lift(f, g, s, v, s2, v2): what g calls (s, v), f calls (s2, v2) at
  // its calls to g. Only identities some summary of g holds are lifted.

  .decl needs(g: symbol, s: symbol, v: symbol)

  needs(g, rs, r), needs(g, ks, k) :- returns_check(g, _, rs, r, ks, k).
  needs(g, rs, r), needs(g, ks, k) :- acts_if(g, _, _, _, rs, r, ks, k).
  needs(g, rs, r), needs(g, ks, k), needs(g, rs2, r2), needs(g, ks2, k2) :-
    deferred(g, _, _, rs, r, ks, k, rs2, r2, ks2, k2).

  .decl lift(f: symbol, g: symbol, s: symbol, v: symbol, s2: symbol, v2: symbol)

  lift(f, g, s, v, s, v) :- needs(g, s, v), global_identity(s), call_edge(f, g).

  lift(f, g, s, v, s, v) :-
    needs(g, s, v),
    module_identity(s),
    call_edge(f, g),
    function_def(f, m, _, _, _),
    function_def(g, m, _, _, _).

  lift(f, g, "param", q, "param", to_string(p)) :-
    needs(g, "param", q),
    call_arg_forward(f, g, n, p),
    q = to_string(n).

  lift(f, g, "param", q, "literal", v) :-
    needs(g, "param", q),
    call_arg(f, g, n, v),
    v != "dynamic",
    q = to_string(n).

  lift(f, g, "param", q, "field", key) :-
    needs(g, "param", q),
    call_arg_field(f, g, n, key),
    q = to_string(n).

  // An element of what the caller passes: `elem(record, 1)` handed on.
  lift(f, g, "param", q, s, to_string(p)) :-
    needs(g, "param", q),
    call_arg_element(f, g, n, p, i),
    q = to_string(n),
    s = cat("element ", to_string(i)).

  // An element of a parameter the caller forwards is the same element of
  // the caller's; of a tuple the caller builds, whatever it put there.
  lift(f, g, s, q, s, to_string(p)) :-
    needs(g, s, q),
    s != "param",
    liftable(s),
    call_arg_forward(f, g, n, p),
    q = to_string(n).

  lift(f, g, s, q, s2, v2) :-
    needs(g, s, q),
    call_arg_tuple(f, g, n, i, s2, v2),
    q = to_string(n),
    s = cat("element ", to_string(i)).

  // ── Values that carry a check ─────────────────────────────────────
  //
  // carries(f, kind, src, c, ...): in f, the value named (kind, src) in
  // the dependence relations carries check c, whose resource and key in
  // f's terms follow. A parameter is never a carrier here: which check it
  // holds depends on the caller, and the caller is where the pair meets.

  .decl carries(f: symbol, kind: symbol, src: symbol, c: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  carries(f, "site", c, c, rs, r, ks, k) :- check(c, f, rs, r, ks, k).

  // A helper returns the check, or something decided by or made from it.
  carries(f, "call", g, c, rs2, r2, ks2, k2) :-
    returns_check(g, c, rs, r, ks, k),
    lift(f, g, rs, r, rs2, r2),
    lift(f, g, ks, k, ks2, k2).

  // A helper is handed the check and returns something made from it.
  carries(f, "call", g, c, rs, r, ks, k) :-
    carries(f, kind, src, c, rs, r, ks, k),
    call_arg_depends(f, g, n, kind, src),
    returns_depends(g, "param", to_string(n)).

  .decl returns_check(g: symbol, c: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  returns_check(g, c, rs, r, ks, k) :-
    returns_depends(g, kind, src),
    carries(g, kind, src, c, rs, r, ks, k).

  // ── Acts a function reaches ───────────────────────────────────────
  //
  // acts_if(h, a, cond, q, ...): calling h may perform act a, whose
  // resource and key in h's terms follow. cond "param" says a also
  // depends on h's parameter q; "any" (q empty) says only that h reaches
  // it. Derived only below a call some carrier decides or feeds.

  .decl reach_needed(h: symbol)

  reach_needed(g) :- carries(f, kind, src, _, _, _, _, _), call_decided(f, g, kind, src).
  reach_needed(g) :- carries(f, kind, src, _, _, _, _, _), call_arg_depends(f, g, _, kind, src).
  reach_needed(g) :- reach_needed(h), call_edge(h, g).

  .decl acts_if(h: symbol, a: symbol, cond: symbol, q: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  acts_if(h, a, "any", "", rs, r, ks, k) :- reach_needed(h), act(a, h, rs, r, ks, k).

  acts_if(h, a, "param", q, rs, r, ks, k) :-
    reach_needed(h),
    act(a, h, rs, r, ks, k),
    site_depends(a, h, "param", q).

  // The act depends on what a helper returns from h's parameter.
  acts_if(h, a, "param", p, rs, r, ks, k) :-
    reach_needed(h),
    act(a, h, rs, r, ks, k),
    site_depends(a, h, "call", g),
    returns_depends(g, "param", to_string(n)),
    call_arg_depends(h, g, n, "param", p).

  // Everything a callee reaches, h reaches.
  acts_if(h, a, "any", "", rs2, r2, ks2, k2) :-
    reach_needed(h),
    call_edge(h, g),
    acts_if(g, a, _, _, rs, r, ks, k),
    lift(h, g, rs, r, rs2, r2),
    lift(h, g, ks, k, ks2, k2).
  // Each semi-naive version starts from its new tuples: a new act of g
  // looks up g's callers, a new lift its (h, g) edge.
  .plan 1:(3,2,1,4,5), 2:(4,2,3,1,5), 3:(5,2,3,1,4)

  // h's parameter decides the call.
  acts_if(h, a, "param", p, rs2, r2, ks2, k2) :-
    reach_needed(h),
    call_decided(h, g, "param", p),
    acts_if(g, a, _, _, rs, r, ks, k),
    lift(h, g, rs, r, rs2, r2),
    lift(h, g, ks, k, ks2, k2).
  .plan 1:(3,2,1,4,5), 2:(4,2,3,1,5), 3:(5,2,3,1,4)

  // h's parameter feeds the argument the act depends on — the loop, when
  // g is h itself. Driven from the acts the callee has, joined to the
  // callers' arguments on (callee, position): every parameter-fed
  // argument of every function is far more rows than acts to meet.
  acts_if(h, a, "param", p, rs2, r2, ks2, k2) :-
    acts_if(g, a, "param", q, rs, r, ks, k),
    param_arg(h, g, q, p),
    reach_needed(h),
    lift(h, g, rs, r, rs2, r2),
    lift(h, g, ks, k, ks2, k2).
  .plan 1:(3,2,1,4,5), 2:(4,2,1,3,5), 3:(5,2,1,3,4)

  // ── How two sources relate ────────────────────────────────────────
  //
  // Whether two identities can meet is mostly a question about their
  // sources, not their values: either is `any`, or both are names a
  // caller may rename. It is asked of the sources in play, as relations,
  // rather than spelled out as a disjunction in each rule that asks:
  // Souffle turns a rule with k alternatives into k rules, each with the
  // whole body. Spelled out, the two identities' conditions made 36
  // copies of each joined rule and 144 of deferred's, which was most of
  // the clauses Souffle compiled for the four instances (three seconds
  // before it read a fact) and, run once per alternative, most of the
  // solve.
  //
  // Every source a rule compares comes from a check, an act or a lift,
  // so `source` holds them all.

  .decl source(s: symbol)

  source(s) :- check(_, _, s, _, _, _).
  source(s) :- check(_, _, _, _, s, _).
  source(s) :- act(_, _, s, _, _, _).
  source(s) :- act(_, _, _, _, s, _).
  source(s) :- lift(_, _, _, _, s, _).

  // Either identity is `any`: they agree whatever the values.
  .decl either_any(s: symbol, s2: symbol)

  either_any("any", s2) :- source(s2).
  either_any(s, "any") :- source(s).

  // They agree, or differ only in names a caller may rename: both are
  // parameters' (or elements of them), or one is and the other a literal.
  .decl may_agree(s: symbol, s2: symbol)

  may_agree(s, s2) :- either_any(s, s2).
  may_agree(s, s2) :- liftable(s), liftable(s2).
  may_agree(s, "literal") :- liftable(s).
  may_agree("literal", s2) :- liftable(s2).

  // ── Where they meet ───────────────────────────────────────────────
  //
  // joined(f, c, a, check's identities, act's identities): in f the
  // check's result decides or feeds the act, and the two either agree on
  // what they touch or differ only in parameters a caller may rename.

  .decl joined(f: symbol, c: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol, rs2: symbol, r2: symbol, ks2: symbol, k2: symbol)

  joined(f, c, a, rs, r, ks, k, rs2, r2, ks2, k2) :-
    carries(f, kind, src, c, rs, r, ks, k),
    decides(f, kind, src, a, rs2, r2, ks2, k2),
    (rs = rs2, r = r2, rs != "dynamic" ; may_agree(rs, rs2)),
    (ks = ks2, k = k2, ks != "dynamic" ; may_agree(ks, ks2)).

  // decides(f, kind, src, a, ...): in f, the value (kind, src) decides
  // or feeds act a, whose resource and key in f's terms follow. Asked
  // only of the values that carry a check, and once for all the checks
  // a value carries: joined with carries in the rule above instead, the
  // walk to the act was repeated per check it carried.
  .decl carrier(f: symbol, kind: symbol, src: symbol)

  carrier(f, kind, src) :- carries(f, kind, src, _, _, _, _, _).

  .decl decides(f: symbol, kind: symbol, src: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  // The act is in f.
  decides(f, kind, src, a, rs, r, ks, k) :-
    carrier(f, kind, src),
    site_depends(a, f, kind, src),
    act(a, f, rs, r, ks, k).

  // The carrier decides a call that reaches the act.
  decides(f, kind, src, a, rs2, r2, ks2, k2) :-
    carrier(f, kind, src),
    call_decided(f, g, kind, src),
    acts_if(g, a, _, _, rs, r, ks, k),
    lift(f, g, rs, r, rs2, r2),
    lift(f, g, ks, k, ks2, k2).
  .plan 1:(3,2,1,4,5), 2:(4,2,1,3,5), 3:(5,2,1,3,4)

  // The carrier is handed to a callee whose act depends on it.
  decides(f, kind, src, a, rs2, r2, ks2, k2) :-
    carrier(f, kind, src),
    call_arg_depends(f, g, n, kind, src),
    acts_if(g, a, "param", to_string(n), rs, r, ks, k),
    lift(f, g, rs, r, rs2, r2),
    lift(f, g, ks, k, ks2, k2).
  .plan 1:(3,2,1,4,5), 2:(4,2,1,3,5), 3:(5,2,1,3,4)

  // Two identities agree when they are equal and known, or either is
  // any; they disagree otherwise. Spelled as comparisons and positive
  // atoms, so the recursion below needs no negation.

  .decl met(f: symbol, c: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  met(f, c, a, rs, r, ks, k) :-
    joined(f, c, a, rs, r, ks, k, rs2, r2, ks2, k2),
    (rs = rs2, r = r2, rs != "dynamic" ; either_any(rs, rs2)),
    (ks = ks2, k = k2, ks != "dynamic" ; either_any(ks, ks2)).

  // A pair that agrees only once f's parameters are named: carried up to
  // each caller, renaming both sides at once, until the two agree (they
  // meet there) or a side stops being a parameter's.
  .decl deferred(f: symbol, c: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol, rs2: symbol, r2: symbol, ks2: symbol, k2: symbol)

  deferred(f, c, a, rs, r, ks, k, rs2, r2, ks2, k2) :-
    joined(f, c, a, rs, r, ks, k, rs2, r2, ks2, k2),
    (rs != rs2, rs != "any", rs2 != "any" ; r != r2, rs != "any", rs2 != "any" ;
     ks != ks2, ks != "any", ks2 != "any" ; k != k2, ks != "any", ks2 != "any").

  .decl lifted(f: symbol, c: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol, rs2: symbol, r2: symbol, ks2: symbol, k2: symbol)

  lifted(h, c, a, xs, x, ys, y, xs2, x2, ys2, y2) :-
    deferred(g, c, a, rs, r, ks, k, rs2, r2, ks2, k2),
    lift(h, g, rs, r, xs, x),
    lift(h, g, ks, k, ys, y),
    lift(h, g, rs2, r2, xs2, x2),
    lift(h, g, ks2, k2, ys2, y2).

  met(h, c, a, xs, x, ys, y) :-
    lifted(h, c, a, xs, x, ys, y, xs2, x2, ys2, y2),
    (xs = xs2, x = x2, xs != "dynamic" ; either_any(xs, xs2)),
    (ys = ys2, y = y2, ys != "dynamic" ; either_any(ys, ys2)).

  deferred(h, c, a, xs, x, ys, y, xs2, x2, ys2, y2) :-
    lifted(h, c, a, xs, x, ys, y, xs2, x2, ys2, y2),
    (xs = xs2, x = x2, xs != "dynamic" ; may_agree(xs, xs2)),
    (ys = ys2, y = y2, ys != "dynamic" ; may_agree(ys, ys2)),
    (xs != xs2, xs != "any", xs2 != "any" ; x != x2, xs != "any", xs2 != "any" ;
     ys != ys2, ys != "any", ys2 != "any" ; y != y2, ys != "any", ys2 != "any").

  // A pair that meets in a helper meets again in every caller the helper
  // returns the check to and that reaches the act under a decision of its
  // own. It is one race: reported where it meets closest to the check.
  // A recursive function carries its own check back to itself; that is
  // the loop meeting where it is, not a meeting below it.
  // Asked only from where a pair meets, and walked one returning call at
  // a time: the same closure as joining it with itself, from the sources
  // met_below reads.
  .decl carried_through(f: symbol, c: symbol, g: symbol)

  carried_through(f, c, g) :- met(f, c, _, _, _, _, _), carries(f, "call", g, c, _, _, _, _).
  carried_through(f, c, h) :- carried_through(f, c, g), carries(g, "call", h, c, _, _, _, _).

  .decl met_below(f: symbol, c: symbol, a: symbol)

  met_below(f, c, a) :-
    met(f, c, a, _, _, _, _),
    carried_through(f, c, g),
    g != f,
    met(g, c, a, _, _, _, _).

  .decl meets(f: symbol, c: symbol, a: symbol, rs: symbol, r: symbol, ks: symbol, k: symbol)

  meets(f, c, a, rs, r, ks, k) :- met(f, c, a, rs, r, ks, k), !met_below(f, c, a).
}

// One finding per write.
//
// A write can be the act of several pairs: several reads decide it, or
// feed it, and it meets them in more than one function. It is one race,
// reported once: of the pairs a write is in, the strongest (the least
// `rank`), then the least read, then the least function where they meet.
// The others are the finding's frames. A write the same read decides in
// the same way in the same function, later than another (`write_in`
// names the function holding each; an index has no leading zeros, so a
// shorter ID in one function is an earlier one), is the same race's other
// branch — `[] -> insert; [r] -> write r + 1` of one counter, or add/2's
// three set/2 calls — and a frame of the first. The ETS and the Mnesia
// read-then-write rules each instantiate it, the ETS one with every pair
// ranked alike.
.comp OnePerWrite {
  // In `func`, `read` decides or feeds `write`, a race of `kind` ranked
  // `rank` (0 is the strongest).
  .decl race(func: symbol, read: symbol, write: symbol, kind: symbol, rank: number)

  // The function holding the write site.
  .decl write_in(write: symbol, func: symbol)

  .decl best_rank(write: symbol, rank: number)

  best_rank(w, n) :- race(_, _, w, _, _), n = min m : { race(_, _, w, _, m) }.

  .decl best(func: symbol, read: symbol, write: symbol, kind: symbol)

  best(f, r, w, k) :- race(f, r, w, k, n), best_rank(w, n).

  .decl outranked(func: symbol, read: symbol, write: symbol)

  outranked(f, r, w) :- best(f, r, w, _), best(_, r2, w, _), r2 < r.
  outranked(f, r, w) :- best(f, r, w, _), best(f2, r, w, _), f2 < f.

  // The pair a write is reported at.
  .decl chosen(func: symbol, read: symbol, write: symbol, kind: symbol)

  chosen(f, r, w, k) :- best(f, r, w, k), !outranked(f, r, w).

  // `write` is a later branch of the race `first` is reported for.
  .decl later_branch(write: symbol, first: symbol)

  later_branch(w2, w1) :-
    chosen(f, r, w1, k),
    chosen(f, r, w2, k),
    w1 != w2,
    write_in(w1, h),
    write_in(w2, h),
    (strlen(w1) < strlen(w2) ; strlen(w1) = strlen(w2), w1 < w2).

  // The pairs that are findings.
  .decl reported(func: symbol, read: symbol, write: symbol, kind: symbol)

  reported(f, r, w, k) :- chosen(f, r, w, k), !later_branch(w, _).

  // The later writes of a reported race, with the function it is
  // reported from: the finding's "also_writes" frames.
  .decl also_writes(first: symbol, write: symbol, func: symbol)

  also_writes(w1, w2, f) :- later_branch(w2, w1), !later_branch(w1, _), chosen(f, _, w1, _).
}

// ── Made of a read ───────────────────────────────────────────────────
//
// Whether a write stores what a read returned, or a value made of it, by
// data alone (Argus.Extractors.Dependence's site_reads, call_arg_reads,
// returns_reads): a value computed under a test on the read, but not
// from it, is not made of it (returns_depends and call_arg_depends, which
// count a decision too, are CheckThenAct's carriers, not this). The
// instance names the reads and the writes it asks about. A write stores a
// read's value when, in the write's own function, what it writes is made
// of:
//
// - the read's own result;
// - a call's result, where the callee returns a read's result or a value
//   made of one, however many helpers down (`set(next())`, next/0
//   returning `count() + 1`), or returns what it is handed and is handed
//   one (`insert({k, next(n)})`);
// - a parameter some caller fills with such a value, through any chain of
//   callers.
//
// Any read and any caller: which read, and which path, is the pair's own
// question (mnesia's record_pair_carries_read). The ETS and the Mnesia
// read-then-write rules each instantiate it, over their own stores.
.comp MadeOfRead {
  .decl read(site: symbol)
  .decl write(site: symbol, func: symbol)

  // The helper returns a value made of a read.
  .decl returns_read(func: symbol)

  returns_read(g) :- read(r), returns_reads(g, "site", r).
  returns_read(g) :- returns_reads(g, "call", g2), returns_read(g2).

  // The values the question reaches, in the function holding them.
  .decl asked(func: symbol, kind: symbol, src: symbol)

  asked(h, k, s) :- write(w, h), site_reads(w, h, k, s).

  asked(c, k, s) :-
    asked(h, "param", p),
    call_arg_reads(c, h, n, k, s),
    p = to_string(n).

  asked(h, k, s) :-
    asked(h, "call", g),
    returns_reads(g, "param", q),
    call_arg_reads(h, g, n, k, s),
    q = to_string(n).

  .decl made(func: symbol, kind: symbol, src: symbol)

  made(h, "site", r) :- asked(h, "site", r), read(r).
  made(h, "call", g) :- asked(h, "call", g), returns_read(g).

  made(h, "call", g) :-
    asked(h, "call", g),
    returns_reads(g, "param", q),
    call_arg_reads(h, g, n, k, s),
    q = to_string(n),
    made(h, k, s).

  made(h, "param", p) :-
    asked(h, "param", p),
    call_arg_reads(c, h, n, k, s),
    p = to_string(n),
    made(c, k, s).

  .decl stores(write: symbol)

  stores(w) :- write(w, h), site_reads(w, h, k, s), made(h, k, s).
}
