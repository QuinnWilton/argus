// Closure ownership through nested construction. `enclosing_function` follows the full
// owner chain and includes each function as its own owner. Used to associate nested
// task or exception work with its enclosing function. Requires imports.dl.

.decl enclosing_function(func: symbol, owner: symbol)

enclosing_function(f, f) :- function_def(f, _, _, _, _).
enclosing_function(f, owner) :- closure_def(owner, f).
enclosing_function(f, owner) :- closure_def(mid, f), enclosing_function(mid, owner), mid != owner.

// The one closure a function builds: with exactly one there is nothing
// to confuse it with.
.decl sole_closure(func: symbol, closure: symbol)

sole_closure(func, closure) :-
  closure_def(func, closure),
  closure_count(func, 1).

// Use the closure passed at the call site. If none is identified and the function
// builds exactly one closure, use it as a fallback for untracked term/variable
// forwarding.
.decl handed_closure(site: symbol, func: symbol, closure: symbol)

handed_closure(site, f, c) :- fun_handed(site, f, c, _), closure_def(f, c).

handed_closure(site, f, c) :-
  call_site(site, f, _, _, _),
  !fun_handed(site, f, _, _),
  sole_closure(f, c).
