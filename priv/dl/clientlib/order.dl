// Site ordering within one function iteration. `runs_after(before, after)` means some
// control-flow path connects the sites; it does not prove the later site always
// executes.
// Seed `asked` with calls or receives. Targets may also be branches. BIFs, fun/apply
// calls, and sends lack ordered-site facts; supporting them requires pipeline changes.
// Order helper work by its call site, including the receiving call for a closure.
// Exclude loop back edges. Try-handler edges originate at the try, not each protected
// instruction. No post-dominance is computed.
// Instantiate RunsAfter, add asked(before), and read runs_after(before, after).
// Traversal starts only from requested blocks. Component declarations stay indented for
// dl_declarations_test and add no inputs.

.comp RunsAfter {
  .decl asked(before: symbol)
  .decl runs_after(before: symbol, after: symbol)

  // The blocks holding an asked instruction, and what their flow reaches.
  .decl asked_block(block: symbol)
  .decl flows_to(from: symbol, to: symbol)

  asked_block(b) :- asked(a), site_block(a, _, b, _).

  flows_to(b, c) :- asked_block(b), block_flow(b, c).
  flows_to(b, d) :- flows_to(b, c), block_flow(c, d).

  runs_after(a, z) :-
    asked(a),
    site_block(a, _, b, i),
    site_block(z, _, b, j),
    i < j.

  runs_after(a, z) :-
    asked(a),
    site_block(a, _, b, _),
    flows_to(b, c),
    site_block(z, _, c, _).
}
