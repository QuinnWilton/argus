// What each process entry waits on.
//
// init/1, the request handlers and handle_continue each wait on other
// processes; the rules about startup order, call chains and continue
// deadlocks ask about one entry at a time. One relation per entry
// rather than one with a phase column: Souffle prunes a relation no
// output reads, but not a rule, so a shared relation would make every
// analysis read every entry's facts.
//
// Requires otp.dl (callbacks.dl, calls.dl and init_phase.dl in
// particular).

// init/1 reaches a synchronous dependency ("call") on another process
// before it acknowledges its start (init_phase.dl): what holds the
// start. An init/1 that acks and then calls runs that call as the
// server. No `mod != to` filter: an init that calls its own module is
// the caller's to judge.
.decl init_dep(mod: symbol, to_mod: symbol, kind: symbol, witness: symbol)

init_dep(mod, to, "call", f) :- init_function(mod, f), !acks_in_init(f), reaches_sync_dep(f, to).

// An init/1 that acks: its own calls before the ack (by site: a
// function's dependencies are not), and what the helpers it calls before
// the ack wait on.
init_dep(mod, to, "call", f) :-
  init_function(mod, f),
  acks_in_init(f),
  sync_site(f, to, id),
  !start_acked(id, f).

init_dep(mod, to, "call", f) :-
  init_function(mod, f),
  acks_in_init(f),
  before_ack.reaches(f, g),
  g != f,
  sync_dep(g, to).

// ── The startup window ───────────────────────────────────────────────
//
// What holds the start ends at the ack; the startup window does not.
// Until the supervisor has started every child after this one, a call or
// a cast to one of them lands on a name nobody holds: a cast is dropped
// without an error, a call exits :noproc. init/1 runs in that window on
// its own stack, before its ack and after it (the supervisor moves on
// the moment it acks, as it does when a handle_continue runs), and so
// does whatever init/1 starts: a task or a spawn runs at once, while the
// supervisor goes on to the later siblings — a race nearly every boot
// loses, and every boot when init/1 awaits the task. The window is
// init/1's whole reach over the call graph, what runs elsewhere
// included, less the logging and telemetry APIs (side_call, calls.dl).
//
// init_window_dep(mod, to, kind, witness): init/1 reaches a one-way
// dependency ("cast"), or a synchronous one that does not hold its start
// ("window_call": after the ack, or in what it starts) — the start-order
// rule's warning, where "call" (init_dep) is its deadlock.
.decl init_window_dep(mod: symbol, to_mod: symbol, kind: symbol, witness: symbol)

.init init_window = ForwardCallReachCut

init_window.cut(f, g) :- side_call(f, g).
init_window.root(i, i) :- init_function(_, i).

init_window_dep(mod, to, "cast", i) :-
  init_function(mod, i),
  init_window.reaches(i, g),
  async_dep(g, to).

init_window_dep(mod, to, "window_call", i) :-
  init_function(mod, i),
  init_window.reaches(i, g),
  sync_dep(g, to),
  !init_dep(mod, to, "call", _).

// A GenServer request handler waits on another process: through a
// resolved call ("call"), or only through a tag-attributed one ("tag").
.decl handler_dep(mod: symbol, callback: symbol, to_mod: symbol, kind: symbol, witness: symbol)

handler_dep(mod, "handle_call", to, "call", f) :-
  handle_call_function(mod, f),
  reaches_sync_dep(f, to),
  mod != to.

handler_dep(mod, "handle_call", to, "tag", f) :-
  handle_call_function(mod, f),
  reaches_tag_dep(f, to),
  mod != to.

handler_dep(mod, "handle_cast", to, "call", f) :-
  handle_cast_function(mod, f),
  reaches_sync_dep(f, to),
  mod != to.

// A handle_continue reached from init/1 waits on another process.
.decl continue_dep(mod: symbol, to_mod: symbol, witness: symbol)

continue_dep(mod, to, f) :-
  init_continues_to(mod, _),
  handle_continue_clause(mod, _, f),
  reaches_sync_dep(f, to),
  mod != to.

// Where a continue waits: the call in its handle_continue/2 on the way
// to the wait on `to` (site_request, calls.dl), the GenServer.call itself
// or the call into the helper that makes it; empty when the wait has no
// call of the function's own (a closure it hands on). handle_continue/2
// compiles every clause into one function, and the clause that makes the
// call is rarely the first: encore's fugue Coda heads its
// handle_continue/2 with a pure `:prime` clause and makes the seeded
// call in the `{:attach, _}` clause below it, so a finding anchored at
// the function lands on the pure clause.
site_demand(f) :- continue_dep(_, _, f).

.decl continue_site(func: symbol, to: symbol, site: symbol)

continue_site(f, to, id) :- continue_dep(_, to, f), site_request(f, id, to, _), id != "".

.decl continue_wait(mod: symbol, to: symbol, site: symbol)

continue_wait(mod, to, id) :- continue_dep(mod, to, f), continue_site(f, to, id).
continue_wait(mod, to, "") :- continue_dep(mod, to, f), !continue_site(f, to, _).
