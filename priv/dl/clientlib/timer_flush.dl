// The cancel_timer flush idiom: a receive that takes a timer's message
// cancel_timer/1 said was already delivered.
//
// flush_receive(recv): a receive with no `after` that is no hang. Blocking's
// receive in a callback and startup's wait during init both step aside
// for it:
//
//     if Process.cancel_timer(ref) == false do
//       receive do :tick -> :ok end
//     end
//
// `cancel_timer/1` returning false means the timer had already expired, so
// the message has already been sent and is sitting in the mailbox — the
// receive is guaranteed to match, and OTP's own code is written this way
// (gen_server's mc_cancel_timer/2, Livebook's session). The receive must
// run only on the `false` side of a test of that cancel's result, later
// in the same function (recv_flush, Argus.Extractors.Monitor.Flush): a
// cancel whose result nothing tests, or a receive the other side reaches
// too, waits forever when the cancel succeeded and the message never
// comes.
//
// flush_poll(recv): a receive with an `after`, in a function that cancels
// a timer, that can take the timer's message — `receive :tick -> :ok
// after 0 -> :ok end`, the form the cancel_timer docs give. It cannot
// hang whichever way the cancel went, and takes exactly the message the
// function means to drop.
//
// Both ask that the receive can take a timer's message — a clause for a
// literal one of the module's timers is armed with, for :timeout
// (erlang:start_timer/3's `{timeout, Ref, Msg}`), or for anything. A
// receive whose every clause names some other literal, in a module whose
// timers all carry known literals, is waiting for something else. When
// the module arms no timer the program can see (the ref came from a
// caller) or arms one whose message is not a known literal, the receive
// may take it: the quiet direction.
// The literal message a timer carries, at the site that arms it for
// `target` ("self" for the arming process): spelled there, or a parameter
// the arming function's callers fill with a literal (resolved_arg:
// nebulex's `start_timer(time, ref, event \\ :heartbeat)`). A message
// built at runtime has no row. mailbox reads it for the stale message a
// cancel leaves behind, this file for the message a flush takes.
.decl armed_literal(site: symbol, func: symbol, target: symbol, message: symbol)

armed_literal(id, a, t, lit) :- timer_arm(id, a, t, "bare", _, lit).

armed_literal(id, a, t, lit) :-
  timer_arm(id, a, t, "param", pos, _),
  resolved_arg(a, pos, lit).

.decl cancels_timer(func: symbol)

cancels_timer(func) :-
  remote_call(_, func, ":erlang", "cancel_timer", _).

.decl timer_message(mod: symbol, message: symbol)

timer_message(mod, lit) :-
  armed_literal(_, a, _, lit),
  function_def(a, mod, _, _, _).

.decl timer_message_unknown(mod: symbol)

timer_message_unknown(mod) :-
  timer_arm(_, a, _, "dynamic", _, _),
  function_def(a, mod, _, _, _).

timer_message_unknown(mod) :-
  timer_arm(_, a, _, "param", pos, _),
  !resolved_arg(a, pos, _),
  function_def(a, mod, _, _, _).

.decl takes_timer_message(recv: symbol)

takes_timer_message(id) :- recv_pattern(id, _, "any").
takes_timer_message(id) :- recv_pattern(id, _, ":timeout").

takes_timer_message(id) :-
  recv_pattern(id, f, lit),
  function_def(f, mod, _, _, _),
  timer_message(mod, lit).

.decl waits_for_other(recv: symbol)

waits_for_other(id) :-
  recv_pattern(id, f, _),
  function_def(f, mod, _, _, _),
  timer_message(mod, _),
  !timer_message_unknown(mod),
  !takes_timer_message(id).

.decl flush_receive(recv: symbol)

flush_receive(id) :-
  recv_start(id, _, 1, _),
  recv_flush(id, _, _),
  !waits_for_other(id).

.decl flush_poll(recv: symbol)

flush_poll(id) :-
  recv_start(id, func, 0, _),
  cancels_timer(func),
  !waits_for_other(id).

// Prerequisites: include clientlib/imports.dl and otp.dl (for
// resolved_arg) before this file.

// ── A helper cancels the field ───────────────────────────────────────
//
// helper_cancels_field(caller, site, cancel, key): `caller`'s call at
// `site`, in its own process, is to a function of its module that reads
// the field under `key` and cancels it at `cancel` itself. The one
// spelling mailbox's flush scope and its timer loop's cancel both read.
.decl helper_cancels_field(caller: symbol, site: symbol, cancel: symbol, key: symbol)

helper_cancels_field(g, s, cancel, key) :-
  timer_cancel(cancel, c, "field", key, _),
  call_instr(g, c, s),
  function_def(c, mod, _, _, _),
  function_def(g, mod, _, _, _),
  !runs_elsewhere(g, c).
