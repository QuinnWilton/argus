// Timer-flush recognition.
// `flush_receive`: an unbounded receive reached only after cancel_timer returns false,
// accepting the timer's message. An unchecked cancellation cannot establish this.
// `flush_poll`: a bounded matching receive after cancellation; it cannot hang
// regardless of the cancellation result.
// Match a known timer literal, start_timer's timeout tuple, or a catch-all. If the
// module's timer/message is unknown, allow a possible match; known incompatible
// literals do not qualify.
// `armed_literal` resolves literal messages at the arm site or from caller parameters
// and records the destination. Runtime-built messages have no row. Used by flush and
// stale-timer checks.
.decl armed_literal(site: symbol, func: symbol, target: symbol, message: symbol)

armed_literal(id, a, t, lit) :- timer_arm(id, a, t, "bare", _, lit).

armed_literal(id, a, t, lit) :-
  timer_arm(id, a, t, "param", pos, _),
  resolved_arg(a, pos, lit).

// The cancel_timer call at `cancel` (Process.cancel_timer/1,2 inline to
// it).
.decl cancels_timer(cancel: symbol)

cancels_timer(cancel) :-
  remote_call(cancel, _, ":erlang", "cancel_timer", _).

.decl timer_message(mod: symbol, message: symbol)

timer_message(mod, lit) :-
  armed_literal(_, a, _, lit),
  function_def(a, mod, _, _, _).

.decl timer_message_unknown(mod: symbol)

timer_message_unknown(mod) :-
  timer_arm(_, a, _, "dynamic", _, _),
  function_def(a, mod, _, _, _).

timer_message_unknown(mod) :-
  timer_arm(_, a, _, "param", pos, _),
  !resolved_arg(a, pos, _),
  function_def(a, mod, _, _, _).

.decl takes_timer_message(recv: symbol)

takes_timer_message(id) :- recv_pattern(id, _, "any").
takes_timer_message(id) :- recv_pattern(id, _, ":timeout").

takes_timer_message(id) :-
  recv_pattern(id, f, lit),
  function_def(f, mod, _, _, _),
  timer_message(mod, lit).

.decl waits_for_other(recv: symbol)

waits_for_other(id) :-
  recv_pattern(id, f, _),
  function_def(f, mod, _, _, _),
  timer_message(mod, _),
  !timer_message_unknown(mod),
  !takes_timer_message(id).

.decl flush_receive(recv: symbol)

flush_receive(id) :-
  recv_start(id, _, 1, _),
  recv_flush(id, _, _),
  !waits_for_other(id).

.decl flush_poll(recv: symbol)

flush_poll(id) :-
  recv_start(id, _, 0, _),
  after_cancel_timer.runs_after(_, id),
  !waits_for_other(id).

.init after_cancel_timer = RunsAfter

after_cancel_timer.asked(cancel) :- cancels_timer(cancel).

// Prerequisites: include clientlib/imports.dl, otp.dl (for
// resolved_arg) and order.dl (RunsAfter) before this file.

// helper_cancels_field(caller, site, cancel, key): a same-module helper called on
// caller's stack reads field key and cancels its timer at cancel. Shared by mailbox
// flush-scope and timer-loop rules.
.decl helper_cancels_field(caller: symbol, site: symbol, cancel: symbol, key: symbol)

helper_cancels_field(g, s, cancel, key) :-
  timer_cancel(cancel, c, "field", key, _),
  call_instr(g, c, s),
  function_def(c, mod, _, _, _),
  function_def(g, mod, _, _, _).
