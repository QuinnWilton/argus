// Classify code by execution frequency within a process incarnation. Used for
// restart-state loss, repeated monitors, timers, and subscriptions. See
// docs/design/analysis-model.md#startup-and-repeated-execution.
// A clause is once-only when all its message producers are startup or other once-only
// code. Unknown, external, cyclic, or repeated producers make it repeatable. Once means
// bounded by startup work, possibly once per startup item or monitor.
// `once_code` is work that may run during a supervised child's startup, including its
// continuation chain and gated sites. `once_step` gives the phase's direct call
// anchors. `once_clause`, `once_clause_site`, and `gated_once_site` prove restricted
// repetition; `once_site` combines the site forms.
// `again_root` identifies repeatable callbacks, state handlers, receive loops, and
// external APIs. `again_code` follows their same-process calls and repeatable clause
// sites. Shared helpers can be both once and again code.
// External callers and cross-process one-time messages may be classified as repeatable.
// Requires imports.dl and otp.dl.

// Clause-aware callbacks: info and cast by message tag, continue by continuation tag,
// LiveView async by task name, and gen_statem internal events by combined type/content.
// Other statem event types are external inputs.
.decl clause_callback(mod: symbol, func: symbol, kind: symbol)

clause_callback(m, h, "info") :-
  otp_callback(h, m, "handle_info", _),
  function_def(h, m, "handle_info", 2, _).

clause_callback(m, h, "cast") :-
  otp_callback(h, m, "handle_cast", _),
  function_def(h, m, "handle_cast", 2, _).

clause_callback(m, h, "continue") :-
  otp_callback(h, m, "handle_continue", _),
  function_def(h, m, "handle_continue", 2, _).

clause_callback(m, h, "async") :-
  otp_callback(h, m, "handle_async", _),
  function_def(h, m, "handle_async", 3, _).

clause_callback(m, h, "internal") :- statem_event_clause(m, h, _).

// clause_fn identifies message-dispatch functions for mod: its callback or a helper
// receiving the whole message through hands_on.
.decl clause_fn(mod: symbol, func: symbol, kind: symbol)

clause_fn(m, h, k) :- clause_callback(m, h, k).
clause_fn(m, g, k) :- hands_on(m, _, g, _, k).

// hands_on forwards the whole message as the first argument to a same-name, same-arity
// callback, including defdelegate wrappers.
.decl hands_on(mod: symbol, func: symbol, callee: symbol, site: symbol, kind: symbol)

hands_on(m, h, g, c, k) :-
  clause_fn(m, h, k),
  k != "internal",
  call_instr(h, g, c),
  !runs_elsewhere(h, g),
  call_arg_forward(h, g, 0, 0),
  function_def(h, _, n, a, _),
  function_def(g, _, n, a, _).

// A gen_statem's event is its first two arguments: both handed on.
hands_on(m, h, g, c, "internal") :-
  clause_fn(m, h, "internal"),
  call_instr(h, g, c),
  !runs_elsewhere(h, g),
  call_arg_forward(h, g, 0, 0),
  call_arg_forward(h, g, 1, 1),
  function_def(h, _, n, a, _),
  function_def(g, _, n, a, _).

// A tagged clause in mod's process, identified by an attributed call, return or
// inserted event.
.decl clause_node(mod: symbol, func: symbol, kind: symbol, tag: symbol)

clause_node(m, h, k, t) :- clause_fn(m, h, k), k != "internal", message_site_clause(_, h, t).

// A gen_statem's clause for :internal events: of one content
// (`:internal :connect`, clause_event), or of any (`:internal`).
clause_node(m, h, "internal", ":internal") :-
  clause_fn(m, h, "internal"),
  message_site_clause(_, h, ":internal").

clause_node(m, h, "internal", t) :-
  clause_fn(m, h, "internal"),
  message_site_clause(_, h, t),
  clause_event(h, t, ":internal", _).

.decl node_tag(kind: symbol, tag: symbol)

node_tag(k, t) :- clause_node(_, _, k, t).

// The clause an instruction of a clause function is in: a call's
// (clause_call), a return's (continue_return, timeout_return), an
// inserted event's (statem_insert).
.decl message_site_clause(site: symbol, func: symbol, tag: symbol)

message_site_clause(s, h, t) :- clause_call(s, h, t).
message_site_clause(s, h, t) :- continue_return(s, h, t, _), t != "*".
message_site_clause(s, h, t) :- timeout_return(s, h, t), t != "*".
message_site_clause(s, h, t) :- statem_insert(s, h, t, _, _), t != "*".

// self_message(site, func, kind, tag) identifies a message sent to func's own process;
// "*" means any tag. Attribute each producer to the start callbacks, clauses and roots
// that reach it on the same stack.
.decl self_message(site: symbol, func: symbol, kind: symbol, tag: symbol)

// A send to self(): the atom, or the tuple tagged by it.
self_message(id, f, "info", t) :-
  pid_send(id, f, msg, "self", _),
  node_tag("info", t),
  (msg = t ; msg = cat("{", cat(t, ", …}"))).

self_message(id, f, "info", "*") :- pid_send(id, f, "dynamic", "self", _).

// A one-shot timer armed for the process (an interval is below).
self_message(id, f, "info", t) :-
  timer_arm(id, f, "self", _, _, _),
  !interval_arm(id),
  timer_tag(id, t, _).

self_message(id, f, "info", "*") :-
  timer_arm(id, f, "self", m, _, _),
  !interval_arm(id),
  m != "param",
  !timer_tag(id, _, _).

self_message(id, f, "info", ":timeout") :- start_timer_arm(id, f, "self").

// Resolve a timer's message parameter at its callers, using literal atoms or tuples
// with literal tags. Propagate through callers that forward their own parameters.
.decl self_arms_param(func: symbol, pos: number)

self_arms_param(f, k) :- timer_arm(_, f, "self", "param", k, _).
self_arms_param(f, j) :- self_arms_param(g, k), call_arg_forward(f, g, k, j).

self_message(c, f, "info", t) :-
  self_arms_param(g, k),
  call_instr(f, g, c),
  call_arg(f, g, k, t),
  t != "dynamic".

self_message(c, f, "info", t) :-
  self_arms_param(g, k),
  call_instr(f, g, c),
  call_arg_tuple(f, g, k, 0, "literal", t).

self_message(c, f, "info", "*") :-
  self_arms_param(g, k),
  call_instr(f, g, c),
  call_arg(f, g, k, "dynamic"),
  !call_arg_tuple(f, g, k, 0, "literal", _).

self_message(c, f, "info", "*") :-
  self_arms_param(g, k),
  call_instr(f, g, c),
  !call_arg(f, g, k, _),
  !call_arg_forward(f, g, k, _).

// A monitor's :DOWN, and that of a task the process starts and does not
// await (Task.async unawaited, Task.Supervisor.async_nolink).
self_message(id, f, "info", ":DOWN") :- monitor_call(id, f, _).
self_message(id, f, "info", ":DOWN") :- mailbox_writer(id, f, "task").
self_message(id, f, "info", ":DOWN") :- mailbox_writer(id, f, "task_nolink").

// Idle timeouts returned by callbacks, directly or through returned helper results. Do
// not interpret arbitrary helper tuples as callback returns.
self_message(id, f, "info", ":timeout") :- timeout_return(id, f, _), callback_result(f).

.decl callback_result(func: symbol)

callback_result(f) :- otp_callback(f, _, _, _).
callback_result(g) :- callback_result(f), returns_call(f, g).

// A cast to self().
self_message(id, f, "cast", t) :-
  pid_call(id, f, "cast", "self", _),
  call_tag(id, f, "cast", t).

self_message(id, f, "cast", "*") :-
  pid_call(id, f, "cast", "self", _),
  !call_tag(id, f, "cast", _).

// A return that continues to handle_continue/2.
self_message(id, f, "continue", t) :- continue_return(id, f, _, t).

// Inserted gen_statem events by type and content. Unknown types or contents may match
// any compatible event clause.
self_message(id, f, "internal", t) :-
  statem_insert(id, f, _, ":internal", c),
  c != "*",
  t = cat(":internal ", c).

self_message(id, f, "internal", ":internal") :- statem_insert(id, f, _, ":internal", "*").
self_message(id, f, "internal", ":internal") :- statem_insert(id, f, _, "*", _).

// The :internal events an insert spells the content of.
.decl internal_event(tag: symbol)

internal_event(cat(":internal ", c)) :- statem_insert(_, _, _, ":internal", c), c != "*".

// LiveView start_async/3,4 delivers results to handle_async/3 for the task's name.
// Facts omit the call site, so a start in a clause function is attributed to every
// clause in that function.
self_message(f, f, "async", t) :-
  call_arg(f, g, 1, t),
  t != "dynamic",
  match("Phoenix.(LiveView|LiveComponent)(.Async)?:start_async/[34]", g).

self_message(f, f, "async", "*") :-
  call_arg(f, g, 1, "dynamic"),
  match("Phoenix.(LiveView|LiveComponent)(.Async)?:start_async/[34]", g).

// A same-module clause-function call dispatches its first argument as a message on the
// caller's stack. Exclude whole-message forwarding already covered by hands_on.
self_message(c, f, k, t) :-
  clause_fn(_, h, k),
  call_instr(f, h, c),
  !hands_on(_, f, h, c, _),
  function_def(f, fm, _, _, _),
  function_def(h, fm, _, _, _),
  (call_arg(f, h, 0, t) ; call_arg_tuple(f, h, 0, 0, "literal", t)),
  t != "dynamic".

self_message(c, f, k, "*") :-
  clause_fn(_, h, k),
  call_instr(f, h, c),
  !hands_on(_, f, h, c, _),
  function_def(f, fm, _, _, _),
  function_def(h, fm, _, _, _),
  !call_arg_tuple(f, h, 0, 0, "literal", _),
  (call_arg(f, h, 0, "dynamic") ; !call_arg(f, h, 0, _)).

// outside_message(kind, tag) identifies possible messages from another process: sends,
// one-shot timers, casts to non-self targets, intervals and Phoenix.PubSub broadcasts.
.decl outside_message(kind: symbol, tag: symbol)

outside_message("info", t) :-
  pid_send(_, _, msg, src, _),
  src != "self",
  node_tag("info", t),
  (msg = t ; msg = cat("{", cat(t, ", …}"))).

outside_message("info", t) :- timer_arm(id, _, "other", _, _, _), timer_tag(id, t, _).

outside_message("cast", t) :-
  call_tag(id, f, "cast", t),
  !pid_call(id, f, "cast", "self", _).

// Interval timers produce repeated messages wherever they are armed. An interval
// targeting self contributes repeated_message; one targeting another process
// contributes outside_message.
.decl interval_arm(site: symbol)

interval_arm(id) :- timer_arm(id, f, _, _, _, _), arms_interval(f).

// If a function calls :timer.send_interval/2,3, conservatively classify all its timer
// arms as repeated, including nearby one-shot timers.
.decl arms_interval(func: symbol)

arms_interval(f) :- call_arg(f, g, _, _), match(":timer:send_interval/[23]", g).

outside_message("info", t) :-
  interval_arm(id),
  timer_arm(id, _, "other", _, _, _),
  timer_tag(id, t, _),
  node_tag("info", t).

.decl repeated_message(site: symbol, func: symbol, tag: symbol)

repeated_message(id, f, t) :-
  interval_arm(id),
  timer_arm(id, f, "self", _, _, _),
  timer_tag(id, t, _).

repeated_message(id, f, "*") :-
  interval_arm(id),
  timer_arm(id, f, "self", _, _, _),
  !timer_tag(id, _, _).

// Phoenix.PubSub delivers broadcast messages to subscribers through library code absent
// from the program's facts. Resolve literal messages and parameters forwarded through
// wrappers.
.decl publishes_param(func: symbol, pos: number)

publishes_param(f, k) :-
  call_arg_forward(f, g, _, k),
  match("Phoenix.PubSub:(local_|direct_)?broadcast(_from)?!?/[3-5]", g).

publishes_param(f, k) :- publishes_param(g, gk), call_arg_forward(f, g, gk, k).

.decl published(tag: symbol)

published(t) :-
  (call_arg(_, g, _, t) ; call_arg_tuple(_, g, _, 0, "literal", t)),
  match("Phoenix.PubSub:(local_|direct_)?broadcast(_from)?!?/[3-5]", g).

published(t) :-
  publishes_param(f, k),
  (call_arg(_, f, k, t) ; call_arg_tuple(_, f, k, 0, "literal", t)).

outside_message("info", t) :- published(t), node_tag("info", t).

// A call of a clause function from another module, other than a
// hand-on: its clauses run in whatever process that caller runs in.
.decl called_from_outside(func: symbol)

called_from_outside(h) :-
  clause_fn(_, h, _),
  call_instr(f, h, c),
  !hands_on(_, f, h, c, _),
  function_def(f, fm, _, _, _),
  function_def(h, hm, _, _, _),
  fm != hm.

// ── Where each producer runs ─────────────────────────────────────────
//
// The functions that reach a producer on their own stack.
.init message_reach = SameProcessReach

message_reach.seed(p, p) :- self_message(_, p, _, _).
message_reach.seed(p, p) :- repeated_message(_, p, _).

// A message producer for mod, kind, and tag. `from` identifies a clause function, start
// phase, or repeatable root; `part` identifies its clause, with `*` for unrestricted
// sites. Unknown process ownership also uses `*`.
.decl produced(from: symbol, part: symbol, mod: symbol, kind: symbol, tag: symbol)

produced(h, t, m, k, tag) :-
  clause_fn(m, h, _),
  self_message(s, h, k, tag),
  message_site_clause(s, h, t).

produced(h, "*", m, k, tag) :-
  clause_fn(m, h, _),
  self_message(s, h, k, tag),
  !message_site_clause(s, h, _).

produced(h, t, m, k, tag) :-
  clause_fn(m, h, _),
  call_instr(h, g, c),
  !runs_elsewhere(h, g),
  !hands_on(m, h, g, c, _),
  clause_call(c, h, t),
  message_reach.reaches(g, p),
  self_message(_, p, k, tag).

produced(h, "*", m, k, tag) :-
  clause_fn(m, h, _),
  call_instr(h, g, c),
  !runs_elsewhere(h, g),
  !hands_on(m, h, g, c, _),
  !clause_call(c, h, _),
  message_reach.reaches(g, p),
  self_message(_, p, k, tag).

produced(h, t, m, k, tag) :-
  clause_fn(m, h, _),
  fun_handed(c, h, g, _),
  !runs_elsewhere(h, g),
  clause_call(c, h, t),
  message_reach.reaches(g, p),
  self_message(_, p, k, tag).

produced(h, "*", m, k, tag) :-
  clause_fn(m, h, _),
  call_edge(h, g),
  !runs_elsewhere(h, g),
  !call_instr(h, g, _),
  message_reach.reaches(g, p),
  self_message(_, p, k, tag).

produced("start", m, m, k, tag) :-
  start_callback(m, s),
  message_reach.reaches(s, p),
  self_message(_, p, k, tag).

produced("again", m, m, k, tag) :-
  again_whole(r, m),
  message_reach.reaches(r, p),
  self_message(_, p, k, tag).

// An interval timer's message, in the process whose code arms it.
produced("again", m, m, "info", tag) :- runs_in(m, p), repeated_message(_, p, tag).

.decl runs_in(mod: symbol, func: symbol)

runs_in(m, p) :- start_callback(m, s), message_reach.reaches(s, p).
runs_in(m, p) :- clause_fn(m, h, _), message_reach.reaches(h, p).
runs_in(m, p) :- again_whole(r, m), message_reach.reaches(r, p).

// A producer no root the program knows reaches (a fun made to run
// elsewhere or later): its process is not known.
.decl rooted(func: symbol)

rooted(p) :- start_callback(_, s), message_reach.reaches(s, p).
rooted(p) :- clause_fn(_, h, _), message_reach.reaches(h, p).
rooted(p) :- again_whole(r, _), message_reach.reaches(r, p).

produced("again", "*", "*", k, tag) :- self_message(_, p, k, tag), !rooted(p).

// Repeatable function roots: callbacks without per-clause tracking, receive loops and
// exports called only from outside the program. `mod` identifies the process module, or
// "*" when unknown.
.decl again_whole(func: symbol, mod: symbol)

again_whole(e, m) :-
  (again_root(e, "callback") ; again_root(e, "state")),
  function_def(e, m, _, _, _),
  !clause_fn(_, e, _).

again_whole(e, "*") :- again_root(e, "loop").
again_whole(e, "*") :- again_root(e, "api").

// An export called only from outside may implement an unlisted behaviour callback.
// Associate it with its own module's clauses even when its execution stack is unknown.
again_whole(e, m) :- again_root(e, "api"), function_def(e, m, _, _, _).

// Code outside visible process-stack reach can still run through an unresolved apply,
// fun call, or protocol dispatch. A process with no such opaque call is restricted to
// visible call-graph work.
.decl opaque_call(func: symbol)

opaque_call(f) :- dynamic_call(id, f, _), !resolved_apply(id, f, _).
opaque_call(f) :- protocol_dispatch(_, f, _).

.init opaque_reach = SameProcessReachSet

opaque_reach.seed(f) :- opaque_call(f).

.decl opaque_stack(mod: symbol)

opaque_stack(m) :- start_callback(m, s), opaque_reach.reaches(s).
opaque_stack(m) :- clause_fn(m, h, _), opaque_reach.reaches(h).
opaque_stack(m) :- again_whole(r, m), opaque_reach.reaches(r).

// ── Once clauses ─────────────────────────────────────────────────────
//
// enters(from, part, mod, func, tag): what runs at (from, part) makes a
// message clause (func, tag) takes in mod's process.
.decl enters(from: symbol, part: symbol, mod: symbol, func: symbol, tag: symbol)

enters(a, b, m, h, t) :- clause_node(m, h, k, t), produced(a, b, m, k, t).
enters(a, b, m, h, t) :- clause_node(m, h, k, t), produced(a, b, m, k, "*").

// Unknown-content internal events may enter any internal clause. Catch-all internal
// clauses accept every content.
enters(a, b, m, h, t) :-
  clause_node(m, h, "internal", t),
  clause_event(h, t, ":internal", _),
  produced(a, b, m, "internal", ":internal").

enters(a, b, m, h, ":internal") :-
  clause_node(m, h, "internal", ":internal"),
  produced(a, b, m, "internal", p),
  internal_event(p).

enters("again", "*", m, h, t) :-
  clause_node(m, h, k, t),
  (produced("again", "*", "*", k, t) ; produced("again", "*", "*", k, "*")),
  opaque_stack(m).

// A known producer emits the clause's tag. Unknown-tag producers may also deliver
// runtime or library messages absent from the facts.
.decl entered(mod: symbol, func: symbol, tag: symbol)

entered(m, h, t) :- clause_node(m, h, k, t), produced(_, _, m, k, t).

entered(m, h, t) :-
  clause_node(m, h, "internal", t),
  clause_event(h, t, ":internal", _),
  produced(_, _, m, "internal", ":internal").

entered(m, h, ":internal") :-
  clause_node(m, h, "internal", ":internal"),
  produced(_, _, m, "internal", p),
  internal_event(p).

// A clause repeats when its messages come from external or repeatable producers,
// repeatable clause parts, or a producer cycle. Derive this by positive fixpoint; do
// not assume once-only execution to prove it.
.decl runs_again(mod: symbol, func: symbol, tag: symbol)

runs_again(m, h, t) :- clause_node(m, h, k, t), outside_message(k, t).
runs_again(m, h, t) :- clause_node(m, h, _, t), called_from_outside(h).
runs_again(m, h, t) :- enters("again", _, m, h, t).
runs_again(m, h, t) :- enters(a, b, m, h, t), again_part(m, a, b).
runs_again(m, h, t) :- enters_path(h, t, m, h, t).

// Potentially repeated clause-function work: unclassified sites, externally driven
// clauses, clauses with no known tag producer, and clauses with repeated producers.
.decl again_part(mod: symbol, func: symbol, tag: symbol)

again_part(m, h, "*") :- clause_fn(m, h, _).

again_part(m, h, t) :-
  produced(h, t, m, _, _),
  clause_fn(m, h, _),
  !clause_node(m, h, _, t).

again_part(m, h, t) :- clause_node(m, h, _, t), !entered(m, h, t).
again_part(m, h, t) :- runs_again(m, h, t).

// The clauses a clause's producers lead to, through the clauses between.
.decl enters_path(from: symbol, part: symbol, mod: symbol, func: symbol, tag: symbol)

enters_path(a, b, m, h, t) :- enters(a, b, m, h, t), clause_fn(m, a, _).
enters_path(a, b, m, h, t) :- enters_path(a, b, m, g, u), enters(g, u, m, h, t).

.decl runs_again_somewhere(func: symbol, tag: symbol)

runs_again_somewhere(h, t) :- runs_again(_, h, t).

// once_clause(func, tag): some producer spells what the clause takes, and
// in every process that runs func nothing makes it run again.
.decl once_clause(func: symbol, tag: symbol)

once_clause(h, t) :-
  entered(m, h, t),
  clause_node(m, h, _, t),
  !runs_again_somewhere(h, t).

// A site of a clause function every clause of which it is in runs once.
.decl once_clause_site(site: symbol, func: symbol)

once_clause_site(s, h) :-
  once_clause(h, t),
  clause_call(s, h, t),
  !again_tag_site(s, h).

.decl again_tag_site(site: symbol, func: symbol)

again_tag_site(s, h) :- clause_fn(_, h, _), clause_call(s, h, t), !once_clause(h, t).

// State-gated once-only sites
//
// Require all paths to test a state field against a finite atom set, every completion
// after the site to leave that set or end the process, and no handler/code_change
// return to reopen it or return unknown state. Init may establish the initial value.
// Direct program calls to the handler invalidate the proof because they can supply
// arbitrary state. Unrecognized callback return shapes count as unknown state.

// A return may reopen the gate by setting its field to an accepted or unknown value.
.decl gate_reopened(site: symbol, func: symbol, key: symbol)

gate_reopened(s, f, k) :-
  state_gate(s, f, k, v),
  function_def(f, m, _, _, _),
  state_setter(m, c),
  (state_return(c, _, k, v) ; state_return(c, _, k, "dynamic")).

.decl gated_once_site(site: symbol, func: symbol)

gated_once_site(s, f) :-
  state_gate(s, f, k, _),
  gate_closed(s, f, k),
  function_def(f, m, _, _, _),
  state_setter(m, f),
  !call_edge(_, f),
  !gate_reopened(s, f, k).

// A site that runs at most once per incarnation: in a clause that runs
// once, or behind a gate its run closes.
.decl once_site(site: symbol, func: symbol)

once_site(s, f) :- once_clause_site(s, f).
once_site(s, f) :- gated_once_site(s, f).

// Every call to this handler helper is gated. Exclude it from the handler's
// unrestricted repeated reachability.
.decl gated_edge(func: symbol, callee: symbol)

gated_edge(f, g) :- gated_once_site(c, f), call_instr(f, g, c), !open_edge(f, g).
gated_edge(f, g) :- gated_once_site(c, f), fun_handed(c, f, g, _), !open_edge(f, g).

.decl open_edge(func: symbol, callee: symbol)

open_edge(f, g) :- gated_once_site(_, f), call_instr(f, g, c), !gated_once_site(c, f).
open_edge(f, g) :- gated_once_site(_, f), fun_handed(c, f, g, _), !gated_once_site(c, f).

open_edge(f, g) :-
  gated_once_site(_, f),
  call_edge(f, g),
  !call_instr(f, g, _),
  !fun_handed(_, f, g, _).

// Startup code
//
// `once_code` means code that may execute during startup, including init's entire
// continuation chain even if later callbacks schedule it again. Message-driven clauses
// qualify only when once-only. Use the stricter `once_clause` to prove that a clause
// cannot repeat.
.decl start_clause(mod: symbol, func: symbol, tag: symbol)

start_clause(m, h, t) :- once_clause(h, t), clause_node(m, h, _, t).

start_clause(m, h, t) :-
  clause_node(m, h, "continue", t),
  enters("start", m, m, h, t).

start_clause(m, h, t) :-
  clause_node(m, h, "continue", t),
  enters(a, b, m, h, t),
  start_clause(m, a, b).

// The handler site runs once: it belongs to a once-only clause or is behind a state
// gate that its own execution closes.
.decl once_phase_site(mod: symbol, func: symbol, site: symbol)

once_phase_site(m, h, s) :- start_clause(m, h, t), clause_call(s, h, t).
once_phase_site(m, h, s) :- gated_once_site(s, h), function_def(h, m, _, _, _).

// Direct calls made at startup-phase level, in start callbacks or once-phase sites.
// These anchor findings in the initiating module even when the request occurs in a
// helper or another module's API.
.decl once_step(mod: symbol, func: symbol, site: symbol, callee: symbol)

once_step(m, s, c, g) :-
  start_callback(m, s),
  child_subtree(_, _, m),
  call_instr(s, g, c),
  !side_call(s, g).

once_step(m, s, c, g) :-
  start_callback(m, s),
  child_subtree(_, _, m),
  fun_handed(c, s, g, _),
  !runs_elsewhere(s, g),
  !side_call(s, g).

once_step(m, h, c, g) :-
  child_subtree(_, _, m),
  once_phase_site(m, h, c),
  call_instr(h, g, c),
  !runs_elsewhere(h, g),
  !side_call(h, g).

once_step(m, h, c, g) :-
  child_subtree(_, _, m),
  once_phase_site(m, h, c),
  fun_handed(c, h, g, _),
  !runs_elsewhere(h, g).

// A start callback's own steps are on its walk already; rooting them
// too keeps once_code what the steps reach.
.init once_reach = ForwardSameProcessReachCut

once_reach.cut(f, g) :- side_call(f, g).
once_reach.root(m, s) :- start_callback(m, s), child_subtree(_, _, m).
once_reach.root(m, g) :- once_step(m, _, _, g).

.decl once_code(mod: symbol, func: symbol)

once_code(m, g) :- once_reach.reaches(m, g).

// ── Code that runs again ─────────────────────────────────────────────
.decl again_root(func: symbol, how: symbol)

again_root(e, "callback") :-
  otp_callback(e, m, n, _),
  function_def(e, m, n, a, _),
  runs_again_callback(n, a).

// handle_continue/2 runs once when continued from init/1, or repeatedly from handlers.
// Classify individual continuation tags with once_clause.
again_root(e, "callback") :- clause_callback(_, e, "continue").

again_root(e, "callback") :-
  otp_callback(e, m, n, "GenEvent"),
  function_def(e, m, n, 2, _),
  (n = "handle_event" ; n = "handle_call").

again_root(f, "state") :- statem_event_clause(_, f, _).

again_root(f, "loop") :-
  receives(f),
  call_edge(f, g),
  !runs_elsewhere(f, g),
  loop_back.reaches(g, f).

// An externally called repeatable API: no visible caller, runtime callback role,
// process start, supervisor start, or library-generated ownership. External users may
// invoke it on every use.
again_root(f, "api") :-
  api_export(f),
  !call_edge(_, f),
  !process_entry(_, f),
  !library_written(f),
  !child_start(f),
  !process_start(_, _, _, _, f).

// A supervised module's start_link/N runs once per child start through its child spec,
// even without a visible call-graph edge.
.decl child_start(func: symbol)

child_start(f) :- child_subtree(_, _, m), function_def(f, m, "start_link", _, _).

// A receive loop's way back to itself, on its own stack.
.init loop_back = SameProcessReach

loop_back.seed(f, f) :- receives(f).

// Reach from repeatable roots and clause sites not proven once-only. Do not enter
// another clause function through ordinary call propagation; classify its clauses from
// their message producers.
.init again_reach = ForwardSameProcessReachSetCut

again_reach.cut(f, g) :- side_call(f, g).
again_reach.cut(f, g) :- call_edge(f, g), clause_fn(_, g, _).
again_reach.cut(f, g) :- gated_edge(f, g).
again_reach.root(f) :- again_root(f, _), !clause_fn(_, f, _).

again_reach.root(g) :-
  clause_fn(_, h, _),
  call_instr(h, g, c),
  !runs_elsewhere(h, g),
  !side_call(h, g),
  !hands_on(_, h, g, c, _),
  !once_site(c, h).

again_reach.root(g) :-
  clause_fn(_, h, _),
  fun_handed(c, h, g, _),
  !runs_elsewhere(h, g),
  !once_site(c, h).

again_reach.root(g) :-
  clause_fn(_, h, _),
  call_edge(h, g),
  !runs_elsewhere(h, g),
  !side_call(h, g),
  !call_instr(h, g, _),
  !fun_handed(_, h, g, _).

.decl again_code(func: symbol)

again_code(f) :- again_reach.reaches(f).
again_code(h) :- clause_fn(_, h, _).
