// Exception escape along call paths. Seed `asked(site, site_func, func, raise)` and
// read `escapes`, `rescued`, or `escapes_through`, which identifies func's first call
// toward the raising site.
// Follow unguarded same-process paths up to 16 calls. For closures, fun references, and
// resolved applies, inspect the receiving call's try coverage or rescuing wrapper.
// Without a call site, a matching handler anywhere in the function suppresses escape.
// Detached processes are excluded.
// Check callers one level above func only if all are visible: no export or fun
// reference, and every call or closure-use site is covered.
// Limits: deeper caller handlers are not tracked; matching uses class and tag, not
// exact reasons; a handler returning on some paths and re-raising on others counts as
// handling. Requires imports.dl, exceptions.dl, and runs_elsewhere.dl.
.comp Escape {
  .decl asked(site: symbol, site_func: symbol, func: symbol, raise: symbol)
  .decl escapes_through(site: symbol, func: symbol, raise: symbol, first: symbol)
  .decl escapes(site: symbol, func: symbol, raise: symbol)
  .decl rescued(site: symbol, func: symbol, raise: symbol)

  .decl root(func: symbol, raise: symbol)

  root(f, r) :- asked(_, _, f, r).

  .decl raise_asked(raise: symbol)

  raise_asked(r) :- root(_, r).

  // ── The path down ──

  // The call at `call` hands `func` a fun that runs `callee` (a closure,
  // a fun reference, an apply the facts resolve).
  .decl handed(func: symbol, callee: symbol, call: symbol)

  handed(f, g, id) :- fun_handed(id, f, g, _).
  handed(f, g, id) :- resolved_apply(id, f, g).

  // A passed fun is guarded if its receiving call is covered or its callee has a
  // matching handler anywhere. The wrapper-level fallback is coarse because execution
  // sites inside it are unknown.
  .decl runs_handed_guarded(call: symbol, func: symbol, raise: symbol)

  runs_handed_guarded(c, f, r) :- raise_asked(r), handed(f, _, c), site_takes(c, f, r).

  runs_handed_guarded(c, f, r) :-
    raise_asked(r),
    handed(f, _, c),
    call_instr(f, t, c),
    takes_somewhere(t, r).

  // A site-less same-process edge permits raise if any invoking call is unguarded, or
  // if no call is known and f has no matching handler.
  .decl open_fun_edge(func: symbol, callee: symbol, raise: symbol)

  open_fun_edge(f, g, r) :-
    raise_asked(r),
    handed(f, g, call),
    !call_instr(f, g, _),
    !runs_handed_guarded(call, f, r),
    !starts_a_process(call),
    !runs_elsewhere(f, g).

  open_fun_edge(f, g, r) :-
    raise_asked(r),
    call_edge(f, g),
    !call_instr(f, g, _),
    !handed(f, g, _),
    !takes_somewhere(f, r),
    !runs_elsewhere(f, g).

  // An unguarded path from root to callee, at depth calls. `first` is its initial call
  // in the root; no handler on the path catches raise.
  .decl reaches(root: symbol, raise: symbol, callee: symbol, depth: number, first: symbol)

  reaches(f, r, g, 1, call) :- root(f, r), call_instr(f, g, call), !site_takes(call, f, r).
  reaches(f, r, g, 1, "") :- root(f, r), open_fun_edge(f, g, r).

  reaches(f, r, h, d + 1, first) :-
    reaches(f, r, g, d, first),
    d < 16,
    call_instr(g, h, call),
    !site_takes(call, g, r).

  reaches(f, r, h, d + 1, first) :-
    reaches(f, r, g, d, first),
    d < 16,
    open_fun_edge(g, h, r).

  // ── The callers up ──

  // `func` has an incoming path without a matching handler, or an externally accessible
  // path through an export or function reference.
  .decl called_unguarded(func: symbol, raise: symbol)

  called_unguarded(f, r) :- root(f, r), call_instr(h, f, c), !site_takes(c, h, r).
  called_unguarded(f, r) :- root(f, r), api_export(f).
  called_unguarded(f, r) :- root(f, r), fun_ref(_, f).
  called_unguarded(f, r) :- root(f, r), handed(h, f, c), !runs_handed_guarded(c, h, r).
  called_unguarded(f, r) :- root(f, r), handed(_, f, c), starts_a_process(c).
  called_unguarded(f, r) :- root(f, r), call_edge(h, f), runs_elsewhere(h, f).

  called_unguarded(f, r) :-
    root(f, r),
    call_edge(h, f),
    !call_instr(h, f, _),
    !handed(h, f, _).

  .decl callers_take(func: symbol, raise: symbol)

  callers_take(f, r) :- root(f, r), call_edge(_, f), !called_unguarded(f, r).

  // ── The answer ──

  escapes_through(s, f, r, s) :-
    asked(s, f, f, r),
    !site_takes(s, f, r),
    !callers_take(f, r).

  escapes_through(s, f, r, first) :-
    asked(s, g, f, r),
    reaches(f, r, g, _, first),
    !site_takes(s, g, r),
    !callers_take(f, r).

  escapes(s, f, r) :- escapes_through(s, f, r, _).

  rescued(s, f, r) :- asked(s, _, f, r), !escapes(s, f, r).
}
