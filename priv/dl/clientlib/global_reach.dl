// Global operations that hold a caller. `global_path(func, call, site)` identifies the
// operation and func's first call toward it, or an empty call for a site-less edge.
// Shared by startup and blocking to assign each finding once.
// Traverse backward through same-process and awaited-task edges, excluding
// logging/telemetry and post-ack work. Literal first arguments narrow dispatcher
// clauses; other arguments use full function reach.
// Requires imports.dl and otp.dl.

.decl global_path(func: symbol, call: symbol, site: symbol)

// A :global call on init/1's stack holds up supervisor startup. This complements RPC
// tracking in init_phase.dl.
.decl global_call_during_init(init: symbol, site: symbol) inline

global_call_during_init(init, site) :- init_function(_, init), global_path(init, _, site).

global_path(f, site, site) :- global_op(site, f, _, _, _), !start_acked(site, f).

// Direct calls stay on f's stack. Site-less edges, such as closures, stay only when
// runs_elsewhere does not classify them as detached.

global_path(f, id, site) :-
  call_instr(f, g, id),
  !side_call(f, g),
  !acked_edge(f, g),
  global_path(g, _, site),
  !literal_first(f, g, _).

global_path(f, id, site) :-
  call_instr(f, g, id),
  !side_call(f, g),
  !acked_edge(f, g),
  literal_first(f, g, a),
  global_path(g, s, site),
  clause_of(g, s, c),
  (c = a ; c = "any" ; clause_event(g, c, a, _)).

global_path(f, "", site) :-
  call_edge(f, g),
  !call_instr(f, g, _),
  !runs_elsewhere(f, g),
  !side_call(f, g),
  !acked_edge(f, g),
  global_path(g, _, site).

global_path(f, id, site) :-
  awaits_task(f, id, g),
  !start_acked(id, f),
  global_path(g, _, site).

// The first-argument tag the clause holding `call` serves, or "any" for
// a call every clause shares, or a hop with no call.
.decl clause_of(func: symbol, call: symbol, tag: symbol)

clause_of(g, s, tag) :- global_path(g, s, _), clause_call(s, g, tag).
clause_of(g, s, "any") :- global_path(g, s, _), !clause_call(s, g, _).
