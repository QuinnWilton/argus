// Which functions a :global call holds up: the ones on whose stack it
// runs.
//
// global_path(func, call, site): the :global op at `site` runs while
// `func` waits on it, and `call` is func's own call that starts the path
// there — the site itself when func holds it, empty for a hop with no
// call instruction of func's (a closure it builds and hands to
// Enum.each, a fun it hands on). Startup's lock during init and
// blocking's step-aside for it (during_init) both read it, so a lock is
// init's finding or blocking's, never both and never neither.
//
// The walk goes backward from every global_op over the edges that stay
// on the caller's stack (runs_elsewhere, in runs_elsewhere.dl), plus the
// edge into a task the caller awaits (awaits_task): Task.async then
// Task.await holds the caller for as long as the lock does. It is
// clause-aware where a call says which clause it enters: a call whose
// first argument is always the same literal atom (literal_first, in
// calls.dl) enters only the clauses that match it (clause_call), so `sync(:boot, s)` in init/1 does not
// reach the set_lock in `sync(:locked, s)` beside it — the fix the talk
// recommends, with a helper shared by init/1 and handle_continue/2.
// Anything else (a forwarded parameter, a computed value, a tuple) is
// taken to enter every clause.
//
// Prerequisites: include clientlib/imports.dl and otp.dl (for
// runs_elsewhere) before this file.

.decl global_path(func: symbol, call: symbol, site: symbol)

global_path(f, site, site) :- global_op(site, f, _, _, _).

global_path(f, id, site) :-
  call_instr(f, g, id),
  !runs_elsewhere(f, g),
  global_path(g, _, site),
  !literal_first(f, g, _).

global_path(f, id, site) :-
  call_instr(f, g, id),
  !runs_elsewhere(f, g),
  literal_first(f, g, a),
  global_path(g, s, site),
  clause_of(g, s, c),
  (c = a ; c = "any").

global_path(f, "", site) :-
  call_edge(f, g),
  !call_instr(f, g, _),
  !runs_elsewhere(f, g),
  global_path(g, _, site).

global_path(f, id, site) :-
  awaits_task(f, id, g),
  global_path(g, _, site).

// The first-argument tag the clause holding `call` serves, or "any" for
// a call every clause shares, or a hop with no call.
.decl clause_of(func: symbol, call: symbol, tag: symbol)

clause_of(g, s, tag) :- global_path(g, s, _), clause_call(s, g, tag).
clause_of(g, s, "any") :- global_path(g, s, _), !clause_call(s, g, _).
