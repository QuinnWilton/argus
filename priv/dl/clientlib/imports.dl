// Standard imports for Argus client analyses.
//
// Include this single file to get all base fact declarations and the
// call graph. This is the recommended starting point for writing new
// analyses.
//
// Usage:
//   .include "../clientlib/imports.dl"
//
// Provides:
//   Base facts:     every Layer-1 and Layer-2 relation in Argus.Schema
//                   (base.dl + layer2.dl, both generated)
//   Stage-0 facts:  call_edge
//   Derived here:   call_reachable
//
// `call_edge` arrives as FACTS, not a derivation: it is produced once by
// `stage0.dl` and read here. Deriving it per analysis meant recomputing
// the same fixpoint once per analysis, and it dragged the layer-1
// relations — instruction, remote_call, function_def and friends — into
// every analysis's input set, so any edit to a function body dirtied
// every analysis, including ones that only reason about supervision
// structure. call_edge is far more stable than its inputs: changing what
// a function *does* leaves it untouched; only changing what a function
// *calls* moves it. `Argus.Analysis.run_rules/3` runs stage 0 for you;
// incremental consumers memoize it separately and reuse it across solves.
//
// call_reachable stays derived here rather than staged — see stage0.dl
// for why (the closure is quadratic and dwarfs the edge relation).
//
// There is no instruction-level control-flow graph in Datalog: Souffle
// prunes unused *input* relations but not unused *derived* ones, so a
// shared cfg_edge rule would keep every analysis demanding
// branch/jump/next/label_at facts it never reads. Intra-function
// reachability is computed per module in Elixir (`Argus.Cfg`) and
// arrives as facts such as `conditional_call` and `def_use`.
.include "../base.dl"

// Layer-2 domain-extractor declarations, generated from the same schema.
// Analyses used to hand-declare the handful they read — 95 declarations of
// 50 distinct relations across 19 files, none of them checked against
// Argus.Schema. Declaring the whole layer here is free for the same reason
// base.dl is: Souffle prunes input relations no rule reads.
.include "../layer2.dl"

// Call graph, derived once by stage0.dl.
.decl call_edge(caller: symbol, callee: symbol)
.input call_edge

// Stage-0 as well: the project-internal and GenServer call sites, so a
// finding can point at the calling instruction without reading
// remote_call.
.decl call_site(id: symbol, caller: symbol, callee_mod: symbol)
.input call_site

// Stage-0 as well: call-graph edges with at least one site that is not
// control-dependent on a branch in the caller.
.decl unconditional_call_edge(caller: symbol, callee: symbol)
.input unconditional_call_edge

// The message tag each GenServer.call/cast site sends (stage 0).
.decl call_tag(id: symbol, caller: symbol, kind: symbol, tag: symbol)
.input call_tag

// Transitive call reachability, closed over the staged edges. No
// built-in analysis reads it any more: the closure is quadratic in the
// call graph (17M rows from 100k edges on one corpus project, ~500 MB per
// solve) and every question the analyses ask is answered by propagating
// over call_edge from the few functions that matter — see calls.dl.
// It stays declared for custom programs; Souffle prunes it when unread.
.decl call_reachable(from: symbol, to: symbol)
.include "call_reachable_rules.dl"

// Target columns that name no module say "dynamic" (the extractor could
// not resolve the target), ":dynamic" (a partially resolved via tuple
// carried the placeholder into the registry slot) or "via:Registry" (a
// via tuple whose module is unknowable). A join against function_def or
// behaves_as is safe by construction; a rule that carries a target into
// a finding must exclude all three, as calls.dl does.

// How many closures a function creates — the shape a transaction body or
// a pure higher-order function is recognised by.
// Reachability components: see reach.dl.
.include "reach.dl"
// Closure ownership, receives by shape, what try handlers take, the
// effect model's categories.
.include "closures.dl"
.include "receive.dl"
.include "exceptions.dl"
.include "effects.dl"
.include "sinks.dl"

.decl closure_count(func: symbol, n: number)

closure_count(func, n) :-
  closure_def(func, _),
  n = count : { closure_def(func, _) }.
