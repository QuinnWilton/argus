// Standard imports for client analyses: generated Layer-1/2 facts and the staged call
// graph. Start with `.include "../clientlib/imports.dl"`.
// `call_edge` is produced once by stage0.dl and reused across analyses;
// Argus.Analysis.run_rules/3 runs that stage. `call_reachable` is derived on demand
// because its full closure can be large.
// Intra-function control flow is computed in Elixir (`Argus.Cfg`) and exposed through
// facts such as conditional_call and def_use. For site ordering, use order.dl over
// site_block/block_flow rather than rebuilding an instruction-level CFG.
.include "../base.dl"

// Generated Layer-2 declarations from Argus.Schema. Include the full layer; Souffle
// prunes unused relations and their inputs.
.include "../layer2.dl"

// Layer-3 priors contain optional classifier results from Argus.Priors. Declare them
// for every program; rules may use them only as positive premises.
.include "../priors.dl"

// Call graph, derived once by stage0.dl.
.decl call_edge(caller: symbol, callee: symbol)
.input call_edge

// Stage-0 call sites cover project calls, GenServer calls and selected library calls,
// providing finding anchors without reading remote_call.
.decl call_site(id: symbol, caller: symbol, callee_mod: symbol, callee_func: symbol, arity: number)
.input call_site

// Stage-0 as well: call-graph edges with at least one site that is not
// control-dependent on a branch in the caller.
.decl unconditional_call_edge(caller: symbol, callee: symbol)
.input unconditional_call_edge

// The message tag each GenServer.call/cast site sends (stage 0).
.decl call_tag(id: symbol, caller: symbol, kind: symbol, tag: symbol)
.input call_tag

// The function each call handed a fun calls (stage 0, from fun_handed):
// the caller, the fun, and the callee (`mod:func/arity`).
.decl fun_handed_to(caller: symbol, fun: symbol, callee: symbol)
.input fun_handed_to

// The staged instruction where func calls project function callee. Use it to anchor
// function-level findings without reading remote_call.
.decl call_instr(func: symbol, callee: symbol, id: symbol)

call_instr(f, g, id) :-
  call_site(id, f, mod, name, arity),
  g = cat(mod, cat(":", cat(name, cat("/", to_string(arity))))),
  function_def(g, _, _, _, _).

// A function and the module it is defined in.
.decl in_module(func: symbol, mod: symbol) inline

in_module(f, m) :- function_def(f, m, _, _, _).

// Full transitive reach over staged call edges, retained for custom programs and pruned
// when unused. Built-in analyses instead seed targeted propagation to avoid a
// potentially quadratic closure.
.decl call_reachable(from: symbol, to: symbol)
.include "call_reachable_rules.dl"

// Non-module targets use dynamic, :dynamic, or via:Registry. Definition/behaviour joins
// naturally reject them; rules carrying target strings into findings must filter all
// three explicitly.

// Reachability components: see reach.dl.
.include "reach.dl"
// Closure ownership, receives by shape, what try handlers take, the
// effect model's categories and its sinks.
.include "closures.dl"
.include "receive.dl"
.include "exceptions.dl"
.include "effect_model.dl"
.include "sinks.dl"
// Ways in from outside the program: api_export, library_face, open_entry.
.include "ways_in.dl"
// Code the program did not write: library_written.
.include "generated.dl"

// How many closures a function creates — the shape a transaction body or
// a pure higher-order function is recognised by.
.decl closure_count(func: symbol, n: number)

closure_count(func, n) :-
  closure_def(func, _),
  n = count : { closure_def(func, _) }.
