.input ets_new

// ETS read/write/delete operation.
.decl ets_op(id: symbol, func: symbol, table_ref: symbol, op: symbol, kind: symbol) mutable
.input ets_op

// The table operand of an ETS operation is the function's own parameter.
.decl ets_op_param(id: symbol, pos: number) mutable
.input ets_op_param

// Parsed option from :ets.new/2.
.decl ets_option(id: symbol, key: symbol, value: symbol) mutable
.input ets_option

// An `:ets.new/2` whose complete options list is known. Only then does a missing `ets_option` row prove an option absent. Partial or runtime lists have no row here; an unreadable `keypos` is `dynamic`, never the default.
//
.decl ets_options_known(id: symbol) mutable
.input ets_options_known

// An ETS read reached only after confirming the table exists or creating it, directly or through a same-module ensure helper. Every path must establish presence; reads on an unchecked or still-absent path have no row.
//
.decl ets_read_when_present(read: symbol, witness: symbol) mutable
