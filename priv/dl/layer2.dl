// Layer 2 — domain extractor facts.
//
// GENERATED by `mix argus.gen.dl` from Argus.Schema.layer_2/0 — do not edit.
//
// Include this instead of declaring fact relations by hand. FlowLog
// prunes input relations no rule reads, so including the whole layer
// costs nothing in the solve.

// A call reached only when a membership test or lookup finds its argument `arg` absent from `store`. The absent path reaches the site; the present path does not (`Argus.Extractors.StateGate.Absent`). Repeating the acquisition requires removing its key from the store.
//
.decl acquired_if_absent(site: symbol, func: symbol, pos: number, store: symbol, arg: number) mutable
.input acquired_if_absent

// A child added by `Supervisor.start_child/2` or `:supervisor.start_child/2`, with spec, restart, and type. Excludes DynamicSupervisor children, simple_one_for_one argument lists, and unresolved specs.
//
.decl added_child(sup: symbol, child_mod: symbol, restart: symbol, type: symbol, caller_func: symbol) mutable
.input added_child

// Every non-raising return forwards a listed call's result, its immediate payload, or that payload rewrapped. Any unrelated return or deeper extraction removes all rows for the function. This is the must-return counterpart of `returns_call`; `clientlib/answers.dl` chains it through wrappers (`Argus.Extractor.Answers`).
//
.decl answers_call(func: symbol, site: symbol, depth: number) mutable
.input answers_call

// GenServer.cast target detected in code.
.decl async_cast(caller_func: symbol, callee_mod: symbol) mutable
.input async_cast

// A cast's target at one site. Joins `call_tag` to associate the target and message of the same cast.
//
.decl async_cast_site(id: symbol, caller_func: symbol, callee_mod: symbol) mutable
.input async_cast_site

// Every start or spawn is followed on every returning path by a receive clause accepting its monitor's `:DOWN`, or any monitor's `:DOWN`. Other receive clauses and timeout arms do not qualify; raising paths are excluded. Establishes that started children cannot outlive the call.
//
.decl awaits_child_exit(func: symbol) mutable
.input awaits_child_exit

// Try/catch handler that catches all exceptions without filtering or reraising.
.decl bare_rescue(id: symbol, func: symbol, guard_end: symbol) mutable
.input bare_rescue

// A function containing only process-boundary operations and non-raising instructions. Boundary operations include calls, casts, stops, sends, and registrations (`Argus.Extractors.ErrorHandling.Boundary`).
//
.decl boundary_function(func: symbol) mutable
.input boundary_function

// A resolved call argument. `resolved_arg` in `clientlib/calls.dl` propagates literals through wrappers to resolve call and cast targets. Forwarded parameters use `call_arg_forward` instead.
//
.decl call_arg(caller: symbol, callee: symbol, arg_pos: number, value: symbol) mutable
.input call_arg

// Every call from caller to callee passes a literal list at this position. Compiled module attributes count as literals. Any nonliteral argument at that position removes the function-level row.
//
.decl call_arg_allowlist(caller: symbol, callee: symbol, arg_pos: number) mutable
.input call_arg_allowlist

// A call argument derived from an existing-atom lookup in the caller. Chains with `call_arg_derived` to detect caller-selected atoms reaching a sink.
//
.decl call_arg_chosen(caller: symbol, callee: symbol, arg_pos: number) mutable
.input call_arg_chosen

// A call argument derived from a read of the application environment in the caller. Chains with `call_arg_derived` to find configuration reaching a sink.
//
.decl call_arg_config(caller: symbol, callee: symbol, arg_pos: number) mutable
.input call_arg_config

// A call argument dependent on the source through data or control flow. Unlike `call_arg_derived`, includes control dependence and call-result sources. Function-level.
//
.decl call_arg_depends(caller: symbol, callee: symbol, arg_pos: number, kind: symbol, source: symbol) mutable
.input call_arg_depends

// A call argument derived from a caller parameter, including destructuring, construction, and known data-preserving calls. Includes `call_arg_forward`. For `make_fun3`, captured variables are trailing arguments. Function-level, so unchanged flows survive body edits.
//
.decl call_arg_derived(caller: symbol, callee: symbol, arg_pos: number, param_pos: number) mutable
.input call_arg_derived

// A call argument taken from element `index` of a caller parameter. Covers tuple extraction instructions and `element/2`. Emitted only when `call_arg` reports `dynamic`.
//
.decl call_arg_element(caller: symbol, callee: symbol, arg_pos: number, param_pos: number, index: number) mutable
.input call_arg_element

// A call argument read from a literal map key in the caller, such as `state.ref`. Emitted only when `call_arg` reports `dynamic`.
//
.decl call_arg_field(caller: symbol, callee: symbol, arg_pos: number, key: symbol) mutable
.input call_arg_field

// A caller parameter passed unchanged to a callee argument. Used for interprocedural constant propagation. Positions are numeric columns to avoid partial string functors, which a solver may evaluate before their guards.
//
.decl call_arg_forward(caller: symbol, callee: symbol, arg_pos: number, fwd_pos: number) mutable
.input call_arg_forward

// Parameter provenance at one concrete call site, with the same data-flow semantics as call_arg_derived. Distinguishes multiple calls to the same callee, so safety at one cannot be applied to another. Includes every argument position of direct local and remote calls.
//
.decl call_arg_param(id: symbol, func: symbol, arg_pos: number, param_pos: number) mutable
.input call_arg_param

// The data-only subset of `call_arg_depends`, for calls but not closures. Function-level.
//
.decl call_arg_reads(caller: symbol, callee: symbol, arg_pos: number, kind: symbol, source: symbol) mutable
.input call_arg_reads

// An argument contains data returned by an unresolved fun invocation. Uses ParamFlow's structural and actual helper-return propagation, independently of parameter taint. A runtime origin does not prove attacker control. Known closures returning constants and unknown ordinary external APIs add none.
//
.decl call_arg_runtime(id: symbol, func: symbol, pos: number, source: symbol, source_func: symbol) mutable
.input call_arg_runtime

// Element `index` of a tuple argument constructed by the caller, expressed as `(source, value)` in `key_identity` vocabulary. Identifies record tables and keys or ETS object keys. Unresolved elements are omitted.
//
.decl call_arg_tuple(caller: symbol, callee: symbol, arg_pos: number, index: number, source: symbol, value: symbol) mutable
.input call_arg_tuple

// A call controlled by a test on the source. Closure construction counts as a call. Function-level.
//
.decl call_decided(caller: symbol, callee: symbol, kind: symbol, source: symbol) mutable
.input call_decided

// A process or OTP API call's result usage, failure class, and literal target when known. One row per site supports comparison with other calls to the same callee and target. `try_covers` and `catch_class` determine whether the failure is handled.
//
.decl call_result(id: symbol, func: symbol, callee: symbol, fate: symbol, raises: symbol, target: symbol) mutable
.input call_result

// A catch-all that only logs or ignores the message. All uses of the message or derived values must go to Logger, `:logger`, IO, or `inspect/2`. Testing, returning, storing, or otherwise passing the message disqualifies it.
//
.decl callback_drops(func: symbol, callback: symbol) mutable
.input callback_drops

// A `handle_call/3` `{:noreply, _}` return reachable without reading `from`. Traces paths that do not read `{x,1}` or call with arity at least two. Recorded per return site so a correctly deferred sibling clause cannot hide a missing reply.
//
.decl callback_drops_from(id: symbol, func: symbol) mutable
.input callback_drops_from

// A non-catch-all clause accepting messages by shape without comparing their value or tag. Records `any` or `tuple` with arity, including `{ref, result}` guarded by `is_reference(ref)`. Complements `callback_tag` when checking whether a message is handled.
//
.decl callback_open(func: symbol, callback: symbol, shape: symbol, arity: number) mutable
.input callback_open

// A callback clause accepting a tuple headed by a reference, such as the `{ref, result}` reply from an `async_nolink` task.
//
.decl callback_ref_head(func: symbol, callback: symbol) mutable
.input callback_ref_head

// A literal OTP callback return tag built into `{x,0}` immediately before return. Tail calls have no row because the callee supplies the shape. Absence means unknown.
//
.decl callback_return(id: symbol, func: symbol, callback: symbol, tag: symbol) mutable
.input callback_return

// A literal reason in an OTP callback's `{:stop, reason, ...}` return: an atom or `{:shutdown, term}` literal. Computed reasons have no row; absence means unknown.
//
.decl callback_stop_reason(id: symbol, func: symbol, reason: symbol) mutable
.input callback_stop_reason

// A possible message tag handled by a callback. Counts every atom comparison in the body without tracking registers. This over-approximation is safe for rules that report missing handlers: extra tags suppress findings.
//
.decl callback_tag(func: symbol, callback: symbol, tag: symbol) mutable
.input callback_tag

// A callback clause's message shape: atom `tag` with arity 0, or a tuple of the given arity headed by `tag`. Reads clause heads only, unlike `callback_tag`, so an atom handler does not count as a handler for a tuple with that tag.
//
.decl callback_tag_shape(func: symbol, callback: symbol, tag: symbol, arity: number) mutable
.input callback_tag_shape

// A callback clause handling all `:DOWN` reasons for a monitor type: `any` or `process`. Reference, object, and state restrictions are allowed; reason restrictions are not (`Argus.Extractors.CallbackTag.MessageClauses.takes_down/2`).
//
.decl callback_takes_down(func: symbol, callback: symbol, type: symbol) mutable
.input callback_takes_down

// A callback clause handling trapped `:EXIT` messages for every exit reason. Sender and state restrictions are allowed; reason restrictions are not (`Argus.Extractors.CallbackTag.MessageClauses.takes_exit?/2`).
//
.decl callback_takes_exit(func: symbol, callback: symbol) mutable
.input callback_takes_exit

// A literal integer idle timeout in an OTP callback return. Schedules `:timeout`, cancelled if another message arrives first.
//
.decl callback_timeout(id: symbol, func: symbol, callback: symbol, timeout_ms: number) mutable
.input callback_timeout

// An unguarded catch-all, established by the absence of branches to the function's `func_info` failure label. Every input matches; guarded catch-alls do not qualify.
//
.decl callback_total(func: symbol, callback: symbol) mutable
.input callback_total

// A cancellation inside a `handle_info/2` clause for a literal atom, with the head test dominating the call and the message argument unchanged. A timer for this message has already fired.
//
.decl cancel_clause(id: symbol, func: symbol, message: symbol) mutable
.input cancel_clause

// An exception class handled by the try at `id`: some path accepts the class and returns without re-raising. Reason restrictions are allowed. `*` means no class test, including Erlang `catch Expr`, which has no separate span. Re-raise-only handlers have no row.
//
.decl catch_class(id: symbol, func: symbol, class: symbol, span_end: symbol) mutable
.input catch_class

// A non-exhaustive `case` in a handler after comparison with `tag`. An unexpected reason raises `CaseClauseError`. The tag distinguishes this case from compiler-generated field-access checks.
//
.decl catch_falls_through(id: symbol, func: symbol, tag: symbol) mutable
.input catch_falls_through

// A tag matched at the head of the reason's first tuple element, such as `:shutdown` in `{{:shutdown, _}, _}`. Distinguishes a GenServer call's wrapped shutdown reason from a plain `{:shutdown, _}` reason.
//
.decl catch_inner_tag(id: symbol, func: symbol, class: symbol, tag: symbol) mutable
.input catch_inner_tag

// An atom compared in a handler clause, attributed to its exception class. Includes body comparisons, so it over-approximates handled reason tags. Consumers check for missing tags; extra tags suppress findings.
//
.decl catch_tag(id: symbol, func: symbol, class: symbol, tag: symbol) mutable
.input catch_tag

// An exception class caught without restricting its reason. No reason of that class escapes the matching clause.
//
.decl catch_total(id: symbol, func: symbol, class: symbol) mutable
.input catch_total

// A tag matched at the head of an exception-reason tuple. Distinguishes `{:noproc, _}` from bare `:noproc` and nested `{{:shutdown, _}, _}`. `*` denotes a clause accepting tuple reasons without testing their elements.
//
.decl catch_tuple_tag(id: symbol, func: symbol, class: symbol, tag: symbol) mutable
.input catch_tuple_tag

// A child-spec field read from the function's argument, with its option key and default. Shorthand starts resolve it through `shorthand_option`; a known options argument lacking the key uses the default. Other arguments leave the value unknown.
//
.decl child_spec_option(mod: symbol, field: symbol, key: symbol, default: symbol) mutable
.input child_spec_option

// A module's `child_spec/1` restart policy: the stated value, `permanent` for a known map lacking `:restart`, or `dynamic` when unresolved. Argument-derived values use `child_spec_option`. No row means no visible `child_spec/1`.
//
.decl child_spec_restart(mod: symbol, restart: symbol) mutable
.input child_spec_restart

// A module's `child_spec/1` type for shorthand starts: the stated type or `worker` for a known map lacking it. Delegation to another module's `child_spec/1` has no row.
//
.decl child_spec_type(mod: symbol, type: symbol) mutable
.input child_spec_type

// A call or send reached only when the first argument has `tag`, either as an atom or tuple head. Every path must establish a tag; one row is emitted per possible tag. Enables clause-specific call-chain analysis. gen_statem event functions use `"<type> <content>"`, or the type alone when content is unknown; `clause_event` splits these tags.
//
.decl clause_call(id: symbol, func: symbol, tag: symbol) mutable
.input clause_call

// The type and content of a gen_statem clause tag used by `clause_call`, `returned_update`, and `statem_insert`. Content is an atom or tuple head, allowing rules to identify events such as `:info :DOWN`.
//
.decl clause_event(func: symbol, tag: symbol, type: symbol, content: symbol) mutable
.input clause_event

// Exact argument identity on every reaching path; a derived value is unknown here.
.decl code_arg_identity(id: symbol, func: symbol, pos: number, kind: symbol, value: symbol) mutable
.input code_arg_identity

// Calls in a module containing a template compiler, retaining invocation identity.
.decl code_call(id: symbol, func: symbol, callee: symbol) mutable
.input code_call

// Dynamic code execution or OS command call.
.decl code_execution(id: symbol, func: symbol, api: symbol) mutable
.input code_execution

// One deterministic necessary literal condition on a function parameter for reaching this call. The accepting edge covers all paths to this operation. -1 means no such proof. When several conditions hold, retaining one weakens precision; it never proves an additional exclusion.
//
.decl code_site_gate(id: symbol, func: symbol, param: number, value: symbol) mutable
.input code_site_gate

// A string template is compiled or evaluated from argument zero.
.decl code_template_site(id: symbol, func: symbol, api: symbol) mutable
.input code_template_site

// A `System.cmd` call to a literal shell or interpreter whose arguments are literal on every path, or to `mix` with a literal task that runs no code its arguments name, through the module's local helpers' returns and a private function's callers (`Argus.Extractor.Argv`). Covers only calls the function's own body could not show fixed, which `code_execution` keeps.
//
.decl command_fixed(id: symbol, func: symbol) mutable
.input command_fixed

// A call restricted to the connected branch of `Phoenix.LiveView.connected?/1` or a non-nil `get_connect_params/1` result. Excludes the disconnected branch and code after branches rejoin. Used to distinguish connected mount work from static rendering (`Argus.Extractors.LiveView`).
//
.decl connected_guarded(id: symbol, func: symbol) mutable
.input connected_guarded

// A return scheduling `handle_continue/2` from init, a handler, or a returned helper result. `tag` is the continuation atom or tuple head. One row per enclosing first-argument clause tag, used by `clientlib/runs.dl` to identify continuations that run once.
//
.decl continue_return(id: symbol, func: symbol, clause: symbol, tag: symbol) mutable
.input continue_return

// A call that registers a name or starts a process, including via registration and `start_child` with a name in its child spec.
//
.decl creating_op(id: symbol, func: symbol, api: symbol, scope: symbol, source: symbol, key: symbol) mutable
.input creating_op

// The argument is exactly this value on every path to the call: the caller's parameter, or a field projected out of a remote call's result in the same function. Rows are emitted at decoding calls, and at local calls of a function whose decoder decodes its parameter, at that position. A join of different values, a computed value, or a local helper's result has no row.
//
.decl decoded_bytes_value(id: symbol, func: symbol, pos: number, param: number, callee: symbol, path: symbol) mutable
.input decoded_bytes_value

// Every accepted payload from this decoded term follows a successful local recursive validator. Rejected error envelopes may be returned unchanged; projecting or consuming their rejected payload is not certified. Validation accepts only inert scalars and recursively checks list heads/tails, every tuple element, and map keys/values. The proof follows exact values and accepted verdicts, including exception handlers; unknown operations establish no safety. This does not exclude compressed ETF allocation or make decoding without safe immune to atom creation.
//
.decl decoded_term_validated(id: symbol, func: symbol) mutable
.input decoded_term_validated

// A demonitor call and whether `[:flush]` is present. Flushing removes an already queued `:DOWN`; cancellation alone does not. Unresolved options use `no_flush` so they cannot suppress a finding.
//
.decl demonitor_call(id: symbol, func: symbol, flush: symbol) mutable
.input demonitor_call

// A process-dictionary put, get, or erase, including Elixir wrappers. `erase/0` uses an unknown key.
//
.decl dict_op(id: symbol, func: symbol, op: symbol, key: symbol) mutable
.input dict_op

// A source stored under `key` in the running process's dictionary. Reads of the same `dict` source in that process may resolve to it (`clientlib/processes.dl`).
//
.decl dict_put(id: symbol, func: symbol, key: symbol, src_kind: symbol, src: symbol) mutable
.input dict_put

// Mnesia distributed store operation. DETS is not one: a DETS table is a file on its own node.
.decl distributed_store_op(id: symbol, func: symbol, store: symbol, op: symbol) mutable
.input distributed_store_op

// An exported function the Docs chunk hides from the module's users: `@doc false`, `@impl true` without a `@doc`, or any function of a `@moduledoc false` module (`Argus.Extractors.Docs`). `unsafe_input.dl` does not count it as a way in for a caller's data. A beam without a Docs chunk hides nothing.
//
.decl doc_hidden(func: symbol) mutable
.input doc_hidden

// A runtime child added by `DynamicSupervisor.start_child/2`. Makes dynamic workers visible alongside static supervision children.
//
.decl dynamic_child(sup: symbol, child_mod: symbol, caller_func: symbol) mutable
.input dynamic_child

// The restart policy stated by a dynamic child's explicit spec or `Supervisor.child_spec/2` override. Known maps without `:restart` use `permanent`. Shorthand forms have no row here; `dynamic_restart` in `clientlib/supervision.dl` also resolves their module-defined policy.
//
.decl dynamic_child_restart(sup: symbol, child_mod: symbol, caller_func: symbol, restart: symbol) mutable
.input dynamic_child_restart

// A send or external runtime effect controlled by a test on the source. Includes process, port, file, network, and node effects classified by `Argus.Purity.Effects`; excludes logging. Project calls use `call_decided`. Function-level.
//
.decl effect_decided(func: symbol, kind: symbol, source: symbol) mutable
.input effect_decided

// A library call (`Enum.map/2`, `Enum.reduce/3`, `Map.new/2`, `:lists.foldl/3`, ...) running `fun` on each element in the calling process (`Argus.Extractors.TermFlow.Library`). `fun` is handed the elements (a map's `{key, value}` pairs, a fold's accumulator) as `element` value_args; when the call's answer holds what `fun` answers, a `value_result` row names `fun` as its callee. Otherwise (`Enum.each/2`, `Enum.filter/2`, ...) what `fun` answers is dropped.
//
.decl element_fun(id: symbol, caller: symbol, fun: symbol, answers: symbol) mutable
.input element_fun

// Every path reaching this call excludes ETF's 131,80 compressed prefix for the exact bytes decoded. A local predicate's accepted result may establish the exclusion when compressed input cannot return that result. Binary match contexts require a known restored zero position to retain byte identity. Byte-size caps and decoded-term shape checks alone do not establish this.
//
.decl etf_compression_rejected(id: symbol, func: symbol) mutable
.input etf_compression_rejected

// A call that decodes ETF bytes from argument zero. Includes binary_to_term, executable-term rejecting wrappers, and transparent same-module delegates. A private delegate with local callers is represented at its callers, preserving their argument guards. Exported delegates retain their independent external-input finding. Options such as safe do not prevent allocation.
//
.decl etf_decode_site(id: symbol, func: symbol, api: symbol) mutable
.input etf_decode_site

// A call argument's identity in `ets_key` vocabulary. Translates a callee's parameter-based insert key into the caller's terms.
//
.decl ets_call_arg(id: symbol, callee: symbol, pos: symbol, source: symbol, value: symbol) mutable
.input ets_call_arg

// Two ordered effects within one function iteration. At least one is an insert or a same-module call that inserts. Excludes loop back edges so writes in a loop are ordered within an iteration, not in both directions.
//
.decl ets_effect_order(func: symbol, first: symbol, then: symbol) mutable
.input ets_effect_order

// The identity of an ETS key operand; for `insert` and `insert_new`, the object's first element. Matching `source` and `key` values identify the same row.
//
.decl ets_key(id: symbol, source: symbol, key: symbol) mutable
.input ets_key

// An element of a tuple key `ets_key` names `tuple`, in `ets_key` vocabulary (`Identity.key_elements/4`). Every element has a row: a key of n elements has rows at positions 0 to n - 1. Not emitted for match patterns.
//
.decl ets_key_element(id: symbol, pos: number, source: symbol, value: symbol) mutable
